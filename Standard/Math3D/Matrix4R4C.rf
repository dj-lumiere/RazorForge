module Math3D

import Simd
# ============================================================================
# Type
# ============================================================================

### A 4x4 matrix of `B32`, stored as four column vectors (column-major).
record Matrix4R4C
obeys Addable, Subtractable, Multiplicable, Negatable, Equatable
    ### Column 0.
    c0: Vector[B32, 4]
    ### Column 1.
    c1: Vector[B32, 4]
    ### Column 2.
    c2: Vector[B32, 4]
    ### Column 3.
    c3: Vector[B32, 4]

### A 4-row, 4-column single-precision matrix, stored **column-major** as four
### SIMD column vectors (`Vector[B32, 4]`). This layout matches the GPU convention
### (GLSL/WGSL column-major) and lets `matrix · vector` lower to hardware vector
### FMA on the columns.
###
### Conventions: **column-major**, **right-handed**, angles in **radians**. Element
### `(row, col)` lives at `column[col][row]`.
###
### The projection/view builders (`perspective`, `orthographic`, `look_at`) live
### separately; this file covers construction, arithmetic, `transpose`,
### `determinant`, `inverse`, and the affine builders (translation / scaling /
### rotation / from-quaternion).

# ============================================================================
# Column helper
# ============================================================================

### Builds a `Vector[B32, 4]` from its four lanes (no bounds-checked setitem — uses
### the raw `insert_element` intrinsic, like the SIMD splat constructor).
### :param x: Lane 0.
### :param y: Lane 1.
### :param z: Lane 2.
### :param w: Lane 3.
### :returns: The packed 4-lane vector `<x, y, z, w>`.
@positional
routine vec4(x: B32, y: B32, z: B32, w: B32) -> Vector[B32, 4]
    var v = LLVM::zero_value[Vector[B32, 4]]()
    v = LLVM::insert_element[Vector[B32, 4], B32](v, x, 0u64)
    v = LLVM::insert_element[Vector[B32, 4], B32](v, y, 1u64)
    v = LLVM::insert_element[Vector[B32, 4], B32](v, z, 2u64)
    v = LLVM::insert_element[Vector[B32, 4], B32](v, w, 3u64)
    return v

# ============================================================================
# Constructors / factories
# ============================================================================

### The 4x4 identity matrix.
### :returns: A matrix with ones on the diagonal, zeros elsewhere.
common routine Matrix4R4C.identity() -> Matrix4R4C
    return Matrix4R4C(
        c0: vec4(1.0_b32, 0.0_b32, 0.0_b32, 0.0_b32),
        c1: vec4(0.0_b32, 1.0_b32, 0.0_b32, 0.0_b32),
        c2: vec4(0.0_b32, 0.0_b32, 1.0_b32, 0.0_b32),
        c3: vec4(0.0_b32, 0.0_b32, 0.0_b32, 1.0_b32),
    )

### The 4x4 zero matrix (every element zero).
### :returns: A matrix of all zeros.
common routine Matrix4R4C.zero() -> Matrix4R4C
    var z = LLVM::zero_value[Vector[B32, 4]]()
    return Matrix4R4C(c0: z, c1: z, c2: z, c3: z)

### An affine translation matrix.
### :param tx: X translation.
### :param ty: Y translation.
### :param tz: Z translation.
### :returns: The translation matrix (identity with `(tx, ty, tz)` in column 3).
common routine Matrix4R4C.translation(tx: B32, ty: B32, tz: B32) -> Matrix4R4C
    return Matrix4R4C(
        c0: vec4(1.0_b32, 0.0_b32, 0.0_b32, 0.0_b32),
        c1: vec4(0.0_b32, 1.0_b32, 0.0_b32, 0.0_b32),
        c2: vec4(0.0_b32, 0.0_b32, 1.0_b32, 0.0_b32),
        c3: vec4(tx, ty, tz, 1.0_b32),
    )

### A non-uniform scaling matrix.
### :param sx: X scale.
### :param sy: Y scale.
### :param sz: Z scale.
### :returns: The scaling matrix.
common routine Matrix4R4C.scaling(sx: B32, sy: B32, sz: B32) -> Matrix4R4C
    return Matrix4R4C(
        c0: vec4(sx, 0.0_b32, 0.0_b32, 0.0_b32),
        c1: vec4(0.0_b32, sy, 0.0_b32, 0.0_b32),
        c2: vec4(0.0_b32, 0.0_b32, sz, 0.0_b32),
        c3: vec4(0.0_b32, 0.0_b32, 0.0_b32, 1.0_b32),
    )

### A right-handed rotation about the X axis.
### :param angle: The rotation angle in radians.
### :returns: The rotation matrix.
common routine Matrix4R4C.rotation_x(angle: B32) -> Matrix4R4C
    var c = angle.cos()
    var s = angle.sin()
    return Matrix4R4C(
        c0: vec4(1.0_b32, 0.0_b32, 0.0_b32, 0.0_b32),
        c1: vec4(0.0_b32, c, s, 0.0_b32),
        c2: vec4(0.0_b32, -s, c, 0.0_b32),
        c3: vec4(0.0_b32, 0.0_b32, 0.0_b32, 1.0_b32),
    )

### A right-handed rotation about the Y axis.
### :param angle: The rotation angle in radians.
### :returns: The rotation matrix.
common routine Matrix4R4C.rotation_y(angle: B32) -> Matrix4R4C
    var c = angle.cos()
    var s = angle.sin()
    return Matrix4R4C(
        c0: vec4(c, 0.0_b32, -s, 0.0_b32),
        c1: vec4(0.0_b32, 1.0_b32, 0.0_b32, 0.0_b32),
        c2: vec4(s, 0.0_b32, c, 0.0_b32),
        c3: vec4(0.0_b32, 0.0_b32, 0.0_b32, 1.0_b32),
    )

### A right-handed rotation about the Z axis.
### :param angle: The rotation angle in radians.
### :returns: The rotation matrix.
common routine Matrix4R4C.rotation_z(angle: B32) -> Matrix4R4C
    var c = angle.cos()
    var s = angle.sin()
    return Matrix4R4C(
        c0: vec4(c, s, 0.0_b32, 0.0_b32),
        c1: vec4(-s, c, 0.0_b32, 0.0_b32),
        c2: vec4(0.0_b32, 0.0_b32, 1.0_b32, 0.0_b32),
        c3: vec4(0.0_b32, 0.0_b32, 0.0_b32, 1.0_b32),
    )

### A rotation matrix from a (unit) quaternion.
### :param q: The rotation quaternion (assumed normalized).
### :returns: The equivalent rotation matrix.
common routine Matrix4R4C.from_quaternion(q: Q128) -> Matrix4R4C
    return C::ingrid_m4_from_quaternion(w: q.w, x: q.x, y: q.y, z: q.z)

# ============================================================================
# Element access
# ============================================================================

### Returns column `index` (0 to 3) as a `Vector[B32, 4]`.
### :param index: The column index.
### :returns: The column vector.
@readonly
routine Matrix4R4C.column(index: U64) -> Vector[B32, 4]
    if index == 0u64
        return me.c0
    if index == 1u64
        return me.c1
    if index == 2u64
        return me.c2
    return me.c3

### Returns the element at `(row, col)` (both 0 to 3).
### :param row: The row index.
### :param col: The column index.
### :returns: The scalar element.
@readonly
routine Matrix4R4C.get(row: U64, col: U64) -> B32
    return LLVM::extract_element[Vector[B32, 4], B32](me.column(index: col), row)

### Returns row `index` (0 to 3) as a `Vector[B32, 4]` — the `me[index]` read operator. Chained subscripts
### read naturally as `m[row][col]`: `m[row]` yields the row vector (gathered across the stored columns),
### and the second subscript picks the column element via `Vector`'s own `getitem`.
### :param index: The row index (0 to 3).
### :returns: The row vector `<m(row,0), m(row,1), m(row,2), m(row,3)>`.
### :throws: {IndexOutOfBoundsError} if `index >= 4`.
@readonly
routine Matrix4R4C.getitem!(index: U64) -> Vector[B32, 4]
    if index >= 4u64
        throw IndexOutOfBoundsError(index: index, count: 4u64)
    return vec4(
        LLVM::extract_element[Vector[B32, 4], B32](me.c0, index),
        LLVM::extract_element[Vector[B32, 4], B32](me.c1, index),
        LLVM::extract_element[Vector[B32, 4], B32](me.c2, index),
        LLVM::extract_element[Vector[B32, 4], B32](me.c3, index),
    )

# ============================================================================
# Arithmetic
# ============================================================================

### Element-wise matrix sum.
### :param you: The matrix to add.
### :returns: `me + you`.
routine Matrix4R4C.add(you: Matrix4R4C) -> Matrix4R4C
    return Matrix4R4C(
        c0: me.c0 + you.c0,
        c1: me.c1 + you.c1,
        c2: me.c2 + you.c2,
        c3: me.c3 + you.c3,
    )

### Element-wise matrix difference.
### :param you: The matrix to subtract.
### :returns: `me - you`.
routine Matrix4R4C.sub(you: Matrix4R4C) -> Matrix4R4C
    return Matrix4R4C(
        c0: me.c0 - you.c0,
        c1: me.c1 - you.c1,
        c2: me.c2 - you.c2,
        c3: me.c3 - you.c3,
    )

### Element-wise negation.
### :returns: `-me`.
routine Matrix4R4C.neg() -> Matrix4R4C
    return Matrix4R4C(c0: -me.c0, c1: -me.c1, c2: -me.c2, c3: -me.c3)

### Scales every element by a scalar.
### :param factor: The scalar multiplier.
### :returns: `factor · me`.
routine Matrix4R4C.scale(factor: B32) -> Matrix4R4C
    return Matrix4R4C(
        c0: me.c0.scale(factor: factor),
        c1: me.c1.scale(factor: factor),
        c2: me.c2.scale(factor: factor),
        c3: me.c3.scale(factor: factor),
    )

### Transforms a homogeneous vector: `me · v` (matrix times column vector).
### :param v: The vector to transform.
### :returns: `me · v`, computed as `c0·v.x + c1·v.y + c2·v.z + c3·v.w`.
@readonly
routine Matrix4R4C.transform(v: Vector[B32, 4]) -> Vector[B32, 4]
    var vx = LLVM::extract_element[Vector[B32, 4], B32](v, 0u64)
    var vy = LLVM::extract_element[Vector[B32, 4], B32](v, 1u64)
    var vz = LLVM::extract_element[Vector[B32, 4], B32](v, 2u64)
    var vw = LLVM::extract_element[Vector[B32, 4], B32](v, 3u64)
    return me.c0.scale(factor: vx) + me.c1.scale(factor: vy) + me.c2.scale(factor: vz) + me.c3.scale(factor: vw)

### Matrix product `me · you`. Each result column is `me · you.column`.
### :param you: The right-hand matrix.
### :returns: `me · you`.
routine Matrix4R4C.mul(you: Matrix4R4C) -> Matrix4R4C
    return Matrix4R4C(
        c0: me.transform(v: you.c0),
        c1: me.transform(v: you.c1),
        c2: me.transform(v: you.c2),
        c3: me.transform(v: you.c3),
    )

### The transpose (rows and columns swapped).
### :returns: `meᵀ`.
@readonly
routine Matrix4R4C.transpose() -> Matrix4R4C
    # SSE `_MM_TRANSPOSE4_PS`: four shuffles to interleave, four to recombine. The transposed matrix's
    # columns are the original's rows, produced without any scalar lane extraction.
    var tmp0 = LLVM::shuffle_unpacklo_4[Vector[B32, 4]](me.c0, me.c1)
    var tmp1 = LLVM::shuffle_unpacklo_4[Vector[B32, 4]](me.c2, me.c3)
    var tmp2 = LLVM::shuffle_unpackhi_4[Vector[B32, 4]](me.c0, me.c1)
    var tmp3 = LLVM::shuffle_unpackhi_4[Vector[B32, 4]](me.c2, me.c3)
    return Matrix4R4C(
        c0: LLVM::shuffle_movelh_4[Vector[B32, 4]](tmp0, tmp1),
        c1: LLVM::shuffle_movehl_4[Vector[B32, 4]](tmp0, tmp1),
        c2: LLVM::shuffle_movelh_4[Vector[B32, 4]](tmp2, tmp3),
        c3: LLVM::shuffle_movehl_4[Vector[B32, 4]](tmp2, tmp3),
    )

# ============================================================================
# Determinant / inverse
# ============================================================================

### The determinant of this matrix.
### :returns: `det(me)`.
@readonly
routine Matrix4R4C.determinant() -> B32
    return C::ingrid_m4_determinant(
        m00: me.get(row: 0u64, col: 0u64),
        m01: me.get(row: 0u64, col: 1u64),
        m02: me.get(row: 0u64, col: 2u64),
        m03: me.get(row: 0u64, col: 3u64),
        m10: me.get(row: 1u64, col: 0u64),
        m11: me.get(row: 1u64, col: 1u64),
        m12: me.get(row: 1u64, col: 2u64),
        m13: me.get(row: 1u64, col: 3u64),
        m20: me.get(row: 2u64, col: 0u64),
        m21: me.get(row: 2u64, col: 1u64),
        m22: me.get(row: 2u64, col: 2u64),
        m23: me.get(row: 2u64, col: 3u64),
        m30: me.get(row: 3u64, col: 0u64),
        m31: me.get(row: 3u64, col: 1u64),
        m32: me.get(row: 3u64, col: 2u64),
        m33: me.get(row: 3u64, col: 3u64),
    )

### The inverse of this matrix. A singular matrix (determinant 0) yields the zero
### matrix.
### :returns: `me⁻¹`, or the zero matrix if `me` is singular.
@readonly
routine Matrix4R4C.inverse() -> Matrix4R4C
    return C::ingrid_m4_inverse(
        m00: me.get(row: 0u64, col: 0u64),
        m01: me.get(row: 0u64, col: 1u64),
        m02: me.get(row: 0u64, col: 2u64),
        m03: me.get(row: 0u64, col: 3u64),
        m10: me.get(row: 1u64, col: 0u64),
        m11: me.get(row: 1u64, col: 1u64),
        m12: me.get(row: 1u64, col: 2u64),
        m13: me.get(row: 1u64, col: 3u64),
        m20: me.get(row: 2u64, col: 0u64),
        m21: me.get(row: 2u64, col: 1u64),
        m22: me.get(row: 2u64, col: 2u64),
        m23: me.get(row: 2u64, col: 3u64),
        m30: me.get(row: 3u64, col: 0u64),
        m31: me.get(row: 3u64, col: 1u64),
        m32: me.get(row: 3u64, col: 2u64),
        m33: me.get(row: 3u64, col: 3u64),
    )

# ============================================================================
# Comparison / display
# ============================================================================

### Returns `true` when all sixteen elements compare equal.
### :param you: The matrix to compare against.
### :returns: `true` if every column matches.
routine Matrix4R4C.eq(you: Matrix4R4C) -> Bool
    return me.c0 == you.c0 and me.c1 == you.c1 and me.c2 == you.c2 and me.c3 == you.c3

### Formats the matrix row by row as `[[…], [-…], …]`.
### :returns: The resulting `Text` value.
@readonly
@override
routine Matrix4R4C.represent() -> Text
    var result = "["
    var r = 0u64
    while r < 4u64
        if r > 0u64
            result = result + ", "
        result = result + "[" + me.get(row: r, col: 0u64).represent() + ", " + me
            .get(row: r, col: 1u64)
            .represent()
        result = result + ", " + me.get(row: r, col: 2u64).represent() + ", " + me
            .get(row: r, col: 3u64)
            .represent() + "]"
        r = r + 1u64
    result = result + "]"
    return result

### Returns a diagnostic string wrapping the value with its type name.
### :returns: The resulting `Text` value.
@readonly
@override
routine Matrix4R4C.diagnose() -> Text
    return "Math3D.Matrix4R4C(" + me.represent() + ")"

# ============================================================================
# Ingrid (Ingrid/tessera/matrix.tess)
# ============================================================================
# The determinant, the inverse and the rotation from a quaternion: the elements go in as `m{row}{col}`, and a
# matrix comes back as itself (64 bytes, returned through a hidden pointer on every target).

routine C::ingrid_m4_determinant(
    m00: B32,
    m01: B32,
    m02: B32,
    m03: B32,
    m10: B32,
    m11: B32,
    m12: B32,
    m13: B32,
    m20: B32,
    m21: B32,
    m22: B32,
    m23: B32,
    m30: B32,
    m31: B32,
    m32: B32,
    m33: B32,
) -> B32

routine C::ingrid_m4_inverse(
    m00: B32,
    m01: B32,
    m02: B32,
    m03: B32,
    m10: B32,
    m11: B32,
    m12: B32,
    m13: B32,
    m20: B32,
    m21: B32,
    m22: B32,
    m23: B32,
    m30: B32,
    m31: B32,
    m32: B32,
    m33: B32,
) -> Matrix4R4C

routine C::ingrid_m4_from_quaternion(w: B32, x: B32, y: B32, z: B32) -> Matrix4R4C
