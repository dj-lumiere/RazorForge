module Core

# ============================================================================
# B128Wx — the 384-bit tier behind the B128, D128, D64 and D32 transcendentals.
# A value is (-1)^neg * m * 2^e with m a 384-bit integer (limbs m2 m1 m0, m2 the most significant, its top
# bit set; the value is zero when m2 is 0) and a bound rel on its relative error that every operation
# carries, as B128Fx does at 128 bits. exp and expm1 are Taylor series after a reduction, sine and cosine
# come from the CORE-MATH 384-bit table of sin / cos(j pi/256) and short series, log1p takes one Newton
# step from the B64 value (log goes through log1p), atan one from the B64 arctangent, and the rest follow
# by identities. The fast paths hand over the inputs whose 128-bit band reaches a rounding midpoint, and a
# result from here is rounded once, from a band of about 2^-360 of it (as it stands when even that band
# is undecided).
# ============================================================================

### A 384-bit binary value with a relative error bound.
secret record B128Wx
  neg: Bool
  m2: U128
  m1: U128
  m0: U128
  e: S64
  rel: B64

### Zero, exact when rel is 0 (a sum that cancels to zero from inexact operands carries an unbounded rel).
@inline
secret routine wx_zero(rel: B64) -> B128Wx
  return B128Wx(neg: false, m2: 0_u128, m1: 0_u128, m0: 0_u128, e: 0_s64, rel: rel)

@inline
secret routine wx_is_zero(w: B128Wx) -> Bool
  return w.m2 == 0_u128

### The significand as the (low, middle, high) triple the 384-bit helpers take.
@inline
secret routine wx_t(w: B128Wx) -> (U128, U128, U128)
  return (w.m0, w.m1, w.m2)

### (-1)^neg * t * 2^e for a 384-bit t, normalized (zero when t is).
secret routine wx_make(neg: Bool, t: (U128, U128, U128), e: S64, rel: B64) -> B128Wx
  var lz = b128_trig_lz384(x: t)
  if lz == 384_s64
    return wx_zero(rel: rel)
  var s = b128_trig_shl384(x: t, shift: lz)
  return B128Wx(neg: neg, m2: s.item2, m1: s.item1, m0: s.item0, e: e -% lz, rel: rel)

### w with its bound raised by r.
@inline
secret routine wx_widen(w: B128Wx, r: B64) -> B128Wx
  return B128Wx(neg: w.neg, m2: w.m2, m1: w.m1, m0: w.m0, e: w.e, rel: w.rel +! r)

@inline
secret routine wx_neg(w: B128Wx) -> B128Wx
  return B128Wx(neg: not w.neg, m2: w.m2, m1: w.m1, m0: w.m0, e: w.e, rel: w.rel)

@inline
secret routine wx_abs(w: B128Wx) -> B128Wx
  return B128Wx(neg: false, m2: w.m2, m1: w.m1, m0: w.m0, e: w.e, rel: w.rel)

### w * 2^k (exact).
@inline
secret routine wx_scale(w: B128Wx, k: S64) -> B128Wx
  return B128Wx(neg: w.neg, m2: w.m2, m1: w.m1, m0: w.m0, e: w.e +% k, rel: w.rel)

### floor(log2 |w|) for a nonzero w.
@inline
secret routine wx_ilog2(w: B128Wx) -> S64
  return w.e +% 383_s64

### k with |w| < 2^-k, for a nonzero w.
@inline
secret routine wx_below(w: B128Wx) -> S64
  return -384_s64 -% w.e

### A 384-bit integer as a B64 within 2^-52 of it.
secret routine wx_t_b64(t: (U128, U128, U128)) -> B64
  var lz = b128_trig_lz384(x: t)
  if lz == 384_s64
    return 0.0
  var s = b128_trig_shl384(x: t, shift: lz)
  return b128fx_top(m: s.item2) *! b128fx_p2(k: 320_s64 -% lz)

### w as a B64 within 2^-52 of it (+-inf or 0 outside the B64 range).
secret routine wx_b64(w: B128Wx) -> B64
  if wx_is_zero(w: w)
    return 0.0
  var v = (b128fx_top(m: w.m2) *! 0x1p-63).scaleb_unchecked(n: w.e +% 383_s64)
  if w.neg
    return 0.0 -! v
  return v

### round(v) for a B64 below 2^62 in magnitude, halves away from zero.
@inline
secret routine wx_round_b64(v: B64) -> S64
  if v < 0.0
    return LLVM::float_to_signed[B64, S64](v -! 0.5)
  return LLVM::float_to_signed[B64, S64](v +! 0.5)

### Whether a > b as 384-bit integers.
@inline
secret routine wx_t_gt(a: (U128, U128, U128), b: (U128, U128, U128)) -> Bool
  if a.item2 != b.item2
    return a.item2 > b.item2
  if a.item1 != b.item1
    return a.item1 > b.item1
  return a.item0 > b.item0

### Entry i of WX_TABLE, within half a unit of its last place: 0 ln 2, 1 pi, 2 pi/256, 3 1/ln 2, 4 1/ln 10,
### 5 ln(2 pi)/2, 6 ln pi, 7 2/sqrt(pi), 8 1/sqrt(pi), 9 pi/2, 10 + i 10^(2^i) and 24 + i 10^-(2^i) for
### i = 0..13, 37 + k |B_2k| / (2k (2k - 1)) for k = 1..41.
secret routine wx_table(i: U64) -> B128Wx
  var k = i *% 3_u64
  return B128Wx(neg: false, m2: WX_TABLE[k], m1: WX_TABLE[k +% 1_u64], m0: WX_TABLE[k +% 2_u64], e: WX_TABLE_E[i], rel: 0x1p-384)

### 1/k! for 0 <= k <= 110, within half a unit of its last place.
secret routine wx_inv_fact(k: S64) -> B128Wx
  var i = LLVM::reinterpret_bits[S64, U64](k)
  var j = i *% 3_u64
  return B128Wx(neg: false, m2: WX_INV_FACT[j], m1: WX_INV_FACT[j +% 1_u64], m0: WX_INV_FACT[j +% 2_u64], e: WX_INV_FACT_E[i], rel: 0x1p-384)

### 1 (exact).
@inline
secret routine wx_one() -> B128Wx
  return B128Wx(neg: false, m2: 1_u128 << 127_u32, m1: 0_u128, m0: 0_u128, e: -383_s64, rel: 0.0)

### A U128 integer (exact).
secret routine wx_of_u128(v: U128) -> B128Wx
  return wx_make(neg: false, t: (0_u128, 0_u128, v), e: -256_s64, rel: 0.0)

### A U256 integer (exact).
secret routine wx_of_u256(v: U256) -> B128Wx
  return wx_make(neg: false, t: (0_u128, LLVM::int_truncate[U256, U128](v), LLVM::int_truncate[U256, U128](v >>> 128_u32)), e: -128_s64, rel: 0.0)

### An S64 integer (exact).
secret routine wx_of_s64(v: S64) -> B128Wx
  var u = LLVM::reinterpret_bits[S64, U64](v)
  if v < 0_s64
    return wx_neg(w: wx_of_u128(v: LLVM::zero_extend[U64, U128](0_u64 -% u)))
  return wx_of_u128(v: LLVM::zero_extend[U64, U128](u))

### c * p as a 384-bit integer (low, middle, high), exact for c * p below 2^384.
secret routine wx_product_t(c: U128, p: U256) -> (U128, U128, U128)
  var lo = b128_trig_wmul(x: c, y: LLVM::int_truncate[U256, U128](p))
  var hi = b128_trig_wmul(x: c, y: LLVM::int_truncate[U256, U128](p >>> 128_u32))
  var (w1, cy) = b128t_add(a: lo.item0, b: hi.item1, cin: 0_u128)
  return (lo.item1, w1, hi.item0 +% cy)

### A finite B128 (exact; zero included).
secret routine wx_of_b128(x: B128) -> B128Wx
  var bits = x.to_bits()
  var neg = (bits >>> 127_u32) != 0_u128
  var ex = LLVM::int_truncate[U128, S64]((bits >>> 112_u32) & 0x7FFF_u128)
  var f = bits & ((1_u128 << 112_u32) -% 1_u128)
  if ex == 0_s64
    return wx_make(neg: neg, t: (0_u128, 0_u128, f), e: -16750_s64, rel: 0.0)
  return wx_make(neg: neg, t: (0_u128, 0_u128, f | (1_u128 << 112_u32)), e: ex -% 16751_s64, rel: 0.0)

### A finite B64 (exact).
secret routine wx_of_b64(v: B64) -> B128Wx
  return wx_of_b128(x: B128(from: v))

# ============================================================================
# Arithmetic
# ============================================================================

### a * b: the top half of the 384 x 384-bit product (at most four units short), normalized (one more unit).
secret routine wx_mul(a: B128Wx, b: B128Wx) -> B128Wx
  if wx_is_zero(w: a)
    return wx_zero(rel: a.rel)
  if wx_is_zero(w: b)
    return wx_zero(rel: b.rel)
  var p = b128_trig_mul384(a: wx_t(w: a), b: wx_t(w: b))
  var e = a.e +% b.e +% 384_s64
  if (p.item2 >>> 127_u32) == 0_u128
    p = b128_trig_shl384(x: p, shift: 1_s64)
    e = e -% 1_s64
  return B128Wx(neg: a.neg != b.neg, m2: p.item2, m1: p.item1, m0: p.item0, e: e, rel: a.rel +! b.rel +! a.rel *! b.rel +! 0x1p-379)

### a + b. The smaller operand is aligned to the larger one's last place (one unit lost at most), a carry out
### of the top shifts one more unit away, and cancellation scales the operands' absolute errors by the size
### of the sum, which the bound follows. A sum that cancels exactly is an exact zero when both operands were
### exact and aligned without loss, else a zero of unbounded error.
secret routine wx_add(a: B128Wx, b: B128Wx) -> B128Wx
  if wx_is_zero(w: a)
    return wx_widen(w: b, r: a.rel)
  if wx_is_zero(w: b)
    return wx_widen(w: a, r: b.rel)
  var x = a
  var y = b
  if b.e > a.e or (b.e == a.e and wx_t_gt(a: wx_t(w: b), b: wx_t(w: a)))
    x = b
    y = a
  var d = x.e -% y.e
  var xt = wx_t(w: x)
  var ys = b128_trig_shr384(x: wx_t(w: y), shift: d)
  var lost = 0.0
  if d > 0_s64
    lost = 1.0
  var e = x.e
  var s = xt
  var carry = 0.0
  if x.neg == y.neg
    s = b128_trig_add384(a: xt, b: ys)
    if wx_t_gt(a: xt, b: s)
      var h = b128_trig_shr384(x: s, shift: 1_s64)
      s = (h.item0, h.item1, h.item2 | (1_u128 << 127_u32))
      e = e +% 1_s64
      carry = 1.0
  else
    s = b128_trig_sub384(a: xt, b: ys)
  var lz = b128_trig_lz384(x: s)
  if lz == 384_s64
    if x.rel == 0.0 and y.rel == 0.0 and d == 0_s64
      return wx_zero(rel: 0.0)
    return wx_zero(rel: 0x1p1023 *! 4.0)
  var sn = b128_trig_shl384(x: s, shift: lz)
  var en = e -% lz
  # absolute errors in units of 2^x.e: the operands' own, the aligned operand's truncation, the carry's bit
  var xv = b128fx_top(m: x.m2) *! b128fx_p2(k: 320_s64)
  var yv = 0.0
  if d < 1000_s64
    yv = (b128fx_top(m: y.m2) *! 0x1p-63).scaleb_unchecked(n: 383_s64 -% d)
  var sv = (b128fx_top(m: sn.item2) *! 0x1p-63).scaleb_unchecked(n: 383_s64 +% en -% x.e)
  var abserr = (x.rel *! xv +! y.rel *! yv) *! (1.0 +! 0x1p-50) +! lost +! carry
  return B128Wx(neg: x.neg, m2: sn.item2, m1: sn.item1, m0: sn.item0, e: en, rel: abserr /! sv *! (1.0 +! 0x1p-50))

### a - b.
@inline
secret routine wx_sub(a: B128Wx, b: B128Wx) -> B128Wx
  return wx_add(a: a, b: wx_neg(w: b))

### w / k for 1 < k < 2^32: the 448-bit quotient of m * 2^64 by k, 32 bits at a time (each step a 64-bit
### division, the remainder below k), its top 384 bits kept (two units at most).
secret routine wx_div_small(w: B128Wx, k: U64) -> B128Wx
  if wx_is_zero(w: w)
    return w
  var limbs = Array[U64, 7]()
  limbs[6_u64] = LLVM::int_truncate[U128, U64](w.m2 >>> 64_u32)
  limbs[5_u64] = LLVM::int_truncate[U128, U64](w.m2)
  limbs[4_u64] = LLVM::int_truncate[U128, U64](w.m1 >>> 64_u32)
  limbs[3_u64] = LLVM::int_truncate[U128, U64](w.m1)
  limbs[2_u64] = LLVM::int_truncate[U128, U64](w.m0 >>> 64_u32)
  limbs[1_u64] = LLVM::int_truncate[U128, U64](w.m0)
  var q = Array[U64, 7]()
  var rem = 0_u64
  var i = 7_u64
  while i > 0_u64
    i = i -% 1_u64
    var cur = (rem << 32_u32) | (limbs[i] >>> 32_u32)
    var qh = cur // k
    rem = cur -% qh *% k
    cur = (rem << 32_u32) | (limbs[i] & 0xFFFFFFFF_u64)
    var ql = cur // k
    rem = cur -% ql *% k
    q[i] = (qh << 32_u32) | ql
  var t = (b128_trig_u128(hi: q[2_u64], lo: q[1_u64]), b128_trig_u128(hi: q[4_u64], lo: q[3_u64]), b128_trig_u128(hi: q[6_u64], lo: q[5_u64]))
  var lz = b128_trig_lz384(x: t)
  var s = b128_trig_shl384(x: t, shift: lz)
  if lz > 0_s64
    s = (s.item0 | (LLVM::zero_extend[U64, U128](q[0_u64]) >>> b128_trig_sh(n: 64_s64 -% lz)), s.item1, s.item2)
  return B128Wx(neg: w.neg, m2: s.item2, m1: s.item1, m0: s.item0, e: w.e -% lz, rel: w.rel +! 0x1p-381)

### a / b for b nonzero: 1/b by three Newton steps r (2 - b r) from the B64 reciprocal (2^-52, then about
### 2^-104, 2^-208 and the rounding of the steps), times a.
secret routine wx_div(a: B128Wx, b: B128Wx) -> B128Wx
  if wx_is_zero(w: a)
    return wx_zero(rel: a.rel)
  var bn = B128Wx(neg: false, m2: b.m2, m1: b.m1, m0: b.m0, e: -384_s64, rel: 0.0)
  var r = wx_of_b64(v: 1.0 /! (b128fx_top(m: b.m2) *! 0x1p-64))
  var two = wx_scale(w: wx_one(), k: 1_s64)
  var i = 0_s64
  while i < 3_s64
    r = wx_mul(a: r, b: wx_sub(a: two, b: wx_mul(a: bn, b: r)))
    i = i +% 1_s64
  var q = wx_mul(a: B128Wx(neg: a.neg != b.neg, m2: a.m2, m1: a.m1, m0: a.m0, e: a.e, rel: 0.0), b: r)
  return B128Wx(neg: q.neg, m2: q.m2, m1: q.m1, m0: q.m0, e: q.e -% b.e -% 384_s64, rel: a.rel +! b.rel +! 0x1p-374)

### sqrt(a) for a >= 0: 1/sqrt by three Newton steps y (3 - A y^2) / 2 from the B64 value, times A (A the
### significand scaled to [1/2, 2) with an even power of two left over).
secret routine wx_sqrt(a: B128Wx) -> B128Wx
  if wx_is_zero(w: a)
    return a
  var big = a.e +% 384_s64
  var aa = B128Wx(neg: false, m2: a.m2, m1: a.m1, m0: a.m0, e: -384_s64, rel: 0.0)
  if (big & 1_s64) != 0_s64
    aa = wx_scale(w: aa, k: 1_s64)
    big = big -% 1_s64
  var y = wx_of_b64(v: 1.0 /! wx_b64(w: aa).sqrt_unchecked())
  var three = wx_of_u128(v: 3_u128)
  var i = 0_s64
  while i < 3_s64
    y = wx_scale(w: wx_mul(a: y, b: wx_sub(a: three, b: wx_mul(a: aa, b: wx_mul(a: y, b: y)))), k: -1_s64)
    i = i +% 1_s64
  var s = wx_mul(a: aa, b: y)
  return B128Wx(neg: false, m2: s.m2, m1: s.m1, m0: s.m0, e: s.e +% (big >> 1), rel: a.rel *! 0.5 +! 0x1p-372)

# ============================================================================
# Powers of ten and decimal inputs
# ============================================================================

### 10^n: exact for 0 <= n <= 76 (a U256), else the product of the tabled 10^(+-2^i) over the bits of |n|
### (|n| < 16384).
secret routine wx_pow10(n: S64) -> B128Wx
  if n >= 0_s64 and n <= 76_s64
    return wx_of_u256(v: pow10_tbl(k: n))
  var base = 10_u64
  var a = n
  if n < 0_s64
    base = 24_u64
    a = 0_s64 -% n
  var r = wx_one()
  var i = 0_u64
  while a != 0_s64
    if (a & 1_s64) != 0_s64
      r = wx_mul(a: r, b: wx_table(i: base +% i))
    a = a >> 1
    i = i +% 1_u64
  return r

### (-1)^neg * c * 10^q for c < 2^113: exact when q is 0..76 (an integer product) or when q < 0 and 5^-q
### divides c (a binary fraction), else within about 2^-372.
secret routine wx_of_decimal(neg: Bool, c: U128, q: S64) -> B128Wx
  var w = wx_zero(rel: 0.0)
  if c == 0_u128
    return w
  if q >= 0_s64 and q <= 76_s64
    w = wx_make(neg: false, t: wx_product_t(c: c, p: pow10_tbl(k: q)), e: 0_s64, rel: 0.0)
  elseif q < 0_s64 and q >= -48_s64 and c % b128t_pow5(p: 0_s64 -% q) == 0_u128
    w = wx_scale(w: wx_of_u128(v: c // b128t_pow5(p: 0_s64 -% q)), k: q)
  elseif q < 0_s64 and q >= -76_s64
    w = wx_div(a: wx_of_u128(v: c), b: wx_of_u256(v: pow10_tbl(k: 0_s64 -% q)))
  else
    w = wx_mul(a: wx_of_u128(v: c), b: wx_pow10(n: q))
  if neg
    return wx_neg(w: w)
  return w

### A finite D128 (see wx_of_decimal).
@inline
secret routine wx_of_d128(p: D128Parts) -> B128Wx
  return wx_of_decimal(neg: p.sign, c: p.coeff, q: p.exp)

# ============================================================================
# Rounding
# ============================================================================

### (whether the band settles it, the IEEE bits) of w rounded to nearest-even in a binary format with a p-bit
### significand, exponent bias emax and the sign bit at sbit: subnormal results and overflow to infinity
### included. Unsettled means w's band reaches the midpoint between two neighbours (force rounds anyway).
secret routine wx_round_ieee(w: B128Wx, p: S64, emax: S64, sbit: S64, force: Bool) -> (Bool, U128)
  var sign = 0_u128
  if w.neg
    sign = 1_u128 << b128_trig_sh(n: sbit)
  if wx_is_zero(w: w)
    return (force or w.rel == 0.0, sign)
  var pw = b128_trig_sh(n: p -% 1_s64)
  var lead = wx_ilog2(w: w)
  if lead > emax
    return (true, sign | (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](emax *% 2_s64 +% 1_s64)) << pw))
  var emin = 1_s64 -% emax
  var k = p
  if lead < emin
    k = p -% (emin -% lead)
  if k < -2_s64
    return (force or w.rel < 0.25, sign)
  var t = wx_t(w: w)
  var keep = 0_u128
  var rs = t
  var trunc = 0.0
  if k > 0_s64
    keep = w.m2 >>> b128_trig_sh(n: 128_s64 -% k)
    rs = b128_trig_shl384(x: t, shift: k)
  elseif k < 0_s64
    rs = b128_trig_shr384(x: t, shift: 0_s64 -% k)
    trunc = 1.0
  # the dropped bits against one half of the last kept place, in units of 2^-384 of it
  var half = (0_u128, 0_u128, 1_u128 << 127_u32)
  var above = not wx_t_gt(a: half, b: rs)
  var dist = b128_trig_sub384(a: half, b: rs)
  if above
    dist = b128_trig_sub384(a: rs, b: half)
  var errb = w.rel *! b128fx_top(m: w.m2) *! b128fx_p2(k: 320_s64 +% k) *! (1.0 +! 0x1p-50) +! trunc
  var ok = force or errb == 0.0 or wx_t_b64(t: dist) > errb
  if above and (b128_trig_lz384(x: dist) < 384_s64 or (keep & 1_u128) == 1_u128)
    keep = keep +% 1_u128
  var bits = keep
  if lead >= emin
    bits = (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](lead +% emax)) << pw) +% (keep -% (1_u128 << pw))
  return (ok, sign | bits)

### w rounded to a B128, and whether its band settles that.
secret routine wx_to_b128(w: B128Wx, force: Bool) -> (Bool, B128)
  var (ok, bits) = wx_round_ieee(w: w, p: 113_s64, emax: 16383_s64, sbit: 127_s64, force: force)
  return (ok, B128.from_bits(bits: bits))

### w rounded to a B128 as it stands.
@inline
secret routine wx_b128(w: B128Wx) -> B128
  return wx_to_b128(w: w, force: true).item1

### w rounded to a B64, and whether its band settles that.
secret routine wx_to_b64(w: B128Wx, force: Bool) -> (Bool, B64)
  var (ok, bits) = wx_round_ieee(w: w, p: 53_s64, emax: 1023_s64, sbit: 63_s64, force: force)
  return (ok, B64.from_bits(bits: LLVM::int_truncate[U128, U64](bits)))

### 5^p as a U256, for 0 <= p <= 110.
secret routine wx_pow5(p: S64) -> U256
  if p <= 55_s64
    return LLVM::zero_extend[U128, U256](b128t_pow5(p: p))
  var pr = b128_trig_wmul(x: b128t_pow5(p: 55_s64), y: b128t_pow5(p: p -% 55_s64))
  return (LLVM::zero_extend[U128, U256](pr.item0) << 128_u32) | LLVM::zero_extend[U128, U256](pr.item1)

### For an exact w of at most 113 significant bits, w * 10^-q exactly when it is a binary fraction that fits
### (the only way it can sit exactly halfway between integers): (fits, its integer part, -1 / 0 / 1 as the
### fraction is below, at or above one half).
secret routine wx_dec_exact(w: B128Wx, q: S64) -> (Bool, U128, S64)
  if w.m1 != 0_u128 or w.m0 != 0_u128 or (w.m2 & 0x7FFF_u128) != 0_u128
    return (false, 0_u128, 0_s64)
  var mm = w.m2 >>> 15_u32
  var tz = LLVM::int_truncate[U128, S64](LLVM::trailing_zeros(mm))
  mm = mm >>> b128_trig_sh(n: tz)
  var ex = w.e +% 271_s64 +% tz
  # w * 10^-q = x * 2^-s
  var x = (mm, 0_u128, 0_u128)
  var s = 0_s64
  if q <= 0_s64
    if q < -110_s64
      return (false, 0_u128, 0_s64)
    x = wx_product_t(c: mm, p: wx_pow5(p: 0_s64 -% q))
    s = 0_s64 -% (ex -% q)
  else
    if q > 48_s64 or mm % b128t_pow5(p: q) != 0_u128
      return (false, 0_u128, 0_s64)
    x = (mm // b128t_pow5(p: q), 0_u128, 0_u128)
    s = q -% ex
  if s <= 0_s64
    # an integer, which must fit in 128 bits
    if x.item1 != 0_u128 or x.item2 != 0_u128 or s < -127_s64 or b128_trig_clz128(x: x.item0) < 0_s64 -% s
      return (false, 0_u128, 0_s64)
    return (true, x.item0 << b128_trig_sh(n: 0_s64 -% s), -1_s64)
  if s > 384_s64
    return (true, 0_u128, -1_s64)
  var ip = b128_trig_shr384(x: x, shift: s)
  if ip.item1 != 0_u128 or ip.item2 != 0_u128
    return (false, 0_u128, 0_s64)
  var fr = b128_trig_shl384(x: x, shift: 384_s64 -% s)
  if s == 384_s64
    fr = x
  var half = (0_u128, 0_u128, 1_u128 << 127_u32)
  if wx_t_gt(a: fr, b: half)
    return (true, ip.item0, 1_s64)
  if wx_t_gt(a: half, b: fr)
    return (true, ip.item0, -1_s64)
  return (true, ip.item0, 0_s64)

### (whether the band settles it, sign, coefficient, exponent, overflow) of w rounded to `digits` decimal
### digits (half to even) at exponents qmin..qmax: w times 10^-q for q = E - digits + 1 (E its leading digit's
### exponent, estimated from the binary one and settled by the scaled value) has the coefficient as its
### integer part and the rounding in its fraction. Below 10^(qmin + digits - 1) the coefficient has fewer
### digits and may round to 0. An exact w the band cannot settle (a tie, or a hair from one) is decided by
### wx_dec_exact when w * 10^-q is a binary fraction, the only case where it can be a tie.
secret routine wx_round_dec(w: B128Wx, digits: S64, qmin: S64, qmax: S64, force: Bool) -> (Bool, Bool, U128, S64, Bool)
  if wx_is_zero(w: w)
    return (force or w.rel == 0.0, w.neg, 0_u128, 0_s64, false)
  var lo = LLVM::int_truncate[U256, U128](pow10_tbl(k: digits -% 1_s64))
  var hi = LLVM::int_truncate[U256, U128](pow10_tbl(k: digits))
  var q = schubfach_flog10pow2(q: wx_ilog2(w: w)) -% digits +% 1_s64
  var tries = 0_s64
  while tries < 4_s64
    tries = tries +% 1_s64
    if q < qmin
      q = qmin
    if q > qmax
      return (true, w.neg, 0_u128, 0_s64, true)
    var t = wx_mul(a: w, b: wx_pow10(n: 0_s64 -% q))
    var s = 0_s64 -% t.e
    var tt = wx_t(w: t)
    if s <= 0_s64
      q = q +% 1_s64
      continue
    var ip = (0_u128, 0_u128, 0_u128)
    var fr = tt
    var lost = 0.0
    if s < 384_s64
      ip = b128_trig_shr384(x: tt, shift: s)
      fr = b128_trig_shl384(x: tt, shift: 384_s64 -% s)
    elseif s > 384_s64
      fr = b128_trig_shr384(x: tt, shift: s -% 384_s64)
      lost = 1.0
    if ip.item2 != 0_u128 or ip.item1 != 0_u128 or ip.item0 >= hi
      q = q +% 1_s64
      continue
    if ip.item0 < lo and q > qmin
      q = q -% 1_s64
      continue
    var c = ip.item0
    var half = (0_u128, 0_u128, 1_u128 << 127_u32)
    var above = not wx_t_gt(a: half, b: fr)
    var dist = b128_trig_sub384(a: half, b: fr)
    if above
      dist = b128_trig_sub384(a: fr, b: half)
    var errb = t.rel *! (b128fx_top(m: t.m2) *! 0x1p-63).scaleb_unchecked(n: 767_s64 -% s) *! (1.0 +! 0x1p-50) +! lost
    var ok = force or errb == 0.0 or wx_t_b64(t: dist) > errb
    var up = above and (b128_trig_lz384(x: dist) < 384_s64 or (c & 1_u128) == 1_u128)
    if not ok and w.rel == 0.0
      var (fits, ec, side) = wx_dec_exact(w: w, q: q)
      if fits
        ok = true
        c = ec
        up = side > 0_s64 or (side == 0_s64 and (c & 1_u128) == 1_u128)
    if up
      c = c +% 1_u128
    if c == hi
      c = lo
      q = q +% 1_s64
      if q > qmax
        return (true, w.neg, 0_u128, 0_s64, true)
    return (ok, w.neg, c, q, false)
  return (false, w.neg, 0_u128, 0_s64, false)

### The D128 of rounded parts: the coefficient with its trailing zeros stripped (while the exponent stays
### within range), a signed zero, or a signed infinity.
secret routine wx_d128_pack(neg: Bool, c: U128, q: S64, inf: Bool) -> D128
  if inf
    return D128.infinity(sign: neg)
  if c == 0_u128
    return D128.from_components(sign: neg, coeff: 0_u128, exp: 0_s64)
  var tz = trailing_zeros10_u128(c: c, cap0: 34_s64)
  if tz > 6111_s64 -% q
    tz = 6111_s64 -% q
  return d128_of_parts(p: D128Parts(sign: neg, special: 0_u64, exp: q +% tz, coeff: div_pow10_u128(x: c, k: tz)))

### w rounded to a D128 (34 digits), and whether its band settles that.
secret routine wx_to_d128(w: B128Wx, force: Bool) -> (Bool, D128)
  var (ok, neg, c, q, inf) = wx_round_dec(w: w, digits: 34_s64, qmin: -6176_s64, qmax: 6111_s64, force: force)
  return (ok, wx_d128_pack(neg: neg, c: c, q: q, inf: inf))

### w rounded to a D128 as it stands.
@inline
secret routine wx_d128(w: B128Wx) -> D128
  return wx_to_d128(w: w, force: true).item1

### w rounded to a D64 (16 digits, stored reduced).
secret routine wx_d64(w: B128Wx) -> D64
  var (ok, neg, c, q, inf) = wx_round_dec(w: w, digits: 16_s64, qmin: -398_s64, qmax: 369_s64, force: true)
  if inf
    return D64.infinity(sign: neg)
  if c == 0_u128
    return D64.from_components(sign: neg, coeff: 0_u64, exp: 0_s64)
  var tz = trailing_zeros10_u128(c: c, cap0: 16_s64)
  if tz > 369_s64 -% q
    tz = 369_s64 -% q
  return D64.from_components(sign: neg, coeff: LLVM::int_truncate[U128, U64](div_pow10_u128(x: c, k: tz)), exp: q +% tz)

### w rounded to a D32 (7 digits, stored reduced).
secret routine wx_d32(w: B128Wx) -> D32
  var (ok, neg, c, q, inf) = wx_round_dec(w: w, digits: 7_s64, qmin: -101_s64, qmax: 90_s64, force: true)
  if inf
    return D32.infinity(sign: neg)
  if c == 0_u128
    return D32.from_components(sign: neg, coeff: 0_u64, exp: 0_s64)
  var tz = trailing_zeros10_u128(c: c, cap0: 7_s64)
  if tz > 90_s64 -% q
    tz = 90_s64 -% q
  return D32.from_components(sign: neg, coeff: LLVM::int_truncate[U128, U64](div_pow10_u128(x: c, k: tz)), exp: q +% tz)

# ============================================================================
# Elementary functions on the tier
# ============================================================================

### The Taylor terms n with |t|^n / n! below 2^-396 for |t| < 2^-lg: the least n with n lg + floor(log2 2) +
### ... + floor(log2 n) >= 396 (each floor at most the true log, so n is never short).
secret routine wx_terms(lg: S64) -> S64
  var l = lg
  if l < 1_s64
    l = 1_s64
  var n = 0_s64
  var acc = 0_s64
  while acc < 396_s64
    n = n +% 1_s64
    acc = acc +% l +% 63_s64 -% LLVM::reinterpret_bits[U64, S64](LLVM::reinterpret_bits[S64, U64](n).leading_zeros())
  return n +% 1_s64

### e^t - 1 for |t| below 1/2: t (1/1! + t (1/2! + t (1/3! + ...))) from the tabled 1/k!, the tail past
### wx_terms below 2^-392.
secret routine wx_expm1_series(t: B128Wx) -> B128Wx
  if wx_is_zero(w: t)
    return t
  var i = wx_terms(lg: wx_below(w: t))
  var p = wx_inv_fact(k: i)
  while i > 1_s64
    i = i -% 1_s64
    p = wx_add(a: wx_inv_fact(k: i), b: wx_mul(a: t, b: p))
  return wx_widen(w: wx_mul(a: t, b: p), r: 0x1p-390)

### e^x for |x| below 2^16 (callers settle overflow and underflow first): x = k ln 2 + r, and e^r as
### (e^(r/16))^16 from the series (|r/16| < 2^-5.5).
secret routine wx_exp(x: B128Wx) -> B128Wx
  if wx_is_zero(w: x)
    return wx_widen(w: wx_one(), r: x.rel)
  var k = wx_round_b64(v: wx_b64(w: x) *! 1.4426950408889634)
  var r = x
  if k != 0_s64
    r = wx_sub(a: x, b: wx_mul(a: wx_table(i: 0_u64), b: wx_of_s64(v: k)))
  var p = wx_add(a: wx_one(), b: wx_expm1_series(t: wx_scale(w: r, k: -4_s64)))
  var i = 0_s64
  while i < 4_s64
    p = wx_mul(a: p, b: p)
    i = i +% 1_s64
  return wx_scale(w: p, k: k)

### e^x - 1: halved to below 2^-8, the series, then E (E + 2) per halving; from 1/2 up, e^x - 1.
secret routine wx_expm1(x: B128Wx) -> B128Wx
  if wx_is_zero(w: x)
    return x
  var lg = wx_below(w: x)
  if lg < 1_s64
    return wx_sub(a: wx_exp(x: x), b: wx_one())
  var s = 0_s64
  if lg < 8_s64
    s = 8_s64 -% lg
  var e = wx_expm1_series(t: wx_scale(w: x, k: 0_s64 -% s))
  var two = wx_scale(w: wx_one(), k: 1_s64)
  var i = 0_s64
  while i < s
    e = wx_mul(a: e, b: wx_add(a: e, b: two))
    i = i +% 1_s64
  return e

### log1p(d) for |d| below 2^-40: d (1 - d (1/2 - d (1/3 - ...))), 392/k + 2 terms for |d| < 2^-k.
secret routine wx_log1p_series(d: B128Wx) -> B128Wx
  if wx_is_zero(w: d)
    return d
  var one = wx_one()
  var n = 392_s64 // wx_below(w: d) +% 2_s64
  var p = wx_div_small(w: one, k: LLVM::reinterpret_bits[S64, U64](n))
  var i = n -% 1_s64
  while i >= 1_s64
    var inv = one
    if i > 1_s64
      inv = wx_div_small(w: one, k: LLVM::reinterpret_bits[S64, U64](i))
    p = wx_sub(a: inv, b: wx_mul(a: d, b: p))
    i = i -% 1_s64
  return wx_widen(w: wx_mul(a: d, b: p), r: 0x1p-390)

### log1p(t) for t > -1: the series below 2^-40, log(1 + t) from |t| = 1/2 on, else one Newton step
### y0 + log1p((1 + t) e^-y0 - 1) from the B64 value y0 (the residual below 2^-50).
secret routine wx_log1p(t: B128Wx) -> B128Wx
  if wx_is_zero(w: t)
    return t
  var lg = wx_below(w: t)
  if lg >= 40_s64
    return wx_log1p_series(d: t)
  if lg < 1_s64
    return wx_log(x: wx_add(a: wx_one(), b: t))
  var y0 = wx_of_b64(v: wx_b64(w: t).log1p_unchecked())
  var e = wx_expm1(x: wx_neg(w: y0))
  var d = wx_add(a: wx_add(a: t, b: e), b: wx_mul(a: t, b: e))
  return wx_add(a: y0, b: wx_log1p_series(d: d))

### log(x) for x > 0: log1p(x - 1) within 1/4 of 1, else n ln 2 + log1p(f - 1) with x = f 2^n and f in
### [sqrt(1/2), sqrt(2)).
secret routine wx_log(x: B128Wx) -> B128Wx
  var lead = wx_ilog2(w: x)
  var one = wx_one()
  if lead == -1_s64 or lead == 0_s64
    var xb = wx_b64(w: x)
    if xb >= 0.75 and xb <= 1.25
      return wx_log1p(t: wx_sub(a: x, b: one))
  var n = lead +% 1_s64
  var f = B128Wx(neg: false, m2: x.m2, m1: x.m1, m0: x.m0, e: -384_s64, rel: x.rel)
  if x.m2 < 0xB504F333F9DE6484597D89B3754ABE9F_u128
    f = wx_scale(w: f, k: 1_s64)
    n = n -% 1_s64
  var lf = wx_log1p(t: wx_sub(a: f, b: one))
  if n == 0_s64
    return lf
  return wx_add(a: wx_mul(a: wx_table(i: 0_u64), b: wx_of_s64(v: n)), b: lf)

### sin(theta) and cos(theta) for |theta| below 2^-5 from their Taylor series with the tabled 1/k!:
### sin(theta)/theta = 1/1! - u (1/3! - u (1/5! - ...)) and cos(theta) = 1/0! - u (1/2! - u (...)) for
### u = theta^2, with 392 / (k + 8) + 4 terms for u < 2^-k.
secret routine wx_sincos_small(theta: B128Wx) -> (B128Wx, B128Wx)
  var one = wx_one()
  if wx_is_zero(w: theta)
    return (theta, wx_widen(w: one, r: theta.rel))
  var u = wx_mul(a: theta, b: theta)
  var n = 392_s64 // (wx_below(w: u) +% 8_s64) +% 4_s64
  var ps = wx_inv_fact(k: 2_s64 *% n +% 1_s64)
  var pc = wx_inv_fact(k: 2_s64 *% n)
  var i = n
  while i > 0_s64
    i = i -% 1_s64
    ps = wx_sub(a: wx_inv_fact(k: 2_s64 *% i +% 1_s64), b: wx_mul(a: u, b: ps))
    pc = wx_sub(a: wx_inv_fact(k: 2_s64 *% i), b: wx_mul(a: u, b: pc))
  return (wx_widen(w: wx_mul(a: theta, b: ps), r: 0x1p-390), wx_widen(w: pc, r: 0x1p-390))

### sin and cos of n pi/256 + theta (|theta| below 2^-5): the CORE-MATH 384-bit sin / cos(j pi/256) for
### j = n mod 128 and the series, by the addition formulas, then turned by the quadrant n / 128.
secret routine wx_sincos_red(n: S64, theta: B128Wx) -> (B128Wx, B128Wx)
  var (st, ct) = wx_sincos_small(theta: theta)
  var j = n & 127_s64
  var s = st
  var c = ct
  if j != 0_s64
    var sj = wx_make(neg: false, t: b128_trig_sincos384(j: j, w: 0_s64), e: -384_s64, rel: 0x1p-383)
    var cj = wx_make(neg: false, t: b128_trig_sincos384(j: j, w: 1_s64), e: -384_s64, rel: 0x1p-383)
    s = wx_add(a: wx_mul(a: sj, b: ct), b: wx_mul(a: cj, b: st))
    c = wx_sub(a: wx_mul(a: cj, b: ct), b: wx_mul(a: sj, b: st))
  var q = (n >> 7) & 3_s64
  if q == 1_s64
    return (c, wx_neg(w: s))
  if q == 2_s64
    return (wx_neg(w: s), wx_neg(w: c))
  if q == 3_s64
    return (wx_neg(w: c), s)
  return (s, c)

### sin and cos of a (|a| below 2^20): n pi/256 the nearest multiple, theta = a - n pi/256.
secret routine wx_sincos(a: B128Wx) -> (B128Wx, B128Wx)
  if wx_is_zero(w: a)
    return wx_sincos_small(theta: a)
  var n = wx_round_b64(v: wx_b64(w: a) *! 81.48733086305042)
  var theta = a
  if n != 0_s64
    theta = wx_sub(a: a, b: wx_mul(a: wx_table(i: 2_u64), b: wx_of_s64(v: n)))
  return wx_sincos_red(n: n, theta: theta)

### sin and cos of a finite B128 x: below 2^-8 no reduction, else the CORE-MATH 448-bit reduction to
### n pi/256 + theta (the residual good to about 2^-440 absolute).
secret routine wx_sincos_b128(x: B128) -> (B128Wx, B128Wx)
  var bits = x.to_bits()
  var ax = bits & ((1_u128 << 127_u32) -% 1_u128)
  var e = LLVM::int_truncate[U128, S64](ax >>> 112_u32) -% 16383_s64
  if e < -8_s64
    return wx_sincos_red(n: 0_s64, theta: wx_of_b128(x: x))
  var m = (ax & ((1_u128 << 112_u32) -% 1_u128)) | (1_u128 << 112_u32)
  var rw = b128_trig_reduce_wide(m: m, e: e)
  var theta = wx_make(neg: rw.item1, t: rw.item2, e: rw.item3 -% 384_s64, rel: 0x1p-378)
  theta = wx_widen(w: theta, r: 1.0.scaleb_unchecked(n: -440_s64 -% wx_ilog2(w: theta)))
  var (s, c) = wx_sincos_red(n: rw.item0, theta: theta)
  if (bits >>> 127_u32) != 0_u128
    return (wx_neg(w: s), c)
  return (s, c)

### sin(pi r) and cos(pi r) for |r| <= 1/2 (r exact or close): j = round(256 r) comes off exactly, and
### pi (r - j/256) is the residual angle.
secret routine wx_sincospi(r: B128Wx) -> (B128Wx, B128Wx)
  var j = wx_round_b64(v: wx_b64(w: r) *! 256.0)
  var rr = r
  if j != 0_s64
    rr = wx_sub(a: r, b: wx_scale(w: wx_of_s64(v: j), k: -8_s64))
  return wx_sincos_red(n: j, theta: wx_mul(a: wx_table(i: 1_u64), b: rr))

### The 512-bit little-endian value a as a B128Wx (its top 384 bits).
secret routine wx_of_limbs8(a: Array[U64, 8], rel: B64) -> B128Wx
  var w = 7_s64
  while w >= 0_s64 and a[LLVM::reinterpret_bits[S64, U64](w)] == 0_u64
    w = w -% 1_s64
  if w < 0_s64
    return wx_zero(rel: rel)
  var lead = w *% 64_s64 +% 63_s64 -% LLVM::reinterpret_bits[U64, S64](a[LLVM::reinterpret_bits[S64, U64](w)].leading_zeros())
  # shift left by 511 - lead so the lead lands on bit 511, then keep limbs 7..2
  var sh = 511_s64 -% lead
  var ws = sh >> 6
  var bs = sh & 63_s64
  var o = Array[U64, 8]()
  var i = 7_s64
  while i >= 0_s64
    var v = 0_u64
    var src = i -% ws
    if src >= 0_s64
      v = a[LLVM::reinterpret_bits[S64, U64](src)] << b128_trig_sh(n: bs)
      if bs != 0_s64 and src >= 1_s64
        v = v | (a[LLVM::reinterpret_bits[S64, U64](src -% 1_s64)] >>> b128_trig_sh(n: 64_s64 -% bs))
    o[LLVM::reinterpret_bits[S64, U64](i)] = v
    i = i -% 1_s64
  var t = (b128_trig_u128(hi: o[3_u64], lo: o[2_u64]), b128_trig_u128(hi: o[5_u64], lo: o[4_u64]), b128_trig_u128(hi: o[7_u64], lo: o[6_u64]))
  return B128Wx(neg: false, m2: t.item2, m1: t.item1, m0: t.item0, e: lead -% 383_s64, rel: rel +! 0x1p-383)

### atan(z) for |z| < 2^-12: z (1 - z^2 (1/3 - z^2 (1/5 - ...))), 196/k + 2 terms for |z| < 2^-k.
secret routine wx_atan_series(z: B128Wx) -> B128Wx
  if wx_is_zero(w: z)
    return z
  var one = wx_one()
  var u = wx_mul(a: z, b: z)
  var n = 196_s64 // wx_below(w: z) +% 2_s64
  var p = wx_div_small(w: one, k: LLVM::reinterpret_bits[S64, U64](2_s64 *% n +% 1_s64))
  var i = n -% 1_s64
  while i >= 0_s64
    var inv = one
    if i > 0_s64
      inv = wx_div_small(w: one, k: LLVM::reinterpret_bits[S64, U64](2_s64 *% i +% 1_s64))
    p = wx_sub(a: inv, b: wx_mul(a: u, b: p))
    i = i -% 1_s64
  return wx_widen(w: wx_mul(a: z, b: p), r: 0x1p-390)

### atan(z): the series below 2^-12, pi/2 - atan(1/|z|) above 1, else one Newton step t0 + atan(d) with
### d = (z cos t0 - sin t0) / (cos t0 + z sin t0) from the B64 arctangent t0 (d below 2^-50).
secret routine wx_atan(z: B128Wx) -> B128Wx
  if wx_is_zero(w: z)
    return z
  var lead = wx_ilog2(w: z)
  var one = wx_one()
  if lead >= 0_s64 and not (lead == 0_s64 and z.m2 == (1_u128 << 127_u32) and z.m1 == 0_u128 and z.m0 == 0_u128)
    var r = wx_sub(a: wx_table(i: 9_u64), b: wx_atan(z: wx_div(a: one, b: wx_abs(w: z))))
    if z.neg
      return wx_neg(w: r)
    return r
  if lead < -12_s64
    return wx_atan_series(z: z)
  var t0 = wx_of_b64(v: wx_b64(w: z).atan())
  var (s, c) = wx_sincos(a: t0)
  var d = wx_div(a: wx_sub(a: wx_mul(a: z, b: c), b: s), b: wx_add(a: c, b: wx_mul(a: z, b: s)))
  return wx_add(a: t0, b: wx_atan_series(z: d))

### asin(x) for |x| <= 1 given omx = 1 - |x| (exact or close): atan(x / sqrt(omx (1 + |x|))), +-pi/2 at
### |x| = 1.
secret routine wx_asin(x: B128Wx, omx: B128Wx) -> B128Wx
  if wx_is_zero(w: omx)
    if x.neg
      return wx_neg(w: wx_table(i: 9_u64))
    return wx_table(i: 9_u64)
  var r = wx_sqrt(a: wx_mul(a: omx, b: wx_add(a: wx_one(), b: wx_abs(w: x))))
  return wx_atan(z: wx_div(a: x, b: r))

### acos(x) for |x| <= 1 given omx = 1 - |x|: pi/2 - asin(x) below |x| = 1/2, else 2 asin(sqrt(omx / 2))
### (pi minus that for x < 0).
secret routine wx_acos(x: B128Wx, omx: B128Wx) -> B128Wx
  var xb = wx_b64(w: x)
  if xb < 0.5 and xb > -0.5
    return wx_sub(a: wx_table(i: 9_u64), b: wx_asin(x: x, omx: omx))
  var s = wx_sqrt(a: wx_scale(w: omx, k: -1_s64))
  var a = wx_scale(w: wx_asin(x: s, omx: wx_sub(a: wx_one(), b: s)), k: 1_s64)
  if x.neg
    return wx_sub(a: wx_table(i: 1_u64), b: a)
  return a

### atan2(y, x) for finite y and x, not both zero.
secret routine wx_atan2(y: B128Wx, x: B128Wx) -> B128Wx
  var a = wx_table(i: 9_u64)
  if not wx_is_zero(w: x)
    a = wx_atan(z: wx_div(a: wx_abs(w: y), b: wx_abs(w: x)))
    if x.neg
      a = wx_sub(a: wx_table(i: 1_u64), b: a)
  if y.neg
    return wx_neg(w: a)
  return a

### sinh(x) = (E + E/(E + 1)) / 2 with E = expm1(|x|) (no cancellation), the sign of x.
secret routine wx_sinh(x: B128Wx) -> B128Wx
  var e = wx_expm1(x: wx_abs(w: x))
  var r = wx_scale(w: wx_add(a: e, b: wx_div(a: e, b: wx_add(a: e, b: wx_one()))), k: -1_s64)
  if x.neg
    return wx_neg(w: r)
  return r

### cosh(x) = (e + 1/e) / 2 with e = e^|x|.
secret routine wx_cosh(x: B128Wx) -> B128Wx
  var e = wx_exp(x: wx_abs(w: x))
  return wx_scale(w: wx_add(a: e, b: wx_div(a: wx_one(), b: e)), k: -1_s64)

### tanh(x) = E / (E + 2) with E = expm1(2|x|), the sign of x.
secret routine wx_tanh(x: B128Wx) -> B128Wx
  var e = wx_expm1(x: wx_scale(w: wx_abs(w: x), k: 1_s64))
  var r = wx_div(a: e, b: wx_add(a: e, b: wx_scale(w: wx_one(), k: 1_s64)))
  if x.neg
    return wx_neg(w: r)
  return r

### asinh(x): log1p(a + a^2 / (1 + sqrt(1 + a^2))) below a = |x| = 1/2, log(a + sqrt(a^2 + 1)) above, the
### sign of x.
secret routine wx_asinh(x: B128Wx) -> B128Wx
  var a = wx_abs(w: x)
  var one = wx_one()
  var sq = wx_sqrt(a: wx_add(a: wx_mul(a: a, b: a), b: one))
  var r = a
  if wx_ilog2(w: a) < -1_s64
    r = wx_log1p(t: wx_add(a: a, b: wx_div(a: wx_mul(a: a, b: a), b: wx_add(a: one, b: sq))))
  else
    r = wx_log(x: wx_add(a: a, b: sq))
  if x.neg
    return wx_neg(w: r)
  return r

### acosh(1 + t) for t >= 0: log1p(t + sqrt(t (t + 2))).
secret routine wx_acosh(t: B128Wx) -> B128Wx
  var two = wx_scale(w: wx_one(), k: 1_s64)
  return wx_log1p(t: wx_add(a: t, b: wx_sqrt(a: wx_mul(a: t, b: wx_add(a: t, b: two)))))

### atanh(x) for |x| < 1 given omx = 1 - |x|: log1p(2|x| / omx) / 2, the sign of x.
secret routine wx_atanh(x: B128Wx, omx: B128Wx) -> B128Wx
  var r = wx_scale(w: wx_log1p(t: wx_div(a: wx_scale(w: wx_abs(w: x), k: 1_s64), b: omx)), k: -1_s64)
  if x.neg
    return wx_neg(w: r)
  return r

### erf(a) for 0 < a <= 8: (2/sqrt(pi)) e^-a^2 sum_n a (2a^2)^n / (1 3 5 ... (2n+1)), every term positive,
### summed until a term past n = 2a^2 (where the ratio is below 1/2) falls below 2^-392 of the sum.
secret routine wx_erf_series(a: B128Wx) -> B128Wx
  var a2 = wx_mul(a: a, b: a)
  var q = wx_scale(w: a2, k: 1_s64)
  var peak = LLVM::float_to_unsigned[B64, U64](wx_b64(w: q))
  var term = a
  var sum = a
  var n = 1_u64
  while n < 4000_u64
    term = wx_div_small(w: wx_mul(a: term, b: q), k: 2_u64 *% n +% 1_u64)
    sum = wx_add(a: sum, b: term)
    if n > peak and wx_ilog2(w: term) < wx_ilog2(w: sum) -% 392_s64
      break
    n = n +% 1_u64
  return wx_widen(w: wx_mul(a: wx_mul(a: wx_table(i: 7_u64), b: wx_exp(x: wx_neg(w: a2))), b: sum), r: 0x1p-390)

### erfc(a) for a > 8: e^-a^2 / sqrt(pi) / f with f = a + (1/2)/(a + 1/(a + (3/2)/(a + ...))) over
### 13000/a^2 + 600/a + 35 levels (within 2^-392), f = P/Q from P' = a P + (k/2) Q, Q' = P bottom up.
secret routine wx_erfc_cf(a: B128Wx) -> B128Wx
  var ab = wx_b64(w: a)
  var p = a
  var q = wx_one()
  var k = LLVM::float_to_signed[B64, S64](13000.0 /! (ab *! ab) +! 600.0 /! ab +! 35.0)
  while k >= 1_s64
    var np = wx_add(a: wx_mul(a: a, b: p), b: wx_scale(w: wx_mul(a: wx_of_s64(v: k), b: q), k: -1_s64))
    q = p
    p = np
    k = k -% 1_s64
  var g = wx_mul(a: wx_exp(x: wx_neg(w: wx_mul(a: a, b: a))), b: wx_table(i: 8_u64))
  return wx_widen(w: wx_div(a: wx_mul(a: g, b: q), b: p), r: 0x1p-390)

### erf(x) (complement false) or erfc(x) (true) for a finite x with |x| <= 130: the series up to |x| = 8,
### the continued fraction above, and the complements by 1 - and 1 + (erfc(x) for x <= 8 loses at most 96
### bits of the 384 to the cancellation).
secret routine wx_erf(x: B128Wx, complement: Bool) -> B128Wx
  var one = wx_one()
  if wx_is_zero(w: x)
    if complement
      return one
    return x
  var a = wx_abs(w: x)
  var big = wx_b64(w: a) > 8.0
  if not complement
    var r = a
    if big
      r = wx_sub(a: one, b: wx_erfc_cf(a: a))
    else
      r = wx_erf_series(a: a)
    if x.neg
      return wx_neg(w: r)
    return r
  if x.neg
    if big
      return wx_sub(a: wx_scale(w: one, k: 1_s64), b: wx_erfc_cf(a: a))
    return wx_add(a: one, b: wx_erf_series(a: a))
  if big
    return wx_erfc_cf(a: a)
  return wx_sub(a: one, b: wx_erf_series(a: a))

### ln Gamma(x) for x >= 1/2: Stirling at X = x + n >= 128 with 41 terms (the rest below 2^-392), less
### ln(x (x + 1) ... (x + n - 1)).
secret routine wx_lgamma_pos(x: B128Wx) -> B128Wx
  var one = wx_one()
  var xb = wx_b64(w: x)
  var n = 0_s64
  if xb < 128.0
    n = 128_s64 -% LLVM::float_to_signed[B64, S64](xb)
  var prod = one
  var i = 0_s64
  while i < n
    prod = wx_mul(a: prod, b: wx_add(a: x, b: wx_of_s64(v: i)))
    i = i +% 1_s64
  var big = wx_add(a: x, b: wx_of_s64(v: n))
  var w = wx_div(a: one, b: big)
  var w2 = wx_mul(a: w, b: w)
  # sum_k (-1)^(k+1) |B_2k| / (2k (2k - 1)) w^(2k-1) = w (c1 + w2 (c2 + ...)), the signs alternating from +
  var k = 41_u64
  var sum = wx_table(i: 78_u64)
  while k > 1_u64
    k = k -% 1_u64
    var c = wx_table(i: 37_u64 +% k)
    if (k & 1_u64) == 0_u64
      c = wx_neg(w: c)
    sum = wx_add(a: c, b: wx_mul(a: w2, b: sum))
  sum = wx_mul(a: w, b: sum)
  var half = wx_scale(w: one, k: -1_s64)
  var l = wx_add(a: wx_sub(a: wx_mul(a: wx_sub(a: big, b: half), b: wx_log(x: big)), b: big), b: wx_table(i: 5_u64))
  l = wx_add(a: l, b: sum)
  if n > 0_s64
    l = wx_sub(a: l, b: wx_log(x: prod))
  return wx_widen(w: l, r: 0x1p-390)

### ln|Gamma(x)| and whether Gamma(x) < 0, for a finite x that is not a pole, given x = k + r with k an
### integer (k_odd its parity) and |r| <= 1/2 (r exact or close): wx_lgamma_pos from 1/2 up, below it the
### reflection ln pi - ln|sin(pi x)| - ln Gamma(1 - x) with sin(pi x) = (-1)^k sin(pi r).
secret routine wx_lgamma(x: B128Wx, k_odd: Bool, r: B128Wx) -> (B128Wx, Bool)
  if not x.neg and wx_b64(w: x) >= 0.5
    return (wx_lgamma_pos(x: x), false)
  var s = wx_sincospi(r: r).item0
  var l = wx_sub(a: wx_sub(a: wx_table(i: 6_u64), b: wx_log(x: wx_abs(w: s))), b: wx_lgamma_pos(x: wx_sub(a: wx_one(), b: x)))
  return (l, s.neg != k_odd)

### Gamma(x) for a finite x that is not a pole, with ln|Gamma| below about 15000 in magnitude (see
### wx_lgamma for k_odd and r): e^lgamma, the sign from the reflection.
secret routine wx_tgamma(x: B128Wx, k_odd: Bool, r: B128Wx) -> B128Wx
  var (l, negative) = wx_lgamma(x: x, k_odd: k_odd, r: r)
  var g = wx_exp(x: l)
  if negative
    return wx_neg(w: g)
  return g

