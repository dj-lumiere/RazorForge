### within 2^-254 relative, for -6208 <= n <= 6207. From -64 to 63 (the values a D128 near 1 needs) it is
### one table entry: exact for n >= 0, rounded to nearest below. Elsewhere the table entries for 10^(64a)
### (rounded) and 10^b (exact) multiplied, the product's top 256 bits kept.
secret routine b128t_pow10(n: S64) -> (U128, U128, S64)
    if n >= 0_s64 and n <= 63_s64
        var i = LLVM::reinterpret_bits[S64, U64](n) *% 2_u64
        return (B128_POW10_SMALL[i], B128_POW10_SMALL[i +% 1_u64], schubfach_flog2pow10(e: n) -% 255_s64)
    if n < 0_s64 and n >= -64_s64
        var j = LLVM::reinterpret_bits[S64, U64](-1_s64 -% n) *% 2_u64
        return (B128_POW10_NEG[j], B128_POW10_NEG[j +% 1_u64], schubfach_flog2pow10(e: n) -% 255_s64)
    var a = n >> 6
    var b = n & 63_s64
    var ia = LLVM::reinterpret_bits[S64, U64](a +% 97_s64) *% 2_u64
    var ib = LLVM::reinterpret_bits[S64, U64](b) *% 2_u64
    var h1 = B128_POW10_64[ia]
    var l1 = B128_POW10_64[ia +% 1_u64]
    var h2 = B128_POW10_SMALL[ib]
    var l2 = B128_POW10_SMALL[ib +% 1_u64]
    var hh = b128_trig_wmul(x: h1, y: h2)
    var hl = b128_trig_wmul(x: h1, y: l2)
    var lh = b128_trig_wmul(x: l1, y: h2)
    var ll = b128_trig_wmul(x: l1, y: l2)
    # the 512-bit product in words w3 w2 w1 (w0 = ll.lo is not needed)
    var (w1a, c1a) = b128t_add(a: ll.item0, b: hl.item1, cin: 0_u128)
    var (w1, c1b) = b128t_add(a: w1a, b: lh.item1, cin: 0_u128)
    var (w2a, c2a) = b128t_add(a: hh.item1, b: hl.item0, cin: c1a)
    var (w2, c2b) = b128t_add(a: w2a, b: lh.item0, cin: c1b)
    var w3 = hh.item0 +% c2a +% c2b
    var e = schubfach_flog2pow10(e: a *% 64_s64) +% schubfach_flog2pow10(e: b) -% 510_s64
    if (w3 >>> 127_u32) != 0_u128
        return (w3, w2, e +% 256_s64)
    return ((w3 << 1_u32) | (w2 >>> 127_u32), (w2 << 1_u32) | (w1 >>> 127_u32), e +% 255_s64)

### cb * (mh, ml) * 2^-sh as a U256 (sh >= 0), for a result below 2^256: the 384-bit product shifted right,
### the dropped bits truncated.
secret routine b128t_scale(cb: U128, mh: U128, ml: U128, sh: S64) -> U256
    var ph = b128_trig_wmul(x: cb, y: mh)
    var pl = b128_trig_wmul(x: cb, y: ml)
    var (x1, c) = b128t_add(a: pl.item0, b: ph.item1, cin: 0_u128)
    var x2 = ph.item0 +% c
    var top = (LLVM::zero_extend[U128, U256](x2) << 128_u32) | LLVM::zero_extend[U128, U256](x1)
    if sh >= 128_s64
        return top >>> b128_trig_sh(n: sh -% 128_s64)
    return (top << b128_trig_sh(n: 128_s64 -% sh)) | LLVM::zero_extend[U128, U256](pl.item1 >>> b128_trig_sh(n: sh))

### -1 when the approximation x (within 2 units) is surely below the exact y, 1 when surely above, 0 when
### they are within 8 units of each other.
@inline
secret routine b128t_side(x: U256, y: U256) -> S64
    if x +% 8_u256 < y
        return -1_s64
    if x > y +% 8_u256
        return 1_s64
    return 0_s64

### The shortest decimal f * 10^e inside the rounding interval of c * 2^q (c a B128 significand, subnormal
### ones included; the closest to the value among the shortest, ties to even), or false when a decision
### falls within the approximation's error.
secret routine b128t_shortest(q: S64, c: U128) -> (Bool, U128, S64)
    var cb = c << 2_u32
    var cbl = cb -% 2_u128
    var cbr = cb +% 2_u128
    var k = schubfach_flog10pow2(q: q)
    if c == (1_u128 << 112_u32) and q != -16494_s64
        # the float below is half as far away
        cbl = cb -% 1_u128
        k = schubfach_flog10_three_quarters_pow2(q: q)
    # 4 * value / 10^k and the interval ends, in units of 2^-128
    var (mh, ml, e10) = b128t_pow10(n: 0_s64 -% k)
    var sh = 0_s64 -% (q +% e10 +% 128_s64)
    var vb = b128t_scale(cb: cb, mh: mh, ml: ml, sh: sh)
    var vbl = b128t_scale(cb: cbl, mh: mh, ml: ml, sh: sh)
    var vbr = b128t_scale(cb: cbr, mh: mh, ml: ml, sh: sh)
    # s = floor(value / 10^k), which must not sit within the error of an integer
    var frac = vb & ((1_u256 << 130_u32) -% 1_u256)
    if frac < 8_u256 or frac > (1_u256 << 130_u32) -% 8_u256
        return (false, 0_u128, 0_s64)
    var s = LLVM::int_truncate[U256, U128](vb >>> 130_u32)
    if s >= 10_u128
        # one digit shorter: at most one of the two neighbouring multiples of ten fits in the interval
        var sp10 = s -% (s % 10_u128)
        var tp10 = sp10 +% 10_u128
        var up = b128t_side(x: vbl, y: LLVM::zero_extend[U128, U256](sp10) << 130_u32)
        var wp = b128t_side(x: vbr, y: LLVM::zero_extend[U128, U256](tp10) << 130_u32)
        if up == 0_s64 or wp == 0_s64
            return (false, 0_u128, 0_s64)
        if up < 0_s64 and wp < 0_s64
            return (true, sp10, k)
        if wp > 0_s64 and up > 0_s64
            return (true, tp10, k)
    var t = s +% 1_u128
    var u = b128t_side(x: vbl, y: LLVM::zero_extend[U128, U256](s) << 130_u32)
    var w = b128t_side(x: vbr, y: LLVM::zero_extend[U128, U256](t) << 130_u32)
    if u == 0_s64 or w == 0_s64
        return (false, 0_u128, 0_s64)
    if u < 0_s64 and w < 0_s64
        return (true, s, k)
    if w > 0_s64 and u > 0_s64
        return (true, t, k)
    # both fit: the closer one (a tie goes to the exact method, which keeps the even one)
    var mid = b128t_side(x: vb, y: LLVM::zero_extend[U128, U256](s +% t) << 129_u32)
    if mid < 0_s64
        return (true, s, k)
    if mid > 0_s64
        return (true, t, k)
    return (false, 0_u128, 0_s64)

### Renders a B128 as the shortest decimal that reads back as the same value (scientific from a
### leading-digit exponent of 34, FLT128_DIG + 1), written as `wrap(...)` when wrap is nonempty.
### Specials: "NaN" / "inf" / "-inf".
routine format_b128_shortest_wrapped(value: B128, wrap: Text) -> Text
    var bits = value.to_bits()
    var neg = (bits >>> 127_u32) != 0_u128
    var ef = LLVM::int_truncate[U128, S64]((bits >>> 112_u32) & 0x7FFF_u128)
    var mf = bits & ((1_u128 << 112_u32) -% 1_u128)
    var special = ""
    if ef == 0x7FFF_s64
        special = "inf"
        if mf != 0_u128
            special = "NaN"
        elseif neg
            special = "-inf"
    elseif ef == 0_s64 and mf == 0_u128
        special = "0"
        if neg
            special = "-0"
    if special.count() > 0_u64
        if wrap.count() > 0_u64
            return wrap + "(" + special + ")"
        return special
    var c = mf
    var q = -16494_s64
    if ef != 0_s64
        c = mf | (1_u128 << 112_u32)
        q = ef -% 16495_s64
        # an integer below 2^113 is its own shortest decimal
        var mq = 0_s64 -% q
        if mq > 0_s64 and mq <= 112_s64
            var fi = c >>> b128_trig_sh(n: mq)
            if (fi << b128_trig_sh(n: mq)) == c
                return shortest_decimal_text(neg: neg, f: fi, e: 0_s64, sci_from: 34_u64, wrap: wrap)
    var (ok, f, e) = b128t_shortest(q: q, c: c)
    if ok
        return shortest_decimal_text(neg: neg, f: f, e: e, sci_from: 34_u64, wrap: wrap)
    var lower_closer = mf == 0_u128 and ef > 1_s64
    var txt = format_shortest(neg: neg, m: Integer(from: c), e2: q, lower_closer: lower_closer, sci_from: 34_u64)
    if wrap.count() > 0_u64
        return wrap + "(" + txt + ")"
    return txt

# ============================================================================
# Rounded decimal digits (to_text, fixed) without big integers
# ============================================================================

# 5^p for p = 0 .. 55, for the exact scalings by 10^p = 5^p * 2^p.
secret preset B128_POW5: Array[U128, 56] = [
    0x00000000000000000000000000000001_u128, 0x00000000000000000000000000000005_u128,
    0x00000000000000000000000000000019_u128, 0x0000000000000000000000000000007D_u128,
    0x00000000000000000000000000000271_u128, 0x00000000000000000000000000000C35_u128,
    0x00000000000000000000000000003D09_u128, 0x0000000000000000000000000001312D_u128,
    0x0000000000000000000000000005F5E1_u128, 0x000000000000000000000000001DCD65_u128,
    0x000000000000000000000000009502F9_u128, 0x00000000000000000000000002E90EDD_u128,
    0x0000000000000000000000000E8D4A51_u128, 0x00000000000000000000000048C27395_u128,
    0x0000000000000000000000016BCC41E9_u128, 0x0000000000000000000000071AFD498D_u128,
    0x00000000000000000000002386F26FC1_u128, 0x0000000000000000000000B1A2BC2EC5_u128,
    0x0000000000000000000003782DACE9D9_u128, 0x000000000000000000001158E460913D_u128,
    0x0000000000000000000056BC75E2D631_u128, 0x00000000000000000001B1AE4D6E2EF5_u128,
    0x0000000000000000000878678326EAC9_u128, 0x0000000000000000002A5A058FC295ED_u128,
    0x000000000000000000D3C21BCECCEDA1_u128, 0x00000000000000000422CA8B0A00A425_u128,
    0x000000000000000014ADF4B7320334B9_u128, 0x00000000000000006765C793FA10079D_u128,
    0x000000000000000204FCE5E3E2502611_u128, 0x000000000000000A18F07D736B90BE55_u128,
    0x00000000000000327CB2734119D3B7A9_u128, 0x00000000000000FC6F7C40458122964D_u128,
    0x00000000000004EE2D6D415B85ACEF81_u128, 0x00000000000018A6E32246C99C60AD85_u128,
    0x0000000000007B426FAB61F00DE36399_u128, 0x000000000002684C2E58E9B04570F1FD_u128,
    0x00000000000C097CE7BC90715B34B9F1_u128, 0x00000000003C2F7086AED236C807A1B5_u128,
    0x00000000012CED32A16A1B11E8262889_u128, 0x0000000005E0A1FD2712875988BECAAD_u128,
    0x000000001D6329F1C35CA4BFABB9F561_u128, 0x0000000092EFD1B8D0CF37BE5AA1CAE5_u128,
    0x00000002DEAF189C140C16B7C528F679_u128, 0x0000000E596B7B0C643C7196D9CCD05D_u128,
    0x00000047BF19673DF52E37F2410011D1_u128, 0x00000166BB7F0435C9E717BB45005915_u128,
    0x00000701A97B150CF18376A85901BD69_u128, 0x000023084F676940B7915149BD08B30D_u128,
    0x0000AF298D050E4395D69670B12B7F41_u128, 0x00036BCFC1194751ED30F03375D97C45_u128,
    0x00111B0EC57E6499A1F4B1014D3F6D59_u128, 0x00558749DB77F70029C77506823D22BD_u128,
    0x01ABA4714957D300D0E549208B31ADB1_u128, 0x085A36366EB71F04147A6DA2B7F86475_u128,
    0x29C30F1029939B146664242D97D9F649_u128, 0xD0CF4B50CFE20765FFF4B4E3F741CF6D_u128
]

### 5^p for 0 <= p <= 55 (for other files of the module, the table being file-private).
@inline
secret routine b128t_pow5(p: S64) -> U128
    return B128_POW5[LLVM::reinterpret_bits[S64, U64](p)]

### round(n / 2^s) half to even for s > 0, or false when the result reaches 2^127.
secret routine b128t_round_shift(n: U256, s: S64) -> (Bool, U128)
    if s >= 256_s64
        # n < 2^255: the value is below one half
        return (true, 0_u128)
    var sh = b128_trig_sh(n: s)
    var r = n >>> sh
    if r >= (1_u256 << 127_u32)
        return (false, 0_u128)
    var rem = n & ((1_u256 << sh) -% 1_u256)
    var half = 1_u256 << (sh -% 1_u32)
    var ri = LLVM::int_truncate[U256, U128](r)
    if rem > half or (rem == half and (ri & 1_u128) == 1_u128)
        ri = ri +% 1_u128
    return (true, ri)

### c * 2^q * 10^p rounded to an integer, half to even, for a binary value c * 2^q (c < 2^113), or false
### when the result would reach 2^127. Exact when p is 0 .. 55 (c * 5^p shifted by q + p) or when p is
### -38 .. -1 and c * 2^q is an integer below 2^127 (one division). Otherwise the value is scaled by the
### 256-bit power of ten (within 3 units of 2^-128) and false also comes back when it sits within 8
### units of a half, where only the exact value can say which way it goes, or when p is outside the table.
secret routine b128t_round_scaled(c: U128, q: S64, p: S64) -> (Bool, U128)
    if p >= 0_s64 and p <= 55_s64
        var pr = b128_trig_wmul(x: c, y: B128_POW5[LLVM::reinterpret_bits[S64, U64](p)])
        var n = (LLVM::zero_extend[U128, U256](pr.item0) << 128_u32) | LLVM::zero_extend[U128, U256](pr.item1)
        var s = 0_s64 -% (q +% p)
        if s > 0_s64
            return b128t_round_shift(n: n, s: s)
        # an integer: n * 2^-s must stay below 2^127
        var lead = 255_s64 -% LLVM::int_truncate[U256, S64](LLVM::leading_zeros(n))
        if lead -% s >= 127_s64
            return (false, 0_u128)
        return (true, LLVM::int_truncate[U256, U128](n << b128_trig_sh(n: 0_s64 -% s)))
    if p < 0_s64 and p >= -38_s64 and q >= 0_s64 and q < 127_s64 and b128_trig_clz128(x: c) > q
        var v = c << b128_trig_sh(n: q)
        var d = B128_POW5[LLVM::reinterpret_bits[S64, U64](0_s64 -% p)] << b128_trig_sh(n: 0_s64 -% p)
        var qq = v // d
        var rr = v -% qq *% d
        if rr > d -% rr or (rr == d -% rr and (qq & 1_u128) == 1_u128)
            qq = qq +% 1_u128
        return (true, qq)
    if p < -6208_s64 or p > 6207_s64
        return (false, 0_u128)
    var (mh, ml, e10) = b128t_pow10(n: p)
    var sh = 0_s64 -% (q +% e10 +% 128_s64)
    # c * M < 2^(msb + 257), so the scaled value stays below 2^255 when sh >= msb + 2
    if sh < 129_s64 -% b128_trig_clz128(x: c)
        return (false, 0_u128)
    var x = 0_u256
    if sh < 400_s64
        x = b128t_scale(cb: c, mh: mh, ml: ml, sh: sh)
    var d = x >>> 128_u32
    if d >= (1_u256 << 127_u32)
        return (false, 0_u128)
    var frac = x & ((1_u256 << 128_u32) -% 1_u256)
    var half = 1_u256 << 127_u32
    if frac +% 8_u256 >= half and frac <= half +% 8_u256
        return (false, 0_u128)
    var r = LLVM::int_truncate[U256, U128](d)
    if frac > half
        r = r +% 1_u128
    return (true, r)

### The digits of a U128 into buf (least significant first), returning how many.
secret routine b128t_digits(v: U128, buf: Hijacked[U32]) -> S64
    var n = 0_s64
    var hi = 0_u64
    var lo = LLVM::int_truncate[U128, U64](v)
    danger
        if (v >>> 64_u32) != 0_u128
            var hq = v // 10000000000000000000_u128
            hi = LLVM::int_truncate[U128, U64](hq)
            lo = LLVM::int_truncate[U128, U64](v -% hq *% 10000000000000000000_u128)
            while n < 19_s64
                buf.stride(count: n).poke(value: 0x30_u32 +% LLVM::int_truncate[U64, U32](lo % 10_u64))
                lo = lo // 10_u64
                n = n +% 1_s64
            lo = hi
        while lo != 0_u64
            buf.stride(count: n).poke(value: 0x30_u32 +% LLVM::int_truncate[U64, U32](lo % 10_u64))
            lo = lo // 10_u64
            n = n +% 1_s64
    return n

### n / 10^places with exactly `places` digits after the point (at least one digit before it) and a
### leading minus sign when neg, for places <= 40.
secret routine b128t_fixed_text(neg: Bool, n: U128, places: U64) -> Text
    danger
        var dig = Array[U32, 40]()
        var dp = LLVM::reinterpret_bits[Hijacked[Array[U32, 40]], Hijacked[U32]](dig.hijack())
        var k = b128t_digits(v: n, buf: dp)
        var pl = LLVM::reinterpret_bits[U64, S64](places)
        # the digits written, padded with zeros up to places + 1
        var total = k
        if total < pl +% 1_s64
            total = pl +% 1_s64
        var buf = Array[Character, 96]()
        var p = LLVM::reinterpret_bits[Hijacked[Array[Character, 96]], Hijacked[Character]](buf.hijack())
        var o = 0_s64
        if neg
            p.stride(count: o).poke(value: Character(0x2D_u32))
            o = o +% 1_s64
        var i = total -% 1_s64
        while i >= 0_s64
            if i == pl -% 1_s64
                p.stride(count: o).poke(value: Character(0x2E_u32))
                o = o +% 1_s64
            var ch = 0x30_u32
            if i < k
                ch = dp.stride(count: i).peek()
            p.stride(count: o).poke(value: Character(ch))
            o = o +% 1_s64
            i = i -% 1_s64
        return Text(from_span: p, count: LLVM::reinterpret_bits[S64, U64](o))

### c * 2^q (c > 0, below 2^113) with exactly `places` digits after the point, or false (see
### b128t_round_scaled, and places above 40 also go to the exact method).
secret routine b128t_fixed_binary(neg: Bool, c: U128, q: S64, places: U64) -> (Bool, Text)
    if places > 40_u64
        return (false, "")
    var (ok, n) = b128t_round_scaled(c: c, q: q, p: LLVM::reinterpret_bits[U64, S64](places))
    if not ok
        return (false, "")
    return (true, b128t_fixed_text(neg: neg, n: n, places: places))

### c * 2^q (c > 0, below 2^113) to sig significant digits (half to even) in `%g` layout, or false: the
### leading digit's exponent is estimated from the bit length and settled by the rounded digits.
secret routine b128t_sig_binary(neg: Bool, c: U128, q: S64, sig: U64) -> (Bool, Text)
    if sig == 0_u64 or sig > 37_u64
        return (false, "")
    var sg = LLVM::reinterpret_bits[U64, S64](sig)
    var msb = 127_s64 -% b128_trig_clz128(x: c)
    var e = schubfach_flog10pow2(q: q +% msb)
    var lo = 1_u128
    var j = 1_s64
    while j < sg
        lo = lo *% 10_u128
        j = j +% 1_s64
    var hi = lo *% 10_u128
    var tries = 0_s64
    while tries < 3_s64
        var (ok, r) = b128t_round_scaled(c: c, q: q, p: sg -% 1_s64 -% e)
        if not ok
            return (false, "")
        if r >= hi
            e = e +% 1_s64
        elseif r < lo
            e = e -% 1_s64
        else
            return (true, shortest_decimal_text(neg: neg, f: r, e: e -% sg +% 1_s64, sci_from: sig, wrap: ""))
        tries = tries +% 1_s64
    return (false, "")
