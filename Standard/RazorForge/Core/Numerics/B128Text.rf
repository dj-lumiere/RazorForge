### a + b + cin on U128 words: the sum and the carry out.
@inline
secret routine b128t_add(a: U128, b: U128, cin: U128) -> (U128, U128)
    var s = a +% b
    var c = 0_u128
    if s < a
        c = 1_u128
    var s2 = s +% cin
    if s2 < s
        c = c +% 1_u128
    return (s2, c)

