### me^you (general power), raw IEEE: may return ±inf or NaN. Never crashes.
### :param you: The exponent.
### :returns: `me` raised to the power `you`, possibly non-finite.
routine D32.pow_unchecked(you: D32) -> D32
  var xb = d32_to_b64(x: me)
  var eb = d32_to_b64(x: you)
  var cond = eb.abs() *! (xb.abs().log_unchecked().abs() +! 1.0_b64)
  var (fast, v) = d32_from_b64_band(y: xb.pow_unchecked(exp: eb), k: d32_b64_k(cond: cond))
  if fast
    return v
  var wide = d32_to_d64_exact(x: me).pow_unchecked(you: d32_to_d64_exact(x: you))
  if not d64_is_d32_tie(r: wide)
    return d64_to_d32_round(r: wide)
  return d32_settle_tie(r: wide, wide: D128(from: me).pow_unchecked(you: D128(from: you)))

### sqrt(x^2 + y^2) (without spurious overflow). Crashes if non-finite.
### :param x: The first leg.
### :param y: The second leg.
### :returns: The Euclidean length `hypot(x, y)`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine hypot!(x: D32, y: D32) -> D32
  var r = hypot_unchecked(x: x, y: y)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `hypot(x, y)`, raw IEEE: may return +inf. Never crashes.
### :param x: The first leg.
### :param y: The second leg.
### :returns: The Euclidean length, possibly +inf.
routine hypot_unchecked(x: D32, y: D32) -> D32
  var (fast, v) = d32_from_b64_band(y: hypot_unchecked(x: d32_to_b64(x: x), y: d32_to_b64(x: y)), k: 51_s64)
  if fast
    return v
  var (wide_ok, w) = d32_round_within(r: hypot_unchecked(x: B128(from: x), y: B128(from: y)), k: 110_s64)
  if wide_ok
    return w
  var r = hypot_unchecked(x: d32_to_d64_exact(x: x), y: d32_to_d64_exact(x: y))
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: hypot_unchecked(x: D128(from: x), y: D128(from: y)))
  return d64_to_d32_round(r: r)

### sqrt(x^2 + y^2 + z^2) (without spurious overflow). Crashes if non-finite.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: The 3D Euclidean length.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine hypot!(x: D32, y: D32, z: D32) -> D32
  var r = hypot_unchecked(x: x, y: y, z: z)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `hypot(x, y, z)`, raw IEEE: may return +inf. Never crashes.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: The 3D Euclidean length, possibly +inf.
routine hypot_unchecked(x: D32, y: D32, z: D32) -> D32
  var (fast, v) = d32_from_b64_band(y: hypot_unchecked(x: d32_to_b64(x: x), y: d32_to_b64(x: y), z: d32_to_b64(x: z)), k: 51_s64)
  if fast
    return v
  var r = hypot_unchecked(x: d32_to_d64_exact(x: x), y: d32_to_d64_exact(x: y), z: d32_to_d64_exact(x: z))
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: hypot_unchecked(x: D128(from: x), y: D128(from: y), z: D128(from: z)))
  return d64_to_d32_round(r: r)

### Fused multiply-add me*b + c, single rounding,. Crashes if non-finite.
### :param b: The multiplier.
### :param c: The addend.
### :returns: `me * b + c` rounded once.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.fma!(b: D32, c: D32) -> D32
  var r = me.fma_unchecked(b: b, c: c)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * b + c` (single rounding), raw IEEE: may return ±inf or NaN. Never crashes.
### :param b: The multiplier.
### :param c: The addend.
### :returns: `me * b + c`, possibly non-finite.
routine D32.fma_unchecked(b: D32, c: D32) -> D32
  var xb = d32_to_b64(x: me)
  var bb = d32_to_b64(x: b)
  var cb = d32_to_b64(x: c)
  var yb = xb.fma_unchecked(b: bb, c: cb)
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: ((xb *! bb).abs() +! cb.abs()) /! yb.abs()))
  if fast
    return v
  var r = d32_to_d64_exact(x: me).fma_unchecked(b: d32_to_d64_exact(x: b), c: d32_to_d64_exact(x: c))
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).fma_unchecked(b: D128(from: b), c: D128(from: c)))
  return d64_to_d32_round(r: r)

### Arcsine asin(me). Crashes if non-finite (|me|>1).
### :returns: The arcsine of `me` in radians.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf.
routine D32.asin!() -> D32
  var r = me.asin_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### asin(me), raw IEEE: NaN for |me|>1. Never crashes.
### :returns: The arcsine of `me`, possibly NaN.
routine D32.asin_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.asin_unchecked()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: 1.0_b64 /! ((1.0_b64 -! xb.abs()) *! (1.0_b64 +! xb.abs())).sqrt_unchecked()))
  if fast
    return v
  var k128 = d32_b128_k(cond: 1.0_b64 /! ((1.0_b64 -! xb.abs()) *! (1.0_b64 +! xb.abs())).sqrt_unchecked())
  if k128 >= 60_s64
    var (wide_ok, w) = d32_round_within(r: B128(from: me).asin_unchecked(), k: k128)
    if wide_ok
      return w
  var r = d32_to_d64_exact(x: me).asin_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).asin_unchecked())
  return d64_to_d32_round(r: r)

### Arccosine acos(me). Crashes if non-finite (|me|>1).
### :returns: The arccosine of `me` in radians.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf.
routine D32.acos!() -> D32
  var r = me.acos_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### acos(me), raw IEEE: NaN for |me|>1. Never crashes.
### :returns: The arccosine of `me`, possibly NaN.
routine D32.acos_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.acos_unchecked()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: xb.abs() /! (((1.0_b64 -! xb.abs()) *! (1.0_b64 +! xb.abs())).sqrt_unchecked() *! yb.abs())))
  if fast
    return v
  var k128 = d32_b128_k(cond: xb.abs() /! (((1.0_b64 -! xb.abs()) *! (1.0_b64 +! xb.abs())).sqrt_unchecked() *! yb.abs()))
  if k128 >= 60_s64
    var (wide_ok, w) = d32_round_within(r: B128(from: me).acos_unchecked(), k: k128)
    if wide_ok
      return w
  var r = d32_to_d64_exact(x: me).acos_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).acos_unchecked())
  return d64_to_d32_round(r: r)

### Arctangent atan(me) (defined for all reals). Never crashes.
### :returns: The arctangent of `me` in radians.
routine D32.atan() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.atan()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: 1.0_b64))
  if fast
    return v
  var k128 = d32_b128_k(cond: 1.0_b64)
  if k128 >= 60_s64
    var (wide_ok, w) = d32_round_within(r: B128(from: me).atan(), k: k128)
    if wide_ok
      return w
  var r = d32_to_d64_exact(x: me).atan()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).atan())
  return d64_to_d32_round(r: r)

### Two-argument arctangent atan2(y, x), quadrant-aware,. Never crashes.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
### :returns: The angle of (x, y) in radians, in (-pi, pi].
routine atan2(y: D32, x: D32) -> D32
  var yb = d32_to_b64(x: y)
  var xb = d32_to_b64(x: x)
  var tb = atan2(y: yb, x: xb)
  var cond = (xb *! yb).abs() *! 2.0_b64 /! ((xb *! xb +! yb *! yb) *! tb.abs()) +! 1.0_b64
  var (fast, v) = d32_from_b64_band(y: tb, k: d32_b64_k(cond: cond))
  if fast
    return v
  var k128 = d32_b128_k(cond: cond)
  if k128 >= 60_s64
    var (wide_ok, w) = d32_round_within(r: atan2(y: B128(from: y), x: B128(from: x)), k: k128)
    if wide_ok
      return w
  var r = atan2(y: d32_to_d64_exact(x: y), x: d32_to_d64_exact(x: x))
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: atan2(y: D128(from: y), x: D128(from: x)))
  return d64_to_d32_round(r: r)

### Hyperbolic sine sinh(me). Crashes if non-finite (overflow for large |me|).
### :returns: The hyperbolic sine of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.sinh!() -> D32
  var r = me.sinh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### sinh(me), raw IEEE: ±inf on overflow. Never crashes.
### :returns: The hyperbolic sine of `me`, possibly ±inf.
routine D32.sinh_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.sinh_unchecked()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: xb.abs() +! 1.0_b64))
  if fast
    return v
  var r = d32_to_d64_exact(x: me).sinh_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).sinh_unchecked())
  return d64_to_d32_round(r: r)

### Hyperbolic cosine cosh(me). Crashes if non-finite (overflow for large |me|).
### :returns: The hyperbolic cosine of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.cosh!() -> D32
  var r = me.cosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### cosh(me), raw IEEE: +inf on overflow. Never crashes.
### :returns: The hyperbolic cosine of `me`, possibly +inf.
routine D32.cosh_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.cosh_unchecked()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: xb.abs() +! 1.0_b64))
  if fast
    return v
  var r = d32_to_d64_exact(x: me).cosh_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).cosh_unchecked())
  return d64_to_d32_round(r: r)

### Hyperbolic tangent tanh(me) (defined for all reals). Never crashes.
### :returns: The hyperbolic tangent of `me`.
routine D32.tanh() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.tanh()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: 1.0_b64))
  if fast
    return v
  var r = d32_to_d64_exact(x: me).tanh()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).tanh())
  return d64_to_d32_round(r: r)

### Inverse hyperbolic sine asinh(me) (defined for all reals). Never crashes.
### :returns: The inverse hyperbolic sine of `me`.
routine D32.asinh() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.asinh()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: 1.0_b64))
  if fast
    return v
  var r = d32_to_d64_exact(x: me).asinh()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).asinh())
