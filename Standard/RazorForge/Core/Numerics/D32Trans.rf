### sqrt(me), raw IEEE: NaN for me<0, -0 for -0. Never crashes.
### :returns: The square root of `me`, possibly NaN.
routine D32.sqrt_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.sqrt_unchecked()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: 0.5_b64))
  if fast
    return v
  var k128 = d32_b128_k(cond: 0.5_b64)
  if k128 >= 60_s64
    var (wide_ok, w) = d32_round_within(r: B128(from: me).sqrt_unchecked(), k: k128)
    if wide_ok
      return w
  var r = d32_to_d64_exact(x: me).sqrt_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).sqrt_unchecked())
  return d64_to_d32_round(r: r)

