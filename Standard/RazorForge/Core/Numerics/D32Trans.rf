### 10^q for q in [0, 22], every one exact in B64.
secret preset D32_B64_P10: Array[B64, 23] = [1.0_b64, 10.0_b64, 100.0_b64, 1000.0_b64, 10000.0_b64, 100000.0_b64, 1000000.0_b64, 10000000.0_b64, 100000000.0_b64, 1000000000.0_b64, 10000000000.0_b64, 100000000000.0_b64, 1000000000000.0_b64, 10000000000000.0_b64, 100000000000000.0_b64, 1000000000000000.0_b64, 10000000000000000.0_b64, 100000000000000000.0_b64, 1000000000000000000.0_b64, 10000000000000000000.0_b64, 100000000000000000000.0_b64, 1000000000000000000000.0_b64, 10000000000000000000000.0_b64]

### x as a B64 rounded once (correctly rounded): the coefficient times or divided by an exact power of ten
### while |exponent| <= 22, the general conversion otherwise (and for infinities and NaN).
secret routine d32_to_b64(x: D32) -> B64
  var p = x.decode()
  if p.special != 0_u64 or p.exp > 22_s64 or p.exp < -22_s64
    return B64(from: x)
  var v = d32_b64_scale(a: p.coeff.B64(), q: p.exp)
  return if p.sign then v.neg() else v

### a * 10^q for q in [-22, 22], one rounding (10^|q| is exact).
@inline
secret routine d32_b64_scale(a: B64, q: S64) -> B64
  if q >= 0_s64
    return a *! D32_B64_P10[LLVM::reinterpret_bits[S64, U64](q)]
  return a /! D32_B64_P10[LLVM::reinterpret_bits[S64, U64](0_s64 -% q)]

### 2^-m as a B64 for m in [0, 1022].
@inline
secret routine d32_b64_pow2_neg(m: S64) -> B64
  return B64.from_bits(bits: LLVM::reinterpret_bits[S64, U64](1023_s64 -% m) << 52)

### a * 10^q for q in [-120, 120]: one rounding while |q| <= 22 (10^|q| is exact), two otherwise (the
### correctly rounded constant and the product).
@inline
secret routine d32_b64_scale_w(a: B64, q: S64) -> B64
  if q >= 0_s64 and q <= 22_s64
    return a *! D32_B64_P10[LLVM::reinterpret_bits[S64, U64](q)]
  if q < 0_s64 and q >= -22_s64
    return a /! D32_B64_P10[LLVM::reinterpret_bits[S64, U64](0_s64 -% q)]
  return a *! D32_B64_P10W[LLVM::reinterpret_bits[S64, U64](q +% 120_s64)]

### The D32 that every value within y * (1 +- 2^-k) rounds to, and whether there is one.
### - NaN is NaN: the B64 routine returns it exactly where the function is undefined, and every domain
###   boundary (0, +-1, the poles) is exactly representable, so a D32 operand lands on the same side.
### - Exact zero is +-0: a zero of the function at an exactly representable point, or an underflow.
### - With the band below 2^-10, anything at or beyond 2e97 (including infinity) rounds to +-infinity and
###   anything at or below 4e-102 to +-0, both far outside the band from the D32 overflow threshold
###   (9.9999995e96) and half the smallest subnormal (5e-102).
### - Otherwise |y| is scaled to t = |y| * 10^q in [10^6, 10^7) (one rounding while |q| <= 22, two
###   beyond), the band around t is widened to 2^(1-k), or 2^(2-k) for two roundings (k capped at 50), to
###   cover those roundings and the roundings of its own ends, and when both ends round half up to the same
###   integer n and the lower end is not exactly on n - 1/2, no D32 rounding boundary lies inside it:
###   n * 10^-q is the correctly rounded D32 (decfin32 saturates a carry past the largest to infinity).
###   Subnormal results (exponent below -101) are left to the slower paths.
secret routine d32_from_b64_band(y: B64, k: S64) -> (Bool, D32)
  var neg = y.signbit()
  if y.is_nan()
    return (true, D32.quiet_nan())
  if y.is_zero()
    return (true, d32_of_parts(p: D32Parts(sign: neg, special: 0_u64, exp: 0_s64, coeff: 0_u64)))
  if k < 10_s64
    return (false, D32.quiet_nan())
  var a = y.abs()
  if a >= 2e97_b64
    return (true, D32.infinity(sign: neg))
  if a <= 4e-102_b64
    return (true, d32_of_parts(p: D32Parts(sign: neg, special: 0_u64, exp: 0_s64, coeff: 0_u64)))
  if k < 27_s64
    return (false, D32.quiet_nan())
  var e10 = (b64_exponent(x: a) *% 315653_s64) >> 20
  var q = 6_s64 -% e10
  var t = d32_b64_scale_w(a: a, q: q)
  if t >= 10000000.0_b64
    q = q -% 1_s64
    t = d32_b64_scale_w(a: a, q: q)
  elseif t < 1000000.0_b64
    q = q +% 1_s64
    t = d32_b64_scale_w(a: a, q: q)
  var e = 0_s64 -% q
  if e < -101_s64
    return (false, D32.quiet_nan())
  var kk = k
  if kk > 50_s64
    kk = 50_s64
  var widen = kk -% 1_s64
  if q > 22_s64 or q < -22_s64
    widen = kk -% 2_s64
  var d = t *! d32_b64_pow2_neg(m: widen)
  var lo_arg = t -! d +! 0.5_b64
  var lo = lo_arg.floor()
  if lo != (t +! d +! 0.5_b64).floor() or lo == lo_arg
    return (false, D32.quiet_nan())
  var n = LLVM::float_to_unsigned[B64, U64](value: lo)
  if n == 10000000_u64
    n = 1000000_u64
    e = e +% 1_s64
  return (true, d32_of_parts(p: decfin32(sign: neg, coeff: n, exp: e, pref: 90_s64)))

### k with (1 + cond) * 2^-53 <= 2^-k for a condition-number bound, 0 when the bound is not finite.
secret routine d32_b64_k(cond: B64) -> S64
  if not cond.is_finite()
    return 0_s64
  var c = cond.abs()
  if c < 1.0_b64
    return 51_s64
  return 50_s64 -% b64_exponent(x: c)

### k with (1 + cond) * 2^-112 <= 2^-k (a B128 input rounding plus the B128 routine's half ulp).
secret routine d32_b128_k(cond: B64) -> S64
  if not cond.is_finite()
    return 0_s64
  var c = cond.abs()
  if c < 1.0_b64
    return 110_s64
  return 109_s64 -% b64_exponent(x: c)

### A bound on |x digamma(x)|, the condition number of tgamma (and, over |lgamma(x)|, of lgamma). For
### x > 0, digamma(x) lies in [log x - 1/x, log x]; for x < 0 the reflection formula bounds it through
### cot(pi x), which grows near the poles. Infinite (no fast path) at 0 and for NaN.
secret routine d32_gamma_cond(x: B64) -> B64
  if x > 0.0_b64
    return x *! (x.log_unchecked().abs() +! 1.0_b64) +! 2.0_b64
  if not (x < 0.0_b64)
    return B64.from_bits(bits: 0x7FF0000000000000_u64)
  # reflection: digamma(x) = digamma(1 - x) - pi cot(pi x), with |digamma(1 - x)| <= log(1 - x) + 1
  return x.abs() *! ((1.0_b64 -! x).log_unchecked() +! 1.0_b64 +! 3.2_b64 /! x.tanpi().abs()) +! 2.0_b64

# ============================================================================
# Transcendentals — B64, then B128, then D64 (see the top of this file). Out-of-domain operands come out
# as NaN from every tier, so no domain checks are needed here.
# ============================================================================

### e^me. Crashes on a non-finite result.
### :returns: The exponential of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.exp!() -> D32
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### e^me, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: The exponential of `me`, possibly non-finite.
routine D32.exp_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.exp_unchecked()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: xb.abs()))
  if fast
    return v
  var k128 = d32_b128_k(cond: xb.abs())
  if k128 >= 60_s64
    var (wide_ok, w) = d32_round_within(r: B128(from: me).exp_unchecked(), k: k128)
    if wide_ok
      return w
  var r = d32_to_d64_exact(x: me).exp_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).exp_unchecked())
  return d64_to_d32_round(r: r)

### e^me - 1 (accurate near 0). Crashes on a non-finite result.
### :returns: `exp(me) - 1`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.expm1!() -> D32
  var r = me.expm1_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `exp(me) - 1`, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: `exp(me) - 1`, possibly non-finite.
routine D32.expm1_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.expm1_unchecked()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: xb.abs() +! 1.0_b64))
  if fast
    return v
  var k128 = d32_b128_k(cond: xb.abs() +! 1.0_b64)
  if k128 >= 60_s64
    var (wide_ok, w) = d32_round_within(r: B128(from: me).expm1_unchecked(), k: k128)
    if wide_ok
      return w
  var r = d32_to_d64_exact(x: me).expm1_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).expm1_unchecked())
  return d64_to_d32_round(r: r)

