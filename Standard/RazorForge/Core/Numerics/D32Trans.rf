### Natural log ln(me). Crashes on a non-finite result (me<=0).
### :returns: The natural logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D32.log!() -> D32
  var r = me.log_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### ln(me), raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The natural logarithm of `me`, possibly non-finite.
routine D32.log_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.log_unchecked()
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: 1.0_b64 /! yb.abs()))
  if fast
    return v
  var k128 = d32_b128_k(cond: 1.0_b64 /! yb.abs())
  if k128 >= 60_s64
    var (wide_ok, w) = d32_round_within(r: B128(from: me).log_unchecked(), k: k128)
    if wide_ok
      return w
  var r = d32_to_d64_exact(x: me).log_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).log_unchecked())
  return d64_to_d32_round(r: r)

### ln(1+me) (accurate near 0). Crashes on a non-finite result (me<=-1).
### :returns: `ln(1 + me)`.
### :throws: {NumericDomainError} on NaN (me<-1); {NumericOverflowError} on ±inf (me=-1).
routine D32.log1p!() -> D32
  var r = me.log1p_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(1 + me)`, raw IEEE: NaN for me<-1, -inf for me=-1. Never crashes.
### :returns: `ln(1 + me)`, possibly non-finite.
routine D32.log1p_unchecked() -> D32
  var xb = d32_to_b64(x: me)
  var yb = xb.log1p_unchecked()
  var cond = xb.abs() /! ((1.0_b64 +! xb) *! yb.abs())
  var (fast, v) = d32_from_b64_band(y: yb, k: d32_b64_k(cond: cond))
  if fast
    return v
  var (lr, lk) = b128_log1p_fast(t: B128(from: me))
  var k128 = d32_b128_k(cond: cond)
  if lk > 0_s64 and k128 >= 62_s64
    var (wide_ok, w) = d32_round_within(r: lr, k: k128 -% 2_s64)
    if wide_ok
      return w
  var r = d32_to_d64_exact(x: me).log1p_unchecked()
  if d64_is_d32_tie(r: r)
    return d32_settle_tie(r: r, wide: D128(from: me).log1p_unchecked())
  return d64_to_d32_round(r: r)

