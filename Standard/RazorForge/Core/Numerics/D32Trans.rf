module Core

# ============================================================================
# D32Trans — decimal32 (Pmax=7) transcendentals and the rest of the math surface. Each function tries, in order:
# 1. B64: the operands rounded once to B64 and the correctly rounded B64 CORE-MATH routine; the result is
#    kept when its error band ((1 + condition number) * 2^-53) rounds to one D32.
# 2. B128, for the functions with a fast CORE-MATH B128 port: the same test at 2^-113 per rounding.
# 3. D64: the operands widened exactly, the correctly rounded D64 routine, one rounding to 7 digits. That is
#    the correct D32 unless the D64 result sits exactly on a D32 midpoint; then the operation is repeated in
#    D128, which decides the direction or confirms an exact midpoint (rounded half-even).
#
# The dec<->bin conversions (B16/B32/B64/B128 <-> D32) are the integer bridge in D64Trans.rf
# (decimal_to_binary_bits / b128_to_d32), correctly rounded in one step.
# ============================================================================

### dec -> bin: D32 value as a B64, correctly rounded (see decimal_to_binary_bits).
routine B64(from: D32) -> B64
  var d = from.decode()
  return B64.from_bits(bits: LLVM::int_truncate[U128, U64](decimal_to_binary_bits(sign: d.sign, special: d.special, coeff: d.coeff, exp: d.exp, p: 53_s64, emin: -1022_s64, emax: 1023_s64)))

### bin -> dec: B64 value as a D32, correctly rounded (exact widening to B128, then b128_to_d32).
routine D32(from: B64) -> D32
  return b128_to_d32(x: B128(from: from))

### D32 -> D64, exact: every decimal32 value (cohort, NaN payload and all) is a decimal64 value.
secret routine d32_to_d64_exact(x: D32) -> D64
  var p = x.decode()
  return d64_of_parts(p: D64Parts(sign: p.sign, special: p.special, exp: p.exp, coeff: p.coeff))

### True when `r` lies exactly on a D32 rounding midpoint: the digits D32 has to drop (the excess over 7,
### or those below the minimum exponent) are exactly half of the dropped quantum. A correctly rounded
### D64 result that is NOT on a midpoint rounds to the same D32 as the exact value, since rounding to
### nearest never crosses a representable number and every D32 midpoint is representable in D64.
secret routine d64_is_d32_tie(r: D64) -> Bool
  var p = r.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u64)
    return false
  var nd = digits10_u64(c: p.coeff)
  var drop = LLVM::sub(a: nd, b: 7_s64)
  var under = LLVM::sub(a: -101_s64, b: p.exp)
  if LLVM::signed_gt(a: under, b: drop)
    drop = under
  if LLVM::signed_le(a: drop, b: 0_s64) or LLVM::signed_gt(a: drop, b: nd)
    return false
  var half = LLVM::mul(a: p10_u64(k: LLVM::sub(a: drop, b: 1_s64)), b: 5_u64)
  if LLVM::int_eq(a: drop, b: nd)
    return LLVM::int_eq(a: p.coeff, b: half)
  var kept = div_pow10_u64(x: p.coeff, k: drop)
  var tail = LLVM::sub(a: p.coeff, b: LLVM::mul(a: kept, b: p10_u64(k: drop)))
  return LLVM::int_eq(a: tail, b: half)

### True when a D128 result lies exactly on a D32 rounding midpoint (see d64_is_d32_tie).
secret routine d128_is_d32_tie(r: D128) -> Bool
  var p = r.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u128)
    return false
  var nd = digits10_u128(c: p.coeff)
  var drop = LLVM::sub(a: nd, b: 7_s64)
  var under = LLVM::sub(a: -101_s64, b: p.exp)
  if LLVM::signed_gt(a: under, b: drop)
    drop = under
  if LLVM::signed_le(a: drop, b: 0_s64) or LLVM::signed_gt(a: drop, b: nd)
    return false
  var half = LLVM::mul(a: p10_u128(k: LLVM::sub(a: drop, b: 1_s64)), b: 5_u128)
  if LLVM::int_eq(a: drop, b: nd)
    return LLVM::int_eq(a: p.coeff, b: half)
  var kept = div_pow10_u128(x: p.coeff, k: drop)
  var tail = LLVM::sub(a: p.coeff, b: LLVM::mul(a: kept, b: p10_u128(k: drop)))
  return LLVM::int_eq(a: tail, b: half)

### True for a finite nonzero D32 with |x| < 10^-20 (below that, tgamma's D32 rounding step is at least
### 10^13, so a D32 midpoint within gamma's -0.58 offset of 1/x = 10^-e / c must be 1/x itself).
secret routine d32_tiny_for_gamma(x: D32) -> Bool
  var p = x.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u64)
    return false
  return LLVM::signed_le(a: LLVM::add(a: p.exp, b: digits10_u64(c: p.coeff)), b: -20_s64)

### The D32 just below the D32 midpoint `r` (rounded toward -infinity). tgamma(x) for |x| < 10^-20 is
### 1/x - 0.5772... + O(x), so when the midpoint is 1/x itself (the only midpoint D128 cannot separate
### from it there, e.g. x = +-2.048E-40 with 1/x = +-4.8828125E+39) the true value lies just below it.
secret routine d64_to_d32_round_down(r: D64) -> D32
  var p = r.decode()
  var nd = digits10_u64(c: p.coeff)
  var drop = LLVM::sub(a: nd, b: 7_s64)
  var under = LLVM::sub(a: -101_s64, b: p.exp)
  if LLVM::signed_gt(a: under, b: drop)
    drop = under
  var kept = div_pow10_u64(x: p.coeff, k: drop)
  if p.sign
    kept = LLVM::add(a: kept, b: 1_u64)
  return d32_of_parts(p: decfin32(sign: p.sign, coeff: kept, exp: LLVM::add(a: p.exp, b: drop), pref: 90_s64))

### The D32 result when the D64 result `r` sits exactly on a D32 midpoint, given the same operation
### evaluated in D128 as `wide`. Off the midpoint in D128, `wide` decides the direction; still on it, the
### true value is taken to be the midpoint and `r` rounds half-even. For the algebraic functions (sqrt,
### cbrt, hypot, fma, pow with an integer exponent) that follows from the operand sizes. For the one-argument
### functions it was checked over every D32 input (2026-09-27, 3 458 000 000 per function): the midpoint
### D128 cannot separate occurs only for exp2(-11) = 2^-11, exactly a midpoint, and for tgamma of |x| below
### 10^-20, which D32.tgamma_unchecked settles before calling this. The two-argument functions cannot be
### enumerated (about 10^19 operand pairs). hypot, fma and pow with an integer exponent are algebraic, so
### the assumption follows from the operand sizes. atan2 and pow with a non-integer exponent rest on a
### counting argument instead: atan2 of nonzero rationals is transcendental, so it is never exactly a
### midpoint, and pow has exact midpoints (pow(1225, 2.5) = 35^5 = 52521875) where the assumption is right;
### an inexact result would have to agree with a midpoint to all 34 D128 digits, about 2 * 10^-27 of the
### D32 spacing, which over 10^19 pairs is expected about 2 * 10^-8 times.
secret routine d32_settle_tie(r: D64, wide: D128) -> D32
  if d128_is_d32_tie(r: wide)
    return d64_to_d32_round(r: r)
  var n = D32(from: wide)
  var p = n.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u64)
    return n
  return d32_of_parts(p: decfin32(sign: p.sign, coeff: p.coeff, exp: p.exp, pref: 90_s64))

### D64 -> D32 with one half-even rounding (decfin32), the cohort normalized (trailing
### zeros stripped, a zero result has exponent 0).
secret routine d64_to_d32_round(r: D64) -> D32
  var p = r.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return D32(from: r)
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return d32_of_parts(p: D32Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d32_of_parts(p: decfin32(sign: p.sign, coeff: p.coeff, exp: p.exp, pref: 90_s64))

# ============================================================================
# B64 and B128 fast paths. A D32 operand becomes a B64 with one rounding (d32_to_b64: the 7-digit
# coefficient is exact in B64 and so is 10^e for |e| <= 22), the correctly rounded B64 CORE-MATH routine
# evaluates it, and the result is within (1 + cond) * 2^-53 relative of the true value, cond being an
# upper bound on the function's condition number |x f'(x) / f(x)| (the input's rounding scaled by it,
# plus the routine's own half ulp). When every value in that band rounds to one D32 (d32_from_b64_band),
# that D32 is the correctly rounded result. Otherwise a function with a fast CORE-MATH B128 port runs the
# same test on B128 (2^-113 per rounding, d32_round_within), and failing that the D64 route decides.
# ============================================================================

