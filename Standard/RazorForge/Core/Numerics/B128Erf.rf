# 2/sqrt(pi) and 1/sqrt(pi) as (significand, exponent).
secret preset B128_TWO_OVER_SQRTPI: U128 = 0x906EBA8214DB688D71D48A7F6BFEC344_u128
secret preset B128_INV_SQRTPI: U128 = 0x906EBA8214DB688D71D48A7F6BFEC344_u128

### (a * b) / 2^126 truncated toward zero, for signed fixed-point values below 2 in magnitude (units of
### 2^-126).
@inline
secret routine b128erf_smul(a: S128, b: S128) -> S128
  var ua = LLVM::reinterpret_bits[S128, U128](a)
  var ub = LLVM::reinterpret_bits[S128, U128](b)
  if a < 0_s128
    ua = 0_u128 -% ua
  if b < 0_s128
    ub = 0_u128 -% ub
  var p = b128_trig_wmul(x: ua, y: ub)
  var r = LLVM::reinterpret_bits[U128, S128]((p.item0 << 2_u32) | (p.item1 >>> 126_u32))
  if (a < 0_s128) != (b < 0_s128)
    return 0_s128 -% r
  return r

### Table entry j (0 .. 609) of B128_ERFC_MANT / B128_ERFC_EXP as a B128Fx (rounded, 2^-128).
@inline
secret routine b128erf_entry(j: U64) -> B128Fx
  return B128Fx(neg: false, m: B128_ERFC_MANT[j], e: B128_ERFC_EXP[j], rel: 0x1p-128)

### erf(a) for 0 < a < 1/2 as a B128Fx: a (2/sqrt(pi)) P with P = 1 - w Q, Q = sum (-1)^(n-1) w^(n-1) /
### (n! (2n+1)) for n = 1 .. 24 (the rest is below 2^-132), w = a^2 < 1/4, in units of 2^-128 by Horner.
### Every inner value stays positive (each coefficient exceeds w times the next), each step adds at most
### 3.5 units and w damps the earlier ones, so P is within 6 units.
secret routine b128_erf_small(af: B128Fx) -> B128Fx
  var p = b128_trig_wmul(x: af.m, y: af.m)
  var w = p.item0 >>> b128_trig_sh(n: 0_s64 -% (2_s64 *% af.e +% 256_s64))
  var q = B128_ERF_SERIES[23]
  var n = 23_u64
  while n > 0_u64
    n = n -% 1_u64
    q = B128_ERF_SERIES[n] -% b128_trig_mhi(x: w, y: q)
  var d = b128_trig_mhi(x: w, y: q)
  var pf = B128Fx(neg: false, m: 1_u128 << 127_u32, e: -127_s64, rel: 6.0 *! 0x1p-128)
  if d != 0_u128
    pf = B128Fx(neg: false, m: 0_u128 -% d, e: -128_s64, rel: 6.0 *! 0x1p-128)
  var k2 = B128Fx(neg: false, m: B128_TWO_OVER_SQRTPI, e: -127_s64, rel: 0x1p-128)
  return b128fx_mul(a: b128fx_mul(a: af, b: k2), b: pf)

### erfc(a) for 1/2 <= a < 10 as a B128Fx, or false. With c = i/32 the nearest table point and h = a - c
### (exact, |h| <= 1/64): erfc(a) = erfc(c) - (2/sqrt(pi)) e^(-c^2) J with J = the integral of
### e^(-2ct - t^2) over [0, h] = h S, S = sum u_k / (k + 1), where u_k are the Taylor terms of e^(-2ct - t^2)
### at t = h: u_0 = 1, u_1 = -2ch, u_(k+1) = -(2ch u_k + 2h^2 u_(k-1)) / (k + 1). In units of 2^-126 each new
### u picks up at most 3 units (three truncated products) and the earlier errors shrink by 2c|h| / (k + 1)
### <= 1/3, so every u is within 4.5 units, and S (one more truncation per term) within 2K + 8 over K terms;
### S itself is at least e^(-1/3) > 0.7. The subtraction cannot cancel much: the correction is at most
### 1 - e^(-2c|h|) < 0.3 of erfc(c).
secret routine b128_erfc_mid(af: B128Fx) -> (Bool, B128Fx)
  # i = round(32 a), and a - i/32 in units of 2^af.e
  var sh = b128_trig_sh(n: 0_s64 -% af.e -% 5_s64)
  var i = ((af.m >>> (sh -% 1_u32)) +% 1_u128) >>> 1_u32
  # a - i/32 is below 2^(sh - 1) in magnitude, so the wrapping difference is exact as a signed value
  var dd = LLVM::reinterpret_bits[U128, S128](af.m -% (i << sh))
  var dneg = dd < 0_s128
  var dmag = LLVM::reinterpret_bits[S128, U128](dd)
  if dneg
    dmag = 0_u128 -% dmag
  # H = h * 2^126 (exact: a has at least 15 trailing zero bits and af.e >= -128)
  var hmag = dmag
  var up = af.e +% 126_s64
  if up >= 0_s64
    hmag = dmag << b128_trig_sh(n: up)
  else
    hmag = dmag >>> b128_trig_sh(n: 0_s64 -% up)
  var hs = LLVM::reinterpret_bits[U128, S128](hmag)
  if dneg
    hs = 0_s128 -% hs
  var ii = LLVM::reinterpret_bits[U128, S128](i)
  # A = 2ch = i h / 16, B = 2h^2
  var aa = ii *% (hs >> 4_u32)
  var bb = b128erf_smul(a: hs, b: hs) *% 2_s128
  var one = LLVM::reinterpret_bits[U128, S128](1_u128 << 126_u32)
  var u0 = one
  var u1 = 0_s128 -% aa
  var s = u0 +% b128erf_smul(a: u1, b: LLVM::reinterpret_bits[U128, S128](B128_ERF_RECIP[1]))
  var k = 1_s64
  while k < 45_s64 and (u0 != 0_s128 or u1 != 0_s128)
    var t = b128erf_smul(a: aa, b: u1) +% b128erf_smul(a: bb, b: u0)
    var un = 0_s128 -% b128erf_smul(a: t, b: LLVM::reinterpret_bits[U128, S128](B128_ERF_RECIP[LLVM::reinterpret_bits[S64, U64](k)]))
    s = s +% b128erf_smul(a: un, b: LLVM::reinterpret_bits[U128, S128](B128_ERF_RECIP[LLVM::reinterpret_bits[S64, U64](k +% 1_s64)]))
    u0 = u1
    u1 = un
    k = k +% 1_s64
  if u0 != 0_s128 or u1 != 0_s128 or s <= 0_s128
    return (false, af)
  var j = LLVM::int_truncate[U128, U64](i -% 16_u128) *% 2_u64
  var ec = b128erf_entry(j: j)
  if hmag == 0_u128
    return (true, ec)
  var sf = b128fx_norm(neg: false, mag: LLVM::zero_extend[U128, U256](LLVM::reinterpret_bits[S128, U128](s)), scale: -126_s64, abserr: B64(from: 2_s64 *% k +% 8_s64))
  var hf = b128fx_norm(neg: dneg, mag: LLVM::zero_extend[U128, U256](hmag), scale: -126_s64, abserr: 0.0)
  var corr = b128fx_mul(a: b128erf_entry(j: j +% 1_u64), b: b128fx_mul(a: hf, b: sf))
  return b128fx_add(a: ec, b: b128fx_neg(v: corr))

### e^(-a^2) for a finite a as a B128Fx, or false (a result outside exp's fast range): a^2 is exact in 256
### bits, split into its first 113 bits zb (a B128) and the rest zl (below 2^-112 zb), and e^(-a^2) =
### e^(-zb) (1 - zl), dropping zl^2/2 (below 2^-200 wherever the result is normal).
secret routine b128_exp_neg_sq(a: B128, acc: Bool) -> (Bool, B128Fx)
  var af = b128fx_of(x: a)
  var p = b128_trig_wmul(x: af.m, y: af.m)
  var pw = (LLVM::zero_extend[U128, U256](p.item0) << 128_u32) | LLVM::zero_extend[U128, U256](p.item1)
  var scale = 2_s64 *% af.e
  var lead = 255_s64 -% LLVM::int_truncate[U256, S64](LLVM::leading_zeros(pw))
  var sh = b128_trig_sh(n: lead -% 112_s64)
  var zsig = LLVM::int_truncate[U256, U128](pw >>> sh)
  var rest = pw & ((1_u256 << sh) -% 1_u256)
  var biased = lead +% scale +% 16383_s64
  if biased < 1_s64 or biased > 32766_s64
    return (false, af)
  var zbits = (1_u128 << 127_u32) | (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](biased)) << 112_u32) | (zsig -% (1_u128 << 112_u32))
  var (ok, ez) = b128_exp_fx(x: B128.from_bits(bits: zbits), acc: acc)
  if not ok
    return (false, af)
  if rest == 0_u256
    return (true, ez)
  var zl = b128fx_norm(neg: true, mag: rest, scale: scale, abserr: 0.0)
  var (ok2, onem) = b128fx_add(a: b128fx_one(), b: zl)
  if not ok2
    return (false, af)
  var r = b128fx_mul(a: ez, b: onem)
  return (true, B128Fx(neg: false, m: r.m, e: r.e, rel: r.rel +! 0x1p-200))

### erfc(a) for 10 <= a < 106.5 as a B128Fx, or false: e^(-a^2) / (a sqrt(pi)) times the asymptotic series
### P = sum (-1)^n (2n-1)!! u^n, u = 1/(2a^2) <= 1/200, summed in units of 2^-126 until its terms vanish (it
### is alternating with shrinking terms there, so the tail is below the last term). Each term adds one unit
### of truncation to the previous one's error times (2n - 1) u < 3/4, so every term is within 4 units and P
### within 4N + 4 over N terms, and the relative error of u moves P by less than 2u of it.
secret routine b128_erfc_big(a: B128, acc: Bool) -> (Bool, B128Fx)
  var af = b128fx_of(x: a)
  var x2 = b128fx_mul(a: af, b: af)
  var (oku, u) = b128fx_div(a: b128fx_one(), b: B128Fx(neg: false, m: x2.m, e: x2.e +% 1_s64, rel: x2.rel))
  if not oku
    return (false, af)
  var uu = u.m >>> b128_trig_sh(n: 0_s64 -% (u.e +% 126_s64))
  var one = 1_u128 << 126_u32
  var sum = LLVM::reinterpret_bits[U128, S128](one)
  var t = one
  var n = 1_u64
  while t != 0_u128 and n < 200_u64
    var mult = LLVM::zero_extend[U64, U128](2_u64 *% n -% 1_u64) *% uu
    var pr = b128_trig_wmul(x: t, y: mult)
    t = (pr.item0 << 2_u32) | (pr.item1 >>> 126_u32)
    if (n & 1_u64) == 1_u64
      sum = sum -% LLVM::reinterpret_bits[U128, S128](t)
    else
      sum = sum +% LLVM::reinterpret_bits[U128, S128](t)
    n = n +% 1_u64
  if t != 0_u128
    return (false, af)
  # the multipliers (2n - 1) u stay below m, so each term is within 1 / (1 - m) units
  var nn = B64(from: n)
  var mm = (2.0 *! nn) *! b128fx_b64(v: u)
  if mm >= 0.75
    return (false, af)
  var pf = b128fx_norm(neg: false, mag: LLVM::zero_extend[U128, U256](LLVM::reinterpret_bits[S128, U128](sum)), scale: -126_s64, abserr: nn *! 4.0 +! 4.0)
  pf = B128Fx(neg: false, m: pf.m, e: pf.e, rel: pf.rel +! 2.0 *! u.rel *! 0.01)
  var (okd, inv) = b128fx_div(a: B128Fx(neg: false, m: B128_INV_SQRTPI, e: -128_s64, rel: 0x1p-128), b: af)
  var (oke, ez) = b128_exp_neg_sq(a: a, acc: acc)
  if not okd or not oke
    return (false, af)
  return (true, b128fx_mul(a: ez, b: b128fx_mul(a: pf, b: inv)))

# |x| thresholds as B128 bit patterns without the sign: 1/2, 10 and 106.5.
secret preset B128_ERF_HALF: U128 = 0x3FFE0000000000000000000000000000_u128
secret preset B128_ERF_TEN: U128 = 0x40024000000000000000000000000000_u128
secret preset B128_ERF_MAX: U128 = 0x4005AA00000000000000000000000000_u128
# 107, from which erfc rounds to +0
secret preset B128_ERF_ZERO: U128 = 0x4005AC00000000000000000000000000_u128

### erf(x) for a finite nonzero x as a B128Fx, or false: the series below 1/2,
### 1 - erfc from the table up to 10, and +-1 from there (erfc(10) < 2^-148).
secret routine b128_erf_fx(x: B128) -> (Bool, B128Fx)
  var u = x.to_bits()
  var a = u & ((1_u128 << 127_u32) -% 1_u128)
  if a >= (0x7FFF_u128 << 112_u32) or a == 0_u128
    return (false, b128fx_one())
  var neg = (u >>> 127_u32) != 0_u128
  if a >= B128_ERF_TEN
    # 1 - erf(10) < 2^-148
    return (true, B128Fx(neg: neg, m: 1_u128 << 127_u32, e: -127_s64, rel: 0x1p-148))
  var af = b128fx_of(x: B128.from_bits(bits: a))
  var r = af
  if a < B128_ERF_HALF
    r = b128_erf_small(af: af)
  else
    var (okc, c) = b128_erfc_mid(af: af)
    if not okc
      return (false, b128fx_one())
    var (ok, e) = b128fx_add(a: b128fx_one(), b: b128fx_neg(v: c))
    if not ok
      return (false, b128fx_one())
    r = e
  return (true, B128Fx(neg: neg, m: r.m, e: r.e, rel: r.rel))

### erf(x) as a B128, or false when the band does not settle it.
secret routine b128_erf_fast(x: B128) -> (Bool, B128)
  var (ok, r) = b128_erf_fx(x: x)
  if not ok
    return (false, x)
  return b128fx_round(v: r)

### erfc(x) for a finite nonzero x as a B128Fx, or false: 1 - erf below 1/2, the table up to
### 10, the asymptotic series up to 106.5 (beyond it the result leaves the normal range), and for negative
### x, 2 - erfc(|x|) (exactly 2 from -10 down, as 2 - erfc(10) rounds to 2). acc takes e^(-x^2) of the series
### from the exponential's accurate phase.
secret routine b128_erfc_fx(x: B128, acc: Bool) -> (Bool, B128Fx)
  var u = x.to_bits()
  var a = u & ((1_u128 << 127_u32) -% 1_u128)
  if a >= (0x7FFF_u128 << 112_u32) or a == 0_u128
    return (false, b128fx_one())
  var neg = (u >>> 127_u32) != 0_u128
  var af = b128fx_of(x: B128.from_bits(bits: a))
  var two = B128Fx(neg: false, m: 1_u128 << 127_u32, e: -126_s64, rel: 0.0)
  if a < B128_ERF_HALF
    var s = b128_erf_small(af: af)
    var (ok, r) = b128fx_add(a: b128fx_one(), b: B128Fx(neg: not neg, m: s.m, e: s.e, rel: s.rel))
    if not ok
      return (false, b128fx_one())
    return (true, r)
  if a < B128_ERF_TEN
    var (okc, c) = b128_erfc_mid(af: af)
    if not okc
      return (false, b128fx_one())
    if neg
      var (ok2, r2) = b128fx_add(a: two, b: b128fx_neg(v: c))
      if not ok2
        return (false, b128fx_one())
      return (true, r2)
    return (true, c)
  if neg
    # erfc(10) < 2^-148
    return (true, B128Fx(neg: false, m: 1_u128 << 127_u32, e: -126_s64, rel: 0x1p-149))
  if a >= B128_ERF_MAX
    return (false, b128fx_one())
  var (okb, cb) = b128_erfc_big(a: B128.from_bits(bits: a), acc: acc)
  if not okb
    return (false, b128fx_one())
  return (true, cb)


### erfc(x) as a B128, or false when the band does not settle it.
secret routine b128_erfc_fast(x: B128) -> (Bool, B128)
  if x.to_bits() >= B128_ERF_ZERO and x.to_bits() < (1_u128 << 127_u32) and not x.is_nan()
    # from 107 on e^(-x^2) / (x sqrt(pi)) is below half the smallest subnormal (+inf included)
    return (true, B128.from_bits(bits: 0_u128))
  var (ok, r) = b128_erfc_fx(x: x, acc: false)
  if not ok
    return (false, x)
  var (okr, v) = b128fx_round(v: r)
  if okr or x < 10.0_b128
    return (okr, v)
  var (oka, ra) = b128_erfc_fx(x: x, acc: true)
  if not oka
    return (false, x)
  return b128fx_round(v: ra)