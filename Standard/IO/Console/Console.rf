module IO/Console

import IO/Errors
import IO/Stream
# ============================================================================
# Console streams — concrete Source / Sink over the process-global std streams
# ============================================================================
# The console is NOT a {File}: there is no persistent, addressable content underneath it — nothing to
# open as storage. (A terminal's escape-sequence handling is a program-to-program convention, the same layer
# as PNG's magic bytes, NOT the medium imposing a format — so that is NOT the disqualifier. The absence
# of persistent, addressable content is.) So stdin/stdout/stderr are born as {Source}/{Sink} directly.
# They are process-global and never closed, so they do NOT obey {Enterable} — use them inline, never
# `using`. They are cheap `record`s (copying one just re-refers to the same global stream).

### stdin as a {Source}. Consume forward with `pull`; an empty result signals EOF.
record ConsoleIn
obeys Source
    ### The standard-input descriptor (0). Present for identity; `pull` reads stdin via the runtime.
    secret fd: S32

### stdout or stderr as a {Sink}, discriminated by `fd` (1 = stdout, 2 = stderr).
record ConsoleOut
obeys Sink
    ### The standard stream descriptor: 1 = stdout, 2 = stderr.
    secret fd: S32

# ============================================================================
# Output: show() - Standard Output (stdout)
# ============================================================================
### Writes text to standard output.
### `end` is appended after `value`.
### :param value: The text to write.
### :param end: The trailing text to append.
routine show(value: Text, end: Text = "\n")
    # One write for the value and its end, so two threads writing at once don't mix their lines.
    var line_cstr = f"{value}{end}".to[CStr]()
    C::rf_console_show(ptr: line_cstr.view().ptr(), len: line_cstr.count())
    return

### Writes raw bytes to standard output.
### `end` is appended after `value`.
### :param value: The bytes to write.
### :param end: The trailing text to append.
routine show(value: Bytes, end: Text = "\n")
    var value_cstr = value.to[CStr]()
    C::rf_console_show(ptr: value_cstr.view().ptr(), len: value_cstr.count())
    var end_cstr = end.to[CStr]()
    C::rf_console_show(ptr: end_cstr.view().ptr(), len: end_cstr.count())
    return

### Writes a single value to standard output using its representable form.
### :param value: The value to render and write.
### :param end: The trailing text to append.
routine show[T](value: T, end: Text = "\n")
    # One write for the value and its end, so two threads writing at once don't mix their lines.
    var line_cstr = f"{value.represent()}{end}".to[CStr]()
    C::rf_console_show(ptr: line_cstr.view().ptr(), len: line_cstr.count())
    return

# ============================================================================
# Output: alert() - Standard Error (stderr)
# ============================================================================

### Writes text to standard error.
### :param value: The text to write.
### :param end: The trailing text to append.
routine alert(value: Text, end: Text = "\n")
    # One write for the value and its end, so two threads writing at once don't mix their lines.
    var line_cstr = f"{value}{end}".to[CStr]()
    C::rf_console_alert(ptr: line_cstr.view().ptr(), len: line_cstr.count())
    return

### Writes raw bytes to standard error.
### :param value: The bytes to write.
### :param end: The trailing text to append.
routine alert(value: Bytes, end: Text = "\n")
    var value_cstr = value.to[CStr]()
    C::rf_console_alert(ptr: value_cstr.view().ptr(), len: value_cstr.count())
    var end_cstr = end.to[CStr]()
    C::rf_console_alert(ptr: end_cstr.view().ptr(), len: end_cstr.count())
    return

### Writes a single value to standard error using its diagnostic form.
### :param value: The value to render and write.
### :param end: The trailing text to append.
routine alert[T](value: T, end: Text = "\n")
    # One write for the value and its end, so two threads writing at once don't mix their lines.
    var line_cstr = f"{value.diagnose()}{end}".to[CStr]()
    C::rf_console_alert(ptr: line_cstr.view().ptr(), len: line_cstr.count())
    return

# ============================================================================
# Input: Text functions (default)
# ============================================================================

### Reads one line of text from standard input.
### Line termination is not included in the returned text, and a blank line is `""`. Right after {ask_word}, the line
### end that ended the word is not read as a blank line of its own.
### :returns: The resulting `Text` value.
### :throws: {EndOfInputError} when the input has ended.
failable routine ask_line() -> Text
    var ptr = C::rf_console_ask_line()
    if ptr.is_hollow()
        throw EndOfInputError(reader: "ask_line")
    var bytes = Bytes(ptr: ptr)
    return bytes.decode_as_utf8_lossy()

### Reads one line of standard input as a `T`: `var n: S64 = ask()` (the type the value goes to), or `ask[S64]()`.
### The line becomes the value the way `line.to[T]()` makes it, so a line that isn't one fails like that does.
### :typeparam T: The type the line becomes.
### :returns: The line as a `T`.
### :throws: {InvalidValueError} or what else `to[T]()` throws when the line isn't a `T`, {EndOfInputError} when the
### input has ended.
failable routine ask[T]() -> T
    return ask_line().to[T]()

### Reads one whitespace-delimited word from standard input.
### :returns: The resulting `Text` value.
### :throws: {EndOfInputError} when the input has ended before another word.
failable routine ask_word() -> Text
    var ptr = C::rf_console_ask_word()
    if ptr.is_hollow()
        throw EndOfInputError(reader: "ask_word")
    var bytes = Bytes(ptr: ptr)
    return bytes.decode_as_utf8_lossy()

### Reads all remaining text from standard input.
### :returns: The resulting `Text` value.
routine ask_all() -> Text
    var ptr = C::rf_console_ask_all()
    if ptr.is_hollow()
        return ""
    var bytes = Bytes(ptr: ptr)
    return bytes.decode_as_utf8_lossy()

### Reads all remaining input and splits it into lines, as {Text.lines} does: the line ending after the last line
### starts no new one.
### :returns: The resulting `List[Text]` value.
routine ask_lines() -> List[Text]
    return ask_all().lines()

### Reads all remaining input and splits it into whitespace-delimited words.
### :returns: The resulting `List[Text]` value.
routine ask_words() -> List[Text]
    var all = ask_all()
    return all.words()

# ============================================================================
# Input: Bytes functions (opt-in)
# ============================================================================

### Reads all remaining standard input as raw bytes.
### :returns: The resulting `Bytes` value.
routine ask_raw() -> Bytes
    var ptr = C::rf_console_ask_all()
    if ptr.is_hollow()
        return Bytes()
    return Bytes(ptr: ptr)

### Reads up to `count` bytes from standard input.
### :param count: The maximum number of bytes to read.
### :returns: The resulting `Bytes` value.
routine ask_bytes(count: U64) -> Bytes
    var ptr = C::rf_console_ask_bytes(count)
    if ptr.is_hollow()
        return Bytes()
    return Bytes(ptr: ptr)

### The standard-input source.
### :returns: A {ConsoleIn} over stdin.
routine stdin() -> ConsoleIn
    return ConsoleIn(fd: 0)

### The standard-output sink.
### :returns: A {ConsoleOut} over stdout.
routine stdout() -> ConsoleOut
    return ConsoleOut(fd: 1)

### The standard-error sink.
### :returns: A {ConsoleOut} over stderr.
routine stderr() -> ConsoleOut
    return ConsoleOut(fd: 2)

### Pulls up to `max` bytes from standard input; an empty `Bytes` signals EOF.
### :param max: The maximum byte count to pull.
### :returns: The bytes pulled, or empty at EOF.
routine ConsoleIn.pull(max: U64) -> Bytes
    var ptr = C::rf_console_ask_bytes(max)
    if ptr.is_hollow()
        return Bytes()
    return Bytes(ptr: ptr)

### Pushes `data` to the underlying standard stream, returning the number of bytes accepted.
### :param data: The bytes to push.
### :returns: The number of bytes accepted (always `data.count()`).
routine ConsoleOut.push(data: Bytes) -> U64
    danger
        if me.fd == 2
            C::rf_console_alert(ptr: data.raw_buffer(), len: data.count())
        else
            C::rf_console_show(ptr: data.raw_buffer(), len: data.count())
    return data.count()

### Flushes the standard stream. No-op — the runtime flushes stdout/stderr for you.
routine ConsoleOut.flush()
    return
