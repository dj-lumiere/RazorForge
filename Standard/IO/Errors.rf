module IO/Errors

### Represents the crashable raised for filesystem and stream I/O failures.
### `IOError` is the generic runtime carrier for operating-system and
### environment-dependent failures that do not have a more specific I/O type.
crashable IOError
    ### Stores the human-readable description of the I/O failure.
    description: Text

### Returns the message associated with this I/O failure.
### :returns: The resulting `Text` value.
@override
routine IOError.crash_message() -> Text
    return me.description

### Represents the crashable raised when standard input has ended before a read found anything to read.
crashable EndOfInputError
    ### Stores the name of the routine that found the input ended.
    reader: Text

### Returns the message naming the routine that found the input ended.
### :returns: The resulting `Text` value.
@override
routine EndOfInputError.crash_message() -> Text
    return f"The input ended before {me.reader}() found anything to read."
