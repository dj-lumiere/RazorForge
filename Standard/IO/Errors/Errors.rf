module IO/Errors

### Represents the crashable raised for filesystem and stream I/O failures that have no more specific crashable:
### a missing path is {NotFoundError}, a refusal {NotEnoughPermissionError}, a full device {NotEnoughSpaceError}, and
### a device that failed to read or write {StorageFaultError}. Each is its own crashable, so a `when` names the ones
### it handles (`is Crashables` takes them all).
crashable IOError
    ### Stores the human-readable description of the I/O failure.
    description: Text

### Returns the message associated with this I/O failure.
### :returns: The resulting `Text` value.
@override
routine IOError.crash_message() -> Text
    return me.description

### Represents the crashable raised when standard input has ended before a read found anything to read.
crashable EndOfInputError
    ### Stores the name of the routine that found the input ended.
    reader: Text

### Returns the message naming the routine that found the input ended.
### :returns: The resulting `Text` value.
@override
routine EndOfInputError.crash_message() -> Text
    return f"The input ended before {me.reader}() found anything to read."

### Represents the crashable raised when a file system call finds nothing at the path it was given.
crashable NotFoundError
    ### Stores the human-readable description of what could not be done.
    description: Text

### Returns the message associated with this failure.
### :returns: The resulting `Text` value.
@override
routine NotFoundError.crash_message() -> Text
    return me.description

### Represents the crashable raised when the operating system doesn't allow this program what a file system call
### asked for (reading, writing, deleting, a read-only file system).
crashable NotEnoughPermissionError
    ### Stores the human-readable description of what could not be done.
    description: Text

### Returns the message associated with this failure.
### :returns: The resulting `Text` value.
@override
routine NotEnoughPermissionError.crash_message() -> Text
    return me.description

### Represents the crashable raised when the storage device has no room left for what a file system call writes.
crashable NotEnoughSpaceError
    ### Stores the human-readable description of what could not be done.
    description: Text

### Returns the message associated with this failure.
### :returns: The resulting `Text` value.
@override
routine NotEnoughSpaceError.crash_message() -> Text
    return me.description

### Represents the crashable raised when the storage device itself failed to read or write (a bad sector, a device
### that stopped answering).
crashable StorageFaultError
    ### Stores the human-readable description of what could not be done and where.
    description: Text

### Returns the message associated with this failure.
### :returns: The resulting `Text` value.
@override
routine StorageFaultError.crash_message() -> Text
    return me.description
