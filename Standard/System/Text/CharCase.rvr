### The simple uppercase mapping of a code point.
### :param cp: The code point.
### :returns: The code point it maps to, or `cp` itself.
secret routine unicode_uppercase(cp: S64) -> S64
    var low: U64 = 0
    var high: U64 = 204
    until low >= high
        var mid = (low + high) // 2
        var at = mid * 4
        if cp < UPPERCASE_RUNS[at]
            high = mid
        elseif cp > UPPERCASE_RUNS[at + 1]
            low = mid + 1
        elseif (cp - UPPERCASE_RUNS[at]) % UPPERCASE_RUNS[at + 2] == 0
            return cp + UPPERCASE_RUNS[at + 3]
        else
            return cp
    return cp

### The simple lowercase mapping of a code point.
### :param cp: The code point.
### :returns: The code point it maps to, or `cp` itself.
secret routine unicode_lowercase(cp: S64) -> S64
    var low: U64 = 0
    var high: U64 = 186
    until low >= high
        var mid = (low + high) // 2
        var at = mid * 4
        if cp < LOWERCASE_RUNS[at]
            high = mid
        elseif cp > LOWERCASE_RUNS[at + 1]
            low = mid + 1
        elseif (cp - LOWERCASE_RUNS[at]) % LOWERCASE_RUNS[at + 2] == 0
            return cp + LOWERCASE_RUNS[at + 3]
        else
            return cp
    return cp

### Whether a code point is an uppercase letter (Lu).
### :param cp: The code point.
### :returns: `true` when it is one.
secret routine unicode_is_uppercase(cp: S64) -> Bool
    var low: U64 = 0
    var high: U64 = 163
    until low >= high
        var mid = (low + high) // 2
        var at = mid * 3
        if cp < UPPERCASE_LETTER_RUNS[at]
            high = mid
        elseif cp > UPPERCASE_LETTER_RUNS[at + 1]
            low = mid + 1
        else
            return (cp - UPPERCASE_LETTER_RUNS[at]) % UPPERCASE_LETTER_RUNS[at + 2] == 0
    return false

### Whether a code point is a lowercase letter (Ll).
### :param cp: The code point.
### :returns: `true` when it is one.
secret routine unicode_is_lowercase(cp: S64) -> Bool
    var low: U64 = 0
    var high: U64 = 178
    until low >= high
        var mid = (low + high) // 2
        var at = mid * 3
        if cp < LOWERCASE_LETTER_RUNS[at]
            high = mid
        elseif cp > LOWERCASE_LETTER_RUNS[at + 1]
            low = mid + 1
        else
            return (cp - LOWERCASE_LETTER_RUNS[at]) % LOWERCASE_LETTER_RUNS[at + 2] == 0
    return false
