module System/Text

import BuilderQuery
### Represents an immutable byte sequence with value semantics.
###
### Layout:
###   data:  Hijacked[Byte]                 — the owner list's buffer, read directly
###   count: U64                            — number of bytes
###   owner: Guarded[List[Byte], ReadOnly]  — the list holding the bytes (null for an empty or literal sequence)
###
### `Bytes` is a record (value semantics from the user's view) over a shared, read-only list of bytes. Copying a
### `Bytes` shares the list (its `Guarded` owner counts one more holder) and copies the `data`/`count` cache, so a
### read never goes through the owner. The last copy to go ends the list. An empty sequence and a bytes literal have
### no owner: nothing is counted or freed.
record Bytes
relates BytesEmittable as Iter
obeys Copyable, Addable, Iterable[Byte], Comparable, Hashable
    ### Raw buffer of byte values.
    secret data: Hijacked[Byte]
    ### Number of bytes in the buffer.
    secret count: U64
    ### The list holding the bytes, shared read-only by every copy (null for an empty or literal sequence).
    secret owner: Guarded[List[Byte], ReadOnly]

# Iteration

### Represents the iterator used to traverse a `Bytes` value.
entity BytesEmittable
    ### Stores the source byte sequence.
    bytes: Bytes
    ### Stores the next byte index to yield.
    index: U64

### Represents a strict lazy UTF-8 view over a borrowed `Bytes` value.
### Iteration throws {MalformedUtf8Error} on the first ill-formed subsequence.
record BytesUtf8View
relates BytesUtf8Emittable as Iter
obeys Iterable[Char]
    ### Raw pointer to the underlying byte buffer. Caller guarantees lifetime.
    secret data: Hijacked[Byte]
    ### Number of bytes in the buffer.
    secret byte_count: U64

### Represents the iterator backing {BytesUtf8View}.
entity BytesUtf8Emittable
    ### Raw pointer to the underlying byte buffer. Caller guarantees lifetime.
    secret data: Hijacked[Byte]
    ### Number of bytes in the buffer.
    secret byte_count: U64
    ### Stores the index.
    index: U64

### Represents a lossy lazy UTF-8 view over a borrowed `Bytes` value.
### Iteration substitutes U+FFFD for any ill-formed subsequence and never fails.
record BytesUtf8LossyView
relates BytesUtf8LossyEmittable as Iter
obeys Iterable[Char]
    ### Raw pointer to the underlying byte buffer. Caller guarantees lifetime.
    secret data: Hijacked[Byte]
    ### Number of bytes in the buffer.
    secret byte_count: U64

### Represents the iterator backing {BytesUtf8LossyView}.
entity BytesUtf8LossyEmittable
    ### Raw pointer to the underlying byte buffer. Caller guarantees lifetime.
    secret data: Hijacked[Byte]
    ### Number of bytes in the buffer.
    secret byte_count: U64
    ### Stores the index.
    index: U64

### Copy (Copyable): a `Bytes` is immutable, so a copy shares the same bytes.
@readonly
@inline
routine Bytes.duplicate() -> Bytes
    return me

### Makes a `Bytes` over `count` bytes at `data`, a buffer the caller allocated and filled: a list over that buffer
### becomes the owner (one strong holder, not yet shared). `count` MUST be > 0.
### :param data: The bytes, a buffer of exactly `count` bytes the new value takes over.
### :param count: The number of bytes.
### :returns: The resulting `Bytes` value.
secret routine bytes_over(data: Hijacked[Byte], count: U64) -> Bytes
    danger
        var bytes = List[Byte](over: data, count: count)
        return Bytes(data: data, count: count, owner: Guarded[List[Byte], ReadOnly](from: steal bytes))

### Creates an empty byte sequence.
### :returns: The resulting `Bytes` value.
routine Bytes() -> Bytes
    return Bytes(data: hijacked_none[Byte](), count: 0, owner: guarded_none[List[Byte], ReadOnly]())

### Creates a byte sequence from a list of bytes. The list itself becomes the sequence's bytes, nothing is copied, so
### this is O(1): hand it over with `steal` (`Bytes(from_list: steal bytes)`).
### :param from_list: The bytes, taken over by the new value.
### :returns: The resulting `Bytes` value.
routine Bytes(from_list: List[Byte]) -> Bytes
    var n = from_list.count()
    if n == 0
        return Bytes()
    var data = from_list.data
    return Bytes(data: data, count: n, owner: Guarded[List[Byte], ReadOnly](from: steal from_list))

### Creates a one-byte sequence from `from_byte`.
### :param from_byte: The single byte to store.
### :returns: The resulting `Bytes` value.
routine Bytes(from_byte: Byte) -> Bytes
    danger
        var buf = Hijacked[Byte](rf_allocate_dynamic(size: Byte.data_size()))
        buf.poke(value: from_byte)
        return bytes_over(data: buf, count: 1)

### Creates a byte sequence by copying a null-terminated byte buffer.
### Copying stops at the first null byte.
### :param ptr: The source pointer to read from.
### :returns: The resulting `Bytes` value.
routine Bytes(ptr: Hijacked[Byte]) -> Bytes
    danger
        var len: U64 = 0
        loop
            if ptr.stride(count: len.to[S64]()).peek() == BYTE_NULL
                break
            len += 1
        if len == 0
            return Bytes()
        var buf = Hijacked[Byte](rf_allocate_dynamic(size: Byte.data_size() * len))
        rf_copy_bytes_at(dest: buf.address(), src: ptr.address(), size: Byte.data_size() * len)
        return bytes_over(data: buf, count: len)

### Creates a byte sequence by copying a null-terminated C string as raw bytes.
### No text decoding is performed.
### :param ptr: The source C string.
### :returns: The resulting `Bytes` value.
routine Bytes(ptr: CStrView) -> Bytes
    var len = C::rf_cstr_count(ptr)
    if len == 0
        return Bytes()
    danger
        var buf = Hijacked[Byte](rf_allocate_dynamic(size: Byte.data_size() * len))
        rf_copy_bytes_at(
            dest: buf.address(),
            src: ptr.ptr().address(),
            size: Byte.data_size() * len,
        )
        return bytes_over(data: buf, count: len)

### Creates a byte sequence by copying `count` bytes from an address.
### :param ptr: The source address.
### :param count: The number of bytes to copy.
### :returns: The resulting `Bytes` value.
routine Bytes(ptr: Addr, count: U64) -> Bytes
    if count == 0
        return Bytes()
    danger
        var buf = Hijacked[Byte](rf_allocate_dynamic(size: Byte.data_size() * count))
        rf_copy_bytes_at(dest: buf.address(), src: ptr, size: Byte.data_size() * count)
        return bytes_over(data: buf, count: count)

### Creates a byte sequence by copying `count` bytes from a hijacked pointer.
### :param ptr: The source pointer.
### :param count: The number of bytes to copy.
### :returns: The resulting `Bytes` value.
routine Bytes(ptr: Hijacked[Byte], count: U64) -> Bytes
    if count == 0
        return Bytes()
    danger
        var buf = Hijacked[Byte](rf_allocate_dynamic(size: Byte.data_size() * count))
        rf_copy_bytes_at(dest: buf.address(), src: ptr.address(), size: Byte.data_size() * count)
        return bytes_over(data: buf, count: count)

# Core operations

### Returns the number of stored bytes in this sequence.
### :returns: The resulting `U64` value.
@readonly
routine Bytes.count() -> U64
    return me.count

### Returns the number of occurrences of a byte.
### Matching is exact on raw byte values.
### :param byte: The byte to search for.
### :returns: The resulting `U64` value.
@readonly
routine Bytes.count_of(byte: Byte) -> U64
    var result: U64 = 0
    each b in me
        if b == byte
            result += 1
    return result

### Returns `true` when this byte sequence has no stored bytes.
### This is equivalent to checking whether `count()` is `0`.
### :returns: The resulting `Bool` value.
@readonly
routine Bytes.is_empty() -> Bool
    return me.count == 0

### Hands out the raw, NON-OWNING `Hijacked[Byte]` over this sequence's backing buffer — the
### zero-copy escape hatch for hot byte scanning. The returned handle borrows the buffer: it does
### NOT own or free it (the `Bytes` value remains the sole owner), and it is invalidated when the
### `Bytes` is destroyed or reallocated. `dangerous` because it exposes an unchecked pointer with a
### caller-guaranteed lifetime; callers must keep the source `Bytes` alive for as long as the handle
### (or any slice `stride`d from it) is used. Use for raw `stride`/`peek` walks that must skip the
### per-index bounds check of `getitem!`, and for building pointer-keyed slices into the buffer.
### :returns: A non-owning `Hijacked[Byte]` positioned at byte 0 of the backing buffer.
@readonly
dangerous routine Bytes.raw_buffer() -> Hijacked[Byte]
    return me.data

# Indexing

### Returns the byte at `index`.
### :param index: The zero-based position to use.
### :returns: The resulting `Byte` value.
@readonly
failable routine Bytes.getitem(index: U64) -> Byte
    if index >= me.count
        throw IndexOutOfBoundsError(index: index, count: me.count)
    danger
        return me.data.stride(count: index.to[S64]()).peek()

### Returns the sub-sequence spanning an index range — the slice form of indexing (`bytes[a til b]`).
### A half-open `a til b` yields `[a, b)`; an inclusive `a to b` yields `[a, b]`; a range that
### counts down (`by -1`) reverses the segment. Positions at or past `count` are skipped, so `bytes[a til ^0]` slices cleanly
### to the end. `Bytes` is immutable, so the result is a freshly allocated copy.
### :param range: The index range to extract.
### :returns: The resulting `Bytes` value.
@readonly
routine Bytes.getitem(range: Range[U64]) -> Bytes
    var result = List[Byte]()
    danger
        each i in range
            if i < me.count
                result.add_last(me.data.stride(count: i.to[S64]()).peek())
    return Bytes(from_list: steal result)

# String operations

### Returns a new value with `other` appended.
### Both input byte sequences remain unchanged.
### :param other: The byte sequence to append.
### :returns: The resulting `Bytes` value.
@readonly
routine Bytes.concat(other: Bytes) -> Bytes
    var n = me.count + other.count
    if n == 0
        return Bytes()
    danger
        var buf = Hijacked[Byte](rf_allocate_dynamic(size: Byte.data_size() * n))
        if me.count > 0
            rf_copy_bytes_at(
                dest: buf.address(),
                src: me.data.address(),
                size: Byte.data_size() * me.count,
            )
        if other.count > 0
            var dest = buf.stride(count: me.count.to[S64]())
            rf_copy_bytes_at(
                dest: dest.address(),
                src: other.data.address(),
                size: Byte.data_size() * other.count,
            )
        return bytes_over(data: buf, count: n)

### Returns the sum of this value and the other value.
### This is the operator form of `concat`.
### :param other: The byte sequence to append.
### :returns: The resulting `Bytes` value.
@readonly
routine Bytes.add(other: Bytes) -> Bytes
    return me.concat(other)

### Returns whether both values are equal.
### Equality requires the same length and the same byte at each position.
### :param other: The other byte sequence to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Bytes.eq(other: Bytes) -> Bool
    if me.count != other.count
        return false
    var i: U64 = 0
    each i in 0 til me.count
        if me[i] != other[i]
            return false
    return true

### Compares this value with the other value.
### Comparison is lexicographic over raw byte values; a shorter sequence that is a
### prefix of a longer one sorts first. Lets `Bytes` be sorted and used as a map key.
### :param you: The other byte sequence to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine Bytes.compare(you: Bytes) -> ComparisonSign
    var min_len = me.count
    if you.count < min_len
        min_len = you.count
    each i in 0 til min_len
        if me[i] < you[i]
            return ComparisonSign.ME_SMALL
        if me[i] > you[i]
            return ComparisonSign.ME_LARGE
    if me.count < you.count
        return ComparisonSign.ME_SMALL
    if me.count > you.count
        return ComparisonSign.ME_LARGE
    return ComparisonSign.SAME

### Returns a SipHash-2-4 keyed hash of this value.
### Each byte is folded into the keyed hash so equal sequences under the same key
### produce the same digest — the counterpart to `Text.hash`.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` keyed hash.
@readonly
routine Bytes.hash(k0: U64, k1: U64) -> U64
    var h = __hash_leaf(v: me.count)
    each i in 0 til me.count
        h = __hash_round(acc: h, h: me[i].hash(k0: k0, k1: k1))
    return __hash_finalize(h)

# Search

### Returns `true` when this byte sequence contains `byte`.
### :param byte: The byte to search for.
### :returns: The resulting `Bool` value.
@readonly
routine Bytes.has(byte: Byte) -> Bool
    each i in 0 til me.count
        if me[i] == byte
            return true
    return false

### Returns whether `byte` is not in this value: the opposite of `has`.
### :param byte: The value to look for.
### :returns: `true` when `byte` is absent.
@readonly
routine Bytes.lacks(byte: Byte) -> Bool
    return not me.has(byte)

### Returns `true` when this byte sequence contains `other` as a contiguous sub-sequence.
### An empty `other` is always considered contained.
### :param other: The sub-sequence to search for.
### :returns: The resulting `Bool` value.
@readonly
routine Bytes.has(other: Bytes) -> Bool
    if other.is_empty()
        return true
    var oc = other.count
    if oc > me.count
        return false
    var limit = me.count - oc + 1
    each i in 0 til limit
        var found = true
        each j in 0 til oc
            if me[i + j] != other[j]
                found = false
                break
        if found
            return true
    return false

### Returns whether `other` is not in this value: the opposite of `has`.
### :param other: The value to look for.
### :returns: `true` when `other` is absent.
@readonly
routine Bytes.lacks(other: Bytes) -> Bool
    return not me.has(other)

### Returns `true` when this byte sequence begins with `prefix`.
### :param prefix: The prefix to test.
### :returns: The resulting `Bool` value.
@readonly
routine Bytes.starts_with(prefix: Bytes) -> Bool
    if prefix.count > me.count
        return false
    each i in 0 til prefix.count
        if me[i] != prefix[i]
            return false
    return true

### Returns `true` when this byte sequence ends with `suffix`.
### :param suffix: The suffix to test.
### :returns: The resulting `Bool` value.
@readonly
routine Bytes.ends_with(suffix: Bytes) -> Bool
    if suffix.count > me.count
        return false
    var offset = me.count - suffix.count
    each i in 0 til suffix.count
        if me[offset + i] != suffix[i]
            return false
    return true

### Returns the position of the first occurrence of `byte`.
### :param byte: The byte to search for.
### :returns: The resulting `U64` value.
### :throws: {AbsentValueError} Thrown when the requested value is unavailable.
@readonly
failable routine Bytes.find(byte: Byte) -> U64
    each i in 0 til me.count
        if me[i] == byte
            return i
    throw AbsentValueError()

### Returns the position of the first occurrence of `other` as a sub-sequence.
### An empty `other` matches at position `0`.
### :param other: The sub-sequence to search for.
### :returns: The resulting `U64` value.
### :throws: {AbsentValueError} Thrown when the requested value is unavailable.
@readonly
failable routine Bytes.find(other: Bytes) -> U64
    if other.is_empty()
        return 0
    if other.count > me.count
        throw AbsentValueError()
    var limit = me.count - other.count + 1
    each i in 0 til limit
        var found = true
        each j in 0 til other.count
            if me[i + j] != other[j]
                found = false
                break
        if found
            return i
    throw AbsentValueError()

# Split

### Splits this value into parts.
### Separator bytes are not included in the returned segments.
### :param separator: The separator to use.
### :returns: The resulting `List[Bytes]` value.
@readonly
routine Bytes.split(separator: Byte) -> List[Bytes]
    var parts = List[Bytes]()
    var current = List[Byte]()
    each i in 0 til me.count
        if me[i] == separator
            parts.add_last(Bytes(from_list: steal current))
            current = List[Byte]()
        else
            current.add_last(me[i])
    parts.add_last(Bytes(from_list: steal current))
    return steal parts

### Splits this value on a multi-byte separator sub-sequence.
### Separator bytes are not included in the returned segments. An empty separator
### returns the whole sequence as a single segment.
### :param separator: The separator sub-sequence to split on.
### :returns: The resulting `List[Bytes]` value.
@readonly
routine Bytes.split(separator: Bytes) -> List[Bytes]
    var parts = List[Bytes]()
    if separator.is_empty()
        parts.add_last(me)
        return steal parts
    var sc = separator.count
    var current = List[Byte]()
    var i: U64 = 0
    until i >= me.count
        var matched = false
        if i + sc <= me.count
            matched = true
            each j in 0 til sc
                if me[i + j] != separator[j]
                    matched = false
                    break
        if matched
            parts.add_last(Bytes(from_list: steal current))
            current = List[Byte]()
            i += sc
        else
            current.add_last(me[i])
            i += 1
    parts.add_last(Bytes(from_list: steal current))
    return steal parts

# Transform

### Returns a copy with the value order reversed.
### Bytes are reversed by position with no interpretation as text.
### :returns: The resulting `Bytes` value.
@readonly
routine Bytes.reverse() -> Bytes
    var result = List[Byte]()
    var i = me.count
    loop
        if i == 0
            break
        i -= 1
        result.add_last(me[i])
    return Bytes(from_list: steal result)

### Returns a repeated copy of this value.
### This is the binary-sequence equivalent of text repetition.
### :param times: The number of repetitions to produce.
### :returns: The resulting `Bytes` value.
@readonly
routine Bytes.repeat(times: U64) -> Bytes
    if times == 0 or me.count == 0
        return Bytes()
    var n = me.count * times
    danger
        var buf = Hijacked[Byte](rf_allocate_dynamic(size: Byte.data_size() * n))
        var t: U64 = 0
        loop
            if t >= times
                break
            var dest = buf.stride(count: (t * me.count).to[S64]())
            rf_copy_bytes_at(
                dest: dest.address(),
                src: me.data.address(),
                size: Byte.data_size() * me.count,
            )
            t += 1
        return bytes_over(data: buf, count: n)

# Hex encoding

### Maps a 0..15 nibble to its lowercase hex character.
routine __nibble_to_hex_char(nibble: U32) -> Char
    if nibble < 10
        return Char(0x30 + nibble)
    return Char(0x61 + nibble - 10)

### Returns this byte as exactly two lowercase hexadecimal digits, high nibble first (`0x0F` is `0f`), the
### per-byte form of `Bytes.to_hex`.
### :returns: The two-digit hexadecimal `Text`.
@readonly
routine Byte.to_hex() -> Text
    var v = me.codepoint()
    var out = List[Char]()
    out.add_last(__nibble_to_hex_char(nibble: (v >> 4) & 0xF))
    out.add_last(__nibble_to_hex_char(nibble: v & 0xF))
    return Text(from_list: steal out)

### Returns the lowercase hexadecimal encoding of this sequence.
### Each byte becomes exactly two hex digits (high nibble first), so the result is
### always `2 * count()` characters. The inverse is `Bytes.from_hex!`.
### :returns: The resulting `Text` value.
@readonly
routine Bytes.to_hex() -> Text
    var out = List[Char]()
    each i in 0 til me.count
        var v = me[i].codepoint()
        out.add_last(__nibble_to_hex_char(nibble: (v >> 4) & 0xF))
        out.add_last(__nibble_to_hex_char(nibble: v & 0xF))
    return Text(from_list: steal out)

### Decodes a hexadecimal string into bytes.
### Accepts upper- or lowercase digits. The inverse of `to_hex`.
### :param hex: The hex string to decode; its length must be even.
### :returns: The resulting `Bytes` value.
### :throws: {InvalidValueError} on an odd length or a non-hex character.
failable routine Bytes.from_hex(hex: Text) -> Bytes
    var n = hex.count()
    if n % 2 != 0
        throw InvalidValueError(input: hex, target: "Bytes.from_hex")
    if n == 0
        return Bytes()
    var out = List[Byte]()
    var i: U64 = 0
    until i >= n
        var hi_c = hex[i]
        var lo_c = hex[i + 1]
        if hi_c.codepoint() > 0x7F or lo_c.codepoint() > 0x7F
            throw InvalidValueError(input: hex, target: "Bytes.from_hex")
        var hi = hi_c.codepoint().to[U8]().to[Byte]().hex_value()
        var lo = lo_c.codepoint().to[U8]().to[Byte]().hex_value()
        out.add_last((hi * 16 + lo).to[Byte]())
        i += 2
    return Bytes(from_list: steal out)

# Conversion to modifiable list

### Creates a mutable byte list by copying the contents of `Bytes`.
### :param source: The byte sequence to convert.
### :returns: The resulting `List[Byte]` value.
routine List[Byte](source: Bytes) -> List[Byte]
    var result = List[Byte](source.count)
    var i: U64 = 0
    loop
        if i >= source.count
            break
        danger
            result.add_last(source.data.stride(count: i.to[S64]()).peek())
        i += 1
    return steal result

### Returns an iterator over this byte sequence.
### The iterator starts at byte index `0`.
### :returns: The resulting `BytesEmittable` value.
@readonly
routine Bytes.iter() -> BytesEmittable
    return BytesEmittable(bytes: me, index: 0)

### Returns the next byte from this iterator.
### Each successful call yields one byte and advances the internal index.
### :returns: The resulting `Byte` value.
### :throws: {AbsentValueError} Thrown when the requested value is unavailable.
failable routine BytesEmittable.emit() -> Byte
    if me.index >= me.bytes.count
        throw AbsentValueError()
    var value = me.bytes[me.index]
    me.index = me.index + 1
    return value

# ============================================================================
# Display — hex format \xHH for each byte
# ============================================================================

### Returns the display form of this byte sequence.
### Each byte is rendered using its escaped `\\xHH` representation.
### :returns: The resulting `Text` value.
@readonly
@override
routine Bytes.represent() -> Text
    var result = List[Char]()
    var i: U64 = 0
    loop
        if i >= me.count
            break
        var byte_text = me[i].represent()
        var j: U64 = 0
        loop
            if j >= byte_text.count()
                break
            result.add_last(byte_text[j])
            j += 1
        i += 1
    return Text(from_list: steal result)

### Returns the diagnostic form of this byte sequence.
### The diagnostic form includes both the byte count and the escaped payload.
### :returns: The resulting `Text` value.
@readonly
@override
routine Bytes.diagnose() -> Text
    return "Bytes(count: " + me.count.represent() + ", " + me.represent() + ")"

# ============================================================================
# Encoding Conversions
# ============================================================================

### Encodes this text value as UTF-8 bytes.
### :returns: The resulting `Bytes` value.
@readonly
routine Text.encode_as_utf8() -> Bytes
    var result = List[Byte]()
    var len = me.count()
    each i in 0 til len
        var current_letter = me[i]
        var codepoint = current_letter.codepoint()
        when
            codepoint <= 0x7F =>
                result.add_last(Byte(codepoint.to[U8]()))
            codepoint <= 0x7FF =>
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0xC0 | (codepoint >> 6))))
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0x80 | (codepoint & 0x3F))))
            codepoint <= 0xFFFF =>
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0xE0 | (codepoint >> 12))))
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0x80 | ((codepoint >> 6) & 0x3F))))
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0x80 | (codepoint & 0x3F))))
            else =>
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0xF0 | (codepoint >> 18))))
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0x80 | ((codepoint >> 12) & 0x3F))))
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0x80 | ((codepoint >> 6) & 0x3F))))
                result.add_last(Byte(LLVM::int_truncate[U32, U8](0x80 | (codepoint & 0x3F))))
    return Bytes(from_list: steal result)

### Decodes this byte sequence as UTF-8, replacing malformed subsequences with
### the Unicode replacement character.
### :returns: The resulting `Text` value.
@readonly
routine Bytes.decode_as_utf8_lossy() -> Text
    var result = List[Char]()
    var len = me.count
    var i: U64 = 0
    loop
        if i >= len
            break
        var b0 = me[i].codepoint()
        var codepoint: U32 = 0
        when
            (b0 & 0x80) == 0 =>
                codepoint = b0
                i += 1
            (b0 & 0xE0) == 0xC0 =>
                if i + 1 < len
                    var b1 = me[i + 1].codepoint()
                    if (b1 & 0xC0) == 0x80 and b0 >= 0xC2
                        codepoint = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
                        i += 2
                    else
                        codepoint = 0xFFFD
                        i += 1
                else
                    codepoint = 0xFFFD
                    i += 1
            (b0 & 0xF0) == 0xE0 =>
                if i + 2 < len
                    var b1 = me[i + 1].codepoint()
                    var b2 = me[i + 2].codepoint()
                    var is_valid = (b1 & 0xC0) == 0x80 and (b2 & 0xC0) == 0x80
                    if is_valid
                        var candidate = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
                        if candidate >= 0x800
                            and (candidate < 0xD800 or candidate > 0xDFFF)
                            codepoint = candidate
                            i += 3
                        else
                            codepoint = 0xFFFD
                            i += 1
                    else
                        codepoint = 0xFFFD
                        i += 1
                else
                    codepoint = 0xFFFD
                    i += 1
            (b0 & 0xF8) == 0xF0 =>
                if i + 3 < len
                    var b1 = me[i + 1].codepoint()
                    var b2 = me[i + 2].codepoint()
                    var b3 = me[i + 3].codepoint()
                    var is_valid = (b1 & 0xC0) == 0x80
                        and (b2 & 0xC0) == 0x80
                        and (b3 & 0xC0) == 0x80
                    if is_valid
                        var candidate = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                        if 0x10000 <= candidate <= 0x10FFFF
                            codepoint = candidate
                            i += 4
                        else
                            codepoint = 0xFFFD
                            i += 1
                    else
                        codepoint = 0xFFFD
                        i += 1
                else
                    codepoint = 0xFFFD
                    i += 1
            else =>
                codepoint = 0xFFFD
                i += 1
        result.add_last(Char(codepoint))
    return Text(from_list: steal result)

### Decodes this byte sequence as UTF-8.
### Malformed input causes a `MalformedUtf8Error` instead of lossy replacement.
### :returns: The resulting `Text` value.
### :throws: May throw {MalformedUtf8Error}.
@readonly
failable routine Bytes.decode_as_utf8() -> Text
    var result = List[Char]()
    var len = me.count
    var i: U64 = 0
    loop
        if i >= len
            break
        var b0 = me[i].codepoint()
        var codepoint: U32 = 0
        when
            (b0 & 0x80) == 0 =>
                codepoint = b0
                i += 1
            (b0 & 0xE0) == 0xC0 =>
                if i + 1 >= len
                    throw MalformedUtf8Error(index: i, reason: "truncated 2-byte sequence")
                var b1 = me[i + 1].codepoint()
                if (b1 & 0xC0) != 0x80
                    throw MalformedUtf8Error(index: i, reason: "invalid continuation byte")
                if b0 < 0xC2
                    throw MalformedUtf8Error(index: i, reason: "overlong 2-byte sequence")
                codepoint = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
                i += 2
            (b0 & 0xF0) == 0xE0 =>
                if i + 2 >= len
                    throw MalformedUtf8Error(index: i, reason: "truncated 3-byte sequence")
                var b1 = me[i + 1].codepoint()
                var b2 = me[i + 2].codepoint()
                if (b1 & 0xC0) != 0x80 or (b2 & 0xC0) != 0x80
                    throw MalformedUtf8Error(index: i, reason: "invalid continuation byte")
                codepoint = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
                if codepoint < 0x800
                    throw MalformedUtf8Error(index: i, reason: "overlong 3-byte sequence")
                if 0xD800 <= codepoint <= 0xDFFF
                    throw MalformedUtf8Error(
                        index: i,
                        reason: "surrogate codepoint is not valid UTF-8",
                    )
                i += 3
            (b0 & 0xF8) == 0xF0 =>
                if i + 3 >= len
                    throw MalformedUtf8Error(index: i, reason: "truncated 4-byte sequence")
                var b1 = me[i + 1].codepoint()
                var b2 = me[i + 2].codepoint()
                var b3 = me[i + 3].codepoint()
                if (b1 & 0xC0) != 0x80
                    or (b2 & 0xC0) != 0x80
                    or (b3 & 0xC0) != 0x80
                    throw MalformedUtf8Error(index: i, reason: "invalid continuation byte")
                codepoint = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                if codepoint < 0x10000
                    throw MalformedUtf8Error(index: i, reason: "overlong 4-byte sequence")
                if codepoint > 0x10FFFF
                    throw MalformedUtf8Error(index: i, reason: "codepoint exceeds Unicode range")
                i += 4
            else =>
                throw MalformedUtf8Error(index: i, reason: "invalid leading byte")
        result.add_last(Char(codepoint))
    return Text(from_list: steal result)

### Returns a strict lazy UTF-8 view over this byte sequence.
### The bytes are validated eagerly so subsequent iteration is guaranteed to
### succeed; iteration throws {MalformedUtf8Error} only if the underlying bytes
### are mutated after construction.
### :returns: The resulting `BytesUtf8View` value.
### :throws: {MalformedUtf8Error} if these bytes are not well-formed UTF-8.
@readonly
failable routine Bytes.interpret_as_utf8() -> BytesUtf8View
    var validated = me.decode_as_utf8()
    return BytesUtf8View(data: me.data, byte_count: me.count)

### Returns a lossy lazy UTF-8 view over this byte sequence.
### Malformed subsequences are surfaced as the Unicode replacement character
### (U+FFFD) during iteration.
### :returns: The resulting `BytesUtf8LossyView` value.
@readonly
routine Bytes.interpret_as_utf8_lossy() -> BytesUtf8LossyView
    return BytesUtf8LossyView(data: me.data, byte_count: me.count)

### Returns an iterator over this strict UTF-8 view.
### :returns: The resulting `BytesUtf8Emittable` value.
@readonly
routine BytesUtf8View.iter() -> BytesUtf8Emittable
    return BytesUtf8Emittable(data: me.data, byte_count: me.byte_count, index: 0)

### Returns an iterator over this lossy UTF-8 view.
### :returns: The resulting `BytesUtf8LossyEmittable` value.
@readonly
routine BytesUtf8LossyView.iter() -> BytesUtf8LossyEmittable
    return BytesUtf8LossyEmittable(data: me.data, byte_count: me.byte_count, index: 0)

### Returns the next decoded character from this strict UTF-8 iterator.
### :returns: The resulting `Char` value.
### :throws: {AbsentValueError} Thrown when iteration is exhausted.
### :throws: {MalformedUtf8Error} on the first ill-formed subsequence.
failable routine BytesUtf8Emittable.emit() -> Char
    danger
        if me.index >= me.byte_count
            throw AbsentValueError()

        var b0 = me.data
            .stride(count: me.index.to[S64]())
            .peek()
            .codepoint()
        var codepoint: U32 = 0

        when
            (b0 & 0x80) == 0 =>
                codepoint = b0
                me.index += 1
            (b0 & 0xE0) == 0xC0 =>
                if me.index + 1 >= me.byte_count
                    throw MalformedUtf8Error(index: me.index, reason: "truncated 2-byte sequence")
                var b1 = me.data
                    .stride(count: (me.index + 1).to[S64]())
                    .peek()
                    .codepoint()
                if (b1 & 0xC0) != 0x80 or b0 < 0xC2
                    throw MalformedUtf8Error(index: me.index, reason: "invalid 2-byte sequence")
                codepoint = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
                me.index += 2
            (b0 & 0xF0) == 0xE0 =>
                if me.index + 2 >= me.byte_count
                    throw MalformedUtf8Error(index: me.index, reason: "truncated 3-byte sequence")
                var b1 = me.data
                    .stride(count: (me.index + 1).to[S64]())
                    .peek()
                    .codepoint()
                var b2 = me.data
                    .stride(count: (me.index + 2).to[S64]())
                    .peek()
                    .codepoint()
                if (b1 & 0xC0) != 0x80 or (b2 & 0xC0) != 0x80
                    throw MalformedUtf8Error(index: me.index, reason: "invalid 3-byte sequence")
                var candidate = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
                if candidate < 0x800 or 0xD800 <= candidate <= 0xDFFF
                    throw MalformedUtf8Error(
                        index: me.index,
                        reason: "overlong or surrogate codepoint",
                    )
                codepoint = candidate
                me.index += 3
            (b0 & 0xF8) == 0xF0 =>
                if me.index + 3 >= me.byte_count
                    throw MalformedUtf8Error(index: me.index, reason: "truncated 4-byte sequence")
                var b1 = me.data
                    .stride(count: (me.index + 1).to[S64]())
                    .peek()
                    .codepoint()
                var b2 = me.data
                    .stride(count: (me.index + 2).to[S64]())
                    .peek()
                    .codepoint()
                var b3 = me.data
                    .stride(count: (me.index + 3).to[S64]())
                    .peek()
                    .codepoint()
                if (b1 & 0xC0) != 0x80
                    or (b2 & 0xC0) != 0x80
                    or (b3 & 0xC0) != 0x80
                    throw MalformedUtf8Error(index: me.index, reason: "invalid 4-byte sequence")
                var candidate = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                if candidate < 0x10000 or candidate > 0x10FFFF
                    throw MalformedUtf8Error(index: me.index, reason: "codepoint out of range")
                codepoint = candidate
                me.index += 4
            else =>
                throw MalformedUtf8Error(index: me.index, reason: "invalid leading byte")

        return Char(codepoint)

### Returns the next decoded character from this lossy UTF-8 iterator.
### Malformed subsequences are surfaced as the replacement character (U+FFFD).
### :returns: The resulting `Char` value.
### :throws: {AbsentValueError} Thrown when iteration is exhausted.
failable routine BytesUtf8LossyEmittable.emit() -> Char
    danger
        if me.index >= me.byte_count
            throw AbsentValueError()

        var b0 = me.data
            .stride(count: me.index.to[S64]())
            .peek()
            .codepoint()
        var codepoint: U32 = 0

        when
            (b0 & 0x80) == 0 =>
                codepoint = b0
                me.index += 1
            (b0 & 0xE0) == 0xC0 =>
                if me.index + 1 < me.byte_count
                    var b1 = me.data
                        .stride(count: (me.index + 1).to[S64]())
                        .peek()
                        .codepoint()
                    if (b1 & 0xC0) == 0x80 and b0 >= 0xC2
                        codepoint = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
                        me.index += 2
                    else
                        codepoint = 0xFFFD
                        me.index += 1
                else
                    codepoint = 0xFFFD
                    me.index += 1
            (b0 & 0xF0) == 0xE0 =>
                if me.index + 2 < me.byte_count
                    var b1 = me.data
                        .stride(count: (me.index + 1).to[S64]())
                        .peek()
                        .codepoint()
                    var b2 = me.data
                        .stride(count: (me.index + 2).to[S64]())
                        .peek()
                        .codepoint()
                    var is_valid = (b1 & 0xC0) == 0x80 and (b2 & 0xC0) == 0x80
                    if is_valid
                        var candidate = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
                        if candidate >= 0x800
                            and (candidate < 0xD800 or candidate > 0xDFFF)
                            codepoint = candidate
                            me.index += 3
                        else
                            codepoint = 0xFFFD
                            me.index += 1
                    else
                        codepoint = 0xFFFD
                        me.index += 1
                else
                    codepoint = 0xFFFD
                    me.index += 1
            (b0 & 0xF8) == 0xF0 =>
                if me.index + 3 < me.byte_count
                    var b1 = me.data
                        .stride(count: (me.index + 1).to[S64]())
                        .peek()
                        .codepoint()
                    var b2 = me.data
                        .stride(count: (me.index + 2).to[S64]())
                        .peek()
                        .codepoint()
                    var b3 = me.data
                        .stride(count: (me.index + 3).to[S64]())
                        .peek()
                        .codepoint()
                    var is_valid = (b1 & 0xC0) == 0x80
                        and (b2 & 0xC0) == 0x80
                        and (b3 & 0xC0) == 0x80
                    if is_valid
                        var candidate = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                        if 0x10000 <= candidate <= 0x10FFFF
                            codepoint = candidate
                            me.index += 4
                        else
                            codepoint = 0xFFFD
                            me.index += 1
                    else
                        codepoint = 0xFFFD
                        me.index += 1
                else
                    codepoint = 0xFFFD
                    me.index += 1
            else =>
                codepoint = 0xFFFD
                me.index += 1

        return Char(codepoint)

# ============================================================================
# UTF-16 Conversion (for Windows interop)
# ============================================================================

### Encodes this text value as UTF-16 code units.
### :returns: The resulting `List[U16]` value.
@readonly
routine Text.encode_as_utf16() -> List[U16]
    var result = List[U16]()
    var len = me.count()
    var i: U64 = 0
    loop
        if i >= len
            break
        var codepoint = me[i].codepoint()
        if codepoint <= 0xFFFF
            result.add_last(codepoint.to[U16]())
        else
            var cp = codepoint - 0x10000
            result.add_last(((cp >> 10) + 0xD800).to[U16]())
            result.add_last(((cp & 0x3FF) + 0xDC00).to[U16]())
        i += 1
    return steal result

### Decodes a list of UTF-16 code units into `Text`.
### Invalid surrogate structure is replaced with the Unicode replacement
### character.
### :returns: The resulting `Text` value.
routine List[U16].decode_as_utf16() -> Text
    var result = List[Char]()
    var len = me.count()
    var i: U64 = 0
    loop
        if i >= len
            break
        var w1 = me[i].to[U32]()
        if w1 < 0xD800 or w1 > 0xDFFF
            result.add_last(Char(w1))
            i += 1
        elseif 0xD800 <= w1 <= 0xDBFF and i + 1 < len
            var w2 = me[i + 1].to[U32]()
            if 0xDC00 <= w2 <= 0xDFFF
                var codepoint = (w1 - 0xD800 << 10) + (w2 - 0xDC00) + 0x10000
                result.add_last(Char(codepoint))
                i += 2
            else
                result.add_last('\u00FFFD')
                i += 1
        else
            result.add_last('\u00FFFD')
            i += 1
    return Text(from_list: steal result)

# ============================================================================
# Hashing for BytesUtf8View / BytesUtf8Emittable
# ============================================================================

### Returns a SipHash-2-4 keyed hash of the underlying byte buffer's address.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine BytesUtf8View.hash(k0: U64, k1: U64) -> U64
    danger
        return __secure_hash_u64(v: me.data.address().to[U64](), k0: k0, k1: k1)

### Returns a SipHash-2-4 keyed hash of this iterator.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine BytesUtf8Emittable.hash(k0: U64, k1: U64) -> U64
    danger
        var acc = __hash_round(
            acc: 0,
            h: __secure_hash_u64(v: me.data.address().to[U64](), k0: k0, k1: k1),
        )
        acc = __hash_round(acc: acc, h: me.index.hash(k0: k0, k1: k1))
        return __hash_finalize(h: acc)
