module System/Memory

import BuilderQuery
### Biased-reference-counted handle — the auto-promoting hybrid of {Retained[T]} and {Guarded[T, P]}.
### Thin pointer to {RoamManager[T]}. Backs Suflae's `entity` (the monitor-flavored actor): behaves
### like {Retained[T]} (non-atomic, unlocked, fast) while it stays on one thread, and — the moment it
### escapes across a concurrency boundary — promotes itself to atomic reference counting plus a
### reentrant, task-keyed exclusive lock that serializes all access (the actor "one at a time"
### guarantee). Aliasing is free (`.roam()`), so `b = a` maps here, NOT to a bare single-owner entity.
###
### **Access is coerced through `control`/`access`, with the lock applied TRANSPARENTLY.** `Roamed`
### `obeys Modifying[T]`: a deref (method dispatch on a `Roamed` receiver, or passing one to a
### `Modifying[T]`/`Viewing[T]` parameter) coerces to the inner entity via `control()`/`access()`.
### That coercion does NOT bypass serialization — the builder's lock-bracket lowering wraps the
### enclosing access scope in `lock_enter`/`lock_exit` (no-op in LOCAL mode, a reentrant task-keyed
### acquire once ESCAPED), so Suflae code never sees the lock while access stays serialized. Holding a
### handle is a strong reference, so the inner is never dangling. (The scope is per-access on the
### explicit RazorForge side, per-access-scope on the Suflae side, chosen by the lock-bracket pass.)
###
### **Insertion is builder-driven in Suflae.** `Roamed` IS registered as an RC wrapper
### (`RuntimeContract.RcWrapperBaseNames` / `RcCopyVerb`); the aliasing `roam()`, spawn-boundary
### `promote()`, and field-access `lock_enter()`/`lock_exit()` are auto-inserted — `roam` by
### `SuflaeEntityLoweringPass` on entity bindings, `promote`/`lock_enter`/`lock_exit` by codegen
### (Stage 2b/2c). Reachability seeds these via `ImplicitCallContract` (they have no surface AST call).
### In pure RazorForge the same handles are driven explicitly (see `roamed_cycle_api.rf`: `.roam()` /
### `.raw_inner()` by hand). Display is TRANSPARENT: `Roamed` declares no `represent`/`diagnose` —
### codegen's `RoamedTransparency` re-resolves `f"{roamed}"` to the inner value's.
### The cycle collector (`System/Memory/CycleCollector.rf`) is a COMPLETE Bacon-Rajan trial-deletion
### recycler; its trace hooks are auto-synthesized, but `cyclic_collect` is still invoked explicitly
### (no auto-scheduling yet), so cycles are reclaimed only where the collector is actually run.
### :typeparam T: The exclusively owned entity type.
@llvm("ptr")
record Roamed[T]
obeys Copyable when T obeys Copyable
needs EntityType T
    nothing

# ============================================================================
# Construction
# ============================================================================

### `Roamed[T](from: n)`: ownership of the entity moves into the RC system.
### This is what an SF `entity` slot lowers to (SuflaeEntityLoweringPass builds this constructor call).
routine Roamed[T](from: T) -> Roamed[T]
needs EntityType T
    danger
        var ctrl = RoamManager[T](data: from.hijack()).hijack()
        return Roamed[T](ctrl)

### Reinterprets a raw {RoamManager[T]} address as a `Roamed[T]` handle WITHOUT retaining — a
### low-level plumbing / test hatch (Stage-1 cyclic-graph construction). The caller is responsible for
### the reference count: the returned handle does not add a strong ref.
### :param addr: The controller address (0 for the hollow handle).
### :returns: The `Roamed[T]` viewing that controller.
dangerous routine roamed_from_addr[T](addr: Addr) -> Roamed[T]
needs EntityType T
    return Roamed[T](Hijacked[RoamManager[T]](from: addr))

### Returns a new alias to the same object (biased retain), or the hollow handle unchanged. This is
### what `b = a` lowers to.
### :returns: A new handle sharing the same underlying entity.
@readonly
@override
secret routine Roamed[T].share() -> Roamed[T]
    danger
        if me.controller_address().is_not_hollow()
            var ctrl = Hijacked[RoamManager[T]](me).as_entity()
            ctrl.hold()
    return me

# No `duplicate` here: an entity that obeys Copyable declares its own, and a Suflae entity's routines already
# take the Roamed handle as `me` and return a Roamed handle, so `handle.duplicate()` resolves straight to the
# entity's. `share` (and `b = a`) is one more handle to the same entity.

# ============================================================================
# Escape + access lock. In Stage 2 the builder inserts these automatically (promote at the
# concurrency-boundary site; lock_enter/lock_exit around member-routine entry/return). Manual here.
# ============================================================================

### Escapes this object to ESCAPED mode (atomic refcount + armed lock). Idempotent.
dangerous routine Roamed[T].promote()
    var ctrl = Hijacked[RoamManager[T]](me).as_entity()
    ctrl.promote()
    return

### Whether this object has escaped.
### :returns: `true` if ESCAPED.
routine Roamed[T].is_escaped() -> Bool
    danger
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        return ctrl.is_escaped()

### Crashes when an `each` loop over this entity, or a call on one of its elements, is still running. Suflae's
### builder calls this before every call through the handle that can add, remove or move elements (a
### `@reshaping` routine), since the loop or the call could no longer trust where the elements are. A change
### hidden behind other calls is caught too: it reaches the entity through a handle as well.
@readonly
failable routine Roamed[T].require_shape_free()
    danger
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        if ctrl.shape_users != 0
            throw ReshapingWhileInUseError(container: T.type_name())
    return

### The held entity for a call that can add, remove or move its elements (a `@reshaping` routine): crashes like
### `require_shape_free` while an `each` loop over the entity, or a call on one of its elements, is still running.
### Suflae's builder puts it in place of `control()` on the receiver of such a call wherever the receiver is not a
### plain name (an element `rows[0]`, a call result), and in expressions that hold no statement of their own.
### :returns: The inner entity as `T`.
### :throws: {ReshapingWhileInUseError} while a use of the entity's shape is open.
failable routine Roamed[T].control_to_reshape() -> T
    danger
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        if ctrl.shape_users != 0
            throw ReshapingWhileInUseError(container: T.type_name())
        return ctrl.data_ptr().as_entity()

### Takes the entity out of this handle, which ends: the handle's controller is freed and the bare entity comes
### back, for a new handle to own. Suflae's builder calls this where a creator returns an entity that is already
### behind a handle, since the creator's caller makes the handle itself.
### :returns: The entity.
### :throws: {SharedEntityHandOffError} when another handle or a weak observer still reaches the entity.
failable dangerous routine Roamed[T].release_inner() -> T
    var ctrl = Hijacked[RoamManager[T]](me).as_entity()
    var data = ctrl.release_inner()
    if data.is_hollow()
        throw SharedEntityHandOffError(creating: T.type_name())
    return Hijacked[T](from: data).as_entity()

### Marks one more `each` loop or element call as using this entity's element positions. Only the builder
### calls this, paired with `end_shape_use` when that use ends.
dangerous routine Roamed[T].begin_shape_use()
    var ctrl = Hijacked[RoamManager[T]](me).as_entity()
    ctrl.shape_users = ctrl.shape_users +% 1
    return

### Ends one use started by `begin_shape_use`.
dangerous routine Roamed[T].end_shape_use()
    var ctrl = Hijacked[RoamManager[T]](me).as_entity()
    ctrl.shape_users = ctrl.shape_users -% 1
    return

### Enters the access lock: a no-op in LOCAL mode, a reentrant task-keyed acquire in ESCAPED mode.
@inline
dangerous routine Roamed[T].lock_enter()
    var ctrl = Hijacked[RoamManager[T]](me).as_entity()
    ctrl.guard_enter()
    return

### Leaves the access lock: a no-op in LOCAL mode, a reentrant release in ESCAPED mode.
@inline
dangerous routine Roamed[T].lock_exit()
    var ctrl = Hijacked[RoamManager[T]](me).as_entity()
    ctrl.guard_exit()
    return

# ============================================================================
# Inspection / Stage-1 test access
# ============================================================================

### Returns the current strong reference count.
### :returns: The number of live strong handles.
routine Roamed[T].strong_count() -> U64
    danger
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        return ctrl.strong_count()

### Mints a NON-PINNING weak observation of this entity — ObjectHacker's `watch`. The returned
### {Watched[T]} does NOT keep the entity alive, but survives its death as a tombstone view so
### `is_alive()`/`is_destroyed()` stay answerable. The hollow handle yields a hollow observation.
### :returns: A `Watched[T]` observing this entity's controller.
routine Roamed[T].watch() -> Watched[T]
    danger
        if me.controller_address().is_hollow()
            return Watched[T](ctrl: 0)
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        ctrl.observe()
        return Watched[T](ctrl: me.controller_address())

### Reports this handle's controller to the collector as a traced child. The builder-synthesized
### `roam_trace` calls this for each `Roamed` field of an entity, so the collector sees the
### object graph's strong edges. A hollow handle owns no edge and is skipped. Runs inside the (dangerous)
### synthesized trace, so no `danger` here.
@override
dangerous routine Roamed[T].cyclic_visit()
    if me.controller_address().is_not_hollow()
        C::ingrid_cyclic_visit_child(child: me.controller_address())
    return

### Cycle-collector TRACE hook: a `Roamed` handle IS a strong edge, so report its controller to the
### collector rather than walking it as a struct. Overrides the universal member-walk default
### (`T.roam_trace` in DeriveText.rf) — a bare walk over a handle's internal pointer would be wrong.
@override
dangerous routine Roamed[T].roam_trace()
    me.cyclic_visit()
    return

### Cycle-collector FREE hook: a NO-OP. The collector frees the whole white cycle directly, so a handle
### must NOT tear down its pointee here — doing so would double-free a sibling reaped in the same batch.
### Overrides the universal `T.roam_free` default (which forwards to `destruct`).
@override
dangerous routine Roamed[T].roam_free()
    return

### The address of the underlying {RoamManager[T]} — the collector's currency and a Stage-1 test
### hatch. `Roamed[T]` is `@llvm("ptr")` and its bit pattern IS the controller pointer, so this is a
### pure reinterpretation, no load.
### :returns: The controller address.
@readonly
routine Roamed[T].controller_address() -> Addr
    return Hijacked[RoamManager[T]](me).get_address()

### Makes this entity keep the entity whose controller is at `source` alive: one more strong handle to it, let go
### when this entity's last handle goes. The builder calls it on an emitter adapter a Suflae program makes, with the
### collection the adapter walks, so the adapter is safe to store in a field or to return.
### :param source: The other entity's controller (`controller_address()` of its handle).
dangerous routine Roamed[T].keep(source: Addr)
    if me.controller_address().is_not_hollow() and source.is_not_hollow()
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        ctrl.keep(kept: source)
    return

### The inner entity as a raw reference. Real access is lock-wrapped by the builder's lock-bracket
### lowering around the enclosing access scope, so this coercion is safe: it is the deref half, the
### bracket pass is the lock half. Kept as the low-level plumbing name behind `access`/`control`.
### :returns: The inner entity.
dangerous routine Roamed[T].raw_inner() -> T
    var ctrl = Hijacked[RoamManager[T]](me).as_entity()
    return ctrl.data_ptr().as_entity()

# ============================================================================
# Marker-protocol coercion (access/control) — yields the inner entity as T. The access lock is applied
# transparently by the builder's lock-bracket lowering around the enclosing scope (see class doc),
# so these do NOT bypass escaped-mode serialization.
# ============================================================================

### Yields the inner entity as an in-flight `T` reference for read-only access.
### Inserted implicitly at call sites whose parameter is `Viewing[T]`.
### :returns: The inner entity as `T`.
@readonly
@inline
routine Roamed[T].access() -> T
    danger
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        return ctrl.data_ptr().as_entity()

### Yields the inner entity as an in-flight `T` reference for read/write access.
### Inserted implicitly at call sites whose parameter is `Modifying[T]`, and at method-dispatch
### deref on a `Roamed` receiver.
### :returns: The inner entity as `T`.
@inline
routine Roamed[T].control() -> T
    danger
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        return ctrl.data_ptr().as_entity()

### Read access to the held entity. A call hands this to a `Viewing[T]` parameter given the handle.
### :returns: The token.
@readonly
routine Roamed[T].view() -> Viewing[T]
    danger
        return Viewing[T](Hijacked[RoamManager[T]](me).as_entity().data_ptr())

### Write access to the held entity. A call hands this to a `Modifying[T]` parameter given the handle.
### :returns: The token.
routine Roamed[T].modify() -> Modifying[T]
    danger
        return Modifying[T](Hijacked[RoamManager[T]](me).as_entity().data_ptr())

# ============================================================================
# Display (opaque — the inner value is reachable only through the lock in real use)
# ============================================================================

# `represent`/`diagnose` are intentionally NOT declared on `Roamed[T]`: the wrapper is display-
# transparent, so codegen's `RoamedTransparency.Project` re-resolves `f"{roamed}"` / `roamed.diagnose()`
# to the INNER value's display routine (never showing "Roamed[...]"). Declaring them here would shadow
# the inner and reintroduce the opaque-wrapper rendering.

### Decrements the biased count, tearing down the entity at zero. A no-op on the hollow handle. This IS
### the decrement — no separate `release` verb; `destruct` is the teardown (calls the RoamManager's
### own `release` count primitive, a different type — no recursion).
@override
routine Roamed[T].destruct()
    danger
        if me.controller_address().is_hollow()
            return
        var ctrl = Hijacked[RoamManager[T]](me).as_entity()
        ctrl.unhold()
        return

### `==` between two handles, either of which may hold nothing (a Suflae `E?` member variable): equal when both hold
### nothing or both reach the same entity or equal ones, different when only one holds nothing. The builder calls it
### for `==` on two handles, so the entity's `eq` never meets a handle that holds nothing.
### :param you: The other handle.
### :returns: Whether the two are equal.
routine Roamed[T].handle_eq(you: Roamed[T]) -> Bool
needs T obeys Equatable
    if me.controller_address() === you.controller_address()
        return true
    if me.is_hollow() or you.is_hollow()
        return false
    return me.control() == you.control()

### `!=` between two handles, either of which may hold nothing: the opposite of `handle_eq`.
### :param you: The other handle.
### :returns: Whether the two differ.
routine Roamed[T].handle_ne(you: Roamed[T]) -> Bool
needs T obeys Equatable
    return not me.handle_eq(you)

### The text of a handle that may hold nothing (a Suflae `E?` member variable): `none` when it holds nothing, else the
### entity's own `represent()`. The builder calls it for a display of a handle, so the entity's `represent` never meets a
### handle that holds nothing.
### :returns: The text.
@readonly
routine Roamed[T].handle_represent() -> Text
    if me.is_hollow()
        return "none"
    return me.control().represent()

### The debug text of a handle that may hold nothing: `none` when it holds nothing, else the entity's own `diagnose()`.
### :returns: The debug text.
@readonly
routine Roamed[T].handle_diagnose() -> Text
    if me.is_hollow()
        return "none"
    return me.control().diagnose()

### Whether this Roamed is hollow: the all-zero value `Roamed[T].hollow()` gives, which holds nothing.
### :returns: `true` when it holds nothing.
@readonly
routine Roamed[T].is_hollow() -> Bool
    return LLVM::reinterpret_bits[Roamed[T], Addr](me).is_hollow()
