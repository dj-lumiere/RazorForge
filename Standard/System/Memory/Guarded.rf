module System/Memory

import BuilderQuery
### Multi-threaded strong reference to shared data under an access discipline `TPolicy`. Thin pointer to
### {GuardManager[T, TPolicy]}. The atomic-refcount twin of {Retained[T]} — equivalent to `Arc[T]` in Rust.
### Cloning bumps the strong count atomically (`.share()`); dropping decrements it. Safe across threads.
###
### The policy `TPolicy` (an {AccessPolicy}: {ReadOnly} / {Exclusive} / {MultiRead}) is part of the type, so it is
### fixed at build time and selected by monomorphization — no runtime dispatch. Unlike {Retained[T]}, the guarded
### value is reached only through a token: `viewing g as v` binds a {Viewing[T]} and `modifying g as m` a
### {Modifying[T]} for the block, and `f(x: g.modify())` holds the access for that one call. Under `Exclusive` or
### `MultiRead` the block takes the access when it starts (waiting while another agent holds it) and gives it up on
### every way out. Which blocks a policy admits (`viewing` or `modifying`) follows from `TPolicy`. A `ReadOnly` value
### is read directly.
### :typeparam T: The exclusively owned entity type.
### :typeparam TPolicy: The access policy.
@llvm("ptr")
record Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys AccessPolicy
    pass

# ============================================================================
# Construction
# ============================================================================

### `Guarded[T, TPolicy](from: n)`: the entity moves into the handle, which shares it across threads.
routine Guarded[T, TPolicy](from: T) -> Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys AccessPolicy
    danger
        var ctrl = GuardManager[T, TPolicy](data: from.hijack()).hijack()
        return Guarded[T, TPolicy](ctrl)

### The absent `Guarded[T, TPolicy]`: a null handle owning nothing. Sharing and tearing it down do nothing, so a
### value that holds one only sometimes (an empty `Text`) needs no flag of its own.
### :returns: The absent `Guarded[T, TPolicy]`.
routine guarded_none[T, TPolicy]() -> Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys AccessPolicy
    danger
        return Guarded[T, TPolicy](Hijacked[GuardManager[T, TPolicy]](from: Addr.hollow()))

# ============================================================================
# Reference counting
# ============================================================================

### Returns a new strong reference to the same entity, atomically incrementing the strong count.
### :returns: A new strong handle sharing the same underlying entity.
@readonly
@override
secret routine Guarded[T, TPolicy].share() -> Guarded[T, TPolicy]
    danger
        if Hijacked[GuardManager[T, TPolicy]](me).get_address().is_hollow()
            return me
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.hold()
    return me

### Creates a weak reference to the same entity.
### :returns: A new weak handle to the same entity's controller.
routine Guarded[T, TPolicy].observe() -> Witnessed[T, TPolicy]
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.observe()
        return Witnessed[T, TPolicy](me)

# ============================================================================
# Access — read or change the guarded entity. A `viewing` / `modifying` block or a `g.view()` / `g.modify()` argument
# is lowered by the builder to these routines: the access is taken first (`open_*`, `try_*`, or for a block with
# several targets `enlist_*` and then `access_open_enlisted`), the token is `view()` / `modify()`, and every way out
# gives the access up (`close_*`).
# ============================================================================

### Read access to the value: `viewing g as v` in a block, or `f(x: g.view())` for one call. Under `MultiRead` the
### builder takes the read access around the block or the call. A `Guarded[T, ReadOnly]` takes none, and `g.view()`
### is an ordinary {Viewing[T]} anywhere.
### :returns: A read token on the guarded entity.
@readonly
@untraced
routine Guarded[T, TPolicy].view() -> Viewing[T]
needs TPolicy in [MultiRead, ReadOnly]
    danger
        return Viewing[T](Hijacked[GuardManager[T, TPolicy]](me).as_entity().raw_data())

### Write access to the value: `modifying g as m` in a block, or `f(x: g.modify())` for one call. The builder takes
### the write access around the block or the call, waiting until no other agent holds it.
### :returns: A write token on the guarded entity.
@readonly
@untraced
routine Guarded[T, TPolicy].modify() -> Modifying[T]
needs TPolicy in [Exclusive, MultiRead]
    danger
        return Modifying[T](Hijacked[GuardManager[T, TPolicy]](me).as_entity().raw_data())

### Takes read access, waiting while a writer holds it. The builder calls it where a `viewing` block or a `g.view()`
### argument starts.
@readonly
@untraced
routine Guarded[T, TPolicy].open_view()
needs TPolicy in [MultiRead, ReadOnly]
    danger
        Hijacked[GuardManager[T, TPolicy]](me).as_entity().open(mode: 1)
    return

### Takes write access, waiting while anyone else holds it. The builder calls it where a `modifying` block or a
### `g.modify()` argument starts.
@readonly
@untraced
routine Guarded[T, TPolicy].open_modify()
needs TPolicy in [Exclusive, MultiRead]
    danger
        Hijacked[GuardManager[T, TPolicy]](me).as_entity().open(mode: 2)
    return

### Tries read access once, without waiting: what `try viewing g as v` starts with.
### :returns: `true` when the access was taken (the block runs and gives it up), `false` when a writer holds it right
###           now (the `else` block runs and nothing is held).
@readonly
@untraced
routine Guarded[T, TPolicy].try_view() -> Bool
needs TPolicy in [MultiRead]
    danger
        return Hijacked[GuardManager[T, TPolicy]](me).as_entity().try_open(mode: 1)

### Tries write access once, without waiting: what `try modifying g as m` starts with.
### :returns: `true` when the access was taken (the block runs and gives it up), `false` when anyone holds it right
###           now (the `else` block runs and nothing is held).
@readonly
@untraced
routine Guarded[T, TPolicy].try_modify() -> Bool
needs TPolicy in [Exclusive, MultiRead]
    danger
        return Hijacked[GuardManager[T, TPolicy]](me).as_entity().try_open(mode: 2)

### Gives up read access on every way out of a `viewing` block or after a `g.view()` argument's call.
@readonly
@untraced
routine Guarded[T, TPolicy].close_view()
needs TPolicy in [MultiRead, ReadOnly]
    danger
        Hijacked[GuardManager[T, TPolicy]](me).as_entity().close(mode: 1)
    return

### Gives up write access on every way out of a `modifying` block or after a `g.modify()` argument's call.
@readonly
@untraced
routine Guarded[T, TPolicy].close_modify()
needs TPolicy in [Exclusive, MultiRead]
    danger
        Hijacked[GuardManager[T, TPolicy]](me).as_entity().close(mode: 2)
    return

### Names read access as one target of a block that opens several at once (`viewing rates, modifying payer`): the
### block opens them together, in the order of their addresses, with {access_open_enlisted}.
@readonly
@untraced
routine Guarded[T, TPolicy].enlist_view()
needs TPolicy in [MultiRead, ReadOnly]
    danger
        Hijacked[GuardManager[T, TPolicy]](me).as_entity().enlist(mode: 1)
    return

### Names write access as one target of a block that opens several at once.
@readonly
@untraced
routine Guarded[T, TPolicy].enlist_modify()
needs TPolicy in [Exclusive, MultiRead]
    danger
        Hijacked[GuardManager[T, TPolicy]](me).as_entity().enlist(mode: 2)
    return

### Opens the targets a block named, the lowest address first, waiting for each. Two agents naming the same targets
### in different orders take them in the same order, so they can't wait on each other.
### :throws: Crashes with `AliasedTokensError` when two names of the block are the same entity.
@untraced
routine access_open_enlisted()
    danger
        C::rf_access_open_enlisted()
    return

### Opens the targets a block named only if every one is free right now, without waiting: what a `try` block with
### several targets starts with.
### :returns: `true` when it opened them all, `false` when one was taken (then none is open).
### :throws: Crashes with `AliasedTokensError` when two names of the block are the same entity.
@untraced
routine access_try_open_enlisted() -> Bool
    danger
        return C::rf_access_try_open_enlisted() != 0

# ============================================================================
# Inspection
# ============================================================================

### Returns the current strong reference count.
### :returns: The number of live strong handles to this entity.
routine Guarded[T, TPolicy].strong_count() -> U64
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return ctrl.strong_count()

### Returns the current weak reference count.
### :returns: The number of live weak handles to this entity's controller.
routine Guarded[T, TPolicy].weak_count() -> U64
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return ctrl.weak_count()

# ============================================================================
# Display (opaque — the inner value is reachable only through a token)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Guarded[T, TPolicy].represent() -> Text
    danger
        return me.type_name()

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Guarded[T, TPolicy].diagnose() -> Text
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        var rc = ctrl.strong_count()
        var weak = ctrl.weak_count()
        var addr = ctrl.raw_data().get_address()
        return me.type_name() + "(holding: " + rc.represent() + ", observing: " + weak.represent() + ", addr: " + addr.represent() + ")"

### `steal handle`: the entity comes out of the handle, which ends. The builder calls this for `steal` on a
### `Guarded`, for example to share a table under another policy once the threads that filled it are done. Weak
### handles see the entity gone afterwards.
### :returns: The entity.
### :throws: {SharedHandleStealError} when another strong handle still shares the entity.
failable dangerous routine Guarded[T, TPolicy].release_inner() -> T
    var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
    var holders = ctrl.strong_count()
    if holders != 1
        throw SharedHandleStealError(holders: holders)
    return ctrl.release_data().as_entity()

### Decrements the strong count, tearing down the entity at zero (and the controller when both counts
### reach zero). This IS the decrement — no separate `release` verb; `destruct` is the teardown.
@override
routine Guarded[T, TPolicy].destruct()
    danger
        if Hijacked[GuardManager[T, TPolicy]](me).get_address().is_hollow()
            return
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.unhold()
        return

### Whether this Guarded is hollow: the all-zero value `Guarded[T, TPolicy].hollow()` gives, which holds nothing.
### :returns: `true` when it holds nothing.
@readonly
routine Guarded[T, TPolicy].is_hollow() -> Bool
    return LLVM::reinterpret_bits[Guarded[T, TPolicy], Addr](me).is_hollow()
