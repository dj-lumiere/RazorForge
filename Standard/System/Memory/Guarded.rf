module System/Memory

import BuilderQuery
### Multi-threaded strong reference to shared data under an access discipline `TPolicy`. Thin pointer to
### {GuardManager[T, TPolicy]}. The atomic-refcount twin of {Retained[T]} — equivalent to `Arc[T]` in Rust.
### Cloning bumps the strong count atomically (`.share()`); dropping decrements it. Safe across threads.
###
### The policy `TPolicy` (an {AccessPolicy}: {ReadOnly} / {Exclusive} / {MultiRead}) is part of the type, so it is
### fixed at build time and selected by monomorphization — no runtime dispatch. Unlike {Retained[T]}, the guarded
### value is reached only through a token: `viewing g as v` binds the {Viewing[T]} `view_enter()` gives and
### `modifying g as m` the {Modifying[T]} `modify_enter()` gives, and `f(x: g.modify())` holds the access for that one
### call. Under `Exclusive` or `MultiRead` the block takes the access when it starts (waiting while another agent holds
### it) and gives it up on every way out (`view_exit()` / `modify_exit()`). Which blocks a policy admits (`viewing` or
### `modifying`) follows from `TPolicy`. A `ReadOnly` value is read directly.
### :typeparam T: The exclusively owned entity type.
### :typeparam TPolicy: The access policy.
@llvm("ptr")
record Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys AccessPolicy
    nothing

# ============================================================================
# Construction
# ============================================================================

### `Guarded[T, TPolicy](from: n)`: the entity moves into the handle, which shares it across threads.
routine Guarded[T, TPolicy](from: T) -> Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys AccessPolicy
    danger
        var ctrl = GuardManager[T, TPolicy](data: from.hijack()).hijack()
        return Guarded[T, TPolicy](ctrl)

### The absent `Guarded[T, TPolicy]`: a null handle owning nothing. Sharing and tearing it down do nothing, so a
### value that holds one only sometimes (an empty `Text`) needs no flag of its own.
### :returns: The absent `Guarded[T, TPolicy]`.
routine guarded_none[T, TPolicy]() -> Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys AccessPolicy
    danger
        return Guarded[T, TPolicy](Hijacked[GuardManager[T, TPolicy]](from: Addr.hollow()))

# ============================================================================
# Reference counting
# ============================================================================

### Returns a new strong reference to the same entity, atomically incrementing the strong count.
### :returns: A new strong handle sharing the same underlying entity.
@readonly
@override
secret routine Guarded[T, TPolicy].share() -> Guarded[T, TPolicy]
    danger
        if Hijacked[GuardManager[T, TPolicy]](me).get_address().is_hollow()
            return me
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.hold()
    return me

### Creates a weak reference to the same entity.
### :returns: A new weak handle to the same entity's controller.
routine Guarded[T, TPolicy].observe() -> Witnessed[T, TPolicy]
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.observe()
        return Witnessed[T, TPolicy](me)

# ============================================================================
# Access — read or change the guarded entity. `viewing g as v` calls `view_enter()` before the block and
# `view_exit()` on every way out of it, `modifying g as m` calls `modify_enter()` and `modify_exit()`, and a
# `g.view()` / `g.modify()` argument does the same around its statement.
# ============================================================================

### Read access to the value, for a `ReadOnly` Guarded anywhere and for a `g.view()` argument, which the builder
### opens with {view_enter} around its statement.
### :returns: A read token on the guarded entity.
@readonly
@untraced
routine Guarded[T, TPolicy].view() -> Viewing[T]
needs TPolicy in [MultiRead, ReadOnly]
    danger
        return Viewing[T](Hijacked[GuardManager[T, TPolicy]](me).as_entity().raw_data())

### Write access to the value, for a `g.modify()` argument, which the builder opens with {modify_enter} around its
### statement.
### :returns: A write token on the guarded entity.
@readonly
@untraced
routine Guarded[T, TPolicy].modify() -> Modifying[T]
needs TPolicy in [Exclusive, MultiRead]
    danger
        return Modifying[T](Hijacked[GuardManager[T, TPolicy]](me).as_entity().raw_data())

### Takes read access, waiting while a writer holds it: what `viewing g as v` starts with. A `ReadOnly` Guarded takes
### nothing.
### :returns: A read token on the guarded entity, the block's `v`.
### :throws: {ReenterDuringAccessError} when this agent has the access open already: waiting for it would never end.
@readonly
@untraced
failable routine Guarded[T, TPolicy].view_enter() -> Viewing[T]
needs TPolicy in [MultiRead, ReadOnly]
    danger
        var manager = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        if manager.held_here()
            throw ReenterDuringAccessError()
        manager.open(mode: 1)
        return Viewing[T](manager.raw_data())

### Takes write access, waiting while anyone else holds it: what `modifying g as m` starts with.
### :returns: A write token on the guarded entity, the block's `m`.
### :throws: {ReenterDuringAccessError} when this agent has the access open already: waiting for it would never end.
@readonly
@untraced
failable routine Guarded[T, TPolicy].modify_enter() -> Modifying[T]
needs TPolicy in [Exclusive, MultiRead]
    danger
        var manager = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        if manager.held_here()
            throw ReenterDuringAccessError()
        manager.open(mode: 2)
        return Modifying[T](manager.raw_data())

### Gives up read access on every way out of a `viewing` block, and after a `g.view()` argument's statement.
@readonly
@untraced
routine Guarded[T, TPolicy].view_exit()
needs TPolicy in [MultiRead, ReadOnly]
    danger
        Hijacked[GuardManager[T, TPolicy]](me).as_entity().close(mode: 1)
    return

### Gives up write access on every way out of a `modifying` block, and after a `g.modify()` argument's statement.
@readonly
@untraced
routine Guarded[T, TPolicy].modify_exit()
needs TPolicy in [Exclusive, MultiRead]
    danger
        Hijacked[GuardManager[T, TPolicy]](me).as_entity().close(mode: 2)
    return

### Checks that the tokens and entities a block names are different entities, the block's targets other than the ones
### it enters: named first with `enlist_identity`, then checked here.
### :throws: Crashes with `AliasedTokensError` when two names of the block are the same entity.
@untraced
routine access_open_enlisted()
    danger
        C::rf_access_open_enlisted()
    return

# ============================================================================
# Inspection
# ============================================================================

### Returns the current strong reference count.
### :returns: The number of live strong handles to this entity.
routine Guarded[T, TPolicy].strong_count() -> U64
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return ctrl.strong_count()

### Returns the current weak reference count.
### :returns: The number of live weak handles to this entity's controller.
routine Guarded[T, TPolicy].weak_count() -> U64
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return ctrl.weak_count()

# ============================================================================
# Display (opaque — the inner value is reachable only through a token)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Guarded[T, TPolicy].represent() -> Text
    danger
        return me.type_name()

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Guarded[T, TPolicy].diagnose() -> Text
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        var rc = ctrl.strong_count()
        var weak = ctrl.weak_count()
        var addr = ctrl.raw_data().get_address()
        return me.type_name() + "(holding: " + rc.represent() + ", observing: " + weak.represent() + ", addr: " + addr.represent() + ")"

### `steal handle`: the entity comes out of the handle, which ends. The builder calls this for `steal` on a
### `Guarded`, for example to share a table under another policy once the threads that filled it are done. Weak
### handles see the entity gone afterwards.
### :returns: The entity.
### :throws: {SharedHandleStealError} when another strong handle still shares the entity.
failable dangerous routine Guarded[T, TPolicy].release_inner() -> T
    var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
    var holders = ctrl.strong_count()
    if holders != 1
        throw SharedHandleStealError(holders: holders)
    return ctrl.release_data().as_entity()

### Decrements the strong count, tearing down the entity at zero (and the controller when both counts
### reach zero). This IS the decrement — no separate `release` verb; `destruct` is the teardown.
@override
routine Guarded[T, TPolicy].destruct()
    danger
        if Hijacked[GuardManager[T, TPolicy]](me).get_address().is_hollow()
            return
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.unhold()
        return

### Whether this Guarded is hollow: the all-zero value `Guarded[T, TPolicy].hollow()` gives, which holds nothing.
### :returns: `true` when it holds nothing.
@readonly
routine Guarded[T, TPolicy].is_hollow() -> Bool
    return LLVM::reinterpret_bits[Guarded[T, TPolicy], Addr](me).is_hollow()
