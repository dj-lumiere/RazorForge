module System/Memory

### ObjectHacker's weak observation of a Roamed entity — a NON-PINNING handle minted by
### `Roamed[T].watch()`. It does NOT keep the entity alive; after the entity dies it survives as a
### tombstone view so `is_alive()`/`is_destroyed()` stay answerable without dangling. "Weak" is an
### internal property of the substrate (RoamManager's weak/tombstone layer) — users of ObjectHacker
### just hold a `Watched` and ask whether the object is still there; they never see a weak-reference
### concept. Holds only the controller address (the weak edge); `0` = the absent observation.
### :typeparam T: The observed entity type.
###
### NOTE (experiment): balanced copy semantics (observe-on-copy, like `Witnessed[T, P].share`) are a
### follow-up. `Watched` currently carries only a scalar address (no hand-written `store`), so a
### return is a bitwise MOVE — mint (`watch`) observes once, the single live handle's `destruct`
### unobserves once. Do not COPY a `Watched` yet (a bitwise copy would unbalance the weak count).
record Watched[T]
needs EntityType T
    ### The observed entity's {RoamManager} address — the weak edge. `0` for the absent observation.
    secret ctrl: Addr

### Whether the observed entity is still alive. Safe after the entity's death (reads the tombstone's
### `dead` flag, never the freed entity data). :returns: `true` until the entity has been destroyed.
routine Watched[T].is_alive() -> Bool
    danger
        if me.ctrl.is_hollow()
            return false
        return Hijacked[RoamManager[T]](from: me.ctrl).as_entity().is_alive()

### Whether the observed entity has been destroyed (by either free path). :returns: `true` once gone.
routine Watched[T].is_destroyed() -> Bool
    danger
        if me.ctrl.is_hollow()
            return true
        return Hijacked[RoamManager[T]](from: me.ctrl).as_entity().is_destroyed()

### A strong handle on the observed entity, used directly from then on.
### :returns: A new `Roamed[T]` sharing the entity.
### :throws: {AbsentValueError} when the entity is gone (or this Watched observes nothing).
failable routine Watched[T].hold() -> Roamed[T]
    danger
        if me.ctrl.is_hollow()
            throw AbsentValueError()
        var ctrl = Hijacked[RoamManager[T]](from: me.ctrl).as_entity()
        if not ctrl.is_alive()
            throw AbsentValueError()
        ctrl.hold()
        return Roamed[T](Hijacked[RoamManager[T]](from: me.ctrl))

### Releases the weak observation. If this was the last observer of an already-dead (tombstoned)
### controller, the controller struct is finally freed. Called at scope exit like any owned handle.
@override
routine Watched[T].destruct()
    danger
        if me.ctrl.is_not_hollow()
            Hijacked[RoamManager[T]](from: me.ctrl).as_entity().unobserve()
        return

### Whether this Watched is hollow: the all-zero value `Watched[T].hollow()` gives, which observes nothing.
### :returns: `true` when it observes nothing.
@readonly
routine Watched[T].is_hollow() -> Bool
    return me.ctrl.is_hollow()
