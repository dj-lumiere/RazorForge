module System/Memory

import BuilderQuery
### Represents temporary read-only access to a value where it is stored: an entity, or a record in its place
### (a variable, a field, a container slot). It is the address of that place, the same as `Hijacked[T]`.
### `Viewing[T]` is the non-Assignable access token produced by `.view()` for single-threaded observation.
### :typeparam T: The type being viewed.
### :see: {Modifying[T]}, {Guarded[T, TPolicy]}
@llvm("ptr")
record Viewing[T]
    pass

### Produces a temporary read-only view of `me`.
### :returns: The resulting `Viewing[T]` value.
### :note: Entity-only. A record's token is made by whatever holds the record in place (a container hands
###        one out for its element), from that place's address: `me` here could be a copy.
@readonly
routine T.view() -> Viewing[T]
needs EntityType T
    danger
        return Viewing[T](me.hijack())

# NOTE: No creators, no manual methods - all operations handled by builder
# The address member variable is managed internally by the `.view()` implementation
# Users should NEVER create Viewing[T] values directly

# ============================================================================
# A target of a block that opens several at once
# ============================================================================

### Names this token's entity as one target of a `viewing` / `modifying` block that opens several at once
### (`modifying into, viewing from`): nothing is taken, the block only checks that its targets are different
### entities, and stops the program with `AliasedTokensError` when two are the same one.
@readonly
@untraced
routine Viewing[T].enlist_identity()
    danger
        C::rf_access_enlist(access: Hijacked[T](me).get_address(), kind: 0, mode: 1)
    return

# ============================================================================
# Marker-protocol coercion (access) — yields the inner entity as T
# ============================================================================

### Yields the inner entity as an in-flight `T` reference for read-only access.
### Inserted implicitly at call sites whose parameter is `Viewing[T]`.
### :returns: The inner entity as `T`.
@readonly
@inline
@overridable
routine Viewing[T].access() -> T
needs RecordType T
    # A record read out of its place is a holder of its own, as `getitem` gives one.
    danger
        return Hijacked[T](me).peek().share()

### `access` for a single-owner entity: the entity itself, which the token only points at.
### :returns: The viewed entity.
@readonly
@inline
@override
routine Viewing[T].access() -> T
needs EntityType T
    danger
        return Hijacked[T](me).as_entity()

# ============================================================================
# Display (transparent - delegates to inner value)
# ============================================================================

### Returns the display form of the viewed value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Viewing[T].represent() -> Text
    # Through `access`, which reads an entity in place and a record out of its slot.
    return me.access().represent()

### Returns the diagnostic form of the viewed value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Viewing[T].diagnose() -> Text
    return me.type_name() + "(" + me.access().diagnose() + ")"

@override
routine Viewing[T].destruct()
    return

### Whether this Viewing is hollow: the all-zero value `Viewing[T].hollow()` gives, which holds nothing.
### :returns: `true` when it holds nothing.
@readonly
routine Viewing[T].is_hollow() -> Bool
    return LLVM::reinterpret_bits[Viewing[T], Addr](me).is_hollow()
