module System/Memory

### Multi-threaded reference-counting manager — the atomic twin of {RetainManager[T]}.
### Owns the managed entity; shared between {Guarded[T, TPolicy]} (strong) and {Witnessed[T, TPolicy]} (weak). All
### count mutations go through SeqCst atomic intrinsics driven on the live field address
### (`me.<field>.hijack()`), so cloning/dropping a handle is safe across threads.
###
### Also holds the state of the access policy `TPolicy` (an {AccessPolicy}): who is using the entity right now, the
### readers and the one writer, and which job holds it. The state lives here, at the one address every handle
### references, so the `viewing` and `modifying` blocks of every job meet at it. The runtime's AccessManager takes
### and gives up the access, and finds jobs that wait on each other. A token itself carries only permission.
### Selected by monomorphization: `ReadOnly` is zero-sized (no overhead), `Exclusive`/`MultiRead` carry their state.
### :typeparam T: The exclusively owned entity type.
### :typeparam TPolicy: The access policy.
entity GuardManager[T, TPolicy]
needs EntityType T
needs TPolicy obeys AccessPolicy
    ### Strong reference count (live `Guarded` handles). Changed atomically.
    secret strong_count: U64
    ### Weak reference count (live `Witnessed` handles). Changed atomically.
    secret weak_count: U64
    ### Raw pointer to the managed entity.
    secret data: Hijacked[T]
    ### The access policy's state. Laid out per `TPolicy` by monomorphization.
    secret access: TPolicy

### Creates a new controller with one strong reference, no weak references, and a free access.
### :param data: The raw pointer to the entity; ownership transfers to this controller.
### :returns: The resulting `GuardManager[T, TPolicy]` value.
dangerous routine GuardManager[T, TPolicy](data: Hijacked[T]) -> GuardManager[T, TPolicy]
    return GuardManager[T, TPolicy](strong_count: 1, weak_count: 0, data: data, access: TPolicy())

### Atomically increments the strong count when a `Guarded` handle is cloned.
routine GuardManager[T, TPolicy].hold()
    danger
        drop LLVM::atomic_add[U64](ptr: me.strong_count.hijack(), value: 1)
    return

### Atomically decrements the strong count. When it reaches zero the managed entity is dropped,
### and the controller itself is freed if no weak handles remain.
routine GuardManager[T, TPolicy].unhold()
    danger
        var previous = LLVM::atomic_sub[U64](ptr: me.strong_count.hijack(), value: 1)
        if previous == 1
            me.drop_data()
            if me.weak_count() == 0
                me.destruct()
    return

### Atomically increments the weak count when a `Witnessed` handle is cloned.
routine GuardManager[T, TPolicy].observe()
    danger
        drop LLVM::atomic_add[U64](ptr: me.weak_count.hijack(), value: 1)
    return

### Atomically decrements the weak count, freeing the controller when both counts reach zero.
routine GuardManager[T, TPolicy].unobserve()
    danger
        var previous = LLVM::atomic_sub[U64](ptr: me.weak_count.hijack(), value: 1)
        if previous == 1
            if me.strong_count() == 0
                me.destruct()
    return

### Returns the current number of live strong (`Guarded`) handles. Snapshot only.
### :returns: The strong reference count.
routine GuardManager[T, TPolicy].strong_count() -> U64
    danger
        return LLVM::atomic_load[U64](ptr: me.strong_count.hijack())

### Returns the current number of live weak (`Witnessed`) handles. Snapshot only.
### :returns: The weak reference count.
routine GuardManager[T, TPolicy].weak_count() -> U64
    danger
        return LLVM::atomic_load[U64](ptr: me.weak_count.hijack())

### Returns a non-owning pointer to the managed data.
### :returns: The resulting `Hijacked[T]` value.
routine GuardManager[T, TPolicy].raw_data() -> Hijacked[T]
    return me.data

# ============================================================================
# Access: taken and given up by the Guarded's `view_enter` / `modify_enter` and `view_exit` / `modify_exit`, which the
# `viewing` / `modifying` blocks and the `g.view()` / `g.modify()` arguments call. The state lives here, at the single address every handle shares, and the runtime's
# AccessManager works on it. `mode` is 1 to read, 2 to write. A `ReadOnly` policy has no state: nothing is taken.
# ============================================================================

### The address of the access policy's state, as the runtime's AccessManager takes it.
### :returns: The address.
@untraced
secret routine GuardManager[T, TPolicy].access_address() -> Addr
    danger
        return me.access.hijack().get_address()

### Takes the access, waiting while another job holds it.
### :param mode: 1 to read, 2 to write.
@untraced
routine GuardManager[T, TPolicy].open(mode: U32)
    var kind = me.access.access_kind()
    if kind != 0
        danger
            C::rf_access_lock(access: me.access_address(), kind: kind, mode: mode)
    return

### Whether this job holds the access already, for reading or for writing.
### :returns: `true` when it does (a `ReadOnly` policy has nothing to hold: `false`).
@untraced
routine GuardManager[T, TPolicy].held_here() -> Bool
    var kind = me.access.access_kind()
    if kind == 0
        return false
    danger
        return C::rf_access_holds(access: me.access_address()) != 0

### Gives up the access this job holds.
### :param mode: 1 to read, 2 to write.
@untraced
routine GuardManager[T, TPolicy].close(mode: U32)
    var kind = me.access.access_kind()
    if kind != 0
        danger
            C::rf_access_unlock(access: me.access_address(), kind: kind, mode: mode)
    return

### Gives the managed entity up to the last strong handle, which is ending: the strong count drops to zero without
### tearing the entity down, and the controller is freed unless weak handles remain (they now see it gone).
### :returns: The managed entity's pointer, now owned by the caller.
dangerous routine GuardManager[T, TPolicy].release_data() -> Hijacked[T]
    drop LLVM::atomic_sub[U64](ptr: me.strong_count.hijack(), value: 1)
    var data = me.data
    if me.weak_count() == 0
        me.destruct()
    return data

### Destroys the managed entity. Call only when the strong count reaches zero.
### Runs the entity's own `destruct` (the sole free under unified teardown); does not also
### `invalidate`, which would double-free a self-freeing entity.
dangerous routine GuardManager[T, TPolicy].drop_data()
    me.data.as_entity().destruct()
    return

@override
routine GuardManager[T, TPolicy].destruct()
    danger
        me.strong_count.destruct()
        me.weak_count.destruct()
        return
