module System/Concurrency

import BuilderQuery
# ---- Transmitting end --------------------------------------------------------------------------------

### The transmitting end of a channel. Clone it for multiple producers; the last one dropping (or an
### explicit `close`) closes the channel.
entity Transmitter[T]
    ### The shared native channel handle (rf_channel*).
    secret chan: Addr

# ---- Receiving ends -----------------------------------------------------------------------------

### The single-consumer receiving end. Obeys `Iterable[T]`: `for x in hop` drains it until the
### channel closes and the buffer empties. There is only ever one `Receiver` per channel (it is not
### cloneable — use a `SharedReceiver` for multiple consumers).
entity Receiver[T]
relates ChannelDrain[T] as Iter
obeys Iterable[T]
    ### The shared native channel handle (rf_channel*).
    secret chan: Addr

### A multi-consumer receiving handle. Clone one per consumer for a worker pool; any free worker
### takes the next item. Obeys `Iterable[T]` like `Receiver`.
entity SharedReceiver[T]
relates ChannelDrain[T] as Iter
obeys Iterable[T]
    ### The shared native channel handle (rf_channel*).
    secret chan: Addr

# ---- The drain iterator -------------------------------------------------------------------------

### The iterator a receiving end hands to a `for` loop. It references the channel without owning it (the
### owning `Receiver`/`SharedReceiver` holds the consumer reference); `emit!` receives one item, parking
### while the buffer is empty, and throws `AbsentValueError` once the channel is closed and drained — ending the loop.
entity ChannelDrain[T]
obeys Emittable[T]
    ### The shared native channel handle (rf_channel*), non-owning (this iterator holds no reference).
    secret chan: Addr

# Channels — `Receiver[T]` (single consumer) / `SharedReceiver[T]` (multi consumer) message passing.
#
# A channel is a typed conduit carrying a STREAM of values between concurrent jobs (the streaming
# counterpart to Work's one-shot result). The transmitting end is a `Transmitter[T]` (cloneable for multiple
# producers); the receiving end is a `Receiver[T]` (one owner) or, for multiple consumers, a `SharedReceiver[T]`
# (clone one per consumer). Receiving == iterating: both receivers obey `Iterable[T]`, so `for x in`,
# IterTools, and explicit iteration all work — there is no separate receive verb.
#
# `transmit` and receive park the calling coroutine when the buffer is full / empty (woken cross-thread
# by the counterpart op) or block a plain thread — uncolored, like `retrieve!`/`waitfor`. The native
# refcounted ring buffer (Ingrid's runtime-tessera/channel.te) backs all of this; the last `Transmitter`
# dropping auto-closes the channel, after which receivers drain the buffer then end.

# ---- Creation -----------------------------------------------------------------------------------

### Creates a single-consumer channel and returns its `(Transmitter, Receiver)` pair. `capacity` is the
### buffered depth: 0 = rendezvous (transmit waits for a taker), N = a bounded buffer (transmit blocks when
### full = backpressure). Clone the `Transmitter` for multiple producers (fan-in).
### :param capacity: The buffer depth (0 = rendezvous).
### :returns: A `(Transmitter[T], Receiver[T])` tuple sharing one channel.
routine make_channel[T](capacity: U64) -> (Transmitter[T], Receiver[T])
    danger
        var chan = C::rf_channel_create(capacity: capacity)
        return (Transmitter[T](chan: chan), Receiver[T](chan: chan))

### Creates a multi-consumer channel and returns its `(Transmitter, SharedReceiver)` pair. Clone the
### `SharedReceiver` (one per consumer) for a worker pool — any free worker takes the next item (consumer
### fan-out, not broadcast). `capacity` as in `make_channel`.
### :param capacity: The buffer depth (0 = rendezvous).
### :returns: A `(Transmitter[T], SharedReceiver[T])` tuple sharing one channel.
routine make_shared_channel[T](capacity: U64) -> (Transmitter[T], SharedReceiver[T])
    danger
        var chan = C::rf_channel_create(capacity: capacity)
        return (Transmitter[T](chan: chan), SharedReceiver[T](chan: chan))

### Transmits one item, moving its ownership into the channel. Blocks/parks while the buffer is full
### (backpressure); for a rendezvous channel waits until a consumer takes it. FAILABLE: throws
### {ChannelClosedError} if the channel is already closed or has no consumers left.
### :param item: The value to transmit (ownership transfers in).
failable routine Transmitter[T].transmit(item: T)
    danger
        var box = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size()))
        box.poke(value: item)
        var ok = C::rf_channel_feed(chan: me.chan, payload: box.address())
        if ok == 0
            # Undelivered: reclaim the item, then the box, before reporting the closed channel.
            var orphan = box.peek()
            box.invalidate()
            throw ChannelClosedError()
    return

### Transmits one item only when the channel has room for it now, never waiting: the step a broadcast takes per
### subscriber, where waiting on one full subscriber would hold up the rest. On a rendezvous channel there is room
### while no item waits in it, and the transmitter does not wait for the taker.
### :param item: The value to transmit (ownership transfers in when it is sent, and it is destroyed when it is not).
### :returns: `true` when the item went in, `false` when the channel was full.
### :throws: {ChannelClosedError} if the channel is already closed or has no consumers left.
failable routine Transmitter[T].transmit_if_room(item: T) -> Bool
    danger
        var box = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size()))
        box.poke(value: item)
        var outcome = C::rf_channel_offer(chan: me.chan, payload: box.address())
        if outcome == 1
            return true
        # Undelivered: reclaim the item, then the box.
        var orphan = box.peek()
        box.invalidate()
        if outcome == 0
            throw ChannelClosedError()
        return false

### Produces another transmitting handle on the same channel (fan-in: more producers).
### :returns: A new `Transmitter[T]` on the same channel.
routine Transmitter[T].duplicate() -> Transmitter[T]
    danger
        C::rf_channel_add_feeder(chan: me.chan)
        return Transmitter[T](chan: me.chan)

### Closes the channel early (dropping the last Transmitter also closes it). Receivers drain the buffer
### then finish. Not dangerous — closing is the normal end-of-stream signal; double-close is a no-op.
routine Transmitter[T].close()
    danger
        C::rf_channel_close(chan: me.chan)
    return

### Whether the channel has been closed (a subsequent `transmit` would throw). Racy: another job could
### close it the instant after you check, so prefer handling `transmit`'s failure to gating on this.
### :returns: `true` if the channel is closed.
routine Transmitter[T].is_closed() -> Bool
    danger
        return C::rf_channel_is_closed(chan: me.chan) != 0

### Drops this producer reference; the last one closes the channel.
@override
routine Transmitter[T].destruct()
    danger
        C::rf_channel_drop_feeder(chan: me.chan)
        return

### Destroys every item still buffered in a closed channel.
secret routine destroy_buffered[T](chan: Addr)
    danger
        var box = hijacked_from[T](C::rf_channel_next(chan: chan))
        until box.is_hollow()
            var leftover = box.peek()
            box.invalidate()
            box = hijacked_from[T](C::rf_channel_next(chan: chan))
    return

### Returns an iterator that draws items from the channel (receive == iterate).
### :returns: A `ChannelDrain[T]` over this channel.
@readonly
routine Receiver[T].iter() -> ChannelDrain[T]
    danger
        return ChannelDrain[T](chan: me.chan)

### The number of buffered items right now. A racy snapshot for diagnostics/heuristics — never a
### synchronization decision (it can change the instant after you read it).
### :returns: The current buffered item count.
routine Receiver[T].count() -> U64
    danger
        return C::rf_channel_count(chan: me.chan)

### Whether the buffer is currently empty. Racy snapshot (see `count`).
### :returns: `true` if no items are buffered.
routine Receiver[T].is_empty() -> Bool
    danger
        return C::rf_channel_count(chan: me.chan) == 0

### Whether the channel has been closed (it may still hold buffered items to drain).
### :returns: `true` if closed.
routine Receiver[T].is_closed() -> Bool
    danger
        return C::rf_channel_is_closed(chan: me.chan) != 0

### The buffered capacity this channel was created with (0 = rendezvous).
### :returns: The buffer capacity.
routine Receiver[T].capacity() -> U64
    danger
        return C::rf_channel_capacity(chan: me.chan)

### Closes the channel from the receiving side, for a consumer that wants no more items. What is still buffered is
### destroyed without being received, a later `transmit` throws {ChannelClosedError}, and a transmitter waiting for room wakes
### with that error. The stage feeding this channel then ends on its failed `transmit`, so an early stop travels up a
### pipeline. Closing twice does nothing.
routine Receiver[T].close()
    danger
        C::rf_channel_close(chan: me.chan)
    destroy_buffered[T](chan: me.chan)
    return

### Drops this consumer reference; the channel frees once no producers and no consumers remain.
@override
routine Receiver[T].destruct()
    danger
        C::rf_channel_drop_consumer(chan: me.chan)
        return

### Produces another consumer handle on the same channel (one more line worker).
### :returns: A new `SharedReceiver[T]` on the same channel.
routine SharedReceiver[T].duplicate() -> SharedReceiver[T]
    danger
        C::rf_channel_add_consumer(chan: me.chan)
        return SharedReceiver[T](chan: me.chan)

### Returns an iterator that draws items from the channel (receive == iterate).
### :returns: A `ChannelDrain[T]` over this channel.
@readonly
routine SharedReceiver[T].iter() -> ChannelDrain[T]
    danger
        return ChannelDrain[T](chan: me.chan)

### The number of buffered items right now (racy snapshot — diagnostics only, not synchronization).
### :returns: The current buffered item count.
routine SharedReceiver[T].count() -> U64
    danger
        return C::rf_channel_count(chan: me.chan)

### Whether the buffer is currently empty (racy snapshot). :returns: `true` if no items are buffered.
routine SharedReceiver[T].is_empty() -> Bool
    danger
        return C::rf_channel_count(chan: me.chan) == 0

### Whether the channel has been closed (may still hold buffered items). :returns: `true` if closed.
routine SharedReceiver[T].is_closed() -> Bool
    danger
        return C::rf_channel_is_closed(chan: me.chan) != 0

### The buffered capacity this channel was created with (0 = rendezvous). :returns: The capacity.
routine SharedReceiver[T].capacity() -> U64
    danger
        return C::rf_channel_capacity(chan: me.chan)

### Closes the channel from the receiving side, for a consumer that wants no more items. What is still buffered is
### destroyed without being received, a later `transmit` throws {ChannelClosedError}, and a transmitter waiting for room wakes
### with that error. The stage feeding this channel then ends on its failed `transmit`, so an early stop travels up a
### pipeline. Closing twice does nothing.
routine SharedReceiver[T].close()
    danger
        C::rf_channel_close(chan: me.chan)
    destroy_buffered[T](chan: me.chan)
    return

### Drops this consumer reference; the channel frees once no producers and no consumers remain.
@override
routine SharedReceiver[T].destruct()
    danger
        C::rf_channel_drop_consumer(chan: me.chan)
        return

### Receives the next item, or throws `AbsentValueError` when the channel is closed and the buffer is empty.
### :returns: The next value. Throws `AbsentValueError` at end-of-stream.
@writable
failable routine ChannelDrain[T].emit() -> T
    danger
        var box = hijacked_from[T](C::rf_channel_next(chan: me.chan))
        if box.is_hollow()
            throw AbsentValueError()
        var value = box.peek()
        box.invalidate()
        return value
