module System

### Represents the crashable raised when a range is iterated or tested with a step of zero. A step of zero never
### moves, so the range would never reach its end. The sign of a step sets the direction: `by -1` counts down.
crashable RangeStepZeroError
    pass

### Returns the default message for a range whose step is zero.
### :returns: The resulting `Text` value.
@override
routine RangeStepZeroError.crash_message() -> Text
    return "This range's step is zero, so it would never reach its end. Give it a step that moves: a positive step counts up, a negative one counts down (`10 to 0 by -1`)."
