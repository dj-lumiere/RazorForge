module System

import BuilderQuery
### A run of up to `COUNT` places laid out in place, for elements of any type, whose count changes while the program
### runs.
###
### `PartialSlots[T, COUNT]` is `Slots[T, COUNT]` with a count: the room for `COUNT` elements is fixed at build
### time and lives inside the value itself (no allocation), and the first `count()` of them hold an element.
### `add_last` fills the next place and `remove_last` gives the last element back. It is an entity: it has one
### original, never copied by `=`, and handed over with `steal`. Adding to a full `PartialSlots` is an ordinary
### failure (`FullCollectionError`), so `try` and `check` can receive it, and the element that did not fit ends.
### Ending a `PartialSlots` ends the filled places only.
###
### **When to use**
### - The most elements that can ever be held is known at build time, the count is only known while running, and
###   the element type may be an entity (a stack of known greatest depth over generic code).
### - Use {PartialItems[T, COUNT]} when the elements are values: it is a record and copies with `=`.
### - Use {Slots[T, COUNT]} when every place always holds an element.
### - Use {List[T]} when there is no greatest count.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add_last` / `remove_last` | O(1) |
### | `getitem` / `setitem` | O(1) |
### | `has` | O(count) |
### | Iteration | O(count) |
###
### :typeparam T: The element type stored in the places.
### :typeparam COUNT: The most elements held, a `U64` fixed at build time.
### :see: {Slots[T, COUNT]} for a fixed number of places.
### :see: {PartialItems[T, COUNT]} for the same with values.
entity PartialSlots[T, COUNT]
relates PartialSlotsEmitter[T, COUNT] as Emitter
obeys Emittable[T], ModifyingIndexable[T], Sized, Container
needs U64 COUNT
    ### Stores the places, of which the first `used` hold an element.
    secret places: Slots[T, COUNT]
    ### Stores how many places hold an element.
    secret used: U64

# ============================================================================
# Iteration Support
# ============================================================================

### Walks the elements of a `PartialSlots[T, COUNT]` that are held, from index 0 up, reading each one where it is.
### :typeparam T: The element type yielded by the emitter.
### :typeparam COUNT: The most elements the walked value holds.
entity PartialSlotsEmitter[T, COUNT]
obeys Emitter[T]
needs U64 COUNT
    ### Points at the places being walked: each element is read in place, so the loop's binding only reads it.
    secret data: Hijacked[Slots[T, COUNT]]
    ### Stores how many elements the walk reaches.
    secret held: U64
    ### Stores the next index to read.
    secret index: U64

# ============================================================================
# Construction
# ============================================================================

### Builds a `PartialSlots` that holds no element yet.
### :returns: An empty `PartialSlots` with room for `COUNT` elements.
routine PartialSlots[T, COUNT]() -> PartialSlots[T, COUNT]
    return PartialSlots[T, COUNT](places: Slots[T, COUNT](), used: 0)

# ============================================================================
# Query Operations
# ============================================================================

### Returns how many places hold an element.
### :returns: The number of elements held, at most `COUNT`.
@readonly
routine PartialSlots[T, COUNT].count() -> U64
    return me.used

### Returns the most elements this value holds, the buildtime parameter `COUNT`.
### :returns: `COUNT`.
@readonly
routine PartialSlots[T, COUNT].capacity() -> U64
    return COUNT

### Returns true when no place holds an element.
### :returns: `true` if `count()` is zero.
@readonly
routine PartialSlots[T, COUNT].is_empty() -> Bool
    return me.used == 0

### Returns true when every place holds an element, so `add_last` would fail.
### :returns: `true` if `count()` equals `capacity()`.
@readonly
routine PartialSlots[T, COUNT].is_full() -> Bool
    return me.used >= COUNT

# ============================================================================
# Adding and removing
# ============================================================================

### Puts `value` in the next place, after the elements held.
### :param value: The value to add.
### :throws: {FullCollectionError} All `COUNT` places hold an element.
@reshaping
routine PartialSlots[T, COUNT].add_last(value: T)
    if me.used >= COUNT
        throw FullCollectionError(capacity: COUNT)
    me.places.put_raw(index: me.used, value: value)
    me.used = me.used + 1
    return

### Adds the steps that run next, given in the order they run, so that `remove_last` gives them back in that order.
### `stack.add_next(a, b, c)` leaves `a` at the back, then `b`, then `c`: the steps go in last to first. When they
### do not all fit, none is added.
### :param steps: The steps in the order they should come back out.
### :throws: {FullCollectionError} There is not room for every step.
### :see: {PartialSlots[T, COUNT].remove_last}
@reshaping
routine PartialSlots[T, COUNT].add_next(steps...: T)
    if steps.count() > COUNT - me.used
        throw FullCollectionError(capacity: COUNT)
    var i = steps.count()
    until i == 0
        i = i -% 1
        me.add_last(value: steps.get_raw(index: i))
    return

### Removes the last element and gives it back.
### :returns: The element that was last.
### :throws: {AbsentValueError} No place holds an element.
@reshaping
routine PartialSlots[T, COUNT].remove_last() -> T
    if me.used == 0
        throw AbsentValueError()
    me.used = me.used - 1
    return me.places.get_raw(index: me.used)

### Removes every element and ends them. The places that held one are free for `add_last` again.
@reshaping
routine PartialSlots[T, COUNT].clear()
    var i: U64 = 0
    until i >= me.used
        danger
            me.places.get_raw(index: i).destruct()
        i = i + 1
    me.used = 0
    return

# ============================================================================
# Indexing
# ============================================================================

### Returns the element at `index`, as a holder of its own (a share for a counted value).
### :param index: The zero-based position to read.
### :returns: The element stored at that position.
### :throws: {IndexOutOfBoundsError} if `index >= count()`.
@readonly
routine PartialSlots[T, COUNT].getitem(index: U64) -> T
needs RecordType T
    if index >= me.used
        throw IndexOutOfBoundsError(index: index, count: me.used)
    return me.places.get_raw(index: index).share()

### Returns a write token on the entity stored at `index`, so one call or field write through it changes the
### element in place: `stack[0].v = 5` lowers to `stack.modify_at(index: 0).v = 5`.
### :param index: The zero-based position.
### :returns: A write token on the element.
### :throws: {IndexOutOfBoundsError} if `index >= count()`.
routine PartialSlots[T, COUNT].modify_at(index: U64) -> Modifying[T]
needs EntityType T
    if index >= me.used
        throw IndexOutOfBoundsError(index: index, count: me.used)
    return me.places.modify_at(index: index)

### Returns a read token on the entity stored at `index`, so one call or field read through it reads the element
### without copying it: `stack[0].v` lowers to `stack.view_at(index: 0).v`.
### :param index: The zero-based position.
### :returns: A read token on the element.
### :throws: {IndexOutOfBoundsError} if `index >= count()`.
@readonly
routine PartialSlots[T, COUNT].view_at(index: U64) -> Viewing[T]
needs EntityType T
    if index >= me.used
        throw IndexOutOfBoundsError(index: index, count: me.used)
    return me.places.view_at(index: index)

### Replaces the element at `index` with `value`, tearing the old one down first.
### :param index: The zero-based position to update.
### :param value: The replacement value.
### :throws: {IndexOutOfBoundsError} if `index >= count()`.
routine PartialSlots[T, COUNT].setitem(index: U64, value: T)
    if index >= me.used
        throw IndexOutOfBoundsError(index: index, count: me.used)
    me.places.setitem(index: index, value: value)
    return

### Returns true if any element held equals `value`.
### :param value: The value to search for.
### :returns: `true` if `value` is found, `false` otherwise.
@readonly
routine PartialSlots[T, COUNT].has(value: T) -> Bool
needs T obeys Equatable
    var i: U64 = 0
    until i >= me.used
        if me.places.get_raw(index: i) == value
            return true
        i = i + 1
    return false

### Returns whether `value` is not among the elements held: the opposite of `has`.
### :param value: The value to look for.
### :returns: `true` when `value` is absent.
@readonly
routine PartialSlots[T, COUNT].lacks(value: T) -> Bool
needs T obeys Equatable
    return not me.has(value)

# ============================================================================
# Iteration
# ============================================================================

### Returns an emitter over the elements held, in ascending index order. It reads each element where it is, so the
### value must stay as it is while the loop runs (the builder keeps it from being reshaped, RF-S625).
### :returns: An emitter over the elements held.
@readonly
routine PartialSlots[T, COUNT].emitter() -> PartialSlotsEmitter[T, COUNT]
    danger
        return PartialSlotsEmitter[T, COUNT](data: me.places.hijack(), held: me.used, index: 0)

### Returns the next element held, read in place: for an entity element it is the element itself, which the loop
### only reads.
### :returns: The element at the current index.
### :throws: {AbsentValueError} Every element held has been yielded.
routine PartialSlotsEmitter[T, COUNT].emit() -> T
    if me.index >= me.held
        throw AbsentValueError()
    danger
        var value: T = LLVM::load_element_ref[Slots[T, COUNT], T](me.data, me.index)
        me.index = me.index + 1
        return value

# ============================================================================
# Teardown
# ============================================================================

### Tears down the elements held. The places that hold none are not touched.
@override
routine PartialSlots[T, COUNT].destruct()
    var i: U64 = 0
    until i >= me.used
        danger
            me.places.get_raw(index: i).destruct()
        i = i + 1
    return

### Cycle-collector TRACE: reports each element held to the collector.
@override
infallible dangerous routine PartialSlots[T, COUNT].roam_trace()
    var i: U64 = 0
    until i >= me.used
        me.places.get_raw(index: i).cyclic_visit()
        i = i + 1
    return

### Cycle-collector FREE: does nothing. A `PartialSlots` has no allocation of its own, and the collector frees its
### elements as part of the cycle.
@override
infallible dangerous routine PartialSlots[T, COUNT].roam_free()
    return

### Returns an independent copy: each element held duplicated through its own `duplicate`.
### :returns: A new `PartialSlots` holding a duplicate of each element held.
@readonly
routine PartialSlots[T, COUNT].duplicate() -> PartialSlots[T, COUNT]
needs T obeys Copyable
    var result = PartialSlots[T, COUNT]()
    var i: U64 = 0
    until i >= me.used
        result.add_last(value: me.places.get_raw(index: i).duplicate())
        i = i + 1
    return result

# ============================================================================
# Display
# ============================================================================

### Returns the display form: each element held in its own display form, between brackets.
### :returns: The resulting `Text` value.
@readonly
@override
routine PartialSlots[T, COUNT].represent() -> Text
    var result = "["
    var i: U64 = 0
    until i >= me.used
        if i > 0
            result = result + ", "
        result = result + nested_repr(me.places.get_raw(index: i))
        i = i + 1
    result = result + "]"
    return result

### Returns the diagnostic form: the type name, then each element held in its own diagnostic form.
### :returns: The resulting `Text` value.
@readonly
@override
routine PartialSlots[T, COUNT].diagnose() -> Text
    var result = me.full_type_name() + "(["
    var i: U64 = 0
    until i >= me.used
        if i > 0
            result = result + ", "
        result = result + nested_diagnose(me.places.get_raw(index: i))
        i = i + 1
    result = result + "])"
    return result
