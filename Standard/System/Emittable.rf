module System

### Represents the `Emittable` protocol.
### An emittable value can produce a fresh emitter for use in `for` loops and
### other traversal utilities.
### :typeparam T: The element type yielded during iteration.
protocol Emittable[T]
relates Emitter obeys Emitter[T]
    ### Creates an emitter over this value.
    ### Each call should return an emitter positioned at the start of the sequence.
    ### :returns: The resulting `Emitter[T]` value.
    @readonly
    routine Me.emitter() -> Me/Emitter
