module System

### Represents the crashable raised when a byte or a character is not an ASCII digit of the base it is read in.
crashable InvalidDigitError
    nothing

### Returns the default message for a byte or a character that is not a digit.
### :returns: The resulting `Text` value.
@override
routine InvalidDigitError.crash_message() -> Text
    return "This is not an ASCII digit of the base it was read in: 0-9, and a-f or A-F above base 10."
