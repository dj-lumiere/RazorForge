module System

### An address with no pointee type, mapped to LLVM `ptr` (C's `void*`): what an allocator hands out, a handle the
### runtime gives back, a callback's state. It says where, not what. Memory is read and written through a typed
### `Hijacked[T](from: a)`.
### Two addresses name the same place when `a === b` (`a !== b` when they differ). An address is not a number: it has no
### ordering, and its only arithmetic is moving it by a `ByteSize` with `+%` / `-%` (`a +% 16b`) and measuring two
### with `-%` (`b -% a` is the bytes from `a` to `b`). Both wrap around and check no bounds.
### :see: {Hijacked[T]}, {ByteSize}
@llvm("ptr")
record Addr
obeys ConstCompatible, Copyable, WrappingOffsetAddable, WrappingOffsetSubtractable
    pass

### Returns the address 0, which names no memory.
### :returns: The address 0.
common routine Addr.hollow() -> Addr
    var zero: U64 = 0
    return zero.to[Addr]()

### The address a `U64` names: `0x1000.to[Addr]()`.
### :returns: The address.
routine U64.to[Addr]() -> Addr
    return LLVM::reinterpret_bits[U64, Addr](value: me)

### Reads this address as a `U64`: `a.to[U64]()`. The distance between two addresses is `b -% a`, a `ByteSize`.
### :returns: The address as a number.
routine Addr.to[U64]() -> U64
    return LLVM::reinterpret_bits[Addr, U64](value: me)

### Returns a bitwise duplicate of this address. An `@llvm("ptr")` record derives no copy step, so this trivial body
### lets `=` and `with` work. What the address points at is not copied.
### :returns: The same address.
@readonly
@override
secret routine Addr.share() -> Addr
    return me

### Returns the same address (Copyable). What it points at is not copied.
### :returns: The same address.
@readonly
routine Addr.duplicate() -> Addr
    return me

# ============================================================================
# Identity
# ============================================================================

### Whether `me` and `you` are the same address: `me === you`.
### :param you: The other address.
### :returns: `true` when the addresses are equal.
@readonly
routine Addr.same(you: Addr) -> Bool
    return LLVM::ptr_same[Addr](a: me, b: you)

### Whether `me` and `you` are different addresses: `me !== you`.
### :param you: The other address.
### :returns: `true` when the addresses differ.
@readonly
routine Addr.notsame(you: Addr) -> Bool
    return not LLVM::ptr_same[Addr](a: me, b: you)

### Whether this is the address 0, which names no memory.
### :returns: `true` when the address is 0.
@readonly
routine Addr.is_hollow() -> Bool
    return LLVM::ptr_same[Addr](a: me, b: Addr.hollow())

### Whether this is an address other than 0.
### :returns: `true` when the address is not 0.
@readonly
routine Addr.is_not_hollow() -> Bool
    return not me.is_hollow()

# ============================================================================
# Moving
# ============================================================================

### The address `you` bytes further on: `me +% you`. It wraps around the end of the address space, and nothing checks
### bounds: staying inside the block is the caller's job.
### :param you: How far to move.
### :returns: The moved address.
@readonly
routine Addr.add_wrap(you: ByteSize) -> Addr
    return LLVM::byte_offset(base: me, bytes: LLVM::reinterpret_bits[ByteSize, S64](you))

### The address `you` bytes back: `me -% you`. It wraps around the start of the address space, and nothing checks
### bounds.
### :param you: How far to move back.
### :returns: The moved address.
@readonly
routine Addr.sub_wrap(you: ByteSize) -> Addr
    var back: S64 = 0
    return LLVM::byte_offset(base: me, bytes: back -% LLVM::reinterpret_bits[ByteSize, S64](you))

### The distance in bytes from `you` to this address: `me -% you`. With `you` past this address it wraps around, so
### the earlier address goes on the right.
### :param you: The address to measure from.
### :returns: The distance.
@readonly
routine Addr.sub_wrap(you: Addr) -> ByteSize
    return LLVM::reinterpret_bits[U64, ByteSize](me.to[U64]() -% you.to[U64]())

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the display form of this address.
### Addresses are rendered in grouped hexadecimal form to make pointer values
### easier to scan in diagnostics.
### :returns: The resulting `Text` value.
@readonly
@override
routine Addr.represent() -> Text
    # Format as 0xXXXX_XXXX_XXXX_XXXX (64-bit hex with underscore groups)
    var digits = List[Char]()
    digits.add_last('0')
    digits.add_last('x')
    var i: U32 = 0
    until i >= 16
        if i > 0 and i % 4 == 0
            digits.add_last('_')
        var shift = (15 - i) * 4
        var nibble = ((me.to[U64]() >> shift) & 0x0F).to[U32]()
        if nibble < 10
            digits.add_last(Char(0x0030 + nibble))
        else
            digits.add_last(Char(0x0041 + nibble - 10))
        i = i + 1
    return Text(from_list: steal digits)

### Returns the diagnostic form of this address.
### :returns: The resulting `Text` value.
@readonly
@override
routine Addr.diagnose() -> Text
    return "Addr(" + me.represent() + ")"

### Parses an address from hexadecimal text.
### The accepted format is hex digits with an optional `0x`/`0X` prefix and
### optional underscore separators.
### :returns: The resulting `Addr` value.
### :throws: May throw {InvalidValueError}.
failable routine Text.to[Addr]() -> Addr
    # Parses hex format: 0xXXXX_XXXX_XXXX_XXXX
    if me.count() == 0
        throw InvalidValueError(input: me, target: "Addr")
    var result: U64 = 0
    var i: U64 = 0
    # Skip optional "0x" prefix
    if me.count() > 1
        if me[0] == '0'
            if me[1] == 'x'
                i = 2
            elseif me[1] == 'X'
                i = 2
    if i >= me.count()
        throw InvalidValueError(input: me, target: "Addr")
    until i >= me.count()
        var cp = me[i].codepoint()
        if 0x0030 <= cp <= 0x0039
            result = (result << 4) + (cp - 0x0030).to[U64]()
        elseif 0x0041 <= cp <= 0x0046
            result = (result << 4) + (cp - 0x0041 + 10).to[U64]()
        elseif 0x0061 <= cp <= 0x0066
            result = (result << 4) + (cp - 0x0061 + 10).to[U64]()
        elseif cp == 0x005F
            pass
        else
            throw InvalidValueError(input: me, target: "Addr")
        i = i + 1
    return result.to[Addr]()
