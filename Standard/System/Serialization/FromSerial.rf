# ============================================================================
# Collections
# ============================================================================

### Builds a `List[T]` from its serialized element list.
### :throws: {SerialShapeError} when the value is not a list or an element does not fit `T`.
failable common routine List[T].from_serial(value: SerialValue) -> List[T]
    var result = List[T]()
    when value
        is List[SerialValue] as items =>
            for item in items
                result.add_last(value: serial_decode[T](value: item))
        else =>
            throw SerialShapeError(detail: "expected a list")
    return result

### Builds the set from its serialized element list, the reverse of `serialize`.
### :param value: The serialized element list.
### :returns: The rebuilt set.
### :throws: {SerialShapeError} when the value is not a list or an element does not fit `T`.
failable common routine Set[T].from_serial(value: SerialValue) -> Set[T]
    var result = Set[T]()
    when value
        is List[SerialValue] as items =>
            for item in items
                drop result.add(value: serial_decode[T](value: item))
        else =>
            throw SerialShapeError(detail: "expected a list")
    return result

### Builds the dictionary from its serialized entry table, the reverse of `serialize`.
### :param value: The serialized entry table.
### :returns: The rebuilt dictionary.
### :throws: {SerialShapeError} when the value is not a table or an entry does not fit, or a parse error when a key
### does not read as a `TKey`.
failable common routine Dict[TKey, TValue].from_serial(value: SerialValue) -> Dict[TKey, TValue]
    var result = Dict[TKey, TValue]()
    when value
        is Dict[Text, SerialValue] as entries =>
            for entry in entries
                var decoded = serial_decode[TValue](value: entry.item1)
                result[serial_key[TKey](key: entry.item0)] = steal decoded
        else =>
            throw SerialShapeError(detail: "expected an entry table")
    return result
