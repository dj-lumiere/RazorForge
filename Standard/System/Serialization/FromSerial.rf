### Builds a `Byte` from its serialized form (a `U8`). :throws: {SerialShapeError} on any other arm.
failable common routine Byte.from_serial(value: SerialValue) -> Byte
    when value
        is U8 as v => return Byte(v)
        else => throw SerialShapeError(detail: "expected a byte")

### Builds a `Char` from its serialized form (a one-character `Text`).
### :throws: {SerialShapeError} when the value is not a one-character text.
failable common routine Char.from_serial(value: SerialValue) -> Char
    var t = serial_text(value: value)
    if t.count() != 1
        throw SerialShapeError(detail: "expected exactly one character")
    return t[0]

### Builds an `S128` from its serialized text. :throws: {SerialShapeError} or a parse error.
failable common routine S128.from_serial(value: SerialValue) -> S128
    return serial_text(value: value).to[S128]()

### Builds a `U128` from its serialized text. :throws: {SerialShapeError} or a parse error.
failable common routine U128.from_serial(value: SerialValue) -> U128
