module System/Serialization

import BuilderExpansion
import Collections
### Raised when a `SerialValue` does not have the shape `sv.to[T]()` expects: a
### missing member variable, a text where a number was expected, an unknown choice case, and so on.
crashable SerialShapeError
    ### What was expected and what was found.
    detail: Text

### Returns the message for a serialized value that does not fit its target type.
### :returns: The resulting `Text` value.
@readonly
@override
routine SerialShapeError.crash_message() -> Text
    return f"The serialized value does not fit: {me.detail}"

### The serialized value of member variable `name` inside a serialized record or entity (the
### `Dict[Text, SerialValue]` that `serialize` produces).
### :param value: The serialized record or entity.
### :param name: The member variable to look up.
### :returns: The member variable's serialized value.
### :throws: {SerialShapeError} when `value` is not a member-variable table or has no entry for `name`.
failable routine serial_field(value: SerialValue, name: Text) -> SerialValue
    when value
        is Dict[Text, SerialValue] as d =>
            if d.has_key(name)
                return d[name].duplicate()
            throw SerialShapeError(detail: f"member variable {name} is missing")
        else =>
            throw SerialShapeError(detail: f"expected a member variable table for {name}")

### The text inside a serialized `Text` value.
### :param value: The serialized value.
### :returns: The text.
### :throws: {SerialShapeError} when `value` is not text.
failable routine serial_text(value: SerialValue) -> Text
    when value
        is Text as t => return t
        else => throw SerialShapeError(detail: "expected text")

### The key a serialized dictionary entry names: `serialize` writes each key with `represent`, so a `Text` key is
### the text itself and any other key is read back from it.
### :typeparam T: The key type.
### :param key: The entry's name.
### :returns: The key.
### :throws: A parse error when `key` does not read as a `T`.
failable routine serial_key[T](key: Text) -> T
    when T
        is Text => return serial_decode[T](value: SerialValue(from: key))
        else => return key.to[T]()

### Builds a `T` from its serialized form: the generic entry point the builder-synthesized `from_serial`
### routines call for their member variables and arms. A part that does not fit fails the whole rebuild, so
### `try sv.to[List[S64]]()` recovers a bad element too.
### :typeparam T: The type to build.
### :param value: The serialized value.
### :returns: The rebuilt value.
### :throws: {SerialShapeError} or a parse error when `value` does not have the shape `T` needs.
failable routine serial_decode[T](value: SerialValue) -> T
    return T.from_serial(value: value)

### Rebuilds a value from its serialized form, the reverse of `serialize`: `sv.to[Point]()`,
### `try sv.to[List[S64]]()`. Each type rebuilds itself in `failable common routine T.from_serial(value: SerialValue)`: the
### builder writes it for records, entities, choices, flags and variants, and a type may write its own.
### :returns: The rebuilt value.
### :throws: {SerialShapeError} when the value does not have the shape `T` needs.
failable routine SerialValue.to[T]() -> T
needs AnyType T
    return T.from_serial(value: me)

### Builds a choice value from its serialized case name.
### :typeparam T: The choice type.
### :param value: The serialized case name.
### :returns: The matching case.
### :throws: {SerialShapeError} when the name is not a case of `T`.
failable routine choice_from_serial[T](value: SerialValue) -> T
needs ChoiceType T
    var name = serial_text(value: value)
    expand c in caseof(T)
        if name == nameof(c)
            return LLVM::reinterpret_bits[S32, T]($valueof(c))
    throw SerialShapeError(detail: f"{name} is not a known case")

### Builds a flags value from the serialized list of its set member names.
### :typeparam T: The flags type.
### :param value: The serialized list of member names.
### :returns: The flags value with exactly those members set.
### :throws: {SerialShapeError} when `value` is not a list of names or a name is not a member of `T`.
failable routine flags_from_serial[T](value: SerialValue) -> T
needs FlagsType T
    var mask: U64 = 0
    when value
        is List[SerialValue] as names =>
            for entry in names
                var name = serial_text(value: entry)
                var found = false
                expand c in caseof(T)
                    if name == nameof(c)
                        mask = mask.bitor(you: $valueof(c))
                        found = true
                if not found
                    throw SerialShapeError(detail: f"{name} is not a known flag")
        else =>
            throw SerialShapeError(detail: "expected a list of flag names")
    return LLVM::reinterpret_bits[U64, T](mask)

### Builds a variant value from its serialized `{arm: payload}` table. (A variant with a `None` arm
### handles a serialized `None` in its builder-synthesized `from_serial` before calling this.)
### :typeparam T: The variant type.
### :param value: The serialized variant.
### :returns: The variant holding the rebuilt payload in the named arm.
### :throws: {SerialShapeError} when `value` is not a one-entry table naming an arm of `T`.
failable routine variant_from_serial[T](value: SerialValue) -> T
needs VariantType T
    when value
        is Dict[Text, SerialValue] as d =>
            if d.count() != 1
                throw SerialShapeError(detail: "a variant needs exactly one arm entry")
            var arm = d.keys()[0]
            var payload = d.values()[0].duplicate()
            expand m in branchof(T)
                if arm == nameof(m)
                    return T(from: serial_decode[$typeof(m)](value: payload))
            throw SerialShapeError(detail: f"{arm} is not an arm of this variant")
        else =>
            throw SerialShapeError(detail: "expected a variant arm table")

# ============================================================================
# Leaf types: one hand-written `from_serial` per type. A type that is itself a SerialValue arm takes its
# arm out, as `value.to[S64]()` does.
# ============================================================================

### A `SerialValue` is already its own serialized form.
### :param value: The serialized value.
### :returns: The same value.
common routine SerialValue.from_serial(value: SerialValue) -> SerialValue
    return value

### Takes the `Bool` out of its serialized form. :throws: {SerialShapeError} on any other arm.
failable common routine Bool.from_serial(value: SerialValue) -> Bool
    when value
        is Bool as v => return v
        else => throw SerialShapeError(detail: "expected Bool")

### Takes the `S8` out of its serialized form. :throws: {SerialShapeError} on any other arm.
failable common routine S8.from_serial(value: SerialValue) -> S8
    when value
        is S8 as v => return v
        else => throw SerialShapeError(detail: "expected S8")

