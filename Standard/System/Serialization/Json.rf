module System/Serialization

import Collections
### JSON encoder over the `SerialValue` tree. Any `Serializable` value reaches JSON via
### `value.serialize().to_json_bytes()`. This is a format encoder in the sense of
### `Serializable`'s doc: it walks the neutral `SerialValue` tree and renders one concrete wire
### format. Encoding is total — every arm has a rendering, so it never fails.
###
### Format notes (lossy round-trip — JSON has fewer types than `SerialValue`):
###   - `None`            -> `null`
###   - `Bool`            -> `true` / `false`
###   - integers          -> decimal digits
###   - `B32` / `B64`     -> decimal (non-finite floats are out of scope)
###   - `Text`            -> a JSON string with quote, backslash and control chars escaped
###   - `Moment`          -> a JSON string of its `represent()`
###   - `Bytes`           -> a JSON array of byte VALUES (`[10, 20]`), since JSON has no byte type
###   - `List`            -> a JSON array
###   - `Dict[Text, _]`   -> a JSON object (keys are the Text keys, escaped)

### Renders `t` as a quoted, escaped JSON string.
### Escapes the quote, the backslash, the named controls (b, t, n, f, r), and any other control
### code as the u00XX form (lowercase hex). The escaping is Tessera's `Standard::Json`, called
### through Ingrid: one pass sizes the result, the second fills it.
### :param t: The text to encode.
### :returns: The JSON string literal, including the surrounding quotes.
secret routine json_string(t: Text) -> Text
    var count = C::ingrid_json_quoted_count_utf32(chars: t.data, count: t.count)
    var result = text_alloc(count: count)
    drop C::ingrid_json_quote_utf32(chars: t.data, count: t.count, out: result.data, out_count: count)
    return result

### Encodes this `SerialValue` tree as JSON `Text`. Total — never fails.
### :returns: The JSON rendering.
@readonly
routine SerialValue.to_json_text() -> Text
    when me
        is None =>
            return "null"
        is Bool as b =>
            return if b then "true" else "false"
        is S8 as v =>
            return v.represent()
        is S16 as v =>
            return v.represent()
        is S32 as v =>
            return v.represent()
        is S64 as v =>
            return v.represent()
        is U8 as v =>
            return v.represent()
        is U16 as v =>
            return v.represent()
        is U32 as v =>
            return v.represent()
        is U64 as v =>
            return v.represent()
        is B32 as v =>
            return v.represent()
        is B64 as v =>
            return v.represent()
        is Moment as v =>
            return json_string(t: v.represent())
        is Text as v =>
            return json_string(t: v)
        is Bytes as v =>
            var body: Text = "["
            var first = true
            each byte in v
                if not first
                    body = body + ","
                body = body + byte.value().represent()
                first = false
            body = body + "]"
            return body
        is List[SerialValue] as xs =>
            var body: Text = "["
            var first = true
            each x in xs
                if not first
                    body = body + ","
                body = body + x.to_json_text()
                first = false
            body = body + "]"
            return body
        is Dict[Text, SerialValue] as d =>
            # Walk keys()/values() by index rather than `for entry in d`. The type-resolution gap that
            # blocked `for entry in d` in a concrete stdlib method is fixed (GetIterableElementType now
            # resolves the element via the emitter's `emit!` return), so it COMPILES — but tearing down
            # the per-iteration `DictEntry` loop variable (whose `value` is a copied nested-Dict SerialValue)
            # still double-frees here, a separate concrete-method teardown bug. keys()/values() (concrete
            # element types) sidesteps the DictEntry loop variable entirely.
            var ks = d.keys()
            var vs = d.values()
            var body: Text = "{"
            var i: U64 = 0
            until i >= ks.count()
                if i > 0
                    body = body + ","
                body = body + json_string(t: ks[i]) + ":" + vs[i].to_json_text()
                i = i + 1
            body = body + "}"
            return body
        else =>
            return "null"

### Encodes this `SerialValue` tree as UTF-8 JSON `Bytes`. Total — never fails.
### :returns: The UTF-8 encoded JSON.
@readonly
routine SerialValue.to_json_bytes() -> Bytes
    return me.to_json_text().encode_as_utf8()
