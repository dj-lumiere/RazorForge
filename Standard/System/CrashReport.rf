module System

# The crash report is written here, in RazorForge: the C runtime only writes bytes to the error stream,
# flushes, and exits. Nothing on this path may crash or allocate (it runs because something already
# crashed, possibly out of memory), so it uses wrapping arithmetic, the raw primitives and stack buffers.

### One frame of the crash trace, as the builder's trace helpers keep it: the routine's name and the source
### file (NUL-terminated C strings), and the line and column the routine has reached.
record TraceFrame
    routine_name: Address
    file: Address
    line: S32
    column: S32

### Ends the program with a crash report: the error type's name, its message, where it was raised, then
### the call trace, and exit status 82. The builder calls it for a `throw` nothing recovers, so every crash
### report has this one shape.
### :param type_name: The name of the error type.
### :param message: What went wrong.
### :param file: The source file the crash was raised in.
### :param line: The source line, or 0 for a crash raised in the standard library, named by where the program
###     called into it.
### :param column: The source column.
@untraced
routine crash_report(type_name: Text, message: Text, file: Text, line: S32, column: S32)
    C::rf_flush_output()
    var colored = C::rf_stderr_is_terminal()
    if colored
        crash_write(text: "\u00001B[91m")
    crash_write(text: type_name)
    crash_write(text: ": ")
    crash_write(text: message)
    crash_write(text: "\nat ")
    if line == 0 and crash_write_library_caller(library: file)
        crash_write(text: "\n")
    else
        crash_write(text: file)
        crash_write(text: ":")
        crash_write_number(value: line)
        crash_write(text: ":")
        crash_write_number(value: column)
        crash_write(text: "\n")
    crash_write_trace()
    if colored
        crash_write(text: "\u00001B[0m")
    C::rf_crash_exit()
    return

### Ends the program with the report of a caught error thrown again (a `throw e` of a `Crashables`, or a
### `when` that does not handle the error passing it on): the error's title and message, where it was first
### thrown, the trace it was first thrown with, and where it was thrown again, then exit status 82. By the
### time it is thrown again, the routines between the first throw and the catcher have returned, so the
### calling thread's own trace no longer has them.
### :param type_name: The error's title.
### :param message: What went wrong.
### :param error: The caught error, which kept the trace it was first thrown with.
### :param file: The source file it was thrown again in.
### :param line: That source line, or 0 for a rethrow written in the standard library, named by where the
###     program called into it.
### :param column: That source column.
@untraced
routine crash_report_rethrown(type_name: Text, message: Text, error: Crashables, file: Text, line: S32, column: S32)
    C::rf_flush_output()
    var colored = C::rf_stderr_is_terminal()
    if colored
        crash_write(text: "\u00001B[91m")
    crash_write(text: type_name)
    crash_write(text: ": ")
    crash_write(text: message)
    crash_write(text: "\n")
    danger
        var depth = error.thrown_trace_depth()
        var frames = error.thrown_trace_frames()
        if depth > 0
            var first = frames.stride(count: LLVM::sign_extend[S32, S64](LLVM::bit_and(a: depth -% 1, b: 31))).peek()
            crash_write(text: "at ")
            crash_write_c_text(text: first.file)
            crash_write(text: ":")
            crash_write_number(value: first.line)
            crash_write(text: ":")
            crash_write_number(value: first.column)
            crash_write(text: "\n")
        crash_write_frames(depth: depth, frames: frames)
    crash_write(text: "Thrown again at ")
    if line == 0 and crash_write_library_caller(library: file)
        crash_write(text: "\n")
    else
        crash_write(text: file)
        crash_write(text: ":")
        crash_write_number(value: line)
        crash_write(text: ":")
        crash_write_number(value: column)
        crash_write(text: "\n")
    if colored
        crash_write(text: "\u00001B[0m")
    C::rf_crash_exit()
    return

### Writes where the program called into the standard library a rethrow is written in: the position of the most
### recent frame of the live trace whose file is outside the library's directory (an Agent's error rethrown in the
### library is named by the `retrieve()` call that took it).
### :param library: The standard library's directory.
### :returns: `false` when the trace has no such frame (a build that keeps no trace), and nothing was written.
@untraced
routine crash_write_library_caller(library: Text) -> Bool
    var depth = LLVM::trace_depth()
    if depth <= 0
        return false
    var shown = depth
    if shown > 32
        shown = 32
    danger
        var frames = LLVM::trace_frames()
        var i: S32 = 0
        while i < shown
            var index = LLVM::bit_and(a: depth -% 1 -% i, b: 31)
            var frame = frames.stride(count: LLVM::sign_extend[S32, S64](index)).peek()
            # A frame with no line is a library frame named by the library (Suflae), not by its file.
            if frame.line != 0 and not c_text_starts_with(text: frame.file, prefix: library)
                crash_write_c_text(text: frame.file)
                crash_write(text: ":")
                crash_write_number(value: frame.line)
                crash_write(text: ":")
                crash_write_number(value: frame.column)
                return true
            i = i +% 1
    return false

### Whether a NUL-terminated byte string starts with the UTF-8 bytes of a text.
### :param text: The string.
### :param prefix: The text it may start with.
### :returns: `true` when it does.
@untraced
routine c_text_starts_with(text: Address, prefix: Text) -> Bool
    var at: U64 = 0
    var i: U64 = 0
    while i < prefix.count
        danger
            var code = prefix.data.stride(count: LLVM::reinterpret_bits[U64, S64](i)).peek().codepoint()
            var matched = c_text_code_point_at(text: text, at: at, code: code)
            if matched == 0
                return false
            at = at +% matched
        i = i +% 1
    return true

### Whether a NUL-terminated byte string holds the UTF-8 bytes of one code point at a byte offset.
### :param text: The string.
### :param at: The byte offset.
### :param code: The code point.
### :returns: how many bytes it took, or 0 when the bytes there differ.
@untraced
routine c_text_code_point_at(text: Address, at: U64, code: U32) -> U64
    var count: U64 = 4
    var lead: U32 = 0xF0
    if code <= 0x7F
        count = 1
        lead = 0x00
    elseif code <= 0x7FF
        count = 2
        lead = 0xC0
    elseif code <= 0xFFFF
        count = 3
        lead = 0xE0
    var k: U64 = 0
    while k < count
        var expected = crash_utf8_byte(lead: 0x80, code: code, shift: 6 * LLVM::int_truncate[U64, U32](count -% 1 -% k))
        if k == 0
            expected = crash_utf8_byte(lead: lead, code: code, shift: 6 * LLVM::int_truncate[U64, U32](count -% 1))
        danger
            var actual = Hijacked[Byte](text).stride(count: LLVM::reinterpret_bits[U64, S64](at +% k)).peek()
            if LLVM::reinterpret_bits[Byte, U8](actual) != expected
                return 0
        k = k +% 1
    return count

### Writes the calling thread's crash trace, most recent frame first. Writes nothing when the build keeps no
### trace.
@untraced
routine crash_write_trace()
    crash_write_frames(depth: LLVM::trace_depth(), frames: LLVM::trace_frames())
    return

### Writes a crash trace, most recent frame first: the trace keeps the last 32 frames and says how many there
### were in all when there were more. Writes nothing when the depth is 0 (a build that keeps no trace).
### :param depth: How many frames were pushed in all.
### :param frames: The first of the 32 frames, a ring the depth indexes modulo 32.
@untraced
routine crash_write_frames(depth: S32, frames: Hijacked[TraceFrame])
    if depth <= 0
        return
    crash_write(text: "Stack trace:\n")
    var shown = depth
    if shown > 32
        shown = 32
    var i: S32 = 0
    while i < shown
        # The frames are a ring of 32: the most recent is at (depth - 1) mod 32.
        var index = LLVM::bit_and(a: depth -% 1 -% i, b: 31)
        danger
            var frame = frames.stride(count: LLVM::sign_extend[S32, S64](index)).peek()
            crash_write(text: "  ")
            crash_write_number(value: i)
            crash_write(text: ": at ")
            crash_write_c_text(text: frame.routine_name)
            crash_write(text: " (")
            crash_write_c_text(text: frame.file)
            # A frame with no line names a place, not a file position (the standard library in Suflae).
            if frame.line != 0
                crash_write(text: ":")
                crash_write_number(value: frame.line)
                crash_write(text: ":")
                crash_write_number(value: frame.column)
            crash_write(text: ")\n")
        i = i +% 1
    if depth > 32
        crash_write(text: "  ... (")
        crash_write_number(value: depth)
        crash_write(text: " frames total)\n")
    return

### Writes a text to the error stream as UTF-8, one character at a time.
### :param text: The text to write.
@untraced
routine crash_write(text: Text)
    var i: U64 = 0
    while i < text.count
        danger
            var letter = text.data.stride(count: LLVM::reinterpret_bits[U64, S64](i)).peek()
            crash_write_code_point(code: letter.codepoint())
        i = i +% 1
    return

### Writes one Unicode code point to the error stream as its one to four UTF-8 bytes.
### :param code: The code point.
@untraced
routine crash_write_code_point(code: U32)
    var bytes = Array[Byte, 4]()
    var count: U64 = 1
    if code <= 0x7F
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 0,
            value: LLVM::int_truncate[U32, U8](code),
        )
    elseif code <= 0x7FF
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 0,
            value: crash_utf8_byte(lead: 0xC0, code: code, shift: 6),
        )
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 1,
            value: crash_utf8_byte(lead: 0x80, code: code, shift: 0),
        )
        count = 2
    elseif code <= 0xFFFF
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 0,
            value: crash_utf8_byte(lead: 0xE0, code: code, shift: 12),
        )
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 1,
            value: crash_utf8_byte(lead: 0x80, code: code, shift: 6),
        )
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 2,
            value: crash_utf8_byte(lead: 0x80, code: code, shift: 0),
        )
        count = 3
    else
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 0,
            value: crash_utf8_byte(lead: 0xF0, code: code, shift: 18),
        )
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 1,
            value: crash_utf8_byte(lead: 0x80, code: code, shift: 12),
        )
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 2,
            value: crash_utf8_byte(lead: 0x80, code: code, shift: 6),
        )
        bytes = LLVM::set_byte_at(
            array: bytes,
            index: 3,
            value: crash_utf8_byte(lead: 0x80, code: code, shift: 0),
        )
        count = 4
    danger
        C::rf_console_error(ptr: bytes.hijack().recast_as[Byte](), len: count)
    return

### One UTF-8 byte: the lead bits, then the code point's bits from `shift` up (six of them, or all that
### remain under a lead byte).
### :param lead: The byte's fixed high bits.
### :param code: The code point.
### :param shift: How far the code point is shifted right for this byte.
### :returns: The byte.
@untraced
routine crash_utf8_byte(lead: U32, code: U32, shift: U32) -> U8
    var bits = LLVM::shift_right_unsigned(code, shift)
    if lead == 0x80
        bits = LLVM::bit_and(a: bits, b: 0x3F)
    return LLVM::int_truncate[U32, U8](LLVM::bit_or(a: lead, b: bits))

### Writes a number in decimal to the error stream, with a minus sign when it is negative.
### :param value: The number.
@untraced
routine crash_write_number(value: S32)
    var magnitude = LLVM::reinterpret_bits[S32, U32](value)
    if value < 0
        crash_write(text: "-")
        magnitude = 0 -% magnitude
    var digits = Array[Byte, 10]()
    var position: U64 = 10
    loop
        position = position -% 1
        var digit = LLVM::unsigned_rem(a: magnitude, b: 10)
        digits = LLVM::set_byte_at(
            array: digits,
            index: position,
            value: LLVM::int_truncate[U32, U8](48 +% digit),
        )
        magnitude = LLVM::unsigned_div(a: magnitude, b: 10)
        if magnitude == 0
            break
    danger
        var first = digits
            .hijack()
            .recast_as[Byte]()
            .stride(count: LLVM::reinterpret_bits[U64, S64](position))
        C::rf_console_error(ptr: first, len: 10 -% position)
    return

### Writes a NUL-terminated C string (a trace frame's routine name or file) to the error stream.
### :param text: The address of the string's first byte.
@untraced
routine crash_write_c_text(text: Address)
    danger
        var first = Hijacked[Byte](text)
        var length: U64 = 0
        while LLVM::reinterpret_bits[Byte, U8](
            first.stride(count: LLVM::reinterpret_bits[U64, S64](length)).peek(),
        ) != 0
            length = length +% 1
        C::rf_console_error(ptr: first, len: length)
    return
