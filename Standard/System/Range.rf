module System

import BuilderQuery

### Represents the `Range` record.
### `Range[T]` describes a lazily iterated arithmetic progression between two bounds. The sign of the step sets the
### direction: `1 to 5` counts up, `5 to 1` is empty, and `5 to 1 by -1` counts down.
### :typeparam T: The type argument bound to `T`.
record Range[T]
relates RangeEmitter[T] as Emitter
obeys Emittable[T], Container
needs RecordType T
needs T obeys Comparable, Addable, Subtractable
    ### Stores the first value in the progression.
    start: T
    ### Stores the terminating bound.
    end: T
    ### Stores the step applied between successive values: positive counts up, negative counts down.
    step: T
    ### Stores whether the terminating bound is included.
    inclusive: Bool  # true for 'to', false for 'til'
    ### Stores whether the range counts down by `step`: written with a negative literal step (`by -1`), which keeps
    ### only its magnitude so an unsigned range counts down too. A negative step held in a variable counts down too.
    descending: Bool

# ============================================================================
# Emittable protocol support
# ============================================================================

### Represents the `RangeEmitter` entity.
### `RangeEmitter[T]` holds the mutable iteration state for a `Range[T]`.
### :typeparam T: The type argument bound to `T`.
entity RangeEmitter[T]
obeys Emitter[T]
needs RecordType T
needs T obeys Comparable, Addable, Subtractable
    ### Stores the next value to yield.
    current: T
    ### Stores the terminating bound.
    end: T
    ### Stores the distance between yielded values (the step's magnitude, always positive).
    step: T
    ### Stores whether iteration is moving upward.
    ascending: Bool
    ### Stores whether the terminating bound may be yielded.
    inclusive: Bool
    ### Stores whether iteration has already completed.
    done: Bool
    ### Stores whether `limit` holds: the range's end leaves room for one whole step past it on the side the walk
    ### comes from, so each step is one comparison against `limit`.
    steady: Bool
    ### Stores the value from which one more step still lands inside the range (`end - step` counting up,
    ### `end + step` counting down), when `steady` is true.
    limit: T

### Creates an inclusive range from `start` to `end` using a step of `1`.
### :param start: The inclusive starting position.
### :param end: The terminating bound.
### :returns: The resulting `Range[T]` value.
routine Range[T](start: T, end: T) -> Range[T]
    return Range[T](start: start, end: end, step: 1, inclusive: true, descending: false)

### Creates a range from `start` to `end` using a step of `1`.
### :param start: The inclusive starting position.
### :param end: The terminating bound.
### :param inclusive: `true` to include `end`; `false` to stop before it.
### :returns: The resulting `Range[T]` value.
routine Range[T](start: T, end: T, inclusive: Bool) -> Range[T]
    return Range[T](start: start, end: end, step: 1, inclusive: inclusive, descending: false)

### Returns true if this range counts up: it was not written with a negative step.
### :returns: The resulting `Bool` value.
@readonly
routine Range[T].is_ascending() -> Bool
    return not me.descending and me.step > me.start - me.start

### The distance between successive values: the step's magnitude.
### :returns: The resulting `T` value.
@readonly
routine Range[T].stride() -> T
    if me.step < me.start - me.start
        return me.start - me.start - me.step
    return me.step

### Returns the step component.
### This is the increment used for each successive value.
### :returns: The resulting `T` value.
@readonly
routine Range[T].get_step() -> T
    return me.step

### Returns true if iterating this range yields nothing: counting up, the start is past the end (`2 to 1`),
### counting down, the start is before it (`1 to 2 by -1`), and an exclusive range whose start is its end.
### :returns: The resulting `Bool` value.
@readonly
routine Range[T].is_empty() -> Bool
    if me.is_ascending()
        if me.inclusive
            return me.start > me.end
        return me.start >= me.end
    if me.inclusive
        return me.start < me.end
    return me.start <= me.end

### Returns true if iterating the range would yield `value`: `0 to 10 have 10` is true,
### `0 til 10 have 10` is false, `0 to 10 by 2 have 3` is false, and `2 to 1 have 1` is false (the range is empty).
### Works for ranges that count down too (`10 to 0 by -2 have 4` is true).
### :param value: The value to test.
### :returns: `true` if `value` is within the bounds and on a step from `start`.
@readonly
routine Range[T].has(value: T) -> Bool
needs T obeys FloorDivisible
    me.require_nonzero_step()
    if me.is_ascending()
        if value < me.start
            return false
        if me.inclusive and value > me.end
            return false
        if not me.inclusive and value >= me.end
            return false
        return on_step(value: value, from: me.start, stride: me.stride())
    if value > me.start
        return false
    if me.inclusive and value < me.end
        return false
    if not me.inclusive and value <= me.end
        return false
    return on_step(value: value, from: me.start, stride: me.stride())

### Whether `value` is a whole number of strides from `from`: both leave the same remainder, which never computes the
### distance between them (it may not fit in the type, as from `S64_MIN` to `S64_MAX`).
### :param value: The value to test.
### :param from: The range's start.
### :param stride: The step's magnitude.
### :returns: `true` when the remainders match.
secret routine on_step[T](value: T, from: T, stride: T) -> Bool
needs T obeys FloorDivisible, Comparable
    return value.mod(you: stride) == from.mod(you: stride)

### Returns whether `value` is not in this value: the opposite of `has`.
### :param value: The value to look for.
### :returns: `true` when `value` is absent.
@readonly
routine Range[T].lacks(value: T) -> Bool
needs T obeys FloorDivisible
    return not me.has(value)

### Returns the range as it is written: `0 to 10`, `0 til 10 by 2`, `10 to 0 by -2`. A step of 1 is left out, and a
### range that counts down shows its step with a minus sign.
### :returns: The resulting `Text` value.
@readonly
@override
routine Range[T].represent() -> Text
    var word = "til"
    if me.inclusive
        word = "to"
    var result = f"{nested_repr(me.start)} {word} {nested_repr(me.end)}"
    if me.step == me.start - me.start
        return f"{result} by {nested_repr(me.step)}"
    if not me.is_ascending()
        var stride = me.stride()
        return f"{result} by -{nested_repr(stride)}"
    var one: T = 1
    if me.step != one
        return f"{result} by {nested_repr(me.step)}"
    return result

### Returns the range's diagnostic text: its type around the written form, as `Range[S64](0 til 10 by 2)`.
### :returns: The resulting `Text` value.
@readonly
@override
routine Range[T].diagnose() -> Text
    return f"{me.full_type_name()}({me.represent()})"

### Crashes when the step is zero: it never moves, so the range would never reach its end.
### :throws: {RangeStepZeroError} when `step` is zero.
@readonly
failable routine Range[T].require_nonzero_step()
    if me.step == me.start - me.start
        throw RangeStepZeroError()
    return

### Creates an emitter for this value.
### The emitter starts at `me.start` and moves by the step's magnitude in the step's direction. A step of zero
### crashes here.
### :returns: The resulting `RangeEmitter[T]` value.
@readonly
routine Range[T].emitter() -> RangeEmitter[T]
    me.require_nonzero_step()
    var stride = me.stride()
    var ascending = me.is_ascending()
    var done = me.is_empty()
    # `end - stride` stays inside the type when the end is at least one stride. `end + stride` does when the end is
    # not above zero, or when a stride fits between the end and the start (which is above the end then). In the
    # other ranges each step measures how far the end still is instead.
    var steady = false
    var limit = me.end
    if not done
        if ascending
            if me.end >= stride
                steady = true
                limit = me.end - stride
        elseif me.end <= me.start - me.start or stride <= me.start - me.end
            steady = true
            limit = me.end + stride
    return RangeEmitter[T](
        current: me.start,
        end: me.end,
        step: stride,
        ascending: ascending,
        inclusive: me.inclusive,
        done: done,
        steady: steady,
        limit: limit,
    )

### Returns the step's size for walking the range: its magnitude, after crashing when it is zero. A `for` over a
### range written with `by` asks for it once, before the first round.
### :returns: The resulting `T` value.
@readonly
routine Range[T].walk_stride() -> T
    me.require_nonzero_step()
    return me.stride()

### Returns whether a walk that has reached `value` takes another step: whether one more step of `stride` from
### `value` still lands inside the range. It never steps past the type's own limits to find out.
### :param value: The value the walk has reached.
### :param stride: The step's size, from `walk_stride()`.
### :returns: `true` when another step fits.
@readonly
@inline
routine Range[T].continues_after(value: T, stride: T) -> Bool
    return step_fits(value: value, end: me.end, stride: stride, ascending: me.is_ascending(), inclusive: me.inclusive)

### Returns the value one step of `stride` after `value`, in the range's direction. Call it only after
### `continues_after` said the step fits.
### :param value: The value the walk has reached.
### :param stride: The step's size, from `walk_stride()`.
### :returns: The next value.
@readonly
@inline
routine Range[T].next_after(value: T, stride: T) -> T
    if me.is_ascending()
        return value + stride
    return value - stride

### Returns the next value from this emitter.
### Each successful call yields the current value and advances by `step`.
### :returns: The resulting `T` value.
### :throws: {AbsentValueError} Thrown when the requested value is unavailable.
@inline
failable routine RangeEmitter[T].emit() -> T
    if me.done
        throw AbsentValueError()
    var result = me.current
    if not me.steady
        me.step_measured()
    elseif me.ascending
        if me.current < me.limit or (me.inclusive and me.current == me.limit)
            me.current = me.current + me.step
        else
            me.done = true
    elseif me.current > me.limit or (me.inclusive and me.current == me.limit)
        me.current = me.current - me.step
    else
        me.done = true
    return result

### Takes one step of a walk whose end leaves no room for `limit`: how far the end still is decides whether another
### step fits, and the walk is done when none does.
secret routine RangeEmitter[T].step_measured()
    if step_fits(value: me.current, end: me.end, stride: me.step, ascending: me.ascending, inclusive: me.inclusive)
        if me.ascending
            me.current = me.current + me.step
        else
            me.current = me.current - me.step
    else
        me.done = true
    return

### Returns whether one more step of `stride` from `value` stays inside a range that ends at `end`.
### How far the end still is decides it, before stepping: stepping first would go past the type's own limit at its
### edge (`4 to 0` over `U64` would compute `0 - 1`). The distance itself may not fit in the type when the two ends
### have opposite signs (`S64_MIN to S64_MAX`): then the step is compared from the end instead, which stays in range
### because the step is positive and the end is on the far side of 0.
### :param value: The value the walk has reached.
### :param end: The range's end.
### :param stride: The step's size, always positive.
### :param ascending: `true` when the walk counts up.
### :param inclusive: `true` when the end itself is part of the range.
### :returns: `true` when another step fits.
secret routine step_fits[T](value: T, end: T, stride: T, ascending: Bool, inclusive: Bool) -> Bool
needs T obeys Comparable, Addable, Subtractable
    var zero = value - value
    if ascending
        if value < zero and end >= zero
            var last = end - stride
            return last > value or (inclusive and last == value)
        var room = end - value
        return room > stride or (inclusive and room == stride)
    if value >= zero and end < zero
        var last = end + stride
        return last < value or (inclusive and last == value)
    var room = value - end
    return room > stride or (inclusive and room == stride)
