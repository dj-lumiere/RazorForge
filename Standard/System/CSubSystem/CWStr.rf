module System/CSubSystem

import BuilderQuery

### A wide C string RazorForge made: `wchar_t` code units with a zero unit after them, torn down at the end of its
### scope like any value. The units are UTF-16 on Windows and code points on Linux and macOS, the width of
### {CWChar}. A `CWStr` goes wherever a {CWStrView} goes: C reads it through `view()`, which the builder inserts where
### a `CWStrView` parameter takes a `CWStr`. Passed with `steal`, it goes through `leak()` instead.
### :see: {CWStrView}, {CWChar}
record CWStr
    ### The code units and the zero unit after them, as raw bytes.
    secret bytes: Bytes

### Encodes this text into a new wide C string with a zero unit at the end.
### :returns: The wide C string.
@readonly
routine Text.to[CWStr]() -> CWStr
    var units = wide_units(of: me)
    var n = units.count()
    var size = CWChar.data_size() * (n + 1)
    danger
        var address = rf_allocate_dynamic(size: size)
        var wide = Hijacked[CWChar](address)
        var i: U64 = 0
        until i >= n
            wide.stride(count: i.to[S64]()).poke(value: units[i].to[CWChar]())
            i += 1
        var zero: U32 = 0
        wide.stride(count: n.to[S64]()).poke(value: zero.to[CWChar]())
        return CWStr(bytes: bytes_over(data: Hijacked[Byte](address), count: size.byte_size()))

### The wide C string pointer for C to read. It stays valid while this `CWStr` lives.
### :returns: The pointer.
@readonly
routine CWStr.view() -> CWStrView
    danger
        return CWStrView(from_ptr: Hijacked[CWChar](me.bytes.data.address()))

### Hands this wide C string's memory to C for good: the pointer it returns is never freed by RazorForge. The
### builder calls it for a `CWStr` passed with `steal` where a `CWStrView` goes.
### :returns: The pointer.
routine CWStr.leak() -> CWStrView
    danger
        return CWStrView(from_ptr: Hijacked[CWChar](me.bytes.data.address()))

### The number of code units in this wide C string, without the zero unit.
### :returns: The unit count.
@readonly
routine CWStr.count() -> U64
    return me.bytes.count // CWChar.data_size().byte_size() - 1
