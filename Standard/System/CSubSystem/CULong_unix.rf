@target(os: "linux", "macos")
module System/CSubSystem

### C `unsigned long` under the LP64 data model (Linux, macOS): 64-bit unsigned. The Windows (LLP64,
### 32-bit) width lives in the `#@target(os: "windows")` sibling; conditional compilation loads exactly one.
@llvm("i64")
record CULong
    nothing

### Widens a C `unsigned long` to `U64` (identity on LP64).
@readonly
routine CULong.to[U64]() -> U64
    return LLVM::reinterpret_bits[CULong, U64](me)

### Narrows a `U64` to a C `unsigned long` (identity on LP64).
@readonly
routine U64.to[CULong]() -> CULong
    return LLVM::reinterpret_bits[U64, CULong](me)
