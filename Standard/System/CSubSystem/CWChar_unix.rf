@target(os: "linux", "macos")
module System/CSubSystem

### C `wchar_t` on Unix (Linux, macOS): 32-bit. The Windows width (16-bit) lives in the
### `#@target(os: "windows")` sibling; conditional compilation loads exactly one.
@llvm("i32")
record CWChar
    nothing

### Widens a C `wchar_t` to a `U32` code unit (identity on Unix).
@readonly
routine CWChar.to[U32]() -> U32
    return LLVM::reinterpret_bits[CWChar, U32](me)

### Narrows a `U32` code unit to a C `wchar_t` (identity on Unix).
@readonly
routine U32.to[CWChar]() -> CWChar
    return LLVM::reinterpret_bits[U32, CWChar](me)

### The `wchar_t` units of a text on Linux and macOS: one code point each.
### :param of: The text.
### :returns: The units.
secret routine wide_units(of: Text) -> List[U32]
    var units = List[U32]()
    for c in of
        units.add_last(c.codepoint())
    return units
