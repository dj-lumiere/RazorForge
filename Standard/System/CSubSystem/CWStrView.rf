module System/CSubSystem

import BuilderQuery
### A wide C string pointer, C's `wchar_t*`: code units up to a zero unit, in memory RazorForge never frees.
### {CWChar} is 16 bits on Windows and 32 bits on Linux and macOS. A wide string C returns is a `CWStrView`,
### and a C routine takes its wide string parameters as `CWStrView`, where a {CWStr} goes too.
### :see: {CWStr}, {CWChar}
@llvm("ptr")
record CWStrView
    nothing

### Returns the raw null-terminated wide-character pointer backing this string.
### :returns: The underlying `Hijacked[CWChar]` pointer.
@readonly
routine CWStrView.ptr() -> Hijacked[CWChar]
    return LLVM::reinterpret_bits[CWStrView, Hijacked[CWChar]](me)

### Wraps an existing null-terminated wide-character pointer as `CWStrView`.
### No copy is performed and ownership is not changed.
### :param from_ptr: The pointer to wrap.
### :returns: The resulting `CWStrView` value.
@readonly
routine CWStrView(from_ptr: Hijacked[CWChar]) -> CWStrView
    return LLVM::reinterpret_bits[Hijacked[CWChar], CWStrView](from_ptr)

### The null wide C string, a null `wchar_t*`. A `common routine` and not a `preset`: its value is a
### construction, not a buildtime scalar constant.
### :returns: The null `CWStrView` value.
common routine CWStrView.null() -> CWStrView
    return CWStrView(from_ptr: hijacked_none[CWChar]())

### Returns `true` when this wrapper does not reference any wide C string.
### :returns: The resulting `Bool` value.
@readonly
routine CWStrView.is_null() -> Bool
    return me.ptr().is_none()

### Returns the number of wide characters in this string, excluding the trailing null.
### Walks the buffer up to the null terminator, so the string must end in one.
### :returns: The wide-character count, not including the null terminator.
@readonly
routine CWStrView.count() -> U64
    danger
        var p = me.ptr()
        var n: U64 = 0
        loop
            if p.peek().to[U32]() == 0
                break
            p = p.stride(1)
            n = n + 1
        return n

### Returns `true` when this string is null or has zero length.
### :returns: The resulting `Bool` value.
@readonly
routine CWStrView.is_empty() -> Bool
    return me.is_null() or me.count() == 0

### Returns the wide character at `index` in the referenced string.
### This does not copy the string and assumes the caller stays within bounds.
### :param index: The zero-based position to use.
### :returns: The resulting `CWChar` value.
dangerous routine CWStrView.getitem(index: U64) -> CWChar
    return me
        .ptr()
        .offset(bytes: CWChar.data_size() * index)
        .peek()

### Returns whether both wide strings hold the same code units up to their null terminators.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine CWStrView.eq(you: CWStrView) -> Bool
    danger
        var a = me.ptr()
        var b = you.ptr()
        loop
            var ca = a.peek().to[U32]()
            var cb = b.peek().to[U32]()
            if ca != cb
                return false
            if ca == 0
                return true
            a = a.stride(1)
            b = b.stride(1)

### Compares this wide string with the other lexicographically by code unit.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine CWStrView.compare(you: CWStrView) -> ComparisonSign
    danger
        var a = me.ptr()
        var b = you.ptr()
        loop
            var ca = a.peek().to[U32]()
            var cb = b.peek().to[U32]()
            if ca != cb
                return ca <=> cb
            if ca == 0
                return SAME
            a = a.stride(1)
            b = b.stride(1)

### Returns a `CWStrView` view offset by `n` wide characters into the same underlying buffer.
### :param n: The number of wide characters to skip.
### :returns: The resulting `CWStrView` value.
dangerous routine CWStrView.offset(n: U64) -> CWStrView
    return CWStrView(from_ptr: me.ptr().offset(bytes: CWChar.data_size() * n))
