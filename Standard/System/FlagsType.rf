module System

### Represents the protocol implemented by bitmask-style choice types.
### `FlagsType` is for closed sets of named bits that can be combined into one
### payload and inspected as a single flags value.
protocol FlagsType
obeys Equatable, Hashable
    ### Converts a flags value to its unsigned bitmask representation.
    ### The returned bit pattern uses the declaration-defined flag positions.
    ### :param from: The flags value to convert.
    ### :returns: The resulting `U64` value.
    @readonly
    @innate
    routine U64(from: Me) -> U64

    ### Returns every declared flag case for this type.
    ### The cases are returned in declaration order, not filtered by whether a
    ### specific flags value currently contains them.
    ### :returns: The resulting `List[Me]` value.
    @readonly
    @innate
    routine Me.all_cases() -> List[Me]

    ### Returns the value with all declared flags enabled.
    ### This is the union of every individual declared flag bit.
    ### :returns: The resulting `Me` value.
    @readonly
    @innate
    routine Me.all_on() -> Me

    ### Returns the value with all declared flags disabled.
    ### This is the zero-bitmask identity for the flag type.
    ### :returns: The resulting `Me` value.
    @readonly
    @innate
    routine Me.all_off() -> Me

    ### Returns whether every member of `you` is on in this value: `perms.has(READ)`, `perms.has(READ and WRITE)`.
    ### :param you: The members to look for.
    ### :returns: `true` when all of them are on.
    @readonly
    @innate
    routine Me.has(you: Me) -> Bool

    ### Returns whether at least one member of `you` is on in this value: `perms.has_any(READ and WRITE)`.
    ### :param you: The members to look for.
    ### :returns: `true` when one or more of them are on.
    @readonly
    @innate
    routine Me.has_any(you: Me) -> Bool

    ### Returns whether no member of `you` is on in this value: `perms.lacks(WRITE)`, `perms.lacks(READ and WRITE)`.
    ### :param you: The members to look for.
    ### :returns: `true` when none of them is on.
    @readonly
    @innate
    routine Me.lacks(you: Me) -> Bool

    ### Returns the value with the flags of `you` taken off: `perms.without(WRITE)`.
    ### Flags `you` has and this value lacks change nothing.
    ### :param you: The flags to take off.
    ### :returns: The resulting `Me` value.
    @readonly
    @innate
    routine Me.without(you: Me) -> Me
