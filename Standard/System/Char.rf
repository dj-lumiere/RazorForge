module System

# Unicode constants
preset CHARACTER_NULL: Char = '\0'
preset CHARACTER_SPACE: Char = ' '
preset CHARACTER_NEWLINE: Char = '\n'
preset CHARACTER_TAB: Char = '\t'
preset CHARACTER_REPLACEMENT: Char = '\u00FFFD'
preset CHARACTER_MAX_UNICODE: Char = '\u10FFFF'
# Surrogate range (invalid for standalone codepoints)
preset CHARACTER_SURROGATE_START: U32 = 0xD800
preset CHARACTER_SURROGATE_END: U32 = 0xDFFF

### Represents one Unicode scalar value.
### `Char` stores a code point-sized payload and models text characters
### rather than arbitrary binary bytes.
@llvm("i32")
record Char
obeys ConstCompatible, Comparable, Copyable, StorageCell
    nothing

# Creators

### The character whose codepoint is `n`: `Char.from_codepoint(n: 0x41)` is `'A'`.
### :param n: The codepoint.
### :returns: The character.
### :throws: Throws {InvalidValueError} when `n` is no Unicode scalar: a surrogate (0xD800 to 0xDFFF) or above 0x10FFFF.
failable common routine Char.from_codepoint(n: U32) -> Char
    if n > 0x10FFFF or CHARACTER_SURROGATE_START <= n <= CHARACTER_SURROGATE_END
        throw InvalidValueError(input: n.represent(), target: "Char")
    return LLVM::reinterpret_bits[U32, Char](value: n)

### Builds the character a character literal (`'A'`) stands for from its codepoint.
### :param from: The codepoint.
### :returns: The character.
secret routine Char(from: U32) -> Char
    return LLVM::reinterpret_bits[U32, Char](value: from)

# ============================================================================
# Char protocol implementation
# ============================================================================

### Returns the Unicode scalar value stored by this character: `'A'.codepoint()` is 0x41. Another integer type is
### converted from it: `c.codepoint().to[U64]()`.
### :returns: The codepoint as a `U32`.
@readonly
routine Char.codepoint() -> U32
    return LLVM::reinterpret_bits[Char, U32](value: me)

### Whether this character can be kept in a storage cell: whether it is a Unicode scalar (`is_valid()`).
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_valid_cell() -> Bool
    return me.is_valid()

### Returns `true` when this value is a valid Unicode scalar value.
### Surrogate code points are treated as invalid standalone characters.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_valid() -> Bool
    var cp = me.codepoint()
    # Valid if within Unicode range and not a surrogate
    return cp <= 0x10FFFF and not (CHARACTER_SURROGATE_START <= cp <= CHARACTER_SURROGATE_END)

### Returns `true` when this character is in the ASCII subset.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_ascii() -> Bool
    return me.codepoint() <= 0x007F

### Returns `true` when this character falls in the supported alphabetic ranges.
### This implementation currently focuses on ASCII and common Latin blocks.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_alphabetic() -> Bool
    var v = me.codepoint()
    var is_ascii_upper = 0x0041 <= v <= 0x005A
    var is_ascii_lower = 0x0061 <= v <= 0x007A
    var is_latin_ext = 0x00C0 <= v <= 0x00FF
    var is_latin_ext_a = 0x0100 <= v <= 0x017F
    var is_latin_ext_b = 0x0180 <= v <= 0x024F
    return is_ascii_upper or is_ascii_lower or is_latin_ext or is_latin_ext_a or is_latin_ext_b

### Returns `true` when this character is an ASCII decimal digit.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_numeric() -> Bool
    var v = me.codepoint()
    return 0x0030 <= v <= 0x0039  # 0-9

### Returns `true` when this character is alphabetic or numeric.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_alphanumeric() -> Bool
    return me.is_alphabetic() or me.is_numeric()

### Returns `true` when this character is an uppercase letter (Unicode category Lu): `A`, `É`, `Σ`.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_uppercase() -> Bool
    var v = me.codepoint()
    if v < 0x80
        return 0x0041 <= v <= 0x005A
    return unicode_is_uppercase(cp: v.to[S64]())

### Returns `true` when this character is a lowercase letter (Unicode category Ll): `a`, `é`, `σ`.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_lowercase() -> Bool
    var v = me.codepoint()
    if v < 0x80
        return 0x0061 <= v <= 0x007A
    return unicode_is_lowercase(cp: v.to[S64]())

### Returns `true` when this character is one of the supported whitespace code
### points.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_whitespace() -> Bool
    var v = me.codepoint()
    var is_space = v == 0x0020
    var is_tab = v == 0x0009
    var is_lf = v == 0x000A
    var is_cr = v == 0x000D
    var is_ff = v == 0x000C
    var is_nbsp = v == 0x00A0
    var is_en_quad = v == 0x2000
    var is_em_quad = v == 0x2001
    var is_en_space = v == 0x2002
    var is_em_space = v == 0x2003
    return is_space
        or is_tab
        or is_lf
        or is_cr
        or is_ff
        or is_nbsp
        or is_en_quad
        or is_em_quad
        or is_en_space
        or is_em_space

### Returns `true` when this character is an ASCII or Latin-1 control code.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_control() -> Bool
    var v = me.codepoint()
    return v <= 0x001F or 0x007F <= v <= 0x009F

### Returns this character's uppercase form by the Unicode simple case mapping (`é` gives `É`, `σ` gives `Σ`), or
### the character itself when it has none. Each character maps to one character, so `ß` stays `ß`.
### :returns: The resulting `Char` value.
@readonly
routine Char.to_uppercase() -> Char
    var v = me.codepoint()
    if v < 0x80
        return if 0x0061 <= v <= 0x007A then Char(v - 32) else me
    return Char(unicode_uppercase(cp: v.to[S64]()).to[U32]())

### Returns this character's lowercase form by the Unicode simple case mapping (`É` gives `é`, `Σ` gives `σ`), or
### the character itself when it has none.
### :returns: The resulting `Char` value.
@readonly
routine Char.to_lowercase() -> Char
    var v = me.codepoint()
    if v < 0x80
        return if 0x0041 <= v <= 0x005A then Char(v + 32) else me
    return Char(unicode_lowercase(cp: v.to[S64]()).to[U32]())

# ============================================================================
# Comparison operations
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Char.eq(you: Char) -> Bool
    return me.codepoint() == you.codepoint()

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine Char.compare(you: Char) -> ComparisonSign
    return me.codepoint() <=> you.codepoint()

# ============================================================================
# Type conversions
# ============================================================================

### The byte an ASCII character is in UTF-8: `'A'.to_byte()` is `b'A'`.
### :returns: The byte.
### :throws: Throws {InvalidValueError} when this character is not ASCII: its UTF-8 form is more than one byte.
@readonly
failable routine Char.to_byte() -> Byte
    var cp = me.codepoint()
    if cp > 0x7F
        throw InvalidValueError(input: me.represent(), target: "Byte")
    return Byte(cp.to[U8]())

# ============================================================================
# Display — shows the character itself
# ============================================================================

### Returns the display form of this character.
### The display form emits the character itself rather than its numeric code.
### :returns: The resulting `Text` value.
@readonly
@override
routine Char.represent() -> Text
    var list = List[Char]()
    list.add_last(me)
    return Text(from_list: list)

### Returns the diagnostic form of this character.
### The diagnostic form includes both the printable character and its numeric
### code point.
### :returns: The resulting `Text` value.
@readonly
@override
routine Char.diagnose() -> Text
    return "Char(" + me.represent() + ", " + me.codepoint().represent() + ")"

# ============================================================================
# Utility methods
# ============================================================================

### Returns `true` when this character is a decimal digit.
### This is an alias for `is_numeric`.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_digit() -> Bool
    return me.is_numeric()

### The value of this character as an ASCII digit: `'7'.digit_value()` is 7. Only `0` to `9` are digits, and with
### `base: 16` also `a` to `f` and `A` to `F` (10 to 15). A digit must be below `base`: `'9'.digit_value(base: 8)`
### throws.
### :param base: The base the digit is read in, 2 to 16.
### :returns: The digit's value.
### :throws: Throws {InvalidDigitError} when this character is not a digit of `base`.
@readonly
failable routine Char.digit_value(base: U8 = 10) -> U8
    var cp = me.codepoint()
    var value: U32 = 16
    if 0x30 <= cp <= 0x39
        value = cp - 0x30
    elseif 0x61 <= cp <= 0x66
        value = cp - 0x57
    elseif 0x41 <= cp <= 0x46
        value = cp - 0x37
    if base < 2 or base > 16 or value >= base.to[U32]()
        throw InvalidDigitError()
    return value.to[U8]()

### Returns `true` when this character is valid and not a control code.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_printable() -> Bool
    return me.is_valid() and not me.is_control()

### Returns `true` when this character is in the Basic Multilingual Plane.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_bmp() -> Bool
    # Basic Multilingual Plane: U+0000 to U+FFFF (excluding surrogates)
    return me.codepoint() <= 0xFFFF
        and not (CHARACTER_SURROGATE_START <= me.codepoint() <= CHARACTER_SURROGATE_END)

### Returns `true` when this character is in one of the Unicode supplementary
### planes.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_supplementary() -> Bool
    # Supplementary planes: U+10000 to U+10FFFF
    return 0x10000 <= me.codepoint() <= 0x10FFFF

### Returns `true` when this character falls in the supported CJK ranges.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_cjk() -> Bool
    var v = me.codepoint()
    var is_unified = 0x4E00 <= v <= 0x9FFF
    var is_ext_a = 0x3400 <= v <= 0x4DBF
    var is_ext_b = 0x20000 <= v <= 0x2A6DF
    var is_ext_c = 0x2A700 <= v <= 0x2B73F
    return is_unified or is_ext_a or is_ext_b or is_ext_c

### Returns `true` when this character falls in the supported Latin ranges.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_latin() -> Bool
    var v = me.codepoint()
    var is_basic = 0x0000 <= v <= 0x007F
    var is_supplement = 0x0080 <= v <= 0x00FF
    var is_ext_a = 0x0100 <= v <= 0x017F
    var is_ext_b = 0x0180 <= v <= 0x024F
    return is_basic or is_supplement or is_ext_a or is_ext_b

### Returns `true` when this character falls in one of the supported emoji
### blocks.
### :returns: The resulting `Bool` value.
@readonly
routine Char.is_emoji() -> Bool
    var v = me.codepoint()
    var is_emoticons = 0x1F600 <= v <= 0x1F64F
    var is_misc = 0x1F300 <= v <= 0x1F5FF
    var is_transport = 0x1F680 <= v <= 0x1F6FF
    var is_flags = 0x1F1E0 <= v <= 0x1F1FF
    return is_emoticons or is_misc or is_transport or is_flags

# ============================================================================
# Codepoint offset
# ============================================================================

### Returns the character `delta` code points away from this one.
### :param delta: The amount to add or subtract.
### :returns: The resulting `Char` value.
### :throws: Throws {InvalidValueError} when the result is no Unicode scalar, and {IntegerOverflowError} when it is
###     below 0.
@readonly
failable routine Char.offset(delta: S64) -> Char
    var new_value = me.codepoint().to[S64]() + delta
    return Char.from_codepoint(n: new_value.to[U32]())
