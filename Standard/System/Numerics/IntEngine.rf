module System/Numerics

# The arbitrary-precision integer engine behind {Int}, built on the 64-bit limb layer of the libbf
# port in LimbEngine.rf (limbs_add / limbs_sub / limbs_mul with its NTT path / limbs_divmod / limbs_sqrt_rem). Division
# is Euclidean (the remainder is always in [0, |b|)). AND / OR / XOR act on the infinite two's-complement
# form, a right shift moves the magnitude and keeps the sign, and text uses the digit map 0-9 A-Z a-z + /
# (letters case-insensitive up to radix 36).
#
# The integer semantics and algorithms (Euclidean division, binary GCD, two's-complement bitwise ops,
# radix text with its digit map) follow LibTomMath (The Unlicense), which this engine replaced. See
# THIRD-PARTY-NOTICES.md.
#
# This engine runs in Ingrid: `RazorForge export-ingrid` writes it, with the routines of IngridExport/numerics.rf
# that call it, to Ingrid/tessera/generated/numerics.te, and {Int} calls those exports. Memory: the engine
# allocates nothing. A result goes into a buffer its caller hands over (the `_into` routines), and every
# temporary comes from the call's scratch arena (Ingrid/tessera/scratch.te), the buffer the caller hands over
# for it. An operation that takes limbs first asks the arena to admit the most it takes: when that doesn't fit,
# it returns zero, and the call reports the room it needed so that the caller retries with a larger buffer.

# An engine integer in sign-magnitude form. `tab` holds `len` little-endian limbs with a nonzero top
# limb. Zero has len 0 and is never negative.
record IntV
obeys Copyable
    neg: Bool
    len: U64
    tab: Hijacked[U64]

secret routine bigint_zero() -> IntV
    danger
        return IntV(neg: false, len: 0, tab: Hijacked[U64].hollow())

# Wraps `len` limbs of `tab`, dropping high zero limbs (a zero result is non-negative).
secret dangerous routine bigint_make(neg: Bool, tab: Hijacked[U64], len: U64) -> IntV
    var n = len
    until n == 0 or limb(tab: tab, i: n -% 1) != 0
        n = n -% 1
    if n == 0
        return bigint_zero()
    return IntV(neg: neg, len: n, tab: tab)

# `a` with its sign replaced (zero stays non-negative).
secret routine bigint_with_sign(a: IntV, neg: Bool) -> IntV
    if a.len == 0
        return a
    return IntV(neg: neg, len: a.len, tab: a.tab)

secret routine bigint_from_u64(v: U64, neg: Bool) -> IntV
    danger
        if v == 0 or not scratch_admit(limbs: 1)
            return bigint_zero()
        var tab = alloc_limbs(n: 1)
        set_limb(tab: tab, i: 0, value: v)
        return IntV(neg: neg, len: 1, tab: tab)

# -1 / 0 / 1 comparing magnitudes.
secret routine bigint_cmp_mag(a: IntV, b: IntV) -> S64
    danger
        if a.len != b.len
            return if a.len < b.len then -1 else 1
        if a.len == 0
            return 0
        return limbs_cmp(a: a.tab, b: b.tab, n: a.len)

# -1 / 0 / 1 comparing values.
secret routine bigint_cmp(a: IntV, b: IntV) -> S64
    if a.neg != b.neg
        return if a.neg then -1 else 1
    var c = bigint_cmp_mag(a: a, b: b)
    return if a.neg then 0 -% c else c
# |a| + |b| written into `r` (at least max(a.len, b.len) + 1 limbs), carrying the sign `neg`.
secret dangerous routine bigint_add_mag_into(a: IntV, b: IntV, neg: Bool, r: Hijacked[U64]) -> IntV
    var x = a
    var y = b
    if x.len < y.len
        x = b
        y = a
    var carry: U64 = 0
    if y.len > 0
        carry = limbs_add(res: r, op1: x.tab, op2: y.tab, n: y.len, carry: 0)
    var i = y.len
    until i >= x.len
        var v = limb(tab: x.tab, i: i) +% carry
        carry = if v < carry then 1 else 0
        set_limb(tab: r, i: i, value: v)
        i = i +% 1
    set_limb(tab: r, i: x.len, value: carry)
    return bigint_make(neg: neg, tab: r, len: x.len +% 1)

# |a| - |b| written into `r` (at least a.len limbs), carrying the sign `neg`. Requires |a| >= |b|.
secret dangerous routine bigint_sub_mag_into(a: IntV, b: IntV, neg: Bool, r: Hijacked[U64]) -> IntV
    if a.len == 0
        return bigint_zero()
    var borrow: U64 = 0
    if b.len > 0
        borrow = limbs_sub(res: r, op1: a.tab, op2: b.tab, n: b.len, borrow_in: 0)
    var i = b.len
    until i >= a.len
        var v = limb(tab: a.tab, i: i)
        set_limb(tab: r, i: i, value: v -% borrow)
        borrow = if v < borrow then 1 else 0
        i = i +% 1
    return bigint_make(neg: neg, tab: r, len: a.len)

# The limbs `a + b` needs as an output buffer for `bigint_add_into`.
secret routine bigint_add_capacity(a: IntV, b: IntV) -> U64
    var longer = if a.len > b.len then a.len else b.len
    return longer +% 1

# a + b written into `r` (at least `bigint_add_capacity(a, b)` limbs). The result's limbs are `r`
# unless it is zero.
secret dangerous routine bigint_add_into(a: IntV, b: IntV, r: Hijacked[U64]) -> IntV
    if a.neg == b.neg
        return bigint_add_mag_into(a: a, b: b, neg: a.neg, r: r)
    if bigint_cmp_mag(a: a, b: b) >= 0
        return bigint_sub_mag_into(a: a, b: b, neg: a.neg, r: r)
    return bigint_sub_mag_into(a: b, b: a, neg: b.neg, r: r)

# |a| + |b| carrying the sign `neg`.
secret routine bigint_add_mag(a: IntV, b: IntV, neg: Bool) -> IntV
    danger
        var n = bigint_add_capacity(a: a, b: b)
        if not scratch_admit(limbs: n)
            return bigint_zero()
        return bigint_add_mag_into(a: a, b: b, neg: neg, r: alloc_limbs(n: n))

# |a| - |b| carrying the sign `neg`. Requires |a| >= |b|.
secret routine bigint_sub_mag(a: IntV, b: IntV, neg: Bool) -> IntV
    danger
        if not scratch_admit(limbs: a.len)
            return bigint_zero()
        return bigint_sub_mag_into(a: a, b: b, neg: neg, r: alloc_limbs(n: a.len))

secret routine bigint_neg(a: IntV) -> IntV
    return bigint_with_sign(a: a, neg: not a.neg)

secret routine bigint_abs(a: IntV) -> IntV
    return bigint_with_sign(a: a, neg: false)

secret routine bigint_add(a: IntV, b: IntV) -> IntV
    danger
        var n = bigint_add_capacity(a: a, b: b)
        if not scratch_admit(limbs: n)
            return bigint_zero()
        return bigint_add_into(a: a, b: b, r: alloc_limbs(n: n))

secret routine bigint_sub(a: IntV, b: IntV) -> IntV
    return bigint_add(a: a, b: bigint_neg(a: b))

# a * b (schoolbook below 100 limbs of the smaller factor, NTT above).
secret routine bigint_mul(a: IntV, b: IntV) -> IntV
    danger
        if a.len == 0 or b.len == 0
            return bigint_zero()
        var n = a.len +% b.len
        if not scratch_admit(limbs: n +% limbs_mul_scratch(op1_size: a.len, op2_size: b.len))
            return bigint_zero()
        var r = alloc_limbs(n: n)
        limbs_mul(result: r, op1: a.tab, op1_size: a.len, op2: b.tab, op2_size: b.len)
        return bigint_make(neg: a.neg != b.neg, tab: r, len: n)

# (|a| / |b|, |a| mod |b|) as non-negative values. `b` is nonzero.
secret routine bigint_divmod_mag(a: IntV, b: IntV) -> (IntV, IntV)
    danger
        if bigint_cmp_mag(a: a, b: b) < 0
            return (bigint_zero(), bigint_abs(a: a))
        var nq = a.len -% b.len +% 1
        if not scratch_admit(limbs: nq +% b.len +% limbs_divmod_scratch(na: a.len, nb: b.len))
            return (bigint_zero(), bigint_zero())
        var q = alloc_limbs(n: nq)
        var r = alloc_limbs(n: b.len)
        limbs_divmod(q: q, r: r, a: a.tab, na: a.len, b: b.tab, nb: b.len)
        return (
            bigint_make(neg: false, tab: q, len: nq), bigint_make(neg: false, tab: r, len: b.len),
        )

# Euclidean division: a = b*q + r with 0 <= r < |b|. `b` is nonzero.
# From the magnitudes, q starts as the truncated quotient. When a is negative and the remainder is
# nonzero, the remainder becomes |b| - r and q moves one step away from zero.
secret routine bigint_divmod(a: IntV, b: IntV) -> (IntV, IntV)
    var qr = bigint_divmod_mag(a: a, b: b)
    var q = qr.item0
    var r = qr.item1
    if a.neg and r.len != 0
        q = bigint_add_mag(a: q, b: bigint_from_u64(v: 1, neg: false), neg: false)
        r = bigint_sub_mag(a: bigint_abs(a: b), b: r, neg: false)
    return (bigint_with_sign(a: q, neg: a.neg != b.neg), r)

# The limbs `a << bits` needs as an output buffer for `bigint_shl_into`.
secret routine bigint_shl_capacity(a: IntV, bits: U64) -> U64
    return a.len +% bits // 64 +% 1

# a * 2^bits written into `r` (at least `bigint_shl_capacity(a, bits)` limbs).
secret dangerous routine bigint_shl_into(a: IntV, bits: U64, r: Hijacked[U64]) -> IntV
    if a.len == 0
        return a
    var limb_shift = bits // 64
    var n = a.len +% limb_shift +% 1
    zero_limbs(tab: r, n: limb_shift)
    var carry = limbs_shl(
        dst: r.stride(count: limb_shift.to[S64]()),
        src: a.tab,
        n: a.len,
        shift: bits % 64,
    )
    set_limb(tab: r, i: limb_shift +% a.len, value: carry)
    return bigint_make(neg: a.neg, tab: r, len: n)

# a * 2^bits.
secret routine bigint_shl(a: IntV, bits: U64) -> IntV
    danger
        if a.len == 0 or bits == 0
            return a
        var n = bigint_shl_capacity(a: a, bits: bits)
        if not scratch_admit(limbs: n)
            return bigint_zero()
        return bigint_shl_into(a: a, bits: bits, r: alloc_limbs(n: n))

# The limbs `a >> bits` needs as an output buffer for `bigint_shr_into` (one more than the shifted
# magnitude, for the carry when a negative value rounds its magnitude up).
secret routine bigint_shr_capacity(a: IntV, bits: U64) -> U64
    var limb_shift = bits // 64
    if limb_shift >= a.len
        return 1
    return a.len -% limb_shift +% 1

# floor(a / 2^bits), the arithmetic right shift of the two's-complement form (so -5 >> 1 is -3), written
# into `r` (at least `bigint_shr_capacity(a, bits)` limbs).
secret dangerous routine bigint_shr_into(a: IntV, bits: U64, r: Hijacked[U64]) -> IntV
    var q = bigint_shr_mag_into(a: a, bits: bits, r: r)
    if a.neg and limbs_ctz(tab: a.tab, n: a.len) < bits
        # a negative value lost nonzero bits: round its magnitude up
        var n = q.len
        if n == 0
            set_limb(tab: r, i: 0, value: 1)
            return IntV(neg: true, len: 1, tab: r)
        set_limb(tab: r, i: n, value: limbs_add_word(tab: r, b: 1, n: n))
        return bigint_make(neg: true, tab: r, len: n +% 1)
    return q

# The magnitude shifted right by `bits`, keeping the sign (truncates toward zero), written into `r` (at
# least a.len - bits / 64 limbs when that is positive).
secret dangerous routine bigint_shr_mag_into(a: IntV, bits: U64, r: Hijacked[U64]) -> IntV
    var limb_shift = bits // 64
    if limb_shift >= a.len
        return bigint_zero()
    var n = a.len -% limb_shift
    var src = a.tab.stride(count: limb_shift.to[S64]())
    var bit_shift = bits % 64
    if bit_shift == 0
        var i: U64 = 0
        until i >= n
            set_limb(tab: r, i: i, value: limb(tab: src, i: i))
            i = i +% 1
    else
        drop limbs_shr(tab_r: r, tab: src, n: n, shift: bit_shift.to[U32](), high: 0)
    return bigint_make(neg: a.neg, tab: r, len: n)

# The magnitude shifted right by `bits`, keeping the sign (truncates toward zero).
secret routine bigint_shr_mag(a: IntV, bits: U64) -> IntV
    danger
        var limb_shift = bits // 64
        if limb_shift >= a.len
            return bigint_zero()
        if not scratch_admit(limbs: a.len -% limb_shift)
            return bigint_zero()
        return bigint_shr_mag_into(a: a, bits: bits, r: alloc_limbs(n: a.len -% limb_shift))

# The limbs a bitwise operation of `a` and `b` needs as an output buffer for `bigint_bitop_into`.
secret routine bigint_bitop_capacity(a: IntV, b: IntV) -> U64
    var longer = if a.len > b.len then a.len else b.len
    return longer +% 1

# Bitwise AND (op 0), OR (op 1) or XOR (op 2) over the infinite two's-complement forms, written into `r`
# (at least `bigint_bitop_capacity(a, b)` limbs).
secret dangerous routine bigint_bitop_into(a: IntV, b: IntV, op: U32, r: Hijacked[U64]) -> IntV
    var w = bigint_bitop_capacity(a: a, b: b)
    var neg_r = false
    if op == 0
        neg_r = a.neg and b.neg
    elseif op == 1
        neg_r = a.neg or b.neg
    else
        neg_r = a.neg != b.neg
    var ac: U64 = 1
    var bc: U64 = 1
    var cc: U64 = 1
    var i: U64 = 0
    until i >= w
        var x = if i < a.len then limb(tab: a.tab, i: i) else 0
        if a.neg
            x = (x ^ 0xFFFFFFFFFFFFFFFF) +% ac
            ac = if x < ac then 1 else 0
        var y = if i < b.len then limb(tab: b.tab, i: i) else 0
        if b.neg
            y = (y ^ 0xFFFFFFFFFFFFFFFF) +% bc
            bc = if y < bc then 1 else 0
        var c: U64 = 0
        if op == 0
            c = x & y
        elseif op == 1
            c = x | y
        else
            c = x ^ y
        if neg_r
            c = (c ^ 0xFFFFFFFFFFFFFFFF) +% cc
            cc = if c < cc then 1 else 0
        set_limb(tab: r, i: i, value: c)
        i = i +% 1
    return bigint_make(neg: neg_r, tab: r, len: w)

# a^e by square and multiply (0^0 = 1).
secret routine bigint_pow(a: IntV, e: U64) -> IntV
    var result = bigint_from_u64(v: 1, neg: false)
    var base = a
    var ee = e
    until ee == 0
        if (ee & 1) != 0
            result = bigint_mul(a: result, b: base)
        ee = ee >> 1
        if ee > 0
            base = bigint_mul(a: base, b: base)
    return result

# floor(sqrt(a)). `a` is non-negative ({Int.sqrt} rejects a negative value before calling this).
# Shifts `a` left by an even amount so the 2n-limb square root sees a top limb >= 2^62, then shifts the
# root back by half.
secret routine bigint_isqrt(a: IntV) -> IntV
    danger
        if a.neg or a.len == 0
            return bigint_zero()
        var n = (a.len +% 1) // 2
        if not scratch_admit(limbs: 4 *% n +% limbs_sqrt_rem_scratch(n: n))
            return bigint_zero()
        var lz = LLVM::leading_zeros(
            limb(tab: a.tab, i: a.len -% 1),
        ) +% (2 *% n -% a.len) *% 64
        var sh = lz -% lz % 2
        var buf = alloc_limbs(n: 2 *% n)
        var limb_shift = sh // 64
        var carry = limbs_shl(
            dst: buf.stride(count: limb_shift.to[S64]()),
            src: a.tab,
            n: a.len,
            shift: sh % 64,
        )
        if limb_shift +% a.len < 2 *% n
            set_limb(tab: buf, i: limb_shift +% a.len, value: carry)
        var s = alloc_limbs(n: n)
        drop limbs_sqrt_rem(tabs: s, taba: buf, n: n)
        return bigint_shr_mag(a: bigint_make(neg: false, tab: s, len: n), bits: sh // 2)

# gcd(|a|, |b|), with gcd(0, 0) = 0. Euclid remainder steps while one operand is much longer than the
# other, then the binary GCD on balanced sizes.
secret routine bigint_gcd(a: IntV, b: IntV) -> IntV
    var x = bigint_abs(a: a)
    var y = bigint_abs(a: b)
    # Euclid steps while one side is much longer, so the binary loop starts on balanced sizes
    until x.len == 0 or y.len == 0 or (x.len <= y.len +% 1 and y.len <= x.len +% 1)
        if x.len > y.len
            x = bigint_divmod_mag(a: x, b: y).item1
        else
            y = bigint_divmod_mag(a: y, b: x).item1
    if x.len == 0
        return y
    if y.len == 0
        return x
    return bigint_gcd_binary(x: x, y: y)

# gcd(x, y) of two nonzero magnitudes by the binary method, in place on scratch copies.
secret routine bigint_gcd_binary(x: IntV, y: IntV) -> IntV
    danger
        var ul = x.len
        var vl = y.len
        var longer = if ul > vl then ul else vl
        # the copies, then the result shifted back by the common power of two (below 64 * longer bits)
        if not scratch_admit(limbs: ul +% vl +% 2 *% longer +% 1)
            return bigint_zero()
        var u = alloc_limbs(n: ul)
        var v = alloc_limbs(n: vl)
        limbs_copy(dst: u, src: x.tab, n: ul)
        limbs_copy(dst: v, src: y.tab, n: vl)
        var tu = limbs_ctz(tab: u, n: ul)
        var tv = limbs_ctz(tab: v, n: vl)
        var k = if tu < tv then tu else tv
        ul = limbs_shr_in_place(tab: u, n: ul, bits: tu)
        vl = limbs_shr_in_place(tab: v, n: vl, bits: tv)
        loop
            # u and v are odd here: keep u <= v, then v = v - u (even), then strip v's trailing zeros
            if ul == 1 and vl == 1
                set_limb(
                    tab: u,
                    i: 0,
                    value: gcd_u64(a: limb(tab: u, i: 0), b: limb(tab: v, i: 0)),
                )
                break
            else
                if ul > vl or (ul == vl and limbs_cmp(a: u, b: v, n: ul) > 0)
                    var t = u
                    u = v
                    v = t
                    var tl = ul
                    ul = vl
                    vl = tl
                vl = limbs_sub_in_place(a: v, na: vl, b: u, nb: ul)
                if vl == 0
                    break
                else
                    vl = limbs_shr_in_place(tab: v, n: vl, bits: limbs_ctz(tab: v, n: vl))
        return bigint_shl(a: bigint_make(neg: false, tab: u, len: ul), bits: k)

# gcd of two words by the binary method (gcd(0, b) = b).
secret routine gcd_u64(a: U64, b: U64) -> U64
    if a == 0
        return b
    if b == 0
        return a
    var k = LLVM::trailing_zeros(value: a | b)
    var x = a >> (LLVM::trailing_zeros(value: a)).to[U32]()
    var y = b
    until y == 0
        y = y >> (LLVM::trailing_zeros(value: y)).to[U32]()
        if x > y
            var t = x
            x = y
            y = t
        y = y -% x
    return x << k.to[U32]()

# dst[0..n) = src[0..n).
secret dangerous routine limbs_copy(dst: Hijacked[U64], src: Hijacked[U64], n: U64)
    var i: U64 = 0
    until i >= n
        set_limb(tab: dst, i: i, value: limb(tab: src, i: i))
        i = i +% 1
    return

# Trailing zero bits of a nonzero n-limb number.
secret dangerous routine limbs_ctz(tab: Hijacked[U64], n: U64) -> U64
    var i: U64 = 0
    until i >= n
        var v = limb(tab: tab, i: i)
        if v != 0
            return i *% 64 +% LLVM::trailing_zeros(value: v)
        i = i +% 1
    return n *% 64

# tab[0..n) >>= bits in place. Returns the trimmed length.
secret dangerous routine limbs_shr_in_place(tab: Hijacked[U64], n: U64, bits: U64) -> U64
    var limb_shift = bits // 64
    if limb_shift >= n
        return 0
    var m = n -% limb_shift
    if limb_shift > 0
        var i: U64 = 0
        until i >= m
            set_limb(tab: tab, i: i, value: limb(tab: tab, i: i +% limb_shift))
            i = i +% 1
    var bit_shift = bits % 64
    if bit_shift != 0
        drop limbs_shr(tab_r: tab, tab: tab, n: m, shift: bit_shift.to[U32](), high: 0)
    until m == 0 or limb(tab: tab, i: m -% 1) != 0
        m = m -% 1
    return m

# a[0..na) -= b[0..nb) in place, for a >= b. Returns the trimmed length.
secret dangerous routine limbs_sub_in_place(
    a: Hijacked[U64],
    na: U64,
    b: Hijacked[U64],
    nb: U64,
) -> U64
    var borrow = limbs_sub(res: a, op1: a, op2: b, n: nb, borrow_in: 0)
    var i = nb
    until borrow == 0 or i >= na
        var v = limb(tab: a, i: i)
        set_limb(tab: a, i: i, value: v -% borrow)
        borrow = if v < borrow then 1 else 0
        i = i +% 1
    var m = na
    until m == 0 or limb(tab: a, i: m -% 1) != 0
        m = m -% 1
    return m

# lcm(|a|, |b|), 0 when either is 0.
secret routine bigint_lcm(a: IntV, b: IntV) -> IntV
    if a.len == 0 or b.len == 0
        return bigint_zero()
    var g = bigint_gcd(a: a, b: b)
    if g.len == 0
        # an exhausted call: the gcd of two nonzero values is never zero
        return bigint_zero()
    return bigint_mul(a: bigint_divmod_mag(a: bigint_abs(a: a), b: g).item0, b: bigint_abs(a: b))

# ── text ────────────────────────────────────────────────────────────────────────────────────────────

# tabr[0..n) = taba / b for any nonzero word b, returning the remainder.
secret dangerous routine limbs_divmod_word_any(
    tabr: Hijacked[U64],
    taba: Hijacked[U64],
    n: U64,
    b: U64,
) -> U64
    var r: U64 = 0
    var bb = b.to[U128]()
    var i = n
    until i == 0
        i = i -% 1
        var cur = (r.to[U128]() << 64) | limb(tab: taba, i: i).to[U128]()
        var q = cur // bb
        r = u128_lo(t: cur -% q *% bb)
        set_limb(tab: tabr, i: i, value: u128_lo(t: q))
    return r

# The digit map for radices up to 64: 0-9, A-Z, a-z, '+', '/'.
secret routine bigint_digit_char(d: U64) -> Char
    var cp: U32 = 0
    if d < 10
        cp = 48 +% d.to[U32]()
    elseif d < 36
        cp = 55 +% d.to[U32]()
    elseif d < 62
        cp = 61 +% d.to[U32]()
    elseif d == 62
        cp = 43
    else
        cp = 47
    return Char.from_codepoint(n: cp)

# The digit value of a codepoint in `radix` under the digit map (letters case-insensitive up to
# radix 36), or 255 when it is not a digit of the map.
secret routine bigint_digit_value(cp: U32, radix: U64) -> U64
    var c = cp
    if radix <= 36 and c >= 97 and c <= 122
        c = c -% 32
    if c >= 48 and c <= 57
        return (c -% 48).to[U64]()
    if c >= 65 and c <= 90
        return (c -% 55).to[U64]()
    if c >= 97 and c <= 122
        return (c -% 61).to[U64]()
    if c == 43
        return 62
    if c == 47
        return 63
    return 255

# The most characters `bigint_to_text_into` writes for an `len`-limb value in `radix` (2 to 64): the
# digits of len * 64 bits at floor(log2(radix)) bits each, and a sign.
secret routine bigint_text_capacity(len: U64, radix: U64) -> U64
    var bits_per_digit = 63 -% LLVM::leading_zeros(radix)
    if len == 0
        return 1
    return (len *% 64 +% bits_per_digit -% 1) // bits_per_digit +% 1

# `a` in `radix` (2 to 64), written into `out` (at least `bigint_text_capacity(a.len, radix)`
# characters): an optional '-' then the digits, "0" for zero. Returns the character count, or 0 when the
# call is exhausted.
secret dangerous routine bigint_to_text_into(a: IntV, radix: U64, out: Hijacked[Char]) -> U64
    if a.len == 0
        out.poke(value: '0')
        return 1
    if not scratch_admit(limbs: a.len)
        return 0
    # chunk = radix^k, the largest power of the radix that fits a word
    var chunk = radix
    var k: U64 = 1
    until chunk > 0xFFFFFFFFFFFFFFFF // radix
        chunk = chunk *% radix
        k = k +% 1
    var buf = alloc_limbs(n: a.len)
    limbs_copy(dst: buf, src: a.tab, n: a.len)
    var first: U64 = if a.neg then 1 else 0
    if a.neg
        out.poke(value: '-')
    # the digits, least significant first, then reversed in place
    var count = first
    var n = a.len
    until n == 0
        var rem = limbs_divmod_word_any(tabr: buf, taba: buf, n: n, b: chunk)
        until n == 0 or limb(tab: buf, i: n -% 1) != 0
            n = n -% 1
        var c: U64 = 0
        until c >= k or (n == 0 and rem == 0)
            out.stride(count: count.to[S64]()).poke(value: bigint_digit_char(d: rem % radix))
            count = count +% 1
            rem = rem // radix
            c = c +% 1
    var lo = first
    var hi = count
    until hi <= lo +% 1
        hi = hi -% 1
        var t = out.stride(count: lo.to[S64]()).peek()
        out.stride(count: lo.to[S64]()).poke(value: out.stride(count: hi.to[S64]()).peek())
        out.stride(count: hi.to[S64]()).poke(value: t)
        lo = lo +% 1
    return count

# Parse `count` characters at `chars` in `radix` (2 to 64): an optional leading '-', then digits up to
# the first character outside the radix. The text must end there, or at a '\r' / '\n'. Empty digits
# read as 0. Returns (value, ok).
secret dangerous routine bigint_parse(chars: Hijacked[Char], count: U64, radix: U64) -> (IntV, Bool)
    if radix < 2 or radix > 64
        return (bigint_zero(), false)
    var n = count
    var i: U64 = 0
    var neg = false
    if n > 0 and chars.peek().codepoint() == 45
        neg = true
        i = 1
    # digits per chunk: the largest k with radix^k < 2^64
    var chunk_pow_max: U64 = 1
    var k_max: U64 = 0
    until chunk_pow_max > 0xFFFFFFFFFFFFFFFF // radix
        chunk_pow_max = chunk_pow_max *% radix
        k_max = k_max +% 1
    if not scratch_admit(limbs: n *% 6 // 64 +% 2)
        return (bigint_zero(), true)
    var mant = alloc_limbs(n: n *% 6 // 64 +% 2)
    var mlen: U64 = 0
    var cur: U64 = 0
    var cur_pow: U64 = 1
    var cnt: U64 = 0

    until i >= n
        var d = bigint_digit_value(cp: chars.stride(count: i.to[S64]()).peek().codepoint(), radix: radix)
        if d >= radix
            break
        else
            cur = cur *% radix +% d
            cur_pow = cur_pow *% radix
            cnt = cnt +% 1
            if cnt == k_max
                var carry = limbs_mul_word(tabr: mant, taba: mant, n: mlen, b: cur_pow, l: cur)
                if carry != 0
                    set_limb(tab: mant, i: mlen, value: carry)
                    mlen = mlen +% 1
                cur = 0
                cur_pow = 1
                cnt = 0
            i = i +% 1
    if cnt > 0
        var carry = limbs_mul_word(tabr: mant, taba: mant, n: mlen, b: cur_pow, l: cur)
        if carry != 0
            set_limb(tab: mant, i: mlen, value: carry)
            mlen = mlen +% 1
    if i < n
        var stop = chars.stride(count: i.to[S64]()).peek().codepoint()
        if stop != 13 and stop != 10
            return (bigint_zero(), false)
    return (bigint_make(neg: neg, tab: mant, len: mlen), true)

# ── scratch estimates ─────────────────────────────────────────────────────────────────────────────

# A scratch size for a product of `a_len` x `b_len` limbs: what `bigint_mul` admits.
secret routine bigint_mul_scratch(a_len: U64, b_len: U64) -> U64
    return a_len +% b_len +% limbs_mul_scratch(op1_size: a_len, op2_size: b_len)

# A scratch size for the Euclidean division of an `a_len`-limb value by a `b_len`-limb one: the
# magnitudes' division and the step away from zero.
secret routine bigint_divmod_scratch(a_len: U64, b_len: U64) -> U64
    if a_len < b_len
        return 2 *% b_len +% 4
    var nq = a_len -% b_len +% 1
    return nq +% b_len +% limbs_divmod_scratch(na: a_len, nb: b_len) +% nq +% b_len +% 4

# A scratch size for `a^e` with `a` of `a_len` limbs and `bits` significant bits: every square and
# product along the way (each at most the final size).
secret routine bigint_pow_scratch(a_len: U64, bits: U64, e: U64) -> U64
    if a_len == 0 or e == 0
        return 1
    var total_bits = bits.to[U128]() *% e.to[U128]()
    if total_bits > (1 << 40)
        # beyond any memory: ask for it anyway, the allocation reports it
        return 0xFFFFFFFFFFFFFFFF // 16
    var final = u128_lo(t: total_bits) // 64 +% 2
    var steps = 2 *% (64 -% LLVM::leading_zeros(e)) +% 1
    return steps *% bigint_mul_scratch(a_len: final, b_len: final)

# A scratch size for the integer square root of an `a_len`-limb value.
secret routine bigint_isqrt_scratch(a_len: U64) -> U64
    var n = (a_len +% 1) // 2
    return 5 *% n +% limbs_sqrt_rem_scratch(n: n) +% bigint_mul_scratch(a_len: n, b_len: n) +% a_len +% 4

# A scratch size for gcd(a, b) of `a_len` and `b_len` limbs: the Euclid steps (each a division of the
# operands at most) and the binary GCD.
secret routine bigint_gcd_scratch(a_len: U64, b_len: U64) -> U64
    var longer = if a_len > b_len then a_len else b_len
    var shorter = if a_len > b_len then b_len else a_len
    var steps: U64 = 1
    if longer > shorter +% 1
        steps = 4
    return steps *% bigint_divmod_scratch(a_len: longer, b_len: shorter) +% 4 *% longer +% 2
