module System/Numerics

# ============================================================================
# Integer text in any base (2 to 36). Every integer type's `to_text(radix:)` reduces to a magnitude plus
# a sign and lands here: the 8..64-bit types widen to a `U64` magnitude, the 128/256-bit types keep their
# own width. Digits past 9 are uppercase letters (`FF`, not `ff`); `Text.to_lowercase()` gives the other
# case. `hex()` / `bin()` / `oct()` are the named shorthands.
# ============================================================================

### Crashes unless `radix` is a base this module can render (2 to 36).
### :param radix: The requested numeric base.
### :throws: {NumericDomainError} if `radix` is below 2 or above 36.
routine check_radix(radix: S32)
    if radix < 2 or radix > 36
        throw NumericDomainError(description: f"radix must be between 2 and 36, got {radix}")
    return

### The room of the stack buffer the digits are first written into: a 256-bit value in base 2 needs 257.
preset RADIX_TEXT_ROOM: U64 = 64

### The digits of the 256-bit magnitude `w3..w0` in base `radix`, with a leading `-` when `negative`. Ingrid writes them
### (Ingrid/lapila/radix_text.lpa): a short text fits the stack buffer, a longer one is asked for again with room for
### all of it.
### :param w0: The lowest 64 bits.
### :param w1: The next 64 bits.
### :param w2: The next 64 bits.
### :param w3: The highest 64 bits.
### :param negative: Whether to prefix a minus sign.
### :param radix: The numeric base (2 to 36).
### :returns: The rendered `Text`.
secret routine radix_words_text(w0: U64, w1: U64, w2: U64, w3: U64, negative: Bool, radix: S32) -> Text
    check_radix(radix: radix)
    var sign: U64 = if negative then 1 else 0
    var base = LLVM::zero_extend[U32, U64](LLVM::reinterpret_bits[S32, U32](radix))
    var buf = Items[Char, 64]()
    var count: U64 = 0
    danger
        var p = LLVM::reinterpret_bits[Hijacked[Items[Char, 64]], Hijacked[Char]](buf.hijack())
        count = C::ingrid_radix_text_utf32(w0: w0, w1: w1, w2: w2, w3: w3, negative: sign, radix: base, out: p,
            out_count: RADIX_TEXT_ROOM)
        if count <= RADIX_TEXT_ROOM
            return Text(from_span: p, count: count)
    var result = text_alloc(count: count)
    drop C::ingrid_radix_text_utf32(w0: w0, w1: w1, w2: w2, w3: w3, negative: sign, radix: base, out: result.data,
        out_count: count)
    return result

### The digits of `mag` in base `radix`, with a leading `-` when `negative`.
### :param mag: The magnitude to render.
### :param negative: Whether to prefix a minus sign.
### :param radix: The numeric base (2 to 36).
### :returns: The rendered `Text`.
routine radix_text(mag: U64, negative: Bool, radix: S32) -> Text
    return radix_words_text(w0: mag, w1: 0, w2: 0, w3: 0, negative: negative, radix: radix)

### `radix_text` for a signed 64-bit value (the 8/16/32-bit signed types sign-extend into it first).
### Takes the magnitude through the raw bits so `S64` minimum renders correctly.
### :param value: The value to format.
### :param radix: The base, 2 to 36.
### :returns: The digits, with a leading `-` for a negative value.
routine signed_radix_text(value: S64, radix: S32) -> Text
    var raw = LLVM::reinterpret_bits[S64, U64](value)
    if value < 0
        return radix_text(mag: 0 -% raw, negative: true, radix: radix)
    return radix_text(mag: raw, negative: false, radix: radix)

### `radix_text` for a `U128` magnitude.
### :param mag: The magnitude to format.
### :param negative: `true` to put a `-` in front.
### :param radix: The base, 2 to 36.
### :returns: The digits, with a leading `-` when `negative` is true.
routine wide_radix_text(mag: U128, negative: Bool, radix: S32) -> Text
    return radix_words_text(w0: LLVM::int_truncate[U128, U64](mag), w1: LLVM::int_truncate[U128, U64](mag >>> 64),
        w2: 0, w3: 0, negative: negative, radix: radix)

### `radix_text` for a `U256` magnitude.
### :param mag: The magnitude to format.
### :param negative: `true` to put a `-` in front.
### :param radix: The base, 2 to 36.
### :returns: The digits, with a leading `-` when `negative` is true.
routine wide_radix_text(mag: U256, negative: Bool, radix: S32) -> Text
    return radix_words_text(w0: LLVM::int_truncate[U256, U64](mag), w1: LLVM::int_truncate[U256, U64](mag >>> 64),
        w2: LLVM::int_truncate[U256, U64](mag >>> 128), w3: LLVM::int_truncate[U256, U64](mag >>> 192),
        negative: negative, radix: radix)

### This value in hexadecimal, uppercase (`255.hex()` is `FF`, `-255` is `-FF`). No `0x` prefix.
### :returns: The hexadecimal `Text`.
routine T.hex() -> Text
needs T obeys Integral
    return me.to_text(radix: 16)

### This value in binary (`5.bin()` is `101`). No `0b` prefix.
### :returns: The binary `Text`.
routine T.bin() -> Text
needs T obeys Integral
    return me.to_text(radix: 2)

### This value in octal (`8.oct()` is `10`). No `0o` prefix.
### :returns: The octal `Text`.
routine T.oct() -> Text
needs T obeys Integral
    return me.to_text(radix: 8)
