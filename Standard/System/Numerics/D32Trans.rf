module System/Numerics

# ============================================================================
# D32Trans — the decimal32 transcendentals and libm surface. Every value is computed by Ingrid's decimal engine
# (Ingrid/tessera/decimal/, written in Tessera), one engine for D32, D64 and D128: each transcendental is
# correctly rounded (Ziv's strategy over a multiprecision evaluation with a tracked error bound), and sqrt, cbrt,
# hypot, mul_add, quantize, mod_trunc and rem are exact computations rounded once. A bare `op()` that can leave the
# finite range is CHECKED (it crashes on a non-finite result), `op_unchecked()` gives the raw IEEE value.
# ============================================================================

### e^me. Crashes on a non-finite result (NumericDomainError for a NaN, NumericOverflowError for an
### infinity).
failable routine D32.exp() -> D32
    var r = me.exp_unchecked()
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### e^me, raw IEEE (an infinity or a NaN where the result has no finite value).
routine D32.exp_unchecked() -> D32
    return D32.from_bits(bits: C::ingrid_d32_exp(x: me.to_bits()))

### e^me - 1 (accurate near 0). Crashes on a non-finite result (NumericDomainError for a NaN, NumericOverflowError for an
### infinity).
failable routine D32.exp_m1() -> D32
    var r = me.exp_m1_unchecked()
    if r.is_finite()
        return r
