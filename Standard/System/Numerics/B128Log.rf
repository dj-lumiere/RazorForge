# ============================================================================
# The fast phase of CORE-MATH's natural logarithm of B128
# ============================================================================
# B128.ln_unchecked itself is Tessera's, through Ingrid. This file keeps the fast phase
# the D128 transcendentals (D128Fast.rf) build on.
# Ported from CORE-MATH, src/binary128/log/logq.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see THIRD-PARTY-NOTICES.md at the repository root. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# exception flags, errno and directed-rounding branches are dropped). The computation works on 64-bit and
# 128-bit integer words, like the original, and never uses the software B128 arithmetic. The multi-word
# helpers (b128_wide_*) live in B128Wide.rf.

### ln(x) as a signed 192-bit fixed-point value fs (words w0 low .. w2 high, two's complement) with
### ln(x) = fs * 2^-148 to within 12 units, for a positive finite normal or subnormal B128 whose high word is
### hi and low word lo, outside the range next to 1 that B128.ln_unchecked treats separately. This is the
### value the logarithm rounds; log2 and log10 scale it before rounding.
secret routine b128_log_fs(hi: U64, lo: U64) -> (U64, U64, U64)
    var u = b128_wide_u128(hi: hi, lo: lo)
    var mh = hi
    var ml = lo
    var e = hi & 0xFFFF000000000000
    if e == 0
        var nz: U64 = 0
        if hi != 0
            nz = hi.leading_zeros()
        else
            nz = lo.leading_zeros() +% 64
        var mm = u << b128_wide_s(n: nz -% 15)
        mh = b128_wide_hi(x: mm)
        ml = b128_wide_lo(x: mm)
        e = e -% (nz -% 16 << 48)
    e = e +% (112 << 48)
    # crude approximation of log2
    var l = b128_log_log2(x: mh)
    var sig = (mh & 0x0000FFFFFFFFFFFF) | 0x0001000000000000
    var rr = b128_log_scale(sig: sig, ml: ml, l: l)
    # The reciprocals are rounded so that m * r lands slightly above 1, but the crude log2 can overshoot an index
    # boundary by a hair and leave m * r just below 1, which the unsigned reduced argument can't hold: CORE-MATH's
    # logq.c is off by about 2^-20 there (m just below 2^(k / 2^20) for k = 29, 256, 285, e.g. x =
    # 1.0000191702429175). When the product's leading bit (2^236) is clear, take the index one lower.
    loop
        if (b128_wide_hi(x: rr.item0) >>> 44) != 0
            break
        l = l -% (1 << 44)
        rr = b128_log_scale(sig: sig, ml: ml, l: l)
    var j0 = l >>> 59
    var j1 = (l >>> 54) & 31
    var j2 = (l >>> 49) & 31
    var j3 = (l >>> 44) & 31
    var rhh = b128_wide_hi(x: rr.item0)
    var rhl = b128_wide_lo(x: rr.item0)
    var rlh = b128_wide_hi(x: rr.item1)
    mh = (rhh << 40) | (rhl >>> 24)
    ml = (rhl << 40) | (rlh >>> 24)
    var m = b128_wide_u128(hi: mh, lo: ml)
    var fs = b128_wide_mahu3(
        a: e,
        b0: B128_LOG_LN2A[0],
        b1: B128_LOG_LN2A[1],
        b2: B128_LOG_LN2A[2],
        c0: B128_LOG_OFFA[0],
        c1: B128_LOG_OFFA[1],
        c2: B128_LOG_OFFA[2],
    )
    fs = b128_wide_add3(
        a0: fs.item0,
        a1: fs.item1,
        a2: fs.item2,
        b0: B128_LOG_LT0[3 *% j0],
        b1: B128_LOG_LT0[3 *% j0 +% 1],
        b2: B128_LOG_LT0[3 *% j0 +% 2],
    )
    fs = b128_wide_add3(
        a0: fs.item0,
        a1: fs.item1,
        a2: fs.item2,
        b0: B128_LOG_LT1[3 *% j1],
        b1: B128_LOG_LT1[3 *% j1 +% 1],
        b2: B128_LOG_LT1[3 *% j1 +% 2],
    )
    fs = b128_wide_add3(
        a0: fs.item0,
        a1: fs.item1,
        a2: fs.item2,
        b0: B128_LOG_LT2[3 *% j2],
        b1: B128_LOG_LT2[3 *% j2 +% 1],
        b2: B128_LOG_LT2[3 *% j2 +% 2],
    )
    fs = b128_wide_add3(
        a0: fs.item0,
        a1: fs.item1,
        a2: fs.item2,
        b0: B128_LOG_LT3[3 *% j3],
        b1: B128_LOG_LT3[3 *% j3 +% 1],
        b2: B128_LOG_LT3[3 *% j3 +% 2],
    )
    var f = b128_wide_u128(
        hi: B128_LOG_C[7],
        lo: B128_LOG_C[6] -% b128_wide_mhuu(
            a: mh,
            b: B128_LOG_C[8] -% b128_wide_mhuu(a: mh, b: B128_LOG_C[10]),
        ),
    )
    f = b128_wide_u128(hi: B128_LOG_C[5], lo: B128_LOG_C[4]) -% b128_wide_mhUU(a: m, b: f)
    f = b128_wide_u128(hi: B128_LOG_C[3], lo: B128_LOG_C[2]) -% b128_wide_mhUU(a: m, b: f)
    f = b128_wide_u128(hi: B128_LOG_C[1], lo: B128_LOG_C[0]) -% b128_wide_mhUU(a: m, b: f)
    var res = b128_wide_mhUU(a: m, b: f)
    fs = b128_wide_add3(
        a0: fs.item0,
        a1: fs.item1,
        a2: fs.item2,
        b0: b128_wide_lo(x: res),
        b1: b128_wide_hi(x: res),
        b2: 0,
    )
    return fs

### The significand (sig, ml) times the product of the four reciprocals that the digits of the crude log2 l select.
secret routine b128_log_scale(sig: U64, ml: U64, l: U64) -> (U128, U128)
    var j0 = l >>> 59
    var j1 = (l >>> 54) & 31
    var j2 = (l >>> 49) & 31
    var j3 = (l >>> 44) & 31
    var r01 = B128_LOG_RT1[j1] *% B128_LOG_RT0[j0]
    var r23 = B128_LOG_RT2[j2] *% B128_LOG_RT3[j3]
    return b128_wide_mUU(a: b128_wide_u128(hi: sig, lo: ml), b: b128_wide_muu(a: r01, b: r23))

### |fs| as a U256 and whether fs is negative, for a signed 192-bit fs from b128_log_fs.
secret routine b128_fs_magnitude(fs: (U64, U64, U64)) -> (Bool, U256)
    var v = LLVM::zero_extend[U64, U256](fs.item0) | (LLVM::zero_extend[U64, U256](fs.item1) << 64) | (LLVM::zero_extend[U64, U256](fs.item2) << 128)
    if (fs.item2 >>> 63) == 0
        return (false, v)
    var m192: U256 = (1 << 192) -% 1
    return (true, (v ^ m192) +% 1 & m192)

### The high and low words of a positive finite B128 that b128_log_scaled can take (normal, not next to 1),
### or false.
secret routine b128_log_scaled_ok(x: B128) -> (Bool, U64, U64)
    var u = x.to_bits()
    var hi = b128_wide_hi(x: u)
    var lo = b128_wide_lo(x: u)
    if hi >= 0x7FFF000000000000 or hi < 0x0001000000000000
        return (false, hi, lo)
    if 0x3FFEFFFFF0000040 <= hi and hi <= 0x3FFF000008000020
        return (false, hi, lo)
    return (true, hi, lo)

### Crude approximation of log2 of the high significand word x (fixed point), selecting the table indices.
secret routine b128_log_log2(x: U64) -> U64
    var j = (x >>> 43) & 31
    var z = (x >>> 11) & 0xFFFFFFFF
    var z2 = z *% z >>> 32
    var t0 = B128_LOG_L2C[4 *% j] -% (z *% B128_LOG_L2C[4 *% j +% 1] >>> 38) & 0xFFFFFFFF
    var t2 = B128_LOG_L2C[4 *% j +% 2] -% (z *% B128_LOG_L2C[4 *% j +% 3] >>> 32) & 0xFFFFFFFF
    t0 = t0 +% (z2 *% t2 >>> 44) & 0xFFFFFFFF
    return B128_LOG_L2C0[j] +% (z *% t0 >>> 4)
