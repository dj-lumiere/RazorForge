module System/Numerics

# Constants for U32 limits
preset U32_MIN: U32 = 0
preset U32_MAX: U32 = 4294967295
preset U32_ZERO: U32 = 0
preset U32_ONE: U32 = 1

### A 32-bit unsigned integer in the range 0 to 4,294,967,295.
###
### `U32` is the natural unsigned integer type for 32-bit quantities such as
### Unicode code points, IPv4 addresses, pixel colours, and shift amounts
### (the shift operators expect `U32` for their count argument).
@llvm("i32")
record U32
obeys UnsignedIntegral, Comparable, ConstCompatible, UnbrokenType, Copyable, Splittable
    nothing

# ============================================================================
# Checked Creators (crash on overflow)
# ============================================================================

### Converts an `S8` to `U32`, throwing if the value is negative.
### :returns: A `U32` with the same unsigned value as this value.
### :throws: {IntegerOverflowError} if `me < 0`.
failable routine S8.to[U32]() -> U32
    if me < 0
        throw IntegerOverflowError()
    return LLVM::sign_extend[S8, U32](me)

### Converts an `S16` to `U32`, throwing if the value is negative.
### :returns: A `U32` with the same unsigned value as this value.
### :throws: {IntegerOverflowError} if `me < 0`.
failable routine S16.to[U32]() -> U32
    if me < 0
        throw IntegerOverflowError()
    return LLVM::sign_extend[S16, U32](me)

### Converts an `S32` to `U32`, throwing if the value is negative.
### :returns: The same bit pattern reinterpreted as an unsigned value.
### :throws: {IntegerOverflowError} if `me < 0`.
failable routine S32.to[U32]() -> U32
    if me < 0
        throw IntegerOverflowError()
    return LLVM::reinterpret_bits[S32, U32](me)

### Converts an `S64` to `U32`, throwing if the value is outside 0..4294967295.
### :returns: The lower 32 bits of this value.
### :throws: {IntegerOverflowError} if this value is not in `0..=4294967295`.
failable routine S64.to[U32]() -> U32
    if not (0 <= me <= 4294967295)
        throw IntegerOverflowError()
    return LLVM::int_truncate[S64, U32](me)

### Converts an `S128` to `U32`, throwing if the value is outside 0..4294967295.
### :returns: The lower 32 bits of this value.
### :throws: {IntegerOverflowError} if this value is not in `0..=4294967295`.
failable routine S128.to[U32]() -> U32
    if not (0 <= me <= 4294967295)
        throw IntegerOverflowError()
    return LLVM::int_truncate[S128, U32](me)

### Zero-extends a `U8` to `U32`.
### :returns: A `U32` equal in value to this value.
routine U8.to[U32]() -> U32
    return LLVM::zero_extend[U8, U32](me)

### Zero-extends a `U16` to `U32`.
### :returns: A `U32` equal in value to this value.
routine U16.to[U32]() -> U32
    return LLVM::zero_extend[U16, U32](me)

### Identity conversion — returns this value unchanged.
### :returns: this value unchanged.
routine U32.to[U32]() -> U32
    return me

### Converts a `U64` to `U32`, throwing if the value exceeds 4294967295.
### :returns: The lower 32 bits of this value.
### :throws: {IntegerOverflowError} if `me > 4294967295`.
failable routine U64.to[U32]() -> U32
    if me > 4294967295
        throw IntegerOverflowError()
    return LLVM::int_truncate[U64, U32](me)

### Converts a `U128` to `U32`, throwing if the value exceeds 4294967295.
### :returns: The lower 32 bits of this value.
### :throws: {IntegerOverflowError} if `me > 4294967295`.
failable routine U128.to[U32]() -> U32
    if me > 4294967295
        throw IntegerOverflowError()
    return LLVM::int_truncate[U128, U32](me)

### Converts an `S256` to `U32`, throwing if the value is negative or exceeds 4294967295.
### :returns: The lower 32 bits of this value.
### :throws: {IntegerOverflowError} if this value is outside 0..4294967295.
failable routine S256.to[U32]() -> U32
    if not (0 <= me <= 4294967295)
        throw IntegerOverflowError()
    return LLVM::int_truncate[S256, U32](me)

### Converts a `U256` to `U32`, throwing if the value exceeds 4294967295.
### :returns: The lower 32 bits of this value.
### :throws: {IntegerOverflowError} if `me > 4294967295`.
failable routine U256.to[U32]() -> U32
    if me > 4294967295
        throw IntegerOverflowError()
    return LLVM::int_truncate[U256, U32](me)

### Converts an `B16` to `U32` by widening to `B32` first, then truncating.
### :returns: The integer part of this value as a `U32`.
### :throws: {IntegerOverflowError} if the integer part exceeds 4294967295.
failable routine B16.to[U32]() -> U32
    return me.to[B32]().to[U32]()

### Converts an `B32` to `U32`, truncating toward zero.
### :returns: The integer part of this value as a `U32`.
### :throws: {IntegerOverflowError} if the value is negative or exceeds 4294967295.
failable routine B32.to[U32]() -> U32
    if me.is_nan() or not (0.0 <= me <= 4294967295.0)
        throw IntegerOverflowError()
    return LLVM::float_to_unsigned[B32, U32](me)

### Converts an `B64` to `U32`, truncating toward zero.
### :returns: The integer part of this value as a `U32`.
### :throws: {IntegerOverflowError} if the value is negative or exceeds 4294967295.
failable routine B64.to[U32]() -> U32
    if me.is_nan() or not (0.0 <= me <= 4294967295.0)
        throw IntegerOverflowError()
    return LLVM::float_to_unsigned[B64, U32](me)

### Converts an `B128` to `U32` by narrowing to `B64` first, then truncating.
### :returns: The integer part of this value as a `U32`.
### :throws: {IntegerOverflowError} if the value is negative or exceeds 4294967295.
failable routine B128.to[U32]() -> U32
    return me.to[B64]().to[U32]()

### Converts a `D32` to `U32` via `S64` conversion.
### :returns: The integer part of this value as a `U32`.
### :throws: {IntegerOverflowError} if the value is negative or exceeds 4294967295.
failable routine D32.to[U32]() -> U32
    return me.to[S64]().to[U32]()

### Converts a `D64` to `U32` via `S64` conversion.
### :returns: The integer part of this value as a `U32`.
### :throws: {IntegerOverflowError} if the value is negative or exceeds 4294967295.
failable routine D64.to[U32]() -> U32
    return me.to[S64]().to[U32]()

### Converts a `D128` to `U32` via `S64` conversion.
### :returns: The integer part of this value as a `U32`.
### :throws: {IntegerOverflowError} if the value is negative or exceeds 4294967295.
failable routine D128.to[U32]() -> U32
    return me.to[S64]().to[U32]()

# ============================================================================
# Arithmetic Operations (trapping on overflow by default)
# ============================================================================

### Returns the sum and a flag indicating whether the result wrapped around.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
routine U32.add_with_overflow(you: U32) -> (U32, Bool)
    return LLVM::unsigned_add_checked[U32](me, you)

### Returns the difference and a flag indicating whether the result wrapped around.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
routine U32.sub_with_overflow(you: U32) -> (U32, Bool)
    return LLVM::unsigned_sub_checked[U32](me, you)

### Returns the product and a flag indicating whether the result wrapped around.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
routine U32.mul_with_overflow(you: U32) -> (U32, Bool)
    return LLVM::unsigned_mul_checked[U32](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result exceeds `U32_MAX`.
failable routine U32.add(you: U32) -> U32
    var result = me.add_with_overflow(you)
    if result.item1
        throw IntegerOverflowError()
    return result.item0

### Returns `me - you`, throwing on underflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is less than `U32_MIN` (0).
failable routine U32.sub(you: U32) -> U32
    var result = me.sub_with_overflow(you)
    if result.item1
        throw IntegerOverflowError()
    return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result exceeds `U32_MAX`.
failable routine U32.mul(you: U32) -> U32
    var result = me.mul_with_overflow(you)
    if result.item1
        throw IntegerOverflowError()
    return result.item0

### Returns `me // you` (integer division), throwing if `you` is zero.
### :param you: The divisor.
### :returns: The quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
failable routine U32.floordiv(you: U32) -> U32
    if you == 0
        throw DivisionByZeroError()
    return LLVM::unsigned_div(a: me, b: you)

### Returns `me % you` (integer remainder).
### :param you: The divisor.
### :returns: The remainder `me % you`. Behavior is undefined if `you == 0`.
failable routine U32.mod(you: U32) -> U32
    if you == 0
        throw DivisionByZeroError()
    return LLVM::unsigned_rem(a: me, b: you)

# ============================================================================
# Negation (wrapping)
# ============================================================================

### Returns the two's-complement negation `(2³² - me) mod 2³²`.
### :returns: The wrapped negation.
routine U32.neg_wrap() -> U32
    return LLVM::sub(a: 0, b: me)

### Returns `(wrapping negation, overflowed)`. Overflow occurs for any non-zero value.
### :returns: A tuple of `(wrapped negation, overflow flag)`.
routine U32.neg_with_overflow() -> (U32, Bool)
    return (LLVM::sub(a: 0, b: me), me != 0)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you) mod 2³²` without overflow check.
### :param you: The right operand.
### :returns: The sum modulo 4294967296.
routine U32.add_wrap(you: U32) -> U32
    return LLVM::add(a: me, b: you)

### Returns `(me - you) mod 2³²` without underflow check.
### :param you: The value to subtract.
### :returns: The difference modulo 4294967296.
routine U32.sub_wrap(you: U32) -> U32
    return LLVM::sub(a: me, b: you)

### Returns `(me * you) mod 2³²` without overflow check.
### :param you: The right operand.
### :returns: The product modulo 4294967296.
routine U32.mul_wrap(you: U32) -> U32
    return LLVM::mul(a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum, assuming no overflow.
dangerous routine U32.add_unchecked(you: U32) -> U32
    return LLVM::unsigned_add_exact[U32](a: me, b: you)

### Returns `me - you` with undefined behavior on underflow.
### :param you: The value to subtract.
### :returns: The difference, assuming no underflow.
dangerous routine U32.sub_unchecked(you: U32) -> U32
    return LLVM::unsigned_sub_exact[U32](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product, assuming no overflow.
dangerous routine U32.mul_unchecked(you: U32) -> U32
    return LLVM::unsigned_mul_exact[U32](a: me, b: you)

### Returns `me // you` with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The quotient, assuming `you != 0`.
@readonly
dangerous routine U32.floordiv_unchecked(you: U32) -> U32
    return LLVM::unsigned_div(a: me, b: you)

### Returns `me % you` with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The remainder, assuming `you != 0`.
@readonly
dangerous routine U32.mod_unchecked(you: U32) -> U32
    return LLVM::unsigned_rem(a: me, b: you)

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `U32_MAX` on overflow.
### :param you: The right operand.
### :returns: The sum, or `4294967295` if it would exceed `U32_MAX`.
@readonly
routine U32.add_clamp(you: U32) -> U32
    return LLVM::unsigned_add_sat[U32](a: me, b: you)

### Returns `me - you`, clamped to `U32_MIN` on underflow.
### :param you: The value to subtract.
### :returns: The difference, or `0` if it would go below `U32_MIN`.
@readonly
routine U32.sub_clamp(you: U32) -> U32
    return LLVM::unsigned_sub_sat[U32](a: me, b: you)

### Returns `me * you`, clamped to `U32_MAX` on overflow.
### :param you: The right operand.
### :returns: The product, or `4294967295` if it would exceed `U32_MAX`.
@readonly
routine U32.mul_clamp(you: U32) -> U32
    var wide = LLVM::mul(LLVM::zero_extend[U32, U64](me), LLVM::zero_extend[U32, U64](you))
    if LLVM::unsigned_gt(wide, 4294967295)
        return U32_MAX
    return LLVM::int_truncate[U64, U32](wide)

# ============================================================================
# Widening / Carrying Arithmetic (multi-word building blocks)
# ============================================================================

### Returns `me + you + carry` as `(wrapped_sum, carry_out)`.
### Chains across words to add integers wider than `U32`: feed each word's
### `carry_out` in as the next higher word's `carry`.
### :param you: The right operand.
### :param carry: The incoming carry bit from the lower word.
### :returns: A tuple of `(wrapped sum, outgoing carry)`.
routine U32.carrying_add(you: U32, carry: Bool) -> (U32, Bool)
    var carry_val: U32 = if carry then 1 else 0
    var first = me.add_with_overflow(you)
    var second = first.item0.add_with_overflow(carry_val)
    return (second.item0, first.item1 or second.item1)

### Returns `me - you - borrow` as `(wrapped_difference, borrow_out)`.
### Chains across words to subtract integers wider than `U32`.
### :param you: The value to subtract.
### :param borrow: The incoming borrow bit from the lower word.
### :returns: A tuple of `(wrapped difference, outgoing borrow)`.
routine U32.borrowing_sub(you: U32, borrow: Bool) -> (U32, Bool)
    var borrow_val: U32 = if borrow then 1 else 0
    var first = me.sub_with_overflow(you)
    var second = first.item0.sub_with_overflow(borrow_val)
    return (second.item0, first.item1 or second.item1)

### Returns the full `me * you` product as `(low, high)` halves.
### The product of two `U32` values needs 64 bits; this splits it into the low
### and high `U32` words without loss.
### :param you: The right operand.
### :returns: A tuple of `(low 32 bits, high 32 bits)`.
routine U32.widening_mul(you: U32) -> (U32, U32)
    var wide = LLVM::mul(LLVM::zero_extend[U32, U64](me), LLVM::zero_extend[U32, U64](you))
    var lo = LLVM::int_truncate[U64, U32](wide)
    var hi = LLVM::int_truncate[U64, U32](LLVM::shift_right_unsigned(wide, 32))
    return (lo, hi)

### Returns `me * you + carry` as `(low, high)` halves.
### Never overflows: the largest result is `(2³²-1)² + (2³²-1) < 2⁶⁴`. The
### workhorse of schoolbook multiplication — `carry` accumulates the high word
### carried out of the previous column.
### :param you: The right operand.
### :param carry: The value to add to the product.
### :returns: A tuple of `(low 32 bits, high 32 bits)`.
routine U32.carrying_mul(you: U32, carry: U32) -> (U32, U32)
    var wide = LLVM::mul(LLVM::zero_extend[U32, U64](me), LLVM::zero_extend[U32, U64](you))
    wide = LLVM::add(wide, LLVM::zero_extend[U32, U64](carry))
    var lo = LLVM::int_truncate[U64, U32](wide)
    var hi = LLVM::int_truncate[U64, U32](LLVM::shift_right_unsigned(wide, 32))
    return (lo, hi)

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and a flag indicating whether the result wrapped around.
### :param exp: The exponent.
### :returns: A tuple of `(wrapped_result, overflowed)`.
routine U32.pow_with_overflow(exp: U32) -> (U32, Bool)
    var result: U32 = 1
    var base: U32 = me
    var e: U32 = exp
    var overflow = false
    until e == 0
        if (e & 1) == 1
            var mul_result = result.mul_with_overflow(base)
            result = mul_result.item0
            overflow = overflow or mul_result.item1
        e = e >> 1
        if e > 0
            var square_result = base.mul_with_overflow(base)
            base = square_result.item0
            overflow = overflow or square_result.item1
    return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent.
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result exceeds `U32_MAX`.
failable routine U32.pow(exp: U32) -> U32
    var result = me.pow_with_overflow(exp)
    if result.item1
        throw IntegerOverflowError()
    return result.item0

### Returns `me ** exp` with wrapping arithmetic (mod 2³²).
### :param exp: The exponent.
### :returns: The result modulo 4294967296.
routine U32.pow_wrap(exp: U32) -> U32
    var result: U32 = 1
    var base: U32 = me
    var e: U32 = exp
    until e == 0
        if (e & 1) == 1
            result = result.mul_wrap(base)
        e = e >> 1
        if e > 0
            base = base.mul_wrap(base)
    return result

### Returns `me ** exp`, clamped to `U32_MAX` on overflow.
### :param exp: The exponent.
### :returns: The result, or `4294967295` if it would overflow.
@readonly
routine U32.pow_clamp(exp: U32) -> U32
    var result: U32 = 1
    var base: U32 = me
    var e: U32 = exp
    until e == 0
        if (e & 1) == 1
            result = result.mul_clamp(base)
        base = base.mul_clamp(base)
        e = e >> 1
    return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
routine U32.bitand(you: U32) -> U32
    return LLVM::bit_and(a: me, b: you)

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
routine U32.bitor(you: U32) -> U32
    return LLVM::bit_or(a: me, b: you)

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
routine U32.bitxor(you: U32) -> U32
    return LLVM::bit_xor(a: me, b: you)

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
@readonly
routine U32.bitnot() -> U32
    return LLVM::bit_xor(a: me, b: U32_MAX)

# ============================================================================
# Shift Operations (<<, >>, >>>)
# Shifting by the width or more pushes every bit out: `<<` and `>>>` give 0, and `>>` gives the
# fill (0; for unsigned types `>>` and `>>>` are the same).
# ============================================================================

### Left-shifts this value by `bits` positions, filling vacated bits with zero. Shifting by
### 32 or more gives 0.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine U32.shift_left(bits: U32) -> U32
    if bits >= 32
        return 0
    return LLVM::shift_left(me, bits)

### Right-shifts this value by `bits` positions, filling vacated bits with zero (the same as
### `>>>` for an unsigned type). Shifting by 32 or more gives 0.
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits`.
routine U32.arith_shift_right(bits: U32) -> U32
    if bits >= 32
        return 0
    return LLVM::shift_right_unsigned(me, bits)

### Right-shifts this value by `bits` positions, filling vacated bits with zero (the same as
### `>>` for an unsigned type). Shifting by 32 or more gives 0.
### :param bits: The number of bit positions to shift right.
### :returns: `me >>> bits`.
routine U32.logical_shift_right(bits: U32) -> U32
    if bits >= 32
        return 0
    return LLVM::shift_right_unsigned(me, bits)

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
@readonly
routine U32.eq(you: U32) -> Bool
    return LLVM::int_eq(a: me, b: you)

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
@readonly
routine U32.compare(you: U32) -> ComparisonSign
    if LLVM::unsigned_lt(me, you)
        return ME_SMALL
    if LLVM::unsigned_gt(me, you)
        return ME_LARGE
    return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
routine U32.min(you: U32) -> U32
    return if me <= you then me else you
### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
routine U32.max(you: U32) -> U32
    return if me >= you then me else you
### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@positional
routine U32.clamp(min_val: U32, max_val: U32) -> U32
    return me.min(max_val).max(min_val)

# ============================================================================
# Integer Math (roots, logs, rounding)
# ============================================================================

### Returns the integer square root ⌊√me⌋ — the largest value whose square is ≤ me.
### :returns: The floor of the square root of `me`.
routine U32.isqrt() -> U32
    return me.sqrtrem().item0

### Returns the integer square root together with its remainder: `(s, r)` with `s = ⌊√me⌋` and
### `r = me - s*s`, so `0 <= r <= 2s` (e.g. `5.sqrtrem()` is `(2, 1)`).
### :returns: The tuple `(root, remainder)`.
routine U32.sqrtrem() -> (U32, U32)
    var x = me
    var result: U32 = 0
    var bit: U32 = 1 << 30
    until bit <= x
        bit = bit.logical_shift_right(2)
    until bit == 0
        var next = result.add_wrap(bit)
        if x >= next
            x = x.sub_wrap(next)
            result = result.logical_shift_right(1).add_wrap(bit)
        else
            result = result.logical_shift_right(1)
        bit = bit.logical_shift_right(2)
    return (result, x)

### Returns ⌊log₂ me⌋. Throws if `me` is zero (the logarithm of zero is undefined).
### :returns: The floor of the base-2 logarithm.
### :throws: {NumericDomainError} if `me == 0`.
failable routine U32.ilog2() -> U32
    if me == 0
        throw NumericDomainError(description: "ilog2 of zero is undefined")
    return 31 - me.leading_zeros()

### Returns ⌊log₁₀ me⌋. Throws if `me` is zero.
### :returns: The floor of the base-10 logarithm.
### :throws: {NumericDomainError} if `me == 0`.
failable routine U32.ilog10() -> U32
    if me == 0
        throw NumericDomainError(description: "ilog10 of zero is undefined")
    var n = me
    var count: U32 = 0
    until n < 10
        n = n // 10
        count = count + 1
    return count

### Returns ⌊log_base me⌋. Throws if `me` is zero or `base < 2`.
### :param base: The logarithm base (must be ≥ 2).
### :returns: The floor of the base-`base` logarithm.
### :throws: {NumericDomainError} if `me == 0` or `base < 2`.
failable routine U32.ilog(base: U32) -> U32
    if me == 0 or base < 2
        throw NumericDomainError(description: "ilog domain: me must be > 0 and base >= 2")
    var n = me
    var count: U32 = 0
    until n < base
        n = n // base
        count = count + 1
    return count

### Returns the absolute difference |me - you| without overflow.
### :param you: The other value.
### :returns: The non-negative distance between `me` and `you`.
routine U32.abs_diff(you: U32) -> U32
    return if me >= you then me.sub_wrap(you) else you.sub_wrap(me)

### Returns ⌈me / you⌉ (division rounding toward positive infinity).
### :param you: The divisor.
### :returns: The ceiling of `me / you`.
### :throws: {DivisionByZeroError} if `you == 0`.
routine U32.div_ceil(you: U32) -> U32
    var q = me.floordiv(you)
    var r = me.mod(you)
    return if r == 0 then q else q.add_wrap(1)

### Returns the smallest power of two that is ≥ me. Both `0` and `1` map to `1`.
### :returns: The next power of two at or above `me`.
### :throws: {IntegerOverflowError} if the next power of two exceeds `U32_MAX`.
failable routine U32.next_power_of_two() -> U32
    if me <= 1
        return 1
    var shift = 32 - me.sub_wrap(1).leading_zeros()
    if shift >= 32
        throw IntegerOverflowError()
    return LLVM::shift_left(1, shift)

### Returns the smallest multiple of `you` that is ≥ me.
### :param you: The base to round up to.
### :returns: The next multiple of `you` at or above `me`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if the result exceeds `U32_MAX`.
routine U32.next_multiple_of(you: U32) -> U32
    var r = me.mod(you)
    if r == 0
        return me
    return me.add(you.sub_wrap(r))

### Returns ⌊(me + you) / 2⌋ computed without overflow.
### :param you: The other value.
### :returns: The midpoint of `me` and `you`, rounding toward negative infinity.
routine U32.midpoint(you: U32) -> U32
    return me.bitand(you).add_wrap(me.bitxor(you).logical_shift_right(1))

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the count of set bits (popcount) in this value's 32-bit representation.
### :returns: The number of `1` bits; between 0 and 32.
routine U32.count_ones() -> U32
    return LLVM::count_ones[U32](me)

### Returns the count of clear bits in this value's 32-bit representation.
### :returns: `32` minus the popcount; between 0 and 32.
routine U32.count_zeros() -> U32
    return 32 -% me.count_ones()

### Returns the number of leading zero bits, starting from the most-significant bit.
### :returns: The leading zero count; `32` if the value is zero.
routine U32.leading_zeros() -> U32
    return LLVM::leading_zeros(me)

### Returns the number of trailing zero bits, starting from the least-significant bit.
### :returns: The trailing zero count; `32` if the value is zero.
routine U32.trailing_zeros() -> U32
    return LLVM::trailing_zeros(me)

### Returns the number of leading one bits, starting from the most-significant bit.
### :returns: The leading one count; `32` if the value is `4294967295`.
routine U32.leading_ones() -> U32
    return me.bitnot().leading_zeros()

### Returns the number of trailing one bits, starting from the least-significant bit.
### :returns: The trailing one count; `32` if the value is `4294967295`.
routine U32.trailing_ones() -> U32
    return me.bitnot().trailing_zeros()

### Returns this value with its bits reversed (bit 31 ↔ bit 0, etc.).
### :returns: The bit-reversed `U32`.
routine U32.reverse_bits() -> U32
    return LLVM::reverse_bits[U32](me)

### Returns this value with its four bytes swapped (for endianness conversion).
### :returns: A `U32` with its bytes in reverse order.
routine U32.swap_bytes() -> U32
    return LLVM::byte_swap(me)

### Returns `true` if this value is an exact power of two.
### :returns: `true` if `me` is 1, 2, 4, ..., 2147483648; `false` otherwise (including zero).
routine U32.is_power_of_two() -> Bool
    return me != 0 and (me & me -% 1) == 0

### Returns this value rotated left by `bits` positions.
routine U32.rotate_left(bits: U32) -> U32
    var n = bits % 32
    if n == 0
        return me
    return LLVM::bit_or(a: LLVM::shift_left(me, n), b: LLVM::shift_right_unsigned(me, 32 -% n))

### Returns this value rotated right by `bits` positions.
routine U32.rotate_right(bits: U32) -> U32
    var n = bits % 32
    if n == 0
        return me
    return LLVM::bit_or(a: LLVM::shift_right_unsigned(me, n), b: LLVM::shift_left(me, 32 -% n))

### Returns the raw byte representation of this value in little-endian order.
routine U32.to_bytes_le() -> Array[Byte, 4]
    var result = Array[Byte, 4]()
    var i: U64 = 0
    until i >= 4
        var b = LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(me, (i * 8).to[U32]()))
        result = LLVM::set_byte_at(array: result, index: i, value: b)
        i = i + 1
    return result

### Returns the raw byte representation of this value in big-endian order.
routine U32.to_bytes_be() -> Array[Byte, 4]
    return me.swap_bytes().to_bytes_le()

### Builds a `U32` from its little-endian raw byte representation.
common routine U32.from_bytes_le(bytes: Array[Byte, 4]) -> U32
    var result: U32 = 0
    var i: U64 = 0
    until i >= 4
        var part = LLVM::shift_left(
            LLVM::zero_extend[U8, U32](LLVM::byte_at(array: bytes, index: i)),
            (i * 8).to[U32](),
        )
        result = LLVM::bit_or(a: result, b: part)
        i = i + 1
    return result

### Builds a `U32` from its big-endian raw byte representation.
common routine U32.from_bytes_be(bytes: Array[Byte, 4]) -> U32
    return U32.from_bytes_le(bytes: bytes).swap_bytes()

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
routine U32.is_zero() -> Bool
    return me == 0

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
routine U32.is_even() -> Bool
    var result = LLVM::bit_and(a: me, b: 1)
    return LLVM::int_eq(a: result, b: 0)

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
routine U32.is_odd() -> Bool
    return not me.is_even()

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine U32.represent() -> Text
    return int_to_text(mag: LLVM::zero_extend[U32, U64](me), negative: false)

### Renders this value in base `radix` (2 to 36), digits past 9 as lowercase letters, with a leading `-`
### when negative (`255.to_text(radix: 16)` is `ff`).
### :param radix: The numeric base.
### :returns: The rendered `Text`.
@readonly
routine U32.to_text(radix: S32) -> Text
    return radix_text(mag: LLVM::zero_extend[U32, U64](me), negative: false, radix: radix)

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine U32.diagnose() -> Text
    return "U32(" + me.represent() + ")"

### Parses a decimal string into a `U32`.
### :returns: The parsed `U32` value.
### :throws: {InvalidValueError} if this value is empty or contains non-digit characters.
### :throws: {IntegerOverflowError} if the value does not fit in `U32`.
failable routine Text.to[U32]() -> U32
    if me.count() == 0
        throw InvalidValueError(input: me, target: "U32")
    var result: U32 = 0
    var i: U64 = 0
    until i >= me.count()
        var ch = me[i]
        if ch.is_numeric()
            var digit = ch.digit_value().to[U32]()
            # Stop before `result * 10 + digit` passes U32's maximum.
            if result > 429496729 or (result == 429496729 and digit > 5)
                throw IntegerOverflowError()
            result = result * 10 + digit
        else
            throw InvalidValueError(input: me, target: "U32")
        i = i + 1
    return result

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine U32.hash(k0: U64, k1: U64) -> U64
    return __secure_hash_u64(v: LLVM::zero_extend[U32, U64](me), k0: k0, k1: k1)
