module System/Numerics

# The amount of a shift and the index of a subscript may be an `Int`: the builder turns it into the type the
# routine takes with these (the fixed-width integers have theirs in System).

### This value as an index: the same count as a `U64`, or `U64_MAX` when it is larger.
### :returns: The count as a `U64`.
### :throws: {NegativeIndexError} when this value is below 0.
@inline
failable routine Int.to_index() -> U64
    if me.owner.is_hollow() and (me.meta >>> 63) == 0
        return me.meta
    if me.is_negative()
        throw NegativeIndexError(index: me)
    if me > U64_MAX.to[Int]()
        return U64_MAX
    return me.to[U64]()

### This value as a shift amount: the same count as a `U32`, or `U32_MAX` when it is larger.
### :returns: The count as a `U32`.
### :throws: {NumericDomainError} when this value is below 0.
@inline
failable routine Int.to_shift_amount() -> U32
    if me.owner.is_hollow() and me.meta <= U32_MAX.to[U64]()
        return LLVM::int_truncate[U64, U32](me.meta)
    if me.is_negative()
        throw NumericDomainError(description: f"{me} is below 0, and a shift amount counts from 0")
    if me > U32_MAX.to[Int]()
        return U32_MAX
    return me.to[U32]()

# A Suflae subscript or shift takes an `Int` count: a fixed-width one becomes an `Int` with these.

### This value as an `Int` count (an index or a shift amount), the same number.
### :returns: The value as an `Int`.
routine S8.to_integer_count() -> Int
    return me.to[Int]()

### This value as an `Int` count (an index or a shift amount), the same number.
### :returns: The value as an `Int`.
routine S16.to_integer_count() -> Int
    return me.to[Int]()

