module System/Numerics

### Represents an arbitrary-precision signed integer, computed by the integer engine in Ingrid.
### `Integer` is the unbounded integer type for workloads where fixed-width overflow is not acceptable.
### It preserves exact integer semantics across arithmetic, parsing, and formatting operations.
###
### `Integer` is a record (value semantics from the user's view). A magnitude below 2^64 is held in the value
### itself (`small`), so small numbers need no heap and are computed without calling the engine. A bigger magnitude
### is a read-only list of 64-bit limbs shared by copies (`owner`, with `data`/`count` caching its buffer): copying
### shares the list (no number data is copied), and the last copy to go ends it. A literal's limbs are constant data
### with no owner. Division is Euclidean: `a // b` and `a % b`
### satisfy `a == b * (a // b) + a % b` with `0 <= a % b < |b|`. The bitwise operators act on the two's-complement
### form. There is no `/`: an integer quotient is `//`, and a fractional one is computed in `Decimal`.
### :see: {Decimal}
record Integer
obeys Copyable, Integral, Negatable, Comparable, Hashable
    ### The list holding the limbs of a magnitude of at least 2^64, shared read-only by copies (null when the
    ### magnitude is below 2^64, and for a literal's constant limbs).
    secret owner: Guarded[List[U64], ReadOnly]
    ### The magnitude when it is below 2^64 (`count` is 0), else 0.
    secret small: U64
    ### The limbs, little-endian with a nonzero top limb, when `count` is not 0.
    secret data: Hijacked[U64]
    ### The number of limbs: 0 for a magnitude below 2^64, else at least 2.
    secret count: U64
    ### True when the value is negative (never true for zero).
    secret neg: Bool

### The limbs one engine call reads for a value: its own limbs, or a one-limb buffer made for the call that `temp`
### says to free afterward.
record IntegerLimbView
    ### The number of limbs (0 for zero).
    secret len: U64
    ### The limbs.
    secret tab: Hijacked[U64]
    ### Whether `tab` was made for this call.
    secret temp: Bool

# ============================================================================
# Small values and limbs
# ============================================================================

# The zero `Integer`.
secret routine integer_zero() -> Integer
    return integer_small(neg: false, mag: 0)

# The `Integer` with magnitude `mag` below 2^64, negative when `neg` (zero stays non-negative).
secret routine integer_small(neg: Bool, mag: U64) -> Integer
    danger
        return Integer(
            owner: guarded_none[List[U64], ReadOnly](),
            small: mag,
            data: Hijacked[U64].hollow(),
            count: 0,
            neg: neg and mag != 0,
        )

# The `Integer` over `len` limbs (at least 2) in `tab`, a buffer from `limb_buffer` it takes over, negative when `neg`.
secret dangerous routine integer_over_limbs(neg: Bool, tab: Hijacked[U64], len: U64) -> Integer
    var limbs = List[U64](over: tab, count: len)
    return Integer(owner: Guarded[List[U64], ReadOnly](from: steal limbs), small: 0, data: tab, count: len, neg: neg)

# The magnitude when it is below 2^64, and whether it is.
secret routine integer_small_part(v: Integer) -> (Bool, U64)
    return (v.count == 0, v.small)

# The `Integer` with magnitude `hi * 2^64 + lo`, negative when `neg`.
secret routine integer_two_limbs(neg: Bool, lo: U64, hi: U64) -> Integer
    if hi == 0
        return integer_small(neg: neg, mag: lo)
    danger
        var tab = limb_buffer(n: 2)
        tab.poke(value: lo)
        tab.stride(count: 1).poke(value: hi)
        return integer_over_limbs(neg: neg, tab: tab, len: 2)

# The limbs an engine call reads for `v`. Free them with `limb_view_free`.
secret dangerous routine limb_view(v: Integer) -> IntegerLimbView
    if v.count != 0
        return IntegerLimbView(len: v.count, tab: v.data, temp: false)
    if v.small == 0
        return IntegerLimbView(len: 0, tab: Hijacked[U64].hollow(), temp: false)
    var tab = limb_buffer(n: 1)
    tab.poke(value: v.small)
    return IntegerLimbView(len: 1, tab: tab, temp: true)

# Frees what `limb_view` made for a call.
secret dangerous routine limb_view_free(view: IntegerLimbView)
    if view.temp
        limb_free(p: view.tab)
    return

# ============================================================================
# Calls into Ingrid
# ============================================================================
# The bodies are IntegerEngine.rf, which runs in Ingrid (Ingrid/tessera/generated/numerics.te,
# written from RazorForge/IngridExport/numerics.rf, which describes the call protocol). RazorForge allocates
# every buffer: the result buffer, which becomes the new value's limbs, and the scratch the engine takes its
# temporaries from. A call that needs more of either says so, and is made again with that much. Values below
# 2^64 mostly never get here: the routines below compute them directly.

# A buffer of `n` limbs for one Ingrid call (none when `n` is 0).
secret dangerous routine limb_buffer(n: U64) -> Hijacked[U64]
    if n == 0
        return Hijacked[U64].hollow()
    return Hijacked[U64](from: C::rf_allocate_dynamic_uninit(size: 8 *% n))

# Frees a buffer from `limb_buffer`.
secret dangerous routine limb_free(p: Hijacked[U64])
    if not p.is_hollow()
        p.invalidate()
    return

# The scratch a retry hands over after a call that had `room` limbs needed `need` at least.
secret routine scratch_retry(room: U64, need: U64) -> U64
    var doubled = room *% 2
    var wanted = need +% need // 2
    return if doubled > wanted then doubled else wanted
# 1 when `neg`, else 0: a sign as it crosses the C ABI.
secret routine sign_word(neg: Bool) -> U64
    return if neg then 1 else 0

# The `Integer` an Ingrid call left in `out`: `len` limbs, negative when `neg`. A magnitude that fits one limb
# becomes a small value and `out` is freed.
secret dangerous routine integer_adopt(out: Hijacked[U64], len: U64, neg: Bool) -> Integer
    if len == 0
        limb_free(p: out)
        return integer_zero()
    if len == 1
        var small = out.peek()
        limb_free(p: out)
        return integer_small(neg: neg, mag: small)
    return integer_over_limbs(neg: neg, tab: out, len: len)

# `v` with its sign `neg` (zero stays non-negative), sharing its limbs.
secret routine integer_with_sign(v: Integer, neg: Bool) -> Integer
    if v.count == 0
        return integer_small(neg: neg, mag: v.small)
    return Integer(owner: v.owner, small: 0, data: v.data, count: v.count, neg: neg)

# a + b, or a - b when `negate_b`. Addition needs no scratch: the sum goes straight into its own buffer.
secret routine integer_sum(a: Integer, b: Integer, negate_b: Bool) -> Integer
    var b_neg = if negate_b then not b.neg and not b.is_zero() else b.neg
    var sa = integer_small_part(v: a)
    var sb = integer_small_part(v: b)
    if sa.item0 and sb.item0
        if a.neg == b_neg
            var lo = sa.item1 +% sb.item1
            var carry: U64 = if lo < sa.item1 then 1 else 0
            return integer_two_limbs(neg: a.neg, lo: lo, hi: carry)
        if sa.item1 >= sb.item1
            return integer_small(neg: a.neg, mag: sa.item1 -% sb.item1)
        return integer_small(neg: b_neg, mag: sb.item1 -% sa.item1)
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var cap = (if av.len > bv.len then av.len else bv.len) +% 1
        var out = limb_buffer(n: cap)
        var w = C::ingrid_integer_add(
            a_neg: sign_word(neg: a.neg),
            a_len: av.len,
            a_tab: av.tab,
            b_neg: sign_word(neg: b_neg),
            b_len: bv.len,
            b_tab: bv.tab,
            out: out,
            out_cap: cap,
        )
        limb_view_free(view: av)
        limb_view_free(view: bv)
        return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)

# The low 64 bits of the magnitude.
secret routine integer_low_word(v: Integer) -> U64
    if v.count == 0
        return v.small
    danger
        return v.data.peek()

# One two's-complement bitwise operation (0 AND, 1 OR, 2 XOR). It needs no scratch.
secret routine integer_bitop(a: Integer, b: Integer, op: U32) -> Integer
    var sa = integer_small_part(v: a)
    var sb = integer_small_part(v: b)
    if sa.item0 and sb.item0 and not a.neg and not b.neg
        if op == 0
            return integer_small(neg: false, mag: sa.item1 & sb.item1)
        if op == 1
            return integer_small(neg: false, mag: sa.item1 | sb.item1)
        return integer_small(neg: false, mag: sa.item1 ^ sb.item1)
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var cap = (if av.len > bv.len then av.len else bv.len) +% 1
        var out = limb_buffer(n: cap)
        var w = IngridWords(w0: 0, w1: 0, w2: 0, w3: 0)
        if op == 0
            w = C::ingrid_integer_and(
                a_neg: sign_word(neg: a.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: b.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                out: out,
                out_cap: cap,
            )
        elseif op == 1
            w = C::ingrid_integer_or(
                a_neg: sign_word(neg: a.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: b.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                out: out,
                out_cap: cap,
            )
        else
            w = C::ingrid_integer_xor(
                a_neg: sign_word(neg: a.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: b.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                out: out,
                out_cap: cap,
            )
        limb_view_free(view: av)
        limb_view_free(view: bv)
        return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)

# Shifts the magnitude by `bits` (left when `left`), keeping the sign. It needs no scratch.
secret routine integer_shift(a: Integer, bits: U64, left: Bool) -> Integer
    var sa = integer_small_part(v: a)
    if sa.item0
        var m = sa.item1
        if m == 0
            return integer_zero()
        if not left
            var capped = if bits > 64 then 64 else bits
            var k = capped.to[U32]()
            # floor(m / 2^k), and for a negative value floor(-m / 2^k) = -(((m - 1) >> k) + 1).
            if not a.neg
                return integer_small(neg: false, mag: m >>> k)
            return integer_small(neg: true, mag: ((m -% 1) >>> k) +% 1)
        if bits < 64 and m >>> (64 -% bits).to[U32]() == 0
            return integer_small(neg: a.neg, mag: m << bits.to[U32]())
    danger
        var av = limb_view(v: a)
        var cap: U64 = 0
        if left
            cap = av.len +% bits // 64 +% 1
        else
            var limb_shift = bits // 64
            cap = if limb_shift >= av.len then 1 else av.len -% limb_shift +% 1
        var out = limb_buffer(n: cap)
        var w = IngridWords(w0: 0, w1: 0, w2: 0, w3: 0)
        if left
            w = C::ingrid_integer_shift_left(
                a_neg: sign_word(neg: a.neg),
                a_len: av.len,
                a_tab: av.tab,
                bits: bits,
                out: out,
                out_cap: cap,
            )
        else
            w = C::ingrid_integer_shift_right(
                a_neg: sign_word(neg: a.neg),
                a_len: av.len,
                a_tab: av.tab,
                bits: bits,
                out: out,
                out_cap: cap,
            )
        limb_view_free(view: av)
        return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)

# a * b.
secret routine integer_product(a: Integer, b: Integer) -> Integer
    if a.is_zero() or b.is_zero()
        return integer_zero()
    var sa = integer_small_part(v: a)
    var sb = integer_small_part(v: b)
    if sa.item0 and sb.item0
        var p = sa.item1.to[U128]() *% sb.item1.to[U128]()
        return integer_two_limbs(
            neg: a.neg != b.neg,
            lo: LLVM::int_truncate[U128, U64](p),
            hi: LLVM::int_truncate[U128, U64](p >>> 64),
        )
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var cap = av.len +% bv.len
        var room = C::ingrid_integer_mul_scratch_size(a_len: av.len, b_len: bv.len)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_mul(
                a_neg: sign_word(neg: a.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: b.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                limb_view_free(view: bv)
                return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)
            limb_free(p: out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# The Euclidean quotient and remainder of a / b (b nonzero).
secret routine integer_divmod(a: Integer, b: Integer) -> (Integer, Integer)
    var sa = integer_small_part(v: a)
    var sb = integer_small_part(v: b)
    if sa.item0 and sb.item0
        var am = sa.item1
        var bm = sb.item1
        var qt = am // bm
        var rt = am -% qt *% bm
        if not a.neg
            return (integer_small(neg: b.neg, mag: qt), integer_small(neg: false, mag: rt))
        if rt == 0
            return (integer_small(neg: not b.neg, mag: qt), integer_zero())
        return (integer_small(neg: not b.neg, mag: qt +% 1), integer_small(neg: false, mag: bm -% rt))
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var q_cap = (if av.len > bv.len then av.len -% bv.len else 0) +% 2
        var r_cap = bv.len
        var room = C::ingrid_integer_divmod_scratch_size(a_len: av.len, b_len: bv.len)
        loop
            var q_out = limb_buffer(n: q_cap)
            var r_out = limb_buffer(n: r_cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_divmod(
                a_neg: sign_word(neg: a.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: b.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                q_out: q_out,
                q_cap: q_cap,
                r_out: r_out,
                r_cap: r_cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                limb_view_free(view: bv)
                return (
                    integer_adopt(out: q_out, len: w.w1, neg: w.w2 != 0),
                    integer_adopt(out: r_out, len: w.w3, neg: false),
                )
            limb_free(p: q_out)
            limb_free(p: r_out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                q_cap = w.w1
                r_cap = w.w2

# a^e.
secret routine integer_power(a: Integer, e: U64) -> Integer
    danger
        var bits = a.bit_length()
        var av = limb_view(v: a)
        var cap = ((bits.to[U128]() *% e.to[U128]()) // 64).to[U64]() +% 2
        var room = C::ingrid_integer_pow_scratch_size(a_len: av.len, a_bits: bits, e: e)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_pow(
                a_neg: sign_word(neg: a.neg),
                a_len: av.len,
                a_tab: av.tab,
                e: e,
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)
            limb_free(p: out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# (floor(sqrt(a)), a - floor(sqrt(a))^2) of a non-negative a, the remainder only when `want_rem`.
secret routine integer_root(a: Integer, want_rem: Bool) -> (Integer, Integer)
    danger
        var av = limb_view(v: a)
        var s_cap = (av.len +% 1) // 2 +% 1
        var r_cap = if want_rem then s_cap +% 1 else 0
        var room = C::ingrid_integer_sqrt_scratch_size(a_len: av.len)
        loop
            var s_out = limb_buffer(n: s_cap)
            var r_out = limb_buffer(n: r_cap)
            var scratch = limb_buffer(n: room)
            var w = IngridWords(w0: 0, w1: 0, w2: 0, w3: 0)
            if want_rem
                w = C::ingrid_integer_sqrtrem(
                    a_len: av.len,
                    a_tab: av.tab,
                    s_out: s_out,
                    s_cap: s_cap,
                    r_out: r_out,
                    r_cap: r_cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            else
                w = C::ingrid_integer_sqrt(
                    a_len: av.len,
                    a_tab: av.tab,
                    out: s_out,
                    out_cap: s_cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                return (
                    integer_adopt(out: s_out, len: w.w1, neg: false),
                    integer_adopt(out: r_out, len: w.w3, neg: false),
                )
            limb_free(p: s_out)
            limb_free(p: r_out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                s_cap = w.w1
                r_cap = w.w2

# gcd(|a|, |b|), or lcm(|a|, |b|) when `lcm`.
secret routine integer_gcd_lcm(a: Integer, b: Integer, lcm: Bool) -> Integer
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var cap = if av.len > bv.len then av.len else bv.len
        if lcm
            cap = av.len +% bv.len
        var room = C::ingrid_integer_gcd_scratch_size(a_len: av.len, b_len: bv.len)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = IngridWords(w0: 0, w1: 0, w2: 0, w3: 0)
            if lcm
                w = C::ingrid_integer_lcm(
                    a_len: av.len,
                    a_tab: av.tab,
                    b_len: bv.len,
                    b_tab: bv.tab,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            else
                w = C::ingrid_integer_gcd(
                    a_len: av.len,
                    a_tab: av.tab,
                    b_len: bv.len,
                    b_tab: bv.tab,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                limb_view_free(view: bv)
                return integer_adopt(out: out, len: w.w1, neg: false)
            limb_free(p: out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# -1 / 0 / 1 comparing values.
secret routine integer_compare(a: Integer, b: Integer) -> S64
    var sa = integer_small_part(v: a)
    var sb = integer_small_part(v: b)
    if sa.item0 and sb.item0
        if a.neg != b.neg
            return if a.neg then -1 else 1
        var order = 0
        if sa.item1 < sb.item1
            order = -1
        elseif sa.item1 > sb.item1
            order = 1
        return if a.neg then 0 -% order else order
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var result = C::ingrid_integer_compare(
            a_neg: sign_word(neg: a.neg),
            a_len: av.len,
            a_tab: av.tab,
            b_neg: sign_word(neg: b.neg),
            b_len: bv.len,
            b_tab: bv.tab,
        )
        limb_view_free(view: av)
        limb_view_free(view: bv)
        return result

# `v` in `radix` (2 to 64): an optional '-' then the digits (0-9, A-Z, a-z, '+', '/'), "0" for zero.
secret routine integer_text(v: Integer, radix: U64) -> Text
    var sv = integer_small_part(v: v)
    if sv.item0 and radix == 10
        return if v.neg then f"-{sv.item1}" else f"{sv.item1}"
    danger
        var view = limb_view(v: v)
        var cap = C::ingrid_integer_text_capacity(a_len: view.len, radix: radix)
        var room = view.len
        loop
            var out = Hijacked[Char](from: C::rf_allocate_dynamic_uninit(size: 4 *% cap))
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_to_text(
                a_neg: sign_word(neg: v.neg),
                a_len: view.len,
                a_tab: view.tab,
                radix: radix,
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: view)
                var text = Text(from_span: out, count: w.w1)
                out.invalidate()
                return text
            out.invalidate()
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# ============================================================================
# Lifecycle Management
# ============================================================================

### Creates the integer value `0`.
### Use this overload when the surrounding context needs an explicit `Integer`
### instead of a fixed-width literal.
### :returns: The resulting `Integer` value.
routine Integer() -> Integer
    return integer_zero()

### Creates an `Integer` from a signed 64-bit source value.
### The numeric payload is copied into the arbitrary-precision representation,
### so the result is no longer limited by `S64` range after construction.
### :returns: The resulting `Integer` value.
routine S64.to[Integer]() -> Integer
    return integer_of_s64(v: me)

### Creates an `Integer` from an unsigned 64-bit source value.
### This is the direct widening entry point for exact conversion from native
### unsigned integer data.
### :returns: The resulting `Integer` value.
routine U64.to[Integer]() -> Integer
    return integer_of_u64(v: me)

# ============================================================================
# Creators — fixed-width integer widenings. Every width is composed from S64/U64
# limbs via shift+add. All are total (any fixed-width integer fits an unbounded
# Integer exactly).
# ============================================================================

# 64-bit base builders: one limb holds the magnitude. They avoid the `Integer(from:)` call form (which
# mis-lowers) and don't collide with the `create(value: S64/U64)` overloads.
routine integer_of_s64(v: S64) -> Integer
    if v < 0
        return integer_small(neg: true, mag: 0 -% LLVM::reinterpret_bits[S64, U64](v))
    return integer_small(neg: false, mag: LLVM::reinterpret_bits[S64, U64](v))

routine integer_of_u64(v: U64) -> Integer
    return integer_small(neg: false, mag: v)

### Widens a fixed-width integer into an `Integer` (exact). 64-bit limbs go through the
### base builders; wider widths compose them with shift+add.
### :returns: The equal `Integer` value.
routine S8.to[Integer]() -> Integer
    return integer_of_s64(v: LLVM::sign_extend[S8, S64](me))

routine S16.to[Integer]() -> Integer
    return integer_of_s64(v: LLVM::sign_extend[S16, S64](me))

routine S32.to[Integer]() -> Integer
    return integer_of_s64(v: LLVM::sign_extend[S32, S64](me))

routine S128.to[Integer]() -> Integer
    var neg = LLVM::signed_lt[S128](a: me, b: 0)
    var mag = if neg then LLVM::reinterpret_bits[S128, U128](
        LLVM::sub[S128](a: 0, b: me),
    ) else LLVM::reinterpret_bits[S128, U128](me)
    var r = mag.to[Integer]()
    return if neg then r.neg() else r
routine S256.to[Integer]() -> Integer
    var neg = LLVM::signed_lt[S256](a: me, b: 0)
    var mag = if neg then LLVM::reinterpret_bits[S256, U256](
        LLVM::sub[S256](a: 0, b: me),
    ) else LLVM::reinterpret_bits[S256, U256](me)
    var r = mag.to[Integer]()
    return if neg then r.neg() else r
### Widens an unsigned fixed-width integer into an `Integer` (exact).
### :returns: The equal `Integer` value.
routine U8.to[Integer]() -> Integer
    return integer_of_u64(v: LLVM::zero_extend[U8, U64](me))

routine U16.to[Integer]() -> Integer
    return integer_of_u64(v: LLVM::zero_extend[U16, U64](me))

routine U32.to[Integer]() -> Integer
    return integer_of_u64(v: LLVM::zero_extend[U32, U64](me))

routine U128.to[Integer]() -> Integer
    # value = hi * 2^64 + lo, from the two 64-bit limbs.
    var hi = integer_of_u64(v: LLVM::int_truncate[U128, U64](me >>> 64))
    var lo = integer_of_u64(v: LLVM::int_truncate[U128, U64](me))
    return hi.shift_left(bits: 64).add(other: lo)

routine U256.to[Integer]() -> Integer
    # value = hi * 2^128 + lo, reusing the U128 widening for each 128-bit half.
    var hi = (LLVM::int_truncate[U256, U128](me >>> 128)).to[Integer]()
    var lo = (LLVM::int_truncate[U256, U128](me)).to[Integer]()
    return hi.shift_left(bits: 128).add(other: lo)

# Parses `text` in `radix`, or returns (_, false): an optional leading '-', then digits up to the first
# character outside the radix, where the text must end or hold a '\r' or '\n'. Empty digits read as 0.
secret routine integer_parse(text: Text, radix: S32) -> (Integer, Bool)
    danger
        var count = text.count()
        var chars = Hijacked[Char](from: C::rf_allocate_dynamic_uninit(size: 4 *% count +% 4))
        var i: U64 = 0
        until i >= count
            chars.stride(count: i.to[S64]()).poke(value: text[i])
            i = i +% 1
        var cap = count *% 6 // 64 +% 2
        var room = cap
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_parse(
                chars: chars,
                count: count,
                radix: radix.to[S64]().to[U64](),
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                chars.invalidate()
                return (integer_adopt(out: out, len: w.w1, neg: w.w2 != 0), w.w3 != 0)
            limb_free(p: out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

### Parses an integer from text using the requested radix (2 to 64).
### The input is an optional leading `-` followed by digits of the selected base (letters are
### case-insensitive up to base 36). A trailing `\r` or `\n` ends the digits; empty digits read as 0.
### :param text: The textual integer representation.
### :param radix: The numeric base to use.
### :returns: The resulting `Integer` value.
### :throws: {ValueError} if `text` is not a valid integer in `radix`.
failable routine Integer(text: Text, radix: S32 = 10) -> Integer
    if radix < 2 or radix > 64
        throw InvalidValueError(input: text, target: "Integer")
    var parsed = integer_parse(text: text, radix: radix)
    if not parsed.item1
        throw InvalidValueError(input: text, target: "Integer")
    return parsed.item0

### Materializes an `Integer` from a decimal digit string its caller has already validated.
### The float conversions call it on the digits they collected. An `n` literal never does: the builder
### lays its limbs down as static data. Infallible, unlike the public `Integer(text:)`.
### :param text: The decimal digit string (no suffix, no separators).
### :returns: The resulting `Integer` value.
common routine Integer.from_literal(text: Text) -> Integer
    return integer_parse(text: text, radix: 10).item0

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Adds `other` to this value using exact integer arithmetic.
### No overflow occurs; the storage grows as needed.
### :param other: The value to add.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.add(other: Integer) -> Integer
    return integer_sum(a: me, b: other, negate_b: false)

### Subtracts `other` from this value using exact integer arithmetic.
### :param other: The value to subtract.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.sub(other: Integer) -> Integer
    return integer_sum(a: me, b: other, negate_b: true)

### Multiplies this value by `other` using exact integer arithmetic.
### :param other: The value to multiply by.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.mul(other: Integer) -> Integer
    return integer_product(a: me, b: other)

### Divides this value by `other` and returns the Euclidean quotient: the `q` for which
### `me - other * q` lies in `[0, |other|)`.
### :param other: The non-zero divisor.
### :returns: The integer quotient.
@readonly
failable routine Integer.floordiv(other: Integer) -> Integer
    if other.is_zero()
        throw DivisionByZeroError()
    return integer_divmod(a: me, b: other).item0

### Returns the Euclidean remainder of this value divided by `other`.
### :param other: The non-zero divisor.
### :returns: The remainder, always in `[0, |other|)`.
@readonly
failable routine Integer.mod(other: Integer) -> Integer
    if other.is_zero()
        throw DivisionByZeroError()
    return integer_divmod(a: me, b: other).item1

### Returns the additive inverse of this value.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.neg() -> Integer
    return integer_with_sign(v: me, neg: not me.neg)

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values represent the same mathematical integer.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.eq(you: Integer) -> Bool
    return integer_compare(a: me, b: you) == 0

### Compares this value with `you` using numeric ordering.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine Integer.compare(you: Integer) -> ComparisonSign
    var comparison_value = integer_compare(a: me, b: you)
    if comparison_value < 0
        return ME_SMALL
    elseif comparison_value > 0
        return ME_LARGE
    else
        return SAME

# ============================================================================
# Bitwise Operations
# ============================================================================

### Computes the bitwise AND of this value and `other` (two's-complement form).
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.bitand(other: Integer) -> Integer
    return integer_bitop(a: me, b: other, op: 0)

### Computes the bitwise OR of this value and `other` (two's-complement form).
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.bitor(other: Integer) -> Integer
    return integer_bitop(a: me, b: other, op: 1)

### Computes the bitwise XOR of this value and `other` (two's-complement form).
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.bitxor(other: Integer) -> Integer
    return integer_bitop(a: me, b: other, op: 2)

### Shifts this value left by `bits` positions (`me << bits`): `me * 2^bits`.
### :param bits: The number of bit positions to shift.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.shift_left(bits: U32) -> Integer
    return integer_shift(a: me, bits: bits.to[U64](), left: true)

### Shifts this value right by `bits` positions (`me >> bits`): `floor(me / 2^bits)`, so `-5 >> 1` is `-3`.
### :param bits: The number of bit positions to shift.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.arith_shift_right(bits: U32) -> Integer
    return integer_shift(a: me, bits: bits.to[U64](), left: false)

### Shifts this value right by `bits` positions filling with zeros (`me >>> bits`). An `Integer` has no fixed
### width, so a negative value has no zero-filled form: this is `>>` for a value that is not negative.
### :param bits: The number of bit positions to shift.
### :returns: The resulting `Integer` value.
### :throws: {NumericDomainError} when this value is negative.
@readonly
failable routine Integer.logical_shift_right(bits: U32) -> Integer
    if me.neg
        throw NumericDomainError(description: ">>> on a negative Integer: it has no width to fill with zeros")
    return integer_shift(a: me, bits: bits.to[U64](), left: false)

# ============================================================================
# Math Operations
# ============================================================================

### Returns the absolute magnitude of this value.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.abs() -> Integer
    return integer_with_sign(v: me, neg: false)

### Raises this value to a non-negative integer exponent.
### :param exp: The exponent value.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.pow(exp: U32) -> Integer
    return integer_power(a: me, e: exp.to[U64]())

### Returns the integer square root of this value.
### The result is the greatest integer whose square does not exceed the input.
### :returns: The resulting `Integer` value.
### :throws: {NumericDomainError} when this value is negative (it has no real square root).
@readonly
failable routine Integer.sqrt() -> Integer
    if me.is_negative()
        throw NumericDomainError(description: "sqrt: negative Integer has no real square root")
    return integer_root(a: me, want_rem: false).item0

### Returns the integer square root together with its remainder: `(s, r)` with `s = ⌊√me⌋` and
### `r = me - s*s`, so `0 <= r <= 2s` (e.g. `5.sqrtrem()` is `(2, 1)`).
### :returns: The tuple `(root, remainder)`.
### :throws: {NumericDomainError} when this value is negative (it has no real square root).
@readonly
failable routine Integer.sqrtrem() -> (Integer, Integer)
    if me.is_negative()
        throw NumericDomainError(description: "sqrtrem: negative Integer has no real square root")
    return integer_root(a: me, want_rem: true)

### Computes the greatest common divisor of this value and `other` (non-negative).
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.gcd(other: Integer) -> Integer
    return integer_gcd_lcm(a: me, b: other, lcm: false)

### Computes the least common multiple of this value and `other` (non-negative, 0 when either is 0).
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.lcm(other: Integer) -> Integer
    return integer_gcd_lcm(a: me, b: other, lcm: true)

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` when this value is exactly zero.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_zero() -> Bool
    var s = integer_small_part(v: me)
    return s.item0 and s.item1 == 0

### Returns `true` when this value is less than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_negative() -> Bool
    return me.neg

### Returns `true` when this value is greater than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_positive() -> Bool
    return not me.is_zero() and not me.is_negative()

### Returns the sign of this value as `-1`, `0`, or `1`.
### :returns: The resulting `S32` value.
@readonly
routine Integer.signum() -> S32
    return when
        me.is_positive() => 1
        me.is_negative() => -1
        else => 0

### Returns `true` when this value is even (divisible by two).
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_even() -> Bool
    return (integer_low_word(v: me) & 1) == 0

### Returns `true` when this value is odd.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_odd() -> Bool
    return not me.is_even()

### Returns `true` when this value is a positive power of two (1, 2, 4, 8, ...).
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_power_of_two() -> Bool
    if not me.is_positive()
        return false
    return me.bitand(other: me.sub(other: Integer.one())).is_zero()

### Returns the bitwise complement `~me`, defined in the two's-complement sense as `-me - 1`.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.bitnot() -> Integer
    return me.add(other: Integer.one()).neg()

### Returns the number of bits in the magnitude of this value (0 for zero).
### :returns: The resulting `U64` value.
@readonly
routine Integer.bit_length() -> U64
    if me.count == 0
        return 64 -% LLVM::leading_zeros(me.small)
    danger
        var top = me.data.stride(count: (me.count -% 1).to[S64]()).peek()
        return me.count *% 64 -% LLVM::leading_zeros(top)

### Returns the smaller of this value and `other`.
### :param other: The value to compare against.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.min(other: Integer) -> Integer
    if me.compare(you: other) == ME_LARGE
        return other.share()
    return me.share()

### Returns the larger of this value and `other`.
### :param other: The value to compare against.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.max(other: Integer) -> Integer
    if me.compare(you: other) == ME_SMALL
        return other.share()
    return me.share()

### Clamps this value into the inclusive range `[low, high]`.
### :param low: The lower bound.
### :param high: The upper bound.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.clamp(low: Integer, high: Integer) -> Integer
    if me.compare(you: low) == ME_SMALL
        return low.share()
    if me.compare(you: high) == ME_LARGE
        return high.share()
    return me.share()

### Divides by `other`, returning the Euclidean quotient and remainder together
### (`me == other * q + r`, `0 <= r < |other|`).
### :param other: The non-zero divisor.
### :returns: A tuple `(quotient, remainder)`.
### :throws: {DivisionByZeroError} when `other` is zero.
@readonly
failable routine Integer.divmod(other: Integer) -> (Integer, Integer)
    if other.is_zero()
        throw DivisionByZeroError()
    return integer_divmod(a: me, b: other)

### Modular exponentiation `me^exp mod modulus` via right-to-left binary exponentiation
### (each step reduced modulo `modulus`, so intermediates never blow up).
### :param exp: The non-negative exponent.
### :param modulus: The non-zero modulus.
### :returns: The resulting `Integer` value in `[0, modulus)`.
### :throws: {DivisionByZeroError} when `modulus` is zero; {NumericDomainError} when `exp` is negative.
@readonly
failable routine Integer.modpow(exp: Integer, modulus: Integer) -> Integer
    if modulus.is_zero()
        throw DivisionByZeroError()
    if exp.is_negative()
        throw NumericDomainError(description: "modpow: negative exponent")
    var result = Integer.one()
    var base = me.mod(other: modulus)
    var e = exp.share()
    until e.is_zero()
        if e.is_odd()
            result = result.mul(other: base).mod(other: modulus)
        e = e.arith_shift_right(bits: 1)
        base = base.mul(other: base).mod(other: modulus)
    return result

# ============================================================================
# Conversions
# ============================================================================

### Converts an arbitrary-precision integer to `S64`.
### :returns: The resulting `S64` value.
### :throws: {IntegerOverflowError} if this value is outside `S64_MIN..S64_MAX`.
failable routine Integer.to[S64]() -> S64
    var s = integer_small_part(v: me)
    if not s.item0
        throw IntegerOverflowError()
    var limit: U64 = if me.neg then 9223372036854775808 else 9223372036854775807
    if s.item1 > limit
        throw IntegerOverflowError()
    # in range: wrap the magnitude to 64 bits in two's complement
    var bits = if me.neg then 0 -% s.item1 else s.item1
    return LLVM::reinterpret_bits[U64, S64](bits)

### Converts an arbitrary-precision integer to `U64`.
### :returns: The resulting `U64` value.
### :throws: {IntegerOverflowError} if this value is negative or exceeds `U64_MAX`.
failable routine Integer.to[U64]() -> U64
    var s = integer_small_part(v: me)
    if me.is_negative() or not s.item0
        throw IntegerOverflowError()
    return s.item1

### Converts an arbitrary-precision integer to `S8`.
### :returns: The resulting `S8` value.
### :throws: {IntegerOverflowError} if this value is outside the `S8` range.
failable routine Integer.to[S8]() -> S8
    return me.to[S64]().to[S8]()

### Converts an arbitrary-precision integer to `S16`.
### :returns: The resulting `S16` value.
### :throws: {IntegerOverflowError} if this value is outside the `S16` range.
failable routine Integer.to[S16]() -> S16
    return me.to[S64]().to[S16]()

### Converts an arbitrary-precision integer to `S32`.
### :returns: The resulting `S32` value.
### :throws: {IntegerOverflowError} if this value is outside the `S32` range.
failable routine Integer.to[S32]() -> S32
    return me.to[S64]().to[S32]()

### Converts an arbitrary-precision integer to `U8`.
### :returns: The resulting `U8` value.
### :throws: {IntegerOverflowError} if this value is outside the `U8` range.
failable routine Integer.to[U8]() -> U8
    return me.to[U64]().to[U8]()

### Converts an arbitrary-precision integer to `U16`.
### :returns: The resulting `U16` value.
### :throws: {IntegerOverflowError} if this value is outside the `U16` range.
failable routine Integer.to[U16]() -> U16
    return me.to[U64]().to[U16]()

### Converts an arbitrary-precision integer to `U32`.
### :returns: The resulting `U32` value.
### :throws: {IntegerOverflowError} if this value is outside the `U32` range.
failable routine Integer.to[U32]() -> U32
    return me.to[U64]().to[U32]()

### Converts an arbitrary-precision integer to `U128`.
### :returns: The resulting `U128` value.
### :throws: {IntegerOverflowError} if this value is negative or exceeds `U128_MAX`.
failable routine Integer.to[U128]() -> U128
    if me.is_negative()
        throw IntegerOverflowError()
    # value = hi * 2^64 + lo: `hi` fits 64 bits exactly when the value fits 128.
    var hi = me.arith_shift_right(bits: 64)
    var lo = me.sub(other: hi.shift_left(bits: 64))
    return (hi.to[U64]().to[U128]() << 64) | lo.to[U64]().to[U128]()

### Converts an arbitrary-precision integer to `U256`.
### :returns: The resulting `U256` value.
### :throws: {IntegerOverflowError} if this value is negative or exceeds `U256_MAX`.
failable routine Integer.to[U256]() -> U256
    if me.is_negative()
        throw IntegerOverflowError()
    # value = hi * 2^128 + lo, each half through the U128 conversion.
    var hi = me.arith_shift_right(bits: 128)
    var lo = me.sub(other: hi.shift_left(bits: 128))
    return (hi.to[U128]().to[U256]() << 128) | lo.to[U128]().to[U256]()

### Converts an arbitrary-precision integer to `S128`.
### :returns: The resulting `S128` value.
### :throws: {IntegerOverflowError} if this value is outside `S128_MIN..S128_MAX`.
failable routine Integer.to[S128]() -> S128
    var magnitude = me.abs().to[U128]()
    # A negative value may reach 2^127 (S128_MIN), a positive one stops one short.
    var limit: U128 = if me.is_negative() then 1 << 127 else (1 << 127) -% 1
    if magnitude > limit
        throw IntegerOverflowError()
    var bits = if me.is_negative() then 0 -% magnitude else magnitude
    return LLVM::reinterpret_bits[U128, S128](bits)

### Converts an arbitrary-precision integer to `S256`.
### :returns: The resulting `S256` value.
### :throws: {IntegerOverflowError} if this value is outside `S256_MIN..S256_MAX`.
failable routine Integer.to[S256]() -> S256
    var magnitude = me.abs().to[U256]()
    # A negative value may reach 2^255 (S256_MIN), a positive one stops one short.
    var limit: U256 = if me.is_negative() then 1 << 255 else (1 << 255) -% 1
    if magnitude > limit
        throw IntegerOverflowError()
    var bits = if me.is_negative() then 0 -% magnitude else magnitude
    return LLVM::reinterpret_bits[U256, S256](bits)

### Converts an arbitrary-precision integer to the nearest `B32`.
### :returns: The `B32` closest to this value.
### :throws: {NumericOverflowError} if this value is beyond the range of `B32`.
failable routine Integer.to[B32]() -> B32
    # The exact decimal text read back as a float rounds once, to the nearest `B32`.
    return me.represent().to[B32]()

### Converts an arbitrary-precision integer to the nearest `B64`.
### :returns: The `B64` closest to this value.
### :throws: {NumericOverflowError} if this value is beyond the range of `B64`.
failable routine Integer.to[B64]() -> B64
    # The exact decimal text read back as a float rounds once, to the nearest `B64`.
    return me.represent().to[B64]()

### Converts an arbitrary-precision integer to `Decimal`, rounding half-even to its 34 significant digits.
### :returns: The resulting `Decimal` value.
### :throws: {NumericOverflowError} if this value is beyond the range of `Decimal` (about `1e6144`).
failable routine Integer.to[Decimal]() -> Decimal
    var d = me.represent().to[D128]()
    if not d.is_finite()
        throw NumericOverflowError(description: "overflow: the integer is too large for Decimal")
    return d.to[Decimal]()

### Formats this value as base-10 text. Standard `represent` shape (no args)
### so the f-string machinery can dispatch without supplying a radix.
### :returns: The resulting `Text` value.
@readonly
@override
routine Integer.represent() -> Text
    return me.represent_radix(radix: 10)

### Serializes this value as its base-10 text, which `sv.to[Integer]()` parses back exactly.
### :returns: The `SerialValue` text arm.
@readonly
@override
routine Integer.serialize() -> SerialValue
    return SerialValue(from: me.represent())

### Builds an `Integer` from its serialized base-10 text.
### :param value: The serialized value.
### :returns: The parsed value.
### :throws: {SerialShapeError} when the value is not text, or a parse error when the text is not an integer.
failable common routine Integer.from_serial(value: SerialValue) -> Integer
    return serial_text(value: value).to[Integer]()

### Formats this value as text in the requested radix (2 to 64; digits past 9 are uppercase
### letters up to base 36). An out-of-range radix renders an empty text.
### :param radix: The numeric base to use.
### :returns: The resulting `Text` value.
@readonly
routine Integer.represent_radix(radix: S32) -> Text
    if radix < 2 or radix > 64
        return ""
    return integer_text(v: me, radix: radix.to[S64]().to[U64]())

### Renders this value in base `radix` (2 to 36), digits past 9 as lowercase letters, with a leading `-`
### when negative. Crashes on any other radix (unlike `represent_radix`, which renders an empty text).
### :param radix: The numeric base.
### :returns: The rendered `Text`.
@readonly
routine Integer.to_text(radix: S32) -> Text
    check_radix(radix: radix)
    return me.represent_radix(radix: radix).to_lowercase()

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value: of the magnitude word (with the key changed for a negative
### value) below 2^64, of the base-10 text above. A value has one form only, so equal values hash equal.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The 64-bit keyed hash.
@readonly
routine Integer.hash(k0: U64, k1: U64) -> U64
    var s = integer_small_part(v: me)
    if s.item0
        var key = if me.neg then k1 ^ 0x9E3779B97F4A7C15 else k1
        return s.item1.hash(k0: k0, k1: key)
    return me.represent_radix(radix: 10).hash(k0: k0, k1: k1)

# ============================================================================
# Factory Methods
# ============================================================================

### Parses a base-10 integer from text.
### This is the canonical text-to-`Integer` conversion used by generic parsing
### surfaces.
### :returns: The resulting `Integer` value.
### :throws: May throw {ParseError}.
failable routine Text.to[Integer]() -> Integer
    var parsed = integer_parse(text: me, radix: 10)
    if not parsed.item1
        throw InvalidValueError(input: me, target: "Integer")
    return parsed.item0

### Parses a base-2 integer from text.
### :param text: The binary digits to parse.
### :returns: The resulting `Integer` value.
### :throws: May throw {ParseError}.
@readonly
failable common routine Integer.from_binary(text: Text) -> Integer
    var parsed = integer_parse(text: text, radix: 2)
    if not parsed.item1
        throw InvalidValueError(input: text, target: "Integer")
    return parsed.item0

### Parses a base-16 integer from text.
### :param text: The hexadecimal digits to parse.
