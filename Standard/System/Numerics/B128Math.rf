module System/Numerics

# ============================================================================
# B128 library functions. Each is one call to Ingrid's export (Ingrid/tessera/binfloat.te), which is Tessera's
# correctly rounded B128 routine: the CORE-MATH port where CORE-MATH has the binary128 function, Tessera's own
# correctly rounded one elsewhere. The checked forms crash here, in RazorForge, on a result that is not finite.
# ============================================================================

### Returns `e^me`.
failable routine B128.exp() -> B128
    var rr = me.exp_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `ln(me)`.
failable routine B128.ln() -> B128
    var rr = me.ln_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `e^me - 1`.
failable routine B128.exp_m1() -> B128
    var rr = me.exp_m1_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `ln(1 + me)`.
failable routine B128.ln_1p() -> B128
    var rr = me.ln_1p_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### `ln(1+me)` with raw IEEE (NaN -> qNaN, me=-1 -> -inf, me<-1 -> qNaN, +inf -> +inf). No crash.
routine B128.ln_1p_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_ln_1p(low: me.low_bits(), high: me.high_bits()))

