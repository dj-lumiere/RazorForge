module System/Numerics

import Collections
# IEEE 754 single precision constants
preset B32_EPSILON: B32 = 1.1920929e-7
preset B32_MIN: B32 = -3.4028235e+38
preset B32_MAX: B32 = 3.4028235e+38
preset B32_MIN_POSITIVE: B32 = 1.1754944e-38
preset B32_ZERO: B32 = 0.0
preset B32_ONE: B32 = 1.0
# Mathematical constants
preset B32_PI: B32 = 3.1415927
preset B32_E: B32 = 2.7182817
preset B32_SQRT_2: B32 = 1.4142135
preset B32_LN_2: B32 = 0.6931472
preset B32_LN_10: B32 = 2.3025851

# System B32 type definition - maps to LLVM float

### Represents a 32-bit IEEE 754 binary floating-point value.
### `B32` is the standard single-precision float: compact, fast, and suitable
### for graphics, simulation, and general-purpose numeric code where 24 bits of
### significand precision are acceptable.
@llvm("float")
record B32
obeys Numeric, Comparable, Copyable, Splittable
    nothing

### Converts an `S8` into single-precision floating-point form.
### :returns: The corresponding `B32` value.
@inline
routine S8.to[B32]() -> B32
    return LLVM::signed_to_float[S8, B32](me)

### Converts an `S16` into single-precision floating-point form.
### :returns: The corresponding `B32` value.
@inline
routine S16.to[B32]() -> B32
    return LLVM::signed_to_float[S16, B32](me)

### Converts an `S32` into single-precision floating-point form.
### :returns: The closest representable `B32` value.
@inline
routine S32.to[B32]() -> B32
    return LLVM::signed_to_float[S32, B32](me)

### Converts an `S64` into single-precision floating-point form.
### Precision may be rounded when the integer cannot be represented exactly.
### :returns: The closest representable `B32` value.
@inline
routine S64.to[B32]() -> B32
    return LLVM::signed_to_float[S64, B32](me)

### Converts an `S128` into single-precision floating-point form.
### :returns: The closest representable `B32` value under the target rounding rules.
@inline
routine S128.to[B32]() -> B32
    return LLVM::signed_to_float[S128, B32](me)

### Converts a `U8` into single-precision floating-point form.
### :returns: The corresponding `B32` value.
@inline
routine U8.to[B32]() -> B32
    return LLVM::unsigned_to_float[U8, B32](me)

### Converts a `U16` into single-precision floating-point form.
### :returns: The corresponding `B32` value.
@inline
routine U16.to[B32]() -> B32
    return LLVM::unsigned_to_float[U16, B32](me)

### Converts a `U32` into single-precision floating-point form.
### :returns: The closest representable `B32` value.
@inline
routine U32.to[B32]() -> B32
    return LLVM::unsigned_to_float[U32, B32](me)

### Converts a `U64` into single-precision floating-point form.
### :returns: The closest representable `B32` value.
@inline
routine U64.to[B32]() -> B32
    return LLVM::unsigned_to_float[U64, B32](me)

### Converts `U128` to `B32`.
### Checked: a value past the `B32` range crashes. {U128.to_unchecked[B32]} gives the infinity instead.
### :returns: The nearest `B32` value.
### :throws: {NumericOverflowError} if `me` rounds past the `B32` range.
failable routine U128.to[B32]() -> B32
    return me.to_unchecked[B32]().finite()

### Converts `U128` to `B32`.
### Unchecked: a value past the `B32` range gives an infinity, where {U128.to[B32]} crashes.
### :returns: The nearest `B32` value.
routine U128.to_unchecked[B32]() -> B32
    return LLVM::unsigned_to_float[U128, B32](me)

### Converts `S256` to `B32`.
### Checked: a value past the `B32` range crashes. {S256.to_unchecked[B32]} gives the infinity instead.
### :returns: The nearest `B32` value.
### :throws: {NumericOverflowError} if `me` rounds past the `B32` range.
failable routine S256.to[B32]() -> B32
    return me.to_unchecked[B32]().finite()

### Converts `S256` to `B32`.
### Unchecked: a value past the `B32` range gives an infinity, where {S256.to[B32]} crashes.
### :returns: The nearest `B32` value.
routine S256.to_unchecked[B32]() -> B32
    return LLVM::signed_to_float[S256, B32](me)

### Converts `U256` to `B32`.
### Checked: a value past the `B32` range crashes. {U256.to_unchecked[B32]} gives the infinity instead.
### :returns: The nearest `B32` value.
### :throws: {NumericOverflowError} if `me` rounds past the `B32` range.
failable routine U256.to[B32]() -> B32
    return me.to_unchecked[B32]().finite()

### Converts `U256` to `B32`.
### Unchecked: a value past the `B32` range gives an infinity, where {U256.to[B32]} crashes.
### :returns: The nearest `B32` value.
routine U256.to_unchecked[B32]() -> B32
    return LLVM::unsigned_to_float[U256, B32](me)

### Widens a half-precision float to single precision.
### :returns: An `B32` carrying the same numeric value when representable.
@inline
routine B16.to[B32]() -> B32
    return LLVM::float_extend[B16, B32](me)

### Widens a bfloat16 value to single precision (exact: bfloat16 is the top half of a `B32`).
### :returns: The same value as a `B32`.
routine BF16.to[B32]() -> B32
    return B32.from_bits(bits: LLVM::zero_extend[U16, U32](me.to_bits()) << 16)

### Returns an existing `B32` unchanged.
### :returns: this value.
@inline
routine B32.to[B32]() -> B32
    return me

### Narrows a double-precision float to single precision.
### Checked: a finite value past the `B32` range crashes. {B64.to_unchecked[B32]} gives the infinity instead. An
### infinity stays infinite and a NaN stays a NaN.
### :returns: The nearest `B32` value.
### :throws: {NumericOverflowError} if a finite `me` rounds past the `B32` range.
failable routine B64.to[B32]() -> B32
    var r = me.to_unchecked[B32]()
    if r.is_infinite() and me.is_finite()
        throw NumericOverflowError(description: "overflow: out of the B32 range")
    return r

### Narrows a double-precision float to single precision.
### Unchecked: a value past the `B32` range gives an infinity, where {B64.to[B32]} crashes.
### :returns: The nearest `B32` value.
@inline
routine B64.to_unchecked[B32]() -> B32
    return LLVM::float_narrow[B64, B32](me)

### (`B32(from: B128)` is provided by the quadruple-precision engine — `B128.rf` — which owns
### the bit-surgery narrowing; a forwarding stub here would recurse into itself.)

### Converts a decimal32 value to single-precision binary floating point.
### Checked: a finite value past the `B32` range crashes. {D32.to_unchecked[B32]} gives the infinity instead. An
### infinity stays infinite and a NaN stays a NaN.
### :returns: The nearest `B32` value.
### :throws: {NumericOverflowError} if a finite `me` rounds past the `B32` range.
failable routine D32.to[B32]() -> B32
    var r = me.to_unchecked[B32]()
    if r.is_infinite() and me.is_finite()
        throw NumericOverflowError(description: "overflow: out of the B32 range")
    return r

### Converts a decimal32 value to single-precision binary floating point.
### Unchecked: a value past the `B32` range gives an infinity, where {D32.to[B32]} crashes.
### :returns: The nearest `B32` value.
routine D32.to_unchecked[B32]() -> B32
    return B32.from_bits(bits: LLVM::int_truncate[U128, U32](d32_to_binary(x: me, which: 32)))

### Converts a decimal64 value to single-precision binary floating point.
### Checked: a finite value past the `B32` range crashes. {D64.to_unchecked[B32]} gives the infinity instead. An
### infinity stays infinite and a NaN stays a NaN.
### :returns: The nearest `B32` value.
### :throws: {NumericOverflowError} if a finite `me` rounds past the `B32` range.
failable routine D64.to[B32]() -> B32
    var r = me.to_unchecked[B32]()
    if r.is_infinite() and me.is_finite()
        throw NumericOverflowError(description: "overflow: out of the B32 range")
    return r

### Converts a decimal64 value to single-precision binary floating point.
### Unchecked: a value past the `B32` range gives an infinity, where {D64.to[B32]} crashes.
### :returns: The nearest `B32` value.
routine D64.to_unchecked[B32]() -> B32
    return B32.from_bits(bits: LLVM::int_truncate[U128, U32](d64_to_binary(x: me, which: 32)))

### Converts a decimal128 value to single-precision binary floating point.
### Checked: a finite value past the `B32` range crashes. {D128.to_unchecked[B32]} gives the infinity instead. An
### infinity stays infinite and a NaN stays a NaN.
### :returns: The nearest `B32` value.
### :throws: {NumericOverflowError} if a finite `me` rounds past the `B32` range.
failable routine D128.to[B32]() -> B32
    var r = me.to_unchecked[B32]()
    if r.is_infinite() and me.is_finite()
        throw NumericOverflowError(description: "overflow: out of the B32 range")
    return r

### Converts a decimal128 value to single-precision binary floating point.
### Unchecked: a value past the `B32` range gives an infinity, where {D128.to[B32]} crashes.
### :returns: The nearest `B32` value.
routine D128.to_unchecked[B32]() -> B32
    return B32.from_bits(bits: LLVM::int_truncate[U128, U32](d128_to_binary(x: me, which: 32)))

# ============================================================================
# Arithmetic Operations (IEEE 754 semantics)
# ============================================================================

# Checked arithmetic crashes with a specific cause on a non-finite result (mirrors B64/Decimal):
# ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 -> DivisionByZeroError. `@crash_only`
# keeps the callers non-failable. Use the `*_unchecked` operators for raw IEEE 754 propagation.

### Returns `me + you`. Checked: crashes if the IEEE result is non-finite. Use `add_unchecked` for
### raw IEEE.
### :param you: The addend.
### :returns: The single-precision sum (always finite).
@readonly
failable routine B32.add(you: B32) -> B32
    var r = LLVM::float_add[B32](a: me, b: you)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me - you`. Checked: crashes if the IEEE result is non-finite. Use `sub_unchecked` for
### raw IEEE.
### :param you: The value to subtract.
### :returns: The single-precision difference (always finite).
@readonly
failable routine B32.sub(you: B32) -> B32
    var r = LLVM::float_sub[B32](a: me, b: you)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me + you`, promoting the real `me` to complex (imaginary part 0). Only `+`/`-` allow
### real↔complex mixing; the component width must match (B32 pairs with C64).
### :param you: The complex addend.
### :returns: The complex sum.
routine B32.add(you: C64) -> C64
    return me.to[C64]().add(you)

### Returns `me - you`, promoting the real `me` to complex (imaginary part 0).
### :param you: The complex value to subtract.
### :returns: The complex difference.
routine B32.sub(you: C64) -> C64
    return me.to[C64]().sub(you)

### Returns `me * you`. Checked: crashes if the IEEE result is non-finite. Use `mul_unchecked` for
### raw IEEE.
### :param you: The multiplier.
### :returns: The single-precision product (always finite).
@readonly
failable routine B32.mul(you: B32) -> B32
    var r = LLVM::float_mul[B32](a: me, b: you)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me / you`. Checked: `x/0` -> DivisionByZeroError, `0/0` -> domain, overflow ->
### overflow.
### Use `truediv_unchecked` for raw IEEE 754, or `(a / b).finite()` for recoverable handling.
### :param you: The divisor.
### :returns: The single-precision quotient (always finite).
@readonly
failable routine B32.truediv(you: B32) -> B32
    var r = LLVM::float_div[B32](a: me, b: you)
    if r.is_finite()
        return r
    if you.is_zero() and not me.is_zero()
        throw DivisionByZeroError()
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me` if it is finite; throws if it is ±infinity or NaN. The opt-in
### finiteness assertion for IEEE arithmetic, e.g. `var x = (a * b + c).finite()`.
### :returns: `me`, when finite.
### :throws: {NumericOverflowError} if `me` is ±infinity or NaN.
failable routine B32.finite() -> B32
    if not me.is_finite()
        throw NumericOverflowError(description: f"B32 value is non-finite: {me}")
    return me

### Returns the negated value.
### :returns: The resulting `B32` value.
@readonly
routine B32.neg() -> B32
    return LLVM::float_neg[B32](me)

# Unchecked variants — raw IEEE 754 propagation (the float analog of integer `+%`/`+^`). Plain
# (NOT `dangerous`): inf/NaN are valid IEEE values, the `_unchecked` spelling is the marker.

### Returns `me / you` with raw IEEE 754 semantics: `x/0` -> ±infinity, `0/0` -> NaN. No crash.
routine B32.truediv_unchecked(you: B32) -> B32
    return LLVM::float_div[B32](a: me, b: you)

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B32.add_unchecked(you: B32) -> B32
    return LLVM::float_add[B32](a: me, b: you)

### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B32.sub_unchecked(you: B32) -> B32
    return LLVM::float_sub[B32](a: me, b: you)

### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B32.mul_unchecked(you: B32) -> B32
    return LLVM::float_mul[B32](a: me, b: you)

# ============================================================================
# Comparison Operations (ordered - false if NaN)
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine B32.eq(you: B32) -> Bool
    return LLVM::float_eq[B32](a: me, b: you)

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine B32.compare(you: B32) -> ComparisonSign
    if LLVM::float_lt[B32](a: me, b: you)
        return ME_SMALL
    if LLVM::float_gt[B32](a: me, b: you)
        return ME_LARGE
    return SAME

# ============================================================================
# Math Operations using intrinsics
# ============================================================================

### Returns the square root of this value in single precision.
### :returns: The intrinsic square-root result for `me`.
failable routine B32.sqrt() -> B32
    var rr = me.sqrt_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Square root with raw IEEE 754 propagation (`sqrt(<0)` -> NaN). Thin wrapper over LLVM `sqrt`.
routine B32.sqrt_unchecked() -> B32
    return LLVM::sqrt[B32](me)

### Returns the absolute value.
### :returns: The resulting `B32` value.
routine B32.abs() -> B32
    return LLVM::float_abs[B32](me)

### Rounds this value toward negative infinity.
### :returns: The greatest integral-valued `B32` not larger than `me`.
routine B32.floor() -> B32
    return LLVM::floor[B32](me)

### Rounds this value toward positive infinity.
### :returns: The smallest integral-valued `B32` not smaller than `me`.
routine B32.ceil() -> B32
    return LLVM::ceil[B32](me)

### Rounds this value to the nearest integral-valued `B32`.
### :returns: The rounded result in single precision.
routine B32.round() -> B32
    return LLVM::round[B32](me)

### Discards the fractional part of this value toward zero.
### :returns: The truncated result in single precision.
routine B32.int_truncate() -> B32
    return LLVM::float_truncate[B32](me)

### Returns `e` raised to this value.
### :returns: The single-precision exponential result.
failable routine B32.exp() -> B32
    var rr = me.exp_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns the natural logarithm of this value.
### :returns: The single-precision natural-log result.
failable routine B32.ln() -> B32
    var rr = me.ln_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns the base-10 logarithm of this value.
### :returns: The single-precision common-log result.
failable routine B32.log10() -> B32
    var rr = me.log10_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Raises this value to `exp` (IEEE semantics: overflow/domain errors yield inf/NaN).
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp` in single precision.
@readonly
failable routine B32.pow(exp: B32) -> B32
    var rr = me.pow_unchecked(exp: exp)
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns this value with its sign bit replaced by the sign of `sign`.
### :param sign: The value supplying the sign bit.
### :returns: A value with the magnitude of `me` and the sign of `sign`.
routine B32.copysign(sign: B32) -> B32
    return LLVM::copysign[B32](me, sign)

# ============================================================================
# Convenience (recip / angle conversion / integer power / midpoint)
# ============================================================================

### Returns the reciprocal `1 / me` (`±∞` for `±0`, following IEEE rules).
### :returns: The multiplicative inverse.
routine B32.recip() -> B32
    return B32_ONE.truediv_unchecked(me)

### Returns `me` converted from radians to degrees (`me × 180 / π`).
### :returns: The angle in degrees.
routine B32.to_degrees() -> B32
    return me.mul_unchecked(180.0).truediv_unchecked(B32_PI)

### Returns `me` converted from degrees to radians (`me × π / 180`).
### :returns: The angle in radians.
routine B32.to_radians() -> B32
    return me.mul_unchecked(B32_PI).truediv_unchecked(180.0)

### Returns `me` raised to the integer power `n`, correctly rounded: the exact `me^n` rounded to the nearest
### `B32` (ties to even), identical on every platform, with raw IEEE 754 propagation. `powi(0)` is 1 for every
### `me`, NaN included.
### :param n: The integer exponent.
### :returns: `me ** n`.
routine B32.powi(n: S32) -> B32
    return C::ingrid_b32_powi(x: me, n: n)

### Returns `(me + you) / 2`, computed without intermediate overflow.
### :param you: The other value.
### :returns: The arithmetic midpoint of `me` and `you`.
routine B32.midpoint(you: B32) -> B32
    var lo = B32_MIN_POSITIVE.mul_unchecked(2.0)
    var hi = B32_MAX.truediv_unchecked(2.0)
    var aa = me.abs()
    var ab = you.abs()
    if aa <= hi and ab <= hi
        return me.add_unchecked(you).truediv_unchecked(2.0)
    if aa < lo
        return me.add_unchecked(you.truediv_unchecked(2.0))
    if ab < lo
        return me.truediv_unchecked(2.0).add_unchecked(you)
    return me.truediv_unchecked(2.0).add_unchecked(you.truediv_unchecked(2.0))

# ============================================================================
# Utility Methods
# ============================================================================

### The smaller of `me` and `you`. If one operand is NaN, the other one.
### :param you: The value to compare with.
### :returns: The smaller value, the other operand when one is NaN, and NaN when both are.
routine B32.min(you: B32) -> B32
    if me.is_nan()
        return you
    if you.is_nan()
        return me
    return if me <= you then me else you
### The larger of `me` and `you`. If one operand is NaN, the other one.
### :param you: The value to compare with.
### :returns: The larger value, the other operand when one is NaN, and NaN when both are.
routine B32.max(you: B32) -> B32
    if me.is_nan()
        return you
    if you.is_nan()
        return me
    return if me >= you then me else you
### Restricts this value to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound to enforce.
### :param max_val: The upper bound to enforce.
### :returns: `me` if already in range, otherwise the nearest bound.
@positional
routine B32.clamp(min_val: B32, max_val: B32) -> B32
    return me.min(max_val).max(min_val)

### Returns `true` if this value is strictly positive (greater than zero).
### :returns: `true` if `me > 0.0`.
routine B32.is_positive() -> Bool
    return me > 0.0

### Returns `true` if this value is strictly negative (less than zero).
### :returns: `true` if `me < 0.0`.
routine B32.is_negative() -> Bool
    return me < 0.0

### Returns `true` if this value compares equal to zero.
### :returns: `true` if `me == 0.0`.
@readonly
routine B32.is_zero() -> Bool
    return me == 0.0

### Returns `true` when this value encodes an IEEE 754 NaN.
### :returns: Whether the bit pattern represents a not-a-number payload.
routine B32.is_nan() -> Bool
    var bits = me.to_bits()
    var exponent = LLVM::bit_and(a: bits, b: 0x7F800000)
    var mantissa = LLVM::bit_and(a: bits, b: 0x007FFFFF)
    return exponent == 0x7F800000 and mantissa != 0

### True when this is a SIGNALING NaN (quiet bit clear). Arithmetic only makes quiet NaN.
routine B32.is_signaling() -> Bool
    return me.is_nan() and LLVM::bit_and(a: me.to_bits(), b: 0x00400000) == 0

### Returns `true` when this value encodes positive or negative infinity.
### :returns: Whether the bit pattern represents an infinity.
routine B32.is_infinite() -> Bool
    var bits = me.to_bits()
    var exponent = LLVM::bit_and(a: bits, b: 0x7F800000)
    var mantissa = LLVM::bit_and(a: bits, b: 0x007FFFFF)
    return exponent == 0x7F800000 and mantissa == 0

### Returns `true` when this value is neither NaN nor infinity.
### :returns: Whether the value is finite.
routine B32.is_finite() -> Bool
    return not me.is_nan() and not me.is_infinite()

### Returns the sign of this value as `-1.0`, `0.0`, or `1.0`.
### :returns: A unit-sign value describing the sign of `me`.
routine B32.signum() -> B32
    return when
        me > 0.0 => 1.0
        me < 0.0 => -1.0
        else => 0.0

# ============================================================================
# Type Conversions
# ============================================================================

### Reinterprets this float as its raw IEEE 754 bit pattern.
### :returns: The underlying `U32` encoding of this value.
routine B32.to_bits() -> U32
    return LLVM::reinterpret_bits[B32, U32](me)

### Reinterprets a raw IEEE 754 bit pattern as an `B32`.
### :param bits: The exact single-precision encoding to decode.
### :returns: The `B32` value with that bit pattern.
common routine B32.from_bits(bits: U32) -> B32
    return LLVM::reinterpret_bits[U32, B32](bits)

### Returns a signaling NaN (interop/testing; never produced by arithmetic).
common routine B32.signaling_nan() -> B32
    return B32.from_bits(bits: 0x7F800001)

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the shortest decimal text that reads back as this exact value (`B32(from_text:)`
### round-trips it bit for bit).
### :returns: The resulting `Text` value.
@override
routine B32.represent() -> Text
    if me.is_signaling()
        return "snan"
    return float_text(low: LLVM::zero_extend[U32, U64](me.to_bits()), high: 0, format: 1, style: 0, digits: 0)

### Renders this value to `sig_digits` significant decimal digits with C `%g`
### layout, rounded half to even from the exact value (Ingrid's text, widened to B64 exactly first).
### :param sig_digits: The number of significant decimal digits (>= 1).
### :returns: The resulting `Text` value.
routine B32.to_text(sig_digits: U64) -> Text
    return float_text(low: me.to[B64]().to_bits(), high: 0, format: 0, style: 1, digits: sig_digits)

### Renders this value with exactly `places` digits after the point, rounded half to even from its
### exact value (`2.675.fixed(2)` is `2.67`, since the stored double is just below 2.675). The integer
### part is always written out in full, never in exponent form.
### :param places: The number of digits after the point (0 for none).
### :returns: The rendered `Text`.
@readonly
routine B32.fixed(places: U64) -> Text
    return float_text(low: me.to[B64]().to_bits(), high: 0, format: 0, style: 2, digits: places)

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@override
routine B32.diagnose() -> Text
    if me.is_signaling()
        return "B32(snan)"
    return float_text(low: LLVM::zero_extend[U32, U64](me.to_bits()), high: 0, format: 1, style: 3, digits: 0)

### Implements the wired routine behavior for this value.
### :returns: The resulting `B32` value.
### :throws: May throw {InvalidValueError}.
failable routine Text.to[B32]() -> B32
    var w = float_parse(text: me, format: 1)
    if w.w0 == 3
        throw InvalidValueError(input: me, target: "B32")
    if w.w0 == 1
        return nan
    return B32.from_bits(bits: LLVM::int_truncate[U64, U32](w.w1))

# ============================================================================
# Hashing
# ============================================================================

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
### :returns: The resulting `Array[Byte, 4]` value.
routine B32.to_bytes_le() -> Array[Byte, 4]
    var raw = LLVM::reinterpret_bits[B32, U32](me)
    var result = Array[Byte, 4]()
    result = LLVM::set_byte_at(array: result, index: 0, value: LLVM::int_truncate[U32, U8](raw))
    result = LLVM::set_byte_at(
        array: result,
        index: 1,
        value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 8)),
    )
    result = LLVM::set_byte_at(
        array: result,
        index: 2,
        value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 16)),
    )
    result = LLVM::set_byte_at(
        array: result,
        index: 3,
        value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 24)),
    )
    return result

### Returns the raw bytes of this value in big-endian order.
### :returns: The resulting `Array[Byte, 4]` value.
routine B32.to_bytes_be() -> Array[Byte, 4]
    var raw = LLVM::byte_swap(LLVM::reinterpret_bits[B32, U32](me))
    var result = Array[Byte, 4]()
    result = LLVM::set_byte_at(array: result, index: 0, value: LLVM::int_truncate[U32, U8](raw))
    result = LLVM::set_byte_at(
        array: result,
        index: 1,
        value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 8)),
    )
    result = LLVM::set_byte_at(
        array: result,
        index: 2,
        value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 16)),
    )
    result = LLVM::set_byte_at(
        array: result,
        index: 3,
        value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 24)),
    )
    return result

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
routine B32.hash(k0: U64, k1: U64) -> U64
    return __secure_hash_u64(
        v: LLVM::zero_extend[U32, U64](LLVM::reinterpret_bits[B32, U32](me)),
        k0: k0,
        k1: k1,
    )

# ============================================================================
# Runtime externs (rf_b32_* in native/runtime/math_functions.c) for the exact
# operations. The transcendental functions and hypot are CORE-MATH ports in the
# files of this folder, and the basic ops use LLVM intrinsics.
# ============================================================================
### C libm extern: IEEE remainder (C remainder).
routine C::rf_b32_rem(x: B32, y: B32) -> B32

### C libm extern: positive difference max(x - y, 0) (C fdim).
routine C::rf_b32_fdim(x: B32, y: B32) -> B32

### C libm extern: next representable value after x toward y.
routine C::rf_b32_nextafter(x: B32, y: B32) -> B32

### C libm extern: x * 2^n (C scalbn).
routine C::rf_b32_scalbn(value: B32, n: S64) -> B32

### C libm extern: unbiased radix-2 exponent as an integer (C ilogb).
routine C::rf_b32_ilogb(value: B32) -> S64

### Arc sine.
failable routine B32.asin() -> B32
    var rr = me.asin_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Arc cosine.
failable routine B32.acos() -> B32
    var rr = me.acos_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Hyperbolic sine.
failable routine B32.sinh() -> B32
    var rr = me.sinh_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

