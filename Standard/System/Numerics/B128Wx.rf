module System/Numerics

# ============================================================================
# B128Wx — a 384-bit binary value with a relative error bound, for B128Math's fused operations.
# A value is (-1)^neg * m * 2^e with m a 384-bit integer (limbs m2 m1 m0, m2 the most significant, its top
# bit set; the value is zero when m2 is 0) and a bound rel on its relative error that every operation
# carries, as B128Fx does at 128 bits. wx_b128 rounds it once to B128.
# ============================================================================

### A 384-bit binary value with a relative error bound.
secret record B128Wx
    neg: Bool
    m2: U128
    m1: U128
    m0: U128
    e: S64
    rel: B64

### Zero, exact when rel is 0 (a sum that cancels to zero from inexact operands carries an unbounded rel).
@inline
secret routine wx_zero(rel: B64) -> B128Wx
    return B128Wx(neg: false, m2: 0, m1: 0, m0: 0, e: 0, rel: rel)

@inline
secret routine wx_is_zero(w: B128Wx) -> Bool
    return w.m2 == 0

### The significand as the (low, middle, high) triple the 384-bit helpers take.
@inline
secret routine wx_t(w: B128Wx) -> (U128, U128, U128)
    return (w.m0, w.m1, w.m2)

### (-1)^neg * t * 2^e for a 384-bit t, normalized (zero when t is).
secret routine wx_make(neg: Bool, t: (U128, U128, U128), e: S64, rel: B64) -> B128Wx
    var lz = b128_trig_lz384(x: t)
    if lz == 384
        return wx_zero(rel: rel)
    var s = b128_trig_shl384(x: t, shift: lz)
    return B128Wx(neg: neg, m2: s.item2, m1: s.item1, m0: s.item0, e: e -% lz, rel: rel)

### floor(log2 |w|) for a nonzero w.
@inline
secret routine wx_ilog2(w: B128Wx) -> S64
    return w.e +% 383

### A 384-bit integer as a B64 within 2^-52 of it.
secret routine wx_t_b64(t: (U128, U128, U128)) -> B64
    var lz = b128_trig_lz384(x: t)
    if lz == 384
        return 0.0
    var s = b128_trig_shl384(x: t, shift: lz)
    return b128fx_top(m: s.item2) *! b128fx_p2(k: 320 -% lz)

### Whether a > b as 384-bit integers.
@inline
secret routine wx_t_gt(a: (U128, U128, U128), b: (U128, U128, U128)) -> Bool
    if a.item2 != b.item2
        return a.item2 > b.item2
    if a.item1 != b.item1
        return a.item1 > b.item1
    return a.item0 > b.item0

### (whether the band settles it, the IEEE bits) of w rounded to nearest-even in a binary format with a p-bit
### significand, exponent bias emax and the sign bit at sbit: subnormal results and overflow to infinity
### included. Unsettled means w's band reaches the midpoint between two neighbours (force rounds anyway).
secret routine wx_round_ieee(w: B128Wx, p: S64, emax: S64, sbit: S64, force: Bool) -> (Bool, U128)
    var sign: U128 = 0
    if w.neg
        sign = 1 << b128_trig_sh(n: sbit)
    if wx_is_zero(w: w)
        return (force or w.rel == 0.0, sign)
    var pw = b128_trig_sh(n: p -% 1)
    var lead = wx_ilog2(w: w)
    if lead > emax
        return (
            true,
            sign | (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](emax *% 2 +% 1)) << pw),
        )
    var emin = 1 -% emax
    var k = p
    if lead < emin
        k = p -% (emin -% lead)
    if k < -2
        return (force or w.rel < 0.25, sign)
    var t = wx_t(w: w)
    var keep: U128 = 0
    var rs = t
    var trunc = 0.0
    if k > 0
        keep = w.m2 >>> b128_trig_sh(n: 128 -% k)
        rs = b128_trig_shl384(x: t, shift: k)
    elseif k < 0
        rs = b128_trig_shr384(x: t, shift: 0 -% k)
        trunc = 1.0
    # the dropped bits against one half of the last kept place, in units of 2^-384 of it
    var half: (U128, U128, U128) = (0, 0, 1 << 127)
    var above = not wx_t_gt(a: half, b: rs)
    var dist = b128_trig_sub384(a: half, b: rs)
    if above
        dist = b128_trig_sub384(a: rs, b: half)
    var errb = w.rel *! b128fx_top(m: w.m2) *! b128fx_p2(k: 320 +% k) *! (1.0 +! 0x1p-50) +! trunc
    var ok = force or errb == 0.0 or wx_t_b64(t: dist) > errb
    if above and (b128_trig_lz384(x: dist) < 384 or (keep & 1) == 1)
        keep = keep +% 1
    var bits = keep
    if lead >= emin
        bits = (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](lead +% emax)) << pw) +% (keep -% (1 << pw))
    return (ok, sign | bits)

### w rounded to a B128, and whether its band settles that.
secret routine wx_to_b128(w: B128Wx, force: Bool) -> (Bool, B128)
    var (ok, bits) = wx_round_ieee(w: w, p: 113, emax: 16383, sbit: 127, force: force)
    return (ok, B128.from_bits(bits: bits))

### w rounded to a B128 as it stands.
@inline
secret routine wx_b128(w: B128Wx) -> B128
    return wx_to_b128(w: w, force: true).item1
