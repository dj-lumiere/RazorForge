module System/Numerics

### Represents an arbitrary-precision signed integer, computed by the integer engine in Ingrid.
### `Int` is the unbounded integer type for workloads where fixed-width overflow is not acceptable.
### It preserves exact integer semantics across arithmetic, parsing, and formatting operations.
###
### `Int` is a record of two words (value semantics from the user's view). A value in the `S64` range is held in the
### value itself, so small numbers need no heap and are computed without calling the engine. A value outside it is a
### read-only list of 64-bit limbs shared by copies: copying shares the list (no number data is copied), and the last
### copy to go ends it. Division is Euclidean: `a // b` and `a % b`
### satisfy `a == b * (a // b) + a % b` with `0 <= a % b < |b|`. The bitwise operators act on the two's-complement
### form. There is no `/`: an integer quotient is `//`, and a fractional one is computed in `Decimal`.
### :see: {Decimal}
record Int
obeys Copyable, Integral, Negatable, Comparable, Hashable
    ### The list holding the magnitude of a value outside the `S64` range as little-endian limbs with a nonzero top
    ### limb, shared read-only by copies. Hollow for a value in the `S64` range.
    secret owner: Guarded[List[U64], ReadOnly]
    ### For a value in the `S64` range (`owner` hollow), its `S64` two's-complement bits. For a value outside it, 1
    ### when it is negative, else 0.
    secret meta: U64

### The limbs one engine call reads for a value: its own limbs, or a one-limb buffer made for the call that `temp`
### says to free afterward.
record IntegerLimbView
    ### The number of limbs (0 for zero).
    secret len: U64
    ### The limbs.
    secret tab: Hijacked[U64]
    ### Whether `tab` was made for this call.
    secret temp: Bool
    ### Whether the value is negative.
    secret neg: Bool

# ============================================================================
# Small values and limbs
# ============================================================================

# The `Int` with the `S64` bits `bits`.
@inline
secret routine integer_of_bits(bits: S64) -> Int
    danger
        return Int(owner: Guarded[List[U64], ReadOnly].hollow(), meta: LLVM::reinterpret_bits[S64, U64](bits))

# The `S64` bits of a value in the `S64` range.
@inline
secret routine integer_bits(v: Int) -> S64
    return LLVM::reinterpret_bits[U64, S64](v.meta)

# The magnitude of the `S64` value `bits` (2^63 for `S64_MIN`).
@inline
secret routine integer_bits_magnitude(bits: S64) -> U64
    var u = LLVM::reinterpret_bits[S64, U64](bits)
    if bits < 0
        return 0 -% u
    return u

# Whether `v` is negative.
@inline
secret routine integer_negative(v: Int) -> Bool
    if v.owner.is_hollow()
        return integer_bits(v: v) < 0
    return v.meta != 0

# The zero `Int`.
@inline
secret routine integer_zero() -> Int
    return integer_of_bits(bits: 0)

# The `Int` with magnitude `mag`, negative when `neg` (zero stays non-negative). One in the `S64` range is held in the
# value, a bigger one gets a one-limb list.
@inline
secret routine integer_small(neg: Bool, mag: U64) -> Int
    if neg and mag <= 9223372036854775808
        return integer_of_bits(bits: LLVM::reinterpret_bits[U64, S64](0 -% mag))
    if not neg and mag <= 9223372036854775807
        return integer_of_bits(bits: LLVM::reinterpret_bits[U64, S64](mag))
    return integer_one_limb(neg: neg, mag: mag)

# The `Int` with magnitude `mag` (outside the `S64` range for its sign) as a one-limb list, negative when `neg`.
secret routine integer_one_limb(neg: Bool, mag: U64) -> Int
    danger
        var tab = limb_buffer(n: 1)
        tab.poke(value: mag)
        return integer_over_limbs(neg: neg, tab: tab, len: 1)

# The `Int` over `len` limbs (a magnitude outside the `S64` range) in `tab`, a buffer from `limb_buffer` it takes
# over, negative when `neg`.
secret dangerous routine integer_over_limbs(neg: Bool, tab: Hijacked[U64], len: U64) -> Int
    var limbs = List[U64](over: tab, count: len)
    return Int(owner: Guarded[List[U64], ReadOnly](from: limbs), meta: sign_word(neg: neg))

# The `Int` with magnitude `hi * 2^64 + lo`, negative when `neg`.
secret routine integer_two_limbs(neg: Bool, lo: U64, hi: U64) -> Int
    if hi == 0
        return integer_small(neg: neg, mag: lo)
    danger
        var tab = limb_buffer(n: 2)
        tab.poke(value: lo)
        tab.stride(count: 1).poke(value: hi)
        return integer_over_limbs(neg: neg, tab: tab, len: 2)

# The `Int` equal to `v`.
secret routine integer_of_s128(v: S128) -> Int
    var neg = LLVM::signed_lt[S128](a: v, b: 0)
    var mag = LLVM::reinterpret_bits[S128, U128](v)
    if neg
        mag = 0 -% mag
    return integer_two_limbs(neg: neg, lo: LLVM::int_truncate[U128, U64](mag), hi: LLVM::int_truncate[U128, U64](mag >>> 64))

# The limbs an engine call reads for `v`: a value outside the `S64` range reads its list, one in it a one-limb buffer
# made for the call. Free them with `limb_view_free`.
secret dangerous routine limb_view(v: Int) -> IntegerLimbView
    if not v.owner.is_hollow()
        # A read token on the list, which does not share it.
        var limbs = v.owner.view()
        return IntegerLimbView(len: limbs.count, tab: limbs.data, temp: false, neg: v.meta != 0)
    var bits = integer_bits(v: v)
    if bits == 0
        return IntegerLimbView(len: 0, tab: Hijacked[U64].hollow(), temp: false, neg: false)
    var tab = limb_buffer(n: 1)
    tab.poke(value: integer_bits_magnitude(bits: bits))
    return IntegerLimbView(len: 1, tab: tab, temp: true, neg: bits < 0)

# Frees what `limb_view` made for a call.
secret dangerous routine limb_view_free(view: IntegerLimbView)
    if view.temp
        limb_free(p: view.tab)
    return

# ============================================================================
# Calls into Ingrid
# ============================================================================
# The bodies are IntEngine.rf, which runs in Ingrid (Ingrid/tessera/generated/numerics.te,
# written from RazorForge/IngridExport/numerics.rf, which describes the call protocol). A value crosses as its sign,
# its limb count and its limbs: a value outside the `S64` range lends its list's buffer, one in it a one-limb buffer
# made for the call. RazorForge allocates every buffer: the result buffer, which becomes the list of the new value,
# and the scratch the engine takes its temporaries from. A call that needs more of either says so, and is made again
# with that much. Two values in the `S64` range mostly never get here: the routines below compute them directly.

# A buffer of `n` limbs for one Ingrid call (none when `n` is 0).
secret dangerous routine limb_buffer(n: U64) -> Hijacked[U64]
    if n == 0
        return Hijacked[U64].hollow()
    return Hijacked[U64](from: C::rf_allocate_dynamic_uninit(size: 8 *% n))

# Frees a buffer from `limb_buffer`.
secret dangerous routine limb_free(p: Hijacked[U64])
    if not p.is_hollow()
        p.invalidate()
    return

# The scratch a retry hands over after a call that had `room` limbs needed `need` at least.
secret routine scratch_retry(room: U64, need: U64) -> U64
    var doubled = room *% 2
    var wanted = need +% need // 2
    return if doubled > wanted then doubled else wanted
# 1 when `neg`, else 0: a sign as it crosses the C ABI and as `meta` holds it outside the `S64` range.
secret routine sign_word(neg: Bool) -> U64
    return if neg then 1 else 0

# The `Int` an Ingrid call left in `out`: `len` limbs, negative when `neg`. A value in the `S64` range is held in the
# value and `out` is freed.
secret dangerous routine integer_adopt(out: Hijacked[U64], len: U64, neg: Bool) -> Int
    if len == 0
        limb_free(p: out)
        return integer_zero()
    if len == 1
        var mag = out.peek()
        if mag <= 9223372036854775807 or (neg and mag == 9223372036854775808)
            limb_free(p: out)
            return integer_small(neg: neg, mag: mag)
    return integer_over_limbs(neg: neg, tab: out, len: len)

# `v` with its sign `neg` (zero stays non-negative), sharing its limbs.
secret routine integer_with_sign(v: Int, neg: Bool) -> Int
    if v.owner.is_hollow()
        return integer_small(neg: neg, mag: integer_bits_magnitude(bits: integer_bits(v: v)))
    danger
        var view = limb_view(v: v)
        # 2^63 is outside the `S64` range, -2^63 is in it.
        if neg and view.len == 1 and view.tab.peek() == 9223372036854775808
            return integer_of_bits(bits: S64_MIN)
    return Int(owner: v.owner, meta: sign_word(neg: neg))

# a + b, or a - b when `negate_b`. Addition needs no scratch: the sum goes straight into its own buffer.
secret routine integer_sum(a: Int, b: Int, negate_b: Bool) -> Int
    if a.owner.is_hollow() and b.owner.is_hollow()
        var x = LLVM::sign_extend[S64, S128](integer_bits(v: a))
        var y = LLVM::sign_extend[S64, S128](integer_bits(v: b))
        if negate_b
            return integer_of_s128(v: x -% y)
        return integer_of_s128(v: x +% y)
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var b_neg = if negate_b then not bv.neg and bv.len != 0 else bv.neg
        var longer = if av.len > bv.len then av.len else bv.len
        var cap = longer +% 1
        var out = limb_buffer(n: cap)
        var w = C::ingrid_integer_add(
            a_neg: sign_word(neg: av.neg),
            a_len: av.len,
            a_tab: av.tab,
            b_neg: sign_word(neg: b_neg),
            b_len: bv.len,
            b_tab: bv.tab,
            out: out,
            out_cap: cap,
        )
        limb_view_free(view: av)
        limb_view_free(view: bv)
        return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)

# The low 64 bits of the magnitude.
@inline
secret routine integer_low_word(v: Int) -> U64
    if v.owner.is_hollow()
        return integer_bits_magnitude(bits: integer_bits(v: v))
    danger
        return limb_view(v: v).tab.peek()

# One two's-complement bitwise operation (0 AND, 1 OR, 2 XOR). It needs no scratch.
secret routine integer_bitop(a: Int, b: Int, op: U32) -> Int
    if a.owner.is_hollow() and b.owner.is_hollow()
        var x = integer_bits(v: a)
        var y = integer_bits(v: b)
        if op == 0
            return integer_of_bits(bits: x & y)
        if op == 1
            return integer_of_bits(bits: x | y)
        return integer_of_bits(bits: x ^ y)
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var longer = if av.len > bv.len then av.len else bv.len
        var cap = longer +% 1
        var out = limb_buffer(n: cap)
        var w = IngridWords(w0: 0, w1: 0, w2: 0, w3: 0)
        if op == 0
            w = C::ingrid_integer_and(
                a_neg: sign_word(neg: av.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: bv.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                out: out,
                out_cap: cap,
            )
        elseif op == 1
            w = C::ingrid_integer_or(
                a_neg: sign_word(neg: av.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: bv.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                out: out,
                out_cap: cap,
            )
        else
            w = C::ingrid_integer_xor(
                a_neg: sign_word(neg: av.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: bv.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                out: out,
                out_cap: cap,
            )
        limb_view_free(view: av)
        limb_view_free(view: bv)
        return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)

# Shifts by `bits` (left when `left`): `a * 2^bits`, or `floor(a / 2^bits)`. It needs no scratch.
secret routine integer_shift(a: Int, bits: U64, left: Bool) -> Int
    if a.owner.is_hollow()
        var x = integer_bits(v: a)
        if x == 0
            return integer_zero()
        if not left
            # A sign-filling shift of the two's-complement bits is the floor of the quotient.
            return integer_of_bits(bits: x >> bits)
        if bits < 64
            return integer_of_s128(v: LLVM::sign_extend[S64, S128](x) << bits)
    danger
        var av = limb_view(v: a)
        var cap: U64 = 0
        if left
            cap = av.len +% bits // 64 +% 1
        else
            var limb_shift = bits // 64
            cap = if limb_shift >= av.len then 1 else av.len -% limb_shift +% 1
        var out = limb_buffer(n: cap)
        var w = IngridWords(w0: 0, w1: 0, w2: 0, w3: 0)
        if left
            w = C::ingrid_integer_shift_left(
                a_neg: sign_word(neg: av.neg),
                a_len: av.len,
                a_tab: av.tab,
                bits: bits,
                out: out,
                out_cap: cap,
            )
        else
            w = C::ingrid_integer_shift_right(
                a_neg: sign_word(neg: av.neg),
                a_len: av.len,
                a_tab: av.tab,
                bits: bits,
                out: out,
                out_cap: cap,
            )
        limb_view_free(view: av)
        return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)

# a * b.
secret routine integer_product(a: Int, b: Int) -> Int
    if a.is_zero() or b.is_zero()
        return integer_zero()
    if a.owner.is_hollow() and b.owner.is_hollow()
        var x = LLVM::sign_extend[S64, S128](integer_bits(v: a))
        var y = LLVM::sign_extend[S64, S128](integer_bits(v: b))
        return integer_of_s128(v: x *% y)
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var cap = av.len +% bv.len
        var room = C::ingrid_integer_mul_scratch_size(a_len: av.len, b_len: bv.len)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_mul(
                a_neg: sign_word(neg: av.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: bv.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                limb_view_free(view: bv)
                return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)
            limb_free(p: out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# The Euclidean quotient and remainder of a / b (b nonzero).
secret routine integer_divmod(a: Int, b: Int) -> (Int, Int)
    if a.owner.is_hollow() and b.owner.is_hollow()
        return (integer_small_quotient(a: a, b: b), integer_small_remainder(a: a, b: b))
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var q_extra = if av.len > bv.len then av.len -% bv.len else 0
        var q_cap = q_extra +% 2
        var r_cap = bv.len
        var room = C::ingrid_integer_divmod_scratch_size(a_len: av.len, b_len: bv.len)
        loop
            var q_out = limb_buffer(n: q_cap)
            var r_out = limb_buffer(n: r_cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_divmod(
                a_neg: sign_word(neg: av.neg),
                a_len: av.len,
                a_tab: av.tab,
                b_neg: sign_word(neg: bv.neg),
                b_len: bv.len,
                b_tab: bv.tab,
                q_out: q_out,
                q_cap: q_cap,
                r_out: r_out,
                r_cap: r_cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                limb_view_free(view: bv)
                return (
                    integer_adopt(out: q_out, len: w.w1, neg: w.w2 != 0),
                    integer_adopt(out: r_out, len: w.w3, neg: false),
                )
            limb_free(p: q_out)
            limb_free(p: r_out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                q_cap = w.w1
                r_cap = w.w2

# a^e.
secret routine integer_power(a: Int, e: U64) -> Int
    danger
        var bits = a.bit_length()
        var av = limb_view(v: a)
        var cap = ((bits.to[U128]() *% e.to[U128]()) // 64).to[U64]() +% 2
        var room = C::ingrid_integer_pow_scratch_size(a_len: av.len, a_bits: bits, e: e)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_pow(
                a_neg: sign_word(neg: av.neg),
                a_len: av.len,
                a_tab: av.tab,
                e: e,
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                return integer_adopt(out: out, len: w.w1, neg: w.w2 != 0)
            limb_free(p: out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# (floor(sqrt(a)), a - floor(sqrt(a))^2) of a non-negative a, the remainder only when `want_rem`.
secret routine integer_root(a: Int, want_rem: Bool) -> (Int, Int)
    danger
        var av = limb_view(v: a)
        var s_cap = (av.len +% 1) // 2 +% 1
        var r_cap = if want_rem then s_cap +% 1 else 0
        var room = C::ingrid_integer_sqrt_scratch_size(a_len: av.len)
        loop
            var s_out = limb_buffer(n: s_cap)
            var r_out = limb_buffer(n: r_cap)
            var scratch = limb_buffer(n: room)
            var w = IngridWords(w0: 0, w1: 0, w2: 0, w3: 0)
            if want_rem
                w = C::ingrid_integer_sqrtrem(
                    a_len: av.len,
                    a_tab: av.tab,
                    s_out: s_out,
                    s_cap: s_cap,
                    r_out: r_out,
                    r_cap: r_cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            else
                w = C::ingrid_integer_sqrt(
                    a_len: av.len,
                    a_tab: av.tab,
                    out: s_out,
                    out_cap: s_cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                return (
                    integer_adopt(out: s_out, len: w.w1, neg: false),
                    integer_adopt(out: r_out, len: w.w3, neg: false),
                )
            limb_free(p: s_out)
            limb_free(p: r_out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                s_cap = w.w1
                r_cap = w.w2

# gcd(|a|, |b|), or lcm(|a|, |b|) when `lcm`.
secret routine integer_gcd_lcm(a: Int, b: Int, lcm: Bool) -> Int
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var cap = if av.len > bv.len then av.len else bv.len
        if lcm
            cap = av.len +% bv.len
        var room = C::ingrid_integer_gcd_scratch_size(a_len: av.len, b_len: bv.len)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = IngridWords(w0: 0, w1: 0, w2: 0, w3: 0)
            if lcm
                w = C::ingrid_integer_lcm(
                    a_len: av.len,
                    a_tab: av.tab,
                    b_len: bv.len,
                    b_tab: bv.tab,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            else
                w = C::ingrid_integer_gcd(
                    a_len: av.len,
                    a_tab: av.tab,
                    b_len: bv.len,
                    b_tab: bv.tab,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: av)
                limb_view_free(view: bv)
                return integer_adopt(out: out, len: w.w1, neg: false)
            limb_free(p: out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# -1 / 0 / 1 comparing values.
secret routine integer_compare(a: Int, b: Int) -> S64
    if a.owner.is_hollow() and b.owner.is_hollow()
        var x = integer_bits(v: a)
        var y = integer_bits(v: b)
        if x < y
            return -1
        return if x > y then 1 else 0
    danger
        var av = limb_view(v: a)
        var bv = limb_view(v: b)
        var result = C::ingrid_integer_compare(
            a_neg: sign_word(neg: av.neg),
            a_len: av.len,
            a_tab: av.tab,
            b_neg: sign_word(neg: bv.neg),
            b_len: bv.len,
            b_tab: bv.tab,
        )
        limb_view_free(view: av)
        limb_view_free(view: bv)
        return result

# `v` in `radix` (2 to 64): an optional '-' then the digits (0-9, A-Z, a-z, '+', '/'), "0" for zero.
secret routine integer_text(v: Int, radix: U64) -> Text
    if v.owner.is_hollow() and radix == 10
        return f"{integer_bits(v: v)}"
    danger
        var view = limb_view(v: v)
        var cap = C::ingrid_integer_text_capacity(a_len: view.len, radix: radix)
        var room = view.len
        loop
            var out = Hijacked[Char](from: C::rf_allocate_dynamic_uninit(size: 4 *% cap))
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_to_text(
                a_neg: sign_word(neg: view.neg),
                a_len: view.len,
                a_tab: view.tab,
                radix: radix,
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                limb_view_free(view: view)
                var text = Text(from_span: out, count: w.w1)
                out.invalidate()
                return text
            out.invalidate()
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# ============================================================================
# Lifecycle Management
# ============================================================================

### Ends this value. A value in the `S64` range has no list to let go of, and a value outside it gives up its share
### of its list of limbs.
@inline
@override
routine Int.destruct()
    if me.owner.is_hollow()
        return
    me.owner.destruct()
    return

### Creates the integer value `0`.
### Use this overload when the surrounding context needs an explicit `Int`
### instead of a fixed-width literal.
### :returns: The resulting `Int` value.
routine Int() -> Int
    return integer_zero()

### Creates an `Int` from a signed 64-bit source value.
### The numeric payload is copied into the arbitrary-precision representation,
### so the result is no longer limited by `S64` range after construction.
### :returns: The resulting `Int` value.
@inline
routine S64.to[Int]() -> Int
    return integer_of_s64(v: me)

### Creates an `Int` from an unsigned 64-bit source value.
### This is the direct widening entry point for exact conversion from native
### unsigned integer data.
### :returns: The resulting `Int` value.
@inline
routine U64.to[Int]() -> Int
    return integer_of_u64(v: me)

# ============================================================================
# Creators — fixed-width integer widenings. Every width is composed from S64/U64
# limbs via shift+add. All are total (any fixed-width integer fits an unbounded
# Int exactly).
# ============================================================================

# The `S64` and `U64` builders the conversions of every width go through.
@inline
routine integer_of_s64(v: S64) -> Int
    return integer_of_bits(bits: v)

@inline
routine integer_of_u64(v: U64) -> Int
    return integer_small(neg: false, mag: v)

### Widens a fixed-width integer into an `Int` (exact). 64-bit limbs go through the
### base builders; wider widths compose them with shift+add.
### :returns: The equal `Int` value.
@inline
routine S8.to[Int]() -> Int
    return integer_of_s64(v: LLVM::sign_extend[S8, S64](me))

@inline
routine S16.to[Int]() -> Int
    return integer_of_s64(v: LLVM::sign_extend[S16, S64](me))

@inline
routine S32.to[Int]() -> Int
    return integer_of_s64(v: LLVM::sign_extend[S32, S64](me))

routine S128.to[Int]() -> Int
    var neg = LLVM::signed_lt[S128](a: me, b: 0)
    var mag = if neg then LLVM::reinterpret_bits[S128, U128](
        LLVM::sub[S128](a: 0, b: me),
    ) else LLVM::reinterpret_bits[S128, U128](me)
    var r = mag.to[Int]()
    return if neg then r.neg() else r
routine S256.to[Int]() -> Int
    var neg = LLVM::signed_lt[S256](a: me, b: 0)
    var mag = if neg then LLVM::reinterpret_bits[S256, U256](
        LLVM::sub[S256](a: 0, b: me),
    ) else LLVM::reinterpret_bits[S256, U256](me)
    var r = mag.to[Int]()
    return if neg then r.neg() else r
### Widens an unsigned fixed-width integer into an `Int` (exact).
### :returns: The equal `Int` value.
@inline
routine U8.to[Int]() -> Int
    return integer_of_u64(v: LLVM::zero_extend[U8, U64](me))

@inline
routine U16.to[Int]() -> Int
    return integer_of_u64(v: LLVM::zero_extend[U16, U64](me))

@inline
routine U32.to[Int]() -> Int
    return integer_of_u64(v: LLVM::zero_extend[U32, U64](me))

routine U128.to[Int]() -> Int
    # value = hi * 2^64 + lo, from the two 64-bit limbs.
    var hi = integer_of_u64(v: LLVM::int_truncate[U128, U64](me >>> 64))
    var lo = integer_of_u64(v: LLVM::int_truncate[U128, U64](me))
    return hi.shift_left(bits: 64).add(other: lo)

routine U256.to[Int]() -> Int
    # value = hi * 2^128 + lo, reusing the U128 widening for each 128-bit half.
    var hi = (LLVM::int_truncate[U256, U128](me >>> 128)).to[Int]()
    var lo = (LLVM::int_truncate[U256, U128](me)).to[Int]()
    return hi.shift_left(bits: 128).add(other: lo)

# Parses `text` in `radix`, or returns (_, false): an optional leading '-', then digits up to the first
# character outside the radix, where the text must end or hold a '\r' or '\n'. Empty digits read as 0.
secret routine integer_parse(text: Text, radix: S32) -> (Int, Bool)
    danger
        var count = text.count()
        var chars = Hijacked[Char](from: C::rf_allocate_dynamic_uninit(size: 4 *% count +% 4))
        var i: U64 = 0
        until i >= count
            chars.stride(count: i.to[S64]()).poke(value: text[i])
            i = i +% 1
        var cap = count *% 6 // 64 +% 2
        var room = cap
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_integer_parse(
                chars: chars,
                count: count,
                radix: radix.to[S64]().to[U64](),
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0
                chars.invalidate()
                return (integer_adopt(out: out, len: w.w1, neg: w.w2 != 0), w.w3 != 0)
            limb_free(p: out)
            if w.w0 == 1
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

### Parses an integer from text using the requested radix (2 to 64).
### The input is an optional leading `-` followed by digits of the selected base (letters are
### case-insensitive up to base 36). A trailing `\r` or `\n` ends the digits; empty digits read as 0.
### :param text: The textual integer representation.
### :param radix: The numeric base to use.
### :returns: The resulting `Int` value.
### :throws: {ValueError} if `text` is not a valid integer in `radix`.
failable routine Int(text: Text, radix: S32 = 10) -> Int
    if radix < 2 or radix > 64
        throw InvalidValueError(input: text, target: "Int")
    var parsed = integer_parse(text: text, radix: radix)
    if not parsed.item1
        throw InvalidValueError(input: text, target: "Int")
    return parsed.item0

### Materializes an `Int` from a decimal digit string its caller has already validated.
### The float conversions call it on the digits they collected. A literal never does: the builder
### lays its limbs down as static data. Infallible, unlike the public `Int(text:)`.
### :param text: The decimal digit string (no suffix, no separators).
### :returns: The resulting `Int` value.
common routine Int.from_literal(text: Text) -> Int
    return integer_parse(text: text, radix: 10).item0

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Adds `other` to this value using exact integer arithmetic.
### No overflow occurs; the storage grows as needed.
### :param other: The value to add.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.add(other: Int) -> Int
    # Two values in the `S64` range are added here, and only a sum outside it or a bigger operand calls the engine.
    if me.owner.is_hollow() and other.owner.is_hollow()
        var sum = LLVM::signed_add_checked[S64](a: integer_bits(v: me), b: integer_bits(v: other))
        if not sum.item1
            return integer_of_bits(bits: sum.item0)
    return integer_sum(a: me, b: other, negate_b: false)

### Subtracts `other` from this value using exact integer arithmetic.
### :param other: The value to subtract.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.sub(other: Int) -> Int
    if me.owner.is_hollow() and other.owner.is_hollow()
        var difference = LLVM::signed_sub_checked[S64](a: integer_bits(v: me), b: integer_bits(v: other))
        if not difference.item1
            return integer_of_bits(bits: difference.item0)
    return integer_sum(a: me, b: other, negate_b: true)

### Multiplies this value by `other` using exact integer arithmetic.
### :param other: The value to multiply by.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.mul(other: Int) -> Int
    if me.owner.is_hollow() and other.owner.is_hollow()
        var product = LLVM::signed_mul_checked[S64](a: integer_bits(v: me), b: integer_bits(v: other))
        if not product.item1
            return integer_of_bits(bits: product.item0)
    return integer_product(a: me, b: other)

### Divides this value by `other` and returns the Euclidean quotient: the `q` for which
### `me - other * q` lies in `[0, |other|)`.
### :param other: The non-zero divisor.
### :returns: The integer quotient.
@inline
@readonly
failable routine Int.floordiv(other: Int) -> Int
    if other.is_zero()
        throw DivisionByZeroError()
    if me.owner.is_hollow() and other.owner.is_hollow()
        return integer_small_quotient(a: me, b: other)
    return integer_divmod(a: me, b: other).item0

### Returns the Euclidean remainder of this value divided by `other`.
### :param other: The non-zero divisor.
### :returns: The remainder, always in `[0, |other|)`.
@inline
@readonly
failable routine Int.mod(other: Int) -> Int
    if other.is_zero()
        throw DivisionByZeroError()
    if me.owner.is_hollow() and other.owner.is_hollow()
        return integer_small_remainder(a: me, b: other)
    return integer_divmod(a: me, b: other).item1

### Returns the additive inverse of this value.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.neg() -> Int
    # Every value in the `S64` range but `S64_MIN` negates in it.
    if me.owner.is_hollow()
        var negated = LLVM::signed_sub_checked[S64](a: 0, b: integer_bits(v: me))
        if not negated.item1
            return integer_of_bits(bits: negated.item0)
    return integer_with_sign(v: me, neg: not integer_negative(v: me))

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values represent the same mathematical integer.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@inline
@readonly
routine Int.eq(you: Int) -> Bool
    # A value has one form only: a value in the `S64` range never equals one outside it.
    if me.owner.is_hollow() or you.owner.is_hollow()
        return me.owner.is_hollow() and you.owner.is_hollow() and me.meta == you.meta
    return integer_compare(a: me, b: you) == 0

### Compares this value with `you` using numeric ordering.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@inline
@readonly
routine Int.compare(you: Int) -> ComparisonSign
    if me.owner.is_hollow() and you.owner.is_hollow()
        var x = integer_bits(v: me)
        var y = integer_bits(v: you)
        if x == y
            return SAME
        return if x < y then ME_SMALL else ME_LARGE
    return integer_compare_sign(a: me, b: you)

# The `compare` of two values one of which is outside the `S64` range.
secret routine integer_compare_sign(a: Int, b: Int) -> ComparisonSign
    var comparison_value = integer_compare(a: a, b: b)
    if comparison_value < 0
        return ME_SMALL
    elseif comparison_value > 0
        return ME_LARGE
    else
        return SAME

# The Euclidean quotient of two values in the `S64` range, `b` nonzero. `S64_MIN // -1` is 2^63, outside it.
@inline
secret routine integer_small_quotient(a: Int, b: Int) -> Int
    var x = integer_bits(v: a)
    var y = integer_bits(v: b)
    var am = integer_bits_magnitude(bits: x)
    var bm = integer_bits_magnitude(bits: y)
    var q = am // bm
    if x >= 0
        return integer_small(neg: y < 0, mag: q)
    # A negative dividend rounds the quotient away from zero unless the division is exact, so the remainder
    # stays at least 0.
    if q *% bm == am
        return integer_small(neg: y >= 0, mag: q)
    return integer_small(neg: y >= 0, mag: q +% 1)

# The Euclidean remainder of two values in the `S64` range, `b` nonzero: in [0, |b|), so it is in the range too.
@inline
secret routine integer_small_remainder(a: Int, b: Int) -> Int
    var x = integer_bits(v: a)
    var bm = integer_bits_magnitude(bits: integer_bits(v: b))
    var r = integer_bits_magnitude(bits: x) % bm
    if x < 0 and r != 0
        r = bm -% r
    return integer_of_bits(bits: LLVM::reinterpret_bits[U64, S64](r))

# ============================================================================
# Bitwise Operations
# ============================================================================

### Computes the bitwise AND of this value and `other` (two's-complement form).
### :param other: The other operand.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.bitand(other: Int) -> Int
    if me.owner.is_hollow() and other.owner.is_hollow()
        return integer_of_bits(bits: integer_bits(v: me) & integer_bits(v: other))
    return integer_bitop(a: me, b: other, op: 0)

### Computes the bitwise OR of this value and `other` (two's-complement form).
### :param other: The other operand.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.bitor(other: Int) -> Int
    if me.owner.is_hollow() and other.owner.is_hollow()
        return integer_of_bits(bits: integer_bits(v: me) | integer_bits(v: other))
    return integer_bitop(a: me, b: other, op: 1)

### Computes the bitwise XOR of this value and `other` (two's-complement form).
### :param other: The other operand.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.bitxor(other: Int) -> Int
    if me.owner.is_hollow() and other.owner.is_hollow()
        return integer_of_bits(bits: integer_bits(v: me) ^ integer_bits(v: other))
    return integer_bitop(a: me, b: other, op: 2)

### Shifts this value left by `bits` positions (`me << bits`): `me * 2^bits`.
### :param bits: The number of bit positions to shift.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.shift_left(bits: U32) -> Int
    # A shift of a value in the `S64` range that stays in it is done here: shifting back gives the value again.
    if me.owner.is_hollow() and bits < 64
        var x = integer_bits(v: me)
        var shifted = x << bits
        if (shifted >> bits) == x
            return integer_of_bits(bits: shifted)
    return integer_shift(a: me, bits: bits.to[U64](), left: true)

### Shifts this value right by `bits` positions (`me >> bits`): `floor(me / 2^bits)`, so `-5 >> 1` is `-3`.
### :param bits: The number of bit positions to shift.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.arith_shift_right(bits: U32) -> Int
    # The sign-filling shift of the two's-complement bits is the floor of the quotient.
    if me.owner.is_hollow()
        return integer_of_bits(bits: integer_bits(v: me) >> bits)
    return integer_shift(a: me, bits: bits.to[U64](), left: false)

### Shifts this value right by `bits` positions filling with zeros (`me >>> bits`). An `Int` has no fixed
### width, so a negative value has no zero-filled form: this is `>>` for a value that is not negative.
### :param bits: The number of bit positions to shift.
### :returns: The resulting `Int` value.
### :throws: {NumericDomainError} when this value is negative.
@inline
@readonly
failable routine Int.logical_shift_right(bits: U32) -> Int
    if integer_negative(v: me)
        throw NumericDomainError(description: ">>> on a negative Int: it has no width to fill with zeros")
    if me.owner.is_hollow()
        return integer_of_bits(bits: integer_bits(v: me) >> bits)
    return integer_shift(a: me, bits: bits.to[U64](), left: false)

# ============================================================================
# Math Operations
# ============================================================================

### Returns the absolute magnitude of this value.
### :returns: The resulting `Int` value.
@inline
@readonly
routine Int.abs() -> Int
    if me.owner.is_hollow()
        return integer_small(neg: false, mag: integer_bits_magnitude(bits: integer_bits(v: me)))
    return integer_with_sign(v: me, neg: false)

### Raises this value to a non-negative integer exponent.
### :param exp: The exponent value.
### :returns: The resulting `Int` value.
@readonly
routine Int.pow(exp: U32) -> Int
    return integer_power(a: me, e: exp.to[U64]())

### Returns the integer square root of this value.
### The result is the greatest integer whose square does not exceed the input.
### :returns: The resulting `Int` value.
### :throws: {NumericDomainError} when this value is negative (it has no real square root).
@readonly
failable routine Int.sqrt() -> Int
    if me.is_negative()
        throw NumericDomainError(description: "sqrt: negative Int has no real square root")
    return integer_root(a: me, want_rem: false).item0

### Returns the integer square root together with its remainder: `(s, r)` with `s = ⌊√me⌋` and
### `r = me - s*s`, so `0 <= r <= 2s` (e.g. `5.sqrtrem()` is `(2, 1)`).
### :returns: The tuple `(root, remainder)`.
### :throws: {NumericDomainError} when this value is negative (it has no real square root).
@readonly
failable routine Int.sqrtrem() -> (Int, Int)
    if me.is_negative()
        throw NumericDomainError(description: "sqrtrem: negative Int has no real square root")
    return integer_root(a: me, want_rem: true)

### Computes the greatest common divisor of this value and `other` (non-negative).
### :param other: The other operand.
### :returns: The resulting `Int` value.
@readonly
routine Int.gcd(other: Int) -> Int
    return integer_gcd_lcm(a: me, b: other, lcm: false)

### Computes the least common multiple of this value and `other` (non-negative, 0 when either is 0).
### :param other: The other operand.
### :returns: The resulting `Int` value.
@readonly
routine Int.lcm(other: Int) -> Int
    return integer_gcd_lcm(a: me, b: other, lcm: true)

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` when this value is exactly zero.
### :returns: The resulting `Bool` value.
@inline
@readonly
routine Int.is_zero() -> Bool
    return me.owner.is_hollow() and me.meta == 0

### Returns `true` when this value is less than zero.
### :returns: The resulting `Bool` value.
@inline
@readonly
routine Int.is_negative() -> Bool
    return integer_negative(v: me)

### Returns `true` when this value is greater than zero.
### :returns: The resulting `Bool` value.
@inline
@readonly
routine Int.is_positive() -> Bool
    return not me.is_zero() and not me.is_negative()

### Returns the sign of this value as `-1`, `0`, or `1`.
### :returns: The resulting `S32` value.
@readonly
routine Int.signum() -> S32
    return when
        me.is_positive() => 1
        me.is_negative() => -1
        else => 0

### Returns `true` when this value is even (divisible by two).
### :returns: The resulting `Bool` value.
@inline
@readonly
routine Int.is_even() -> Bool
    return (integer_low_word(v: me) & 1) == 0

### Returns `true` when this value is odd.
### :returns: The resulting `Bool` value.
@readonly
routine Int.is_odd() -> Bool
    return not me.is_even()

### Returns `true` when this value is a positive power of two (1, 2, 4, 8, ...).
### :returns: The resulting `Bool` value.
@readonly
routine Int.is_power_of_two() -> Bool
    if not me.is_positive()
        return false
    return me.bitand(other: me.sub(other: Int.one())).is_zero()

### Returns the bitwise complement `~me`, defined in the two's-complement sense as `-me - 1`.
### :returns: The resulting `Int` value.
@readonly
routine Int.bitnot() -> Int
    return me.add(other: Int.one()).neg()

### Returns the number of bits in the magnitude of this value (0 for zero).
### :returns: The resulting `U64` value.
@readonly
routine Int.bit_length() -> U64
    if me.owner.is_hollow()
        return 64 -% LLVM::leading_zeros(integer_bits_magnitude(bits: integer_bits(v: me)))
    danger
        var view = limb_view(v: me)
        var top = view.tab.stride(count: (view.len -% 1).to[S64]()).peek()
        return view.len *% 64 -% LLVM::leading_zeros(top)

### Returns the smaller of this value and `other`.
### :param other: The value to compare against.
### :returns: The resulting `Int` value.
@readonly
routine Int.min(other: Int) -> Int
    if me.compare(you: other) == ME_LARGE
        return other.share()
    return me.share()

### Returns the larger of this value and `other`.
### :param other: The value to compare against.
### :returns: The resulting `Int` value.
@readonly
routine Int.max(other: Int) -> Int
    if me.compare(you: other) == ME_SMALL
        return other.share()
    return me.share()

### Clamps this value into the inclusive range `[low, high]`.
### :param low: The lower bound.
### :param high: The upper bound.
### :returns: The resulting `Int` value.
@readonly
routine Int.clamp(low: Int, high: Int) -> Int
    if me.compare(you: low) == ME_SMALL
        return low.share()
    if me.compare(you: high) == ME_LARGE
        return high.share()
    return me.share()

### Divides by `other`, returning the Euclidean quotient and remainder together
### (`me == other * q + r`, `0 <= r < |other|`).
### :param other: The non-zero divisor.
### :returns: A tuple `(quotient, remainder)`.
### :throws: {DivisionByZeroError} when `other` is zero.
@readonly
failable routine Int.divmod(other: Int) -> (Int, Int)
    if other.is_zero()
        throw DivisionByZeroError()
    return integer_divmod(a: me, b: other)

### Modular exponentiation `me^exp mod modulus` via right-to-left binary exponentiation
### (each step reduced modulo `modulus`, so intermediates never blow up).
### :param exp: The non-negative exponent.
### :param modulus: The non-zero modulus.
### :returns: The resulting `Int` value in `[0, modulus)`.
### :throws: {DivisionByZeroError} when `modulus` is zero; {NumericDomainError} when `exp` is negative.
@readonly
failable routine Int.modpow(exp: Int, modulus: Int) -> Int
    if modulus.is_zero()
        throw DivisionByZeroError()
    if exp.is_negative()
        throw NumericDomainError(description: "modpow: negative exponent")
    var result = Int.one()
    var base = me.mod(other: modulus)
    var e = exp.share()
    until e.is_zero()
        if e.is_odd()
            result = result.mul(other: base).mod(other: modulus)
        e = e.arith_shift_right(bits: 1)
        base = base.mul(other: base).mod(other: modulus)
    return result

# ============================================================================
# Conversions
# ============================================================================

### Converts an arbitrary-precision integer to `S64`.
### :returns: The resulting `S64` value.
### :throws: {IntegerOverflowError} if this value is outside `S64_MIN..S64_MAX`.
@inline
failable routine Int.to[S64]() -> S64
    # Every value in the `S64` range is held in the value, and none outside it is.
    if not me.owner.is_hollow()
        throw IntegerOverflowError()
    return integer_bits(v: me)

### Converts an arbitrary-precision integer to `U64`.
### :returns: The resulting `U64` value.
### :throws: {IntegerOverflowError} if this value is negative or exceeds `U64_MAX`.
@inline
failable routine Int.to[U64]() -> U64
    if me.owner.is_hollow()
        if integer_bits(v: me) < 0
            throw IntegerOverflowError()
        return me.meta
    return integer_wide_u64(v: me)

# The `U64` equal to `v`, a value outside the `S64` range: 2^63 to 2^64 - 1 is one non-negative limb.
secret failable routine integer_wide_u64(v: Int) -> U64
    danger
        var view = limb_view(v: v)
        if view.neg or view.len != 1
            throw IntegerOverflowError()
        return view.tab.peek()

### Converts an arbitrary-precision integer to `S8`.
### :returns: The resulting `S8` value.
### :throws: {IntegerOverflowError} if this value is outside the `S8` range.
failable routine Int.to[S8]() -> S8
    return me.to[S64]().to[S8]()

### Converts an arbitrary-precision integer to `S16`.
### :returns: The resulting `S16` value.
### :throws: {IntegerOverflowError} if this value is outside the `S16` range.
failable routine Int.to[S16]() -> S16
    return me.to[S64]().to[S16]()

### Converts an arbitrary-precision integer to `S32`.
### :returns: The resulting `S32` value.
### :throws: {IntegerOverflowError} if this value is outside the `S32` range.
failable routine Int.to[S32]() -> S32
    return me.to[S64]().to[S32]()

### Converts an arbitrary-precision integer to `U8`.
### :returns: The resulting `U8` value.
### :throws: {IntegerOverflowError} if this value is outside the `U8` range.
failable routine Int.to[U8]() -> U8
    return me.to[U64]().to[U8]()

### Converts an arbitrary-precision integer to `U16`.
### :returns: The resulting `U16` value.
### :throws: {IntegerOverflowError} if this value is outside the `U16` range.
failable routine Int.to[U16]() -> U16
    return me.to[U64]().to[U16]()

### Converts an arbitrary-precision integer to `U32`.
### :returns: The resulting `U32` value.
### :throws: {IntegerOverflowError} if this value is outside the `U32` range.
failable routine Int.to[U32]() -> U32
    return me.to[U64]().to[U32]()

### Converts an arbitrary-precision integer to `U128`.
### :returns: The resulting `U128` value.
### :throws: {IntegerOverflowError} if this value is negative or exceeds `U128_MAX`.
failable routine Int.to[U128]() -> U128
    if me.is_negative()
        throw IntegerOverflowError()
    # value = hi * 2^64 + lo: `hi` fits 64 bits exactly when the value fits 128.
    var hi = me.arith_shift_right(bits: 64)
    var lo = me.sub(other: hi.shift_left(bits: 64))
    return (hi.to[U64]().to[U128]() << 64) | lo.to[U64]().to[U128]()

### Converts an arbitrary-precision integer to `U256`.
### :returns: The resulting `U256` value.
### :throws: {IntegerOverflowError} if this value is negative or exceeds `U256_MAX`.
failable routine Int.to[U256]() -> U256
    if me.is_negative()
        throw IntegerOverflowError()
    # value = hi * 2^128 + lo, each half through the U128 conversion.
    var hi = me.arith_shift_right(bits: 128)
    var lo = me.sub(other: hi.shift_left(bits: 128))
    return (hi.to[U128]().to[U256]() << 128) | lo.to[U128]().to[U256]()

### Converts an arbitrary-precision integer to `S128`.
### :returns: The resulting `S128` value.
### :throws: {IntegerOverflowError} if this value is outside `S128_MIN..S128_MAX`.
failable routine Int.to[S128]() -> S128
    var magnitude = me.abs().to[U128]()
    # A negative value may reach 2^127 (S128_MIN), a positive one stops one short.
    var limit: U128 = if me.is_negative() then 1 << 127 else (1 << 127) -% 1
    if magnitude > limit
        throw IntegerOverflowError()
    var bits = if me.is_negative() then 0 -% magnitude else magnitude
    return LLVM::reinterpret_bits[U128, S128](bits)

### Converts an arbitrary-precision integer to `S256`.
### :returns: The resulting `S256` value.
### :throws: {IntegerOverflowError} if this value is outside `S256_MIN..S256_MAX`.
failable routine Int.to[S256]() -> S256
    var magnitude = me.abs().to[U256]()
    # A negative value may reach 2^255 (S256_MIN), a positive one stops one short.
    var limit: U256 = if me.is_negative() then 1 << 255 else (1 << 255) -% 1
    if magnitude > limit
        throw IntegerOverflowError()
    var bits = if me.is_negative() then 0 -% magnitude else magnitude
    return LLVM::reinterpret_bits[U256, S256](bits)

### Converts an arbitrary-precision integer to the nearest `B32`.
### :returns: The `B32` closest to this value.
### :throws: {NumericOverflowError} if this value is beyond the range of `B32`.
@inline
failable routine Int.to[B32]() -> B32
    # A value in the `S64` range converts in one rounding step.
    if me.owner.is_hollow()
        return LLVM::signed_to_float[S64, B32](integer_bits(v: me))
    # A magnitude below 2^64 converts in one rounding step too, and the sign is exact.
    var low = integer_one_word(v: me)
    if low.item0
        var magnitude = LLVM::unsigned_to_float[U64, B32](low.item1)
        return if integer_negative(v: me) then -magnitude else magnitude
    # The exact decimal text read back as a float rounds once, to the nearest `B32`.
    return me.represent().to[B32]()

### Converts an arbitrary-precision integer to the nearest `B64`.
### :returns: The `B64` closest to this value.
### :throws: {NumericOverflowError} if this value is beyond the range of `B64`.
@inline
failable routine Int.to[B64]() -> B64
    # A value in the `S64` range converts in one rounding step.
    if me.owner.is_hollow()
        return LLVM::signed_to_float[S64, B64](integer_bits(v: me))
    # A magnitude below 2^64 converts in one rounding step too, and the sign is exact.
    var low = integer_one_word(v: me)
    if low.item0
        var magnitude = LLVM::unsigned_to_float[U64, B64](low.item1)
        return if integer_negative(v: me) then -magnitude else magnitude
    # The exact decimal text read back as a float rounds once, to the nearest `B64`.
    return me.represent().to[B64]()

### Converts an arbitrary-precision integer to `Decimal`, rounding to its 34 significant digits half up.
### :returns: The resulting `Decimal` value.
### :throws: {NumericOverflowError} if this value is beyond the range of `Decimal` (about `1e6144`).
failable routine Int.to[Decimal]() -> Decimal
    var w = decimal_bits_parse(text: me.represent(), width: 0)
    if w.w0 != 0
        throw NumericOverflowError(description: "overflow: the integer is too large for Decimal")
    return dec_of_canonical(x: D128.from_words(low: w.w1, high: w.w2))

### Formats this value as base-10 text. Standard `represent` shape (no args)
### so the f-string machinery can dispatch without supplying a radix.
### :returns: The resulting `Text` value.
@readonly
@override
routine Int.represent() -> Text
    return me.represent_radix(radix: 10)

### Serializes this value as its base-10 text, which `sv.to[Int]()` parses back exactly.
### :returns: The `SerialValue` text arm.
@readonly
@override
routine Int.serialize() -> SerialValue
    return SerialValue(from: me.represent())

### Builds an `Int` from its serialized base-10 text.
### :param value: The serialized value.
### :returns: The parsed value.
### :throws: {SerialShapeError} when the value is not text, or a parse error when the text is not an integer.
failable common routine Int.from_serial(value: SerialValue) -> Int
    return serial_text(value: value).to[Int]()

### Formats this value as text in the requested radix (2 to 64; digits past 9 are uppercase
### letters up to base 36). An out-of-range radix renders an empty text.
### :param radix: The numeric base to use.
### :returns: The resulting `Text` value.
@readonly
routine Int.represent_radix(radix: S32) -> Text
    if radix < 2 or radix > 64
        return ""
    return integer_text(v: me, radix: radix.to[S64]().to[U64]())

### Renders this value in base `radix` (2 to 36), digits past 9 as lowercase letters, with a leading `-`
### when negative. Crashes on any other radix (unlike `represent_radix`, which renders an empty text).
### :param radix: The numeric base.
### :returns: The rendered `Text`.
@readonly
routine Int.to_text(radix: S32) -> Text
    check_radix(radix: radix)
    return me.represent_radix(radix: radix).to_lowercase()

# Whether the magnitude of `v` is below 2^64, and that magnitude when it is.
secret routine integer_one_word(v: Int) -> (Bool, U64)
    if v.owner.is_hollow()
        return (true, integer_bits_magnitude(bits: integer_bits(v: v)))
    danger
        var view = limb_view(v: v)
        if view.len == 1
            return (true, view.tab.peek())
        return (false, 0)

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value: of the magnitude word (with the key changed for a negative
### value) when the magnitude is below 2^64, of the base-10 text above. A value has one form only, so equal values hash
### equal.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The 64-bit keyed hash.
@readonly
routine Int.hash(k0: U64, k1: U64) -> U64
    var s = integer_one_word(v: me)
    if s.item0
        var key = if integer_negative(v: me) then k1 ^ 0x9E3779B97F4A7C15 else k1
        return s.item1.hash(k0: k0, k1: key)
    return me.represent_radix(radix: 10).hash(k0: k0, k1: k1)

# ============================================================================
# Factory Methods
# ============================================================================

### Parses a base-10 integer from text.
### This is the canonical text-to-`Int` conversion used by generic parsing
### surfaces.
### :returns: The resulting `Int` value.
### :throws: May throw {ParseError}.
failable routine Text.to[Int]() -> Int
    var parsed = integer_parse(text: me, radix: 10)
    if not parsed.item1
        throw InvalidValueError(input: me, target: "Int")
    return parsed.item0

### Parses a base-2 integer from text.
### :param text: The binary digits to parse.
### :returns: The resulting `Int` value.
### :throws: May throw {ParseError}.
@readonly
failable common routine Int.from_binary(text: Text) -> Int
    var parsed = integer_parse(text: text, radix: 2)
    if not parsed.item1
        throw InvalidValueError(input: text, target: "Int")
    return parsed.item0

### Parses a base-16 integer from text.
### :param text: The hexadecimal digits to parse.
### :returns: The resulting `Int` value.
### :throws: May throw {ParseError}.
@readonly
failable common routine Int.from_hex(text: Text) -> Int
    var parsed = integer_parse(text: text, radix: 16)
    if not parsed.item1
        throw InvalidValueError(input: text, target: "Int")
    return parsed.item0

### Returns the additive identity for `Int`.
### :returns: The resulting `Int` value.
@readonly
common routine Int.zero() -> Int
    return 0.to[Int]()

### Returns the multiplicative identity for `Int`.
### :returns: The resulting `Int` value.
@readonly
common routine Int.one() -> Int
    return 1.to[Int]()

# ============================================================================
# Examples
# ============================================================================

### Computes `n!` using iterative multiplication.
### This routine is included as a worked example for larger integer workloads.
### :param n: The non-negative input value.
### :returns: The resulting `Int` value.
routine factorial(n: Int) -> Int
    if n.is_zero() or n == Int.one()
        return Int.one()

    var result = Int.one()
    var i = 2.to[Int]()

    until i > n
        result = result * i
        i = i + Int.one()

    return result

### Computes the `n`th Fibonacci number using arbitrary-precision integers.
### This routine demonstrates growth beyond fixed-width integer range.
### :param n: The zero-based sequence index.
### :returns: The resulting `Int` value.
routine fibonacci_big(n: S64) -> Int
    if n <= 1
        return n.to[Int]()

    var a = Int.zero()
    var b = Int.one()

    var i: S64 = 2
    until i > n
        var temp = a + b
        a = b
        b = temp
        i = i + 1

    return b

### Builder plumbing for presets computed at build time: this value as a bare number (`12`), which takes the
### `Int` type from the preset's declared type.
### :returns: The source text.
@readonly
@override
routine Int.preset_literal() -> Text
    return me.represent()
