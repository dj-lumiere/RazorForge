module System/Numerics

# ============================================================================
# The text of the binary floats and the decimals: each is Ingrid's (Ingrid/tessera/floattext.te and
# Ingrid/tessera/decimal/dec_text.te), which writes the characters into a buffer this side hands it.
# A short text fits the stack buffer, and a longer one is asked for again with room for all of it.
# ============================================================================

### The room of the stack buffer a text is first written into.
preset FLOAT_TEXT_ROOM: U64 = 64

### The text of a binary float's bits (`high` 0 below B128) as Ingrid writes it.
### :param low: The low 64 bits.
### :param high: The high 64 bits.
### :param format: 0 B64, 1 B32, 2 B16, 3 BF16, 4 B128.
### :param style: 0 the shortest decimal, 1 `digits` significant digits, 2 `digits` digits after the point, 3 the
###     `diagnose` text (the type name, then the shortest decimal in parentheses).
### :param digits: The significant digits or the digits after the point.
### :returns: The text.
secret routine float_text(low: U64, high: U64, format: U32, style: U32, digits: U64) -> Text
    var buf = Array[Char, 64]()
    var count: U64 = 0
    danger
        var p = LLVM::reinterpret_bits[Hijacked[Array[Char, 64]], Hijacked[Char]](buf.hijack())
        count = C::ingrid_float_text_utf32(
            low: low,
            high: high,
            format: format,
            style: style,
            digits: digits,
            out: p,
            out_count: FLOAT_TEXT_ROOM,
        )
        if count <= FLOAT_TEXT_ROOM
            return Text(from_span: p, count: count)
    var result = text_alloc(count: count)
    drop C::ingrid_float_text_utf32(
        low: low,
        high: high,
        format: format,
        style: style,
        digits: digits,
        out: result.data,
        out_count: count,
    )
    return result

### Reads decimal text as a binary float of `format` (Ingrid's reader).
### :param text: The text.
### :param format: 0 B64, 1 B32, 2 B16, 3 BF16, 4 B128.
### :returns: w0: 0 a number, 1 a NaN, 2 an infinity, 3 not a number. w1 and w2: the bits' low and high 64.
secret routine float_parse(text: Text, format: U32) -> IngridWords
    return C::ingrid_float_parse_utf32(chars: text.data, count: text.count, format: format)

### The text of a decimal given its bits, as Ingrid writes it.
### :param low: The low 64 bits of the bits.
### :param high: The high 64 bits (0 below D128).
### :param width: 32, 64, or 128 for D32, D64, or D128, and 0 for Decimal.
### :param style: 0 the scientific text, 1 Decimal's text (no fractional trailing zeros, integers in full), 2 `places`
###     digits after the point, 3 the `diagnose` text (the type name, then the text in parentheses), 4 Decimal's
###     `places` digits after the point.
### :param places: The digits after the point for styles 2 and 4.
### :param mode: How styles 2 and 4 round (`rounding_mode`): the type's own rule writes the digits as they are, any other
###     rounds to `places` digits first.
### :returns: The text.
secret routine decimal_bits_text(low: U64, high: U64, width: U32, style: U32, places: U64, mode: U32) -> Text
    var buf = Array[Char, 64]()
    var count: U64 = 0
    danger
        var o = LLVM::reinterpret_bits[Hijacked[Array[Char, 64]], Hijacked[Char]](buf.hijack())
        count = C::ingrid_decimal_bits_text_utf32(
            low: low,
            high: high,
            width: width,
            style: style,
            places: places,
            mode: mode,
            out: o,
            out_count: FLOAT_TEXT_ROOM,
        )
        if count <= FLOAT_TEXT_ROOM
            return Text(from_span: o, count: count)
    var result = text_alloc(count: count)
    drop C::ingrid_decimal_bits_text_utf32(
        low: low,
        high: high,
        width: width,
        style: style,
        places: places,
        mode: mode,
        out: result.data,
        out_count: count,
    )
    return result

### Reads decimal text as a decimal of `width`, rounded once (Ingrid's reader): an optional sign, an integer and fraction
### mantissa, an optional `e`/`E` exponent, and the special values `inf`/`infinity`/`nan` (any case).
### :param text: The text.
### :param width: 32, 64, or 128 for D32, D64, or D128, and 0 for Decimal.
### :returns: w0: 0 a value, 1 not a number (for a Decimal also an infinity or a NaN), 2 a Decimal out of range. w1 and
###     w2: the bits' low and high 64.
secret routine decimal_bits_parse(text: Text, width: U32) -> IngridWords
    return C::ingrid_decimal_bits_parse_utf32(chars: text.data, count: text.count, width: width)
