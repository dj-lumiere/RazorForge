module System/Numerics

# Constants for S64 limits
preset S64_MIN: S64 = -9_223_372_036_854_775_808
preset S64_MAX: S64 = 9_223_372_036_854_775_807
preset S64_ZERO: S64 = 0
preset S64_ONE: S64 = 1

### A 64-bit signed integer in the range −9,223,372,036,854,775,808 to 9,223,372,036,854,775,807.
### `S64` is the default word-sized signed integer type in RazorForge.
@llvm("i64")
record S64
obeys SignedIntegral, Comparable, ConstCompatible, AtomicType, Copyable, Splittable
    pass

# ============================================================================
# Checked Creators (crash on overflow)
# ============================================================================

### Sign-extends a signed 8-bit integer to `S64`.
### :returns: The `S64` representation of this value.
routine S8.to[S64]() -> S64
    return LLVM::sign_extend[S8, S64](me)

### Sign-extends a signed 16-bit integer to `S64`.
### :returns: The `S64` representation of this value.
routine S16.to[S64]() -> S64
    return LLVM::sign_extend[S16, S64](me)

### Sign-extends a signed 32-bit integer to `S64`.
### :returns: The `S64` representation of this value.
routine S32.to[S64]() -> S64
    return LLVM::sign_extend[S32, S64](me)

### Returns this value unchanged (identity conversion).
### :returns: this value.
routine S64.to[S64]() -> S64
    return me

### Truncates a signed 128-bit integer to `S64`.
### :returns: The `S64` representation of this value.
### :throws: {IntegerOverflowError} if this value is outside the `S64` range.
failable routine S128.to[S64]() -> S64
    if not (-9223372036854775808 <= me <= 9223372036854775807)
        throw IntegerOverflowError()
    return LLVM::int_truncate[S128, S64](me)

### Zero-extends an unsigned 8-bit integer to `S64`.
### :returns: The `S64` representation of this value.
routine U8.to[S64]() -> S64
    return LLVM::zero_extend[U8, S64](me)

### Zero-extends an unsigned 16-bit integer to `S64`.
### :returns: The `S64` representation of this value.
routine U16.to[S64]() -> S64
    return LLVM::zero_extend[U16, S64](me)

### Zero-extends an unsigned 32-bit integer to `S64`.
### :returns: The `S64` representation of this value.
routine U32.to[S64]() -> S64
    return LLVM::zero_extend[U32, S64](me)

### Reinterprets a `U64` as `S64` using two's complement.
### :returns: The `S64` representation of this value.
### :throws: {IntegerOverflowError} if this value exceeds `S64_MAX`.
failable routine U64.to[S64]() -> S64
    if me > 9223372036854775807
        throw IntegerOverflowError()
    return LLVM::reinterpret_bits[U64, S64](me)

### Truncates an unsigned 128-bit integer to `S64`.
### :returns: The `S64` representation of this value.
### :throws: {IntegerOverflowError} if this value exceeds `S64_MAX`.
failable routine U128.to[S64]() -> S64
    if me > 9223372036854775807
        throw IntegerOverflowError()
    return LLVM::int_truncate[U128, S64](me)

### Converts an `S256` to `S64`, throwing if outside the S64 range.
### :returns: The lower 64 bits reinterpreted as an `S64`.
### :throws: {IntegerOverflowError} if this value is outside −9223372036854775808..9223372036854775807.
failable routine S256.to[S64]() -> S64
    if not (-9223372036854775808 <= me <= 9223372036854775807)
        throw IntegerOverflowError()
    return LLVM::int_truncate[S256, S64](me)

### Converts a `U256` to `S64`, throwing if the value exceeds S64_MAX.
### :returns: The lower 64 bits reinterpreted as an `S64`.
### :throws: {IntegerOverflowError} if `me > 9223372036854775807`.
failable routine U256.to[S64]() -> S64
    if me > 9223372036854775807
        throw IntegerOverflowError()
    return LLVM::int_truncate[U256, S64](me)

### Truncates a 16-bit float to `S64` by first widening to `B32`.
### :returns: The truncated `S64` representation.
failable routine B16.to[S64]() -> S64
    return me.to[B32]().to[S64]()

### Truncates a 32-bit float to `S64`, rounding toward zero.
### :returns: The truncated `S64` representation.
failable routine B32.to[S64]() -> S64
    if me.is_nan() or not (-9223372036854775808.0 <= me <= 9223372036854775807.0)
        throw IntegerOverflowError()
    return LLVM::float_to_signed[B32, S64](me)

### Truncates a 64-bit float to `S64`, rounding toward zero.
### :returns: The truncated `S64` representation.
failable routine B64.to[S64]() -> S64
    if me.is_nan() or not (-9223372036854775808.0 <= me <= 9223372036854775807.0)
        throw IntegerOverflowError()
    return LLVM::float_to_signed[B64, S64](me)

### Truncates a 128-bit float to `S64` by narrowing to `B64` first.
### :returns: The truncated `S64` representation.
failable routine B128.to[S64]() -> S64
    if me.is_nan() or not (-9223372036854775808.0 <= me <= 9223372036854775807.0)
        throw IntegerOverflowError()
    return me.to[B64]().to[S64]()

### Converts a 32-bit decimal float to `S64`.
### :returns: The truncated `S64` representation.
failable routine D32.to[S64]() -> S64
    return me.to[D128]().to[S128]().to[S64]()

### Converts a 64-bit decimal float to `S64`.
### :returns: The truncated `S64` representation.
failable routine D64.to[S64]() -> S64
    return me.to[D128]().to[S128]().to[S64]()

### Converts a 128-bit decimal float to `S64`.
### :returns: The truncated `S64` representation.
failable routine D128.to[S64]() -> S64
    return me.to[S128]().to[S64]()

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Returns the sum of this value and `you`, and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(sum, overflow_flag)`.
routine S64.add_with_overflow(you: S64) -> (S64, Bool)
    return LLVM::signed_add_checked[S64](me, you)

### Returns the difference `me - you`, and a flag indicating whether the result overflowed.
### :param you: The value to subtract.
### :returns: A tuple of `(difference, overflow_flag)`.
routine S64.sub_with_overflow(you: S64) -> (S64, Bool)
    return LLVM::signed_sub_checked[S64](me, you)

### Returns the product of this value and `you`, and a flag indicating whether the result
### overflowed.
### :param you: The right operand.
### :returns: A tuple of `(product, overflow_flag)`.
routine S64.mul_with_overflow(you: S64) -> (S64, Bool)
    return LLVM::signed_mul_checked[S64](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum.
### :throws: {IntegerOverflowError} if the result is outside the `S64` range.
failable routine S64.add(you: S64) -> S64
    var result = me.add_with_overflow(you)
    if result.item1
        throw IntegerOverflowError()
    return result.item0

### Returns `me - you`, throwing on overflow.
### :param you: The value to subtract.
### :returns: The difference.
### :throws: {IntegerOverflowError} if the result is outside the `S64` range.
failable routine S64.sub(you: S64) -> S64
    var result = me.sub_with_overflow(you)
    if result.item1
        throw IntegerOverflowError()
    return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product.
### :throws: {IntegerOverflowError} if the result is outside the `S64` range.
failable routine S64.mul(you: S64) -> S64
    var result = me.mul_with_overflow(you)
    if result.item1
        throw IntegerOverflowError()
    return result.item0

### Returns `me // you` (euclidean division), throwing on errors.
### Euclidean division: the remainder is always in `[0, |you|)`, consistent with `mod!`.
### :param you: The divisor.
### :returns: The euclidean quotient.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if `me == S64_MIN and you == -1`.
failable routine S64.floordiv(you: S64) -> S64
    if you == 0
        throw DivisionByZeroError()
    if me == S64_MIN and you == -1
        throw IntegerOverflowError()
    var quotient = LLVM::signed_div(a: me, b: you)
    var remainder = LLVM::signed_rem(a: me, b: you)
    if remainder < 0
        if you > 0
            return quotient - 1
        return quotient + 1
    return quotient

### Returns `me % you` (euclidean modulo): the remainder is always in `[0, |you|)`.
### :param you: The divisor.
### :returns: The euclidean remainder — always non-negative.
### :throws: {DivisionByZeroError} if `you == 0`.
failable routine S64.mod(you: S64) -> S64
    if you == 0
        throw DivisionByZeroError()
    # S64_MIN % -1 is mathematically 0, but signed_rem(S64_MIN, -1) is undefined at the
    # hardware level (same trap as S64_MIN / -1). Return the exact euclidean result directly.
    if me == S64_MIN and you == -1
        return 0
    var remainder = LLVM::signed_rem(a: me, b: you)
    if remainder < 0
        if you > 0
            return remainder + you
        return remainder - you
    return remainder

### Returns `-me` (arithmetic negation).
### :returns: The negated value.
@readonly
failable routine S64.neg() -> S64
    if me == -9223372036854775808
        throw IntegerOverflowError()
    return LLVM::sub(a: 0, b: me)

# ============================================================================
# Overflow-mode variants (neg / abs / div / mod)
# ============================================================================

### Returns `-me` in two's complement, wrapping `S64_MIN` to itself.
### :returns: The wrapped negation.
routine S64.neg_wrap() -> S64
    return LLVM::sub(a: 0, b: me)

### Returns `(-me, overflowed)`. Overflow occurs only for `S64_MIN`.
### :returns: A tuple of `(wrapped negation, overflow flag)`.
routine S64.neg_with_overflow() -> (S64, Bool)
    return (LLVM::sub(a: 0, b: me), me == S64_MIN)

### Returns `-me`, clamped to `S64_MAX` when `me == S64_MIN`.
### :returns: The saturating negation.
routine S64.neg_clamp() -> S64
    return if me == S64_MIN then S64_MAX else LLVM::sub(a: 0, b: me)

### Returns |me| in two's complement, wrapping `|S64_MIN|` back to `S64_MIN`.
### :returns: The wrapped absolute value.
routine S64.abs_wrap() -> S64
    return if me < 0 then LLVM::sub(a: 0, b: me) else me

### Returns `(|me|, overflowed)`. Overflow occurs only for `S64_MIN`.
### :returns: A tuple of `(wrapped absolute value, overflow flag)`.
routine S64.abs_with_overflow() -> (S64, Bool)
    return (me.abs_wrap(), me == S64_MIN)

### Returns |me|, clamped to `S64_MAX` when `me == S64_MIN`.
### :returns: The saturating absolute value.
routine S64.abs_clamp() -> S64
    return if me == S64_MIN then S64_MAX else me.abs_wrap()

### Returns |me| as an unsigned value; `|S64_MIN|` is represented exactly.
### :returns: The absolute value as `U64`.
routine S64.unsigned_abs() -> U64
    var w = if me < 0 then LLVM::sub(a: 0, b: me) else me
    return LLVM::reinterpret_bits[S64, U64](w)

### Returns euclidean `me // you`, wrapping the `S64_MIN // -1` overflow to `S64_MIN`.
### :param you: The divisor.
### :returns: The wrapped euclidean quotient.
### :throws: {DivisionByZeroError} if `you == 0`.
routine S64.floordiv_wrap(you: S64) -> S64
    if me == S64_MIN and you == -1
        return S64_MIN
    return me.floordiv(you)

### Returns `(euclidean quotient, overflowed)`; overflow only for `S64_MIN // -1`.
### :param you: The divisor.
### :returns: A tuple of `(quotient, overflow flag)`.
### :throws: {DivisionByZeroError} if `you == 0`.
routine S64.floordiv_with_overflow(you: S64) -> (S64, Bool)
    if me == S64_MIN and you == -1
        return (S64_MIN, true)
    return (me.floordiv(you), false)

### Returns euclidean `me % you`, wrapping the `S64_MIN % -1` overflow to `0`.
### :param you: The divisor.
### :returns: The wrapped euclidean remainder.
### :throws: {DivisionByZeroError} if `you == 0`.
routine S64.mod_wrap(you: S64) -> S64
    if me == S64_MIN and you == -1
        return 0
    return me.mod(you)

### Returns `(euclidean remainder, overflowed)`; overflow only for `S64_MIN % -1`.
### :param you: The divisor.
### :returns: A tuple of `(remainder, overflow flag)`.
### :throws: {DivisionByZeroError} if `you == 0`.
routine S64.mod_with_overflow(you: S64) -> (S64, Bool)
    if me == S64_MIN and you == -1
        return (0, true)
    return (me.mod(you), false)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you) mod 2⁶⁴` in two's complement, without overflow check.
### :param you: The right operand.
### :returns: The wrapped sum.
routine S64.add_wrap(you: S64) -> S64
    return LLVM::add(a: me, b: you)

### Returns `(me - you) mod 2⁶⁴` in two's complement, without overflow check.
### :param you: The value to subtract.
### :returns: The wrapped difference.
routine S64.sub_wrap(you: S64) -> S64
    return LLVM::sub(a: me, b: you)

### Returns `(me * you) mod 2⁶⁴` in two's complement, without overflow check.
### :param you: The right operand.
### :returns: The wrapped product.
routine S64.mul_wrap(you: S64) -> S64
    return LLVM::mul(a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum.
dangerous routine S64.add_unchecked(you: S64) -> S64
    return LLVM::signed_add_exact[S64](a: me, b: you)

### Returns `me - you` with undefined behavior on overflow.
### :param you: The value to subtract.
### :returns: The difference.
dangerous routine S64.sub_unchecked(you: S64) -> S64
    return LLVM::signed_sub_exact[S64](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product.
dangerous routine S64.mul_unchecked(you: S64) -> S64
    return LLVM::signed_mul_exact[S64](a: me, b: you)

### Returns `me // you` (euclidean division) with undefined behavior if `you` is zero.
### :param you: The divisor.
### :returns: The euclidean quotient.
@readonly
dangerous routine S64.floordiv_unchecked(you: S64) -> S64
    var quotient = LLVM::signed_div(a: me, b: you)
    var remainder = LLVM::signed_rem(a: me, b: you)
    if remainder < 0
        if you > 0
            return quotient - 1
        return quotient + 1
    return quotient

### Returns `me % you` (euclidean modulo) with undefined behavior if `you` is zero.
### :param you: The divisor.
### :returns: The floor remainder.
@readonly
dangerous routine S64.mod_unchecked(you: S64) -> S64
    var remainder = LLVM::signed_rem(a: me, b: you)
    if remainder < 0
        if you > 0
            return remainder + you
        return remainder - you
    return remainder

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `[S64_MIN, S64_MAX]` on overflow.
### :param you: The right operand.
### :returns: The clamped sum.
@readonly
routine S64.add_clamp(you: S64) -> S64
    return LLVM::signed_add_sat[S64](a: me, b: you)

### Returns `me - you`, clamped to `[S64_MIN, S64_MAX]` on overflow.
### :param you: The value to subtract.
### :returns: The clamped difference.
@readonly
routine S64.sub_clamp(you: S64) -> S64
    return LLVM::signed_sub_sat[S64](a: me, b: you)

### Returns `me * you`, clamped to `[S64_MIN, S64_MAX]` on overflow.
### :param you: The right operand.
### :returns: The clamped product.
@readonly
routine S64.mul_clamp(you: S64) -> S64
    var wide = LLVM::mul(LLVM::sign_extend[S64, S128](me), LLVM::sign_extend[S64, S128](you))
    if LLVM::signed_gt(wide, 9223372036854775807)
        return S64_MAX
    if LLVM::signed_lt(wide, -9223372036854775808)
        return S64_MIN
    return LLVM::int_truncate[S128, S64](wide)

# ============================================================================
# Carrying Arithmetic (multi-word building blocks)
# ============================================================================

### Returns `me + you + carry` as `(wrapped_sum, overflowed)`.
### Chains across words to add integers wider than `S64`: feed each word's carry
### bit up the chain. Unlike the unsigned form, the flag reports SIGNED overflow
### (the two internal overflows cancel via XOR), so it is only meaningful on the
### most-significant word of a multi-word signed value.
### :param you: The right operand.
### :param carry: The incoming carry bit from the lower word.
### :returns: A tuple of `(wrapped sum, signed-overflow flag)`.
routine S64.carrying_add(you: S64, carry: Bool) -> (S64, Bool)
    var carry_val: S64 = if carry then 1 else 0
    var first = me.add_with_overflow(you)
    var second = first.item0.add_with_overflow(carry_val)
    return (second.item0, not first.item1.eq(second.item1))

### Returns `me - you - borrow` as `(wrapped_difference, overflowed)`.
### Chains across words to subtract integers wider than `S64`; the flag reports
### SIGNED overflow, meaningful only on the most-significant word.
### :param you: The value to subtract.
### :param borrow: The incoming borrow bit from the lower word.
### :returns: A tuple of `(wrapped difference, signed-overflow flag)`.
routine S64.borrowing_sub(you: S64, borrow: Bool) -> (S64, Bool)
    var borrow_val: S64 = if borrow then 1 else 0
    var first = me.sub_with_overflow(you)
    var second = first.item0.sub_with_overflow(borrow_val)
    return (second.item0, not first.item1.eq(second.item1))

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and an overflow flag.
### Uses repeated squaring. `0 ** 0 == 1` (the empty product); a negative exponent crashes
### with NumericDomainError (the result would not be an integer).
### :param exp: The exponent. Must be non-negative.
### :returns: A tuple of `(result, overflow_flag)`.
### :throws: {NumericDomainError} if `exp < 0`.
failable routine S64.pow_with_overflow(exp: S64) -> (S64, Bool)
    var result: S64 = 1
    var base: S64 = me
    var e: S64 = exp
    var overflow = false
    if exp < 0
        throw NumericDomainError(description: "negative exponent: no integer result")
    until e <= 0
        if (e & 1) == 1
            var mul_result = result.mul_with_overflow(base)
            result = mul_result.item0
            overflow = overflow or mul_result.item1
        e = e >> 1
        if e > 0
            var square_result = base.mul_with_overflow(base)
            base = square_result.item0
            overflow = overflow or square_result.item1
    return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent. Must be non-negative.
### :returns: The result.
### :throws: {IntegerOverflowError} if the result is outside the `S64` range.
failable routine S64.pow(exp: S64) -> S64
    var result = me.pow_with_overflow(exp)
    if result.item1
        throw IntegerOverflowError()
    return result.item0

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent. Must be non-negative.
### :returns: The result modulo 2⁶⁴ in two's complement.
failable routine S64.pow_wrap(exp: S64) -> S64
    if exp < 0
        throw NumericDomainError(description: "negative exponent: no integer result")
    var result: S64 = 1
    var base: S64 = me
    var e: U32 = exp.to[U32]()
    until e == 0
        if (e & 1) == 1
            result = result.mul_wrap(base)
        e = e >> 1
        if e > 0
            base = base.mul_wrap(base)
    return result

### Returns `me ** exp` clamped to `[S64_MIN, S64_MAX]` on overflow.
### :param exp: The exponent. Must be non-negative.
### :returns: The clamped result.
@readonly
failable routine S64.pow_clamp(exp: S64) -> S64
    var result: S64 = 1
    var base: S64 = me
    if exp < 0
        throw NumericDomainError(description: "negative exponent: no integer result")
    until exp <= 0
        if (exp & 1) == 1
            result = result.mul_clamp(base)
        exp = exp >> 1
        if exp > 0
            base = base.mul_clamp(base)
    return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns `me & you` (bitwise AND).
### :param you: The right operand.
### :returns: The bitwise intersection.
routine S64.bitand(you: S64) -> S64
    return LLVM::bit_and(a: me, b: you)

### Returns `me | you` (bitwise OR).
### :param you: The right operand.
### :returns: The bitwise union.
routine S64.bitor(you: S64) -> S64
    return LLVM::bit_or(a: me, b: you)

### Returns `me ^ you` (bitwise XOR).
### :param you: The right operand.
### :returns: The bitwise exclusive-or.
routine S64.bitxor(you: S64) -> S64
    return LLVM::bit_xor(a: me, b: you)

### Returns `~me` (bitwise NOT).
### :returns: The bitwise complement.
@readonly
routine S64.bitnot() -> S64
    return LLVM::bit_xor(a: me, b: -1)

# ============================================================================
# Shift Operations (<<, >>, >>>)
# Shifting by the width or more pushes every bit out: `<<` and `>>>` give 0, and `>>` gives the
# sign fill (-1 for a negative value, else 0).
# ============================================================================

### Left-shifts this value by `bits` positions, filling vacated bits with zero. Shifting by
### 64 or more gives 0.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine S64.shift_left(bits: U32) -> S64
    if bits >= 64
        return 0
    return LLVM::shift_left(me, bits.to[S64]())

### Right-shifts this value by `bits` positions, copying the sign bit into vacated positions
### (arithmetic shift right). Shifting by 64 or more gives -1 for a negative value, else 0.
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits`.
routine S64.arith_shift_right(bits: U32) -> S64
    if bits >= 64
        return if me < 0 then -1 else 0
    return LLVM::shift_right_signed(me, bits.to[S64]())

### Right-shifts this value by `bits` positions, filling vacated bits with zero regardless of
### sign (logical shift right). Shifting by 64 or more gives 0.
### :param bits: The number of bit positions to shift right.
### :returns: `me >>> bits`.
routine S64.logical_shift_right(bits: U32) -> S64
    if bits >= 64
        return 0
    return LLVM::shift_right_unsigned(me, bits.to[S64]())

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns true if both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`.
@readonly
routine S64.eq(you: S64) -> Bool
    return LLVM::int_eq(a: me, b: you)

### Returns the ordering relationship between this value and `you`.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
@readonly
routine S64.compare(you: S64) -> ComparisonSign
    if LLVM::signed_lt(me, you)
        return ME_SMALL
    if LLVM::signed_gt(me, you)
        return ME_LARGE
    return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the absolute value of this value.
### :returns: `me` if non-negative; `-me` otherwise.
### :throws: {IntegerOverflowError} when `me` is `S64_MIN` (its magnitude is not representable in S64).
failable routine S64.abs() -> S64
    if me == -9223372036854775808
        throw IntegerOverflowError()
    return LLVM::int_abs[S64](me)

### Returns the smaller of this value and `you`.
### :param you: The value to compare.
### :returns: `me` if `me <= you`; otherwise `you`.
routine S64.min(you: S64) -> S64
    if me <= you
        return me
    else
        return you

### Returns the larger of this value and `you`.
### :param you: The value to compare.
### :returns: `me` if `me >= you`; otherwise `you`.
routine S64.max(you: S64) -> S64
    if me >= you
        return me
    else
        return you

### Returns this value clamped to the inclusive range `[min_val, max_val]`.
### :param min_val: The lower bound of the allowed range.
### :param max_val: The upper bound of the allowed range.
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; `me` otherwise.
@positional
routine S64.clamp(min_val: S64, max_val: S64) -> S64
    return me.min(max_val).max(min_val)

# ============================================================================
# Integer Math (roots, logs)
# ============================================================================

### Returns the integer square root ⌊√me⌋. Throws for a negative `me`.
### :returns: The floor of the square root of `me`.
### :throws: {NumericDomainError} if `me < 0`.
routine S64.isqrt() -> S64
    return me.sqrtrem().item0

### Returns the integer square root together with its remainder: `(s, r)` with `s = ⌊√me⌋` and
### `r = me - s*s`, so `0 <= r <= 2s` (e.g. `5.sqrtrem()` is `(2, 1)`).
### :returns: The tuple `(root, remainder)`.
### :throws: {NumericDomainError} if `me < 0`.
failable routine S64.sqrtrem() -> (S64, S64)
    if me < 0
        throw NumericDomainError(description: "square root of a negative value has no real result")
    var x = me
    var result = 0
    var bit = 1 << 62
    until bit <= x
        bit = bit.logical_shift_right(2)
    until bit == 0
        var next = result.add_wrap(bit)
        if x >= next
            x = x.sub_wrap(next)
            result = result.logical_shift_right(1).add_wrap(bit)
        else
            result = result.logical_shift_right(1)
        bit = bit.logical_shift_right(2)
    return (result, x)

### Returns ⌊log₂ me⌋. Throws if `me <= 0`.
### :returns: The floor of the base-2 logarithm.
### :throws: {NumericDomainError} if `me <= 0`.
failable routine S64.ilog2() -> S64
    if me <= 0
        throw NumericDomainError(description: "ilog2 domain: me must be > 0")
    return 63 - me.leading_zeros()

### Returns ⌊log₁₀ me⌋. Throws if `me <= 0`.
### :returns: The floor of the base-10 logarithm.
### :throws: {NumericDomainError} if `me <= 0`.
failable routine S64.ilog10() -> S64
    if me <= 0
        throw NumericDomainError(description: "ilog10 domain: me must be > 0")
    var n = me
    var count = 0
    until n < 10
        n = n // 10
        count = count + 1
    return count

### Returns ⌊log_base me⌋. Throws if `me <= 0` or `base < 2`.
### :param base: The logarithm base (must be ≥ 2).
### :returns: The floor of the base-`base` logarithm.
### :throws: {NumericDomainError} if `me <= 0` or `base < 2`.
failable routine S64.ilog(base: S64) -> S64
    if me <= 0 or base < 2
        throw NumericDomainError(description: "ilog domain: me must be > 0 and base >= 2")
    var n = me
    var count = 0
    until n < base
        n = n // base
        count = count + 1
    return count

### Returns the absolute difference |me - you| as an unsigned value (no overflow).
### :param you: The other value.
### :returns: The non-negative distance between `me` and `you`.
routine S64.abs_diff(you: S64) -> U64
    var d = if me >= you then me.sub_wrap(you) else you.sub_wrap(me)
    return LLVM::reinterpret_bits[S64, U64](d)

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the number of bits set to one (popcount).
### :returns: The count of set bits in the 64-bit representation.
routine S64.count_ones() -> S64
    return LLVM::count_ones[S64](me)

### Returns the number of bits set to zero.
### :returns: `64` minus the popcount.
routine S64.count_zeros() -> S64
    return 64 -% me.count_ones()

### Returns the number of consecutive zero bits before the highest set bit.
### :returns: The leading zero count; `64` if the value is zero.
routine S64.leading_zeros() -> S64
    return LLVM::leading_zeros(me)

### Returns the number of consecutive zero bits starting from the least significant bit.
### :returns: The trailing zero count; `64` if the value is zero.
routine S64.trailing_zeros() -> S64
    return LLVM::trailing_zeros(me)

### Returns the number of consecutive one bits before the highest clear bit.
### :returns: The leading one count.
routine S64.leading_ones() -> S64
    return me.bitnot().leading_zeros()

### Returns the number of consecutive one bits starting from the least significant bit.
### :returns: The trailing one count.
routine S64.trailing_ones() -> S64
    return me.bitnot().trailing_zeros()

### Returns this value with the bit order reversed.
### :returns: The bit-reversed value.
routine S64.reverse_bits() -> S64
    return LLVM::reverse_bits[S64](me)

### Returns this value with the byte order reversed (big/little endian swap).
### :returns: The byte-swapped value.
routine S64.swap_bytes() -> S64
    return LLVM::byte_swap(me)

### Returns this value rotated left by `bits` positions.
routine S64.rotate_left(bits: U32) -> S64
    return LLVM::reinterpret_bits[U64, S64](LLVM::reinterpret_bits[S64, U64](me).rotate_left(bits: bits))

### Returns this value rotated right by `bits` positions.
routine S64.rotate_right(bits: U32) -> S64
    return LLVM::reinterpret_bits[U64, S64](LLVM::reinterpret_bits[S64, U64](me).rotate_right(bits: bits))

### Returns the raw byte representation of this value in little-endian order.
routine S64.to_bytes_le() -> Array[Byte, 8]
    return LLVM::reinterpret_bits[S64, U64](me).to_bytes_le()

### Returns the raw byte representation of this value in big-endian order.
routine S64.to_bytes_be() -> Array[Byte, 8]
    return LLVM::reinterpret_bits[S64, U64](me).to_bytes_be()

### Builds an `S64` from its little-endian raw byte representation.
common routine S64.from_bytes_le(bytes: Array[Byte, 8]) -> S64
    return LLVM::reinterpret_bits[U64, S64](U64.from_bytes_le(bytes: bytes))

### Builds an `S64` from its big-endian raw byte representation.
common routine S64.from_bytes_be(bytes: Array[Byte, 8]) -> S64
    return LLVM::reinterpret_bits[U64, S64](U64.from_bytes_be(bytes: bytes))

# ============================================================================
# Utility Methods
# ============================================================================

### Returns true if this value is strictly greater than zero.
### :returns: `true` when `me > 0`.
routine S64.is_positive() -> Bool
    return me > 0

### Returns true if this value is strictly less than zero.
### :returns: `true` when `me < 0`.
routine S64.is_negative() -> Bool
    return me < 0

### Returns true if this value is zero.
### :returns: `true` when `me == 0`.
routine S64.is_zero() -> Bool
    return me == 0

### Returns true if this value is even.
### :returns: `true` when the least significant bit is clear.
routine S64.is_even() -> Bool
    var result = LLVM::bit_and(a: me, b: 1)
    return LLVM::int_eq(a: result, b: 0)

### Returns true if this value is odd.
### :returns: `true` when the least significant bit is set.
routine S64.is_odd() -> Bool
    return not me.is_even()

### Returns the sign of this value as −1, 0, or 1.
### :returns: `1` if positive, `−1` if negative, `0` if zero.
routine S64.signum() -> S64
    return when
        me > 0 => 1
        me < 0 => -1
        else => 0

### Returns true if this value is an exact power of two.
### Negative values always return `false`.
### :returns: `true` if `me > 0 and (me & (me - 1)) == 0`.
routine S64.is_power_of_two() -> Bool
    var is_pos = LLVM::signed_gt(me, 0)
    var minus_one = LLVM::sub(a: me, b: 1)
    var anded = LLVM::bit_and(a: me, b: minus_one)
    var is_zero = LLVM::int_eq(a: anded, b: 0)
    return is_pos and is_zero

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine S64.represent() -> Text
    # reinterpret (not U64(me)) so the two's-complement magnitude `0 -% bits` is correct even for S64.MIN.
    var raw = LLVM::reinterpret_bits[S64, U64](me)
    if me < 0
        return int_to_text(mag: 0 -% raw, negative: true)
    return int_to_text(mag: raw, negative: false)

### Renders this value in base `radix` (2 to 36), digits past 9 as lowercase letters, with a leading `-`
### when negative (`255.to_text(radix: 16)` is `ff`).
### :param radix: The numeric base.
### :returns: The rendered `Text`.
@readonly
routine S64.to_text(radix: S32) -> Text
    return signed_radix_text(value: me, radix: radix)

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine S64.diagnose() -> Text
    return "S64(" + me.represent() + ")"

### Parses a decimal text representation of an `S64`.
### Accepts an optional leading `+` or `-` sign followed by ASCII decimal digits.
### :returns: The parsed `S64` value.
### :throws: {InvalidValueError} if the text is empty or contains non-digit characters.
### :throws: {IntegerOverflowError} if the value does not fit in `S64`.
failable routine Text.to[S64]() -> S64
    if me.count() == 0
        throw InvalidValueError(input: me, target: "S64")
    var start: U64 = 0
    var negative = false
    var first = me[0]
    if first == '-'
        negative = true
        start = 1
    elseif first == '+'
        start = 1
    if start >= me.count()
        throw InvalidValueError(input: me, target: "S64")
    var result: U64 = 0
    var last_limit: U64 = 7
    if negative
        last_limit = 8
    var i = start
    until i >= me.count()
        var ch = me[i]
        if ch.is_numeric()
            var digit = ch.digit_value().to[U64]()
            # Stop before `result * 10 + digit` passes the largest magnitude the sign allows.
            if result > 922337203685477580
                or (result == 922337203685477580 and digit > last_limit)
                throw IntegerOverflowError()
            result = result * 10 + digit
        else
            throw InvalidValueError(input: me, target: "S64")
        i = i + 1
    if negative
        return LLVM::reinterpret_bits[U64, S64](0 -% result)
    return result.to[S64]()

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The 64-bit keyed hash.
routine S64.hash(k0: U64, k1: U64) -> U64
    return __secure_hash_u64(v: LLVM::reinterpret_bits[S64, U64](me), k0: k0, k1: k1)
