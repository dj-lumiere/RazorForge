module System

### The crashable a debug build raises when an entity that other tasks can reach holds a handle that they could not
### reach safely: the handle was stored after the entity was shared and never made shareable. It points at a bug in the
### builder or in a library, not in the program.
crashable SharingViolationError
    ### The type of the entity that holds the handle.
    holder: Text

### Returns the default message for a handle that was not made shareable.
### :returns: The resulting `Text` value.
@override
routine SharingViolationError.crash_message() -> Text
    return f"An entity of type {me.holder} is shared with other tasks, but a handle stored in it is not, so two tasks could change what that handle reaches at the same time. The store that put the handle there did not make it shareable. This is a bug in the builder or a library, not in your program: report it with the code around the store."
