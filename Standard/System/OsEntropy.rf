module System

### The operating system's random source (getrandom on Linux, arc4random_buf on macOS, ProcessPrng on Windows): bits
### no one can guess, drawn anew on every call. Hash tables key their hashing with it, and `Random.from_entropy()`
### seeds a generator with it. Its routines are called on the type (`OsEntropy.next_u64()`).
record OsEntropy
    pass

### 64 random bits from the operating system's random source.
### :returns: The random bits.
common routine OsEntropy.next_u64() -> U64
    return C::rf_random_u64()
