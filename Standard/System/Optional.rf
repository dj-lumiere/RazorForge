module System

import BuilderQuery
### Represents an optional value: a variant of `T` and `None`, written `T?`.
### `Optional[T]` holds either a `T` or nothing, without carrying crash information. A `when` on it names the `T`
### member and `None` (`is None`). It is the one named type whose kind follows what it holds. For a value `T` it is
### a record: a presence flag and the value, copied by `=` and usable in a preset. For an entity `T` it holds the one
### original or nothing, is handed over with `steal`, and is the entity's address alone (`none` is the null address).
### :typeparam T: The wrapped type.
variant Optional[T]
    T
    None

### Returns the display form of this optional value.
### Present values are rendered using the wrapped value's text form.
### :returns: The resulting `Text` value.
@override
routine Optional[T].represent() -> Text
    if not me.is_present()
        return "none"
    return f"{me.value}"

### Returns the diagnostic form of this optional value.
### This form keeps the `Optional` wrapper visible for debugging and logs.
### :returns: The resulting `Text` value.
@override
routine Optional[T].diagnose() -> Text
    if not me.is_present()
        return f"{me.full_type_name()}(none)"
    return f"{me.full_type_name()}({me.value})"

### Frees the wrapped value when present; a no-op when absent. Defined explicitly (rather than
### auto-derived) so the per-instantiation body is monomorphized and emitted like the other carrier
### routines, and so the `value` field is only touched when actually present.
@override
routine Optional[T].destruct()
    if me.is_present()
        me.value.destruct()
    return

### The copy step `=` runs: the value is copied by its own `share` only when present. An absent optional's `value`
### is all zero bits, and sharing it would hand a zero handle (a `Retained` with no controller) to its `share`.
### :returns: A copy of this optional.
@override
secret routine Optional[T].share() -> Optional[T]
needs RecordType T
    if not me.is_present()
        return me
    return Optional[T](present: true, value: me.value.share())

### Returns the wrapped value, leaving this optional intact (NON-consuming).
### Use this when absence is a logic error rather than an expected branch. The payload is DUPLICATED: for
### a managed leaf (Text/…) `duplicate` is the cheap refcount share (`= assign`); for an aggregate it is a
### deep, independent copy — the ONLY way to co-own something that cannot be shallow-shared (e.g. a variant
### with a `Dict`/`List` arm is `Copyable` but not `Assignable`). Either way the optional stays intact and
### the caller gets an independent value. A single-owner ENTITY that did not opt into `Copyable` cannot be
### duplicated; use `strip_out` to MOVE it out instead.
### :returns: The contained `T` value (an independent duplicate).
### :throws: {AbsentValueError} if this `Optional` is absent.
@overridable
failable routine Optional[T].unwrap() -> T
needs RecordType T
    if not me.is_present()
        throw AbsentValueError()
    return me.value

### `unwrap` for a single-owner entity: it cannot be shared, so the caller gets an independent duplicate,
### which needs the entity to declare it can be copied.
@override
failable routine Optional[T].unwrap() -> T
needs EntityType T
needs T obeys Copyable
    if not me.is_present()
        throw AbsentValueError()
    return me.value.duplicate()

### `unwrap` for a variant: one with an entity arm cannot be shared, so the caller gets a duplicate.
@override
failable routine Optional[T].unwrap() -> T
needs VariantType T
needs T obeys Copyable
    if not me.is_present()
        throw AbsentValueError()
    return me.value.duplicate()

### Returns the wrapped value or `fallback` when absent, leaving this optional intact (NON-consuming).
### This avoids branching at the call site when a fixed fallback is acceptable. As with `unwrap`, the
### present-case result is a retaining copy (co-owned); `fallback` goes unused and is torn down at scope
### exit like any other unconsumed local.
### :param fallback: The fallback value to return when absent.
### :returns: The contained `T` value (a co-owning copy), or `fallback` if this `Optional` is absent.
@overridable
routine Optional[T].unwrap_or(fallback: T) -> T
needs RecordType T
    if not me.is_present()
        return fallback
    return me.value

### `unwrap_or` for a single-owner entity: the present value comes back as a duplicate (see `unwrap`).
@override
routine Optional[T].unwrap_or(fallback: T) -> T
needs EntityType T
needs T obeys Copyable
    if not me.is_present()
        return fallback
    return me.value.duplicate()

### `unwrap_or` for a variant: the present value comes back as a duplicate (see `unwrap`).
@override
routine Optional[T].unwrap_or(fallback: T) -> T
needs VariantType T
needs T obeys Copyable
    if not me.is_present()
        return fallback
    return me.value.duplicate()

### MOVES the wrapped value out, CONSUMING this optional (marks it absent). Unlike `unwrap` (which
### co-owns via a retaining copy and leaves the optional intact), this hands the payload's SINGLE
### reference to the caller and empties the carrier — the model an `Optional[Entity]` requires (an entity is
### single-owner: it cannot be co-owned/retained, only moved). The carrier's own `destruct` then no-ops on
### `value` (guarded by `is_present()`), so the moved-out payload is freed exactly once by its new owner.
### A re-`strip_out` of the now-absent optional fails LOUDLY (AbsentValueError), never silently corrupts.
### :returns: The contained `T` value, moved out.
### :throws: {AbsentValueError} if this `Optional` is absent.
@overridable
failable routine Optional[T].strip_out() -> T
needs RecordType T
    if not me.is_present()
        throw AbsentValueError()
    me.present = false
    # The value moves out: `present` is cleared first, so this Optional no longer owns it.
    danger
        return me.value.hijack().peek()

### `strip_out` for a variant: the value moves out of its slot, as a record's does.
@override
failable routine Optional[T].strip_out() -> T
needs VariantType T
    if not me.is_present()
        throw AbsentValueError()
    me.present = false
    danger
        return me.value.hijack().peek()

### `strip_out` for an entity (an `Optional[T]`): the optional is the entity's address, so the entity is made from
### that address, and the optional is then left `none`.
@override
failable routine Optional[T].strip_out() -> T
needs EntityType T
    if not me.is_present()
        throw AbsentValueError()
    danger
        var taken = LLVM::reinterpret_bits[Hijacked[T], T](Hijacked[T](me.value.get_address()))
        me.present = false
        return taken

routine Optional[T].is_present() -> Bool
    return me.present

### Returns whether both optionals are equal: both absent, or both present with equal values.
### :param you: The other optional to compare against.
### :returns: `true` when both are absent or both hold equal values, `false` when only one is absent.
@readonly
routine Optional[T].eq(you: Viewing[Optional[T]]) -> Bool
needs T obeys Equatable
    if not me.present
        return not you.present
    if not you.present
        return false
    return me.value == you.value

### Returns a keyed hash of this optional: a fixed value when absent, the value's own hash when present, so equal
### optionals hash the same.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
@readonly
routine Optional[T].hash(k0: U64, k1: U64) -> U64
needs T obeys Hashable
    if not me.present
        var absent_tag: U64 = 0x6E6F6E65
        return absent_tag.hash(k0: k0, k1: k1)
    return me.value.hash(k0: k0, k1: k1)
