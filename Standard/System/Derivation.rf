module System

import BuilderExpansion
import BuilderQuery
import Collections
### The auto-derived default `represent()` for any record/entity: `TypeName(field: value, …)`. Written as a
### universal `@overridable routine T.represent()` — the builder uses it as the represent for any
### record that doesn't provide its own (a hand-written `T.represent` or a kind-specialized
### `@override` takes precedence). Secret fields are hidden — the `openmemvarof` walk yields only the
### publicly-readable (OPEN ∪ POSTED) members. Each value renders via its own `represent`.
@readonly
@overridable
routine T.represent() -> Text
needs AnyType T
    var result = me.type_name() + "("
    var first = true
    expand m in openmemvarof(T)
        if not first
            result = result + ", "
        result = result + nameof(m) + ": " + me.$nameof(m).represent()
        first = false
    result = result + ")"
    return result

### The form a value takes as a CONTAINER ELEMENT: stringy leaves are quoted (Text/Bytes in `"…"`,
### Char/Byte in `'…'`) so nested strings print delimited (`["a", "b"]` / `['a', 'b']`), while
### numbers, nested containers and records stay structural. A single generic free routine — the `when T`
### type-switch is folded at monomorphization (T is concrete there; RF has no inheritance, so `T is X` is
### exact type-identity), so each instantiation collapses to just its arm. Containers call `nested_repr`
### on every element; the top-level `represent()` stays bare.
routine nested_repr(value: T) -> Text
needs AnyType T
    when T
        is Text => return "\"" + value.represent() + "\""
        is Bytes => return "\"" + value.represent() + "\""
        is Char => return "'" + value.represent() + "'"
        is Byte => return "'" + value.represent() + "'"
        else => return value.represent()

### Variant `represent()`: TYPE-dispatch on the live arm — `TypeName(payload_repr)`, or `TypeName(none)`
### for the absent arm. The `@override needs VariantType T` gate makes the wired synthesizer pick this
### over the record default for a variant type. `expand m in branchof(T)` generates one arm clause each;
### the explicit `is None` clause covers the absent arm the payload expansion skips.
@readonly
@override
routine T.represent() -> Text
needs VariantType T
    when me
        is None => return me.type_name() + "(none)"
        expand m in branchof(T)
            is $typeof(m) as v => return me.type_name() + "(" + v.represent() + ")"

### Variant `diagnose()`: `Module.Variant(type_id: <arm id>, <arm diagnose>)` — TAG-dispatch via
### `branchof`; the live arm's `typeidof(m)` (its stable type id) and the payload's `diagnose()`. The absent
### `None` arm shows `(type_id: 0, none)`. (No `None`/void arms exist — `None` is the canonical empty
### branch — so no bindingless-arm form is needed.)
@readonly
@override
routine T.diagnose() -> Text
needs VariantType T
    when me
        is None => return me.full_type_name() + "(type_id: 0, none)"
        expand m in branchof(T)
            is $typeof(m) as v => return me.full_type_name() + "(type_id: " + typeidof(m).represent() + ", " + v.diagnose() + ")"

### Choice `represent()`: VALUE-dispatch on the S32 discriminant via `caseof`, returning the bare case
### name (`READ`). `LLVM::reinterpret_bits[T, S32](me)` reads the discriminant, and `$valueof(c)` is each case's
### constant. The walk is exhaustive (one case always matches), so the trailing `pierce` is unreachable.
@readonly
@override
routine T.represent() -> Text
needs ChoiceType T
    expand c in caseof(T)
        if LLVM::reinterpret_bits[T, S32](me) == $valueof(c)
            return nameof(c)
    pierce LogicBreachedError()

### Choice `diagnose()`: `Module.ChoiceName(id: <discriminant>, CaseName)`, matching the C# builder.
@readonly
@override
routine T.diagnose() -> Text
needs ChoiceType T
    expand c in caseof(T)
        if LLVM::reinterpret_bits[T, S32](me) == $valueof(c)
            return me.full_type_name() + "(id: " + LLVM::reinterpret_bits[T, S32](me).represent() + ", " + nameof(c) + ")"
    pierce LogicBreachedError()

### Flags `represent()`: the ON members joined by `" and "` (`READ and WRITE`), or `none` if the
### bitmask is empty. A flags value is a COMBINATION, so `caseof` ACCUMULATES (no `when`): a SUBSET
### test per member (the bitmask `&` the member's value is not `0`) appends its name.
@readonly
@override
routine T.represent() -> Text
needs FlagsType T
    var result = ""
    var first = true
    expand c in caseof(T)
        if (LLVM::reinterpret_bits[T, U64](me) & $valueof(c)) != 0
            if first
                result = nameof(c)
            else
                result = result + " and " + nameof(c)
            first = false
    if first
        result = "none"
    return result

### Flags `diagnose()`: `Module.FlagsName(value: %<bits>, <members>)` — `<bits>` is LSB-first, one
### digit per declared member in declaration order ('1' if set), matching the C# builder.
@readonly
@override
routine T.diagnose() -> Text
needs FlagsType T
    var result = ""
    var first = true
    var bits = "%"
    expand c in caseof(T)
        if (LLVM::reinterpret_bits[T, U64](me) & $valueof(c)) != 0
            if first
                result = nameof(c)
            else
                result = result + " and " + nameof(c)
            first = false
            bits = bits + "1"
        else
            bits = bits + "0"
    if first
        result = "none"
    return me.full_type_name() + "(value: " + bits + ", " + result + ")"

### Choice `all_cases()`: every declared case value, in declaration order. `caseof` yields each case;
### `$valueof(c)` is its S32 discriminant, reinterpreted back to `Me` inline. This is the SAFE reverse: the
### walked `$valueof(c)` is by construction a declared discriminant, so no validity check is needed here (a
### from-untrusted-scalar public creator would additionally validate + throw). `Me` resolves as a type
### argument because this is a member routine whose owner is `T`.
@overridable
routine T.all_cases() -> List[Me]
needs ChoiceType T
    var result = List[Me]()
    expand c in caseof(T)
        result.add_last(value: LLVM::reinterpret_bits[S32, Me]($valueof(c)))
    return result

### Flags `all_cases()`: every declared single-bit member value; `$valueof(c)` is its U64 bit, reinterpreted
### back to `Me` inline (safe — a declared member bit).
@overridable
routine T.all_cases() -> List[Me]
needs FlagsType T
    var result = List[Me]()
    expand c in caseof(T)
        result.add_last(value: LLVM::reinterpret_bits[U64, Me]($valueof(c)))
    return result

### Choice/Flags `count()`: the number of declared cases/members. `caseof` unrolls at buildtime into one
### `n +% 1` per declared case, so the sum constant-folds to the case count — no runtime iteration remains.
### Written as a template (not a synthesized buildtime constant) so the demand collector materializes a real
### body; `+%` wraps rather than checks, though a declared-case count never approaches U64 overflow.
@readonly
@overridable
routine T.count() -> U64
needs ChoiceType T
    var n: U64 = 0
    expand c in caseof(T)
        n = n +% 1
    return n

@readonly
@overridable
routine T.count() -> U64
needs FlagsType T
    var n: U64 = 0
    expand c in caseof(T)
        n = n +% 1
    return n

### Tuple `represent()`: the SPECIAL tuple format `(v0, v1, …)` — no type name, no field names, each
### element in its container-element form (`nested_repr`), so text is quoted as in a list: `(3, "write")`.
### Distinct from the record `TypeName(field: value)` shape, hence the `is TupleType` override. A one-item tuple keeps
### its comma, `(1,)`, the way it is written.
@readonly
@override
routine T.represent() -> Text
needs TupleType T
    var result = "("
    var count: S64 = 0
    expand m in allmemvarof(T)
        if count > 0
            result = result + ", "
        result = result + nested_repr(me.$nameof(m))
        count += 1
    if count == 1
        result = result + ","
    return result + ")"

### Tuple `diagnose()`: `Module.Tuple[…](v0, v1, …)` — the qualified type name prefixed onto the same
### element walk (elements still render via `represent`, not `diagnose`, matching the C# builder).
@readonly
@override
routine T.diagnose() -> Text
needs TupleType T
    var result = me.full_type_name() + "("
    var first = true
    expand m in allmemvarof(T)
        if not first
            result = result + ", "
        result = result + me.$nameof(m).represent()
        first = false
    return result + ")"

### Routine values: `represent`/`diagnose` show the SIGNATURE (the routine type's name, e.g.
### `Callable[(S32,), S32]`) — executable code has no field structure to walk. `serialize` boxes that same
### signature Text: serializing code is meaningless, but the signature is the useful view. These make a
### routine-typed member (an entity may hold one — `entity Callback { f: Callable[...] }`) serialize
### uniformly through the universal walk, no capability gate.
@readonly
@override
routine T.represent() -> Text
needs RoutineType T
    return me.type_name()

@readonly
@override
routine T.diagnose() -> Text
needs RoutineType T
    return me.full_type_name()

@override
routine T.serialize() -> SerialValue
needs RoutineType T
    return SerialValue(from: me.represent())

### A crashable's `crash_title()`, as a `needs CrashableType T` body sees it. The builder gives every crashable its
### title, its type name in sentence case (`AbsentValueError` -> "Absent value error"), which wins over this one.
@readonly
@overridable
routine T.crash_title() -> Text
needs CrashableType T
    return me.type_name()

### A crashable's `crash_message()`, as a `needs CrashableType T` body sees it. Every crashable writes its own
### (RF-S704), which wins over this one, so this body never runs: it only lets a crashable derive call
### `me.crash_message()`.
@readonly
@overridable
routine T.crash_message() -> Text
needs CrashableType T
    return me.crash_title()

### Crashable `represent()`: the human-readable message (`crash_message()`), NOT the record field walk — a
### crashable is surfaced to users, logs and `f"{err}"` by its message. The `needs CrashableType T` kind gate
### makes the derive selector pick this over the record `needs AnyType T` default (which would show the empty
### `TypeName()` for a fieldless error); `crash_message` resolves via the CrashableType derive above.
@readonly
@override
routine T.represent() -> Text
needs CrashableType T
    return me.crash_message()

### Crashable `diagnose()`: `Module.CrashableName(<crash_message>[, field: value, …])` — the qualified type
### name, the message as the first element, then each declared field via its own `represent` (matching the
### former C# builder).
@readonly
@override
routine T.diagnose() -> Text
needs CrashableType T
    var result = me.full_type_name() + "(" + me.crash_message()
    expand m in allmemvarof(T)
        result = result + ", " + nameof(m) + ": " + me.$nameof(m).represent()
    return result + ")"

### A routine VALUE (`{ptr fn, ptr bound}`) owns no heap resource that a holding field is responsible for —
### a captureless function pointer, or a bound word managed elsewhere — so its teardown is a no-op. The
### record/entity/variant destroy templates are kind-gated and none match a RoutineType, so without this a
### routine-typed member (`entity Callback { f: Callable[...] }`, an iterator's `transform`/`predicate`) would
### field-walk into an UNDEFINED `Callable[(…),…].destruct()` at link.
@override
routine T.destruct()
needs RoutineType T
    return

### The auto-derived default `diagnose()` for any record: `Module.TypeName(field: value, …)`. Uses the
### fully-qualified name and shows ALL fields (secret ones prefixed `[secret] ` via `visibilityof`); each
### value still renders via `represent` (never `diagnose`) to avoid exponentially verbose nested output.
@readonly
@overridable
routine T.diagnose() -> Text
needs AnyType T
    var result = me.full_type_name() + "("
    var first = true
    expand m in allmemvarof(T)
        if not first
            result = result + ", "
        if visibilityof(m) == SECRET
            result = result + "[secret] "
        result = result + nameof(m) + ": " + me.$nameof(m).represent()
        first = false
    result = result + ")"
    return result

### The auto-derived default `eq()` for any record/entity/tuple: equal when every member variable is
### equal. Written as the universal `@overridable routine T.eq()`; `ne` is derived from this by the
### builder (`return not me.eq(...)`). The buildtime `expand` field-walk replaces the hand-written C#
### builder — a zero-field type expands to no comparisons and returns `true`.
@overridable
routine T.eq(you: Viewing[T]) -> Bool
needs T obeys Equatable
    expand m in allmemvarof(T)
        if me.$nameof(m) != you.$nameof(m)
            return false
    return true

### The auto-derived default `compare()` for any record/entity/tuple: lexicographic comparison in
### declaration order, returning at the first non-`SAME` member. Written as the universal
### `@overridable routine T.compare()`; `lt`/`le`/`gt`/`ge` are derived from this by the builder. A
### zero-field type expands to no comparisons and returns `SAME`.
@overridable
routine T.compare(you: Viewing[T]) -> ComparisonSign
needs T obeys Comparable
    expand m in allmemvarof(T)
        if me.$nameof(m).compare(you: you.$nameof(m)) != SAME
            return me.$nameof(m).compare(you: you.$nameof(m))
    return SAME

### Returns this choice's discriminant: `status.to[S32]()`.
### :returns: The discriminant.
@readonly
routine T.to[S32]() -> S32
needs ChoiceType T
    return LLVM::reinterpret_bits[T, S32](me)

### Returns this choice's discriminant widened to `S64`: `status.to[S64]()`.
### :returns: The discriminant.
@readonly
routine T.to[S64]() -> S64
needs ChoiceType T
    return LLVM::sign_extend[S32, S64](LLVM::reinterpret_bits[T, S32](me))

### Returns this flags value's bitmask: `perms.to[U64]()`.
### :returns: The bitmask.
@readonly
routine T.to[U64]() -> U64
needs FlagsType T
    return LLVM::reinterpret_bits[T, U64](me)

### Choice `eq`/`compare`: a choice holds EXACTLY ONE case, so equality and ordering are just a compare of
### the S32 discriminant — NOT the record field-walk above (a choice has no member variables, so
### `allmemvarof(T)` is empty and the record template would wrongly return `true`/`SAME` for every pair).
### Reading the discriminant is a reinterpretation of the value (the same read the choice `represent` makes), and the inner
### `==`/`compare` resolve to the hand-written `S32` ops, so there is no recursion back into this derive.
@override
routine T.eq(you: Viewing[T]) -> Bool
needs ChoiceType T
    return LLVM::reinterpret_bits[T, S32](me) == LLVM::reinterpret_bits[T, S32](you)

@override
routine T.compare(you: Viewing[T]) -> ComparisonSign
needs ChoiceType T
    return LLVM::reinterpret_bits[T, S32](me).compare(you: LLVM::reinterpret_bits[T, S32](you))

### Choice `hash`: a choice IS its S32 discriminant, so hashing reinterprets to the integral identity
### (the discriminant widened to `S64`) and defers to the hand-written `S64` keyed hash. Without
### this override the call binds to the abstract `Hashable.hash` and the protocol type leaks to codegen.
@override
routine T.hash(k0: U64, k1: U64) -> U64
needs ChoiceType T
    return LLVM::sign_extend[S32, S64](LLVM::reinterpret_bits[T, S32](me)).hash(k0: k0, k1: k1)

### Flags `eq`: EXACT bitmask equality (`perms == READ` means "exactly READ, nothing else"). A flags value
### is a SET of bits, so membership/subset ("is READ on?") is the separate `in` operator, never `==`. Like
### the choice derives, this compares the reinterpreted U64 bitmask via the hand-written `U64` op — no
### field-walk, no recursion. Flags have no natural total order, so no `compare` derive.
@override
routine T.eq(you: Viewing[T]) -> Bool
needs FlagsType T
    return LLVM::reinterpret_bits[T, U64](me) == LLVM::reinterpret_bits[T, U64](you)

### Flags bitwise combinators: `bitor` (union), `bitand` (intersection), `bitxor` for symmetry, and `without`
### (the members of `me` that `you` lacks). A flags value IS its U64 bitmask, so each reads both operands as U64, applies the
### U64 bitwise op, and reinterprets the result back to the flags type. The result bits are always a subset
### of declared members (both operands are valid), so the reverse reinterpret is safe — no validity check.
### `Me` resolves as a type argument because the owner is `T` (a member routine).
@override
routine T.bitor(you: T) -> Me
needs FlagsType T
    return LLVM::reinterpret_bits[U64, Me](LLVM::reinterpret_bits[T, U64](me).bitor(you: LLVM::reinterpret_bits[T, U64](you)))

@override
routine T.bitand(you: T) -> Me
needs FlagsType T
    return LLVM::reinterpret_bits[U64, Me](LLVM::reinterpret_bits[T, U64](me).bitand(you: LLVM::reinterpret_bits[T, U64](you)))

@override
routine T.bitxor(you: T) -> Me
needs FlagsType T
    return LLVM::reinterpret_bits[U64, Me](LLVM::reinterpret_bits[T, U64](me).bitxor(you: LLVM::reinterpret_bits[T, U64](you)))

### Whether every member of `you` is on in `me`: `perms.has(READ and WRITE)`.
### :param you: The members to look for.
### :returns: `true` when all of them are on.
@override
routine T.has(you: T) -> Bool
needs FlagsType T
    return LLVM::reinterpret_bits[T, U64](me).bitand(you: LLVM::reinterpret_bits[T, U64](you)) == LLVM::reinterpret_bits[T, U64](you)

### Returns whether `you` is not in this value: the opposite of `has`.
### :param you: The value to look for.
### :returns: `true` when `you` is absent.
@override
routine T.lacks(you: T) -> Bool
needs FlagsType T
    return not me.has(you)

### Whether at least one member of `you` is on in `me`: `perms.has_any(READ and WRITE)`.
### :param you: The members to look for.
### :returns: `true` when one or more of them are on.
@override
routine T.has_any(you: T) -> Bool
needs FlagsType T
    return LLVM::reinterpret_bits[T, U64](me).bitand(you: LLVM::reinterpret_bits[T, U64](you)) != 0

### Whether no member of `you` is on in `me`: `perms.lacks(WRITE)`.
### :param you: The members to look for.
### :returns: `true` when none of them is on.
@override
routine T.lacks(you: T) -> Bool
needs FlagsType T
    return LLVM::reinterpret_bits[T, U64](me).bitand(you: LLVM::reinterpret_bits[T, U64](you)) == 0

### The flags of `me` with the members of `you` taken off: `perms.without(WRITE)`.
### :param you: The members to take off.
### :returns: `me` without those members.
@override
routine T.without(you: T) -> Me
needs FlagsType T
    return LLVM::reinterpret_bits[U64, Me](LLVM::reinterpret_bits[T, U64](me).bitand(you: LLVM::reinterpret_bits[T, U64](you).bitnot()))

### Flags `all_off` (empty mask) / `all_on` (union of every declared member bit, folded over `caseof`).
@override
routine T.all_off() -> Me
needs FlagsType T
    return LLVM::reinterpret_bits[U64, Me](0)

@override
routine T.all_on() -> Me
needs FlagsType T
    var mask: U64 = 0
    expand c in caseof(T)
        mask = mask.bitor(you: $valueof(c))
    return LLVM::reinterpret_bits[U64, Me](mask)

### The auto-derived ordering helpers `lt`/`le`/`gt`/`ge` for any Comparable type, derived from `compare`
### (`me.compare(you)` is `ME_SMALL`/`SAME`/`ME_LARGE`). These used to be emitted by the C# DerivedOperatorPass,
### which the collector/harness codegen path lost; deriving them here routes them through the same
### everywhere-derive template mechanism as `represent`/`compare` (registered + materialized by the collector),
### so `a < b` (-> `a.lt(b)`) resolves for Char, numerics, records, collections uniformly.
routine T.lt(you: Viewing[T]) -> Bool
needs T obeys Comparable
    return me.compare(you: you) == ME_SMALL

routine T.le(you: Viewing[T]) -> Bool
needs T obeys Comparable
    return me.compare(you: you) != ME_LARGE

routine T.gt(you: Viewing[T]) -> Bool
needs T obeys Comparable
    return me.compare(you: you) == ME_LARGE

routine T.ge(you: Viewing[T]) -> Bool
needs T obeys Comparable
    return me.compare(you: you) != ME_SMALL

### The auto-derived fast `hash()` for any record/entity/tuple: XOR-fold each member variable's fast
### hash. Seeded at `0` (the XOR identity), so a single-field type hashes to exactly that field's hash
### and a zero-field type hashes to `0` — matching the hand-written C# builder. `expand` field-walk.
@overridable
routine T.hash() -> U64
needs T obeys Hashable
    var acc: U64 = 0
    expand m in allmemvarof(T)
        acc = acc.bitxor(you: me.$nameof(m).hash())
    return acc

### The auto-derived keyed `hash(k0, k1)`: same XOR-fold, threading the seed keys through each member
### variable's keyed hash.
@overridable
routine T.hash(k0: U64, k1: U64) -> U64
needs T obeys Hashable
    var acc: U64 = 0
    expand m in allmemvarof(T)
        acc = acc.bitxor(you: me.$nameof(m).hash(k0: k0, k1: k1))
    return acc

### The auto-derived default `serialize()` for a composite record/entity: field-walk into a
### `Dict[Text, SerialValue]` arm over the publicly-readable (`openmemvarof`) members, keyed by field
### name in declaration order (`Dict` iteration is insertion-ordered, so the output is stable).
###
### `serialize` is UNIVERSAL — EVERY type has one, so the walk calls `me.field.serialize()`
### UNCONDITIONALLY (no capability gate, no buildtime prune): a scalar with its own SerialValue arm boxes
### into that arm; a fixed-width scalar without one (S128, D64, Char, ...) boxes its `represent()`
### Text, which its `from_serial` parses back; a `Byte` boxes as `U8`; an aggregate record/entity
### recurses. `choice`/`flags`/variants override below, a routine value boxes its signature Text.
@overridable
routine T.serialize() -> SerialValue
needs AnyType T
    when T
        is Bool => return SerialValue(from: me)
        is S8 => return SerialValue(from: me)
        is S16 => return SerialValue(from: me)
        is S32 => return SerialValue(from: me)
        is S64 => return SerialValue(from: me)
        is U8 => return SerialValue(from: me)
        is U16 => return SerialValue(from: me)
        is U32 => return SerialValue(from: me)
        is U64 => return SerialValue(from: me)
        is B32 => return SerialValue(from: me)
        is B64 => return SerialValue(from: me)
        is Moment => return SerialValue(from: me)
        is Bytes => return SerialValue(from: me)
        is Text => return SerialValue(from: me)
        is Byte => return SerialValue(from: LLVM::reinterpret_bits[Byte, U8](value: me))
        is Char => return SerialValue(from: me.represent())
        is S128 => return SerialValue(from: me.represent())
        is U128 => return SerialValue(from: me.represent())
        is S256 => return SerialValue(from: me.represent())
        is U256 => return SerialValue(from: me.represent())
        is B16 => return SerialValue(from: me.represent())
        is BF16 => return SerialValue(from: me.represent())
        is B128 => return SerialValue(from: me.represent())
        is D32 => return SerialValue(from: me.represent())
        is D64 => return SerialValue(from: me.represent())
        is D128 => return SerialValue(from: me.represent())
        is Decimal => return SerialValue(from: me.represent())
        is C64 => return SerialValue(from: me.represent())
        is C128 => return SerialValue(from: me.represent())
        is C256 => return SerialValue(from: me.represent())
        is Address => return SerialValue(from: me.represent())
        else =>
            var __sv = Dict[Text, SerialValue]()
            expand m in openmemvarof(T)
                __sv[nameof(m)] = me.$nameof(m).serialize()
            return SerialValue(steal __sv)

### Choice `serialize()`: the bare case name as Text (`GREEN`), which `from_serial` looks up again.
@override
routine T.serialize() -> SerialValue
needs ChoiceType T
    return SerialValue(from: me.represent())

### Flags `serialize()`: the list of set member names (`["READ", "WRITE"]`), empty when no bit is set.
@override
routine T.serialize() -> SerialValue
needs FlagsType T
    var names = List[SerialValue]()
    expand c in caseof(T)
        if (LLVM::reinterpret_bits[T, U64](me) & $valueof(c)) != 0
            names.add_last(value: SerialValue(from: nameof(c)))
    return SerialValue(steal names)

### Variant `serialize()`: a one-entry table `{arm: payload}` naming the live arm, or `None` for the
### absent arm, so `from_serial` knows which arm to rebuild.
@override
routine T.serialize() -> SerialValue
needs VariantType T
    when me
        is None => return none
        expand m in branchof(T)
            is $typeof(m) as v =>
                var table = Dict[Text, SerialValue]()
                table[nameof(m)] = v.serialize()
                return SerialValue(steal table)

### The auto-derived deep `copy()` (Copyable): forwards to `store` — a bitwise copy for a pure value
### type, or the retaining store for a managed-leaf / retaining-field record. Same as the C# builder.
@overridable
routine T.duplicate() -> Me
needs T obeys Copyable
    return me.share()

### Variant `copy()`: TAG-dispatch DEEP copy — reconstruct the live arm with a copied payload, so a
### heap arm (a collection, a managed leaf) is NOT bitwise-aliased (which would double-free). `branchof`
### emits one clause per payload arm boxing `v.duplicate()` back into the variant via the arm constructor
### `Me(from: …)`; None / borrow arms (borrow can't be a variant payload) fall to `else => return me`.
@override
routine T.duplicate() -> Me
needs VariantType T
needs T obeys Copyable
    when me
        expand m in branchof(T)
            is $typeof(m) as v =>
                return T(from: v.duplicate())
        else => return me

### `duplicate()` of a value aggregate that holds an entity (a bundle instance, a tuple, an Array of entities): it has
### no `assign` (a shallow copy would make two owners of the entity), so each member is duplicated into a zeroed
### value of its own.
@override
routine T.duplicate() -> Me
needs OwningValueType T
needs T obeys Copyable
    danger
        var result = LLVM::zeroed[T]()
        expand m in allmemvarof(T)
            result.$nameof(m) = me.$nameof(m).duplicate()
        return result

### Entity `duplicate()`: a new entity of its own whose every member is a duplicate of this one's. An entity
### has no `assign` (a copy would be a second owner), so the base forward does not apply. The new entity starts
### zeroed (`hollow`) and each member is filled in from `me`, so no constructor argument list is needed.
@override
routine T.duplicate() -> Me
needs EntityType T
needs T obeys Copyable
    danger
        var result = hollow[T]()
        expand m in allmemvarof(T)
            result.$nameof(m) = me.$nameof(m).duplicate()
        return result

### The auto-derived `destruct()`: tear down each member (unconditionally, every type has a `destruct`, a no-op
### for a raw-pointer / scalar / borrow leaf). Records/tuples stop here (stack values). An ENTITY then gives back
### its own box: one `destruct` call ends the entity. A written entity `destruct` holds only the teardown of what
### the entity owns, and the builder adds the same `me.hijack().invalidate()` before each of its returns. The
### `allmemvarof` walk covers every owned member including `secret`.
@overridable
routine T.destruct()
needs RecordType T
    expand m in allmemvarof(T)
        me.$nameof(m).destruct()
    return

@override
routine T.destruct()
needs EntityType T
    expand m in allmemvarof(T)
        me.$nameof(m).destruct()
    me.hijack().invalidate()
    return

### Variant `destruct()`: TAG-dispatch — tear down ONLY the live arm's payload (a variant is a union,
### one arm live at a time). `branchof` generates one `is $typeof(m) v =>` clause per payload arm; the
### `else` arm covers the payload-less / void arms (nothing to destroy).
@override
routine T.destruct()
needs VariantType T
    when me
        expand m in branchof(T)
            is $typeof(m) as v =>
                v.destruct()
                return
        else => return

### The auto-derived cycle-collector TRACE hook `roam_trace()`: reports this value's strong
### (`Roamed`) edges to the collector. The universal default walks every member, delegating to each
### member's own `roam_trace` — a `Roamed` field reports its controller (override in Roamed.rf),
### a plain value member is a no-op (empty walk / no edge), a bare owned sub-entity recurses so nested
### aggregates (e.g. an SF container overlay's `inner: List[T]`) are descended. Container entities with
### raw `Hijacked` element buffers OVERRIDE this to call `cyclic_trace_buffer` — a raw pointer cannot
### self-describe its length, so the container (which knows its `count`) supplies it.
@overridable
dangerous routine T.roam_trace()
needs AnyType T
    expand m in allmemvarof(T)
        me.$nameof(m).roam_trace()
    return

### Variant `roam_trace()`: descend ONLY into the live arm's payload (a variant is a union). The
### `None` / void arms own no edge.
@override
dangerous routine T.roam_trace()
needs VariantType T
    when me
        expand m in branchof(T)
            is $typeof(m) as v =>
                v.roam_trace()
                return
        else => return

### The auto-derived cycle-collector FREE hook `roam_free()`: tears down this value's OWNED
### resources but NOT its `Roamed` edges — the collector frees the whole white cycle directly, so
### following a `Roamed` edge here would double-free a sibling reaped in the same batch. The universal
### default is a plain `destruct` (a value / plain record owns no `Roamed` edge, so full teardown is
### safe); `Roamed[T]` overrides to a no-op (Roamed.rf).
@overridable
dangerous routine T.roam_free()
needs AnyType T
    me.destruct()
    return

### Entity `roam_free()`: walk each member's `roam_free` (so a `Roamed` member is SKIPPED via
### its no-op override, while an owned member is torn down) then give back this entity's own box.
@override
dangerous routine T.roam_free()
needs EntityType T
    expand m in allmemvarof(T)
        me.$nameof(m).roam_free()
    me.hijack().invalidate()
    return

### Variant `roam_free()`: tear down ONLY the live arm's payload, skipping its `Roamed` edges.
@override
dangerous routine T.roam_free()
needs VariantType T
    when me
        expand m in branchof(T)
            is $typeof(m) as v =>
                v.roam_free()
                return
        else => return

### The copy step `=` runs for a record: a bitwise `var result = me` (the builder does not run `share` on this
### self-copy, so there is no recursion), then each member is copied in place by its own `share`. A plain value
### field's `share` is the bitwise `return me`, and a field holding a handle (a `Guarded` buffer of a `Text`, an RC
### wrapper) gains one more holder, so the two copies tear down in balance.
@overridable
secret routine T.share() -> Me
needs RecordType T
    var result = me
    expand m in allmemvarof(T)
        result.$nameof(m) = me.$nameof(m).share()
    return result

### The copy step `=` runs for a variant: the live case is rebuilt around a copy made by its own `share`, so a
### case holding a handle gains one more holder instead of being aliased bit for bit. Empty cases fall to
### `else => return me`. A variant held in a record field (`Maybe[S32]` in a record) needs it too: the record's
### own `share` walk calls it.
@override
secret routine T.share() -> Me
needs VariantType T
    when me
        expand m in branchof(T)
            is $typeof(m) as v =>
                return T(from: v.share())
        else => return me
