module System

import BuilderExpansion
import BuilderQuery

### Builder plumbing for presets computed at build time: the value written back as RazorForge source that reads
### as the same value, a literal or a construction from literals (`Point(x: 3, y: 4)`). A number is written bare:
### it takes its type from the preset's declared type, or from the member or parameter it fills. The build runs the
### program's presets once, reads this text back and puts it where each preset is used. A value with no such
### spelling (a `List`, a `Bytes`) gives `!` and its type name, which the build reports.
### :returns: The source text.
@readonly
@overridable
routine T.preset_literal() -> Text
needs AnyType T
    when T
        is Bool => return me.represent()
        is S8 => return signed_literal(text: me.represent(), is_min: me == S8_MIN, min: "S8_MIN")
        is S16 => return signed_literal(text: me.represent(), is_min: me == S16_MIN, min: "S16_MIN")
        is S32 => return signed_literal(text: me.represent(), is_min: me == S32_MIN, min: "S32_MIN")
        is S64 => return signed_literal(text: me.represent(), is_min: me == S64_MIN, min: "S64_MIN")
        is S128 => return signed_literal(text: me.represent(), is_min: me == S128_MIN, min: "S128_MIN")
        is U8 => return me.represent()
        is U16 => return me.represent()
        is U32 => return me.represent()
        is U64 => return me.represent()
        is U128 => return me.represent()
        is B32 => return b32_literal(value: me)
        is B64 => return b64_literal(value: me)
        is Decimal => return me.represent()
        is Text => return text_literal(text: me)
        is Char => return "'" + code_point_escape(code: me.to[U32]()) + "'"
        is Byte => return "b'\\x" + hex_digits(value: me.to[U8]().to[U64](), count: 2) + "'"
        else =>
            var result = me.type_name() + "("
            var first = true
            expand m in allmemvarof(T)
                if not first
                    result = result + ", "
                result = result + nameof(m) + ": " + me.$nameof(m).preset_literal()
                first = false
            return result + ")"

### A tuple as its items in parentheses: `(3, "write")`.
### :returns: The source text.
@readonly
@override
routine T.preset_literal() -> Text
needs TupleType T
    var result = "("
    var first = true
    expand m in allmemvarof(T)
        if not first
            result = result + ", "
        result = result + me.$nameof(m).preset_literal()
        first = false
    return result + ")"

### A choice as its type and case: `Color.GREEN`.
### :returns: The source text.
@readonly
@override
routine T.preset_literal() -> Text
needs ChoiceType T
    return me.type_name() + "." + me.represent()

### A flags value has no spelling made of literals here.
### :returns: `!` and the type name.
@readonly
@override
routine T.preset_literal() -> Text
needs FlagsType T
    return "!" + me.type_name()

### A variant has no spelling made of literals here.
### :returns: `!` and the type name.
@readonly
@override
routine T.preset_literal() -> Text
needs VariantType T
    return "!" + me.type_name()

### A signed number in decimal, or the name of its type's smallest value, whose magnitude does not fit the type.
### :returns: The source text.
secret routine signed_literal(text: Text, is_min: Bool, min: Text) -> Text
    return if is_min then min else text

### A `B32` as a hexadecimal float literal of the same bits: `0x1.800000p+1`.
### :returns: The source text: `inf`, `-inf` or `nan` for an infinity or a NaN.
secret routine b32_literal(value: B32) -> Text
    var bits = value.to_bits()
    var sign = ""
    if (bits >>> 31) != 0
        sign = "-"
    var exponent = (bits >>> 23) & 0xFF
    var fraction = (bits & 0x7FFFFF).to[U64]() << 1
    if exponent == 0xFF
        return if fraction == 0 then sign + "inf" else "nan"
    if exponent == 0
        if fraction == 0
            return sign + "0x0" + "p+0"
        return f"{sign}0x0.{hex_digits(value: fraction, count: 6)}p-126"
    return f"{sign}0x1.{hex_digits(value: fraction, count: 6)}p{exponent_text(value: exponent.to[S64]() - 127)}"

### A `B64` as a hexadecimal float literal of the same bits: `0x1.8000000000000p+1`.
### :returns: The source text: `inf`, `-inf` or `nan` for an infinity or a NaN.
secret routine b64_literal(value: B64) -> Text
    var bits = value.to_bits()
    var sign = ""
    if (bits >>> 63) != 0
        sign = "-"
    var exponent = (bits >>> 52) & 0x7FF
    var fraction = bits & 0xFFFFFFFFFFFFF
    if exponent == 0x7FF
        return if fraction == 0 then sign + "inf" else "nan"
    if exponent == 0
        if fraction == 0
            return sign + "0x0" + "p+0"
        return f"{sign}0x0.{hex_digits(value: fraction, count: 13)}p-1022"
    return f"{sign}0x1.{hex_digits(value: fraction, count: 13)}p{exponent_text(value: exponent.to[S64]() - 1023)}"

### A binary exponent with its sign: `+1`, `-3`.
### :returns: The source text.
secret routine exponent_text(value: S64) -> Text
    return if value < 0 then value.represent() else "+" + value.represent()

### `value` in hexadecimal with exactly `count` digits, zeros in front.
### :returns: The digits.
secret routine hex_digits(value: U64, count: U64) -> Text
    var digits = value.to_text(radix: 16)
    until digits.count >= count
        digits = "0" + digits
    return digits

### A text as a quoted literal: printable ASCII as it is, everything else (and `"` and `\`) as a `\u` escape.
### :returns: The source text.
secret routine text_literal(text: Text) -> Text
    var result = "\""
    each letter in text
        var code = letter.codepoint()
        if 0x20 <= code <= 0x7E and code != 0x22 and code != 0x5C
            result = result + letter.to[Text]()
        else
            result = result + code_point_escape(code: code)
    return result + "\""

### A code point as a `\u` escape of six hexadecimal digits.
### :returns: The escape.
secret routine code_point_escape(code: U32) -> Text
    return "\\u" + hex_digits(value: code.to[U64](), count: 6)
