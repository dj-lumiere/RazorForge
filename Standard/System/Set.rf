module System

import BuilderQuery
secret preset SET_INITIAL_CAPACITY: U64 = 16
secret preset SET_INITIAL_ENTRIES: U64 = 16
secret preset CTRL_EMPTY: U8 = 128
secret preset CTRL_TOMBSTONED: U8 = 254
secret preset CTRL_H2_MASK: U8 = 127
secret preset ENTRY_DEAD: U8 = 0
secret preset ENTRY_LIVE: U8 = 1

### A hash-flooding-resistant insertion-ordered set.
###
### `Set[T]` works like {Set[T]} (insertion-ordered iteration, O(1) average operations)
### but uses SipHash-2-4 keyed with a per-instance secret to make the probe sequence
### unpredictable to external attackers. Iteration order follows insertion order; the secure
### key only affects the probe-array layout, not the entries array.
###
### **When to use**
### - You are storing data derived from untrusted input (e.g. tokens, user-supplied strings, request IDs).
### - You need membership testing with a security guarantee against hash-flooding.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `contains` | O(1) | O(n) |
### | Iteration | O(n + tombstones) | O(n + tombstones) |
###
### :typeparam T: The element type. Must obey {Hashable} and {Equatable}.
### :see: {Dict[K, V]} for the dictionary counterpart.
entity Set[T]
relates SetEmitter[T] as Emitter
obeys Emittable[T], Container, SetLiteral[T]
needs T obeys Hashable, Equatable
    secret ctrl: Hijacked[U8]
    secret indices: Hijacked[U64]
    secret slots: Hijacked[T]
    secret entry_live: Hijacked[U8]
    secret count: U64
    secret deleted: U64
    secret entries_used: U64
    secret capacity: U64
    secret entries_cap: U64
    secret k0: U64
    secret k1: U64

### Emitter that walks the dense entries array of a {Set[T]} in insertion order.
entity SetEmitter[T]
obeys Emitter[T]
    secret slots: Hijacked[T]
    secret entry_live: Hijacked[U8]
    secret entries_used: U64
    secret pos: U64

# ============================================================================
# Creators
# ============================================================================

### Creates a set containing the given `elements` (duplicates collapsed). Variadic constructor behind the
### `{a, b, c}` set-literal syntax (the `SetLiteral` opt-in): the builder packs the elements into a
### fixed `Array[T, K]` and monomorphizes one body per element count `K`.
### :param elements: The elements to insert; duplicates are ignored.
### :returns: A set of the distinct given elements.
common routine Set[T].from_literal(elements...: T) -> Set[T]
needs T obeys Hashable, Equatable
    var result = Set[T]()
    var i: U64 = 0
    until i >= elements.count()
        drop result.add(value: elements.get_raw(index: i))
        i = i +% 1
    return result

routine Set[T]() -> Set[T]
    return Set[T](key: SecureHashKey.random())

routine Set[T](key: SecureHashKey) -> Set[T]
    var cap = SET_INITIAL_CAPACITY
    var ecap = SET_INITIAL_ENTRIES
    danger
        var set = Set[T](
            ctrl: Hijacked[U8].hollow(),
            indices: Hijacked[U64].hollow(),
            slots: Hijacked[T].hollow(),
            entry_live: Hijacked[U8].hollow(),
            count: 0,
            deleted: 0,
            entries_used: 0,
            capacity: cap,
            entries_cap: ecap,
            k0: key.k0,
            k1: key.k1,
        )
        set.ctrl = Hijacked[U8](C::rf_allocate_dynamic_uninit(cap))
        C::rf_set_bytes_at(
            dest: set.ctrl.address(),
            value: CTRL_EMPTY,
            size: cap,
        )
        set.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
        set.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * ecap))
        set.entry_live = Hijacked[U8](C::rf_allocate_dynamic_uninit(ecap))
        return set

### :throws: {OutOfMemoryError} The storage is more bytes than a `U64` counts, or the heap has no room for it.
failable routine Set[T](key: SecureHashKey, capacity: U64) -> Set[T]
    var cap = storage_doubled_capacity(start: SET_INITIAL_CAPACITY, capacity: capacity)
    var ecap = storage_doubled_capacity(start: SET_INITIAL_ENTRIES, capacity: capacity)
    danger
        var set = Set[T](
            ctrl: Hijacked[U8].hollow(),
            indices: Hijacked[U64].hollow(),
            slots: Hijacked[T].hollow(),
            entry_live: Hijacked[U8].hollow(),
            count: 0,
            deleted: 0,
            entries_used: 0,
            capacity: cap,
            entries_cap: ecap,
            k0: key.k0,
            k1: key.k1,
        )
        set.ctrl = Hijacked[U8](allocate_storage_uninit(element_size: U8.data_size(), count: cap))
        C::rf_set_bytes_at(
            dest: set.ctrl.address(),
            value: CTRL_EMPTY,
            size: cap,
        )
        set.indices = Hijacked[U64](allocate_storage_uninit(element_size: U64.data_size(), count: cap))
        set.slots = hijacked_from[T](allocate_storage_uninit(element_size: T.data_size(), count: ecap))
        set.entry_live = Hijacked[U8](allocate_storage_uninit(element_size: U8.data_size(), count: ecap))
        return set

# ============================================================================
# Internal Helpers
# ============================================================================

@readonly
routine Set[T].h2(hash: U64) -> U8
    return (hash & CTRL_H2_MASK.to[U64]()).to[U8]()

@readonly
routine Set[T].h1(hash: U64) -> U64
    return hash >> 7

@readonly
routine Set[T].read_index(slot: U64) -> U64
    danger
        return me.indices.offset(U64.data_size() * slot).peek()

@readonly
routine Set[T].find_slot(value: T) -> U64
    var h = value.hash(k0: me.k0, k1: me.k1)
    var target = me.h2(h)
    var mask = me.capacity -% 1
    var i = me.h1(h) & mask
    danger
        loop
            var c = me.ctrl.offset(ByteSize(bytes: i)).peek()
            if c == CTRL_EMPTY
                return me.capacity
            if c == target
                var ei = me.indices.offset(U64.data_size() * i).peek()
                if me.slots.offset(T.data_size() * ei).peek() == value
                    return i
            i = i +% 1 & mask
    return me.capacity

@reshaping
routine Set[T].insert_index_raw(h: U64, entry_index: U64)
    var h2_val = me.h2(h)
    var mask = me.capacity -% 1
    var i = me.h1(h) & mask
    danger
        loop
            var c = me.ctrl.offset(ByteSize(bytes: i)).peek()
            if c == CTRL_EMPTY
                me.ctrl.offset(ByteSize(bytes: i)).poke(h2_val)
                me.indices.offset(U64.data_size() * i).poke(entry_index)
                return
            if c == CTRL_TOMBSTONED
                me.ctrl.offset(ByteSize(bytes: i)).poke(h2_val)
                me.indices.offset(U64.data_size() * i).poke(entry_index)
                me.deleted = me.deleted -% 1
                return
            i = i +% 1 & mask
    return

@readonly
routine Set[T].should_rehash() -> Bool
    if (me.count +% me.deleted) *% 8 >= me.capacity *% 7
        return true
    if me.entries_used >= me.entries_cap
        return true
    return false

@reshaping
routine Set[T].rehash()
    var old_cap = me.capacity
    var old_ecap = me.entries_cap
    var old_ctrl = me.ctrl
    var old_indices = me.indices
    var old_slots = me.slots
    var old_entry_live = me.entry_live
    var old_entries_used = me.entries_used

    var table_pressured = (me.count +% me.deleted) *% 8 >= old_cap *% 7
    var new_cap = old_cap
    if table_pressured
        new_cap = old_cap *% 2

    var new_ecap = old_ecap
    if me.count *% 2 >= old_ecap
        new_ecap = old_ecap *% 2

    danger
        me.ctrl = Hijacked[U8](C::rf_allocate_dynamic_uninit(new_cap))
        C::rf_set_bytes_at(
            dest: me.ctrl.address(),
            value: CTRL_EMPTY,
            size: new_cap,
        )
        me.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * new_cap))
        me.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * new_ecap))
        me.entry_live = Hijacked[U8](C::rf_allocate_dynamic_uninit(new_ecap))
    me.capacity = new_cap
    me.entries_cap = new_ecap
    me.count = 0
    me.deleted = 0
    me.entries_used = 0

    var i: U64 = 0
    until i >= old_entries_used
        danger
            var live = old_entry_live.offset(ByteSize(bytes: i)).peek()
            if live == ENTRY_LIVE
                var val = old_slots.offset(T.data_size() * i).peek()
                var new_ei = me.entries_used
                me.slots.offset(T.data_size() * new_ei).poke(val)
                me.entry_live.offset(ByteSize(bytes: new_ei)).poke(ENTRY_LIVE)
                me.entries_used = me.entries_used +% 1
                me.insert_index_raw(h: val.hash(k0: me.k0, k1: me.k1), entry_index: new_ei)
                me.count = me.count +% 1
        i = i +% 1

    danger
        if not old_ctrl.is_hollow()
            old_ctrl.invalidate()
        if not old_indices.is_hollow()
            old_indices.invalidate()
        if not old_slots.is_hollow()
            old_slots.invalidate()
        if not old_entry_live.is_hollow()
            old_entry_live.invalidate()
    return

# ============================================================================
# Core Operations
# ============================================================================

@readonly
routine Set[T].count() -> U64
    return me.count

@readonly
routine Set[T].is_empty() -> Bool
    return me.count == 0

@reshaping
routine Set[T].clear()
    danger
        C::rf_set_bytes_at(
            dest: me.ctrl.address(),
            value: CTRL_EMPTY,
            size: me.capacity,
        )
    me.count = 0
    me.deleted = 0
    me.entries_used = 0
    return

@readonly
routine Set[T].has(value: T) -> Bool
    return me.find_slot(value) < me.capacity

### Returns whether `value` is not in this value: the opposite of `has`.
### :param value: The value to look for.
### :returns: `true` when `value` is absent.
@readonly
routine Set[T].lacks(value: T) -> Bool
    return not me.has(value)

@reshaping
@discardable
routine Set[T].add(value: T) -> Bool
    if me.should_rehash()
        me.rehash()
    if me.find_slot(value) < me.capacity
        return false
    var ei = me.entries_used
    danger
        me.slots.offset(T.data_size() * ei).poke(value)
        me.entry_live.offset(ByteSize(bytes: ei)).poke(ENTRY_LIVE)
    me.entries_used = me.entries_used +% 1
    me.insert_index_raw(h: value.hash(k0: me.k0, k1: me.k1), entry_index: ei)
    me.count = me.count +% 1
    return true

@reshaping
@discardable
routine Set[T].remove(value: T) -> Bool
    var slot = me.find_slot(value)
    if slot >= me.capacity
        return false
    var ei = me.read_index(slot)
    danger
        me.ctrl.offset(ByteSize(bytes: slot)).poke(CTRL_TOMBSTONED)
        me.entry_live.offset(ByteSize(bytes: ei)).poke(ENTRY_DEAD)
    me.count = me.count -% 1
    me.deleted = me.deleted +% 1
    return true

# ============================================================================
# Iteration
# ============================================================================

@readonly
routine Set[T].emitter() -> SetEmitter[T]
    danger
        return SetEmitter[T](
            slots: me.slots,
            entry_live: me.entry_live,
            entries_used: me.entries_used,
            pos: 0,
        )

failable routine SetEmitter[T].emit() -> T
    danger
        until me.pos >= me.entries_used
            var p = me.pos
            me.pos = me.pos + 1
            if me.entry_live.offset(ByteSize(bytes: p)).peek() == ENTRY_LIVE
                return me.slots.offset(T.data_size() * p).peek()
    throw AbsentValueError()

# ============================================================================
# Set Operations
# ============================================================================

@readonly
routine Set[T].union(other: Viewing[Set[T]]) -> Set[T]
    var result = Set[T](key: SecureHashKey.random(), capacity: me.count +% other.count)
    each val in me
        drop result.add(val)
    each val in other
        drop result.add(val)
    return result

@readonly
routine Set[T].intersection(other: Viewing[Set[T]]) -> Set[T]
    var result = Set[T]()
    each val in me
        if other.has(val)
            drop result.add(val)
    return result

@readonly
routine Set[T].difference(other: Viewing[Set[T]]) -> Set[T]
    var result = Set[T]()
    each val in me
        if other.lacks(val)
            drop result.add(val)
    return result

@readonly
routine Set[T].symmetric_difference(other: Viewing[Set[T]]) -> Set[T]
    var result = Set[T]()
    each val in me
        if other.lacks(val)
            drop result.add(val)
    each val in other
        if me.lacks(val)
            drop result.add(val)
    return result

@readonly
routine Set[T].is_subset(other: Viewing[Set[T]]) -> Bool
    if me.count > other.count
        return false
    each val in me
        if other.lacks(val)
            return false
    return true

@readonly
routine Set[T].is_superset(other: Viewing[Set[T]]) -> Bool
    return other.is_subset(me)

@readonly
routine Set[T].is_disjoint(other: Viewing[Set[T]]) -> Bool
    each val in me
        if other.has(val)
            return false
    return true

# ============================================================================
# Conversion
# ============================================================================

### Creates a {List[T]} from all elements of `from` in insertion order.
### :returns: A new {List[T]} containing all elements of `from`.
routine Set[T].to[List[T]]() -> List[T]
    var result = List[T](capacity: me.count)
    each val in me
        result.add_last(val)
    return result

# ============================================================================
# Display
# ============================================================================

@readonly
@override
routine Set[T].represent() -> Text
    if me.is_empty()
        return "{}"
    var result = "{"
    var first = true
    each val in me
        if not first
            result = result + ", "
        result = result + nested_repr(val)
        first = false
    result = result + "}"
    return result

@readonly
@override
routine Set[T].diagnose() -> Text
    var result = me.full_type_name() + "(count: " + me.count().represent() + ", {"
    var first = true
    each val in me
        if not first
            result = result + ", "
        result = result + nested_repr(val)
        first = false
    result = result + "})"
    return result

# ============================================================================
# Comparison
# ============================================================================

@readonly
routine Set[T].eq(other: Viewing[Set[T]]) -> Bool
    if me.count != other.count
        return false
    each val in me
        if other.lacks(val)
            return false
    return true

@override
routine Set[T].destruct()
    danger
        # Tear down each live element before freeing the buffers (mirrors the live-entry scan in
        # SetEmitter.emit!). For value elements `destruct` is a no-op; for owned entity elements
        # this frees them. Must run before invalidating `slots`/`entry_live`.
        var p: U64 = 0
        until p >= me.entries_used
            if me.entry_live.offset(ByteSize(bytes: p)).peek() == ENTRY_LIVE
                me.slots
                    .offset(T.data_size() * p)
                    .peek()
                    .destruct()
            p = p + 1
        me.ctrl.invalidate()
        me.indices.invalidate()
        me.slots.invalidate()
        me.entry_live.invalidate()
        return

### Cycle-collector TRACE: report every live element to the collector. The `slots` buffer is SPARSE
### (open-addressing with tombstones), so `cyclic_trace_sparse_buffer` scans slots `0..used`, skipping
### dead entries via the `entry_live` bitmap. Overrides the universal member-walk (raw buffers cannot
### self-trace).
@override
dangerous routine Set[T].roam_trace()
    me.slots.cyclic_trace_sparse_buffer(live: me.entry_live, used: me.entries_used)
    return

### Cycle-collector FREE: free every owned buffer and this set's own box, but NOT the elements (the
### collector frees the whole white cycle directly).
@override
dangerous routine Set[T].roam_free()
    me.ctrl.invalidate()
    me.indices.invalidate()
    me.slots.invalidate()
    me.entry_live.invalidate()
    return

### Serializes this collection to a `SerialValue.List`, serializing each element.
### :returns: The `SerialValue.List` of each element's serialized form.
@readonly
@override
routine Set[T].serialize() -> SerialValue
    var __sv = List[SerialValue]()
    each __x in me
        __sv.add_last(value: __x.serialize())
    return SerialValue(__sv)
