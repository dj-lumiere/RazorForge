module System

### Represents the crashable raised when the runtime cannot satisfy an
### allocation request. A size past what a `U64` counts is reported as `U64_MAX` bytes.
crashable OutOfMemoryError
    ### Stores the number of bytes requested by the failed allocation, `U64_MAX` for a size past what a `U64` counts.
    requested_bytes: U64

### Represents the crashable raised when a raw memory access extends beyond the
### allocated region.
crashable MemoryBoundsError
    ### Stores the starting offset of the attempted access.
    offset: U64
    ### Stores the size in bytes of the attempted access.
    size: U64
    ### Stores the number of bytes that were actually allocated.
    allocated: U64

### Returns the default message for allocation failure.
### :returns: The resulting `Text` value.
@override
routine OutOfMemoryError.crash_message() -> Text
    if me.requested_bytes == U64_MAX
        return "Failed to allocate the storage: its size is more bytes than a U64 counts"
    return f"Failed to allocate {me.requested_bytes} bytes"

### Returns the default message for out-of-bounds memory access.
### :returns: The resulting `Text` value.
@override
routine MemoryBoundsError.crash_message() -> Text
    return f"Memory access at offset {me.offset} with size {me.size} exceeds allocated {me.allocated} bytes"
