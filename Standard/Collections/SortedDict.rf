module Collections

import BuilderQuery
secret preset B_DICT: U64 = 64
secret preset MIN_KEYS_DICT: U64 = 31

### Internal B-tree node for {SortedDict[TKey, TValue]}.
### Stores up to 63 ordered key-value pairs, up to 64 child pointers, and a cached subtree element count.
### :typeparam TKey: The key type.
### :typeparam TValue: The value type.
entity BTreeDictNode[TKey, TValue]
needs TKey obeys Comparable
    entry_keys: Slots[TKey, 63]
    entry_values: Slots[TValue, 63]
    children: Items[Hijacked[BTreeDictNode[TKey, TValue]], 64]
    key_count: U64
    child_count: U64
    subtree_size: U64
    is_leaf: Bool

### A sorted dictionary that maintains keys in ascending order, backed by a B-tree.
###
### `SortedDict[TKey, TValue]` maps comparable keys to values and always keeps those keys sorted.
### Unlike {Dict[TKey, TValue]}, which uses hashing and has no defined order, `SortedDict` lets
### you iterate in key order, efficiently find the minimum or maximum entry, and retrieve
### entries by sorted rank. Each key is unique — inserting an existing key overwrites its value.
###
### **When to use**
### - You need to iterate over entries in key order.
### - You need `min!` / `max!` or want the smallest/largest key at any time.
### - You need range queries over the key space.
### - You need rank-based access: the N-th smallest entry.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add` | O(log n) |
### | `remove` | O(log n) |
### | `contains` / `get!` / `get_or` | O(log n) |
### | `[]` rank-based access | O(log n) |
### | `min!` / `max!` | O(log n) |
### | `keys()` / `values()` | O(n) |
### | Iteration | O(n) |
###
### :typeparam TKey: The key type. Must obey {Comparable}.
### :typeparam TValue: The value type.
### :see: {Dict[TKey, TValue]} for an unordered dictionary with O(1) average lookup.
### :see: {SortedList[T]} for a sorted sequence that allows duplicates.
entity SortedDict[TKey, TValue]
relates SortedDictEmitter[TKey, TValue] as Emitter, TKey as Key, TValue as Value
obeys Emittable[(TKey, TValue)], KeyFindable, KeyContainer, DictLiteral[TKey, TValue]
needs TKey obeys Comparable
    secret root: Hijacked[BTreeDictNode[TKey, TValue]]?
    secret count: U64

### Emitter that yields entries of a {SortedDict[TKey, TValue]} in ascending key order.
### Holds a NON-OWNING `Hijacked` pointer to the dict — a cursor borrows its container, it does not
### own it. An owning `dict: SortedDict` field would make the emitter's teardown free the whole tree,
### double-freeing it against the real owner's scope-exit `destruct` (containment = ownership).
### :typeparam TKey: The key type.
### :typeparam TValue: The value type.
entity SortedDictEmitter[TKey, TValue]
obeys Emitter[(TKey, TValue)]
    dict: Hijacked[SortedDict[TKey, TValue]]
    index: U64

# ============================================================================
# Node buffer helpers
# ============================================================================

### Returns the number of entries currently stored in this node.
### :returns: The key count.
@readonly
secret routine BTreeDictNode[TKey, TValue].keys_count() -> U64
    return me.key_count

### Returns the number of child pointers currently stored in this node.
### :returns: The child count.
@readonly
secret routine BTreeDictNode[TKey, TValue].children_count() -> U64
    return me.child_count

### Returns a raw pointer to the start of the keys buffer.
### :returns: A {Hijacked[TKey]} pointing to the first key slot.
@readonly
secret routine BTreeDictNode[TKey, TValue].keys_base() -> Hijacked[TKey]
    return me.hijack().recast_as[TKey]()

### Returns a raw pointer to the start of the values buffer, offset past the keys region.
### :returns: A {Hijacked[TValue]} pointing to the first value slot.
@readonly
secret routine BTreeDictNode[TKey, TValue].values_base() -> Hijacked[TValue]
    return me
        .hijack()
        .recast_as[TKey]()
        .stride(count: 63)
        .recast_as[TValue]()

### Returns a raw pointer to the start of the children buffer, offset past the keys and values regions.
### The buffer holds child-node POINTERS (the tree is a manual `Hijacked` graph — a node does not own
### its children inline), so the base is a pointer-to-pointer.
### :returns: A {Hijacked[Hijacked[BTreeDictNode[TKey, TValue]]]} pointing to the first child-pointer slot.
@readonly
secret routine BTreeDictNode[TKey, TValue].children_base() -> Hijacked[Hijacked[BTreeDictNode[TKey, TValue]]]
    return me
        .hijack()
        .recast_as[TKey]()
        .stride(count: 63)
        .recast_as[TValue]()
        .stride(count: 63)
        .recast_as[Hijacked[BTreeDictNode[TKey, TValue]]]()

### Returns the key at slot `i`.
### :param i: Zero-based entry index.
### :returns: The key at position `i`.
@readonly
secret routine BTreeDictNode[TKey, TValue].key_get(i: U64) -> TKey
    danger
        return me
            .keys_base()
            .stride(count: i.to[S64]())
            .peek()

### Returns the value at slot `i`.
### :param i: Zero-based entry index.
### :returns: The value at position `i`.
@readonly
secret routine BTreeDictNode[TKey, TValue].value_get(i: U64) -> TValue
    danger
        return me
            .values_base()
            .stride(count: i.to[S64]())
            .peek()

### Builds a `(TKey, TValue)` tuple from the entry at slot `i`, taking OWNED copies of the key and value.
### The key/value are bound to locals first so the copy pass injects a retaining `store` (a bare
### `key_get(i)` call-result argument would NOT be copied, leaving the entry aliasing the buffer's
### refcounted controller — a double-free when the entry is torn down). Mirrors Dict's emitter.
### :param i: Zero-based entry index.
### :returns: An owning `(TKey, TValue)` tuple copy of the entry at position `i`.
@readonly
secret routine BTreeDictNode[TKey, TValue].entry_get(i: U64) -> (TKey, TValue)
    var k = me.key_get(i)
    var v = me.value_get(i)
    return (steal k, steal v)

### Writes `value` to the key slot at position `i`.
### :param i: Zero-based entry index.
### :param value: The key to store.
secret routine BTreeDictNode[TKey, TValue].key_set(i: U64, value: TKey)
    danger
        me
            .keys_base()
            .stride(count: i.to[S64]())
            .poke(value: value)
    return

### Writes `value` to the value slot at position `i`.
### :param i: Zero-based entry index.
### :param value: The value to store.
secret routine BTreeDictNode[TKey, TValue].value_set(i: U64, value: TValue)
    danger
        me
            .values_base()
            .stride(count: i.to[S64]())
            .poke(value: value)
    return

### Puts `value` at slot `i` in place of the value there, which is torn down (a key written again).
### :param i: The slot.
### :param value: The value that goes in.
secret routine BTreeDictNode[TKey, TValue].value_replace(i: U64, value: TValue)
    danger
        me
            .values_base()
            .stride(count: i.to[S64]())
            .peek()
            .destruct()
    me.value_set(i: i, value: value)
    return

### Returns a non-owning pointer to the child node at slot `i`.
### The tree owns its children; this LENDS the pointer (no ownership transfer). Callers `.as_entity()`
### it to read the node. Returning a bare `?BTreeDictNode` would make `var c = node.children_get(i)` a
### second owner and double-free the tree-owned node at scope exit (containment = ownership).
### :param i: Zero-based child index.
### :returns: The `?Hijacked[BTreeDictNode[TKey, TValue]]` child-node pointer stored in slot `i`.
@readonly
dangerous routine BTreeDictNode[TKey, TValue].children_get(i: U64) -> Hijacked[BTreeDictNode[TKey, TValue]]
    return me
        .children_base()
        .stride(count: i.to[S64]())
        .peek()

### Recursively frees this node's subtree (post-order): destroys each child node, tears down each
### stored key and value, then frees this node's own allocation. Visited inline (never bound to a
### `var`) so scope-exit teardown doesn't double-free.
@override
routine BTreeDictNode[TKey, TValue].destruct()
    danger
        if not me.is_leaf
            var ci: U64 = 0
            until ci >= me.child_count
                me
                    .children_get(ci)
                    .as_entity()
                    .destruct()
                ci = ci + 1
        var ki: U64 = 0
        until ki >= me.key_count
            me.key_get(ki).destruct()
            me.value_get(ki).destruct()
            ki = ki + 1
        return

### Cycle-collector TRACE: recurse into every child node, then report each stored key AND value to the
### collector. Overrides the universal member-walk (keys/values live in fixed inline arrays the generic
### walk cannot iterate).
@override
dangerous routine BTreeDictNode[TKey, TValue].roam_trace()
    if not me.is_leaf
        var ci: U64 = 0
        until ci >= me.child_count
            me
                .children_get(ci)
                .as_entity()
                .roam_trace()
            ci = ci + 1
    var ki: U64 = 0
    until ki >= me.key_count
        me.key_get(ki).cyclic_visit()
        me.value_get(ki).cyclic_visit()
        ki = ki + 1
    return

### Cycle-collector FREE: recurse into every child node freeing the subtree, then free this node's own
### box — but NOT the stored keys/values (the collector frees the whole white cycle directly).
@override
dangerous routine BTreeDictNode[TKey, TValue].roam_free()
    if not me.is_leaf
        var ci: U64 = 0
        until ci >= me.child_count
            me
                .children_get(ci)
                .as_entity()
                .roam_free()
            ci = ci + 1
    return

### Frees the entire backing B-tree — every node, key, and value — at scope exit.
@override
routine SortedDict[TKey, TValue].destruct()
    danger
        if me.root is None
            return
        me.root!!.as_entity().destruct()
        return

### Cycle-collector TRACE: delegate to the root node's recursive trace (reports every key/value).
@override
dangerous routine SortedDict[TKey, TValue].roam_trace()
    if me.root is None
        return
    me.root!!.as_entity().roam_trace()
    return

### Cycle-collector FREE: free the whole B-tree via the root's recursive free, then free this dict's own
### box — but NOT the stored keys/values (the collector frees the whole white cycle directly).
@override
dangerous routine SortedDict[TKey, TValue].roam_free()
    if me.root is None
        return
    me.root!!.as_entity().roam_free()
    return

### Writes `value` to the child slot at position `i`.
### :param i: Zero-based child index.
### :param value: The child-node pointer to store.
secret routine BTreeDictNode[TKey, TValue].children_set(i: U64, value: Hijacked[BTreeDictNode[TKey, TValue]])
    danger
        me
            .children_base()
            .stride(count: i.to[S64]())
            .poke(value: value)
    return

### Appends a key-value pair after the last entry and increments the entry count.
### :param k: The key to append.
### :param v: The value to append.
secret routine BTreeDictNode[TKey, TValue].entries_add_last(k: TKey, v: TValue)
    danger
        me
            .keys_base()
            .stride(count: me.key_count.to[S64]())
            .poke(value: k)
        me
            .values_base()
            .stride(count: me.key_count.to[S64]())
            .poke(value: v)
    me.key_count = me.key_count +% 1
    return

### Appends `value` after the last child pointer and increments the child count.
### :param value: The child-node pointer to append.
secret routine BTreeDictNode[TKey, TValue].children_add_last(value: Hijacked[BTreeDictNode[TKey, TValue]])
    danger
        me
            .children_base()
            .stride(count: me.child_count.to[S64]())
            .poke(value: value)
    me.child_count = me.child_count +% 1
    return

### Inserts a key-value pair at position `i`, shifting later entries right by one.
### :param i: Zero-based insertion index.
### :param k: The key to insert.
### :param v: The value to insert.
secret routine BTreeDictNode[TKey, TValue].entries_add_at(i: U64, k: TKey, v: TValue)
    danger
        var kbase = me.keys_base()
        var vbase = me.values_base()
        if i < me.key_count
            var k_elem_size = TKey.data_size()
            var v_elem_size = TValue.data_size()
            var shift_count = me.key_count -% i
            var ksrc_addr = kbase.stride(count: i.to[S64]()).get_address()
            var kdst_addr = kbase.stride(count: (i +% 1).to[S64]()).get_address()
            var vsrc_addr = vbase.stride(count: i.to[S64]()).get_address()
            var vdst_addr = vbase.stride(count: (i +% 1).to[S64]()).get_address()
            rf_copy_bytes_at(dest: kdst_addr, src: ksrc_addr, size: k_elem_size * shift_count)
            rf_copy_bytes_at(dest: vdst_addr, src: vsrc_addr, size: v_elem_size * shift_count)
        kbase.stride(count: i.to[S64]()).poke(value: k)
        vbase.stride(count: i.to[S64]()).poke(value: v)
    me.key_count = me.key_count +% 1
    return

### Inserts `value` at position `i` in the children buffer, shifting later pointers right by one.
### :param i: Zero-based insertion index.
### :param value: The child-node pointer to insert.
secret routine BTreeDictNode[TKey, TValue].children_add_at(i: U64, value: Hijacked[BTreeDictNode[TKey, TValue]])
    danger
        var base = me.children_base()
        if i < me.child_count
            var elem_size = Addr.data_size()
            var shift_count = me.child_count -% i
            var src_addr = base.stride(count: i.to[S64]()).get_address()
            var dst_addr = base.stride(count: (i +% 1).to[S64]()).get_address()
            rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * shift_count)
        base.stride(count: i.to[S64]()).poke(value: value)
    me.child_count = me.child_count +% 1
    return

### Removes the entry at position `i`, shifting later entries left by one.
### :param i: Zero-based index of the entry to remove.
secret routine BTreeDictNode[TKey, TValue].entries_remove_at(i: U64)
    danger
        if i +% 1 < me.key_count
            var kbase = me.keys_base()
            var vbase = me.values_base()
            var k_elem_size = TKey.data_size()
            var v_elem_size = TValue.data_size()
            var shift_count = me.key_count -% i -% 1
            var ksrc_addr = kbase.stride(count: (i +% 1).to[S64]()).get_address()
            var kdst_addr = kbase.stride(count: i.to[S64]()).get_address()
            var vsrc_addr = vbase.stride(count: (i +% 1).to[S64]()).get_address()
            var vdst_addr = vbase.stride(count: i.to[S64]()).get_address()
            rf_copy_bytes_at(dest: kdst_addr, src: ksrc_addr, size: k_elem_size * shift_count)
            rf_copy_bytes_at(dest: vdst_addr, src: vsrc_addr, size: v_elem_size * shift_count)
    me.key_count = me.key_count -% 1
    return

### Removes the child pointer at position `i`, shifting later pointers left by one.
### :param i: Zero-based index of the child to remove.
secret routine BTreeDictNode[TKey, TValue].children_remove_at(i: U64)
    danger
        if i +% 1 < me.child_count
            var base = me.children_base()
            var elem_size = Addr.data_size()
            var shift_count = me.child_count -% i -% 1
            var src_addr = base.stride(count: (i +% 1).to[S64]()).get_address()
            var dst_addr = base.stride(count: i.to[S64]()).get_address()
            rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * shift_count)
    me.child_count = me.child_count -% 1
    return

### Decrements the entry count, logically removing the last entry without zeroing memory.
secret routine BTreeDictNode[TKey, TValue].entries_remove_last()
    me.key_count = me.key_count -% 1
    return

### Decrements the child count, logically removing the last child pointer without zeroing memory.
secret routine BTreeDictNode[TKey, TValue].children_remove_last()
    me.child_count = me.child_count -% 1
    return

### Sets the entry count to `n`, discarding all entries at or after index `n`.
### :param n: The new entry count.
secret routine BTreeDictNode[TKey, TValue].entries_truncate(n: U64)
    me.key_count = n
    return

### Sets the child count to `n`, discarding all children at or after index `n`.
### :param n: The new child count.
secret routine BTreeDictNode[TKey, TValue].children_truncate(n: U64)
    me.child_count = n
    return

### Bulk-copies `count` entries from `other` starting at `start` into this node's entry buffers.
### :param other: The source node to copy from.
### :param start: Zero-based start index in `other`.
### :param count: Number of entries to copy.
secret routine BTreeDictNode[TKey, TValue].entries_add_range_from(
    other: Viewing[BTreeDictNode[TKey, TValue]],
    start: U64,
    count: U64,
)
    if count > 0
        danger
            var k_elem_size = TKey.data_size()
            var v_elem_size = TValue.data_size()
            var ksrc_addr = other
                .keys_base()
                .stride(count: start.to[S64]())
                .get_address()
            var kdst_addr = me
                .keys_base()
                .stride(count: me.key_count.to[S64]())
                .get_address()
            var vsrc_addr = other
                .values_base()
                .stride(count: start.to[S64]())
                .get_address()
            var vdst_addr = me
                .values_base()
                .stride(count: me.key_count.to[S64]())
                .get_address()
            rf_copy_bytes_at(dest: kdst_addr, src: ksrc_addr, size: k_elem_size * count)
            rf_copy_bytes_at(dest: vdst_addr, src: vsrc_addr, size: v_elem_size * count)
    me.key_count = me.key_count +% count
    return

### Bulk-copies `count` child pointers from `other` starting at `start` into this node's children buffer.
### :param other: The source node to copy from.
### :param start: Zero-based start index in `other`.
### :param count: Number of child pointers to copy.
secret routine BTreeDictNode[TKey, TValue].children_add_range_from(
    other: Viewing[BTreeDictNode[TKey, TValue]],
    start: U64,
    count: U64,
)
    if count > 0
        danger
            var elem_size = Addr.data_size()
            var src_addr = other
                .children_base()
                .stride(count: start.to[S64]())
                .get_address()
            var dst_addr = me
                .children_base()
                .stride(count: me.child_count.to[S64]())
                .get_address()
            rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * count)
    me.child_count = me.child_count +% count
    return

# ============================================================================
# Creators
# ============================================================================

secret routine BTreeDictNode[TKey, TValue](is_leaf: Bool) -> BTreeDictNode[TKey, TValue]
    return BTreeDictNode[TKey, TValue](
        entry_keys: LLVM::zero_value[Slots[TKey, 63]](),
        entry_values: LLVM::zero_value[Slots[TValue, 63]](),
        children: LLVM::zero_value[Items[Hijacked[BTreeDictNode[TKey, TValue]], 64]](),
        key_count: 0,
        child_count: 0,
        subtree_size: 0,
        is_leaf: is_leaf,
    )

routine SortedDict[TKey, TValue]() -> SortedDict[TKey, TValue]
    return SortedDict[TKey, TValue](root: none, count: 0)

### Creates a sorted dict containing the given key-value `pairs` (stored in sorted key order). Variadic
### constructor behind the `{k: v, …}` dict-literal syntax (the `DictLiteral` opt-in).
### :param pairs: The key-value pairs as `(TKey, TValue)` values; a later duplicate key overwrites.
### :returns: A sorted dict of the given pairs.
common routine SortedDict[TKey, TValue].from_literal(pairs...: (TKey, TValue)) -> SortedDict[TKey, TValue]
needs TKey obeys Comparable
    var result = SortedDict[TKey, TValue]()
    var i: U64 = 0
    # Each pair is read in place: `add` makes the dictionary's holders, and the caller releases the
    # literal's own afterwards.
    until i >= pairs.count()
        drop result.put(key: pairs.get_raw(index: i).item0, value: pairs.get_raw(index: i).item1)
        i = i +% 1
    return result

# ============================================================================
# Core
# ============================================================================

### Returns the number of key-value pairs in this dictionary.
### :returns: The entry count.
@readonly
routine SortedDict[TKey, TValue].count() -> U64
    return me.count

### Returns true if this dictionary contains no entries.
### :returns: `true` when `count()` is zero.
@readonly
routine SortedDict[TKey, TValue].is_empty() -> Bool
    return me.count == 0

### Removes all entries, resetting the dictionary to an empty state.
@reshaping
routine SortedDict[TKey, TValue].clear()
    me.root = none
    me.count = 0
    return

# ============================================================================
# Binary search
# ============================================================================

### Binary search: returns the leftmost index where `node.keys[i] >= key`.
### :param node: The node whose keys are searched.
### :param key: The target key.
### :returns: Smallest index `i` where `node.keys[i] >= key`, or `keys_count()` if all keys are smaller.
@readonly
@inline
secret routine SortedDict[TKey, TValue].lower_bound(node: Viewing[BTreeDictNode[TKey, TValue]], key: TKey) -> U64
    var lo: U64 = 0
    var hi = node.keys_count()
    until lo >= hi
        var mid = lo +% LLVM::unsigned_div(hi -% lo, 2)
        if node.key_get(mid) < key
            lo = mid +% 1
        else
            hi = mid
    return lo

# ============================================================================
# Search
# ============================================================================

### Returns true if `key` exists in this dictionary.
### :param key: The key to look up.
### :returns: `true` if the key is present.
@readonly
routine SortedDict[TKey, TValue].has_key(key: TKey) -> Bool
    if me.root is None
        return false
    danger
        var root_ref = me.root!!.as_entity()
        return me.search_node(node: root_ref, key: key)

### Returns whether `key` has no entry (`d lack k`).
### :param key: The key to look for.
### :returns: `true` if the key is absent.
@readonly
routine SortedDict[TKey, TValue].lacks_key(key: TKey) -> Bool
    return not me.has_key(key: key)

### Descends the subtree rooted at `node` to find `key`.
### :param node: The subtree root to search.
### :param key: The key to find.
### :returns: `true` if found anywhere in the subtree.
@readonly
@inline
secret routine SortedDict[TKey, TValue].search_node(node: Viewing[BTreeDictNode[TKey, TValue]], key: TKey) -> Bool
    danger
        var i = me.lower_bound(node: node, key: key)
        if i < node.keys_count() and key == node.key_get(i)
            return true
        if node.is_leaf
            return false
        return me.search_node(node: node.children_get(i).as_entity(), key: key)

### Returns the value associated with `key`.
### :param key: The key to look up.
### :returns: The value mapped to `key`.
### :throws: `KeyNotFoundError` if `key` is not present.
@readonly
@overridable
failable routine SortedDict[TKey, TValue].getitem(key: Viewing[TKey]) -> TValue
needs RecordType TValue
    if me.root is None
        throw KeyNotFoundError(key: key.represent())
    danger
        var root_ref = me.root!!.as_entity()
        return me.get_from_node(node: root_ref, key: key).share()

### Descends `node` to retrieve the value for `key`, throwing if not found.
### :param node: The subtree root to search.
### :param key: The key to look up.
### :returns: The value mapped to `key`.
### :throws: `KeyNotFoundError` if `key` is not present.
@readonly
secret failable routine SortedDict[TKey, TValue].get_from_node(node: Viewing[BTreeDictNode[TKey, TValue]], key: TKey) -> TValue
    danger
        var i = me.lower_bound(node: node, key: key)
        if i < node.keys_count() and key == node.key_get(i)
            return node.value_get(i)
        if node.is_leaf
            throw KeyNotFoundError(key: key.represent())
        return me.get_from_node(node: node.children_get(i).as_entity(), key: key)

### Puts `value` at `key` (`d[k] = v`): replaces the value of a key that is there, and adds the key otherwise.
### :param key: The key.
### :param value: The value.
@reshaping
routine SortedDict[TKey, TValue].setitem(key: TKey, value: TValue)
    drop me.put(key: key, value: value)
    return

### Find-or-insert returning a raw handle to the VALUE slot for `key` — the ordered analog of
### {Dict[TKey, TValue].slot}, the general read-modify-write primitive. On miss inserts `seed` first, then returns
### a handle to the value cell; on hit returns the existing cell so the caller mutates it in place instead
### of a second descend-and-rewrite (`get!` then `add`). O(log n) find-or-insert.
### DANGER: the handle is invalidated by the next structural mutation — an `add`/`remove` can split or merge
### B-tree nodes and relocate the value. Read/modify it BEFORE any further `add`/`remove`/`slot`-insert.
### :param key: The key to find or insert.
### :param seed: The value stored when `key` is absent.
### :returns: A {Hijacked[TValue]} addressing the value cell for `key`.
routine SortedDict[TKey, TValue].slot(key: TKey, seed: TValue) -> Hijacked[TValue]
    if not me.has_key(key: key)
        drop me.put(key: key, value: seed)
    danger
        var root_ref = me.root!!.as_entity()
        return me.value_slot_in(node: root_ref, key: key)

### Descends `node`'s subtree to the value cell for an EXISTING `key`, returning a raw {Hijacked[TValue]} to it.
### Precondition: `key` is present (the public `slot` inserts it first) — so the exact-match branch always
### fires at or above the leaf, never descending past one. Mirrors `get_from_node` but yields the cell
### ADDRESS instead of a copy.
### :param node: The subtree root to search.
### :param key: The key whose value cell to locate.
### :returns: A {Hijacked[TValue]} addressing the value cell.
@readonly
secret routine SortedDict[TKey, TValue].value_slot_in(node: Viewing[BTreeDictNode[TKey, TValue]], key: TKey) -> Hijacked[TValue]
    danger
        var i = me.lower_bound(node: node, key: key)
        if i < node.keys_count() and key == node.key_get(i)
            return node.values_base().stride(count: i.to[S64]())
        return me.value_slot_in(node: node.children_get(i).as_entity(), key: key)

# ============================================================================
# Insert
# ============================================================================

### Inserts or updates the entry for `key`.
### If `key` already exists, its value is replaced with `value`.
### :param key: The key to insert or update.
### :param value: The value to associate with `key`.
### :returns: `true` if a new key was inserted; `false` if an existing key was updated.
@reshaping
@discardable
secret routine SortedDict[TKey, TValue].put(key: TKey, value: TValue) -> Bool
    if me.root is None
        danger
            me.root = BTreeDictNode[TKey, TValue](is_leaf: true).hijack()
            me.root!!.as_entity().entries_add_last(k: key, v: value)
            me.root!!.as_entity().subtree_size = 1
        me.count = 1
        return true

    var root_full = false
    danger
        root_full = me.root!!.as_entity().keys_count() >= B_DICT -% 1
    if root_full
        danger
            var old_root = me.root!!
            me.root = BTreeDictNode[TKey, TValue](is_leaf: false).hijack()
            var new_root = me.root!!.as_entity()
            new_root.children_add_last(value: old_root)
            me.split_child(parent_node: new_root, child_idx: 0)
            new_root.subtree_size = new_root.children_get(0).as_entity().subtree_size +% new_root
                .children_get(1)
                .as_entity()
                .subtree_size +% 1

    var inserted = false
    danger
        var root_ref = me.root!!.as_entity()
        inserted = me.insert_non_full(node: root_ref, key: key, value: value)
    if inserted
        me.count = me.count +% 1
    return inserted

### Inserts or updates `key` in `node`, which must have at least one free entry slot.
### :param node: A non-full node to insert into.
### :param key: The key to insert or update.
### :param value: The value to associate with `key`.
### :returns: `true` if a new entry was inserted; `false` if an existing key was updated.
@inline
secret routine SortedDict[TKey, TValue].insert_non_full(
    node: Modifying[BTreeDictNode[TKey, TValue]],
    key: TKey,
    value: TValue,
) -> Bool
    danger
        var i = me.lower_bound(node: node, key: key)

        if i < node.keys_count() and node.key_get(i) == key
            node.value_replace(i: i, value: value)
            return false

        if node.is_leaf
            node.entries_add_at(i: i, k: key, v: value)
            node.subtree_size = node.subtree_size +% 1
            return true
        else
            if node
                .children_get(i)
                .as_entity()
                .keys_count() >= B_DICT -% 1
                me.split_child(parent_node: node, child_idx: i)
                if key == node.key_get(i)
                    node.value_replace(i: i, value: value)
                    return false
                if key > node.key_get(i)
                    i = i +% 1

            var inserted = me.insert_non_full(
                node: node.children_get(i).as_entity(),
                key: key,
                value: value,
            )
            if inserted
                node.subtree_size = node.subtree_size +% 1
            return inserted

### Splits the full child at index `child_idx`, promoting its median entry up to `parent_node`.
### :param parent_node: The parent node that owns the full child.
### :param child_idx: Index of the full child within `parent_node`'s children buffer.
@inline
secret routine SortedDict[TKey, TValue].split_child(parent_node: Modifying[BTreeDictNode[TKey, TValue]], child_idx: U64)
    danger
        var child = parent_node.children_get(child_idx).as_entity()
        var mid = LLVM::unsigned_div(B_DICT -% 1, 2)

        var new_node_ptr = BTreeDictNode[TKey, TValue](is_leaf: child.is_leaf).hijack()
        var new_node = new_node_ptr.as_entity()
        new_node.entries_add_range_from(
            other: child,
            start: mid +% 1,
            count: child.keys_count() -% mid -% 1,
        )

        if not child.is_leaf
            new_node.children_add_range_from(
                other: child,
                start: mid +% 1,
                count: child.children_count() -% mid -% 1,
            )

        var mid_key = child.key_get(mid)
        var mid_value = child.value_get(mid)

        child.entries_truncate(mid)
        if not child.is_leaf
            child.children_truncate(mid +% 1)

        if child.is_leaf
            child.subtree_size = child.keys_count()
            new_node.subtree_size = new_node.keys_count()
        else
            var left_size = child.keys_count()
            var i: U64 = 0
            until i >= child.children_count()
                left_size = left_size +% child.children_get(i).as_entity().subtree_size
                i = i +% 1
            child.subtree_size = left_size
            var right_size = new_node.keys_count()
            i = 0
            until i >= new_node.children_count()
                right_size = right_size +% new_node.children_get(i).as_entity().subtree_size
                i = i +% 1
            new_node.subtree_size = right_size

        parent_node.entries_add_at(i: child_idx, k: mid_key, v: mid_value)
        parent_node.children_add_at(i: child_idx +% 1, value: new_node_ptr)
        return

# ============================================================================
# Remove
# ============================================================================

### Removes the entry for `key` from the dictionary.
### :param key: The key to remove.
### :returns: `true` if the key was found and removed; `false` if not present.
@reshaping
@discardable
routine SortedDict[TKey, TValue].remove(key: TKey) -> Bool
    if me.root is None
        return false

    var removed = false
    danger
        var root_ref = me.root!!.as_entity()
        removed = me.remove_from_node(node: root_ref, key: key)
    if removed
        me.count = me.count -% 1
        danger
            if me.root!!.as_entity().keys_count() == 0 and not me.root!!.as_entity().is_leaf
                me.root = me.root!!.as_entity().children_get(0)
            if me.root!!.as_entity().keys_count() == 0
                me.root = none
    return removed

### Descends `node` to delete the entry for `key`, rebalancing on the way back up.
### :param node: The subtree root to search and remove from.
### :param key: The key to remove.
### :returns: `true` if the key was found and removed.
@inline
secret routine SortedDict[TKey, TValue].remove_from_node(node: Modifying[BTreeDictNode[TKey, TValue]], key: TKey) -> Bool
    danger
        var i = me.lower_bound(node: node, key: key)

        if i < node.keys_count() and key == node.key_get(i)
            if node.is_leaf
                node.entries_remove_at(i)
                node.subtree_size = node.subtree_size -% 1
                return true
            else
                var left = node.children_get(i).as_entity()
                var right = node.children_get(i +% 1).as_entity()
                if left.keys_count() > MIN_KEYS_DICT
                    var pred = me.get_predecessor(node: node, idx: i)
                    node.key_set(i: i, value: pred.item0)
                    node.value_set(i: i, value: pred.item1)
                    drop me.remove_from_node(node: left, key: pred.item0)
                    node.subtree_size = node.subtree_size -% 1
                    return true
                elseif right.keys_count() > MIN_KEYS_DICT
                    var succ = me.get_successor(node: node, idx: i)
                    node.key_set(i: i, value: succ.item0)
                    node.value_set(i: i, value: succ.item1)
                    drop me.remove_from_node(node: right, key: succ.item0)
                    node.subtree_size = node.subtree_size -% 1
                    return true
                else
                    me.merge_children_at(node: node, i: i)
                    var removed = me.remove_from_node(
                        node: node.children_get(i).as_entity(),
                        key: key,
                    )
                    if removed
                        node.subtree_size = node.subtree_size -% 1
                    return removed
        else
            if node.is_leaf
                return false
            i = me.fix_child(node: node, i: i)
            var removed = me.remove_from_node(node: node.children_get(i).as_entity(), key: key)
            if removed
                node.subtree_size = node.subtree_size -% 1
            return removed

### Returns the largest entry in the left subtree of `node.children[idx]`.
### :param node: The parent node.
### :param idx: Index of the separator entry whose left child to descend.
### :returns: The in-order predecessor entry.
@inline
secret routine SortedDict[TKey, TValue].get_predecessor(
    node: Viewing[BTreeDictNode[TKey, TValue]],
    idx: U64,
) -> (TKey, TValue)
    danger
        var current = node.children_get(idx).as_entity()
        until current.is_leaf
            current = current.children_get(current.children_count() -% 1).as_entity()
        var last = current.keys_count() -% 1
        return current.entry_get(last)

### Returns the smallest entry in the right subtree of `node.children[idx + 1]`.
### :param node: The parent node.
### :param idx: Index of the separator entry whose right child to descend.
### :returns: The in-order successor entry.
@inline
secret routine SortedDict[TKey, TValue].get_successor(
    node: Viewing[BTreeDictNode[TKey, TValue]],
    idx: U64,
) -> (TKey, TValue)
    danger
        var current = node.children_get(idx +% 1).as_entity()
        until current.is_leaf
            current = current.children_get(0).as_entity()
        return current.entry_get(0)

### Merges `node.children[i + 1]` into `node.children[i]`, pulling down the separator entry at `node.keys[i]`.
### :param node: The parent node whose two adjacent children are merged.
### :param i: Index of the separator entry and the left child that absorbs the right.
@inline
secret routine SortedDict[TKey, TValue].merge_children_at(node: Modifying[BTreeDictNode[TKey, TValue]], i: U64)
    danger
        var left = node.children_get(i).as_entity()
        var right = node.children_get(i +% 1).as_entity()

        left.entries_add_last(k: node.key_get(i), v: node.value_get(i))
        left.entries_add_range_from(other: right, start: 0, count: right.keys_count())

        if not right.is_leaf
            left.children_add_range_from(other: right, start: 0, count: right.children_count())

        left.subtree_size = left.subtree_size +% right.subtree_size +% 1

        node.entries_remove_at(i)
        node.children_remove_at(i +% 1)
        return

### Ensures `node.children[i]` has enough keys for safe descent; rotates or merges siblings as needed.
### :param node: The parent node whose child needs fixing.
### :param i: The child index that is about to be descended into.
### :returns: The adjusted child index after any rotation or merge.
@inline
secret routine SortedDict[TKey, TValue].fix_child(node: Modifying[BTreeDictNode[TKey, TValue]], i: U64) -> U64
    danger
        if node
            .children_get(i)
            .as_entity()
            .keys_count() > MIN_KEYS_DICT
            return i
        if i > 0
            and node
                .children_get(i -% 1)
                .as_entity()
                .keys_count() > MIN_KEYS_DICT
            me.rotate_right_at(node: node, i: i)
            return i
        if i +% 1 < node.children_count()
            and node
                .children_get(i +% 1)
                .as_entity()
                .keys_count() > MIN_KEYS_DICT
            me.rotate_left_at(node: node, i: i)
            return i
        if i > 0
            me.merge_children_at(node: node, i: i -% 1)
            return i -% 1
        me.merge_children_at(node: node, i: i)
        return i

### Borrows the last entry from the left sibling of `node.children[i]` through the parent separator.
### :param node: The parent node.
### :param i: Index of the child that receives the borrowed entry.
@inline
secret routine SortedDict[TKey, TValue].rotate_right_at(node: Modifying[BTreeDictNode[TKey, TValue]], i: U64)
    danger
        var left = node.children_get(i -% 1).as_entity()
        var child = node.children_get(i).as_entity()

        child.entries_add_at(i: 0, k: node.key_get(i -% 1), v: node.value_get(i -% 1))

        if not child.is_leaf
            child.children_add_at(
                i: 0,
                value: left
                    .children_get(left.children_count() -% 1)
                    .as_entity()
                    .hijack(),
            )
            left.children_remove_last()

        var last = left.keys_count() -% 1
        node.key_set(i: i -% 1, value: left.key_get(last))
        node.value_set(i: i -% 1, value: left.value_get(last))
        left.entries_remove_last()

        me.update_subtree_size(left)
        me.update_subtree_size(child)
        return

### Borrows the first entry from the right sibling of `node.children[i]` through the parent separator.
### :param node: The parent node.
### :param i: Index of the child that receives the borrowed entry.
@inline
secret routine SortedDict[TKey, TValue].rotate_left_at(node: Modifying[BTreeDictNode[TKey, TValue]], i: U64)
    danger
        var right = node.children_get(i +% 1).as_entity()
        var child = node.children_get(i).as_entity()

        child.entries_add_last(k: node.key_get(i), v: node.value_get(i))

        if not child.is_leaf
            child.children_add_last(
                right
                    .children_get(0)
                    .as_entity()
                    .hijack(),
            )
            right.children_remove_at(0)

        node.key_set(i: i, value: right.key_get(0))
        node.value_set(i: i, value: right.value_get(0))
        right.entries_remove_at(0)

        me.update_subtree_size(right)
        me.update_subtree_size(child)
        return

### Recomputes `node.subtree_size` from its entries and children.
### :param node: The node whose subtree size is to be refreshed.
@inline
secret routine SortedDict[TKey, TValue].update_subtree_size(node: Modifying[BTreeDictNode[TKey, TValue]])
    danger
        if node.is_leaf
            node.subtree_size = node.keys_count()
        else
            var size = node.keys_count()
            var i: U64 = 0
            until i >= node.children_count()
                size = size +% node.children_get(i).as_entity().subtree_size
                i = i +% 1
            node.subtree_size = size
        return

# ============================================================================
# Get helpers
# ============================================================================

### Returns the entry at the given zero-based sorted rank.
### Rank 0 is the entry with the smallest key; rank `count()-1` is the largest.
### :param i: The zero-based sorted rank to read.
### :returns: The `(TKey, TValue)` tuple at that sorted position.
### :throws: {IndexOutOfBoundsError} if `i >= count()`.
@readonly
failable routine SortedDict[TKey, TValue].get_by_rank(i: U64) -> (TKey, TValue)
    if i >= me.count
        throw IndexOutOfBoundsError(index: i, count: me.count)
    danger
        var root_ref = me.root!!.as_entity()
        return me.get_by_rank_node(node: root_ref, rank: i)

### Returns the entry at zero-based sorted rank `rank` within `node`'s subtree.
### :param node: The subtree root to search.
### :param rank: Zero-based position in the in-order traversal of this subtree.
### :returns: The `(TKey, TValue)` tuple at that rank.
@readonly
secret routine SortedDict[TKey, TValue].get_by_rank_node(
    node: Viewing[BTreeDictNode[TKey, TValue]],
    rank: U64,
) -> (TKey, TValue)
    danger
        if node.is_leaf
            return node.entry_get(rank)

        var remaining = rank
        var i: U64 = 0
        until i >= node.children_count()
            var child_size = node.children_get(i).as_entity().subtree_size
            if remaining < child_size
                return me.get_by_rank_node(node: node.children_get(i).as_entity(), rank: remaining)
            remaining = remaining -% child_size
            if i < node.keys_count()
                if remaining == 0
                    return node.entry_get(i)
                remaining = remaining -% 1
            i = i +% 1
        return node.entry_get(0)

### Returns the value for `key`, or `default` if the key is not present.
### :param key: The key to look up.
### :param default: The fallback value returned when `key` is absent.
### :returns: The mapped value if found, otherwise `default`.
@readonly
routine SortedDict[TKey, TValue].get_or(key: TKey, default: TValue) -> TValue
    if me.root is None
        return default
    danger
        var root_ref = me.root!!.as_entity()
        return me.get_or_from_node(node: root_ref, key: key, default: default)

### Descends `node` to retrieve the value for `key`, returning `default` if not found.
### :param node: The subtree root to search.
### :param key: The key to look up.
### :param default: The fallback value returned when `key` is absent.
### :returns: The mapped value if found, otherwise `default`.
@readonly
secret routine SortedDict[TKey, TValue].get_or_from_node(
    node: Viewing[BTreeDictNode[TKey, TValue]],
    key: TKey,
    default: TValue,
) -> TValue
    danger
        var i = me.lower_bound(node: node, key: key)
        if i < node.keys_count() and key == node.key_get(i)
            return node.value_get(i)
        if node.is_leaf
            return default
        return me.get_or_from_node(
            node: node.children_get(i).as_entity(),
            key: key,
            default: default,
        )

# ============================================================================
# Min/Max
# ============================================================================

### Returns the entry with the smallest key.
### :returns: A `(TKey, TValue)` tuple with the minimum key and its associated value.
### :throws: {AbsentValueError} The dictionary is empty.
@readonly
failable routine SortedDict[TKey, TValue].min() -> (TKey, TValue)
    if me.is_empty()
        throw AbsentValueError()
    danger
        var node = me.root!!.as_entity()
        until node.is_leaf
            node = node.children_get(0).as_entity()
        return node.entry_get(0)

### Returns the entry with the largest key.
### :returns: A `(TKey, TValue)` tuple with the maximum key and its associated value.
### :throws: {AbsentValueError} The dictionary is empty.
@readonly
failable routine SortedDict[TKey, TValue].max() -> (TKey, TValue)
    if me.is_empty()
        throw AbsentValueError()
    danger
        var node = me.root!!.as_entity()
        until node.is_leaf
            node = node.children_get(node.children_count() -% 1).as_entity()
        var last = node.keys_count() -% 1
        return node.entry_get(last)

### Returns the entry with the smallest key. Alias for {SortedDict[TKey, TValue].min()}.
### :returns: The first (minimum-key) entry.
### :throws: {AbsentValueError} The dictionary is empty.
@readonly
failable routine SortedDict[TKey, TValue].first() -> (TKey, TValue)
    return me.min()

### Returns the entry with the largest key. Alias for {SortedDict[TKey, TValue].max()}.
### :returns: The last (maximum-key) entry.
### :throws: {AbsentValueError} The dictionary is empty.
@readonly
failable routine SortedDict[TKey, TValue].last() -> (TKey, TValue)
    return me.max()

# ============================================================================
# Keys / Values
# ============================================================================

### Returns all keys in ascending order.
### :returns: A {List[TKey]} of every key, sorted from smallest to largest.
@readonly
routine SortedDict[TKey, TValue].keys() -> List[TKey]
    var result = List[TKey](me.count)
    if me.root is None
        nothing
    else
        danger
            var root_ref = me.root!!.as_entity()
            me.collect_keys(node: root_ref, result: result)
    return result

### Appends all keys from `node`'s subtree into `result` via in-order traversal.
### :param node: The subtree root to traverse.
### :param result: The list to append keys into.
@readonly
secret routine SortedDict[TKey, TValue].collect_keys(
    node: Viewing[BTreeDictNode[TKey, TValue]],
    result: Modifying[List[TKey]],
)
    danger
        var i: U64 = 0
        until i >= node.keys_count()
            if not node.is_leaf
                me.collect_keys(node: node.children_get(i).as_entity(), result: result)
            result.add_last(node.key_get(i))
            i = i +% 1
        if not node.is_leaf
            me.collect_keys(
                node: node.children_get(node.children_count() -% 1).as_entity(),
                result: result,
            )
        return

### Returns all values in key-ascending order.
### :returns: A {List[TValue]} of every value, ordered by their corresponding keys.
@readonly
routine SortedDict[TKey, TValue].values() -> List[TValue]
    var result = List[TValue](me.count)
    if me.root is None
        nothing
    else
        danger
            var root_ref = me.root!!.as_entity()
            me.collect_values(node: root_ref, result: result)
    return result

### Appends all values from `node`'s subtree into `result` via in-order traversal.
### :param node: The subtree root to traverse.
### :param result: The list to append values into.
@readonly
secret routine SortedDict[TKey, TValue].collect_values(
    node: Viewing[BTreeDictNode[TKey, TValue]],
    result: Modifying[List[TValue]],
)
    danger
        var i: U64 = 0
        until i >= node.keys_count()
            if not node.is_leaf
                me.collect_values(node: node.children_get(i).as_entity(), result: result)
            result.add_last(node.value_get(i))
            i = i +% 1
        if not node.is_leaf
            me.collect_values(
                node: node.children_get(node.children_count() -% 1).as_entity(),
                result: result,
            )
        return

# ============================================================================
# Rank-based access
# ============================================================================

### Returns the entry at zero-based sorted rank `rank` within `node`'s subtree.
### :param node: The subtree root to search.
### :param rank: Zero-based position in the in-order traversal of this subtree.
### :returns: The entry at that rank.
@readonly
secret routine SortedDict[TKey, TValue].get_by_rank(
    node: Viewing[BTreeDictNode[TKey, TValue]],
    rank: U64,
) -> (TKey, TValue)
    danger
        if node.is_leaf
            return node.entry_get(rank)

        var remaining = rank
        var i: U64 = 0
        until i >= node.children_count()
            var child_size = node.children_get(i).as_entity().subtree_size
            if remaining < child_size
                return me.get_by_rank(node: node.children_get(i).as_entity(), rank: remaining)
            remaining = remaining -% child_size
            if i < node.keys_count()
                if remaining == 0
                    return node.entry_get(i)
                remaining = remaining -% 1
            i = i +% 1
        return node.entry_get(0)

# ============================================================================
# Iteration
# ============================================================================

@readonly
routine SortedDict[TKey, TValue].emitter() -> SortedDictEmitter[TKey, TValue]
    danger
        return SortedDictEmitter[TKey, TValue](dict: me.hijack(), index: 0)

### Creates a `List[(TKey, TValue)]` from all entries of `from` in ascending key order.
### :returns: A new list of all entries in key-ascending order.
routine SortedDict[TKey, TValue].to[List[(TKey, TValue)]]() -> List[(TKey, TValue)]
    var result = List[(TKey, TValue)](me.count)
    if me.root is None
        nothing
    else
        danger
            var root_ref = me.root!!.as_entity()
            me.collect_inorder(node: root_ref, result: result)
    return result

### Appends all entries from `node`'s subtree into `result` via in-order traversal.
### :param node: The subtree root to traverse.
### :param result: The list to append entries into.
@readonly
secret routine SortedDict[TKey, TValue].collect_inorder(
    node: Viewing[BTreeDictNode[TKey, TValue]],
    result: Modifying[List[(TKey, TValue)]],
)
    danger
        var i: U64 = 0
        until i >= node.keys_count()
            if not node.is_leaf
                me.collect_inorder(node: node.children_get(i).as_entity(), result: result)
            result.add_last(node.entry_get(i))
            i = i +% 1
        if not node.is_leaf
            me.collect_inorder(
                node: node.children_get(node.children_count() -% 1).as_entity(),
                result: result,
            )
        return

failable routine SortedDictEmitter[TKey, TValue].emit() -> (TKey, TValue)
    danger
        if me.index >= me.dict.as_entity().count()
            throw AbsentValueError()
        var root_ref = me.dict.as_entity().root!!.as_entity()
        var entry = me.dict.as_entity().get_by_rank(node: root_ref, rank: me.index)
        me.index = me.index + 1
        return entry

# ============================================================================
# Display
# ============================================================================

@readonly
@override
routine SortedDict[TKey, TValue].represent() -> Text
    if me.is_empty()
        return "{:}"
    var result = "{"
    var i: U64 = 0
    for entry in me
        if i > 0
            result = result + ", "
        result = result + nested_repr(entry.item0) + ": " + nested_repr(entry.item1)
        i = i +% 1
    result = result + "}"
    return result

@readonly
@override
routine SortedDict[TKey, TValue].diagnose() -> Text
    if me.is_empty()
        return me.full_type_name() + "(count: 0, {:})"
    var result = me.full_type_name() + "(count: " + me.count().represent() + ", {"
    var i: U64 = 0
    for entry in me
        if i > 0
            result = result + ", "
        result = result + nested_diagnose(entry.item0) + ": " + nested_diagnose(entry.item1)
        i = i +% 1
    result = result + "})"
    return result

### Serializes this dictionary to a `SerialValue.Dict`; keys render via `represent`, values serialize.
### :returns: The `SerialValue.Dict` mapping each key's text to its value's serialized form.
@readonly
@override
routine SortedDict[TKey, TValue].serialize() -> SerialValue
    var __sv = Dict[Text, SerialValue]()
    for __e in me
        __sv[__e.item0.represent()] = __e.item1.serialize()
    return SerialValue(__sv)

### Builds the dictionary from its serialized entry table, the reverse of `serialize`.
### :param value: The serialized entry table.
### :returns: The rebuilt dictionary.
### :throws: {SerialShapeError} when the value is not a table or an entry does not fit, or a parse error when a key
### does not read as a `TKey`.
failable common routine SortedDict[TKey, TValue].from_serial(value: SerialValue) -> SortedDict[TKey, TValue]
    var result = SortedDict[TKey, TValue]()
    when value
        is Dict[Text, SerialValue] as entries =>
            for entry in entries
                result[serial_key[TKey](key: entry.item0)] = serial_decode[TValue](value: entry.item1)
        else =>
            throw SerialShapeError(detail: "expected an entry table")
    return result

### Collects `(key, value)` pairs into a `SortedDict`: a later pair whose key is there already replaces its value.
### :returns: The sorted dict.
@readonly
routine Emittable[Tuple[TKey, TValue]].to[SortedDict[TKey, TValue]]() -> SortedDict[TKey, TValue]
needs TKey obeys Comparable
needs RecordType TKey, RecordType TValue
    var result = SortedDict[TKey, TValue]()
    for item in me
        var pair: Tuple[TKey, TValue] = item
        result[pair.item0] = pair.item1
    return result
