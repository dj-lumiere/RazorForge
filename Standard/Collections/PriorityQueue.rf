module Collections

import BuilderQuery
### A min-heap priority pool that always removes the entry with the smallest priority first.
###
### `PriorityQueue[TPriority, TElement]` stores elements alongside their priorities in two
### parallel heap arrays. The heap property guarantees that the minimum-priority entry
### is always at the front. When two entries have equal priority, no order guarantee
### is made between them.
###
### A queue is not walked directly: pick the order. `unordered()` copies the `(priority, element)` pairs in storage
### order, `ordered()` copies them smallest priority first and leaves the queue as it is, and `drain()` empties the
### queue into them smallest priority first.
###
### **When to use**
### - You need to process items by priority (e.g., Dijkstra's algorithm, task scheduling).
### - You need O(log n) insertion and O(log n) minimum removal.
### - Use {SortedList[T]} instead when you need sorted traversal without removing elements.
### - Use {CircularList[T]} instead when order does not depend on priority — arrival order, both ends, or rotation.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add` | O(log n) |
### | `remove!` | O(log n) |
### | `peek!` / `peek_priority!` / `peek_entry!` | O(1) |
### | `add_all` | O(k log n) |
### | `unordered` | O(n) |
### | `ordered` / `drain` | O(n log n) |
### | `contains` | O(n) |
###
### :typeparam TPriority: The comparable type used for heap ordering. Smaller values rank higher.
### :typeparam TElement: The value type stored alongside each priority.
### :see: {SortedList[T]} for sorted traversal without removing elements.
### :see: {CircularList[T]} for both-ended, rotatable sequencing without priority.
entity PriorityQueue[TPriority, TElement]
obeys DictLiteral[TPriority, TElement]
needs TPriority obeys Comparable
    secret priorities: Hijacked[TPriority]
    secret elements: Hijacked[TElement]
    secret count: U64
    secret capacity: U64

# ============================================================================
# Creators
# ============================================================================

### Creates an empty priority pool with no allocated backing storage.
### Storage is acquired lazily on the first insertion or explicit `reserve`.
### Creates a priority pool containing the given `pairs`, each a `{priority: element}` mapping. Variadic
### constructor behind the `{p: e, …}` dict-literal syntax (the `DictLiteral` opt-in): the key of every
### `DictEntry` is the priority, the value is the element.
### :param pairs: The priority-element pairs as `DictEntry[TPriority, TElement]` values.
### :returns: A priority pool of the given pairs.
common routine PriorityQueue[TPriority, TElement].from_literal(pairs...: DictEntry[TPriority, TElement]) -> PriorityQueue[TPriority, TElement]
needs TPriority obeys Comparable
    var result = PriorityQueue[TPriority, TElement]()
    var i: U64 = 0
    while i < pairs.count()
        result.add(element: pairs.get_raw(index: i).value, priority: pairs.get_raw(index: i).key)
        i = i +% 1
    return result

routine PriorityQueue[TPriority, TElement]() -> PriorityQueue[TPriority, TElement]
    return PriorityQueue[TPriority, TElement](
        priorities: hijacked_none[TPriority](),
        elements: hijacked_none[TElement](),
        count: 0,
        capacity: 0,
    )

### Creates an empty priority pool with storage pre-allocated for `capacity` entries.
### Use this when the expected pool size is known and early reallocations should be avoided.
### :param capacity: The number of entries to reserve space for.
routine PriorityQueue[TPriority, TElement](capacity: U64) -> PriorityQueue[TPriority, TElement]
    var priority_byte_size = TPriority.data_size() * capacity
    var element_byte_size = TElement.data_size() * capacity
    danger
        var priority_ptr = rf_allocate_dynamic_uninit(priority_byte_size)
        var element_ptr = rf_allocate_dynamic_uninit(element_byte_size)
        return PriorityQueue[TPriority, TElement](
            priorities: Hijacked[TPriority](priority_ptr),
            elements: Hijacked[TElement](element_ptr),
            count: 0,
            capacity: capacity,
        )

# ============================================================================
# Internal Helpers
# ============================================================================

### Returns the priority at `index` without bounds checking.
### :param index: The zero-based heap position to read.
### :returns: The priority stored at that heap node.
@readonly
@inline
routine PriorityQueue[TPriority, TElement].get_priority_raw(index: U64) -> TPriority
    danger
        return me.priorities.offset(TPriority.data_size() * index).peek()

### Writes `value` into the priority buffer at `index` without bounds checking.
### :param index: The zero-based heap position to update.
### :param value: The priority value to store.
@inline
routine PriorityQueue[TPriority, TElement].set_priority_raw(index: U64, value: TPriority)
    danger
        me.priorities.offset(TPriority.data_size() * index).poke(value)
    return

### Returns the element at `index` without bounds checking.
### Paired with `get_priority_raw` when swapping heap nodes during sift operations.
### :param index: The zero-based heap position to read.
### :returns: The element stored at that heap node.
@readonly
@inline
routine PriorityQueue[TPriority, TElement].get_element_raw(index: U64) -> TElement
    danger
        return me.elements.offset(TElement.data_size() * index).peek()

### Writes `value` into the element buffer at `index` without bounds checking.
### :param index: The zero-based heap position to update.
### :param value: The element value to store.
@inline
routine PriorityQueue[TPriority, TElement].set_element_raw(index: U64, value: TElement)
    danger
        me.elements.offset(TElement.data_size() * index).poke(value)
    return

### Ensures the pool can hold at least `new_capacity` entries without growing again.
### Both the priority and element buffers are grown together. Requests no larger than
### the current capacity are ignored.
### :param new_capacity: The minimum entry count to guarantee.
@reshaping
routine PriorityQueue[TPriority, TElement].reserve(new_capacity: U64)
    if new_capacity > me.capacity
        var priority_byte_size = TPriority.data_size() * new_capacity
        var element_byte_size = TElement.data_size() * new_capacity

        danger
            if me.priorities.is_none()
                var ptr = rf_allocate_dynamic_uninit(priority_byte_size)
                me.priorities = Hijacked[TPriority](ptr)
            else
                var ptr = rf_reallocate_dynamic(
                    ptr: LLVM::pointer_to_int[TPriority, Address](me.priorities),
                    size: priority_byte_size,
                )
                me.priorities = Hijacked[TPriority](ptr)

            if me.elements.is_none()
                var ptr = rf_allocate_dynamic_uninit(element_byte_size)
                me.elements = Hijacked[TElement](ptr)
            else
                var ptr = rf_reallocate_dynamic(
                    ptr: LLVM::pointer_to_int[TElement, Address](me.elements),
                    size: element_byte_size,
                )
                me.elements = Hijacked[TElement](ptr)

        me.capacity = new_capacity
    return

### Grows the backing storage using the shared `next_grow_capacity` policy: empty pools
### start at four slots; small pools double; large pools grow by 1.5x to bound memory waste.
### Both the priority and element buffers grow together via `reserve`.
routine PriorityQueue[TPriority, TElement].grow()
    # Size the growth off the priority buffer's element size; the element buffer grows in lockstep.
    me.reserve(
        next_grow_capacity(
            current: me.capacity,
            min_needed: me.capacity +% 1,
            element_size: TPriority.data_size().byte_size(),
        ),
    )
    return

# ============================================================================
# Internal Heap Operations
# ============================================================================

### Returns the heap index of the parent of node `index`.
### :param index: The child index whose parent to find.
### :returns: The index of the parent node.
routine PriorityQueue[TPriority, TElement].parent_index(index: U64) -> U64
    return LLVM::unsigned_div(index -% 1, 2)

### Returns the heap index of the left child of node `index`.
### :param index: The parent index to expand.
### :returns: The index of the left child node.
routine PriorityQueue[TPriority, TElement].left_child(index: U64) -> U64
    return 2 *% index +% 1

### Returns the heap index of the right child of node `index`.
### :param index: The parent index to expand.
### :returns: The index of the right child node.
routine PriorityQueue[TPriority, TElement].right_child(index: U64) -> U64
    return 2 *% index +% 2

### Restores the min-heap property by bubbling the entry at `index` toward the root.
### Called after appending a new entry at the end of the heap array. Stops as soon as
### the entry's priority is no smaller than its parent's.
### :param index: The heap position of the newly inserted entry.
routine PriorityQueue[TPriority, TElement].sift_up(index: U64)
    var hole_idx = index
    var hole_priority = me.get_priority_raw(index)
    var hole_element = me.get_element_raw(index)
    while hole_idx > 0
        var p = me.parent_index(hole_idx)
        var parent_priority = me.get_priority_raw(p)
        if hole_priority < parent_priority
            me.set_priority_raw(index: hole_idx, value: parent_priority)
            me.set_element_raw(index: hole_idx, value: me.get_element_raw(p))
            hole_idx = p
        else
            break
    me.set_priority_raw(index: hole_idx, value: hole_priority)
    me.set_element_raw(index: hole_idx, value: hole_element)
    return

### Restores the min-heap property by pushing the entry at `index` toward the leaves.
### Called after moving the last heap entry to the root following a removal. At each step,
### the entry swaps with its smaller child until the heap property is restored.
### :param index: The heap position that may violate the min-heap ordering.
routine PriorityQueue[TPriority, TElement].sift_down(index: U64)
    var size = me.count
    var hole_idx = index
    var hole_priority = me.get_priority_raw(index)
    var hole_element = me.get_element_raw(index)

    loop
        var left = me.left_child(hole_idx)
        if left >= size
            break

        var right = me.right_child(hole_idx)
        var child = left
        var child_priority = me.get_priority_raw(left)
        if right < size and me.get_priority_raw(right) < child_priority
            child = right
            child_priority = me.get_priority_raw(right)

        if hole_priority <= child_priority
            break

        me.set_priority_raw(index: hole_idx, value: child_priority)
        me.set_element_raw(index: hole_idx, value: me.get_element_raw(child))
        hole_idx = child

    me.set_priority_raw(index: hole_idx, value: hole_priority)
    me.set_element_raw(index: hole_idx, value: hole_element)
    return

# ============================================================================
# Core Operations
# ============================================================================

### Returns the number of entries currently stored in the pool.
### :returns: The live entry count.
@readonly
routine PriorityQueue[TPriority, TElement].count() -> U64
    return me.count

### Returns true if the pool currently holds no entries.
### :returns: `true` when `count()` is zero.
routine PriorityQueue[TPriority, TElement].is_empty() -> Bool
    return me.count == 0

### Removes every entry while preserving the current heap allocation.
### Use this when the pool will be reused and releasing capacity would be wasteful.
@reshaping
routine PriorityQueue[TPriority, TElement].clear()
    me.count = 0
    return

### Inserts `element` with the given `priority`.
### Smaller priority values rank higher — the entry with the smallest priority is removed first.
### :param element: The value to add.
### :param priority: The priority that determines removal order.
@reshaping
routine PriorityQueue[TPriority, TElement].add(element: TElement, priority: TPriority)
    if me.count >= me.capacity
        me.grow()

    var insert_idx = me.count
    me.set_priority_raw(index: insert_idx, value: priority)
    me.set_element_raw(index: insert_idx, value: element)
    me.count = insert_idx +% 1
    me.sift_up(insert_idx)
    return

### Removes and returns the element with the smallest priority.
### The last heap entry is moved to the root and sifted down to restore heap order.
### :returns: The element associated with the minimum priority.
### :throws: {AbsentValueError} The pool is empty.
@reshaping
failable routine PriorityQueue[TPriority, TElement].remove() -> TElement
    if me.is_empty()
        throw AbsentValueError()

    var result = me.get_element_raw(0)
    var last_idx = me.count - 1
    if last_idx > 0
        me.set_priority_raw(index: 0, value: me.get_priority_raw(last_idx))
        me.set_element_raw(index: 0, value: me.get_element_raw(last_idx))
    me.count = last_idx

    if not me.is_empty()
        me.sift_down(0)

    return result

### Returns the element at the front of the pool without removing it.
### :returns: The element with the smallest priority.
### :throws: {AbsentValueError} The pool is empty.
failable routine PriorityQueue[TPriority, TElement].peek() -> TElement
    if me.is_empty()
        throw AbsentValueError()
    return me.get_element_raw(0)

### Returns the smallest priority currently in the pool without removing its entry.
### :returns: The minimum priority value.
### :throws: {AbsentValueError} The pool is empty.
failable routine PriorityQueue[TPriority, TElement].peek_priority() -> TPriority
    if me.is_empty()
        throw AbsentValueError()
    return me.get_priority_raw(0)

### Returns the front `(priority, element)` pair without removing it.
### :returns: The pair with the smallest priority.
### :throws: {AbsentValueError} The pool is empty.
failable routine PriorityQueue[TPriority, TElement].peek_entry() -> (TPriority, TElement)
needs RecordType TElement
    if me.is_empty()
        throw AbsentValueError()
    return (me.get_priority_raw(0), me.get_element_raw(0))

# ============================================================================
# Bulk Operations
# ============================================================================

### Inserts elements from `elements` paired with priorities from `priorities`.
### Only pairs up to the length of the shorter list are inserted; any extra values are ignored.
### :param elements: The elements to add.
### :param priorities: The priorities to assign at matching positions.
@reshaping
routine PriorityQueue[TPriority, TElement].add_all(
    elements: Viewing[List[TElement]],
    priorities: Viewing[List[TPriority]],
)
needs RecordType TElement
needs RecordType TPriority
    var i: U64 = 0
    var limit = if elements.count() < priorities.count() then elements.count() else priorities.count()
    while i < limit
        # `elements[i]` is a holder of its own (the read makes it), which `add` copies into the queue.
        me.add(element: elements[i], priority: priorities[i])
        i = i +% 1
    return

### Empties the queue into its `(priority, element)` pairs, smallest priority first: the order repeated `remove()`
### calls give (`each (priority, element) in pq.drain()`).
### :returns: The pairs, in removal order.
@reshaping
routine PriorityQueue[TPriority, TElement].drain() -> List[(TPriority, TElement)]
    var result = List[Tuple[TPriority, TElement]](capacity: me.count())
    while not me.is_empty()
        var priority = me.get_priority_raw(0)
        var element = me.remove()
        result.add_last(value: (steal priority, steal element))
    return result

### Copies the `(priority, element)` pairs smallest priority first, leaving the queue as it is
### (`each (priority, element) in pq.ordered()`).
### :returns: The pairs, in removal order.
routine PriorityQueue[TPriority, TElement].ordered() -> List[(TPriority, TElement)]
needs RecordType TElement
    var copy = PriorityQueue[TPriority, TElement](capacity: me.count())
    var i: U64 = 0
    while i < me.count()
        copy.add(element: me.get_element_raw(i), priority: me.get_priority_raw(i))
        i = i +% 1
    return copy.drain()

### Copies the `(priority, element)` pairs in storage order, which is NOT priority order: the cheap walk for when the
### order does not matter (`each (priority, element) in pq.unordered()`).
### :returns: The pairs, in heap storage order.
routine PriorityQueue[TPriority, TElement].unordered() -> List[(TPriority, TElement)]
needs RecordType TElement
    var result = List[Tuple[TPriority, TElement]](capacity: me.count())
    var i: U64 = 0
    while i < me.count()
        result.add_last(value: (me.get_priority_raw(i), me.get_element_raw(i)))
        i = i +% 1
    return result

# ============================================================================
# Utility Operations
# ============================================================================

### Returns true if any stored entry carries `element`.
### Performs a linear scan of the heap array in storage order (not priority order).
### :param element: The element value to search for.
### :returns: `true` if `element` is found in any heap entry; `false` otherwise.
@readonly
routine PriorityQueue[TPriority, TElement].has(element: TElement) -> Bool
needs TElement obeys Equatable
    var i: U64 = 0
    while i < me.count
        if me.get_element_raw(i) == element
            return true
        i = i +% 1
    return false

### Returns whether `element` is not in this value: the opposite of `has`.
### :param element: The value to look for.
### :returns: `true` when `element` is absent.
@readonly
routine PriorityQueue[TPriority, TElement].lacks(element: TElement) -> Bool
needs TElement obeys Equatable
    return not me.has(element)

@readonly
@override
routine PriorityQueue[TPriority, TElement].represent() -> Text
    return f"{me.type_name()}([{me.pairs_text()}])"

@readonly
@override
routine PriorityQueue[TPriority, TElement].diagnose() -> Text
    return f"{me.full_type_name()}(count: {me.count()}, [{me.pairs_text()}])"

### The stored pairs as `priority: element` text in storage order, read in place.
@readonly
secret routine PriorityQueue[TPriority, TElement].pairs_text() -> Text
    var result = ""
    var i: U64 = 0
    while i < me.count
        if i > 0
            result = f"{result}, "
        result = f"{result}{nested_repr(me.get_priority_raw(i))}: {nested_repr(me.get_element_raw(i))}"
        i = i +% 1
    return result

@override
routine PriorityQueue[TPriority, TElement].destruct()
    danger
        # Tear down each stored priority and element before freeing the buffers. No-op for value
        # types; frees owned entity priorities/elements.
        var i: U64 = 0
        while i < me.count
            me.priorities
                .offset(TPriority.data_size() * i)
                .peek()
                .destruct()
            me.elements
                .offset(TElement.data_size() * i)
                .peek()
                .destruct()
            i = i + 1
        me.priorities.invalidate()
        me.elements.invalidate()
        return

### Cycle-collector TRACE: report every live priority and element to the collector via the two dense
### backing buffers (`0..count`). A `Roamed` priority/element reports its controller; a value one is a
### no-op. Overrides the universal member-walk (raw buffers cannot self-trace).
@override
dangerous routine PriorityQueue[TPriority, TElement].roam_trace()
    me.priorities.cyclic_trace_buffer(count: me.count)
    me.elements.cyclic_trace_buffer(count: me.count)
    return

### Cycle-collector FREE: free both backing buffers and this queue's own box, but NOT the stored
### priorities/elements (the collector frees the whole white cycle directly).
@override
dangerous routine PriorityQueue[TPriority, TElement].roam_free()
    me.priorities.invalidate()
    me.elements.invalidate()
    return
