module Collections

import BuilderExpansion
import BuilderQuery
### A fixed-size, struct-of-arrays (SoA) array of `COUNT` records with value semantics.
###
### `SplitArray[T, COUNT]` is the SoA counterpart of {Items[T, COUNT]}: instead of storing `COUNT` whole `T`
### values inline (array-of-structs), it stores each FIELD of the element record `T` in its own
### inline `Array[fieldType, COUNT]` column. Indexing copies a whole `T` out — gathering one value from
### each column — so the surface matches `Array[T, COUNT]`'s value-out `getitem`; the payoff is
### cache-friendly per-field scans and per-field bulk work.
###
### Like `Array`, it makes no separate allocation for its slots: every column is packed directly into
### the record's own footprint, copying the `SplitArray` copies all `COUNT` elements, and the size can never
### change after construction. The element type must be `Splittable` (trivially destructible — its footprint
### reduces to `@llvm` primitives with no custom store/destroy), so each column is a flat blittable
### `Array`.
###
### Storage is realized by a decl-position `expand m in allmemvarof(T)`: one `Array[$typeof(m), COUNT]`
### column per field of `T`, materialized per concrete instantiation.
###
### **When to use**
### - The element count is a buildtime constant AND you scan/update fields in bulk (SoA wins on cache).
### - Use {Items[T, COUNT]} for the array-of-structs layout (whole-element locality).
### - Use {SplitList[T]} when the count is only known at runtime.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `getitem!` / `setitem!` | O(fields) |
### | `contains` / `index_of!` | O(N) |
### | Iteration | O(N) |
###
### :typeparam T: The record element type (must be `Splittable`).
### :typeparam COUNT: The buildtime element count, supplied as a `U64` literal.
### :see: {Items[T, COUNT]} for the array-of-structs counterpart.
### :see: {SplitList[T]} for the growable, heap-backed SoA sequence.
record SplitItems[T, COUNT]
relates SplitItemsEmitter[T, COUNT] as Emitter
obeys Comparable, Emittable[T], ModifyingIndexable[T], Sized, Container
needs U64 COUNT
needs RecordType T
needs T obeys Splittable
    expand m in allmemvarof(T)
        ### One inline column holding this field across every element.
        secret $nameof(m): Items[$typeof(m), COUNT]

# ============================================================================
# Iteration Support
# ============================================================================

### Walks the elements of a fixed-size `SplitArray[T, COUNT]` from index 0 to N - 1, reconstructing each
### `T` from the columns in order. Because `SplitArray` is a record type, the emitter holds its own
### copy of the column data.
### :typeparam T: The element type yielded by the emitter.
### :typeparam COUNT: The buildtime element count.
entity SplitItemsEmitter[T, COUNT]
obeys Emitter[T]
needs RecordType T
needs U64 COUNT
needs T obeys Splittable
    ### Stores the split array being iterated.
    source: SplitItems[T, COUNT]
    ### Stores the next logical index to read.
    index: U64

# ============================================================================
# Indexing
# ============================================================================

### Returns the element at `index`, gathering one value from each column. Enables `array[i]`.
### :param index: The zero-based position to read.
### :returns: The reconstructed element.
### :throws: {IndexOutOfBoundsError} if `index >= COUNT`.
@readonly
failable routine SplitItems[T, COUNT].getitem(index: U64) -> T
    if index >= COUNT
        throw IndexOutOfBoundsError(index: index, count: COUNT)
    var result = T.blank()
    expand m in allmemvarof(T)
        danger
            result.$nameof(m) = me.$nameof(m)[index]
    return result

### Overwrites the element at `index`, scattering each field into its column. Enables `array[i] = value`.
### `me` is received by reference (struct-record `setitem!`), so the per-column writes reach the
### caller's storage directly — no whole-array copy.
### :param index: The zero-based position to update.
### :param value: The replacement element.
### :throws: {IndexOutOfBoundsError} if `index >= COUNT`.
failable routine SplitItems[T, COUNT].setitem(index: U64, value: T)
    if index >= COUNT
        throw IndexOutOfBoundsError(index: index, count: COUNT)
    expand m in allmemvarof(T)
        danger
            me.$nameof(m)[index] = value.$nameof(m)
    return

# ============================================================================
# Query Operations
# ============================================================================

### Returns the fixed number of elements, always equal to the buildtime parameter `COUNT`.
### :returns: The element count `COUNT`.
@readonly
routine SplitItems[T, COUNT].count() -> U64
    return COUNT

### Returns true when the buildtime size is zero.
### :returns: `true` if `COUNT == 0`.
@readonly
routine SplitItems[T, COUNT].is_empty() -> Bool
    return COUNT == 0

### Returns the first element of the array.
### :returns: The element at index `0`.
### :throws: {AbsentValueError} The array has zero elements (`COUNT == 0`).
@readonly
failable routine SplitItems[T, COUNT].first() -> T
needs RecordType T
    if COUNT == 0
        throw AbsentValueError()
    return me[0]

### Returns the last element of the array.
### :returns: The element at index `COUNT - 1`.
### :throws: {AbsentValueError} The array has zero elements (`COUNT == 0`).
@readonly
failable routine SplitItems[T, COUNT].last() -> T
needs RecordType T
    if COUNT == 0
        throw AbsentValueError()
    return me[COUNT - 1]

### Returns true if any element equals `value`. O(N): reconstructs each element from the columns
### and compares by value.
### :param value: The value to search for.
### :returns: `true` if a matching element is present.
@readonly
routine SplitItems[T, COUNT].has(value: T) -> Bool
needs T obeys Equatable
    for i in 0 til COUNT
        if me[i] == value
            return true
    return false

### Returns whether `value` is not in this value: the opposite of `has`.
### :param value: The value to look for.
### :returns: `true` when `value` is absent.
@readonly
routine SplitItems[T, COUNT].lacks(value: T) -> Bool
needs T obeys Equatable
    return not me.has(value)

### Returns the index of the first element equal to `value`.
### :param value: The value to search for.
### :returns: The zero-based index of the first match.
### :throws: {AbsentValueError} No element equals `value`.
@readonly
failable routine SplitItems[T, COUNT].index_of(value: T) -> U64
needs T obeys Equatable
    for i in 0 til COUNT
        if me[i] == value
            return i
    throw AbsentValueError()

@readonly
routine SplitItems[T, COUNT].emitter() -> SplitItemsEmitter[T, COUNT]
needs RecordType T
    return SplitItemsEmitter[T, COUNT](source: me, index: 0)

### Produces the next element and advances, or throws `AbsentValueError` when the sequence is exhausted.
### :returns: The element at the current index.
### :throws: {AbsentValueError} All `COUNT` elements have been yielded.
failable routine SplitItemsEmitter[T, COUNT].emit() -> T
    if me.index >= COUNT
        throw AbsentValueError()
    var value = me.source[me.index]
    me.index = me.index + 1
    return value

# ============================================================================
# Display
# ============================================================================

@readonly
@override
routine SplitItems[T, COUNT].represent() -> Text
    var result = "["
    for i in 0 til COUNT
        if i > 0
            result = result + ", "
        result = result + nested_repr(me[i])
    result = result + "]"
    return result

@readonly
@override
routine SplitItems[T, COUNT].diagnose() -> Text
    var result = me.full_type_name() + "(["
    for i in 0 til COUNT
        if i > 0
            result = result + ", "
        result = result + nested_diagnose(me[i])
    result = result + "])"
    return result

# ============================================================================
# Comparison
# ============================================================================

### Returns true when both arrays contain equal elements in the same order.
### :param you: The other array to compare against.
### :returns: `true` if every corresponding pair of elements is equal.
### :note: Requires `T` to obey `Equatable`.
@readonly
routine SplitItems[T, COUNT].eq(you: SplitItems[T, COUNT]) -> Bool
needs T obeys Equatable
    for i in 0 til COUNT
        if me[i] != you[i]
            return false
    return true

### Lexicographic comparison of two arrays of equal length. Compares element by element from index 0
### using `T.compare`; returns at the first non-equal pair, or `SAME` when every pair is equal.
### :param you: The other array to compare against.
### :returns: `ME_SMALL`, `SAME`, or `ME_LARGE`.
### :note: Requires `T` to obey `Comparable`.
@readonly
routine SplitItems[T, COUNT].compare(you: SplitItems[T, COUNT]) -> ComparisonSign
needs T obeys Comparable
    for i in 0 til COUNT
        var sign = me[i].compare(you[i])
        if sign != SAME
            return sign
    return SAME
