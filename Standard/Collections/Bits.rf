module Collections

import BuilderQuery
### A fixed-size, inline sequence of `BITS` boolean flags packed into bytes.
###
### `Bits[BITS]` stores exactly `BITS` bits compactly — each bit occupies only
### one bit of storage rather than a full byte. Like {Items[T, BITS]}, it is a
### record type: copying a `Bits` copies all `BITS` bits and the size is fixed
### at build time.
###
### Because modification returns a new copy (via `with_set` and `with_flipped`)
### rather than mutating in place, `Bits` is well-suited for immutable flag
### sets or small bit masks that are passed around by value.
###
### **When to use**
### - The bit count is known at build time.
### - You want value semantics (copy = full duplication of all bits).
### - You need a compact, cache-friendly fixed-size flag field.
### - Use {BitList} when the number of bits is only known at runtime or bits are appended dynamically.
### - Use {Items[Bool, BITS]} when you need per-element mutability and don't mind the extra memory.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `getitem!` | O(1) |
### | `with_set` / `with_flipped` | O(1) — returns a new copy |
### | `count_trues` / `count_falses` | O(N) |
### | `is_any_true` / `is_all_true` / `is_none_true` | O(N) |
### | `contains` | O(N) |
###
### :typeparam BITS: The buildtime bit count, supplied as a `U64` literal.
### :see: {BitList} for a heap-backed growable bit sequence.
### :see: {Items[T, BITS]} for a fixed-size inline array of typed elements.
@llvm("[{(BITS+7)//8} x i8]")
record Bits[BITS]
relates BitsEmitter[BITS] as Emitter
obeys Comparable, Emittable[Bool], ModifyingIndexable[Bool]
needs U64 BITS
    nothing

# ============================================================================
# Iteration Support
# ============================================================================

### Walks the bits of a fixed-size `Bits[BITS]` from index 0 to N - 1.
### Because `Bits` is a record type, the emitter holds its own copy of the packed bits.
### :typeparam BITS: The buildtime bit count.
entity BitsEmitter[BITS]
obeys Emitter[Bool]
needs U64 BITS
    ### Stores the bit array being iterated.
    bits: Bits[BITS]
    ### Stores the next logical bit index to read.
    index: U64

### Reads the byte at `index` from a `Bits[BITS]`'s packed storage.
### :param array: The bit array to read from.
### :param index: The zero-based byte position.
### :returns: The byte stored at `index`.
@llvm_ir("{result} = alloca [{(BITS+7)//8} x i8]\nstore [{(BITS+7)//8} x i8] {array}, ptr {prev}\n{result} = getelementptr [{(BITS+7)//8} x i8], ptr {prev}, i32 0, i64 {index}\n{result} = load i8, ptr {prev}")
routine LLVM::byte_at_bits[BITS](array: Bits[BITS], index: U64) -> U8
needs U64 BITS

### Writes `value` into the byte at `index` of a `Bits[BITS]`'s packed storage.
### :param array: The bit array to update.
### :param index: The zero-based byte position.
### :param value: The byte to store.
### :returns: A copy of `array` with the byte at `index` replaced by `value`.
@llvm_ir("{result} = alloca [{(BITS+7)//8} x i8]\nstore [{(BITS+7)//8} x i8] {array}, ptr {prev}\n{result} = getelementptr [{(BITS+7)//8} x i8], ptr {prev}, i32 0, i64 {index}\nstore i8 {value}, ptr {prev}\n{result} = load [{(BITS+7)//8} x i8], ptr {first}")
routine LLVM::set_byte_at_bits[BITS](array: Bits[BITS], index: U64, value: U8) -> Bits[BITS]
needs U64 BITS

# ============================================================================
# Query Operations
# ============================================================================

### Returns the fixed number of bits in this array.
### This is always equal to the buildtime parameter `BITS`.
### :returns: The bit count `BITS`.
@readonly
routine Bits[BITS].count() -> U64
    return BITS

### Returns true when the buildtime bit count is zero.
### :returns: `true` if `BITS == 0`.
@readonly
routine Bits[BITS].is_empty() -> Bool
    return BITS == 0

# ============================================================================
# Indexing (read-only, value semantics)
# ============================================================================

### Returns the bit stored at `index`.
### :param index: The zero-based bit position to read.
### :returns: `true` if the bit at `index` is set; `false` if it is clear.
### :throws: {IndexOutOfBoundsError} if `index >= BITS`.
@readonly
failable routine Bits[BITS].getitem(index: U64) -> Bool
    if index >= BITS
        throw IndexOutOfBoundsError(index: index, count: BITS)
    # Access bit at index within packed bytes
    var byte_idx = index // 8
    var bit_off = (index % 8).to[U32]()
    var byte_val: U8 = 0
    # Read the packed byte in place through the storage pointer — no whole-array copy.
    danger
        byte_val = LLVM::load_element_ref[Bits[BITS], U8](me.hijack(), byte_idx)
    return (byte_val & (1 << bit_off)) != 0

### Writes `value` into the bit at `index`, mutating this `Bits` in place.
### :param index: The zero-based bit position to update.
### :param value: The new bit value.
### :throws: {IndexOutOfBoundsError} if `index >= BITS`.
failable routine Bits[BITS].setitem(index: U64, value: Bool)
    if index >= BITS
        throw IndexOutOfBoundsError(index: index, count: BITS)
    var byte_idx = LLVM::unsigned_div(index, 8)
    var bit_off = (LLVM::unsigned_rem(index, 8)).to[U32]()
    # `me` is by reference (struct-record `setitem!`): read-modify-write the single packed byte in
    # place through `me.hijack()` so the bit change reaches the caller's storage — no whole-array copy.
    danger
        var byte_val = LLVM::load_element_ref[Bits[BITS], U8](me.hijack(), byte_idx)
        if value
            LLVM::store_element_ref[Bits[BITS], U8](
                me.hijack(),
                byte_idx,
                byte_val | (1 << bit_off),
            )
        else
            LLVM::store_element_ref[Bits[BITS], U8](
                me.hijack(),
                byte_idx,
                byte_val & ~(1 << bit_off),
            )
    return

# ============================================================================
# Functional Modification (returns new copy)
# ============================================================================

### Returns a new `Bits` identical to this one but with the bit at `index` set to `value`.
### The original value is unchanged because `Bits` has value semantics.
### If `index >= BITS`, the original array is returned unmodified.
### :param index: The zero-based bit position to change.
### :param value: The new bit value.
### :returns: A copy of this array with the specified bit updated.
@readonly
routine Bits[BITS].with_set(index: U64, value: Bool) -> Bits[BITS]
    # Returns a new Bits with the bit at index changed
    if index >= BITS
        return me
    var result = me
    # Modify the bit in the copy
    var byte_idx = LLVM::unsigned_div(index, 8)
    var bit_off = (LLVM::unsigned_rem(index, 8)).to[U32]()
    var byte_val = LLVM::byte_at_bits[BITS](result, byte_idx)
    if value
        result = LLVM::set_byte_at_bits[BITS](result, byte_idx, byte_val | (1 << bit_off))
    else
        result = LLVM::set_byte_at_bits[BITS](result, byte_idx, byte_val & ~(1 << bit_off))
    return result

### Returns a new `Bits` identical to this one but with the bit at `index` toggled.
### If `index >= BITS`, the original array is returned unmodified.
### :param index: The zero-based bit position to flip.
### :returns: A copy of this array with the specified bit inverted.
@readonly
routine Bits[BITS].with_flipped(index: U64) -> Bits[BITS]
    # Returns a new Bits with the bit at index toggled
    if index >= BITS
        return me
    var current = me[index]
    return me.with_set(index: index, value: not current)

# ============================================================================
# Bit Queries
# ============================================================================

### Returns the number of bits currently set to `true`.
### :returns: The count of one-bits in this array.
@readonly
routine Bits[BITS].count_trues() -> U64
    var count: U64 = 0
    var i: U64 = 0
    until i >= BITS
        if me[i]
            count = count +% 1
        i = i +% 1
    return count

### Returns the number of bits currently set to `false`.
### :returns: `BITS` minus the number of one-bits.
@readonly
routine Bits[BITS].count_falses() -> U64
    return BITS -% me.count_trues()

### Returns true when at least one stored bit is `true`.
### :returns: `true` if any bit is set; `false` if all bits are clear.
@readonly
routine Bits[BITS].is_any_true() -> Bool
    var i: U64 = 0
    until i >= BITS
        if me[i]
            return true
        i = i +% 1
    return false

### Returns true when every stored bit is `true`.
### Empty arrays (`BITS == 0`) vacuously return `true`.
### :returns: `true` if all bits are set; `false` if any bit is clear.
@readonly
routine Bits[BITS].is_all_true() -> Bool
    var i: U64 = 0
    until i >= BITS
        if not me[i]
            return false
        i = i +% 1
    return true

### Returns true when no stored bit is `true`.
### :returns: `true` if all bits are clear; `false` if any bit is set.
@readonly
routine Bits[BITS].is_none_true() -> Bool
    return not me.is_any_true()

### Returns true if any stored bit equals `value`.
### When `value` is `true`, equivalent to `is_any_true()`; when `false`, equivalent to `not is_all_true()`.
### :param value: The bit value to search for.
### :returns: `true` if at least one stored bit matches `value`.
@readonly
routine Bits[BITS].has(value: Bool) -> Bool
    if value
        return me.is_any_true()
    return not me.is_all_true()

### Returns whether `value` is not in this value: the opposite of `has`.
### :param value: The value to look for.
### :returns: `true` when `value` is absent.
@readonly
routine Bits[BITS].lacks(value: Bool) -> Bool
    return not me.has(value)

### Returns the position of the first `true` bit.
### :returns: The lowest index whose bit is `true`.
### :throws: {AbsentValueError} when no bit is `true`.
@readonly
failable routine Bits[BITS].first_true() -> U64
    var i: U64 = 0
    until i >= BITS
        if me[i]
            return i
        i = i +% 1
    throw AbsentValueError()

### Returns the position of the next `true` bit after `after`.
### :param after: The index to look past.
### :returns: The lowest index above `after` whose bit is `true`.
### :throws: {AbsentValueError} when no bit after `after` is `true`.
@readonly
failable routine Bits[BITS].next_true(after: U64) -> U64
    var start: U64 = after
    if start >= BITS
        throw AbsentValueError()
    var i: U64 = start + 1
    until i >= BITS
        if me[i]
            return i
        i = i +% 1
    throw AbsentValueError()

### Returns the position of the first `false` bit.
### :returns: The lowest index whose bit is `false`.
### :throws: {AbsentValueError} when no bit is `false`.
@readonly
failable routine Bits[BITS].first_false() -> U64
    var i: U64 = 0
    until i >= BITS
        if not me[i]
            return i
        i = i +% 1
    throw AbsentValueError()

### Returns the position of the next `false` bit after `after`.
### :param after: The index to look past.
### :returns: The lowest index above `after` whose bit is `false`.
### :throws: {AbsentValueError} when no bit after `after` is `false`.
@readonly
failable routine Bits[BITS].next_false(after: U64) -> U64
    var start: U64 = after
    if start >= BITS
        throw AbsentValueError()
    var i: U64 = start + 1
    until i >= BITS
        if not me[i]
            return i
        i = i +% 1
    throw AbsentValueError()

# ============================================================================
# Display
# ============================================================================

@readonly
@override
routine Bits[BITS].represent() -> Text
    var result = "["
    var i: U64 = 0
    until i >= BITS
        if i > 0
            result = result + ", "
        result = result + nested_repr(me[i])
        i = i +% 1
    result = result + "]"
    return result

@readonly
@override
routine Bits[BITS].diagnose() -> Text
    var result = me.full_type_name() + "(["
    var i: U64 = 0
    until i >= BITS
        if i > 0
            result = result + ", "
        result = result + nested_diagnose(me[i])
        i = i +% 1
    result = result + "])"
    return result

@readonly
routine Bits[BITS].emitter() -> BitsEmitter[BITS]
    return BitsEmitter[BITS](bits: me, index: 0)

### Returns the next bit from the emitter in ascending index order.
### :returns: The bit at the current index.
### :throws: {AbsentValueError} All `BITS` bits have been yielded.
failable routine BitsEmitter[BITS].emit() -> Bool
    if me.index >= BITS
        throw AbsentValueError()
    var value = me.bits[me.index]
    me.index = me.index + 1
    return value

# ============================================================================
# Equality and Comparison
# ============================================================================

### Returns true when both bit arrays contain equal bits at every position.
### :param you: The other bit array to compare against.
### :returns: `true` if every corresponding pair of bits is equal.
### :note: Bit-by-bit comparison is required because the trailing bits of the
###        last byte are unspecified — a raw `memcmp` would compare padding.
@readonly
routine Bits[BITS].eq(you: Bits[BITS]) -> Bool
    for i in 0 til BITS
        if me[i] != you[i]
            return false
    return true

### Lexicographic comparison of two bit arrays of equal length.
### Compares bit by bit from index 0; `false` sorts before `true`.
### :param you: The other bit array to compare against.
### :returns: `ME_SMALL`, `SAME`, or `ME_LARGE`.
@readonly
routine Bits[BITS].compare(you: Bits[BITS]) -> ComparisonSign
    for i in 0 til BITS
        var a = me[i]
        var b = you[i]
        if a != b
            if a
                return ME_LARGE
            return ME_SMALL
    return SAME
