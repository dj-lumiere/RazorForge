module Core

### Represents one key-value pair used by dictionary-style APIs.
### `DictEntry[TKey, TValue]` appears in dictionary literals, iteration, and constructor helpers.
### :typeparam TKey: The key type.
### :typeparam TValue: The value type.
bundle DictEntry[TKey, TValue]
    ### Stores the entry key.
    key: TKey
    ### Stores the value associated with `key`.
    value: TValue
