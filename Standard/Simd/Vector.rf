module Simd

### A fixed-length SIMD vector of `LANES` lanes of element type `T`, laid out as the
### native LLVM vector type `<LANES x T>`. Arithmetic is elementwise (lane-wise) and
### lowers to hardware vector instructions where the target supports them.
###
### Unlike the geometry-facing `Vector2D`/`Vector3D`/`Vector4D`, this type is
### generic over both the element type and the lane count, and its `*` / `/` are
### elementwise (Hadamard) — the standard SIMD meaning — not a dot or cross
### product. Use `dot` for the inner product.
###
### **Element type:** `T` must obey `Numeric`. In practice `Vector[T, LANES]` is
### intended for the primitive IEEE float lanes `B16` / `B32` / `B64`, whose
### `+ - * /` map to LLVM `fadd` / `fsub` / `fmul` / `fdiv` on `<LANES x T>`. Software
### floats (`B128`) and non-float `Numeric` types are not valid SIMD lanes.
###
### :typeparam T: The element (lane) type; a primitive float.
### :typeparam LANES: The buildtime lane count, supplied as a `U64` literal.
### :see: {Vector3D} for the fixed 3-component geometry vector.
@llvm("<{LANES} x {T}>")
record Vector[T, LANES]
obeys Addable, Subtractable, Multiplicable, Divisible, Negatable, Equatable, Sized,
    MutableIndexable[T]
needs U64 LANES
    # N lanes of T stored as a native LLVM vector - no explicit member variables.
    pass

# ============================================================================
# Constructors
# ============================================================================

### Constructs a vector with every lane set to `fill` (a broadcast / splat).
### Pass `fill: 0` (in the lane type) for the zero vector.
### :param fill: The scalar to replicate across all `LANES` lanes.
### :returns: The splatted vector.
routine Vector[T, LANES](fill: T) -> Vector[T, LANES]
    var result = LLVM::zero_value[Vector[T, LANES]]()
    each i in 0u64 til LANES
        result = LLVM::insert_element[Vector[T, LANES], T](result, fill, i)
    return result

# ============================================================================
# Lane Access
# ============================================================================

### Returns the scalar at lane `index` (the `me[index]` read operator).
### Reads in place through the storage pointer — a `<LANES x T>` vector is `LANES`
### contiguous `T` lanes, so an `T`-strided load addresses lane `index` directly.
### :param index: The zero-based lane to read.
### :returns: The element at that lane.
### :throws: {IndexOutOfBoundsError} if `index >= LANES`.
@readonly
routine Vector[T, LANES].getitem!(index: U64) -> T
    if index >= LANES
        throw IndexOutOfBoundsError(index: index, count: me.count())
    danger
        return LLVM::load_element_ref[Vector[T, LANES], T](me.hijack(), index)

### Replaces the lane at `index` with `value`, mutating this vector in place (the
### `me[index] = value` write operator). `me` is received by reference, so the
### single-lane write through `me.hijack()` reaches the caller's storage.
### :param index: The zero-based lane to overwrite.
### :param value: The replacement scalar.
### :throws: {IndexOutOfBoundsError} if `index >= LANES`.
routine Vector[T, LANES].setitem!(index: U64, value: T)
    if index >= LANES
        throw IndexOutOfBoundsError(index: index, count: me.count())
    danger
        LLVM::store_element_ref[Vector[T, LANES], T](me.hijack(), index, value)
    return

### Returns the lane count `LANES`.
### :returns: The buildtime lane count.
@readonly
routine Vector[T, LANES].count() -> U64
    return LANES

### Returns true when the lane count is zero.
### :returns: `true` if `LANES == 0`.
@readonly
routine Vector[T, LANES].is_empty() -> Bool
    return LANES == 0u64

# ============================================================================
# Elementwise Arithmetic (lowers to LLVM `<LANES x T>` vector ops)
# ============================================================================

### Returns the lane-wise sum `me + you`.
### :param you: The addend vector.
### :returns: A vector whose lanes are the sums.
routine Vector[T, LANES].add(you: Vector[T, LANES]) -> Vector[T, LANES]
needs T obeys Numeric
    return LLVM::float_add[Vector[T, LANES]](me, you)

### Returns the lane-wise difference `me - you`.
### :param you: The vector to subtract.
### :returns: A vector whose lanes are the differences.
routine Vector[T, LANES].sub(you: Vector[T, LANES]) -> Vector[T, LANES]
needs T obeys Numeric
    return LLVM::float_sub[Vector[T, LANES]](me, you)

### Returns the lane-wise (Hadamard) product `me * you`.
### :param you: The right operand vector.
### :returns: A vector whose lanes are the products.
routine Vector[T, LANES].mul(you: Vector[T, LANES]) -> Vector[T, LANES]
needs T obeys Numeric
    return LLVM::float_mul[Vector[T, LANES]](me, you)

### Returns the lane-wise quotient `me / you`.
### :param you: The divisor vector.
### :returns: A vector whose lanes are the quotients.
routine Vector[T, LANES].truediv(you: Vector[T, LANES]) -> Vector[T, LANES]
needs T obeys Numeric
    return LLVM::float_div[Vector[T, LANES]](me, you)

### Returns the lane-wise negation of this vector.
### :returns: A vector whose lanes are negated.
routine Vector[T, LANES].neg() -> Vector[T, LANES]
needs T obeys Numeric
    return LLVM::float_sub[Vector[T, LANES]](LLVM::zero_value[Vector[T, LANES]](), me)

### Returns this vector with every lane scaled by the scalar `factor`.
### :param factor: The scalar multiplier.
### :returns: `factor · me`, lane-wise.
routine Vector[T, LANES].scale(factor: T) -> Vector[T, LANES]
needs T obeys Numeric
    return LLVM::float_mul[Vector[T, LANES]](me, Vector[T, LANES](fill: factor))

# ============================================================================
# Reductions
# ============================================================================

### Returns the horizontal sum of all lanes.
### :returns: `lane₀ + lane₁ + … + laneₙ₋₁`.
@readonly
routine Vector[T, LANES].sum() -> T
needs T obeys Numeric
    var acc = LLVM::zero_value[T]()
    each i in 0u64 til LANES
        acc = acc + LLVM::extract_element[Vector[T, LANES], T](me, i)
    return acc

### Returns the dot (inner) product `me · you`, the horizontal sum of the
### lane-wise products.
### :param you: The right operand vector.
### :returns: `Σ meᵢ·youᵢ`.
@readonly
routine Vector[T, LANES].dot(you: Vector[T, LANES]) -> T
needs T obeys Numeric
    var prod = me * you
    return prod.sum()

### Returns the squared Euclidean length (the dot product with itself).
### :returns: `me · me`.
@readonly
routine Vector[T, LANES].length_squared() -> T
needs T obeys Numeric
    return me.dot(you: me)

# ============================================================================
# Comparison
# ============================================================================

### Returns true when every lane compares equal.
### :param you: The other vector.
### :returns: `true` if all `LANES` lanes are equal.
@readonly
routine Vector[T, LANES].eq(you: Vector[T, LANES]) -> Bool
needs T obeys Equatable
    each i in 0u64 til LANES
        if LLVM::extract_element[Vector[T, LANES], T](me, i) != LLVM::extract_element[Vector[T, LANES], T](
            you,
            i,
        )
            return false
    return true

# ============================================================================
# Display
# ============================================================================

### Formats this vector as `<lane₀, lane₁, …>`.
### :returns: The resulting `Text` value.
@readonly
@override
routine Vector[T, LANES].represent() -> Text
    var result = "<"
    each i in 0u64 til LANES
        if i > 0u64
            result = result + ", "
        result = result + LLVM::extract_element[Vector[T, LANES], T](me, i).represent()
    result = result + ">"
    return result
