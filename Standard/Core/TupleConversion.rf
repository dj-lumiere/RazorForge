module Core

import BuilderExpansion

### Reads a tuple from text: the text is split into words, and each word becomes the item in its place with its own
### `to` (`"2024 4 1".to[(S64, S64, S64)]()`). The number of words must be the number of items.
### :throws: {InvalidValueError} if the text has more or fewer words than the tuple has items.
### :throws: Whatever an item's conversion throws, when its word does not read as that item's type.
### :returns: The tuple.
routine Text.to![T]() -> T
needs TupleType T
    var words = me.words()
    var expected: U64 = 0
    expand m in allmemvarof(T)
        expected = expected +% 1
    if words.count() != expected
        throw InvalidValueError(input: me, target: f"a tuple of {expected} items")
    lateinit var result: T
    var i: U64 = 0
    expand m in allmemvarof(T)
        result.$nameof(m) = words[i].to[$typeof(m)]()
        i = i +% 1
    return result

