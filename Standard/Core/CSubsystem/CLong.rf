module Core

### Platform-neutral basic API for {CLong}. The width-specific representation and the `S64` widen/narrow
### conversions live in the `@target`-gated `CLong_windows` / `CLong_unix` siblings; these members build on
### the widen conversion (total on both data models), so they are shared and load on every target.

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
@override
routine CLong.eq(you: CLong) -> Bool
    return me.to[S64]() == you.to[S64]()

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
@override
routine CLong.cmp(you: CLong) -> ComparisonSign
    return me.to[S64]() <=> you.to[S64]()

### Returns the display form of this C `long`, rendered as its signed decimal value.
### :returns: The resulting `Text` value.
@readonly
@override
routine CLong.represent() -> Text
    return me.to[S64]().represent()

### Returns the diagnostic form of this C `long`.
### :returns: The resulting `Text` value.
@readonly
@override
routine CLong.diagnose() -> Text
    return "CLong(" + me.to[S64]().represent() + ")"

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
@readonly
@override
routine CLong.hash(k0: U64, k1: U64) -> U64
    return me.to[S64]().hash(k0: k0, k1: k1)
