module Core

### A C string RazorForge made: UTF-8 bytes with a zero byte after them, torn down at the end of its scope like any
### value. A `CStr` goes wherever a {CStrView} goes: C reads it through `view()`, which the builder inserts where a
### `CStrView` parameter takes a `CStr`. Passed with `steal`, it goes through `leak()` instead, so C keeps memory that
### is never torn down here.
### :see: {CStrView}, {Bytes}
record CStr
    ### The bytes and the zero byte after them.
    secret bytes: Bytes

### Copies these bytes into a new C string and puts a zero byte after them.
### :returns: The C string.
@readonly
routine Bytes.to[CStr]() -> CStr
    var len = me.count
    danger
        var buffer = Hijacked[Byte](rf_allocate_dynamic(size: Byte.data_size() * (len + 1)))
        if len > 0
            rf_copy_bytes_at(dest: buffer.address(), src: me.data.address(), size: Byte.data_size() * len)
        buffer.stride(count: len.to[S64]()).poke(value: BYTE_NULL)
        return CStr(bytes: bytes_over(data: buffer, count: len + 1))

### Encodes this text as UTF-8 into a new C string with a zero byte at the end.
### :returns: The C string.
@readonly
routine Text.to[CStr]() -> CStr
    return me.encode_as_utf8().to[CStr]()

### The C string pointer for C to read. It stays valid while this `CStr` lives.
### :returns: The pointer.
@readonly
routine CStr.view() -> CStrView
    return CStrView(from_ptr: me.bytes.data)

### Hands this C string's memory to C for good: the pointer it returns is never freed by RazorForge. The builder
### calls it for a `CStr` passed with `steal` where a `CStrView` goes.
### :returns: The pointer.
routine CStr.leak() -> CStrView
    return CStrView(from_ptr: me.bytes.data)

### The length of this C string in bytes, without the zero byte.
### :returns: The byte count.
@readonly
routine CStr.count() -> U64
    return me.bytes.count - 1

### Decodes this C string's UTF-8 bytes into text.
### :returns: The text.
@readonly
routine CStr.to[Text]() -> Text
    return me.view().to[Text]()
