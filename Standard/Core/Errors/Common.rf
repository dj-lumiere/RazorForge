module Core

### Represents the crashable raised when code tries to consume an absent optional
### result as though a value were present.
crashable AbsentValueError
    pass

### Represents the crashable used when program execution is terminated by the
### user or hosting environment.
crashable UserTerminationError
    pass

### Represents the crashable raised when a runtime verification check fails.
### This is used by generic verification surfaces that enforce invariants and
### preconditions explicitly.
crashable VerificationFailedError
    pass

### Represents the crashable raised when code reaches a state that should be
### impossible if surrounding logic is correct.
crashable LogicBreachedError
    pass

### Represents the crashable raised when a lookup cannot find a requested key.
crashable KeyNotFoundError
    ### Stores the key that could not be resolved.
    key: Text

### Raised when a threaded task could not be spawned (thread or allocation failure).
crashable TaskSpawnError
    pass

### Raised when a threaded task did not finish before its deadline.
crashable TaskTimeoutError
    pass

### Raised when sending to a channel that has been closed, or whose every consumer has gone — the item
### can never be delivered. Closing itself is not an error (it is the normal end-of-stream signal);
### only a `send` after close is.
crashable ChannelClosedError
    pass

### Raised when a thread tries to acquire an exclusive lock it already holds — a re-entrant
### `amend()` (or `amend()` while `consult()`-blocked under exclusion). The acquire would spin
### forever, so it is reported as a self-deadlock crash rather than hanging.
crashable ReentrantLockError
    pass

### Returns the default message for absent-value failures.
### :returns: The resulting `Text` value.
@readonly
@override
routine AbsentValueError.crash_message() -> Text
    return "Attempted to access a value that is absent."

### Returns the default message for user-requested termination.
### :returns: The resulting `Text` value.
@readonly
@override
routine UserTerminationError.crash_message() -> Text
    return "Program was stopped by user."

### Returns the default message for verification failures.
### :returns: The resulting `Text` value.
@readonly
@override
routine VerificationFailedError.crash_message() -> Text
    return "A verification check failed."

### Returns the default message for breached logic invariants.
### :returns: The resulting `Text` value.
@readonly
@override
routine LogicBreachedError.crash_message() -> Text
    return "A logic breach was detected."

### Returns the default message for failed keyed lookup.
### :returns: The resulting `Text` value.
@readonly
@override
routine KeyNotFoundError.crash_message() -> Text
    return f"Key not found: {me.key}"

### Returns the default message for task-spawn failures.
### :returns: The resulting `Text` value.
@readonly
@override
routine TaskSpawnError.crash_message() -> Text
    return "Failed to spawn a threaded task."

### Returns the default message for task-timeout failures.
### :returns: The resulting `Text` value.
@readonly
@override
routine TaskTimeoutError.crash_message() -> Text
    return "Threaded task did not finish before its deadline."

### Returns the default message for sending to a closed channel.
### :returns: The resulting `Text` value.
@readonly
@override
routine ChannelClosedError.crash_message() -> Text
    return "Cannot send to a closed channel (no consumer can receive the item)."

### Returns the default message for re-entrant lock acquisition.
### :returns: The resulting `Text` value.
@readonly
@override
routine ReentrantLockError.crash_message() -> Text
    return "Re-entrant exclusive lock acquisition — the calling thread already holds this lock (self-deadlock)."
