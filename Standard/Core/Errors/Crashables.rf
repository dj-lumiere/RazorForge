module Core

### Any crashable: the error a `grab` or `lookup` caught, whatever its type. `is Crashables e` on a `Check` or
### `Lookup` binds it. It is the address of the heap object the error lives in, whose mold names the crashable's
### own routines, so `crash_title`, `crash_message`, `represent` and `diagnose` reach that crashable's. The carrier
### that caught the error owns the object and frees it; a `Crashables` read out of it is valid while the carrier
### holds the error.
record Crashables
    ### The address of the heap object the caught error lives in.
    secret object: Address

### The caught error's title: its type's name in sentence case, unless the crashable writes its own.
### :returns: The title.
@readonly
@innate
routine Crashables.crash_title() -> Text

### The caught error's message.
### :returns: The message.
@readonly
@innate
routine Crashables.crash_message() -> Text

### The caught error as text: its message.
### :returns: The message.
@readonly
@override
@innate
routine Crashables.represent() -> Text

### The caught error for diagnostics: its type, message and member variables.
### :returns: The diagnostic text.
@readonly
@override
@innate
routine Crashables.diagnose() -> Text

### The caught error's type id, the one a type pattern on a carrier compares.
### :returns: The type id.
@readonly
@innate
routine Crashables.crash_type_id() -> U64

### Frees the caught error and the object it lives in. Only the carrier that owns the error calls this.
@innate
dangerous routine Crashables.free()
