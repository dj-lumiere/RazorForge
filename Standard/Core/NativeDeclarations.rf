# ============================================================================
# Binary floats (Ingrid/tessera/binfloat.tess)
# ============================================================================
# The library functions of B16, B32, B64 and B128, each one call to Tessera's correctly rounded routine (the
# CORE-MATH ports). Each is the raw IEEE function (a NaN, an infinity or a pole passes through): the checked
# routines crash in RazorForge. Each is the RazorForge routine of the same name (`exp` is `exp_unchecked`, `log`
# is `log_unchecked`, `tgamma` is `tgamma_unchecked`, `hypot` is `hypot_unchecked`, `fma` is `fma_unchecked`,
# ...). A B16, B32 or B64 crosses as itself. A B128 goes in as its low and high 64 bits (a 128-bit value crosses
# Win64 by pointer from Tessera but by value from RazorForge, so neither side passes one) and comes back in
# `IngridWords` (`w0` low, `w1` high, and for `sincos` the cosine in `w2` and `w3`).

routine C::ingrid_b16_exp(x: B16) -> B16
routine C::ingrid_b16_exp2(x: B16) -> B16
routine C::ingrid_b16_exp10(x: B16) -> B16
routine C::ingrid_b16_expm1(x: B16) -> B16
routine C::ingrid_b16_log(x: B16) -> B16
routine C::ingrid_b16_log2(x: B16) -> B16
routine C::ingrid_b16_log10(x: B16) -> B16
routine C::ingrid_b16_log1p(x: B16) -> B16
