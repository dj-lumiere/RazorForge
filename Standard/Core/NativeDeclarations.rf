# ============================================================================
# Arbitrary-precision Integer and Real (Ingrid/tessera/generated/numerics.tess)
# ============================================================================
# The bodies of Integer and Real: Numeric/IntegerEngine.rf and Numeric/RealEngine.rf, which
# `RazorForge export-ingrid` writes to Ingrid's library from RazorForge/IngridExport/numerics.rf (that file
# describes the call protocol). A value crosses as its parts, a sign as a U64. RazorForge allocates and frees
# every buffer, the engine takes its temporaries from the `scratch` buffer it is handed, and a result comes back
# in IngridWords: `w0` 0 done, 1 more scratch needed (`w1` at least), 2 a larger result buffer needed (`w1`).

### Starts the scratch arena of an engine call on `limbs` limbs at `base` (Ingrid/tessera/scratch.tess). The
### engines call the arena routines, RazorForge's own code doesn't.
### :param base: The buffer.
### :param limbs: Its size in limbs.
dangerous routine C::ingrid_scratch_open(base: Hijacked[U64], limbs: U64)

### Ends the call's scratch arena.
### :returns: 0 when everything fit, else the limbs the call needs at least.
routine C::ingrid_scratch_close() -> U64

### Asks the arena to admit `limbs` more limbs before an operation takes them. A refusal exhausts the call.
### :param limbs: The most the operation takes.
### :returns: True when they fit.
routine C::ingrid_scratch_admit(limbs: U64) -> Bool

### True once an admission of the call was refused.
### :returns: Whether the call is exhausted.
routine C::ingrid_scratch_exhausted() -> Bool

### Takes `limbs` zeroed limbs from the arena (admitted before).
### :param limbs: How many limbs.
### :returns: The first of them.
dangerous routine C::ingrid_scratch_take(limbs: U64) -> Hijacked[U64]

### The most limbs the last engine call on this thread had taken at once.
### :returns: Its high-water mark in limbs.
routine C::ingrid_scratch_peak() -> U64

### a + b into `out`, which holds at least max(a_len, b_len) + 1 limbs. Takes no scratch.
dangerous routine C::ingrid_integer_add(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
) -> IngridWords

### a * b into `out` (a_len + b_len limbs).
dangerous routine C::ingrid_integer_mul(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords

### The scratch `ingrid_integer_mul` takes.
routine C::ingrid_integer_mul_scratch_size(a_len: U64, b_len: U64) -> U64

### The Euclidean quotient into `q_out` and remainder into `r_out` of a / b, b nonzero. Done: `w1` the quotient's
### length, `w2` its sign, `w3` the remainder's length.
dangerous routine C::ingrid_integer_divmod(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    q_out: Hijacked[U64],
    q_cap: U64,
    r_out: Hijacked[U64],
    r_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords

### The scratch `ingrid_integer_divmod` takes.
routine C::ingrid_integer_divmod_scratch_size(a_len: U64, b_len: U64) -> U64

### a * 2^bits into `out` (a_len + bits / 64 + 1 limbs). Takes no scratch.
dangerous routine C::ingrid_integer_shift_left(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    bits: U64,
    out: Hijacked[U64],
    out_cap: U64,
) -> IngridWords

### floor(a / 2^bits) into `out` (a_len - bits / 64 + 1 limbs, and 1). Takes no scratch.
dangerous routine C::ingrid_integer_shift_right(
