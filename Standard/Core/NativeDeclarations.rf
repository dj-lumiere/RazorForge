# C256: each B128 part as its low and high 64 bits (a 128-bit value crosses Win64 by pointer from Tessera but
# by value from RazorForge, so neither side passes one). `abs`, `arg` and `norm` hand their B128 back in
# `IngridWords` (`w0` low, `w1` high).
routine C::ingrid_c256_mul(
    real_low: U64,
    real_high: U64,
    imag_low: U64,
    imag_high: U64,
    other_real_low: U64,
    other_real_high: U64,
    other_imag_low: U64,
    other_imag_high: U64,
) -> C256
routine C::ingrid_c256_div(
    real_low: U64,
    real_high: U64,
    imag_low: U64,
    imag_high: U64,
    other_real_low: U64,
    other_real_high: U64,
    other_imag_low: U64,
    other_imag_high: U64,
) -> C256
routine C::ingrid_c256_pow(
    real_low: U64,
    real_high: U64,
    imag_low: U64,
    imag_high: U64,
    other_real_low: U64,
    other_real_high: U64,
    other_imag_low: U64,
    other_imag_high: U64,
) -> C256
