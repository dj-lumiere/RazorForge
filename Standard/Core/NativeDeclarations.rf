# ============================================================================
# Decimal floats (Ingrid/tessera/decimal/)
# ============================================================================
# D32, D64 and D128 are computed by Ingrid's decimal engine (written in Tessera): the arithmetic, the rounding and
# exponent operations, the conversions, DPD, and the transcendentals, each correctly rounded. A D32 crosses as its 32
# BID bits, a D64 as its 64, and a D128 goes in as its low and high 64 bits and comes back in `IngridWords` (`w0`
# low, `w1` high). A flag crosses as a U32 (0 or 1). Each is the raw IEEE operation (an infinity or a NaN passes
# through): the checked routines crash in RazorForge. An order is -1, 0 or 1 as a is below, equal to or above b, and
# 2 when either is a NaN.

### `a + b`, rounded half to even to 7 digits.
routine C::ingrid_d32_add(a: U32, b: U32) -> U32

### `a - b`, rounded half to even to 7 digits.
routine C::ingrid_d32_sub(a: U32, b: U32) -> U32

### `a * b`, rounded half to even to 7 digits.
routine C::ingrid_d32_mul(a: U32, b: U32) -> U32

### `a / b`, rounded half to even to 7 digits: a nonzero value over zero is an infinity, zero over zero a NaN.
routine C::ingrid_d32_div(a: U32, b: U32) -> U32

### The order of a and b.
routine C::ingrid_d32_order(a: U32, b: U32) -> S64

### `a * b + c` rounded once to 7 digits.
routine C::ingrid_d32_fma(a: U32, b: U32, c: U32) -> U32

### The square root, correctly rounded and reduced (NaN for a negative number).
routine C::ingrid_d32_sqrt(x: U32) -> U32

### sqrt(x^2 + y^2), correctly rounded (+infinity when either is infinite).
routine C::ingrid_d32_hypot(x: U32, y: U32) -> U32

### sqrt(x^2 + y^2 + z^2), correctly rounded.
routine C::ingrid_d32_hypot3(x: U32, y: U32, z: U32) -> U32

### x rounded to an integral value: mode 0 toward zero, 1 down, 2 up, 3 nearest with ties away from zero, 4 nearest with ties to even. A special, a zero, or a value without a fraction comes back as it is.
routine C::ingrid_d32_round_int(x: U32, mode: U32) -> U32

### a with b's exponent, rounded half to even (NaN when that needs more than the digits there are). a comes back as it is when the exponents match or both are infinite.
routine C::ingrid_d32_quantize(a: U32, b: U32) -> U32

### The remainder of a truncated division, exact, with a's sign: NaN for a NaN, an infinite a, or a zero b; a as it is for an infinite b.
routine C::ingrid_d32_fmod(a: U32, b: U32) -> U32

### The IEEE remainder a - n b, n the integer nearest a / b (ties to even), exact: NaN for a NaN, an infinite a, or a zero b; a as it is for an infinite b.
routine C::ingrid_d32_remainder(a: U32, b: U32) -> U32

### The simplest member of x's cohort (trailing zeros stripped, a zero with exponent 0); a special comes back as it is.
routine C::ingrid_d32_normalize(x: U32) -> U32

### x × 10^n by the exponent alone (an infinity above the range, a zero below it); a special or a zero comes back as it is.
routine C::ingrid_d32_scaleb(x: U32, n: S64) -> U32

### The exponent e with 10^e <= |x| < 10^(e + 1) (-infinity for a zero).
routine C::ingrid_d32_logb(x: U32) -> U32

### (-1)^neg × coeff × 10^exp, coeff = c_high × 2^64 + c_low, rounded half to even to 7 digits with exp as the preferred exponent.
routine C::ingrid_d32_from_parts(neg: U32, c_low: U64, c_high: U64, exp: S64) -> U32

### The integer (-1)^neg × (m3 m2 m1 m0, 64 bits each, m0 lowest), rounded half to even to 7 digits, exponent 0 when it fits.
routine C::ingrid_d32_from_integer(neg: U32, m0: U64, m1: U64, m2: U64, m3: U64) -> U32

### x in the DPD interchange encoding.
routine C::ingrid_d32_to_dpd(x: U32) -> U32

### The D32 whose DPD interchange encoding is bits.
routine C::ingrid_d32_from_dpd(bits: U32) -> U32

### The F128 high × 2^64 + low (a narrower binary float widened to F128 first, which is exact), rounded once to 7 digits and reduced.
routine C::ingrid_d32_from_binary(low: U64, high: U64) -> U32

### The bits of the binary float of `which` bits (16, 32, 64, or 128) nearest x: w0 the low 64 bits, w1 the high ones.
routine C::ingrid_d32_to_binary(x: U32, which: U32) -> IngridWords

### `a + b`, rounded half to even to 16 digits.
routine C::ingrid_d64_add(a: U64, b: U64) -> U64

### `a - b`, rounded half to even to 16 digits.
routine C::ingrid_d64_sub(a: U64, b: U64) -> U64

### `a * b`, rounded half to even to 16 digits.
routine C::ingrid_d64_mul(a: U64, b: U64) -> U64

### `a / b`, rounded half to even to 16 digits: a nonzero value over zero is an infinity, zero over zero a NaN.
routine C::ingrid_d64_div(a: U64, b: U64) -> U64

### The order of a and b.
routine C::ingrid_d64_order(a: U64, b: U64) -> S64

### `a * b + c` rounded once to 16 digits.
routine C::ingrid_d64_fma(a: U64, b: U64, c: U64) -> U64

### The square root, correctly rounded and reduced (NaN for a negative number).
routine C::ingrid_d64_sqrt(x: U64) -> U64

### sqrt(x^2 + y^2), correctly rounded (+infinity when either is infinite).
routine C::ingrid_d64_hypot(x: U64, y: U64) -> U64

### sqrt(x^2 + y^2 + z^2), correctly rounded.
routine C::ingrid_d64_hypot3(x: U64, y: U64, z: U64) -> U64

### x rounded to an integral value: mode 0 toward zero, 1 down, 2 up, 3 nearest with ties away from zero, 4 nearest with ties to even. A special, a zero, or a value without a fraction comes back as it is.
routine C::ingrid_d64_round_int(x: U64, mode: U32) -> U64

### a with b's exponent, rounded half to even (NaN when that needs more than the digits there are). a comes back as it is when the exponents match or both are infinite.
routine C::ingrid_d64_quantize(a: U64, b: U64) -> U64

### The remainder of a truncated division, exact, with a's sign: NaN for a NaN, an infinite a, or a zero b; a as it is for an infinite b.
routine C::ingrid_d64_fmod(a: U64, b: U64) -> U64

### The IEEE remainder a - n b, n the integer nearest a / b (ties to even), exact: NaN for a NaN, an infinite a, or a zero b; a as it is for an infinite b.
routine C::ingrid_d64_remainder(a: U64, b: U64) -> U64

### The simplest member of x's cohort (trailing zeros stripped, a zero with exponent 0); a special comes back as it is.
routine C::ingrid_d64_normalize(x: U64) -> U64

### x × 10^n by the exponent alone (an infinity above the range, a zero below it); a special or a zero comes back as it is.
routine C::ingrid_d64_scaleb(x: U64, n: S64) -> U64

### The exponent e with 10^e <= |x| < 10^(e + 1) (-infinity for a zero).
routine C::ingrid_d64_logb(x: U64) -> U64

### (-1)^neg × coeff × 10^exp, coeff = c_high × 2^64 + c_low, rounded half to even to 16 digits with exp as the preferred exponent.
routine C::ingrid_d64_from_parts(neg: U32, c_low: U64, c_high: U64, exp: S64) -> U64

### The integer (-1)^neg × (m3 m2 m1 m0, 64 bits each, m0 lowest), rounded half to even to 16 digits, exponent 0 when it fits.
routine C::ingrid_d64_from_integer(neg: U32, m0: U64, m1: U64, m2: U64, m3: U64) -> U64

### x in the DPD interchange encoding.
routine C::ingrid_d64_to_dpd(x: U64) -> U64

### The D64 whose DPD interchange encoding is bits.
