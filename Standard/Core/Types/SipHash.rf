module Core

# SipHash-2-4 lives in Ingrid's Tessera library (`Ingrid/tessera/hash.tess`), shared with Suflae. These two are the
# entry points the standard library's `hash(k0, k1)` routines call.

### Secure-hashes a single 64-bit value via SipHash-2-4, as its 8 bytes in memory.
secret routine __secure_hash_u64(v: U64, k0: U64, k1: U64) -> U64
    return C::ingrid_siphash24_u64(value: v, k0: k0, k1: k1)

### Secure-hashes a 128-bit value via SipHash-2-4, as its 16 bytes in memory.
secret routine __secure_hash_u128(v: U128, k0: U64, k1: U64) -> U64
    var low = LLVM::int_truncate[U128, U64](v)
    var high = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(v, 64_u128))
    return C::ingrid_siphash24_u128(low: low, high: high, k0: k0, k1: k1)
