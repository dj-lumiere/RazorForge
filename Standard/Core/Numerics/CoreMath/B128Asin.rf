# ============================================================================
# The fast phase of CORE-MATH's arc sine of B128
# ============================================================================
# B128.asin_unchecked itself is Tessera's, through Ingrid. This file keeps the 128-bit fast phase
# the D128 transcendentals (D128Fast.rf) build on.
# Ported from CORE-MATH, src/binary128/asin/asinq.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see THIRD-PARTY-NOTICES.md at the repository root. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# exception-flag and errno handling and directed-rounding branches are dropped).
# Everything works on integers, never on the B128 arithmetic operators. The helpers and tables shared with
# the arc cosine live in CoreMath/B128AsinFam.rf.
#
# For |x| >= 0.022 the argument is reduced with the table point s_j = sin(pi/2/72*j):
# asin(x) = asin(s_j) + asin(x*sqrt(1 - s_j^2) - s_j*sqrt(1 - x^2)), and the small remainder goes through
# an odd polynomial. A 128-bit fast path is checked against its error bound and falls back to a 320-bit
# accurate path.

### asin(x) before rounding, for 0.022 <= |x| < 1 (the table-reduced branch of `asin_unchecked`'s fast path), as
### a B128Fx, or false below 0.022 (and for |x| >= 1). The fast path's 192-bit value xc (asin |x| = xc 2^-191:
### the result's exponent field is added onto its leading bit) is within eps of its units, the bound its rounding
### test uses; the bound kept here is 4 eps plus the
### truncation to 128 bits.
secret routine b128_asin_fx(x: B128) -> (Bool, B128Fx)
    var u = x.to_bits()
    var xb0 = LLVM::int_truncate[U128, U64](u)
    var xb1 = LLVM::int_truncate[U128, U64](u >>> 64)
    var neg = (xb1 & 0x8000000000000000) != 0
    xb1 = xb1 & 0x7FFFFFFFFFFFFFFF
    var xn = b128_asinfam_s(u: xb1 >>> 48)
    if xn < 0x3FFF -% 56 or xn >= 0x3FFF
        return (false, b128fx_one())
    var j = b128_asinfam_jget(x: xb1)
    if j == 0
        return (false, b128fx_one())
    xb1 = xb1 | 0x0001000000000000
    var xa = b128_asinfam_join(hi: xb1, lo: xb0) << 15
    xb0 = b128_asinfam_lo(u: xa)
    xb1 = b128_asinfam_hi(u: xa)
    var nz = 0x3FFF -% xn
    var red = b128_asinfam_fast_sqrt(x0: xb0, x1: xb1, nz: nz, mode: 0)
    var e = red.item3
    var xs = xa >>> b128_asinfam_sh(n: nz)
    var ci = j *% 5
    var p = b128_asinfam_mh3d(
        y0: b128_asinfam_lo(u: xs),
        y1: b128_asinfam_hi(u: xs),
        x0: B128_ASINFAM_CTH[ci +% 2],
        x1: B128_ASINFAM_CTH[ci +% 3],
        x2: B128_ASINFAM_CTH[ci +% 4],
    )
    var sj = B128_ASINFAM_PTH[j]
    var sp = 43 -% (e >> 1)
    var sx0: U64 = 0
    var sx1: U64 = 0
    var sx2: U64 = 0
    if sp >= 0
        sj = sj << b128_asinfam_sh(n: sp)
        var m = b128_asinfam_mh3w(y: sj, x0: red.item0, x1: red.item1, x2: red.item2)
        sx0 = m.item0
        sx1 = m.item1
        sx2 = m.item2
    else
        var m = b128_asinfam_mh3w(y: sj, x0: red.item0, x1: red.item1, x2: red.item2)
        var rk = b128_asinfam_sh(n: 0 -% sp)
        var lk = b128_asinfam_sh(n: 64 +% sp)
        sx0 = (m.item0 >>> rk) | (m.item1 << lk)
        sx1 = (m.item1 >>> rk) | (m.item2 << lk)
        sx2 = m.item2 >>> rk
    var d = b128_asinfam_sub3(a0: p.item0, a1: p.item1, a2: p.item2, b0: sx0, b1: sx1, b2: sx2)
    nz = b128_asinfam_clz(x: d.item2)
    var l = b128_asinfam_sh(n: nz)
    var r = b128_asinfam_sh(n: 0 -% nz)
    var t = b128_asinfam_join(
        hi: (d.item2 << l) | (d.item1 >>> r),
        lo: (d.item1 << l) | (d.item0 >>> r),
    )
    var pi = j *% 5
    var sc = b128_asinfam_add3(
        a0: d.item0,
        a1: d.item1,
        a2: d.item2,
        b0: B128_ASIN_PHI0[pi +% 2],
        b1: B128_ASIN_PHI0[pi +% 3],
        b2: B128_ASIN_PHI0[pi +% 4],
    )
    var f = b128_asinfam_fast_poly(t: t, s2: 2 *% (nz -% 6))
    var sf = 3 *% nz
    var f2 = b128_asinfam_hi(u: f)
    var f1 = b128_asinfam_lo(u: f)
    var f0: U64 = 0
    if sf < 64
        f0 = f1 << b128_asinfam_sh(n: 0 -% sf)
        f1 = (f1 >>> b128_asinfam_sh(n: sf)) | (f2 << b128_asinfam_sh(n: 0 -% sf))
        f2 = f2 >>> b128_asinfam_sh(n: sf)
    elseif sf < 128
        var s1 = sf -% 64
        f0 = (f1 >>> b128_asinfam_sh(n: s1)) | (f2 << 1 << b128_asinfam_sh(n: s1 ^ -1))
        f1 = f2 >>> b128_asinfam_sh(n: s1)
        f2 = 0
    elseif sf < 192
        f0 = f2 >>> b128_asinfam_sh(n: sf -% 128)
        f1 = 0
        f2 = 0
    else
        f1 = 0
        f2 = 0
    var xc = b128_asinfam_add3(a0: sc.item0, a1: sc.item1, a2: sc.item2, b0: f0, b1: f1, b2: f2)
    var eps: U64 = 64
    if 3 *% nz -% 6 <= 57
        eps = 0x8000000000000000 >>> b128_asinfam_sh(n: 3 *% nz -% 6)
    # the top 128 bits of xc, normalized (asin |x| >= 0.022, so xc's top word is nonzero)
    var k = b128_asinfam_clz(x: xc.item2)
    var hi = xc.item2
    var mid = xc.item1
    var lo = xc.item0
    if k > 0
        hi = (hi << b128_asinfam_sh(n: k)) | (mid >>> b128_asinfam_sh(n: 64 -% k))
        mid = (mid << b128_asinfam_sh(n: k)) | (lo >>> b128_asinfam_sh(n: 64 -% k))
    var mm = b128_asinfam_join(hi: hi, lo: mid)
    # 4 eps and one unit of the dropped word (2^64 units at most), over xc >= 2^(191 - k)
    var err = (4.0 *! eps.to[B64]() +! 0x1p64) *! b128fx_p2(k: k -% 191) *! 2.0
    return (true, B128Fx(neg: neg, m: mm, e: -127 -% k, rel: err +! 0x1p-127))
