# ============================================================================
# Correctly rounded log-gamma function of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/lgamma/lgammaf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2025 Alexei Sibidanov. Distributed under the MIT license: see THIRD-PARTY-NOTICES.md at the
# repository root. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling is dropped, and `signgam` is not computed: this routine returns only the value).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

### Natural logarithm of the absolute value of the gamma function, correctly rounded: the exact
### `log|gamma(x)|` rounded to the nearest `B32` (ties to even), identical on every platform. Poles
### (0 and the negative integers) give +infinity, ±infinity gives +infinity, and NaN stays NaN.
### :returns: The correctly rounded `log|gamma(me)|`.
routine B32.lgamma() -> B32
    var fx = me.floor()
    var ax = me.abs()
    var tu = ax.to_bits()
    if tu >= 0x7F800000_u32
        if tu == 0x7F800000_u32
            return me *! me
        return me +! me
    if fx == me
        # an integer: a pole at 0 and the negative integers, and log(gamma) = 0 at 1 and 2
        if me <= 0.0_b32
            return B32.from_bits(bits: 0x7F800000_u32)
        if me == 1.0_b32 or me == 2.0_b32
            return 0.0_b32
    var z = B64(from: ax)
    var s = B64(from: me)
    var f = 0.0
    if ax < 0x1.52p-1_b32
        f = 0x1.0FC0FAD268C4Dp+2 *! s *! ((s +! 0x1.505BDF4B65ACp+4) *! (s +! 0x1.51C80EB47E068p+2) *! ((s -! 0x1.0000000007CB8p+0) *! (s +! 0x1.4AC529250A1FCp+1)) *! ((s +! 0x1.A8C99DBE1621Ap+0) *! (s +! 0x1.4ABDCC74115EAp+0) *! ((s +! 0x1.1B87FE5A5B923p+0) *! (s +! 0x1.05B8A4D47FF64p+0)))) /! ((s +! 0x1.4DB2CFE9A5265p+5) *! (s +! 0x1.062E99D1C4F27p+3) *! ((s +! 0x1.C81BC2ECF25F6p+1) *! (s +! 0x1.108E55C10091Bp+1)) *! ((s +! 0x1.7DD25AF0B83D4p+0) *! (s +! 0x1.36BF1880125FCp+0) *! ((s +! 0x1.1379FC8023D9Cp+0) *! (s +! 0x1.03712E41525D2p+0)))) -! b32_lgamma_ln(x: z)
    elseif ax > 0x1.AFC1Ap+1_b32
        if me >= 0x1.895F1Cp+121_b32
            return LLVM::fma[B32](a: me, b: 0x1.4D3398p+6_b32, c: 0x1.10F35Ep+103_b32)
        var lz = b32_lgamma_ln(x: z)
        # Stirling's series
        f = (z -! 0.5) *! (lz -! 1.0) +! 0x1.ACFE390C97D69p-2
        if ax < 0x1p+20_b32
            var iz = 1.0 /! z
            var iz2 = iz *! iz
            if ax > 1198.0_b32
                f = f +! iz *! 0x1.5555555555555p-4
            elseif ax > 0x1.279A7p+6_b32
                f = f +! iz *! (0x1.555555547FBADp-4 +! iz2 *! -0x1.6C0FD270C465p-9)
            elseif ax > 0x1.555556p+3_b32
                var iz4 = iz2 *! iz2
                f = f +! iz *! (0x1.555555554DE0Bp-4 +! iz2 *! -0x1.6C16BDC45944Fp-9 +! iz4 *! (0x1.A0077F300ECB3p-11 +! iz2 *! -0x1.2E9CFFF3B29C2p-11))
            else
                var iz4 = iz2 *! iz2
                var iz8 = iz4 *! iz4
                var p = 0x1.5555555551286p-4 +! iz2 *! -0x1.6C16C0E7C4CF4p-9 +! iz4 *! (0x1.A0193267FE6F2p-11 +! iz2 *! -0x1.37E87EC19CB45p-11) +! iz8 *! (0x1.B40011DFFF081p-11 +! iz2 *! -0x1.C16C8946B19B6p-10 +! iz4 *! (0x1.E9F47ACE150D8p-9 +! iz2 *! -0x1.4F5843A71A338p-8))
                f = f +! iz *! p
        if me < 0.0_b32
            # reflection: log|gamma(x)| = log(pi) - log|gamma(-x)| - log(-x) - log|sin(pi x)|
            f = 0x1.250D048E7A1BDp+0 -! f -! lz
            var lp = b32_lgamma_ln(x: b32_lgamma_sinpi(x: B64(from: me -! fx)))
            f = f -! lp
    else
        f = (z -! 1.0) *! (z -! 2.0) *! 0x1.3CC0E6A0106B3p+2 *! ((z +! 0x1.667923FF14DF7p+5) *! (z +! 0x1.2D35F25AD8F64p+3) *! ((z +! 0x1.B8C9EAB9D5BD3p+1) *! (z +! 0x1.7A4A97F494127p+0)) *! ((z +! 0x1.3A6C8295B4445p-1) *! (z +! 0x1.DA44E8B810024p-3) *! (z +! 0x1.9061E81C77E4Ap-5))) /! ((z +! 0x1.491A899E84C52p+6) *! (z +! 0x1.D202961B9E098p+3) *! ((z +! 0x1.4CED68C631ED6p+2) *! (z +! 0x1.2589EEDF40738p+1)) *! ((z +! 0x1.1302E3337271p+0) *! (z +! 0x1.C36B802F26DFFp-2) *! ((z +! 0x1.3DED448ACC39Dp-3) *! (z +! 0x1.BFFC491078EAFp-6))))
        if me < 0.0_b32
            if tu < 0x40301B93_u32 and tu > 0x402F95C2_u32
                # near the zero of lgamma at about -2.7476
                var h = s +! 0x1.5FB410A1BD901p+1 -! 0x1.A19A96D2E6F85p-54
                var hh = h *! h
                var h4 = hh *! hh
                f = h *! (-0x1.EA12DA904B18Cp+0 +! h *! 0x1.3267F3C265A54p+3 +! hh *! (-0x1.4185AC30CADB3p+4 +! h *! 0x1.F504ACCC3F2E4p+5) +! h4 *! (-0x1.8588444C679B4p+7 +! h *! 0x1.43740491DC22p+9 +! hh *! (-0x1.12400EA23F9E6p+11 +! h *! 0x1.DAC829F365795p+12)))
            elseif tu > 0x401CECCB_u32 and tu < 0x401D95CA_u32
                # near the zero of lgamma at about -2.4570
                var h = s +! 0x1.3A7FC9600F86Cp+1 +! 0x1.55F64F98AF8Dp-55
                var hh = h *! h
                var h4 = hh *! hh
                f = h *! (0x1.83FE966AF535Fp+0 +! h *! 0x1.36EEBB002F61Ap+2 +! hh *! (0x1.694A60589A0B3p+0 +! h *! 0x1.1718D7AEDB0B5p+3) +! h4 *! (0x1.733A045ECA0D3p+2 +! h *! 0x1.8D4297421205Bp+4 +! hh *! 0x1.7FEEA5FB29965p+4))
            elseif tu > 0x40492009_u32 and tu < 0x404940EF_u32
                # near the zero of lgamma at about -3.1435
                var h = s +! 0x1.9260DBC9E59AFp+1 +! 0x1.F717CD335A7B3p-53
                var hh = h *! h
                var h4 = hh *! hh
                f = h *! (0x1.F20A65F2FAC55p+2 +! h *! 0x1.9D4D297715105p+4 +! hh *! (0x1.C1137124D5B21p+6 +! h *! 0x1.267203D24DE38p+9) +! h4 *! (0x1.99A63399A0B44p+11 +! h *! 0x1.2941214FAAF0Cp+14 +! hh *! 0x1.BB912C0C9CDD1p+16))
            else
                f = 0x1.250D048E7A1BDp+0 -! f
                var lp = b32_lgamma_ln(x: b32_lgamma_sinpi(x: B64(from: me -! fx)) *! z)
                f = f -! lp
    var r = B32(from: f)
    if (f.to_bits() +% 5 & 0xFFFFFFF_u64) <= 31
        # possibly a hard-to-round case: look it up in the exception table
        var xb = me.to_bits()
        var k = 0_u64
        while k < 27
            if B32_LGAMMA_EXC_X[k] == xb
                return B32.from_bits(bits: B32_LGAMMA_EXC_F[k]) +! B32.from_bits(bits: B32_LGAMMA_EXC_DF[k])
            k = k + 1
    return r

### sin(pi*x) for the reflection formula, as an even polynomial in (x - 1/2) that vanishes at 0 and 1.
### :param x: The fractional part of the input, in [0, 1).
### :returns: sin(pi*x).
secret routine b32_lgamma_sinpi(x: B64) -> B64
    var y = x -! 0.5
    var x2 = y *! y
    var x4 = x2 *! x2
    var x8 = x4 *! x4
    return (0.25 -! x2) *! (0x1p+2 +! x2 *! -0x1.DE9E64DF22EA4p+1 +! x4 *! (0x1.472BE122401F8p+0 +! x2 *! -0x1.D4FCD82DF91Bp-3) +! x8 *! (0x1.9F05C97E0AAB2p-6 +! x2 *! -0x1.F3091C427B611p-10 +! x4 *! (0x1.B22C9BFDCA547p-14 +! x2 *! -0x1.15484325EF569p-18)))

### Natural logarithm of a positive normal B64, through a 16-entry reciprocal table.
### :param x: The argument (positive, finite, normal).
### :returns: log(x).
secret routine b32_lgamma_ln(x: B64) -> B64
    var tb = x.to_bits()
    var e = B64(from: LLVM::reinterpret_bits[U64, S64](tb >>> 52) - 0x3FF)
    var i = (tb >>> 48) & 0xF_u64
    var t = B64.from_bits(bits: tb & 0x000FFFFFFFFFFFFF_u64 | (0x3FF_u64 << 52))
    var z = B64.from_bits(bits: B32_LGAMMA_IX[i]) *! t -! 1.0
    var z2 = z *! z
    var z4 = z2 *! z2
    return e *! 0x1.62E42FEFA39EFp-1 +! B64.from_bits(bits: B32_LGAMMA_IL[i]) +! z *! (0x1.FFFFFFFFFFF24p-1 +! z *! -0x1.FFFFFFFFD1D67p-2 +! z2 *! (0x1.55555537802DEp-2 +! z *! -0x1.FFFFECA81B866p-3) +! z4 *! (0x1.999611761D772p-3 +! z *! -0x1.54F3E581B61BFp-3 +! z2 *! (0x1.1E642B4CB5143p-3 +! z *! -0x1.9115A5AF1E1EDp-4)))
