    -0x1.EAA70B2051E38p-42_b64, 0x1.0D287C5AA12B4p-97_b64, 0x1.4004294p-14_b64,
    0x1.602B04D79B0C8p-42_b64, 0x1.8D2C8DDF31648p-96_b64, 0x1.800A218p-14_b64,
    -0x1.0A2311217863p-42_b64, -0x1.C4652435118F1p-93_b64, 0x1.BFF9304p-14_b64,
    -0x1.385DC475C16Bp-43_b64, -0x1.E7288F74BBBDAp-96_b64, 0x1.FFFF81p-14_b64,
    0x1.355EDCFF4E19p-43_b64, 0x1.F8DAAE6C1DB11p-95_b64, 0x1.2002FF2p-13_b64,
    0x1.3FBB7CD36614p-45_b64, 0x1.93C0E5B4DCA92p-93_b64, 0x1.3FFAC9p-13_b64,
