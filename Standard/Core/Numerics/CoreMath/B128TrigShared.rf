# 1/(2k+2)! * 2^384 for k = 0..17: 1 - cos(t) = sum_k (-1)^k c_k (t^2)^(k+1); same layout as B128_TRIG_SIN_COEF.
secret preset B128_TRIG_COS_COEF: Array[U64, 108] = [
    0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
    0x8000000000000000, 0x0000000000000000, 0xAAAAAAAAAAAAAAAA, 0xAAAAAAAAAAAAAAAB,
