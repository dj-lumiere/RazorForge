# 10^n for 0 <= n <= 22 (the exactly representable powers of ten), then zeros up to 32 entries.
secret preset B64_LOG10_POW10: Array[B64, 32] = [
    0x1p+0_b64, 0x1.4p+3_b64, 0x1.9p+6_b64, 0x1.F4p+9_b64, 0x1.388p+13_b64, 0x1.86Ap+16_b64,
    0x1.E848p+19_b64, 0x1.312Dp+23_b64, 0x1.7D784p+26_b64, 0x1.DCD65p+29_b64, 0x1.2A05F2p+33_b64,
    0x1.74876E8p+36_b64, 0x1.D1A94A2p+39_b64, 0x1.2309CE54p+43_b64, 0x1.6BCC41E9p+46_b64,
    0x1.C6BF52634p+49_b64, 0x1.1C37937E08p+53_b64, 0x1.6345785D8Ap+56_b64, 0x1.BC16D674EC8p+59_b64,
    0x1.158E460913Dp+63_b64, 0x1.5AF1D78B58C4p+66_b64, 0x1.B1AE4D6E2EF5p+69_b64,
    0x1.0F0CF064DD592p+73_b64, 0.0_b64, 0.0_b64, 0.0_b64, 0.0_b64, 0.0_b64, 0.0_b64, 0.0_b64,
    0.0_b64, 0.0_b64,
]

# ============================================================================
# Correctly rounded base-10 logarithm of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/log10/log10.c and its dint.h (https://core-math.gitlabpages.inria.fr/).
# log10.c: Copyright (c) 2022-2025 INRIA and CERN. Authors: Paul Zimmermann and Tom Hubrecht.
# dint.h: Copyright (c) 2022 CERN. Author: Tom Hubrecht.
# Distributed under the MIT license: see THIRD-PARTY-NOTICES.md at the repository root. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its errno handling is dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.
# The accurate path reuses the dint helpers and tables of the natural-log port (B64Log.rf).

### Returns the base-10 logarithm with raw IEEE 754 propagation, correctly rounded: the exact base-10
### logarithm rounded to the nearest `B64` (ties to even), identical on every platform. `log10(±0)` is
### -infinity, `log10(+infinity)` is +infinity, a negative argument or NaN gives NaN, and `log10(10^n)`
### is exactly `n`.
### :returns: The correctly rounded base-10 logarithm.
routine B64.log10_unchecked() -> B64
    var x = me
    var u = x.to_bits()
    var e = LLVM::reinterpret_bits[U64, S64](u >>> 52) - 0x3FF
    # x <= 0, NaN, infinity or subnormal
    if e >= 0x400 or e == -0x3FF
        # +infinity or NaN (of either sign)
        if e == 0x400 or (e == 0xC00 and u != 0xFFF0000000000000_u64)
            return x +! x
        if x <= 0.0
            # negative: the default NaN of 0/0
            if x < 0.0
                return B64.from_bits(bits: 0xFFF8000000000000_u64)
            # ±0: pole
            return B64.from_bits(bits: 0xFFF0000000000000_u64)
        # subnormal: scale into the normal range
        u = (x *! 0x1p52).to_bits()
        e = LLVM::reinterpret_bits[U64, S64](u >>> 52) - 0x3FF - 52
    # x = 10^n for 0 <= n <= 22 gives exactly n: n is a guess from the exponent (32-bit wrapping arithmetic)
    var n = 0x267CFA2_u32 *% (LLVM::int_truncate[S64, U32](e) +% 1_u32) >>> 27
    if u == B64_LOG10_POW10[LLVM::zero_extend[U32, U64](n)].to_bits()
        return B64(from: n)
    var hl = b64_log10_fast(e: e, mbits: u & 0x000FFFFFFFFFFFFF_u64)
    # maximal absolute error of the fast path
    var err = 0x1.04p-69
    var left = hl.item0 +! (hl.item1 -! err)
    var right = hl.item0 +! (hl.item1 +! err)
    if left == right
        return left
    # the fast path fails with probability about 2^-11.5: compute log(x) in dint arithmetic and multiply
    # by 1/log(10)
    var y = b64_log_dint_log_of(x: x)
    y = b64_log_dint_mul(
        am: y.item0,
        aex: y.item1,
        asgn: y.item2,
        bm: b64_log_u128(hi: 0xDE5BD8A937287195_u64, lo: 0x355BAAAFAD33DC32_u64),
        bex: -2,
        bsgn: 0,
    )
    return b64_log_dint_to_b64(m: y.item0, ex: y.item1, sgn: y.item2)

### The fast path of `log10`: a double-double approximation of log10(2^e * m) with absolute error below
### 2^-68.98, where m = 1 + mbits/2^52.
### :param e: The binary exponent, -1074 <= e <= 1023.
### :param mbits: The 52 fraction bits of m.
### :returns: (h, l) with h + l approximating the base-10 logarithm.
secret routine b64_log10_fast(e: S64, mbits: U64) -> (B64, B64)
    var ee = e
    var em = 0x0010000000000000_u64 + mbits
    var y = B64.from_bits(bits: 0x3FF0000000000000_u64 + mbits)
    var i = em >>> 43
    # if m > sqrt(2), divide it by 2 to avoid cancellation: y lies in [1/sqrt(2), sqrt(2))
    if mbits >= 0x6A09E667F3BCD_u64
        ee = ee + 1
        y = B64.from_bits(bits: 0x3FE0000000000000_u64 + mbits)
        i = em >>> 44
    var k = i - 362
    var r = B64_LOG10_INVERSE[k]
    var l1 = B64_LOG10_LOG_INV[2_u64 * k]
    var l2 = B64_LOG10_LOG_INV[2_u64 * k + 1_u64]
    # exact
    var z = LLVM::fma[B64](a: r, b: y, c: -1.0)
    # P(z) - z, for |z| < 0.00212097167968735
    var z2 = z *! z
    var p45 = LLVM::fma[B64](a: -0x1.55362255E0F63p-3, b: z, c: 0x1.999A14758B084p-3)
    var p23 = LLVM::fma[B64](a: -0x1.0000000537DF6p-2, b: z, c: 0x1.555555554F4D8p-2)
    var ph = LLVM::fma[B64](a: p45, b: z2, c: p23)
    ph = LLVM::fma[B64](a: ph, b: z, c: -0x1.FFFFFFFFFFFFAp-2)
    ph = ph *! z2
    # add e*log(2): log2_h is an integer multiple of 2^-42, so e*log2_h + l1 is exact
    var eed = B64(from: ee)
    var hi = LLVM::fma[B64](a: eed, b: 0x1.62E42FEFA38p-1, c: l1)
    var h = hi +! z
    var lo = z -! (h -! hi)
    lo = ph +! (lo +! l2)
    lo = LLVM::fma[B64](a: eed, b: 0x1.EF35793C7673p-45, c: lo)
    # multiply by the double-double 1/log(10), neglecting the low*low term
    var ph10 = h *! 0x1.BCB7B1526E50Ep-2
    var s = LLVM::fma[B64](a: h, b: 0x1.BCB7B1526E50Ep-2, c: -ph10)
    var t = LLVM::fma[B64](a: lo, b: 0x1.BCB7B1526E50Ep-2, c: s)
    return (ph10, LLVM::fma[B64](a: h, b: 0x1.95355BAAAFAD3p-57, c: t))
