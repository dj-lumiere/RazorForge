### A U128 from its high and low words.
@inline
secret routine b128_expfam_w(hi: U64, lo: U64) -> U128
    return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

### The high word of a U128.
@inline
secret routine b128_expfam_hi(u: U128) -> U64
    return LLVM::int_truncate[U128, U64](u >>> 64)

### The low word of a U128.
@inline
secret routine b128_expfam_lo(u: U128) -> U64
    return LLVM::int_truncate[U128, U64](u)

### The full 128-bit product of two words.
@inline
secret routine b128_expfam_mul(a: U64, b: U64) -> U128
    return LLVM::zero_extend[U64, U128](a) *% LLVM::zero_extend[U64, U128](b)

### The high word of the product of two words.
@inline
secret routine b128_expfam_mhuu(a: U64, b: U64) -> U64
    return b128_expfam_hi(u: b128_expfam_mul(a: a, b: b))

### The approximate high half of a 128x128-bit product (the a0*b0 word and the carries out of the low
### words are dropped).
@inline
secret routine b128_expfam_mhuu128(a: U128, b: U128) -> U128
    var a0 = b128_expfam_lo(u: a)
    var a1 = b128_expfam_hi(u: a)
    var b0 = b128_expfam_lo(u: b)
    var b1 = b128_expfam_hi(u: b)
    var r = b128_expfam_mul(a: a1, b: b1)
    r = r +% LLVM::zero_extend[U64, U128](b128_expfam_mhuu(a: a1, b: b0))
    r = r +% LLVM::zero_extend[U64, U128](b128_expfam_mhuu(a: a0, b: b1))
    return r

### a*b/2^64 + c for a word a and 128-bit b and c, the low product word truncated.
@inline
secret routine b128_expfam_mahu128(a: U64, b: U128, c: U128) -> U128
    var s = c +% LLVM::zero_extend[U64, U128](b128_expfam_mhuu(a: a, b: b128_expfam_lo(u: b)))
    return b128_expfam_mul(a: a, b: b128_expfam_hi(u: b)) +% s

### Arithmetic (sign-propagating) right shift of a word by n (n < 64).
@inline
secret routine b128_expfam_sar(v: U64, n: U64) -> U64
    var s = LLVM::reinterpret_bits[U64, S64](v) >> LLVM::int_truncate[U64, U32](n)
    return LLVM::reinterpret_bits[S64, U64](s)

### Left shift of a word by n (n < 64).
@inline
secret routine b128_expfam_shl(v: U64, n: U64) -> U64
    return v << LLVM::int_truncate[U64, U32](n)

### Logical right shift of a word by n (n < 64).
@inline
secret routine b128_expfam_shr(v: U64, n: U64) -> U64
    return v >>> LLVM::int_truncate[U64, U32](n)

### The approximate high part of a 3-word by 2-word product: the words from position 2 up, with the a0*b0
### product and the low words of a0*b1 and a1*b0 dropped (a = a0 + a1*2^64 + a2*2^128).
@inline
secret routine b128_expfam_mh3x2(a0: U64, a1: U64, a2: U64, b: U128) -> (U64, U64, U64)
    var b0 = b128_expfam_lo(u: b)
    var b1 = b128_expfam_hi(u: b)
    var p01 = b128_expfam_mul(a: a0, b: b1)
    var p10 = b128_expfam_mul(a: a1, b: b0)
    var p11 = b128_expfam_mul(a: a1, b: b1)
    var p20 = b128_expfam_mul(a: a2, b: b0)
    var p21 = b128_expfam_mul(a: a2, b: b1)
    var col2 = LLVM::zero_extend[U64, U128](b128_expfam_lo(u: p11)) +% LLVM::zero_extend[U64, U128](b128_expfam_lo(u: p20))
    col2 = col2 +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: p01)) +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: p10))
    var col3 = (col2 >>> 64) +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: p11)) +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: p20))
    col3 = col3 +% LLVM::zero_extend[U64, U128](b128_expfam_lo(u: p21))
    var w2 = b128_expfam_hi(u: col3) +% b128_expfam_hi(u: p21)
    return (b128_expfam_lo(u: col2), b128_expfam_lo(u: col3), w2)

### Arithmetic right shift of the 3-word value (w0, w1, w2) by n bits (n < 192).
@inline
secret routine b128_expfam_ars3(w0: U64, w1: U64, w2: U64, n: U64) -> (U64, U64, U64)
    var sgn = b128_expfam_sar(v: w2, n: 63)
    var rk = n & 63
    var qk = n >>> 6
    if qk == 0
        if rk == 0
            return (w0, w1, w2)
        var lk = 64 -% rk
        return (
            b128_expfam_shl(v: w1, n: lk) | b128_expfam_shr(v: w0, n: rk),
            b128_expfam_shl(v: w2, n: lk) | b128_expfam_shr(v: w1, n: rk),
            b128_expfam_sar(v: w2, n: rk),
        )
    if qk == 1
        if rk == 0
            return (w1, w2, sgn)
        var lk1 = 64 -% rk
        return (
            b128_expfam_shl(v: w2, n: lk1) | b128_expfam_shr(v: w1, n: rk),
            b128_expfam_sar(v: w2, n: rk), sgn,
        )
    return (b128_expfam_sar(v: w2, n: rk), sgn, sgn)

### The fast evaluation of 2^v for the reduced argument (fs0, fs1, fs2) of b128_expfam_finish: the unbiased
### exponent el and the significand res in [2^123, 2^124), with 2^v = res * 2^(el - 123) to within 6 units of
### res (the rounding test of b128_expfam_finish relies on that bound).
@inline
secret routine b128_expfam_eval(fs0: U64, fs1: U64, fs2: U64) -> (S64, U128)
    var el = LLVM::reinterpret_bits[U64, S64](fs2) >> 20
    var i0 = (fs2 >>> 15) & 31
    var i1 = (fs2 >>> 10) & 31
    var i2 = (fs2 >>> 5) & 31
    var i3 = fs2 & 31
    var z = fs1
    # 2^(z * 2^-84) by a degree-5 polynomial, the top terms in single words
    var f0 = b128_expfam_mhuu(
        a: z,
        b: B128_EXPFAM_C2[6] +% b128_expfam_mhuu(
            a: z,
            b: B128_EXPFAM_C2[8] +% b128_expfam_mhuu(a: z, b: B128_EXPFAM_C2[10]),
        ),
    )
    var res = b128_expfam_w(
        hi: B128_EXPFAM_C2[5],
        lo: B128_EXPFAM_C2[4],
    ) +% LLVM::zero_extend[U64, U128](f0)
    res = b128_expfam_mahu128(
        a: z,
        b: res,
        c: b128_expfam_w(hi: B128_EXPFAM_C2[3], lo: B128_EXPFAM_C2[2]),
    )
    res = b128_expfam_mahu128(
        a: z,
        b: res,
        c: b128_expfam_w(hi: B128_EXPFAM_C2[1], lo: B128_EXPFAM_C2[0]),
    )
    # 2^(i0/2^5 + i1/2^10 + i2/2^15 + i3/2^20) from the four tables
    var t0 = b128_expfam_w(hi: B128_EXPFAM_R0[(i0 << 1) | 1], lo: B128_EXPFAM_R0[i0 << 1])
    var t1 = b128_expfam_w(hi: B128_EXPFAM_R1[(i1 << 1) | 1], lo: B128_EXPFAM_R1[i1 << 1])
    var t2 = b128_expfam_w(hi: B128_EXPFAM_R2[(i2 << 1) | 1], lo: B128_EXPFAM_R2[i2 << 1])
    var t3 = b128_expfam_w(hi: B128_EXPFAM_R3[(i3 << 1) | 1], lo: B128_EXPFAM_R3[i3 << 1])
    var m = b128_expfam_mhuu128(
        a: b128_expfam_mhuu128(a: t0, b: t1),
        b: b128_expfam_mhuu128(a: t2, b: t3),
    )
    # the lowest word of the reduced argument, times ln(2), as a first-order correction
    var k = b128_expfam_mhuu(a: 0xB17217F7D1CF79AC, b: fs0)
    m = m +% (b128_expfam_mul(a: b128_expfam_hi(u: m), b: k) >>> 84)
    res = b128_expfam_mhuu128(a: res, b: m)
    return (el, res)

### The words at positions p .. p+nout-1 of the product of the na-word a and the nb-word b, keeping every
### partial-product word at a position >= p (lower words and their carries are dropped).
secret routine b128_expfam_tmul(
    a: Array[U64, 8],
    na: U64,
    b: Array[U64, 8],
    nb: U64,
    p: U64,
    nout: U64,
) -> Array[U64, 8]
    var lo = Array[U64, 16]()
    var hi = Array[U64, 16]()
    var i: U64 = 0
    while i < na
        var j: U64 = 0
        while j < nb
            var pr = b128_expfam_mul(a: a[i], b: b[j])
            var pos = i + j
            if pos >= p and pos - p < nout
                var s = LLVM::zero_extend[U64, U128](lo[pos - p]) +% LLVM::zero_extend[U64, U128](b128_expfam_lo(u: pr))
                lo[pos - p] = b128_expfam_lo(u: s)
                hi[pos - p] = hi[pos - p] +% b128_expfam_hi(u: s)
            if pos + 1 >= p and pos + 1 - p < nout
                var s2 = LLVM::zero_extend[U64, U128](lo[pos + 1 - p]) +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: pr))
                lo[pos + 1 - p] = b128_expfam_lo(u: s2)
                hi[pos + 1 - p] = hi[pos + 1 - p] +% b128_expfam_hi(u: s2)
            j = j + 1
        i = i + 1
    var o = Array[U64, 8]()
    var carry: U128 = 0
    var q: U64 = 0
    while q < nout
        var v = LLVM::zero_extend[U64, U128](lo[q]) +% carry
        o[q] = b128_expfam_lo(u: v)
        carry = (v >>> 64) +% LLVM::zero_extend[U64, U128](hi[q])
        q = q + 1
    return o

### floor(a*b/2^64) + c modulo 2^(64n), for a word a and n-word b and c.
secret routine b128_expfam_mahu(a: U64, b: Array[U64, 8], c: Array[U64, 8], n: U64) -> Array[U64, 8]
    var o = Array[U64, 8]()
    var carry: U128 = 0
    var prev = b128_expfam_mul(a: a, b: b[0])
    var k: U64 = 0
    while k < n
        var nxt: U128 = 0
        if k + 1 < n
            nxt = b128_expfam_mul(a: a, b: b[k + 1])
        var acc = LLVM::zero_extend[U64, U128](b128_expfam_hi(u: prev)) +% LLVM::zero_extend[U64, U128](b128_expfam_lo(u: nxt))
        acc = acc +% LLVM::zero_extend[U64, U128](c[k]) +% carry
        o[k] = b128_expfam_lo(u: acc)
        carry = acc >>> 64
        prev = nxt
        k = k + 1
    return o

### Arithmetic right shift of the len-word value o by n bits (n < 64*len).
secret routine b128_expfam_ars(o: Array[U64, 8], len: U64, n: U64) -> Array[U64, 8]
    var r = o
    var rk = n & 63
    var qk = n >>> 6
    var h = o[len - 1]
    var j: U64 = 0
    while j + qk + 1 < len
        if rk == 0
            r[j] = o[j + qk]
        else
            r[j] = b128_expfam_shl(v: o[j + qk + 1], n: 64 - rk) | b128_expfam_shr(
                v: o[j + qk],
                n: rk,
            )
        j = j + 1
    r[len - 1 - qk] = b128_expfam_sar(v: h, n: rk)
    var sgn = b128_expfam_sar(v: h, n: 63)
    var t = len - qk
    while t < len
        r[t] = sgn
        t = t + 1
    return r

### Row `idx` of a flattened 3-word table: 0 = 2^(j/16), 1 = 2^(j/256), 2 = the accurate coefficients.
secret routine b128_expfam_row3(which: U64, idx: U64) -> Array[U64, 8]
    var o = Array[U64, 8]()
    var k: U64 = 0
    while k < 3
        if which == 0
            o[k] = B128_EXPFAM_TBL0[3 * idx + k]
        elseif which == 1
            o[k] = B128_EXPFAM_TBL1[3 * idx + k]
        else
            o[k] = B128_EXPFAM_C3[3 * idx + k]
        k = k + 1
    return o

### The fixed-point significand of x0 (with its implicit bit) times log2(base) in `len` words (4 or 7), the
### sign applied as a 1's complement after the product (exp, exp10) or a 2's complement (exp2), before the
### exponent shift.
secret routine b128_expfam_reduce_wide(x0: U128, kind: U64, len: U64) -> Array[U64, 8]
    var sm = b128_expfam_sar(v: b128_expfam_hi(u: x0), n: 63)
    var t = (x0 & 0x0000FFFFFFFFFFFFFFFFFFFFFFFFFFFF) | (1 << 112)
    var x = Array[U64, 8]()
    if kind == 1
        var smw = b128_expfam_w(hi: sm, lo: sm)
        t = (t ^ smw) -% smw
        x[len - 2] = b128_expfam_lo(u: t)
        x[len - 1] = b128_expfam_hi(u: t)
        return x
    var a = Array[U64, 8]()
    var k: U64 = 0
    while k < len
        if kind == 0
            a[k] = B128_EXPFAM_ILN2[7 - len + k]
        else
            a[k] = B128_EXPFAM_ILN102[7 - len + k]
        k = k + 1
    var b = Array[U64, 8]()
    b[0] = b128_expfam_lo(u: t)
    b[1] = b128_expfam_hi(u: t)
    x = b128_expfam_tmul(a: a, na: len, b: b, nb: 2, p: 2, nout: len)
    var q: U64 = 0
    while q < len
        x[q] = x[q] ^ sm
        q = q + 1
    return x

### The exponent shift of the wide reductions: 0x402e (exp), 0x402f (exp2) or 0x402d (exp10) minus the
### biased exponent of x0.
secret routine b128_expfam_wide_shift(x0: U128, kind: U64) -> U64
    var e = (b128_expfam_hi(u: x0) >>> 48) & 0x7FFF
    if kind == 0
        return 0x402E - e
    if kind == 1
        return 0x402F - e
    return 0x402D - e

### The accurate path's value of 2^x: the unbiased exponent el and the 192-bit significand f (three words, the
### low first) with 2^x = f * 2^(el - 188), f in [2^188, 2^189), within 8 units of f (the rounding test of
### b128_expfam_accurate relies on that bound).
secret routine b128_expfam_accurate_words(x0: U128, kind: U64) -> (S64, U64, U64, U64)
    var x = b128_expfam_reduce_wide(x0: x0, kind: kind, len: 4)
    x = b128_expfam_ars(o: x, len: 4, n: b128_expfam_wide_shift(x0: x0, kind: kind))
    var el = LLVM::reinterpret_bits[U64, S64](x[3])
    var jt0 = x[2] >>> 60
    var jt1 = (x[2] >>> 56) & 15
    x[2] = x[2] & 0x00FFFFFFFFFFFFFF
    var ft = b128_expfam_tmul(
        a: b128_expfam_row3(which: 0, idx: jt0),
        na: 3,
        b: b128_expfam_row3(which: 1, idx: jt1),
        nb: 3,
        p: 3,
        nout: 3,
    )
    # degree-14 polynomial in the top fraction word
    var f = b128_expfam_row3(which: 2, idx: 14)
    var i: U64 = 14
    while i > 0
        i = i - 1
        f = b128_expfam_mahu(a: x[2], b: f, c: b128_expfam_row3(which: 2, idx: i), n: 3)
    ft = b128_expfam_tmul(a: f, na: 3, b: ft, nb: 3, p: 3, nout: 3)
    # the two low fraction words, by a first-order correction
    var c1 = b128_expfam_w(hi: B128_EXPFAM_C3[5], lo: B128_EXPFAM_C3[4])
    var f2 = b128_expfam_mhuu128(
        a: b128_expfam_w(hi: x[1], lo: x[0]),
        b: c1 +% LLVM::zero_extend[U64, U128](b128_expfam_mhuu(a: B128_EXPFAM_C3[8], b: x[1])),
    )
    var f1 = Array[U64, 8]()
    f1[0] = b128_expfam_lo(u: f2)
    f1[1] = b128_expfam_hi(u: f2)
    f1[2] = B128_EXPFAM_C3[2]
    f = b128_expfam_tmul(a: ft, na: 3, b: f1, nb: 3, p: 3, nout: 3)
    return (el, f[0], f[1], f[2])
