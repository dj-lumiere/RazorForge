# ============================================================================
# Correctly rounded tangent of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/tan/tan.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2025 Paul Zimmermann and Tom Hubrecht. Distributed under the MIT license: see
# THIRD-PARTY-NOTICES.md at the repository root. RazorForge has no dynamic rounding modes, so only the round-to-nearest
# path of the original is kept (its errno handling is dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats. The argument
# reduction, the 128-bit "dint" arithmetic and the tables shared with the cosine are in B64TrigReduce.rf.

### Returns the tangent of this value, interpreting it as radians, correctly rounded: the exact tangent
### rounded to the nearest `B64` (ties to even), identical on every platform. `tan(-x) == -tan(x)`, ±0
### map to themselves, and ±infinity and NaN give NaN.
### :returns: The correctly rounded tangent.
routine B64.tan() -> B64
    var x = me
    var ux = x.to_bits()
    var e = (ux >>> 52) & 0x7FF_u64
    # NaN, +infinity and -infinity
    if e == 0x7FF
        if (ux << 1) == 0xFFE0000000000000_u64
            return x -! x
        return x +! x
    # |x| <= 0x1.d12ed0af1a27ep-27: tan(x) rounds like x + x^3/3
    if (ux & 0x7FFFFFFFFFFFFFFF_u64) <= 0x3E4D12ED0AF1A27E_u64
        if x == 0.0
            return x
        return LLVM::fma[B64](a: x, b: 0x1p-54, c: x)
    var f = b64_tan_fast(x: x)
    var h = f.item0
    var l = f.item1
    var err = f.item2
    var left = h +! (l -! err)
    var right = h +! (l +! err)
    if left == right
        return left
    return b64_tan_accurate(x: x)

### Double-double quotient `(bh + bl) / (ah + al)` with relative error below 2^-96.99, for |bl|, |al| <
### 2^-49.47 (Karp-Markstein).
### :param bh: The high part of the dividend.
### :param bl: The low part of the dividend.
### :param ah: The high part of the divisor.
### :param al: The low part of the divisor.
### :returns: `(h, l)`.
secret routine b64_tan_fast_div(bh: B64, bl: B64, ah: B64, al: B64) -> (B64, B64)
    var y = 1.0 /! ah
    var h = bh *! y
    var eh = LLVM::fma[B64](a: ah, b: -h, c: bh)
    var el = LLVM::fma[B64](a: al, b: -h, c: bl)
    return (h, y *! (eh +! el))

### The fast path of `tan`: returns `(h, l, err)` with |h + l - tan(x)| < |err|.
### :param x: The argument, finite with |x| > 0x1.d12ed0af1a27ep-27.
### :returns: `(h, l, err)`.
secret routine b64_tan_fast(x: B64) -> (B64, B64, B64)
    var neg = 0_u64
    if x < 0.0
        neg = 1_u64
    var red = b64_trig_reduce_fast(x: x.abs(), with_t2: true)
    var i = red.item0
    var h = red.item1
    var l = red.item2
    # i >= 2^10: pi <= x <= 2pi, tan(pi + x) = tan(x)
    i = i & 0x3FF_u64
    # i >= 2^9: pi/2 <= x <= pi, tan(pi/2 + x) = -cot(x)
    var is_tan = 1_u64 ^ (i >>> 9)
    neg = neg ^ (i >>> 9)
    i = i & 0x1FF_u64
    # i >= 2^8: tan(pi/2 - x) = cot(x), and 2^-11 - h is exact
    if (i & 0x100_u64) != 0
        is_tan = is_tan ^ 1
        i = 0x1FF_u64 - i
        h = 0x1p-11 -! h
        l = -l
    # a tiny reduced argument is deferred to the accurate path
    if i == 0 and h < 0x1p-37
        return (h, l, 0x1p0)
    # the SC table is evaluated at i/2^11 + SC[i][0], and h - SC[i][0] is exact
    h = h -! B64_TRIG_SC[3 * i]
    var hl = b64_trig_fast_two_sum(a: h, b: l)
    h = hl.item0
    l = hl.item1
    var u = b64_trig_a_mul(a: h, b: h)
    var uh = u.item0
    var ul = LLVM::fma[B64](a: h +! h, b: l, c: u.item1)
    var ps = b64_trig_eval_ps_fast(xh: h, xl: l, uh: uh, ul: ul)
    var pc = b64_trig_eval_pc_fast(uh: uh, ul: ul)
    # h1 + l1 ~ sin2pi(R)
    var s0 = b64_trig_s_mul(a: B64_TRIG_SC[3 * i + 2], bh: ps.item0, bl: ps.item1)
    var c0 = b64_trig_s_mul(a: B64_TRIG_SC[3 * i + 1], bh: pc.item0, bl: pc.item1)
    var t1 = b64_trig_fast_two_sum(a: c0.item0, b: s0.item0)
    var h1 = t1.item0
    var l1 = t1.item1 +! (s0.item1 +! c0.item1)
    # h2 + l2 ~ cos2pi(R)
    var c2 = b64_trig_s_mul(a: B64_TRIG_SC[3 * i + 2], bh: pc.item0, bl: pc.item1)
    var s2 = b64_trig_s_mul(a: B64_TRIG_SC[3 * i + 1], bh: ps.item0, bl: ps.item1)
    var t2 = b64_trig_fast_two_sum(a: c2.item0, b: -s2.item0)
    var h2 = t2.item0
    var l2 = t2.item1 +! (c2.item1 -! s2.item1)
    var q = b64_tan_fast_div(bh: h2, bl: l2, ah: h1, al: l1)
    if is_tan != 0
        q = b64_tan_fast_div(bh: h1, bl: l1, ah: h2, al: l2)
    h = q.item0
    l = q.item1
    if neg != 0
        h = -h
        l = -l
    return (h, l, h *! 0x1.1Ap-66)

### Approximates 1/a for a non-zero dint, with relative error below 2^-124.999: a 64-bit table seed,
### three integer Newton steps, then one dint Newton step.
### :param a: The dint.
### :returns: 1/a.
secret routine b64_tan_inv_dint(a: (U128, S64, U64)) -> (U128, S64, U64)
    var h = b64_trig_hi(r: a.item0)
    var t = B64_TAN_TINV[(h >>> 55) & 0xFF_u64]
    var two127 = LLVM::zero_extend[U64, U128](1_u64) << 127
    var e = two127 -% b64_trig_mul64(a: h, b: t)
    e = LLVM::zero_extend[U64, U128](t) *% (e >>> 55)
    t = t +% b64_trig_lo(r: e >>> 72)
    e = two127 -% b64_trig_mul64(a: h, b: t)
    e = LLVM::zero_extend[U64, U128](t) *% (e >>> 47)
    t = t +% b64_trig_lo(r: e >>> 80)
    e = two127 -% b64_trig_mul64(a: h, b: t)
    e = LLVM::zero_extend[U64, U128](t) *% (e >>> 31)
    t = t +% b64_trig_lo(r: e >>> 96)
    # Newton's iteration r -> r + r(1 - a r)
    var r = (b64_trig_u128(hi: t, lo: 0_u64), 1 - a.item1, 1_u64)
    var q = b64_trig_dint_mul21(a: a, b: r)
    r = (r.item0, r.item1, 0_u64)
    q = b64_trig_dint_add(
        a0: b64_trig_dint(hi: 0x8000000000000000_u64, lo: 0_u64, ex: 1_s64, sgn: 0_u64),
        b0: q,
    )
    q = b64_trig_dint_mul(a: r, b: q)
    return b64_trig_dint_add(a0: r, b0: q)

### The accurate path of `tan`, in 128-bit floating-point arithmetic.
### :param x: The argument, finite with |x| > 0x1.d12ed0af1a27ep-27.
### :returns: The correctly rounded tangent.
secret routine b64_tan_accurate(x: B64) -> B64
    var red = b64_trig_accurate_reduce(ax: x.abs())
    var i = red.item0
    var quadrant = red.item1
    var u = red.item3
    var v = red.item4
    var neg = 0_u64
    if x < 0.0
        neg = 1_u64
    # pi <= x < 2pi: tan(x) = tan(x - pi), and pi/2 <= x < pi: tan(x) = -1/tan(x - pi/2)
    var is_tan = 1_u64
    if (quadrant & 2_u64) != 0
        is_tan = 0_u64
        neg = neg ^ 1
    # pi/4 <= x < pi/2: tan(x) = 1/tan(pi/2 - x)
    if (quadrant & 4_u64) != 0
        is_tan = is_tan ^ 1
    # sin2pi(R) ~ sin2pi(i/2^11) cos2pi(X) + cos2pi(i/2^11) sin2pi(X)
    var sn = b64_trig_dint_add(
        a0: b64_trig_dint_mul(a: b64_trig_s(i: i), b: u),
        b0: b64_trig_dint_mul(a: b64_trig_c(i: i), b: v),
    )
    # cos2pi(R) ~ cos2pi(i/2^11) cos2pi(X) - sin2pi(i/2^11) sin2pi(X)
    var vv = b64_trig_dint_mul(a: b64_trig_s(i: i), b: v)
    var cs = b64_trig_dint_add(
        a0: b64_trig_dint_mul(a: b64_trig_c(i: i), b: u),
        b0: (vv.item0, vv.item1, 1_u64 - vv.item2),
    )
    var num = cs
    var den = sn
    if is_tan != 0
        num = sn
        den = cs
    var y = b64_trig_dint_mul(a: b64_tan_inv_dint(a: den), b: num)
    # the total error is below 86 ulps of the low word: check the upper 54 bits are determined
    var err = LLVM::zero_extend[U64, U128](86_u64)
    var hi0 = b64_trig_hi(r: y.item0 -% err)
    var hi1 = b64_trig_hi(r: y.item0 +% err)
    if (hi0 >>> 10) != (hi1 >>> 10)
        var ax = x.abs()
        if ax == 0x1.DFFFFFFFFFF1Fp-22
            if x > 0.0
                return 0x1.E000000000151p-22 +! 0x1.FFFFFFFFFFFFFp-76
            return -0x1.E000000000151p-22 -! 0x1.FFFFFFFFFFFFFp-76
        if ax == 0x1.DFFFFFFFFFC7Cp-21
            if x > 0.0
                return 0x1.E000000000546p-21 +! -0x1.658BCEDB6E1D4p-147
            return -0x1.E000000000546p-21 -! -0x1.658BCEDB6E1D4p-147
    if neg != 0
        y = (y.item0, y.item1, 1_u64 - y.item2)
    return b64_trig_dint_tod(a: y)
