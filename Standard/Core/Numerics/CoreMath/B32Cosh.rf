module Core

### Table of 2^(i/32)/2 for i in 0..31, as B64 bit patterns.
secret preset B32_COSH_TB: Array[U64, 32] = [
    0x3FE0000000000000_u64, 0x3FE059B0D3158574_u64, 0x3FE0B5586CF9890F_u64, 0x3FE11301D0125B51_u64,
    0x3FE172B83C7D517B_u64, 0x3FE1D4873168B9AA_u64, 0x3FE2387A6E756238_u64, 0x3FE29E9DF51FDEE1_u64,
    0x3FE306FE0A31B715_u64, 0x3FE371A7373AA9CB_u64, 0x3FE3DEA64C123422_u64, 0x3FE44E086061892D_u64,
    0x3FE4BFDAD5362A27_u64, 0x3FE5342B569D4F82_u64, 0x3FE5AB07DD485429_u64, 0x3FE6247EB03A5585_u64,
    0x3FE6A09E667F3BCD_u64, 0x3FE71F75E8EC5F74_u64, 0x3FE7A11473EB0187_u64, 0x3FE82589994CCE13_u64,
    0x3FE8ACE5422AA0DB_u64, 0x3FE93737B0CDC5E5_u64, 0x3FE9C49182A3F090_u64, 0x3FEA5503B23E255D_u64,
    0x3FEAE89F995AD3AD_u64, 0x3FEB7F76F2FB5E47_u64, 0x3FEC199BDD85529C_u64, 0x3FECB720DCEF9069_u64,
    0x3FED5818DCFBA487_u64, 0x3FEDFC97337B9B5F_u64, 0x3FEEA4AFA2A490DA_u64, 0x3FEF50765B6E4540_u64,
]

# ============================================================================
# Correctly rounded hyperbolic cosine of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/cosh/coshf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2023 Alexei Sibidanov. Distributed under the MIT license: see THIRD-PARTY-NOTICES.md at the
# repository root. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling is dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

### Hyperbolic cosine, correctly rounded: the exact cosh rounded to the nearest `B32` (ties to even),
### identical on every platform. Raw IEEE 754 propagation: overflow gives +infinity, NaN stays NaN.
### :returns: The correctly rounded hyperbolic cosine.
routine B32.cosh_unchecked() -> B32
    var ax = me.to_bits() << 1
    if ax > 0x8565A9F8_u32
        # |x| > ~89.4: NaN, ±infinity, or overflow
        if ax >= 0xFF000000_u32
            return me *! me
        return 2.0_b32 *! 0x1.FFFFFEp127_b32
    if ax < 0x7C000000_u32
        # |x| < 0.125
        if ax < 0x74000000_u32
            # |x| < 0x1p-11
            if ax < 0x66000000_u32
                return LLVM::fma[B32](a: me.abs(), b: 0x1p-25_b32, c: 1.0_b32)
            return 0.5_b32 *! me *! me +! 1.0_b32
        var z = B64(from: me)
        var z2 = z *! z
        var z4 = z2 *! z2
        var p = 0x1.FFFFFFFFFFFE3p-2 +! z2 *! 0x1.55555555723CFp-5 +! z4 *! (0x1.6C16BEE4A5986p-10 +! z2 *! 0x1.A0483FC0328F7p-16)
        return B32(from: 1.0 +! z2 *! p)
    return b32_cosh_main(z: B64(from: me))

### Returns 2^(k/32)/2 for k = ±ia, where ia is an integer held in a B64.
### :param ia: The integer nearest to 32*x/ln(2), as a B64.
### :param minus: When true, uses k = -ia instead of ia.
### :returns: 2^(k/32)/2.
secret routine b32_cosh_scale(ia: B64, minus: Bool) -> B64
    var jp = LLVM::reinterpret_bits[U64, S64]((ia +! 0x1.8p52).to_bits())
    if minus
        jp = -jp
    var index = LLVM::reinterpret_bits[S64, U64](jp & 31)
    return B64.from_bits(bits: B32_COSH_TB[index] +% (LLVM::reinterpret_bits[S64, U64](jp >> 5) << 52))

### The main path, for 0.125 <= |x| and no overflow: combines e^x and e^-x from a 2^(k/32) table.
### :param z: The input, widened to B64.
### :returns: The correctly rounded result.
secret routine b32_cosh_main(z: B64) -> B32
    var a = 0x1.71547652B82FEp+5 *! z
    var ia = LLVM::rint[B64](value: a)
    var h = a -! ia
    var h2 = h *! h
    var sp = b32_cosh_scale(ia: ia, minus: false)
    var sm = b32_cosh_scale(ia: ia, minus: true)
    var tev = 1.0 +! h2 *! 0x1.EBFD1B232F475p-13
    var tod = 0x1.62E42FEF4C4E7p-6 +! h2 *! 0x1.C6B19384ECD93p-20
    var rp = sp *! (tev +! h *! tod)
    var rm = sm *! (tev -! h *! tod)
    var r = rp +! rm
    var ub = B32(from: r)
    var lb = B32(from: r -! 0x1.3EDBBE4560327p-33 *! r)
    if ub != lb
        # too close to a rounding boundary: redo with a split 32/ln(2) and a longer polynomial
        h = 0x1.7154765p+5 *! z -! ia +! 0x1.5C17F0BBBE88p-26 *! z
        h2 = h *! h
        tev = 1.0 +! h2 *! 0x1.EBFBDFF82C58Fp-13 +! h2 *! h2 *! (0x1.3B2AB6FB92E5Ep-27 +! h2 *! 0x1.430976B8CE6EFp-43)
        tod = 0x1.62E42FEFA39EFp-6 +! h2 *! (0x1.C6B08D702E0EDp-20 +! h2 *! 0x1.5D886E6D54203p-35)
        r = sp *! (tev +! h *! tod) +! sm *! (tev -! h *! tod)
        ub = B32(from: r)
    return ub
