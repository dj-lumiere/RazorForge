module Core

# Roots of the numerator of the rational approximation for |x| < 0x1.52p-1 (bit patterns).
secret preset B16_LGAMMA_RN_SMALL: Array[U64, 8] = [
    0xC03505BDF4B65AC0_u64, 0xC0151C80EB47E068_u64, 0x3FF0000000007CB8_u64, 0xC004AC529250A1FC_u64,
    0xBFFA8C99DBE1621A_u64, 0xBFF4ABDCC74115EA_u64, 0xBFF1B87FE5A5B923_u64, 0xBFF05B8A4D47FF64_u64,
]
# Roots of its denominator (bit patterns).
secret preset B16_LGAMMA_RD_SMALL: Array[U64, 8] = [
    0xC044DB2CFE9A5265_u64, 0xC02062E99D1C4F27_u64, 0xC00C81BC2ECF25F6_u64, 0xC00108E55C10091B_u64,
    0xBFF7DD25AF0B83D4_u64, 0xBFF36BF1880125FC_u64, 0xBFF1379FC8023D9C_u64, 0xBFF03712E41525D2_u64,
]
# Roots of the numerator of the rational approximation for 0x1.52p-1 <= |x| <= 0x1.afc1ap+1 (bit patterns).
secret preset B16_LGAMMA_RN_MID: Array[U64, 7] = [
    0xC04667923FF14DF7_u64, 0xC022D35F25AD8F64_u64, 0xC00B8C9EAB9D5BD3_u64, 0xBFF7A4A97F494127_u64,
    0xBFE3A6C8295B4445_u64, 0xBFCDA44E8B810024_u64, 0xBFA9061E81C77E4A_u64,
]
# Roots of its denominator (bit patterns).
secret preset B16_LGAMMA_RD_MID: Array[U64, 8] = [
    0xC05491A899E84C52_u64, 0xC02D202961B9E098_u64, 0xC014CED68C631ED6_u64, 0xC002589EEDF40738_u64,
    0xBFF1302E33372710_u64, 0xBFDC36B802F26DFF_u64, 0xBFC3DED448ACC39D_u64, 0xBF9BFFC491078EAF_u64,
]
# log(1/ix[i]) for the logarithm's 16-entry table reduction (bit patterns).
secret preset B16_LGAMMA_LN_IL: Array[U64, 16] = [
    0x3C659CAEEC280116_u64, 0x3FAF0A30C01162AA_u64, 0x3FBE27076E2AF2EB_u64, 0x3FC5FF3070A793D6_u64,
    0x3FCC8FF7C79A9A20_u64, 0x3FD1675CABABA60F_u64, 0x3FD4618BC21C5EC2_u64, 0x3FD739D7F6BBD007_u64,
    0x3FD9F323ECBF984D_u64, 0x3FDC8FF7C79A9A21_u64, 0x3FDF128F5FAF06EC_u64, 0x3FE0BE72E4252A83_u64,
    0x3FE1E85F5E7040D1_u64, 0x3FE307D7334F10BE_u64, 0x3FE41D8FE84672AF_u64, 0x3FE52A2D265BC5AB_u64,
]
# Approximations of 1/(1 + i/16 + 1/32) for the logarithm's table reduction (bit patterns).
secret preset B16_LGAMMA_LN_IX: Array[U64, 16] = [
    0x3FF0000000000000_u64, 0x3FEE1E1E1E1E1E1E_u64, 0x3FEC71C71C71C71C_u64, 0x3FEAF286BCA1AF28_u64,
    0x3FE999999999999A_u64, 0x3FE8618618618618_u64, 0x3FE745D1745D1746_u64, 0x3FE642C8590B2164_u64,
    0x3FE5555555555555_u64, 0x3FE47AE147AE147B_u64, 0x3FE3B13B13B13B14_u64, 0x3FE2F684BDA12F68_u64,
    0x3FE2492492492492_u64, 0x3FE1A7B9611A7B96_u64, 0x3FE1111111111111_u64, 0x3FE0842108421084_u64,
]

# ============================================================================
# Correctly rounded log-gamma of B16
# ============================================================================
# Ported from CORE-MATH, src/binary16/lgamma/lgammaf16.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2025 Alexei Sibidanov and Paul Zimmermann. Distributed under the MIT license: see
# THIRD-PARTY-NOTICES.md at the repository root. RazorForge has no dynamic rounding modes, so only the
# round-to-nearest path of the original is kept. The original also sets the C global `signgam` (the sign
# of gamma(x)); this routine returns only the value. Arithmetic uses the unchecked operators
# `+! -! *! /!`, which are raw IEEE 754 on floats.

### Natural logarithm of the absolute value of gamma(x), correctly rounded: the exact log|gamma(x)|
### rounded to the nearest `B16` (ties to even), identical on every platform. Poles (zero and the
### negative integers) and ±infinity give +infinity, NaN gives NaN.
### :returns: The correctly rounded log-gamma.
routine B16.lgamma() -> B16
    var x = B32(from: me)
    var fx = LLVM::floor[B32](x)
    var ax = x.abs()
    var tu = ax.to_bits()
    if tu >= 0x7F800000_u32
        if tu == 0x7F800000_u32
            return B16.from_bits(bits: 0x7C00_u16)
        return B16(from: x +! x)
    if fx == x
        # an integer: a pole at zero and the negative integers, and exact zeros at 1 and 2
        if x <= 0.0_b32
            return B16.from_bits(bits: 0x7C00_u16)
        if x == 1.0_b32 or x == 2.0_b32
            return 0.0_b16
    var s = B64(from: x)
    var z = B64(from: ax)
    var f = 0.0
    if ax < 0x1.52p-1_b32
        # a rational approximation of lgamma(x) + log|x| near zero
        var c0 = 0x1.0FC0FAD268C4Dp+2
        f = c0 *! s *! b16_lgamma_r8(x: s, roots: B16_LGAMMA_RN_SMALL) /! b16_lgamma_r8(
            x: s,
            roots: B16_LGAMMA_RD_SMALL,
        ) -! b16_lgamma_ln(x: z)
    else
        if ax > 0x1.AFC1Ap+1_b32
            if x >= 0x1.FF4p+12_b32
                # lgamma(0x1.ff4p+12) rounds to the largest finite B16, larger inputs overflow
                if x > 0x1.FF4p+12_b32
                    return B16.from_bits(bits: 0x7C00_u16)
                return B16.from_bits(bits: 0x7BFF_u16)
            # Stirling's series
            var lz = b16_lgamma_ln(x: z)
            f = (z -! 0.5) *! (lz -! 1.0) +! 0x1.ACFE390C97D69p-2
            var iz = 1.0 /! z
            var iz2 = iz *! iz
            if ax > 1198.0_b32
                f = f +! iz *! 0x1.5555555555555p-4
            else
                if ax > 0x1.279A7p+6_b32
                    f = f +! iz *! (0x1.555555547FBADp-4 +! iz2 *! -0x1.6C0FD270C465p-9)
                else
                    if ax > 0x1.555556p+3_b32
                        var iz4 = iz2 *! iz2
                        f = f +! iz *! (0x1.555555554DE0Bp-4 +! iz2 *! -0x1.6C16BDC45944Fp-9 +! iz4 *! (0x1.A0077F300ECB3p-11 +! iz2 *! -0x1.2E9CFFF3B29C2p-11))
                    else
                        var iz4 = iz2 *! iz2
                        var iz8 = iz4 *! iz4
                        var p = 0x1.5555555551286p-4 +! iz2 *! -0x1.6C16C0E7C4CF4p-9 +! iz4 *! (0x1.A0193267FE6F2p-11 +! iz2 *! -0x1.37E87EC19CB45p-11) +! iz8 *! (0x1.B40011DFFF081p-11 +! iz2 *! -0x1.C16C8946B19B6p-10 +! iz4 *! (0x1.E9F47ACE150D8p-9 +! iz2 *! -0x1.4F5843A71A338p-8))
                        f = f +! iz *! p
            if x < 0.0_b32
                # the reflection formula lgamma(x) = log(pi) - lgamma(-x) - log|x sin(pi x)|
                f = 0x1.250D048E7A1BDp+0 -! f -! lz
                var lp = b16_lgamma_ln(x: b16_lgamma_sinpi(x: B64(from: x -! fx)))
                f = f -! lp
        else
            # a rational approximation with exact zeros at 1 and 2
            var c0 = 0x1.3CC0E6A0106B3p+2
            f = (z -! 1.0) *! (z -! 2.0) *! c0 *! b16_lgamma_r7(x: z) /! b16_lgamma_r8(
                x: z,
                roots: B16_LGAMMA_RD_MID,
            )
            if x < 0.0_b32
                if tu < 0x40301B93_u32 and tu > 0x402F95C2_u32
                    # near the zero of lgamma at -0x1.5fb410a1bd901p+1
                    var h = s +! 0x1.5FB410A1BD901p+1 -! 0x1.A19A96D2E6F85p-54
                    var h2 = h *! h
                    var h4 = h2 *! h2
                    f = h *! (-0x1.EA12DA904B18Cp+0 +! h *! 0x1.3267F3C265A54p+3 +! h2 *! (-0x1.4185AC30CADB3p+4 +! h *! 0x1.F504ACCC3F2E4p+5) +! h4 *! (-0x1.8588444C679B4p+7 +! h *! 0x1.43740491DC22p+9 +! h2 *! (-0x1.12400EA23F9E6p+11 +! h *! 0x1.DAC829F365795p+12)))
                else
                    if tu > 0x401CECCB_u32 and tu < 0x401D95CA_u32
                        # near the zero of lgamma at -0x1.3a7fc9600f86cp+1
                        var h = s +! 0x1.3A7FC9600F86Cp+1 +! 0x1.55F64F98AF8Dp-55
                        var h2 = h *! h
                        var h4 = h2 *! h2
                        f = h *! (0x1.83FE966AF535Fp+0 +! h *! 0x1.36EEBB002F61Ap+2 +! h2 *! (0x1.694A60589A0B3p+0 +! h *! 0x1.1718D7AEDB0B5p+3) +! h4 *! (0x1.733A045ECA0D3p+2 +! h *! 0x1.8D4297421205Bp+4 +! h2 *! 0x1.7FEEA5FB29965p+4))
                    else
                        if tu > 0x40492009_u32 and tu < 0x404940EF_u32
                            # near the zero of lgamma at -0x1.9260dbc9e59afp+1
                            var h = s +! 0x1.9260DBC9E59AFp+1 +! 0x1.F717CD335A7B3p-53
                            var h2 = h *! h
                            var h4 = h2 *! h2
                            f = h *! (0x1.F20A65F2FAC55p+2 +! h *! 0x1.9D4D297715105p+4 +! h2 *! (0x1.C1137124D5B21p+6 +! h *! 0x1.267203D24DE38p+9) +! h4 *! (0x1.99A63399A0B44p+11 +! h *! 0x1.2941214FAAF0Cp+14 +! h2 *! 0x1.BB912C0C9CDD1p+16))
                        else
                            f = 0x1.250D048E7A1BDp+0 -! f
                            var lp = b16_lgamma_ln(x: b16_lgamma_sinpi(x: B64(from: x -! fx)) *! z)
                            f = f -! lp
    return B16(from: f)

### The product `(x - r0)(x - r1)...(x - r6)` over the 7 numerator roots of the mid-range rational
### approximation, grouped as in the original.
### :param x: The evaluation point.
### :returns: The product.
secret routine b16_lgamma_r7(x: B64) -> B64
    var c0 = B64.from_bits(bits: B16_LGAMMA_RN_MID[0])
    var c1 = B64.from_bits(bits: B16_LGAMMA_RN_MID[1])
    var c2 = B64.from_bits(bits: B16_LGAMMA_RN_MID[2])
    var c3 = B64.from_bits(bits: B16_LGAMMA_RN_MID[3])
    var c4 = B64.from_bits(bits: B16_LGAMMA_RN_MID[4])
    var c5 = B64.from_bits(bits: B16_LGAMMA_RN_MID[5])
    var c6 = B64.from_bits(bits: B16_LGAMMA_RN_MID[6])
    return (x -! c0) *! (x -! c1) *! ((x -! c2) *! (x -! c3)) *! ((x -! c4) *! (x -! c5) *! (x -! c6))

### The product `(x - r0)(x - r1)...(x - r7)` over 8 roots, grouped as in the original.
### :param x: The evaluation point.
### :param roots: The 8 roots as binary64 bit patterns.
### :returns: The product.
secret routine b16_lgamma_r8(x: B64, roots: Array[U64, 8]) -> B64
    var c0 = B64.from_bits(bits: roots[0])
    var c1 = B64.from_bits(bits: roots[1])
    var c2 = B64.from_bits(bits: roots[2])
    var c3 = B64.from_bits(bits: roots[3])
    var c4 = B64.from_bits(bits: roots[4])
    var c5 = B64.from_bits(bits: roots[5])
    var c6 = B64.from_bits(bits: roots[6])
    var c7 = B64.from_bits(bits: roots[7])
    return (x -! c0) *! (x -! c1) *! ((x -! c2) *! (x -! c3)) *! ((x -! c4) *! (x -! c5) *! ((x -! c6) *! (x -! c7)))

### An approximation of `sin(pi x)` for `0 <= x <= 1`.
### :param x: The fractional argument.
### :returns: sin(pi x).
secret routine b16_lgamma_sinpi(x: B64) -> B64
    var y = x -! 0.5
    var x2 = y *! y
    var x4 = x2 *! x2
    var x8 = x4 *! x4
    return (0.25 -! x2) *! (0x1p+2 +! x2 *! -0x1.DE9E64DF22EA4p+1 +! x4 *! (0x1.472BE122401F8p+0 +! x2 *! -0x1.D4FCD82DF91Bp-3) +! x8 *! (0x1.9F05C97E0AAB2p-6 +! x2 *! -0x1.F3091C427B611p-10 +! x4 *! (0x1.B22C9BFDCA547p-14 +! x2 *! -0x1.15484325EF569p-18)))

### An approximation of the natural logarithm of a positive normal binary64.
### :param x: The argument.
### :returns: log(x).
secret routine b16_lgamma_ln(x: B64) -> B64
    var tu = x.to_bits()
    var e = LLVM::reinterpret_bits[U64, S64](tu >>> 52) - 0x3FF
    var i = (tu >>> 48) & 0xF_u64
    var m = B64.from_bits(bits: tu & 0x000FFFFFFFFFFFFF_u64 | 0x3FF0000000000000_u64)
    var z = B64.from_bits(bits: B16_LGAMMA_LN_IX[i]) *! m -! 1.0
    var z2 = z *! z
    var z4 = z2 *! z2
    var p = 0x1.FFFFFFFFFFF24p-1 +! z *! -0x1.FFFFFFFFD1D67p-2 +! z2 *! (0x1.55555537802DEp-2 +! z *! -0x1.FFFFECA81B866p-3) +! z4 *! (0x1.999611761D772p-3 +! z *! -0x1.54F3E581B61BFp-3 +! z2 *! (0x1.1E642B4CB5143p-3 +! z *! -0x1.9115A5AF1E1EDp-4))
    return B64(from: e) *! 0x1.62E42FEFA39EFp-1 +! B64.from_bits(bits: B16_LGAMMA_LN_IL[i]) +! z *! p
