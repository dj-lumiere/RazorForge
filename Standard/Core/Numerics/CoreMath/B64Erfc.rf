# ============================================================================
# The fast phase of CORE-MATH's complementary error function of B64
# ============================================================================
# B64.erfc itself is Tessera's, through Ingrid. This file keeps the fast phase the D64 transcendentals
# (D64Trans.rf) build on.
# Ported from CORE-MATH, src/binary64/erfc/erfc.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2026 Alexei Sibidanov, Paul Zimmermann, Tom Hubrecht and
# Claude-Pierre Jeannerod.
# Distributed under the MIT license: see THIRD-PARTY-NOTICES.md at the repository root. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its exception-flag
# handling, errno and directed-rounding remarks are dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.
# The erf kernels (`b64_erf_fast`, `b64_erf_accurate`) and the error-free transforms come from
# B64Erf.rf: the original C file carries a copy of the same code and tables.

# ---------------------------------------------------------------------------
# Double-double helpers
# ---------------------------------------------------------------------------

### `a * (bh + bl)` as a double-double.
### :param a: The double factor.
### :param bh: The high part of the double-double factor.
### :param bl: The low part of the double-double factor.
### :returns: The product.
secret routine b64_erfc_s_mul(a: B64, bh: B64, bl: B64) -> DD
    var p = b64_erf_a_mul(a: a, b: bh)
    return DD(hi: p.hi, lo: LLVM::fma[B64](a: a, b: bl, c: p.lo))

### `(ah + al) * (bh + bl) - al * bl` as a double-double.
### :param ah: The high part of the first factor.
### :param al: The low part of the first factor.
### :param bh: The high part of the second factor.
### :param bl: The low part of the second factor.
### :returns: The product.
secret routine b64_erfc_d_mul(ah: B64, al: B64, bh: B64, bl: B64) -> DD
    var p = b64_erf_a_mul(a: ah, b: bh)
    var lo = LLVM::fma[B64](a: ah, b: bl, c: p.lo)
    return DD(hi: p.hi, lo: LLVM::fma[B64](a: al, b: bh, c: lo))

# ---------------------------------------------------------------------------
# Fast path
# ---------------------------------------------------------------------------

### A double-double approximation of `erfc(x)` for -0x1.7744f8f74e94bp+2 < x < 0x1.b39dc41e48bfdp+4.
### :param x: The argument.
### :returns: `(h, l, err)`: `h + l` approximates erfc(x) with absolute error bounded by `err`.
secret routine b64_erfc_fast(x: B64) -> (B64, B64, B64)
    if x < 0.0
        # erfc(x) = 1 + erf(-x)
        var f = b64_erf_fast(z: -x)
        # convert the relative error bound into an absolute one
        var err = b64_erf_fast_err(z: -x) *! f.hi
        var s = b64_erf_fast_two_sum(a: 1.0, b: f.hi)
        return (s.hi, s.lo +! f.lo, err +! 0x1.4p-102)
    if x <= 0x1.713786D9C7C09p+1
        var f = b64_erf_fast(z: x)
        var err = b64_erf_fast_err(z: x) *! f.hi
        var s = b64_erf_fast_two_sum(a: 1.0, b: -f.hi)
        var l = s.lo -! f.lo
        # for x >= 0x1.e861fbb24c00ap-2, erf(x) >= 1/2, so 1 - h is exact
        if x >= 0x1.E861FBB24C00Ap-2
            return (s.hi, l, err)
        return (s.hi, l, err +! 0x1.4p-104)
    # now 0x1.713786d9c7c09p+1 < x < 0x1.b39dc41e48bfdp+4, thus erfc(x) < 0.000046
    return b64_erfc_asympt_fast(x: x)

### The fast path for 0x1.713786d9c7c09p+1 < x < 0x1.b39dc41e48bfdp+4, using the asymptotic formula
### erfc(x) = exp(-x^2) * p(1/x).
### :param x: The argument.
### :returns: `(h, l, err)`: `h + l` approximates erfc(x) with absolute error bounded by `err`.
secret routine b64_erfc_asympt_fast(x: B64) -> (B64, B64, B64)
    # for x >= 0x1.9db1bb14e15cap+4, erfc(x) < 2^-970: delegate to the accurate path
    if x >= 0x1.9DB1BB14E15CAp+4
        return (0.0, 0.0, 1.0)
    # approximate exp(-x^2)
    var u = b64_erf_a_mul(a: x, b: x)
    var e = b64_erfc_exp_1(xh: -u.hi, xl: -u.lo)
    # 1/x as a double-double (one Newton step)
    var yh = 1.0 /! x
    var yl = yh *! LLVM::fma[B64](a: -x, b: yh, c: 1.0)
    # the interval of yh
    var i = 0_u64
    while yh > B64.from_bits(bits: B64_ERFC_ASYMPT_THRESHOLD[i])
        i = i + 1
    var p = i * 13
    u = b64_erf_a_mul(a: yh, b: yh)
    var uh = u.hi
    var ul = LLVM::fma[B64](a: 2.0 *! yh, b: yl, c: u.lo)
    # evaluate p(uh + ul): degrees 23, 21, 19 in double
    var zh = B64.from_bits(bits: B64_ERFC_T[p + 12])
    zh = LLVM::fma[B64](a: zh, b: uh, c: B64.from_bits(bits: B64_ERFC_T[p + 11]))
    zh = LLVM::fma[B64](a: zh, b: uh, c: B64.from_bits(bits: B64_ERFC_T[p + 10]))
    # degree 17: zh*(uh + ul) + T[p+9]
    var m = b64_erfc_s_mul(a: zh, bh: uh, bl: ul)
    var z = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERFC_T[p + 9]), b: m.hi)
    zh = z.hi
    var zl = z.lo +! m.lo
    var j = 15_u64
    while j >= 3
        m = b64_erfc_d_mul(ah: zh, al: zl, bh: uh, bl: ul)
        z = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERFC_T[p + (j + 1) // 2]), b: m.hi)
        zh = z.hi
        zl = z.lo +! m.lo
        j = j - 2
    # degree 1: (zh + zl)*(uh + ul) + T[p+0] + T[p+1]
    m = b64_erfc_d_mul(ah: zh, al: zl, bh: uh, bl: ul)
    z = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERFC_T[p]), b: m.hi)
    zh = z.hi
    zl = z.lo +! (m.lo +! B64.from_bits(bits: B64_ERFC_T[p + 1]))
    # multiply by yh + yl: p(1/x)
    var q = b64_erfc_d_mul(ah: zh, al: zl, bh: yh, bl: yl)
    # multiply by eh + el
    var r = b64_erfc_d_mul(ah: q.hi, al: q.lo, bh: e.hi, bl: e.lo)
    # the relative error bound is 2^-67.115 < 0x1.d9p-68, and 0x1.d9p-68 * h must not underflow
    if r.hi >= 0x1.151B9A3FDD5C9p-955
        return (r.hi, r.lo, 0x1.D9p-68 *! r.hi)
    return (r.hi, r.lo, 0x1p-1022)

### `exp(xh + xl)` as a double-double, with relative error below 2^-74.139, assuming |xl/xh| < 2^-23.89
### and |xl| < 2^-14.3486 (the fast exponential of CORE-MATH's pow).
### :param xh: The high part of the argument.
### :param xl: The low part of the argument.
### :returns: `hi + lo` approximating exp(xh + xl).
secret routine b64_erfc_exp_1(xh: B64, xl: B64) -> DD
    # INVLOG2 approximates 2^12/log(2)
    var k = LLVM::rint[B64](value: xh *! 0x1.71547652B82FEp+12)
    # LOG2H + LOG2L approximates log(2)/2^12
    var kk = b64_erfc_s_mul(a: k, bh: 0x1.62E42FEFA39EFp-13, bl: 0x1.ABC9E3B39803Fp-68)
    var y = b64_erf_fast_two_sum(a: xh -! kk.hi, b: xl)
    var yl = y.lo -! kk.lo
    var bk = LLVM::float_to_signed[B64, S64](k)
    var ku = LLVM::reinterpret_bits[S64, U64](bk)
    var m = (bk >> 12) + 0x3FF
    var i2 = (ku >>> 6) & 0x3F_u64
    var i1 = ku & 0x3F_u64
    var t = b64_erfc_d_mul(
        ah: B64.from_bits(bits: B64_ERFC_T2[2 * i1]),
        al: B64.from_bits(bits: B64_ERFC_T2[2 * i1 + 1]),
        bh: B64.from_bits(bits: B64_ERFC_T1[2 * i2]),
        bl: B64.from_bits(bits: B64_ERFC_T1[2 * i2 + 1]),
    )
    var q = b64_erfc_q_1(zh: y.hi, zl: yl)
    var r = b64_erfc_d_mul(ah: t.hi, al: t.lo, bh: q.hi, bl: q.lo)
    var scale = B64.from_bits(bits: LLVM::reinterpret_bits[S64, U64](m) << 52)
    return DD(hi: r.hi *! scale, lo: r.lo *! scale)

### `exp(zh + zl)` as a double-double for |zh + zl| < 2^-12.88 and |zl| < 2^-42.6 (a degree-4 polynomial).
### :param zh: The high part of the argument.
### :param zl: The low part of the argument.
### :returns: `hi + lo` approximating exp(zh + zl).
secret routine b64_erfc_q_1(zh: B64, zl: B64) -> DD
    var z = zh +! zl
    var q = LLVM::fma[B64](a: 0x1.55555558489DCp-5, b: zh, c: 0x1.5555555995D37p-3)
    q = LLVM::fma[B64](a: q, b: z, c: 0.5)
    var s = b64_erf_fast_two_sum(a: 1.0, b: q *! z)
    var d = b64_erfc_d_mul(ah: zh, al: zl, bh: s.hi, bl: s.lo)
    var r = b64_erf_fast_two_sum(a: 1.0, b: d.hi)
    return DD(hi: r.hi, lo: r.lo +! d.lo)
