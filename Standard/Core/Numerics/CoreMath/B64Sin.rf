# ============================================================================
# Correctly rounded sine of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/sin/sin.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2026 Paul Zimmermann and Tom Hubrecht and Alexei Sibidanov. Distributed under the MIT
# license: see THIRD-PARTY-NOTICES.md at the repository root. RazorForge has no dynamic rounding modes, so only the
# round-to-nearest path of the original is kept (its errno handling is dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats. The 128-bit
# fixed-point accurate path uses U128 with wrapping operators, as the C code uses unsigned __int128.

### Returns the sine of this value, interpreting it as radians, correctly rounded: the exact sine rounded
### to the nearest `B64` (ties to even), identical on every platform. `sin(-x) == -sin(x)`, ±0 map to
### themselves, and ±infinity and NaN give NaN.
### :returns: The correctly rounded sine.
routine B64.sin() -> B64
    var x = me
    var ux = x.to_bits()
    var au = ux << 1
    # |x| <= 0x1.7137449123ef6p-26: sin(x) rounds like x - x^3/6
    if au <= 0x7CAE26E892247DEC_u64
        if au == 0
            return x
        return LLVM::fma[B64](a: x, b: -0x1p-54, c: x)
    var e = (ux >>> 52) & 0x7FF_u64
    # |x| < 2^31
    if e < 1054
        return b64_sin_moderate(x: x, sbit: ux >>> 63)
    # NaN, +infinity and -infinity
    if e == 0x7FF
        return x -! x
    return b64_sin_large(x: x)

### Builds a 128-bit value from its high and low 64-bit halves.
### :param hi: The high 64 bits.
### :param lo: The low 64 bits.
### :returns: `hi * 2^64 + lo`.
secret routine b64_sin_u128(hi: U64, lo: U64) -> U128
    return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

### Entry `i` of a table of 128-bit values stored as (low, high) pairs of `U64`.
### :param lo: The low half, `TABLE[2i]`.
### :param hi: The high half, `TABLE[2i + 1]`.
### :returns: The 128-bit entry.
secret routine b64_sin_pair(lo: U64, hi: U64) -> U128
    return b64_sin_u128(hi: hi, lo: lo)

### The high half of a 128 x 128-bit fixed-point product, `floor(a * b / 2^128)` up to the dropped
### low-times-low partial product.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The approximate high half of the product.
secret routine b64_sin_mhuu(a: U128, b: U128) -> U128
    var ah = LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](a >>> 64))
    var al = LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](a))
    var bh = LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](b >>> 64))
    var bl = LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](b))
    var ahbh = ah *% bh
    var ahbl = ah *% bl
    var albh = al *% bh
    return ahbh +% ((ahbl >>> 64) +% (albh >>> 64))

### Rounds `(-1)^sbit * r / 2^128` to a `B64`, for `r` non-zero and the result not subnormal.
### :param r: The 128-bit fixed-point magnitude.
### :param sbit: The sign bit (0 or 1).
### :returns: The rounded value.
secret routine b64_sin_u128_tod(r: U128, sbit: U64) -> B64
    var sh = LLVM::int_truncate[U128, U32](r.leading_zeros())
    # upper 53 non-zero bits and the round bit
    var h = LLVM::int_truncate[U128, U64](r >>> 75_u32 - sh)
    var rbit = LLVM::int_truncate[U128, U64](r >>> 74_u32 - sh) & 1_u64
    var vbits = 0x3CA0000000000000_u64
    if sbit == 1
        vbits = 0xBCA0000000000000_u64
    # scale ±2^-53 by 2^-sh
    var v = B64.from_bits(bits: vbits -% (LLVM::zero_extend[U32, U64](sh) << 52))
    var a = LLVM::unsigned_to_float[U64, B64](h) *! v
    var scale = 0x1p-54
    if rbit == 1
        scale = 0x1p-53
    var b = a *! scale
    return a +! b

### Error-free sum `x + y = s + e` for |x| >= |y| (Fast2Sum).
### :param x: The larger operand.
### :param y: The smaller operand.
### :returns: `(s, e)`.
secret routine b64_sin_fasttwosum(x: B64, y: B64) -> (B64, B64)
    var s = x +! y
    var z = s -! x
    return (s, y -! z)

### Double-double sum `(xh + xl) + (yh + yl)`, with |xh| >= |yh|.
### :param xh: The high part of the first operand.
### :param xl: The low part of the first operand.
### :param yh: The high part of the second operand.
### :param yl: The low part of the second operand.
### :returns: `(high, low)` of the sum.
secret routine b64_sin_fastsum(xh: B64, xl: B64, yh: B64, yl: B64) -> (B64, B64)
    var s = b64_sin_fasttwosum(x: xh, y: yh)
    return (s.item0, xl +! yl +! s.item1)

### Double-double product `(xh + xl) * (ch + cl)`.
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: `(high, low)` of the product.
secret routine b64_sin_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> (B64, B64)
    var ahhh = xh *! ch
    return (ahhh, xh *! cl +! xl *! ch +! LLVM::fma[B64](a: xh, b: ch, c: -ahhh))

### Word `j` of the 1/(2pi) table: 1/(2pi) ~ sum of `T[j] / 2^(64j)`.
### :param j: The word index, 0 <= j < 20.
### :returns: The table word.
secret routine b64_sin_t(j: U64) -> U64
    return B64_SIN_T[j]

### Argument reduction for |x| >= 2^31: returns `(k, r)` with x/(2pi) mod 1 = k/2^15 + r + s, where
### 0 <= r < 2^-15 and 0 <= s < 2^-67.988 (r is returned centered, minus 2^-16).
### :param x: The argument |x|, finite with |x| >= 2^31.
### :returns: `(k, r)`.
secret routine b64_sin_reduce_large(x: B64) -> (U64, B64)
    var u64 = x.to_bits()
    var e = (u64 >>> 52) & 0x7FF_u64
    var m = (1_u64 << 52) | u64 & 0x000FFFFFFFFFFFFF_u64
    var i = (e - 1011) // 64
    var f = LLVM::int_truncate[U64, U32](e - 1011 & 0x3F_u64)
    var v0 = b64_sin_t(j: i)
    var v1 = b64_sin_t(j: i + 1)
    if f != 0
        v0 = (b64_sin_t(j: i) << f) | (b64_sin_t(j: i + 1) >>> 64_u32 - f)
        v1 = (b64_sin_t(j: i + 1) << f) | (b64_sin_t(j: i + 2) >>> 64_u32 - f)
    var u = b64_sin_u128(hi: v0, lo: v1)
    u = LLVM::zero_extend[U64, U128](m) *% u
    # round r to nearest, where 0x810000000000000 = 2^59 + 2^52
    var magic = b64_sin_u128(hi: 0x0001000000000000_u64, lo: 0x0810000000000000_u64)
    u = u +% magic
    # the next 53 bits of u after the first 15
    var t = LLVM::unsigned_to_float[U128, B64](u << 15 >>> 75)
    var r = t *! 0x1p-68 -! 0x1p-16
    return (LLVM::int_truncate[U128, U64](u >>> 113), r)

### Returns Sr with Sr/2^128 approximating sin(2 pi r), for 0 <= r < 2^-14, where u, u2 and u4 are r,
### r^2 and r^4 in 128-bit fixed point and u2h = floor(u2 / 2^64).
### :param u: r / 2^128.
### :param u2: r^2 / 2^128.
### :param u2h: floor(u2 / 2^64).
### :param u4: r^4 / 2^128.
### :returns: Sr.
secret routine b64_sin_eval_ps(u: U128, u2: U128, u2h: U128, u4: U128) -> U128
    # Estrin's scheme: the degree-{1,3} part plus r^4 times the degree-{5,7} part, with alternating signs
    var ps0 = b64_sin_u128(hi: 0xFFFFFFFFFFFFFFFF_u64, lo: 0xFFFFFFFFFFFFC396_u64)
    var ps1 = b64_sin_u128(hi: 0x2AAAAAAAAAAAAAAA_u64, lo: 0xAAAAA9646E8F872E_u64)
    var ps2 = b64_sin_u128(hi: 0x0222222222222220_u64, lo: 0x467B898367FB1249_u64)
    var ps3 = b64_sin_u128(hi: 0_u64, lo: 0x000D00D00BFFF5EE_u64)
    var sh = ps2 -% ps3 *% u2h
    sh = b64_sin_mhuu(a: sh, b: u4)
    var s = b64_sin_mhuu(a: ps1, b: u2)
    s = ps0 -% s
    s = s +% sh
    return b64_sin_mhuu(a: s, b: u)

### Returns Cr with Cr/2^128 approximating cos(2 pi r), for 0 <= r < 2^-14, where u2 and u4 are r^2
### and r^4 in 128-bit fixed point and u2h = floor(u2 / 2^64).
### :param u2: r^2 / 2^128.
### :param u2h: floor(u2 / 2^64).
### :param u4: r^4 / 2^128.
### :returns: Cr.
secret routine b64_sin_eval_pc(u2: U128, u2h: U128, u4: U128) -> U128
    var pc0 = b64_sin_u128(hi: 0xFFFFFFFFFFFFFFFF_u64, lo: 0xFFFFFFFFFFFFFFFF_u64)
    var pc1 = b64_sin_u128(hi: 0x7FFFFFFFFFFFFFFF_u64, lo: 0xFFFFFFFFFA998BF0_u64)
    var pc2 = b64_sin_u128(hi: 0x0AAAAAAAAAAAAAAA_u64, lo: 0xAAA2CAECC94962C7_u64)
    var pc3 = b64_sin_u128(hi: 0x005B05B05B05AC1A_u64, lo: 0x642013BC289028B6_u64)
    var pc4 = b64_sin_u128(hi: 0_u64, lo: 0x0001A0193D9A550C_u64)
    var sh = pc3 -% u2h *% pc4
    sh = pc2 -% b64_sin_mhuu(a: sh, b: u2)
    var s = b64_sin_mhuu(a: pc1, b: u2)
    s = pc0 -% s
    return s +% b64_sin_mhuu(a: sh, b: u4)

### Argument reduction for the accurate path: returns `(k, r, neg)` with x/(2pi) mod 1 = k/2^13 +
### (-1)^neg r/2^128 + eps, |r/2^128| <= 2^-14 and 0 <= eps < 2^-127.999.
### :param x: The argument, finite with |x| >= 2^-16.
### :returns: `(k, r, neg)`.
secret routine b64_sin_reduce_large_acc(x: B64) -> (U64, U128, U64)
    var ux = x.to_bits()
    var e = (ux >>> 52) & 0x7FF_u64
    var m = (1_u64 << 52) | ux & 0x000FFFFFFFFFFFFF_u64
    # i = ceil((e - 1074) / 64) - 1, possibly -1 (then the first word is 0)
    var ip1 = (e - 947) // 64
    var f = LLVM::int_truncate[U64, U32](e + 64 - 1011 & 0x3F_u64)
    var v0 = 0_u64
    if ip1 >= 1
        v0 = b64_sin_t(j: ip1 - 1)
    var v1 = b64_sin_t(j: ip1)
    var v2 = b64_sin_t(j: ip1 + 1)
    if f != 0
        v0 = (v0 << f) | (v1 >>> 64_u32 - f)
        v1 = (v1 << f) | (v2 >>> 64_u32 - f)
        v2 = (v2 << f) | (b64_sin_t(j: ip1 + 2) >>> 64_u32 - f)
    var mm = LLVM::zero_extend[U64, U128](m)
    var u = mm *% b64_sin_u128(hi: v0, lo: v1)
    var v = mm *% LLVM::zero_extend[U64, U128](v2)
    # add the contribution of m*V2 from 2^-76 to 2^-128
    u = u +% (v >>> 64)
    var k = LLVM::int_truncate[U128, U64](u >>> 115)
    var mask = b64_sin_u128(hi: 0x0007FFFFFFFFFFFF_u64, lo: 0xFFFFFFFFFFFFFFFF_u64)
    # ignore the leading 13 bits, then round k to nearest to have |r/2^128| < 2^-14
    u = u & mask
    var neg = LLVM::int_truncate[U128, U64](u >>> 114)
    if neg != 0
        k = k + 1 & 0x1FFF_u64
        u = mask +% LLVM::zero_extend[U64, U128](1_u64) -% u
    return (k, u, neg)

### The accurate path of `sin` in 128-bit fixed point, for |x| >= 2^-16.
### :param x: The argument, finite with |x| >= 2^-16.
### :returns: The correctly rounded sine.
secret routine b64_sin_large_accurate(x: B64) -> B64
    var red = b64_sin_reduce_large_acc(x: x)
    var k = red.item0
    var r = red.item1
    var neg = red.item2
    # twopi/2^128 approximates 2pi/2^3: replace r by 2pi*r
    var twopi = b64_sin_u128(hi: 0xC90FDAA22168C234_u64, lo: 0xC4C6628B80DC1CD1_u64)
    r = b64_sin_mhuu(a: twopi, b: r << 3)
    var u2 = b64_sin_mhuu(a: r, b: r)
    var u4 = b64_sin_mhuu(a: u2, b: u2)
    var u2h = u2 >>> 64
    # x/(2pi) mod 1 = k/2^13 + r + eps: with k = 2^12 s + 2^6 i1 + i2, t1 = pi i1/2^6 and t2 = pi i2/2^12,
    # sin(pi k/2^12) and cos(pi k/2^12) follow from sin/cos of t1 and t2, up to the sign (-1)^s
    var sbit = 1_u64
    if x > 0.0
        sbit = 0_u64
    sbit = sbit ^ (k >>> 12)
    var i1 = (k >>> 6) & 0x3F_u64
    var i2 = k & 0x3F_u64
    # |sin(t1)| and |cos(t1)| through sin(pi - t) = sin(t) and cos(t) = sin(t + pi/2)
    var s1 = b64_sin_s1u(i: 32_u64)
    var c1 = s1
    if i1 <= 32
        s1 = b64_sin_s1u(i: i1)
        c1 = b64_sin_s1u(i: 32 - i1)
    else
        s1 = b64_sin_s1u(i: 64 - i1)
        c1 = b64_sin_s1u(i: i1 - 32)
    var c2 = b64_sin_pair(lo: B64_SIN_C2U[2 * i2], hi: B64_SIN_C2U[2 * i2 + 1])
    var s2 = b64_sin_pair(lo: B64_SIN_S2U[2 * i2], hi: B64_SIN_S2U[2 * i2 + 1])
    var s1u = b64_sin_mhuu(a: s1, b: c2)
    var t = b64_sin_mhuu(a: c1, b: s2)
    # sin(t1 + t2) >= 0 for 0 <= t1 + t2 < pi
    if i1 < 32
        s1u = s1u +% t
    else
        s1u = s1u -% t
    # cos(t1 + t2)
    var c1u = b64_sin_mhuu(a: c1, b: c2)
    t = b64_sin_mhuu(a: s1, b: s2)
    if i1 < 32
        c1u = c1u -% t
    else
        c1u = c1u +% t
    var sr = b64_sin_eval_ps(u: r, u2: u2, u2h: u2h, u4: u4)
    var cr = b64_sin_eval_pc(u2: u2, u2h: u2h, u4: u4)
    # sin(x) ~ sin(z) cos(r) + cos(z) sin(r), where the first term is >= 0
    s1u = b64_sin_mhuu(a: s1u, b: cr)
    c1u = b64_sin_mhuu(a: c1u, b: sr)
    var nonneg = 1_u64
    if i1 >= 32
        nonneg = 0_u64
    if (nonneg ^ neg) == 1
        s1u = s1u +% c1u
    elseif s1u < c1u
        s1u = c1u -% s1u
        sbit = sbit ^ 1
    else
        s1u = s1u -% c1u
    return b64_sin_u128_tod(r: s1u, sbit: sbit)

### Entry `i` of the sin(pi i/2^6) table, 0 <= i <= 32, as a 128-bit fixed-point value.
### :param i: The index.
### :returns: The table entry.
secret routine b64_sin_s1u(i: U64) -> U128
    return b64_sin_pair(lo: B64_SIN_S1U[2 * i], hi: B64_SIN_S1U[2 * i + 1])

### The accurate path of `sin` for |x| < 2^-16: x + (c3h + c3l) x^3 + c5 x^5 with relative error below
### 2^-112.743, evaluated in double-double.
### :param x: The argument, 0x1.7137449123ef6p-26 < |x| < 2^-16.
### :returns: The correctly rounded sine.
secret routine b64_sin_small_accurate(x: B64) -> B64
    var c3h = -0x1.5555555555555p-3
    var c3l = -0x1.55554B00DE7E8p-57
    var c5 = 0x1.111111110848p-7
    var x2h = x *! x
    var x2l = LLVM::fma[B64](a: x, b: x, c: -x2h)
    var h = c5 *! x2h
    h = h +! c3l
    var s = b64_sin_fasttwosum(x: c3h, y: h)
    var p = b64_sin_muldd(xh: s.item0, xl: s.item1, ch: x2h, cl: x2l)
    p = b64_sin_muldd(xh: p.item0, xl: p.item1, ch: x, cl: 0.0)
    var l = p.item1
    var q = b64_sin_fasttwosum(x: x, y: p.item0)
    l = l +! q.item1
    return q.item0 +! l

### Combines the table values of sin and cos at `j`/2^15 turns (j = 2^7 i1 + i2) with the polynomial
### values `sh ~ sin(r)` and `ch ~ cos(r) - 1`: returns `(Sh, Sl + Sh ch + Ch sh)`.
### :param i1: The coarse table index, 0 <= i1 < 128.
### :param i2: The fine table index, 0 <= i2 < 128.
### :param sh: The sine polynomial value.
### :param ch: The cosine-minus-one polynomial value.
### :returns: `(fh, fl)` approximating sin of the reduced argument.
secret routine b64_sin_combine(i1: U64, i2: U64, sh: B64, ch: B64) -> (B64, B64)
    var a = 4 * i1
    var b = 4 * i2
    var p1 = b64_sin_muldd(
        xh: B64_SIN_U1[a],
        xl: B64_SIN_U1[a + 1],
        ch: B64_SIN_U2[b + 2],
        cl: B64_SIN_U2[b + 3],
    )
    var p2 = b64_sin_muldd(
        xh: B64_SIN_U2[b],
        xl: B64_SIN_U2[b + 1],
        ch: B64_SIN_U1[a + 2],
        cl: B64_SIN_U1[a + 3],
    )
    var s = b64_sin_fastsum(xh: p1.item0, xl: p1.item1, yh: p2.item0, yl: p2.item1)
    var cc = B64_SIN_U1[a + 2] *! B64_SIN_U2[b + 2] -! B64_SIN_U1[a] *! B64_SIN_U2[b]
    return (s.item0, s.item1 +! s.item0 *! ch +! cc *! sh)

### The fast path of `sin` for 0x1.7137449123ef6p-26 < |x| < 2^31.
### :param x: The argument.
### :param sbit: The sign bit of `x`.
### :returns: The correctly rounded sine.
secret routine b64_sin_moderate(x: B64, sbit: U64) -> B64
    var ax = x.abs()
    # |invpi/2^14 - 1/pi| < 2^-55.496
    var k = LLVM::rint[B64](value: 0x1.45F306DC9C883p+12 *! ax)
    # |2^14 (pih + pil) + pi| < 2^-108.041, and rh is exact
    var rh = LLVM::fma[B64](a: k, b: -0x1.921FB54442D18p-13, c: ax)
    var rl = k *! -0x1.1A62633145C07p-67
    var r = rh +! rl
    var r2 = r *! r
    var j = LLVM::reinterpret_bits[S64, U64](LLVM::float_to_signed[B64, S64](k))
    # a reduction by an odd multiple of pi flips the sign
    var sgn = sbit ^ (j >>> 14) & 1_u64
    var i1 = (j >>> 7) & 0x7F_u64
    var i2 = j & 0x7F_u64
    # r - c3 r^3 approximates sin(r) with absolute error < 2^-76.494, -r^2/2 + c4 r^4 approximates
    # cos(r) - 1 with absolute error < 2^-92.723, for |r| <= 2^-13.339
    var sh = r *! (1.0 -! 0x1.55555553068Fp-3 *! r2)
    var ch = r2 *! (-0.5 +! 0x1.55555553BFD3p-5 *! r2)
    var f = b64_sin_combine(i1: i1, i2: i2, sh: sh, ch: ch)
    var fh = f.item0
    var fl = f.item1
    if sgn == 1
        fh = -fh
        fl = -fl
    fl = fl -! 0x1.DEp-64
    var lb = fh +! fl
    var ub = fh +! (fl +! 0x1.DEp-63)
    if ub == lb
        return lb
    if x.abs() < 0x1p-16
        return b64_sin_small_accurate(x: x)
    return b64_sin_large_accurate(x: x)

### The fast path of `sin` for |x| >= 2^31.
### :param x: The argument, finite with |x| >= 2^31.
### :returns: The correctly rounded sine.
secret routine b64_sin_large(x: B64) -> B64
    var red = b64_sin_reduce_large(x: x.abs())
    var j = red.item0
    var r = red.item1
    # x/(2pi) ~ k + j/2^15 + r with 0 <= r < 2^-15
    var sbit = 1_u64
    if x > 0.0
        sbit = 0_u64
    var r2 = r *! r
    # a reduction by an odd multiple of pi flips the sign
    sbit = sbit ^ (j >>> 14)
    var i1 = (j >>> 7) & 0x7F_u64
    var i2 = j & 0x7F_u64
    var sh = r *! (0x1.921FB54442D18p2 -! 0x1.4ABBCDB6B26D1p5 *! r2)
    var ch = r2 *! (-0x1.3BD3CC9BE45DEp4 +! 0x1.03C1EEE483083p6 *! r2)
    var f = b64_sin_combine(i1: i1, i2: i2, sh: sh, ch: ch)
    var fh = f.item0
    var fl = f.item1
    if sbit == 1
        fh = -fh
        fl = -fl
    var lb = fh +! (fl -! 0x1.41p-63)
    var ub = fh +! (fl +! 0x1.41p-63)
    if lb == ub
        return lb
    return b64_sin_large_accurate(x: x)
