    0x3E6301E540260D52,
]
# the degree-21 odd polynomial of the accurate path on [0, 1/8]: degrees 1 to 7 double-double, then 9 to 21
secret preset B64_ERF_TINY_P: Array[U64, 15] = [
    0x3FF20DD750429B6D, 0x3C71AE3A914FED80, 0xBFD812746B0379E7, 0x3C6EE12E49CA96BA,
    0x3FBCE2F21A042BE2, 0xBC52871BC0A0A0D0, 0xBF9B82CE31288B51, 0x3C21003ACCF1355C,
    0x3F7565BCD0E6A53F, 0xBF4C02DB40040CC3, 0x3F1F9A326FA3CF50, 0xBEEF4D25E3C73CE9,
    0x3EBB9EB332B31646, 0xBE864A4BD5ECA4D7, 0x3E6C0ACC2502E94E,
]

# ============================================================================
# The kernels of CORE-MATH's error function of B64
# ============================================================================
# B64.erf itself is Tessera's, through Ingrid. This file keeps the fast and accurate erf kernels the
# D64 transcendentals (D64Trans.rf) build on.
# Ported from CORE-MATH, src/binary64/erf/erf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2025 Paul Zimmermann. Distributed under the MIT license: see THIRD-PARTY-NOTICES.md at
# the repository root. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling and directed-rounding remarks are dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.
# The error-free transforms and the fast / accurate erf kernels below are shared with `B64.erfc()`
# (B64Erfc.rf), whose original C file carries a copy of the same code and tables.

# ---------------------------------------------------------------------------
# Error-free transforms
# ---------------------------------------------------------------------------

### `a + b` as a double-double, assuming `|a| >= |b|` (Dekker's fast two-sum, exact in round-to-nearest).
### :param a: The larger addend.
### :param b: The smaller addend.
### :returns: `hi + lo == a + b` with `hi = a + b` rounded.
secret routine b64_erf_fast_two_sum(a: B64, b: B64) -> DD
    var hi = a +! b
    var e = hi -! a
    return DD(hi: hi, lo: b -! e)

### `a + b` as a double-double, for any order of magnitude (Knuth's two-sum).
### :param a: The first addend.
### :param b: The second addend.
### :returns: `hi + lo == a + b` with `hi = a + b` rounded.
secret routine b64_erf_two_sum(a: B64, b: B64) -> DD
    var hi = a +! b
    var aa = hi -! b
    var bb = hi -! aa
    var da = a -! aa
    var db = b -! bb
    return DD(hi: hi, lo: da +! db)

### The exact product `a * b` as a double-double (fma-based).
### :param a: The first factor.
### :param b: The second factor.
### :returns: `hi + lo == a * b` exactly.
secret routine b64_erf_a_mul(a: B64, b: B64) -> DD
    var hi = a *! b
    return DD(hi: hi, lo: LLVM::fma[B64](a: a, b: b, c: -hi))

# ---------------------------------------------------------------------------
# Fast path
# ---------------------------------------------------------------------------

### The relative error bound of `b64_erf_fast` for `z`.
### :param z: The argument, 2^-61 <= z <= 0x1.7afb48dc96626p+2.
### :returns: `err` such that |(h + l)/erf(z) - 1| < err * |h + l|.
secret routine b64_erf_fast_err(z: B64) -> B64
    if z < 0.0625
        return 0x1.78p-69
    return 0x1.11p-69

### A double-double approximation of `erf(z)` for 0 <= z <= 0x1.7afb48dc96626p+2, with relative error
### bounded by `b64_erf_fast_err(z)`. The range is split into intervals i/16 <= z < (i+1)/16: the first
### one uses an odd polynomial at zero, the others a degree-10 polynomial at the interval middle.
### :param z: The argument.
### :returns: `hi + lo` approximating erf(z).
secret routine b64_erf_fast(z: B64) -> DD
    if z < 0.0625
        # a degree-11 minimax polynomial for erf on [0, 1/16], double-double coefficients for degrees 1 and 3,
        # relative error 2^-68.935
        var z2 = b64_erf_a_mul(a: z, b: z)
        var z4 = z2.hi *! z2.hi
        var q9 = LLVM::fma[B64](
            a: B64.from_bits(bits: B64_ERF_C0[7]),
            b: z2.hi,
            c: B64.from_bits(bits: B64_ERF_C0[6]),
        )
        var q5 = LLVM::fma[B64](
            a: B64.from_bits(bits: B64_ERF_C0[5]),
            b: z2.hi,
            c: B64.from_bits(bits: B64_ERF_C0[4]),
        )
        q5 = LLVM::fma[B64](a: q9, b: z4, c: q5)
        # C0[2] + C0[3] + z2h*q5
        var t = b64_erf_a_mul(a: z2.hi, b: q5)
        var s = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERF_C0[2]), b: t.hi)
        var h = s.hi
        var l = s.lo +! (t.lo +! B64.from_bits(bits: B64_ERF_C0[3]))
        # C0[0] + C0[1] + (z2h + z2l)*(h + l)
        var h_copy = h
        t = b64_erf_a_mul(a: z2.hi, b: h)
        var tl = t.lo +! LLVM::fma[B64](a: z2.hi, b: l, c: B64.from_bits(bits: B64_ERF_C0[1]))
        s = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERF_C0[0]), b: t.hi)
        h = s.hi
        l = s.lo +! LLVM::fma[B64](a: z2.lo, b: h_copy, c: tl)
        # multiply (h, l) by z
        t = b64_erf_a_mul(a: h, b: z)
        return DD(hi: t.hi, lo: LLVM::fma[B64](a: l, b: z, c: t.lo))
    var v = LLVM::floor[B64](value: 16.0 *! z)
    var i = LLVM::float_to_unsigned[B64, U64](16.0 *! z)
    # i/16 <= z < (i+1)/16, and both subtractions below are exact
    var w = z -! 0.03125 -! 0.0625 *! v
    # now |w| <= 1/32
    var c = (i - 1) * 13
    var w2 = w *! w
    var w4 = w2 *! w2
    # the degree-10 coefficient is C[c + 12]
    var q9 = LLVM::fma[B64](
        a: B64.from_bits(bits: B64_ERF_C[c + 12]),
        b: w,
        c: B64.from_bits(bits: B64_ERF_C[c + 11]),
    )
    var q7 = LLVM::fma[B64](
        a: B64.from_bits(bits: B64_ERF_C[c + 10]),
        b: w,
        c: B64.from_bits(bits: B64_ERF_C[c + 9]),
    )
    var q5 = LLVM::fma[B64](
        a: B64.from_bits(bits: B64_ERF_C[c + 8]),
        b: w,
        c: B64.from_bits(bits: B64_ERF_C[c + 7]),
    )
    # q3 <- C[c+5] + w*C[c+6]
    var q3 = b64_erf_fast_two_sum(
        a: B64.from_bits(bits: B64_ERF_C[c + 5]),
        b: w *! B64.from_bits(bits: B64_ERF_C[c + 6]),
    )
    var q3h = q3.hi
    var q3l = q3.lo
    q7 = LLVM::fma[B64](a: q9, b: w2, c: q7)
    # q3 <- q3 + q5*w2
    var s = b64_erf_fast_two_sum(a: q3h, b: q5 *! w2)
    q3h = s.hi
    q3l = q3l +! s.lo
    # q3 <- q3 + q7*w4
    s = b64_erf_fast_two_sum(a: q3h, b: q7 *! w4)
    q3h = s.hi
    q3l = q3l +! s.lo
    # q2 <- C[c+4] + w*q3
    var t = b64_erf_a_mul(a: w, b: q3h)
    var q2 = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERF_C[c + 4]), b: t.hi)
    var q2l = q2.lo +! LLVM::fma[B64](a: w, b: q3l, c: t.lo)
    # C[c+2] + C[c+3] + w*q2
    t = b64_erf_a_mul(a: w, b: q2.hi)
    s = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERF_C[c + 2]), b: t.hi)
    var h = s.hi
    var l = s.lo +! (t.lo +! LLVM::fma[B64](a: w, b: q2l, c: B64.from_bits(bits: B64_ERF_C[c + 3])))
    # C[c+0] + C[c+1] + w*(h + l)
    t = b64_erf_a_mul(a: w, b: h)
    var tl = LLVM::fma[B64](a: w, b: l, c: t.lo)
    s = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERF_C[c]), b: t.hi)
    return DD(hi: s.hi, lo: s.lo +! (tl +! B64.from_bits(bits: B64_ERF_C[c + 1])))

# ---------------------------------------------------------------------------
# Accurate path
# ---------------------------------------------------------------------------

### An accurate double-double approximation of `erf(z)` (about 106 bits), without any table of hard
### cases. The range is split into intervals i/8 <= z < (i+1)/8: the first one uses an odd polynomial at
### zero, the others a degree-18 polynomial at the interval middle.
### :param z: The argument, 2^-61 <= z <= 0x1.7afb48dc96626p+2.
### :returns: `hi + lo` approximating erf(z).
secret routine b64_erf_accurate(z: B64) -> DD
    if z < 0.125
        return b64_erf_accurate_tiny(z: z)
    var v = LLVM::floor[B64](value: 8.0 *! z)
    var i = LLVM::float_to_unsigned[B64, U64](8.0 *! z)
    var w = z -! 0.0625 -! 0.125 *! v
    # now |w| <= 1/16
    var p = (i - 1) * 27
    # degree 18
    var h = B64.from_bits(bits: B64_ERF_C2[p + 26])
    var j: U64 = 17
    while j > 10
        h = LLVM::fma[B64](a: h, b: w, c: B64.from_bits(bits: B64_ERF_C2[p + 8 + j]))
        j = j - 1
    var l: B64 = 0.0
    while j > 7
        # multiply h + l by w, then add C2[p+8+j]
        var t = b64_erf_a_mul(a: h, b: w)
        var tl = LLVM::fma[B64](a: l, b: w, c: t.lo)
        var s = b64_erf_two_sum(a: B64.from_bits(bits: B64_ERF_C2[p + 8 + j]), b: t.hi)
        h = s.hi
        l = s.lo +! tl
        j = j - 1
    # degrees 7 down to 0 have double-double coefficients C2[p+2j] + C2[p+2j+1]
    j = 8
    while j > 0
        j = j - 1
        var t = b64_erf_a_mul(a: h, b: w)
        var tl = LLVM::fma[B64](a: l, b: w, c: t.lo)
        var s = b64_erf_two_sum(a: B64.from_bits(bits: B64_ERF_C2[p + 2 * j]), b: t.hi)
        h = s.hi
        l = s.lo +! (B64.from_bits(bits: B64_ERF_C2[p + 2 * j + 1]) +! tl)
    return DD(hi: h, lo: l)

### An accurate double-double approximation of `erf(z)` for 2^-61 <= z < 1/8: an odd polynomial of
### degree 21 whose coefficients of degree 1 to 7 are double-double.
### :param z: The argument.
### :returns: `hi + lo` approximating erf(z).
secret routine b64_erf_accurate_tiny(z: B64) -> DD
    var z2 = z *! z
    # degree 21
    var h = B64.from_bits(bits: B64_ERF_TINY_P[14])
    var a: U64 = 19
    while a > 11
        h = LLVM::fma[B64](a: h, b: z2, c: B64.from_bits(bits: B64_ERF_TINY_P[a // 2 + 4]))
        a = a - 2
    var l: B64 = 0.0
    while a > 7
        # multiply h + l by z^2, then add P[a/2+4]
        var t = b64_erf_a_mul(a: h, b: z)
        var tl = LLVM::fma[B64](a: l, b: z, c: t.lo)
        var m = b64_erf_a_mul(a: t.hi, b: z)
        l = LLVM::fma[B64](a: tl, b: z, c: m.lo)
        var s = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERF_TINY_P[a // 2 + 4]), b: m.hi)
        h = s.hi
        l = l +! s.lo
        a = a - 2
    # degrees 7 down to 1 have double-double coefficients P[a-1] + P[a]
    loop
        var t = b64_erf_a_mul(a: h, b: z)
        var tl = LLVM::fma[B64](a: l, b: z, c: t.lo)
        var m = b64_erf_a_mul(a: t.hi, b: z)
        l = LLVM::fma[B64](a: tl, b: z, c: m.lo)
        var s = b64_erf_fast_two_sum(a: B64.from_bits(bits: B64_ERF_TINY_P[a - 1]), b: m.hi)
        h = s.hi
        l = l +! (B64.from_bits(bits: B64_ERF_TINY_P[a]) +! s.lo)
        if a == 1
            break
        a = a - 2
    # multiply by z
    var t = b64_erf_a_mul(a: h, b: z)
    return DD(hi: t.hi, lo: LLVM::fma[B64](a: l, b: z, c: t.lo))
