module Core

# ============================================================================
# Multi-word integer helpers of the B128 log port
# ============================================================================
# Ported from CORE-MATH, src/binary128/log/logq.c and src/binary128/expm1/expm1q.c
# (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see THIRD-PARTY-NOTICES.md at the repository root.
# Numbers wider than 128 bits are little-endian arrays of 64-bit words (word 0 is the least significant).
# Every sum wraps like the C unsigned arithmetic it replaces.

### Builds a U128 from its high and low 64-bit words.
@inline
secret routine b128_wide_u128(hi: U64, lo: U64) -> U128
    return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

### The high 64-bit word of a U128.
@inline
secret routine b128_wide_hi(x: U128) -> U64
    return LLVM::int_truncate[U128, U64](x >>> 64)

### The low 64-bit word of a U128.
@inline
secret routine b128_wide_lo(x: U128) -> U64
    return LLVM::int_truncate[U128, U64](x)

### The full 128-bit product of two 64-bit words.
@inline
secret routine b128_wide_muu(a: U64, b: U64) -> U128
    return LLVM::zero_extend[U64, U128](a) *% LLVM::zero_extend[U64, U128](b)

### The high word of the unsigned 64x64-bit product.
@inline
secret routine b128_wide_mhuu(a: U64, b: U64) -> U64
    return b128_wide_hi(x: b128_wide_muu(a: a, b: b))

### Approximate high part of the unsigned 128x128-bit product (the low x low product is dropped).
@inline
secret routine b128_wide_mhUU(a: U128, b: U128) -> U128
    var a0 = b128_wide_lo(x: a)
    var a1 = b128_wide_hi(x: a)
    var b0 = b128_wide_lo(x: b)
    var b1 = b128_wide_hi(x: b)
    var a1b1 = b128_wide_muu(a: a1, b: b1)
    a1b1 = a1b1 +% (b128_wide_muu(a: a1, b: b0) >>> 64)
    return a1b1 +% (b128_wide_muu(a: a0, b: b1) >>> 64)

### Full 256-bit product of two U128 values, as (high, low).
secret routine b128_wide_mUU(a: U128, b: U128) -> (U128, U128)
    var a0 = b128_wide_lo(x: a)
    var a1 = b128_wide_hi(x: a)
    var b0 = b128_wide_lo(x: b)
    var b1 = b128_wide_hi(x: b)
    var a1b0 = b128_wide_muu(a: a1, b: b0)
    var a0b1 = b128_wide_muu(a: a0, b: b1)
    var a1b1 = b128_wide_muu(a: a1, b: b1)
    var a0b0 = b128_wide_muu(a: a0, b: b0)
    var mid = a1b0 +% a0b1
    var cmid = 0_u128
    if mid < a1b0
        cmid = 1_u128 << 64
    var lo = a0b0 +% (mid << 64)
    var clo = 0_u128
    if lo < a0b0
        clo = 1_u128
    return (a1b1 +% (mid >>> 64) +% cmid +% clo, lo)

### A shift amount as the U32 the shift operators take.
@inline
secret routine b128_wide_s(n: U64) -> U32
    return LLVM::int_truncate[U64, U32](n)

### mahu1u3u3: ((a * (b2, b1, b0)) >> 64) + (c2, c1, c0) over 3 words, returned as (w0, w1, w2).
secret routine b128_wide_mahu3(
    a: U64,
    b0: U64,
    b1: U64,
    b2: U64,
    c0: U64,
    c1: U64,
    c2: U64,
) -> (U64, U64, U64)
    var ab0 = b128_wide_muu(a: a, b: b0)
    var ab1 = b128_wide_muu(a: a, b: b1)
    var ab2 = b128_wide_muu(a: a, b: b2)
    var t = LLVM::zero_extend[U64, U128](b128_wide_lo(x: ab1)) +% (ab0 >>> 64)
    var s = LLVM::zero_extend[U64, U128](c0) +% (t & 0xFFFFFFFFFFFFFFFF_u128)
    var o0 = b128_wide_lo(x: s)
    t = LLVM::zero_extend[U64, U128](b128_wide_lo(x: ab2)) +% (ab1 >>> 64) +% (t >>> 64)
    s = LLVM::zero_extend[U64, U128](c1) +% (t & 0xFFFFFFFFFFFFFFFF_u128) +% (s >>> 64)
    var o1 = b128_wide_lo(x: s)
    t = (ab2 >>> 64) +% (t >>> 64)
    var o2 = c2 +% b128_wide_lo(x: t) +% b128_wide_hi(x: s)
    return (o0, o1, o2)

### (a2, a1, a0) + (b2, b1, b0) over 3 words, returned as (w0, w1, w2).
@inline
secret routine b128_wide_add3(
    a0: U64,
    a1: U64,
    a2: U64,
    b0: U64,
    b1: U64,
    b2: U64,
) -> (U64, U64, U64)
    var s = LLVM::zero_extend[U64, U128](a0) +% LLVM::zero_extend[U64, U128](b0)
    var o0 = b128_wide_lo(x: s)
    s = LLVM::zero_extend[U64, U128](a1) +% LLVM::zero_extend[U64, U128](b1) +% (s >>> 64)
    var o1 = b128_wide_lo(x: s)
    var o2 = a2 +% b2 +% b128_wide_hi(x: s)
    return (o0, o1, o2)
