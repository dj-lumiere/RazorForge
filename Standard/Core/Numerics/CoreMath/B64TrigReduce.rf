# ============================================================================
# Shared argument reduction and kernels of the correctly rounded B64 cosine and tangent
# ============================================================================
# Ported from CORE-MATH, src/binary64/cos/cos.c and src/binary64/tan/tan.c, which share this code
# (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2025 Paul Zimmermann and Tom Hubrecht. Distributed under the MIT license: see
# THIRD-PARTY-NOTICES.md at the repository root. RazorForge has no dynamic rounding modes, so only the round-to-nearest
# path of the original is kept.
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.
# A 128-bit floating-point value ("dint", the C dint64_t) is the tuple `(r, ex, sgn)`, standing for
# (-1)^sgn * r/2^128 * 2^ex, where r is the 128-bit significand (normalized: top bit set, unless zero).

### Builds a 128-bit value from its high and low 64-bit halves.
### :param hi: The high 64 bits.
### :param lo: The low 64 bits.
### :returns: `hi * 2^64 + lo`.
secret routine b64_trig_u128(hi: U64, lo: U64) -> U128
    return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

### The high 64 bits of a 128-bit value.
### :param r: The value.
### :returns: `floor(r / 2^64)`.
secret routine b64_trig_hi(r: U128) -> U64
    return LLVM::int_truncate[U128, U64](r >>> 64)

### The low 64 bits of a 128-bit value.
### :param r: The value.
### :returns: `r mod 2^64`.
secret routine b64_trig_lo(r: U128) -> U64
    return LLVM::int_truncate[U128, U64](r)

### The full 128-bit product of two 64-bit values.
### :param a: The first factor.
### :param b: The second factor.
### :returns: `a * b`.
secret routine b64_trig_mul64(a: U64, b: U64) -> U128
    return LLVM::zero_extend[U64, U128](a) *% LLVM::zero_extend[U64, U128](b)

### The dint zero, which converts back to 0.
### :returns: `(0, -1076, 0)`.
secret routine b64_trig_dint_zero() -> (U128, S64, U64)
    return (LLVM::zero_extend[U64, U128](0_u64), -1076_s64, 0_u64)

### Compares the absolute values of two dints.
### :param a: The first dint.
### :param b: The second dint.
### :returns: -1, 0 or 1 as |a| is less than, equal to or greater than |b|.
secret routine b64_trig_dint_cmp_abs(a: (U128, S64, U64), b: (U128, S64, U64)) -> S64
    var a_zero = b64_trig_hi(r: a.item0) == 0
    var b_zero = b64_trig_hi(r: b.item0) == 0
    if a_zero
        if b_zero
            return 0_s64
        return -1_s64
    if b_zero
        return 1_s64
    if a.item1 > b.item1
        return 1_s64
    if a.item1 < b.item1
        return -1_s64
    if a.item0 > b.item0
        return 1_s64
    if a.item0 < b.item0
        return -1_s64
    return 0_s64

### Adds two dints, with error bounded by 2 ulps (exact in the Sterbenz case).
### :param a0: The first addend.
### :param b0: The second addend.
### :returns: The sum.
secret routine b64_trig_dint_add(a0: (U128, S64, U64), b0: (U128, S64, U64)) -> (U128, S64, U64)
    if a0.item0 == LLVM::zero_extend[U64, U128](0_u64)
        return b0
    var a = a0
    var b = b0
    var c = b64_trig_dint_cmp_abs(a: a0, b: b0)
    if c == 0
        if (a0.item2 ^ b0.item2) != 0
            return b64_trig_dint_zero()
        return (a0.item0, a0.item1 + 1, a0.item2)
    if c == -1
        a = b0
        b = a0
    # from now on |a| > |b|, thus a.ex >= b.ex (or b is zero)
    var aa = a.item0
    var bb = b.item0
    var k = a.item1 - b.item1
    if k != 0
        if k > 0 and k < 128
            bb = bb >>> LLVM::int_truncate[S64, U32](k)
        else
            bb = LLVM::zero_extend[U64, U128](0_u64)
    var cc = aa
    var rex = a.item1
    if (a.item2 ^ b.item2) != 0
        cc = aa -% bb
        # C is not zero since |a| != |b|
        var ex = LLVM::int_truncate[U128, U32](cc.leading_zeros())
        if ex > 0
            if k == 1
                cc = (aa << ex) -% (b.item0 << ex - 1)
            else
                cc = (aa << ex) -% (bb << ex)
            rex = rex - LLVM::zero_extend[U32, S64](ex)
            ex = LLVM::int_truncate[U64, U32](b64_trig_hi(r: cc).leading_zeros())
        cc = cc << ex
        rex = rex - LLVM::zero_extend[U32, S64](ex)
    else
        cc = aa +% bb
        if cc < aa
            cc = (LLVM::zero_extend[U64, U128](1_u64) << 127) | (cc >>> 1)
            rex = rex + 1
    return (cc, rex, a.item2)

### Normalizes a product significand so that its top bit is set, and builds the dint.
### :param r: The significand of the product, with one of its two top bits set.
### :param ex: The sum of the factors' exponents.
### :param sgn: The sign bit of the product.
### :returns: The normalized product.
secret routine b64_trig_dint_mul_finish(r: U128, ex: S64, sgn: U64) -> (U128, S64, U64)
    var top = b64_trig_hi(r: r) >>> 63
    var shifted = r
    if top == 0
        shifted = r << 1
    return (shifted, ex + LLVM::reinterpret_bits[U64, S64](top) - 1, sgn)

### Multiplies two dints, with error bounded by 6 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_trig_dint_mul(a: (U128, S64, U64), b: (U128, S64, U64)) -> (U128, S64, U64)
    var ah = b64_trig_hi(r: a.item0)
    var al = b64_trig_lo(r: a.item0)
    var bh = b64_trig_hi(r: b.item0)
    var bl = b64_trig_lo(r: b.item0)
    var m1 = b64_trig_mul64(a: ah, b: bl)
    var m2 = b64_trig_mul64(a: al, b: bh)
    var r = b64_trig_mul64(a: ah, b: bh)
    r = r +% ((m1 >>> 64) +% (m2 >>> 64))
    return b64_trig_dint_mul_finish(r: r, ex: a.item1 + b.item1, sgn: a.item2 ^ b.item2)

### Multiplies two dints assuming the low half of `b` is zero, with error bounded by 2 ulps.
### :param a: The first factor.
### :param b: The second factor, whose low 64 bits are ignored.
### :returns: The product.
secret routine b64_trig_dint_mul21(a: (U128, S64, U64), b: (U128, S64, U64)) -> (U128, S64, U64)
    var bh = b64_trig_hi(r: b.item0)
    var hi = b64_trig_mul64(a: b64_trig_hi(r: a.item0), b: bh)
    var lo = b64_trig_mul64(a: b64_trig_lo(r: a.item0), b: bh)
    var r = hi +% (lo >>> 64)
    return b64_trig_dint_mul_finish(r: r, ex: a.item1 + b.item1, sgn: a.item2 ^ b.item2)

### Converts a non-zero `B64` to a dint.
### :param b: The value.
### :returns: The dint equal to `b`.
secret routine b64_trig_dint_fromd(b: B64) -> (U128, S64, U64)
    var u = b.to_bits()
    var e = (u >>> 52) & 0x7FF_u64
    var m = u & 0x000FFFFFFFFFFFFF_u64
    if e != 0
        m = m + (1_u64 << 52)
    var ex = LLVM::reinterpret_bits[U64, S64](e) - 0x3FE
    var t = m.leading_zeros()
    var sgn = 0_u64
    if b < 0.0
        sgn = 1_u64
    var hi = m << LLVM::int_truncate[U64, U32](t)
    if t > 11
        ex = ex - LLVM::reinterpret_bits[U64, S64](t - 12)
    return (b64_trig_u128(hi: hi, lo: 0_u64), ex, sgn)

### Converts a dint to the nearest `B64` (ties to even).
### :param a: The dint.
### :returns: The rounded value.
secret routine b64_trig_dint_tod(a: (U128, S64, U64)) -> B64
    var hi = b64_trig_hi(r: a.item0)
    var lo = b64_trig_lo(r: a.item0)
    var aex = a.item1
    var sgn = a.item2
    # subnormal results: round the significand to the available precision
    if aex <= -1023
        var sh = LLVM::int_truncate[S64, U32](-(1011 + aex))
        var h = hi >>> sh
        var md = (hi >>> sh - 1) & 1_u64
        var sticky = (hi & (0xFFFFFFFFFFFFFFFF_u64 >>> sh)) != 0 or lo != 0
        if sticky
            h = h + md
        else
            h = h + (h & md)
        hi = h << sh
        lo = 0_u64
        if hi == 0
            aex = aex + 1
            hi = 1_u64 << 63
    var rbits = (hi >>> 11) | (0x3FF_u64 << 52)
    var rd = 0.0
    if ((hi >>> 10) & 1_u64) != 0
        rd = rd +! 0x1p-53
    if (hi & 0x3FF_u64) != 0 or lo != 0
        rd = rd +! 0x1p-54
    if sgn != 0
        rd = -rd
    var r = B64.from_bits(bits: rbits | (sgn << 63))
    r = r +! rd
    var e = 0.0
    if aex > -1022
        if aex > 1024
            if aex == 1025
                r = r *! 0x1p+1
                e = 0x1p+1023
            else
                r = 0x1.FFFFFFFFFFFFFp+1023
                e = 0x1.FFFFFFFFFFFFFp+1023
        else
            e = B64.from_bits(bits: (LLVM::reinterpret_bits[S64, U64](aex + 1022) & 0x7FF_u64) << 52)
    else
        if aex < -1073
            if aex == -1074
                r = r *! 0x1p-1
                e = 0x1p-1074
            else
                r = 0x1p-1074
                e = 0x1p-1074
        else
            e = B64.from_bits(bits: 1_u64 << LLVM::int_truncate[S64, U32](aex + 1073))
    return r *! e

### Error-free product `a * b = hi + lo`.
### :param a: The first factor.
### :param b: The second factor.
### :returns: `(hi, lo)`.
secret routine b64_trig_a_mul(a: B64, b: B64) -> (B64, B64)
    var hi = a *! b
    return (hi, LLVM::fma[B64](a: a, b: b, c: -hi))

### Product of a double and a double-double, `a * (bh + bl)`, with error bounded by ulp(lo).
### :param a: The double factor.
### :param bh: The high part of the double-double factor.
### :param bl: The low part of the double-double factor.
### :returns: `(hi, lo)`.
secret routine b64_trig_s_mul(a: B64, bh: B64, bl: B64) -> (B64, B64)
    var p = b64_trig_a_mul(a: a, b: bh)
    return (p.item0, LLVM::fma[B64](a: a, b: bl, c: p.item1))

### Double-double product `(ah + al) * (bh + bl)` without the `al * bl` term.
### :param ah: The high part of the first factor.
### :param al: The low part of the first factor.
### :param bh: The high part of the second factor.
### :param bl: The low part of the second factor.
### :returns: `(hi, lo)`.
secret routine b64_trig_d_mul(ah: B64, al: B64, bh: B64, bl: B64) -> (B64, B64)
    var p = b64_trig_a_mul(a: ah, b: bh)
    var t = LLVM::fma[B64](a: al, b: bh, c: p.item1)
    return (p.item0, LLVM::fma[B64](a: ah, b: bl, c: t))

### Error-free sum `a + b = hi + lo` for |a| >= |b| (Fast2Sum).
### :param a: The larger operand.
### :param b: The smaller operand.
### :returns: `(hi, lo)`.
secret routine b64_trig_fast_two_sum(a: B64, b: B64) -> (B64, B64)
    var hi = a +! b
    var e = hi -! a
    return (hi, b -! e)

### Double-double approximation of sin2pi(xh + xl) for -2^-24 <= xh + xl < 2^-11 + 2^-24, given
### uh + ul ~ (xh + xl)^2 (degree-7 odd polynomial).
### :param xh: The high part of the argument.
### :param xl: The low part of the argument.
### :param uh: The high part of the argument's square.
### :param ul: The low part of the argument's square.
### :returns: `(h, l)`.
secret routine b64_trig_eval_ps_fast(xh: B64, xl: B64, uh: B64, ul: B64) -> (B64, B64)
    var h = -0x1.331554CA19669p6
    h = LLVM::fma[B64](a: h, b: uh, c: 0x1.466BC678D8D63p6)
    h = LLVM::fma[B64](a: h, b: uh, c: -0x1.4ABBCE625BE53p5)
    var p = b64_trig_s_mul(a: h, bh: uh, bl: ul)
    var s = b64_trig_fast_two_sum(a: 0x1.921FB54442D18p+2, b: p.item0)
    var l = p.item1 +! (0x1.1A62645446203p-52 +! s.item1)
    # multiply by xh + xl
    return b64_trig_d_mul(ah: s.item0, al: l, bh: xh, bl: xl)

### Double-double approximation of cos2pi(x) for -2^-24 <= x < 2^-11 + 2^-24, given uh + ul ~ x^2
### (degree-6 even polynomial).
### :param uh: The high part of the argument's square.
### :param ul: The low part of the argument's square.
### :returns: `(h, l)`.
secret routine b64_trig_eval_pc_fast(uh: B64, ul: B64) -> (B64, B64)
    var h = -0x1.55A5C590F9E6Ap6
    h = LLVM::fma[B64](a: h, b: uh, c: 0x1.03C1F080AD892p6)
    h = LLVM::fma[B64](a: h, b: uh, c: -0x1.3BD3CC9BE45DEp4)
    var p = b64_trig_s_mul(a: h, bh: uh, bl: ul)
    var s = b64_trig_fast_two_sum(a: 0x1p+0, b: p.item0)
    return (s.item0, p.item1 +! (-0x1.923015Cp-77 +! s.item1))

### Builds a dint from its fields.
### :param hi: The high 64 bits of the significand.
### :param lo: The low 64 bits of the significand.
### :param ex: The exponent.
### :param sgn: The sign bit.
### :returns: The dint.
secret routine b64_trig_dint(hi: U64, lo: U64, ex: S64, sgn: U64) -> (U128, S64, U64)
    return (b64_trig_u128(hi: hi, lo: lo), ex, sgn)

### Dint approximation of sin2pi(X) for 0 <= X < 2^-11, given X2 ~ X^2 (degree-11 odd polynomial,
### relative error below 2^-124.648).
### :param x: X.
### :param x2: X^2.
### :returns: sin2pi(X).
secret routine b64_trig_eval_ps(x: (U128, S64, U64), x2: (U128, S64, U64)) -> (U128, S64, U64)
    var y = b64_trig_dint_mul21(
        a: x2,
        b: b64_trig_dint(
            hi: 0xF16AB2898EAE62F9_u64,
            lo: 0xA7F0339113B8B3C5_u64,
            ex: 4_s64,
            sgn: 1_u64,
        ),
    )
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0xA83C1A43BF1C6485_u64,
            lo: 0x7D5F8F76FA7D74ED_u64,
            ex: 6_s64,
            sgn: 0_u64,
        ),
    )
    y = b64_trig_dint_mul(a: y, b: x2)
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0x9969667315EC2D9D_u64,
            lo: 0xE59D6AB8509A2025_u64,
            ex: 7_s64,
            sgn: 1_u64,
        ),
    )
    y = b64_trig_dint_mul(a: y, b: x2)
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0xA335E33BAD570E92_u64,
            lo: 0x3F33BE0021AA54D2_u64,
            ex: 7_s64,
            sgn: 0_u64,
        ),
    )
    y = b64_trig_dint_mul(a: y, b: x2)
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0xA55DE7312DF295F5_u64,
            lo: 0x5DC72F712AA57DB4_u64,
            ex: 6_s64,
            sgn: 1_u64,
        ),
    )
    y = b64_trig_dint_mul(a: y, b: x2)
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0xC90FDAA22168C234_u64,
            lo: 0xC4C6628B80DC1CD1_u64,
            ex: 3_s64,
            sgn: 0_u64,
        ),
    )
    return b64_trig_dint_mul(a: y, b: x)

### Dint approximation of cos2pi(X) for 0 <= X < 2^-11, given X2 ~ X^2 (degree-10 even polynomial,
### error below 2^-125.999).
### :param x2: X^2.
### :returns: cos2pi(X).
secret routine b64_trig_eval_pc(x2: (U128, S64, U64)) -> (U128, S64, U64)
    var y = b64_trig_dint_mul21(
        a: x2,
        b: b64_trig_dint(
            hi: 0xD368F6F4207CFE49_u64,
            lo: 0x0EC63157807EBFFA_u64,
            ex: 5_s64,
            sgn: 1_u64,
        ),
    )
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0xF0FA83448DD1E094_u64,
            lo: 0x0E0603CE7044EEBA_u64,
            ex: 6_s64,
            sgn: 0_u64,
        ),
    )
    y = b64_trig_dint_mul(a: y, b: x2)
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0xAAE9E3F1E5FFCFE2_u64,
            lo: 0xA508509534006249_u64,
            ex: 7_s64,
            sgn: 1_u64,
        ),
    )
    y = b64_trig_dint_mul(a: y, b: x2)
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0x81E0F840DAD61D9A_u64,
            lo: 0x9980F00630CB655E_u64,
            ex: 7_s64,
            sgn: 0_u64,
        ),
    )
    y = b64_trig_dint_mul(a: y, b: x2)
    y = b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(
            hi: 0x9DE9E64DF22EF2D2_u64,
            lo: 0x56E26CD9808C1949_u64,
            ex: 5_s64,
            sgn: 1_u64,
        ),
    )
    y = b64_trig_dint_mul(a: y, b: x2)
    return b64_trig_dint_add(
        a0: y,
        b0: b64_trig_dint(hi: 0x8000000000000000_u64, lo: 0_u64, ex: 1_s64, sgn: 0_u64),
    )

### Normalizes a dint so that the top bit of its significand is set (unless it is zero).
### :param x: The dint.
### :returns: The normalized dint.
secret routine b64_trig_normalize(x: (U128, S64, U64)) -> (U128, S64, U64)
    if x.item0 == LLVM::zero_extend[U64, U128](0_u64)
        return x
    var cnt = x.item0.leading_zeros()
    return (
        x.item0 << LLVM::int_truncate[U128, U32](cnt),
        x.item1 - LLVM::reinterpret_bits[U64, S64](LLVM::int_truncate[U128, U64](cnt)), x.item2,
    )

### Word `j` of the 1/(2pi) table: 1/(2pi) ~ sum of `T[j] / 2^(64(j+1))`.
### :param j: The word index, 0 <= j < 20.
### :returns: The table word.
secret routine b64_trig_t(j: U64) -> U64
    return B64_TRIG_T[j]

### Reduces a normalized non-negative dint X to X/(2pi) mod 1, with relative error below 2^-126.67;
### the result is normalized.
### :param x: The normalized dint.
### :returns: X/(2pi) mod 1.
secret routine b64_trig_reduce(x: (U128, S64, U64)) -> (U128, S64, U64)
    var e = x.item1
    var xhi = b64_trig_hi(r: x.item0)
    if e <= 1
        # |X| < 2: multiply by T[0]/2^64 + T[1]/2^128
        var u = b64_trig_mul64(a: xhi, b: b64_trig_t(j: 1_u64))
        var tiny = b64_trig_lo(r: u)
        var lo = b64_trig_hi(r: u)
        u = b64_trig_mul64(a: xhi, b: b64_trig_t(j: 0_u64))
        lo = lo +% b64_trig_lo(r: u)
        var carry = 0_u64
        if lo < b64_trig_lo(r: u)
            carry = 1_u64
        var hi = b64_trig_hi(r: u) +% carry
        var y = b64_trig_normalize(x: (b64_trig_u128(hi: hi, lo: lo), x.item1, x.item2))
        var d = x.item1 - y.item1
        if d != 0
            # put the upper d bits of tiny into the low word
            var extra = tiny >>> LLVM::int_truncate[S64, U32](64 - d)
            y = (y.item0 | LLVM::zero_extend[U64, U128](extra), y.item1, y.item2)
        return y
    # now 2 <= e <= 1024: only T[i] .. T[i+4] contribute
    var i = 0_u64
    if e >= 127
        i = LLVM::reinterpret_bits[S64, U64]((e - 127 + 64 - 1) // 64)
    var u = b64_trig_mul64(a: xhi, b: b64_trig_t(j: i + 3))
    var c0 = b64_trig_lo(r: u)
    var c1 = b64_trig_hi(r: u)
    u = b64_trig_mul64(a: xhi, b: b64_trig_t(j: i + 2))
    c1 = c1 +% b64_trig_lo(r: u)
    var c2 = b64_trig_hi(r: u)
    if c1 < b64_trig_lo(r: u)
        c2 = c2 +% 1
    u = b64_trig_mul64(a: xhi, b: b64_trig_t(j: i + 1))
    c2 = c2 +% b64_trig_lo(r: u)
    var c3 = b64_trig_hi(r: u)
    if c2 < b64_trig_lo(r: u)
        c3 = c3 +% 1
    u = b64_trig_mul64(a: xhi, b: b64_trig_t(j: i))
    c3 = c3 +% b64_trig_lo(r: u)
    var c4 = b64_trig_hi(r: u)
    if c3 < b64_trig_lo(r: u)
        c4 = c4 +% 1
    # hi*T[i]/2^128 is multiplied by 2^f
    var f = e - 64 * LLVM::reinterpret_bits[U64, S64](i)
    var hi = 0_u64
    var lo = 0_u64
    var tiny = 0_u64
    if f < 64
        var fs = LLVM::int_truncate[S64, U32](f)
        hi = (c4 << fs) | (c3 >>> 64_u32 - fs)
        lo = (c3 << fs) | (c2 >>> 64_u32 - fs)
        tiny = (c2 << fs) | (c1 >>> 64_u32 - fs)
    elseif f == 64
        hi = c3
        lo = c2
        tiny = c1
    else
        # 65 <= f <= 127: one extra term
        var g = LLVM::int_truncate[S64, U32](f - 64)
        var w = b64_trig_hi(r: b64_trig_mul64(a: xhi, b: b64_trig_t(j: i + 4)))
        c0 = c0 +% w
        if c0 < w
            c1 = c1 +% 1
            if c1 == 0
                c2 = c2 +% 1
                if c2 == 0
                    c3 = c3 +% 1
        hi = (c3 << g) | (c2 >>> 64_u32 - g)
        lo = (c2 << g) | (c1 >>> 64_u32 - g)
        tiny = (c1 << g) | (c0 >>> 64_u32 - g)
    var y = b64_trig_normalize(x: (b64_trig_u128(hi: hi, lo: lo), 0_s64, x.item2))
    if y.item1 < 0
        # put the upper -ex bits of tiny into the low word
        var extra = tiny >>> LLVM::int_truncate[S64, U32](64 + y.item1)
        y = (y.item0 | LLVM::zero_extend[U64, U128](extra), y.item1, y.item2)
    return y

### Splits 0 <= X < 1 exactly as i/2^11 + X' with 0 <= X' < 2^-11.
### :param x: The normalized dint X.
### :returns: `(i, X')`, X' normalized.
secret routine b64_trig_reduce2(x: (U128, S64, U64)) -> (U64, (U128, S64, U64))
    if x.item1 <= -11
        return (0_u64, x)
    var sh = LLVM::int_truncate[S64, U32](64 - 11 - x.item1)
    var hi = b64_trig_hi(r: x.item0)
    var i = hi >>> sh
    hi = hi & (1_u64 << sh) - 1
    return (
        i,
        b64_trig_normalize(
            x: (b64_trig_u128(hi: hi, lo: b64_trig_lo(r: x.item0)), x.item1, x.item2),
        ),
    )

### Truncates c1/2^64 + c0/2^128 to a double-double.
### :param c1: The high word.
### :param c0: The low word.
### :returns: `(h, l)`.
secret routine b64_trig_set_dd(c1_in: U64, c0_in: U64) -> (B64, B64)
    var c1 = c1_in
    var c0 = c0_in
    if c1 != 0
        var e = c1.leading_zeros()
        if e != 0
            var es = LLVM::int_truncate[U64, U32](e)
            c1 = (c1 << es) | (c0 >>> 64_u32 - es)
            c0 = c0 << es
        var f = 0x3FE_u64 - e
        var h = B64.from_bits(bits: (f << 52) | (c1 << 1 >>> 12))
        c0 = (c1 << 53) | (c0 >>> 11)
        if c0 != 0
            var g = c0.leading_zeros()
            if g != 0
                c0 = c0 << LLVM::int_truncate[U64, U32](g)
            return (h, B64.from_bits(bits: (f -% 53 -% g << 52) | (c0 << 1 >>> 12)))
        return (h, 0.0)
    if c0 != 0
        var e = c0.leading_zeros()
        var f = 0x3FE_u64 -% 64 -% e
        # the most significant bit is shifted out
        c0 = c0 << LLVM::int_truncate[U64, U32](e + 1)
        var h = B64.from_bits(bits: (f << 52) | (c0 >>> 12))
        c0 = c0 << 52
        if c0 != 0
            var g = c0.leading_zeros()
            c0 = c0 << LLVM::int_truncate[U64, U32](g + 1)
            return (h, B64.from_bits(bits: (f -% 64 -% g << 52) | (c0 >>> 12)))
        return (h, 0.0)
    return (0.0, 0.0)

### The first two words of the reduction of a large x (> 0x1.921fb54442d17p+2): returns c1, c0 with
### c1/2^64 + c0/2^128 ~ frac(x/(2pi)). With `with_t2`, the upper part of the next product is added in (as
### the tangent does), else it is dropped (as the cosine does).
### :param x: The argument.
### :param with_t2: Whether to add the upper part of the next table product.
### :returns: `(c1, c0)`.
secret routine b64_trig_reduce_fast_large(x: B64, with_t2: Bool) -> (U64, U64)
    var ux = x.to_bits()
    var e = (ux >>> 52) & 0x7FF_u64
    var m = (1_u64 << 52) | ux & 0x000FFFFFFFFFFFFF_u64
    var c0 = 0_u64
    var c1 = 0_u64
    var c2 = 0_u64
    var bits = 0_u64
    var i = 0_u64
    if e > 1074
        i = (e - 1075) // 64
    if e <= 1074
        # 2^2 <= x < 2^52
        var u = b64_trig_mul64(a: m, b: b64_trig_t(j: 1_u64))
        c0 = b64_trig_lo(r: u)
        c1 = b64_trig_hi(r: u)
        if with_t2
            c0 = c0 +% b64_trig_hi(r: b64_trig_mul64(a: m, b: b64_trig_t(j: 2_u64)))
            if c0 < b64_trig_lo(r: u)
                c1 = c1 +% 1
        u = b64_trig_mul64(a: m, b: b64_trig_t(j: 0_u64))
        c1 = c1 +% b64_trig_lo(r: u)
        c2 = b64_trig_hi(r: u)
        if c1 < b64_trig_lo(r: u)
            c2 = c2 +% 1
        bits = 1075 - e
    else
        # 2^52 <= x < 2^1024
        var u = b64_trig_mul64(a: m, b: b64_trig_t(j: i + 2))
        c0 = b64_trig_lo(r: u)
        c1 = b64_trig_hi(r: u)
        if with_t2
            c0 = c0 +% b64_trig_hi(r: b64_trig_mul64(a: m, b: b64_trig_t(j: i + 3)))
            if c0 < b64_trig_lo(r: u)
                c1 = c1 +% 1
        u = b64_trig_mul64(a: m, b: b64_trig_t(j: i + 1))
        c1 = c1 +% b64_trig_lo(r: u)
        c2 = b64_trig_hi(r: u)
        if c1 < b64_trig_lo(r: u)
            c2 = c2 +% 1
        u = b64_trig_mul64(a: m, b: b64_trig_t(j: i))
        c2 = c2 +% b64_trig_lo(r: u)
        bits = 1139 + (i << 6) - e
    # bits is the number of low bits of c2 contributing to frac(x/(2pi))
    if bits == 64
        return (c2, c1)
    var bs = LLVM::int_truncate[U64, U32](bits)
    c0 = (c1 << 64_u32 - bs) | (c0 >>> bs)
    c1 = (c2 << 64_u32 - bs) | (c1 >>> bs)
    return (c1, c0)

### Fast argument reduction for x > 0x1.6a09e667f3bccp-27: returns `(i, h, l, err1)` with i/2^11 + h + l
### approximating frac(x/(2pi)), 0 <= i < 2^11, and err1 the cosine's bound on its absolute error.
### :param x: The argument, finite and positive.
### :param with_t2: Whether the large-x reduction adds the upper part of the next table product.
### :returns: `(i, h, l, err1)`.
secret routine b64_trig_reduce_fast(x: B64, with_t2: Bool) -> (U64, B64, B64, B64)
    var h = 0.0
    var l = 0.0
    var err1 = 0x1.01p-76
    if x <= 0x1.921FB54442D17p+2
        # |CH + CL - 1/(2pi)| < 2^-110.523
        var p = b64_trig_a_mul(a: 0x1.45F306DC9C883p-3, b: x)
        h = p.item0
        l = LLVM::fma[B64](a: -0x1.6B01EC5417056p-57, b: x, c: p.item1)
        # error < 2^-104.116 * h
        err1 = 0x1.D9p-105 *! h
    else
        var c = b64_trig_reduce_fast_large(x: x, with_t2: with_t2)
        var d = b64_trig_set_dd(c1_in: c.item0, c0_in: c.item1)
        h = d.item0
        l = d.item1
    var fi = LLVM::floor[B64](h *! 0x1p11)
    h = LLVM::fma[B64](a: fi, b: -0x1p-11, c: h)
    return (LLVM::float_to_unsigned[B64, U64](fi), h, l, err1)

### The dint entry `i` (0 <= i < 256) of the sin2pi(i/2^11) table.
### :param i: The index.
### :returns: The dint.
secret routine b64_trig_s(i: U64) -> (U128, S64, U64)
    return (
        b64_trig_u128(hi: B64_TRIG_S[2 * i], lo: B64_TRIG_S[2 * i + 1]), B64_TRIG_S_EX[i], 0_u64,
    )

### The dint entry `i` (0 <= i < 256) of the cos2pi(i/2^11) table.
### :param i: The index.
### :returns: The dint.
secret routine b64_trig_c(i: U64) -> (U128, S64, U64)
    return (
        b64_trig_u128(hi: B64_TRIG_C[2 * i], lo: B64_TRIG_C[2 * i + 1]), B64_TRIG_C_EX[i], 0_u64,
    )

### The dint 2^-11.
### :returns: `(2^127, -10, 0)`.
secret routine b64_trig_magic() -> (U128, S64, U64)
    return b64_trig_dint(hi: 0x8000000000000000_u64, lo: 0_u64, ex: -10_s64, sgn: 0_u64)

### The accurate reduction shared by cos and tan: reduces |x| to R = i/2^11 + X with 0 <= R < 1/4
### (using the symmetries up to pi/2), and returns sin2pi and cos2pi of the pieces.
### :param ax: |x|, a finite positive value.
### :returns: `(i, quadrant, X, cos2pi(X), sin2pi(X))`, where quadrant holds bit 0 = i was >= 2^10
### (pi <= x mod 2pi), bit 1 = i mod 2^10 was >= 2^9, bit 2 = i mod 2^9 was >= 2^8.
secret routine b64_trig_accurate_reduce(ax: B64) -> (U64, U64, (U128, S64, U64), (U128, S64, U64), (U128, S64, U64))
    var xd = b64_trig_reduce(x: b64_trig_dint_fromd(b: ax))
    var r2 = b64_trig_reduce2(x: xd)
    var i = r2.item0
    var xx = r2.item1
    var quadrant = 0_u64
    if (i & 0x400_u64) != 0
        quadrant = quadrant | 1_u64
        i = i & 0x3FF_u64
    if (i & 0x200_u64) != 0
        quadrant = quadrant | 2_u64
        i = i & 0x1FF_u64
    if (i & 0x100_u64) != 0
        quadrant = quadrant | 4_u64
        # X -> 2^-11 - X
        xx = b64_trig_dint_add(a0: b64_trig_magic(), b0: (xx.item0, xx.item1, 1_u64))
        i = 0x1FF_u64 - i
    var x2 = b64_trig_dint_mul(a: xx, b: xx)
    var u = b64_trig_eval_pc(x2: x2)
    var v = b64_trig_eval_ps(x: xx, x2: x2)
    return (i, quadrant, xx, u, v)
