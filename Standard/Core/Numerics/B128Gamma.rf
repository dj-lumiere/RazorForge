# ln(2 pi) / 2 in units of 2^-148 (hi, lo words).
secret preset B128_HALF_LN_2PI_HI: U128 = 0x000000000000000000000000000EB3F8_u128
secret preset B128_HALF_LN_2PI_LO: U128 = 0xE4325F5A53494BC900144192023CFB09_u128
# Thresholds as B128 bit patterns: 1/2, 3/2, 5/2, 24, 2^20 and 1756 (beyond it tgamma overflows).
secret preset B128_GAMMA_HALF: U128 = 0x3FFE0000000000000000000000000000_u128
secret preset B128_GAMMA_3HALF: U128 = 0x3FFF8000000000000000000000000000_u128
secret preset B128_GAMMA_5HALF: U128 = 0x40004000000000000000000000000000_u128
secret preset B128_GAMMA_24: U128 = 0x40038000000000000000000000000000_u128
secret preset B128_GAMMA_2P20: U128 = 0x40130000000000000000000000000000_u128
secret preset B128_GAMMA_MAX: U128 = 0x4009B700000000000000000000000000_u128
# pi as a 128-bit significand (exponent -126) and ln(pi) likewise (exponent -127), rounded.
secret preset B128_GAMMA_PI_M: U128 = 0xC90FDAA22168C234C4C6628B80DC1CD1_u128
secret preset B128_GAMMA_LNPI_M: U128 = 0x928682473D0DE85EAFCAB635421FA4CC_u128

### ln(x) for a positive normal B128 x as a B128Fx: the CORE-MATH fixed-point value (12 units of 2^-148),
### or log1p(x - 1) within 2^-21 of 1 (x - 1 is exact there).
secret routine b128_ln_fx(x: B128) -> (Bool, B128Fx)
    var (ok, hi, lo) = b128_log_scaled_ok(x: x)
    if ok
        var (lneg, mag) = b128_fs_magnitude(fs: b128_log_fs(hi: hi, lo: lo))
        if mag == 0_u256
            return (false, b128fx_one())
        return (true, b128fx_norm(neg: lneg, mag: mag, scale: -148_s64, abserr: 12.0))
    var u = x.to_bits()
    if u < (0x0001_u128 << 112_u32) or u >= (0x7FFF_u128 << 112_u32)
        return (false, b128fx_one())
    var d = x -! B128.from_bits(bits: 0x3FFF_u128 << 112_u32)
    if d.is_zero()
        return (false, b128fx_one())
    return b128fx_log1p(t: b128fx_of(x: d))

### e^w for a B128Fx w with |w| < 1, or false: w splits into its B128 truncation wb and the rest wl
### (|wl| < 2^-111 |w|), e^w = e^wb (1 + wl) with wl^2/2 below 2^-200 dropped, and below 2^-100 simply
### e^w = 1 + w (w^2/2 below 2^-200 of it). acc takes e^wb from the exponential's accurate phase.
secret routine b128fx_exp_small(w: B128Fx, acc: Bool) -> (Bool, B128Fx)
    if w.e < -228_s64
        var (ok0, r0) = b128fx_add(a: b128fx_one(), b: w)
        return (ok0, B128Fx(neg: false, m: r0.m, e: r0.e, rel: r0.rel +! 0x1p-199))
    var (okb, wb) = b128fx_to_b128(v: w)
    if not okb
        return (false, w)
    var (oke, ez) = b128_exp_fx(x: wb, acc: acc)
    if not oke
        return (false, w)
    var (okl, wl) = b128fx_add(a: w, b: b128fx_neg(v: b128fx_of(x: wb)))
    if not okl
        # w is exactly wb, up to its own error
        return (true, B128Fx(neg: false, m: ez.m, e: ez.e, rel: ez.rel +! w.rel *! 1.001))
    var (oko, onep) = b128fx_add(a: b128fx_one(), b: wl)
    if not oko
        return (false, w)
    var r = b128fx_mul(a: ez, b: onep)
    return (true, B128Fx(neg: false, m: r.m, e: r.e, rel: r.rel +! 0x1p-190))

### lgamma(2 + z) / z for an exact B128 z with |z| <= 1/2, as a B128Fx: the expansion around the nearest
### centre i/32 in t = z - i/32 (|t| <= 1/64), 19 terms in units of 2^-126 by Horner. Each step adds at most
### 1.5 units and |t| <= 1/64 damps the earlier ones, so the sum is within 1.6 units, plus 0.05 for the rest
### and one for z's own truncation to 2^-126 (the sum's slope is below 1), against a value of at least 0.24.
secret routine b128_lgamma2_q(z: B128) -> B128Fx
    if z.is_zero()
        return b128_lgamma2_q_fx(zf: B128Fx(neg: false, m: 0_u128, e: 0_s64, rel: 0.0))
    return b128_lgamma2_q_fx(zf: b128fx_of(x: z))

### b128_lgamma2_q for a B128Fx z (|z| <= 1/2, m = 0 for z = 0): z's own error moves the sum by at most
### |z| z.rel (the sum's slope is below 1).
secret routine b128_lgamma2_q_fx(zf: B128Fx) -> B128Fx
    var zs = 0_s128
    if zf.m != 0_u128
        var sh = 0_s64 -% (zf.e +% 126_s64)
        var mag = 0_u128
        if sh < 128_s64
            mag = zf.m >>> b128_trig_sh(n: sh)
        zs = LLVM::reinterpret_bits[U128, S128](mag)
        if zf.neg
            zs = 0_s128 -% zs
    # the centre i/32 nearest z (|z| <= 1/2, so -16 <= i <= 16) and t = z - i/32, exact in these units
    var i = zs +% (1_s128 << 120_u32) >> 121_u32
    var ts = zs -% (i << 121_u32)
    var base = LLVM::int_truncate[S128, U64](i +% 16_s128) *% 19_u64
    var acc = B128_LGAMMA2_QC[base +% 18_u64]
    var j = 18_u64
    while j > 0_u64
        j = j -% 1_u64
        acc = B128_LGAMMA2_QC[base +% j] +% b128erf_smul(a: ts, b: acc)
    var extra = 0.0
    if zf.m != 0_u128 and zf.rel > 0.0
        extra = zf.rel *! b128fx_b64(v: zf) *! 0x1p126 *! 1.001
    return b128fx_norm(
        neg: false,
        mag: LLVM::zero_extend[U128, U256](LLVM::reinterpret_bits[S128, U128](acc)),
        scale: -126_s64,
        abserr: 4.0 +! extra,
    )

### The Stirling sum sum e_k u^(2k-1) (e_k = B_2k / (2k (2k - 1) 24^(2k - 1)), 20 terms, u = 24/x <= 1, the
### rest below the first omitted term, 2^-134) as a signed value in units of 2^-126 and its error bound
### in those units: each Horner step adds at most 1.5 units and u^2 <= 1 keeps the earlier ones, so 32
### units in all, plus the error of u (it moves the sum by less than its own size, below 1/12, times u's
### relative error).
secret routine b128_stirling_sum(x: B128) -> (Bool, S128)
    var (oku, u) = b128fx_div(
        a: B128Fx(neg: false, m: 3_u128 << 126_u32, e: -123_s64, rel: 0.0),
        b: b128fx_of(x: x),
    )
    if not oku
        return (false, 0_s128)
    var sh = 0_s64 -% (u.e +% 126_s64)
    if sh < 0_s64
        return (false, 0_s128)
    var um = 0_u128
    if sh < 128_s64
        um = u.m >>> b128_trig_sh(n: sh)
    var us = LLVM::reinterpret_bits[U128, S128](um)
    var u2 = b128erf_smul(a: us, b: us)
    var acc = B128_STIRLING_E[19]
    var k = 19_u64
    while k > 0_u64
        k = k -% 1_u64
        acc = B128_STIRLING_E[k] +% b128erf_smul(a: u2, b: acc)
    return (true, b128erf_smul(a: us, b: acc))

### lgamma(x) for 24 <= x < 2^20 as a signed fixed-point value in units of 2^-148 (S256) and its error
### bound in those units: (x - 1/2) ln x - x + ln(2 pi)/2 + the Stirling sum. The product (x - 1/2) ln x is
### formed from the whole 192-bit CORE-MATH logarithm (x - 1/2 is exact), only its lowest 64 bits dropped
### (as in pow), so it is within (x - 1/2) 12 units plus the truncations.
secret routine b128_lgamma_fixed(x: B128) -> (Bool, S256, B64)
    var (ok, hi, lo) = b128_log_scaled_ok(x: x)
    var (oks, s) = b128_stirling_sum(x: x)
    if not ok or not oks
        return (false, 0_s256, 0.0)
    var (lneg, mag) = b128_fs_magnitude(fs: b128_log_fs(hi: hi, lo: lo))
    var yf = b128fx_of(x: x -! B128.from_bits(bits: 0x3FFE_u128 << 112_u32))
    var mh = LLVM::int_truncate[U256, U128](mag >>> 64_u32)
    var ml = LLVM::int_truncate[U256, U128](mag & 0xFFFFFFFFFFFFFFFF_u256)
    var p1 = b128_trig_wmul(x: yf.m, y: mh)
    var p2 = b128_trig_wmul(x: yf.m, y: ml)
    var pw = ((LLVM::zero_extend[U128, U256](p1.item0) << 128_u32) | LLVM::zero_extend[U128, U256](p1.item1)) +% ((LLVM::zero_extend[U128, U256](p2.item0) << 64_u32) | LLVM::zero_extend[U128, U256](p2.item1 >>> 64_u32))
    # (x - 1/2) ln x = pw * 2^(ye - 84), to 2^-148: shift by ye + 64 (negative for x < 2^20)
    var shr = 0_s64 -% (yf.e +% 64_s64)
    if shr <= 0_s64
        return (false, 0_s256, 0.0)
    var a = LLVM::reinterpret_bits[U256, S256](pw >>> b128_trig_sh(n: shr))
    var xf = b128fx_of(x: x)
    var shl = xf.e +% 148_s64
    if shl < 0_s64
        return (false, 0_s256, 0.0)
    var xs = LLVM::reinterpret_bits[U256, S256](LLVM::zero_extend[U128, U256](xf.m) << b128_trig_sh(n: shl))
    var c = LLVM::reinterpret_bits[U256, S256]((LLVM::zero_extend[U128, U256](B128_HALF_LN_2PI_HI) << 128_u32) | LLVM::zero_extend[U128, U256](B128_HALF_LN_2PI_LO))
    var ss = LLVM::sign_extend[S128, S256](s) << 22_u32
    var z = a -% xs +% c +% ss
    # (x - 1/2) 12 units of ln x, the product's truncations (2 units of pw, below one unit here) and the shift,
    # the constant's rounding, and 33 units of 2^-126 for the Stirling sum
    var err = 12.0 *! b128fx_b64(v: yf) +! 4.0 +! 33.0 *! 0x1p22
    return (true, z, err)

### For 5/2 <= x < 24: z = x - m with m = round(x) (|z| <= 1/2, exact) and the product (x - 1)(x - 2) ...
### (x - m + 2), so that Gamma(x) = Gamma(2 + z) P. x is exact in units of 2^-112 there, so every factor
### is an exact integer in those units and each product keeps its top 128 bits (2^-127 each).
secret routine b128_gamma_shift(x: B128) -> (B128, B128Fx)
    var xf = b128fx_of(x: x)
    var xx = xf.m >>> b128_trig_sh(n: 0_s64 -% xf.e -% 112_s64)
    var m = xx +% (1_u128 << 111_u32) >>> 112_u32
    # z = x - m in units of 2^-112, back to an exact B128
    var zz = LLVM::reinterpret_bits[U128, S128](xx) -% LLVM::reinterpret_bits[U128, S128](m << 112_u32)
    var z = B128.from_bits(bits: 0_u128)
    if zz != 0_s128
        var zneg = zz < 0_s128
        var zmag = LLVM::reinterpret_bits[S128, U128](zz)
        if zneg
            zmag = 0_u128 -% zmag
        var lead = 127_s64 -% b128_trig_clz128(x: zmag)
        var sig = zmag << b128_trig_sh(n: 112_s64 -% lead)
        var bits = (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](lead -% 112_s64 +% 16383_s64)) << 112_u32) | sig -% (1_u128 << 112_u32)
        if zneg
            bits = bits | (1_u128 << 127_u32)
        z = B128.from_bits(bits: bits)
    var pm = 1_u128 << 127_u32
    var pe = -127_s64
    var k = 1_u128
    while k +% 2_u128 <= m
        var pr = b128_trig_wmul(x: pm, y: xx -% (k << 112_u32))
        var lz = b128_trig_clz128(x: pr.item0)
        pm = (pr.item0 << b128_trig_sh(n: lz)) | (pr.item1 >>> b128_trig_sh(n: 128_s64 -% lz))
        pe = pe -% 112_s64 +% 128_s64 -% lz
        k = k +% 1_u128
    var n = LLVM::int_truncate[U128, S64](m) -% 2_s64
    return (z, B128Fx(neg: false, m: pm, e: pe, rel: B64(from: n) *! 0x1p-127))

### lgamma(x) for a positive finite x as a B128Fx, or false (also for x <= 0, and at 1 and 2, where the
### value is exactly 0).
secret routine b128_lgamma_fx(x: B128) -> (Bool, B128Fx)
    var u = x.to_bits()
    if (u >>> 127_u32) != 0_u128
        return b128_lgamma_neg_fx(x: x)
    if u == 0_u128 or u >= (0x7FFF_u128 << 112_u32)
        return (false, b128fx_one())
    var one = B128.from_bits(bits: 0x3FFF_u128 << 112_u32)
    if u == (0x3FFF_u128 << 112_u32) or u == (0x4000_u128 << 112_u32)
        return (false, b128fx_one())
    var r = b128fx_one()
    if u < B128_GAMMA_HALF
        # lgamma(x) = lgamma(2 + x) - ln x - ln(1 + x)
        var g = b128fx_mul(a: b128fx_of(x: x), b: b128_lgamma2_q(z: x))
        var (ok1, lx) = b128_ln_fx(x: x)
        var (ok2, l1) = b128fx_log1p(t: b128fx_of(x: x))
        if not ok1 or not ok2
            return (false, b128fx_one())
        var (ok3, t) = b128fx_add(a: b128fx_neg(v: lx), b: b128fx_neg(v: l1))
        var (ok4, s) = b128fx_add(a: g, b: t)
        if not ok3 or not ok4
            return (false, b128fx_one())
        r = s
    elseif u < B128_GAMMA_3HALF
        # lgamma(x) = lgamma(2 + z) - ln(1 + z), z = x - 1
        var z = x -! one
        if z.is_zero()
            return (false, b128fx_one())
        var g = b128fx_mul(a: b128fx_of(x: z), b: b128_lgamma2_q(z: z))
        var (ok1, l1) = b128fx_log1p(t: b128fx_of(x: z))
        if not ok1
            return (false, b128fx_one())
        var (ok2, s) = b128fx_add(a: g, b: b128fx_neg(v: l1))
        if not ok2
            return (false, b128fx_one())
        r = s
    elseif u < B128_GAMMA_5HALF
        var z = x -! (one +! one)
        if z.is_zero()
            return (false, b128fx_one())
        r = b128fx_mul(a: b128fx_of(x: z), b: b128_lgamma2_q(z: z))
    elseif u < B128_GAMMA_24
        var (z, p) = b128_gamma_shift(x: x)
        var (ok0, pm1) = b128fx_add(a: p, b: b128fx_neg(v: b128fx_one()))
        if not ok0
            return (false, b128fx_one())
        var (ok1, lp) = b128fx_log1p(t: pm1)
        if not ok1
            return (false, b128fx_one())
        if z.is_zero()
            r = lp
        else
            var (ok2, s) = b128fx_add(
                a: lp,
                b: b128fx_mul(a: b128fx_of(x: z), b: b128_lgamma2_q(z: z)),
            )
            if not ok2
                return (false, b128fx_one())
            r = s
    elseif u < B128_GAMMA_2P20
        var (okf, zf, err) = b128_lgamma_fixed(x: x)
        if not okf or zf <= 0_s256
            return (false, b128fx_one())
        r = b128fx_norm(
            neg: false,
            mag: LLVM::reinterpret_bits[S256, U256](zf),
            scale: -148_s64,
            abserr: err,
        )
    else
        # (x - 1/2) ln x - x + ln(2 pi)/2 + the Stirling sum, all positive-dominated from here
        var (okl, lx) = b128_ln_fx(x: x)
        var (oks, s) = b128_stirling_sum(x: x)
        if not okl or not oks
            return (false, b128fx_one())
        # x - 1/2 is exact in B128 below 2^112. From there x's unit is 1 and the B128 difference would round, so
        # it is formed in B128Fx, whose 128-bit significand holds it exactly
        var xh = b128fx_of(x: x -! B128.from_bits(bits: 0x3FFE_u128 << 112_u32))
        if u >= (0x406F_u128 << 112_u32)
            var (okh, xhf) = b128fx_add(
                a: b128fx_of(x: x),
                b: b128fx_of(x: B128.from_bits(bits: 0xBFFE_u128 << 112_u32)),
            )
            if not okh
                return (false, b128fx_one())
            xh = xhf
        var a = b128fx_mul(a: xh, b: lx)
        var (ok1, b) = b128fx_add(a: a, b: b128fx_neg(v: b128fx_of(x: x)))
        var c = b128fx_norm(
            neg: false,
            mag: (LLVM::zero_extend[U128, U256](B128_HALF_LN_2PI_HI) << 128_u32) | LLVM::zero_extend[U128, U256](B128_HALF_LN_2PI_LO),
            scale: -148_s64,
            abserr: 1.0,
        )
        var (ok2, d) = b128fx_add(a: b, b: c)
        if not ok1 or not ok2
            return (false, b128fx_one())
        r = d
        if s != 0_s128
            var sneg = s < 0_s128
            var smag = LLVM::reinterpret_bits[S128, U128](s)
            if sneg
                smag = 0_u128 -% smag
            var (ok3, e) = b128fx_add(
                a: d,
                b: b128fx_norm(
                    neg: sneg,
                    mag: LLVM::zero_extend[U128, U256](smag),
                    scale: -126_s64,
                    abserr: 33.0,
                ),
            )
            if not ok3
                return (false, b128fx_one())
            r = e
    return (true, r)

### tgamma(x) for a positive finite x as a B128Fx, or false (also for x <= 0 or at overflow, which the
### caller settles), its exponentials from the fast phase or with acc the accurate one.
secret routine b128_tgamma_fx(x: B128, acc: Bool) -> (Bool, B128Fx)
    var u = x.to_bits()
    if (u >>> 127_u32) != 0_u128
        return b128_tgamma_neg_fx(x: x, acc: acc)
    if u == 0_u128 or u >= B128_GAMMA_MAX
        return (false, b128fx_one())
    var one = B128.from_bits(bits: 0x3FFF_u128 << 112_u32)
    if u >= B128_GAMMA_24
        var (okf, zf, err) = b128_lgamma_fixed(x: x)
        if not okf or zf <= 0_s256
            return (false, b128fx_one())
        # e^z with z split into its B128 truncation and the rest, as in pow
        var zm = LLVM::reinterpret_bits[S256, U256](zf)
        var lead = 255_s64 -% LLVM::int_truncate[U256, S64](LLVM::leading_zeros(zm))
        var sh = b128_trig_sh(n: lead -% 112_s64)
        var zsig = LLVM::int_truncate[U256, U128](zm >>> sh)
        var rest = zm & (1_u256 << sh) -% 1_u256
        var biased = lead -% 148_s64 +% 16383_s64
        var zb = B128.from_bits(bits: (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](biased)) << 112_u32) | zsig -% (1_u128 << 112_u32))
        var (oke, ez) = b128_exp_fx(x: zb, acc: acc)
        if not oke
            return (false, b128fx_one())
        var r = B128Fx(neg: false, m: ez.m, e: ez.e, rel: ez.rel +! err *! 1.001 *! 0x1p-148)
        if rest != 0_u256
            var (oko, onep) = b128fx_add(
                a: b128fx_one(),
                b: b128fx_norm(neg: false, mag: rest, scale: -148_s64, abserr: err),
            )
            if not oko
                return (false, b128fx_one())
            var rr = b128fx_mul(a: ez, b: onep)
            r = B128Fx(neg: false, m: rr.m, e: rr.e, rel: rr.rel +! 0x1p-190)
        return (true, r)
    var z = x
    var den = b128fx_one()
    var num = b128fx_one()
    if u < B128_GAMMA_HALF
        # Gamma(x) = Gamma(2 + x) / (x (1 + x))
        var (ok1, xp1) = b128fx_add(a: b128fx_one(), b: b128fx_of(x: x))
        if not ok1
            return (false, b128fx_one())
        den = b128fx_mul(a: b128fx_of(x: x), b: xp1)
    elseif u < B128_GAMMA_3HALF
        z = x -! one
        den = b128fx_of(x: x)
    elseif u < B128_GAMMA_5HALF
        z = x -! (one +! one)
    else
        var (zz, p) = b128_gamma_shift(x: x)
        z = zz
        num = p
    var g = b128fx_one()
    if not z.is_zero()
        var (okg, eg) = b128fx_exp_small(
            w: b128fx_mul(a: b128fx_of(x: z), b: b128_lgamma2_q(z: z)),
            acc: acc,
        )
        if not okg
            return (false, b128fx_one())
        g = eg
    var (okd, q) = b128fx_div(a: b128fx_mul(a: g, b: num), b: den)
    if not okd
        return (false, b128fx_one())
    return (true, q)

### (n - 1)! for a B128 x that is an integer n in [1, 57] (so the product fits in 256 bits), or false.
secret routine b128_gamma_int(x: B128) -> (Bool, U256)
    var u = x.to_bits()
    if (u >>> 127_u32) != 0_u128
        or u < (0x3FFF_u128 << 112_u32)
        or u >= 0x4004D000000000000000000000000000_u128
        return (false, 0_u256)
    var xf0 = b128fx_of(x: x)
    var sh0 = 0_s64 -% xf0.e
    if (xf0.m & (1_u128 << b128_trig_sh(n: sh0)) -% 1_u128) != 0_u128
        return (false, 0_u256)
    var n = xf0.m >>> b128_trig_sh(n: sh0)
    var f = 1_u256
    var j = 2_u128
    while j < n
        f = f *% LLVM::zero_extend[U128, U256](j)
        j = j +% 1_u128
    return (true, f)

### Gamma(x) for a negative non-integer B128 x as a B128Fx, or false. Above -1/2 by the small-x formula
### (Gamma(2 + x) / (x (1 + x)), the series taking a negative z too), from -1 to -1/2 as Gamma(2 + z) /
### (x z (1 + z)) with z = x + 1 exact, and below -1 by reflection, pi / (sin(pi x) Gamma(1 - x)) with
### Gamma(1 - x) = |x| Gamma(|x|) (|x| is exact where 1 - x may round).
secret routine b128_tgamma_neg_fx(x: B128, acc: Bool) -> (Bool, B128Fx)
    var a = x.to_bits() & (1_u128 << 127_u32) -% 1_u128
    if a == 0_u128 or a >= (0x7FFF_u128 << 112_u32)
        return (false, b128fx_one())
    var one = B128.from_bits(bits: 0x3FFF_u128 << 112_u32)
    var xf = b128fx_of(x: x)
    if a < B128_GAMMA_HALF
        var (ok1, xp1) = b128fx_add(a: b128fx_one(), b: xf)
        var (okg, g) = b128fx_exp_small(w: b128fx_mul(a: xf, b: b128_lgamma2_q(z: x)), acc: acc)
        if not ok1 or not okg
            return (false, xf)
        return b128fx_div(a: g, b: b128fx_mul(a: xf, b: xp1))
    if a <= (0x3FFF_u128 << 112_u32)
        var z = x +! one
        if z.is_zero()
            return (false, xf)
        var zf = b128fx_of(x: z)
        var (okg2, g2) = b128fx_exp_small(w: b128fx_mul(a: zf, b: b128_lgamma2_q(z: z)), acc: acc)
        var (okp, zp1) = b128fx_add(a: b128fx_one(), b: zf)
        if not okg2 or not okp
            return (false, xf)
        return b128fx_div(a: g2, b: b128fx_mul(a: b128fx_mul(a: xf, b: zf), b: zp1))
    # Gamma(1 - x) = |x| Gamma(|x|), |x| exact (1 - x itself may round)
    var (oks, sn) = b128_sinpi_fx(y: x)
    var (okg3, g3) = b128_tgamma_fx(x: B128.from_bits(bits: a), acc: acc)
    if not oks or not okg3
        return (false, xf)
    var den = b128fx_mul(
        a: b128fx_mul(a: sn, b: g3),
        b: B128Fx(neg: false, m: xf.m, e: xf.e, rel: 0.0),
    )
    return b128fx_div(a: B128Fx(neg: false, m: B128_GAMMA_PI_M, e: -126_s64, rel: 0x1p-128), b: den)

### lgamma(x) = ln|Gamma(x)| for a negative non-integer B128 x as a B128Fx, or false, by the forms of
### b128_tgamma_neg_fx taken in logarithms: x Q(x) - ln|x| - ln(1 + x) above -1/2, z Q(z) - ln|x| - ln z -
### ln(1 + z) from -1 to -1/2, and ln(pi) - ln|sin(pi x)| - lgamma(1 - x) below -1 (which cancels near the zeros of
### lgamma between the poles, where the band widens).
secret routine b128_lgamma_neg_fx(x: B128) -> (Bool, B128Fx)
    var a = x.to_bits() & (1_u128 << 127_u32) -% 1_u128
    if a == 0_u128 or a >= (0x7FFF_u128 << 112_u32)
        return (false, b128fx_one())
    var one = B128.from_bits(bits: 0x3FFF_u128 << 112_u32)
    var ax = B128.from_bits(bits: a)
    var xf = b128fx_of(x: x)
    var (okla, la) = b128_ln_fx(x: ax)
    if not okla
        return (false, xf)
    var first = b128fx_one()
    var second = b128fx_one()
    if a < B128_GAMMA_HALF
        first = b128fx_mul(a: xf, b: b128_lgamma2_q(z: x))
        var (ok1, l1) = b128fx_log1p(t: xf)
        if not ok1
            return (false, xf)
        second = l1
    elseif a <= (0x3FFF_u128 << 112_u32)
        var z = x +! one
        if z.is_zero()
            return (false, xf)
        var zf = b128fx_of(x: z)
        first = b128fx_mul(a: zf, b: b128_lgamma2_q(z: z))
        var (ok2, lz) = b128_ln_fx(x: z)
        var (ok4, l1z) = b128fx_log1p(t: zf)
        if not ok2 or not ok4
            return (false, xf)
        var (ok5, sz) = b128fx_add(a: lz, b: l1z)
        if not ok5
            return (false, xf)
        second = sz
    else
        # lgamma(1 - x) = ln|x| + lgamma(|x|), |x| exact (1 - x itself may round)
        var (oks, sn) = b128_sinpi_fx(y: x)
        var (okg0, lg0) = b128_lgamma_fx(x: ax)
        if not oks or not okg0
            return (false, xf)
        var (okg, lg) = b128fx_add(a: lg0, b: la)
        if not okg
            return (false, xf)
        var (okl, ls) = b128fx_ln(w: B128Fx(neg: false, m: sn.m, e: sn.e, rel: sn.rel))
        if not okl
            return (false, xf)
        var (oka, t) = b128fx_add(
            a: B128Fx(neg: false, m: B128_GAMMA_LNPI_M, e: -127_s64, rel: 0x1p-128),
            b: b128fx_neg(v: ls),
        )
        if not oka
            return (false, xf)
        return b128fx_add(a: t, b: b128fx_neg(v: lg))
    var (ok3, s1) = b128fx_add(a: first, b: b128fx_neg(v: la))
    if not ok3
        return (false, xf)
    return b128fx_add(a: s1, b: b128fx_neg(v: second))

### v with its relative bound raised by r.
@inline
secret routine b128fx_widen(v: B128Fx, r: B64) -> B128Fx
    return B128Fx(neg: v.neg, m: v.m, e: v.e, rel: v.rel +! r)

### ln(w) for a positive B128Fx w in the normal B128 range as a B128Fx, or false: w is split into its B128
### truncation v and the rest c (below 2^-112 v), and ln w = ln v + c/v, the CORE-MATH logarithm of v
### (at least 2^-21 away from 1, else log1p(w - 1) takes it) plus c times 1/v in B64 (ample for a term
### below 2^-110 of the result), (c/v)^2/2 (below 2^-220) dropped.
secret routine b128fx_ln(w: B128Fx) -> (Bool, B128Fx)
    var (okv, v) = b128fx_to_b128(v: w)
    if not okv or w.neg
        return (false, w)
    var (ok, hi, lo) = b128_log_scaled_ok(x: v)
    if not ok
        var (ok1, t) = b128fx_add(a: w, b: b128fx_neg(v: b128fx_one()))
        if not ok1
            return (false, w)
        return b128fx_log1p(t: t)
    var (lneg, mag) = b128_fs_magnitude(fs: b128_log_fs(hi: hi, lo: lo))
    if mag == 0_u256
        return (false, w)
    var l = b128fx_norm(neg: lneg, mag: mag, scale: -148_s64, abserr: 12.0)
    var (okc, c) = b128fx_add(a: w, b: b128fx_neg(v: b128fx_of(x: v)))
    if not okc
        return (true, b128fx_widen(v: l, r: w.rel *! 1.001 /! b128fx_b64(v: l)))
    var cv = b128fx_mul(a: c, b: b128fx_of_b64(v: 1.0 /! B64(from: v), rel: 0x1p-51))
    var (oka, s) = b128fx_add(a: l, b: cv)
    if not oka
        return (false, w)
    return (true, b128fx_widen(v: s, r: 0x1p-200))
