# ============================================================================
# Fast phases of B128 functions, for the D128 transcendentals (D128Fast.rf), built from the fast phases of
# CORE-MATH's exp, log, sqrt, sin and cos. The B128 functions themselves are Tessera's, through Ingrid.
# ============================================================================
# A fast phase gives its value before rounding, with a proven error bound: exp as a 128-bit significand
# within 6 units (b128_expfam_eval), log as a 192-bit fixed-point value within 12 units of 2^-148
# (b128_log_fs), sin and cos as 128-bit fractions within 16 units (b128_trig_fast_tail). The functions here
# combine those values in B128Fx, a 128-bit float that carries a bound on its relative error through every
# product, sum and quotient.

### A real number (-1)^neg * m * 2^e with m in [2^127, 2^128), known to within rel * |value|.
secret record B128Fx
    neg: Bool
    m: U128
    e: S64
    rel: B64

### A finite nonzero B128 as a B128Fx (exact).
secret routine b128fx_of(x: B128) -> B128Fx
    var u = x.to_bits()
    var neg = (u >>> 127) != 0_u128
    var ex = LLVM::int_truncate[U128, S64]((u >>> 112) & 0x7FFF_u128)
    var f = u & (1_u128 << 112) -% 1_u128
    if ex == 0_s64
        var lz = b128_trig_clz128(x: f)
        return B128Fx(neg: neg, m: f << b128_trig_sh(n: lz), e: -16494_s64 -% lz, rel: 0.0)
    return B128Fx(neg: neg, m: (f | (1_u128 << 112)) << 15_u32, e: ex -% 16510_s64, rel: 0.0)

### 2^k as a B64, for -1022 <= k <= 1023.
@inline
secret routine b128fx_p2(k: S64) -> B64
    return B64.from_bits(bits: LLVM::reinterpret_bits[S64, U64](k +% 1023_s64) << 52_u32)

### The top 64 bits of a 128-bit m with its top bit set, as a B64 (within 2^-52 of m / 2^64).
@inline
secret routine b128fx_top(m: U128) -> B64
    return B64(from: LLVM::int_truncate[U128, U64](m >>> 64_u32))

### The 256-bit value hi * 2^128 + lo as a B64 within 2^-52 of it (its top 64 bits, rounded).
secret routine b128fx_wide_b64(hi: U128, lo: U128) -> B64
    if hi != 0_u128
        var lz = b128_trig_clz128(x: hi)
        var top = (hi << b128_trig_sh(n: lz)) | (lo >>> b128_trig_sh(n: 128_s64 -% lz))
        return b128fx_top(m: top) *! b128fx_p2(k: 192_s64 -% lz)
    if lo == 0_u128
        return 0.0
    var lz2 = b128_trig_clz128(x: lo)
    return b128fx_top(m: lo << b128_trig_sh(n: lz2)) *! b128fx_p2(k: 64_s64 -% lz2)

### A B128Fx from the fixed-point value (-1)^neg * mag * 2^scale known to within abserr units of 2^scale.
### mag must be nonzero. The bound divides by mag's top 64 bits (so it is 2^-52 loose at most), and adds
### the truncation to 128 bits. The 256-bit mag is handled as two 128-bit halves (a 256-bit shift by a
### variable amount is far costlier).
secret routine b128fx_norm(neg: Bool, mag: U256, scale: S64, abserr: B64) -> B128Fx
    var hi = LLVM::int_truncate[U256, U128](mag >>> 128_u32)
    var lo = LLVM::int_truncate[U256, U128](mag)
    var lead = 127_s64 -% b128_trig_clz128(x: lo)
    if hi != 0_u128
        lead = 255_s64 -% b128_trig_clz128(x: hi)
    var sh = lead -% 127_s64
    var m = lo
    if sh >= 128_s64
        m = hi >>> b128_trig_sh(n: sh -% 128_s64)
    elseif sh > 0_s64
        m = (hi << b128_trig_sh(n: 128_s64 -% sh)) | (lo >>> b128_trig_sh(n: sh))
    elseif sh < 0_s64
        m = lo << b128_trig_sh(n: 0_s64 -% sh)
    var rel = 0x1p-127
    if abserr != 0.0
        rel = abserr /! (b128fx_top(m: m) *! b128fx_p2(k: lead -% 63_s64)) +! 0x1p-127
    return B128Fx(neg: neg, m: m, e: scale +% lead -% 127_s64, rel: rel)

### a * b. The dropped low half of the product is below one unit of m.
secret routine b128fx_mul(a: B128Fx, b: B128Fx) -> B128Fx
    var p = b128_trig_wmul(x: a.m, y: b.m)
    var m = p.item0
    var e = a.e +% b.e +% 128_s64
    if (m >>> 127_u32) == 0_u128
        m = (m << 1_u32) | (p.item1 >>> 127_u32)
        e = e -% 1_s64
    return B128Fx(
        neg: a.neg != b.neg,
        m: m,
        e: e,
        rel: a.rel +! b.rel +! a.rel *! b.rel +! 0x1p-127,
    )

### a + b, false when it cancels to zero. The sum is formed in 256 bits as two 128-bit halves, x (the larger)
### on the high half and y shifted down by the exponent difference d (a y more than 130 places down only
### moves the sum by under a quarter unit of x, taken as one unit), then normalized and truncated to 128 bits.
### Cancellation scales the operands' absolute errors by the size of the sum, which the bound follows exactly.
secret routine b128fx_add(a: B128Fx, b: B128Fx) -> (Bool, B128Fx)
    var x = a
    var y = b
    if b.e > a.e or (b.e == a.e and b.m > a.m)
        x = b
        y = a
    var d = x.e -% y.e
    # absolute errors in units of x's last place: the operands' own, and 2^-60 of slack for the B64 estimates
    var yv = 0.0
    if d < 1000_s64
        yv = b128fx_top(m: y.m) *! b128fx_p2(k: 64_s64 -% d)
    var abserr = (x.rel *! b128fx_top(m: x.m) *! 0x1p64 +! y.rel *! yv) *! (1.0 +! 0x1p-50)
    if d > 130_s64
        return (
            true,
            B128Fx(
                neg: x.neg,
                m: x.m,
                e: x.e,
                rel: (abserr +! 1.0) /! (b128fx_top(m: x.m) *! 0x1p64) +! 0x1p-127,
            ),
        )
    # y aligned below x: (yh, yl) = y.m * 2^(128 - d), the bits past 2^-128 of x's unit dropped
    var yh = 0_u128
    var yl = 0_u128
    if d == 0_s64
        yh = y.m
    elseif d < 128_s64
        yh = y.m >>> b128_trig_sh(n: d)
        yl = y.m << b128_trig_sh(n: 128_s64 -% d)
    else
        yl = y.m >>> b128_trig_sh(n: d -% 128_s64)
    var hi = 0_u128
    var lo = 0_u128
    var e = x.e
    if x.neg == y.neg
        hi = x.m +% yh
        lo = yl
        if hi < x.m
            # the carry out of the top: one place up, the lowest bit into the truncation
            lo = (lo >>> 1_u32) | (hi << 127_u32)
            hi = (hi >>> 1_u32) | (1_u128 << 127_u32)
            e = e +% 1_s64
    else
        lo = 0_u128 -% yl
        var borrow = 0_u128
        if yl != 0_u128
            borrow = 1_u128
        hi = x.m -% yh -% borrow
    if hi == 0_u128 and lo == 0_u128
        return (false, x)
    var lz = b128_trig_clz128(x: hi)
    var m = hi
    if hi == 0_u128
        lz = 128_s64 +% b128_trig_clz128(x: lo)
        m = lo << b128_trig_sh(n: lz -% 128_s64)
    elseif lz > 0_s64
        m = (hi << b128_trig_sh(n: lz)) | (lo >>> b128_trig_sh(n: 128_s64 -% lz))
    var en = e -% lz
    # the sum in units of x's last place is m 2^(en - x.e); its truncation below 2^-128 units adds one of those
    var sv = b128fx_top(m: m) *! b128fx_p2(k: 64_s64 +% en -% x.e)
    var rel = (abserr +! 0x1p-127) /! sv *! (1.0 +! 0x1p-50) +! 0x1p-127
    return (true, B128Fx(neg: x.neg, m: m, e: en, rel: rel))

### a / b. The quotient T = floor(N / b.m) with N = a.m * 2^127 (2^128 when a.m < b.m, so T lands in [2^127, 2^128)),
### by two digits of Knuth's Algorithm D on 64-bit limbs (b.m is normalized, N's top 128 bits are below it):
### exact, so the quotient's own error is its truncation, under 2^-127.
secret routine b128fx_div(a: B128Fx, b: B128Fx) -> (Bool, B128Fx)
    var sh = 127_s64
    var top = a.m >>> 1_u32
    var x1 = LLVM::int_truncate[U128, U64](a.m & 1_u128) << 63_u32
    if a.m < b.m
        sh = 128_s64
        top = a.m
        x1 = 0_u64
    var e = a.e -% b.e -% sh
    var vrec = reciprocal_word(LLVM::int_truncate[U128, U64](b.m >>> 64_u32))
    var (q1, r1) = b128_knuth_digit(r: top, x: x1, v: b.m, vrec: vrec)
    var (q0, r0) = b128_knuth_digit(r: r1, x: 0_u64, v: b.m, vrec: vrec)
    var q = (LLVM::zero_extend[U64, U128](q1) << 64_u32) | LLVM::zero_extend[U64, U128](q0)
    var rel = a.rel +! b.rel +! 2.0 *! a.rel *! b.rel +! 2.0 *! b.rel *! b.rel +! 0x1.8p-126
    return (true, B128Fx(neg: a.neg != b.neg, m: q, e: e, rel: rel))

# ============================================================================
# exp, sinh, cosh, tanh
# ============================================================================

### e^x as a B128Fx for a finite x with 2^-114 <= |x| < 11356, or false for other x and for subnormal results:
### from the CORE-MATH exp fast phase (within 6 units of its 2^123-scaled significand, 7 taken), or with acc
### from its accurate phase (192 bits within 8 units, truncated to 128: within 2^-126), which a fast path
### retries with when the fast phase's band does not settle its rounding.
secret routine b128_exp_fx(x: B128, acc: Bool) -> (Bool, B128Fx)
    var u = x.to_bits()
    var hi = b128_expfam_hi(u: u)
    var lo = b128_expfam_lo(u: u)
    var b1 = hi & 0x7FFFFFFFFFFFFFFF_u64
    var nofx = B128Fx(neg: false, m: 0_u128, e: 0_s64, rel: 1.0)
    if b1 < 0x3F8D000000000000_u64 or b1 >= 0x400C62E42FEFA39E_u64
        return (false, nofx)
    if acc
        var (ael, f0, f1, f2) = b128_expfam_accurate_words(x0: u, kind: 0_u64)
        if ael < -16382_s64
            return (false, nofx)
        var am = (LLVM::zero_extend[U64, U128](f2) << 67_u32) | (LLVM::zero_extend[U64, U128](f1) << 3_u32) | (LLVM::zero_extend[U64, U128](f0) >>> 61_u32)
        return (true, B128Fx(neg: false, m: am, e: ael -% 127_s64, rel: 0x1p-126))
    var sm = b128_expfam_sar(v: hi, n: 63_u64)
    var m = b128_expfam_w(hi: hi & 0x0000FFFFFFFFFFFF_u64 | 0x0001000000000000_u64, lo: lo)
    var fs = b128_expfam_mh3x2(
        a0: B128_EXPFAM_ILN2[4],
        a1: B128_EXPFAM_ILN2[5],
        a2: B128_EXPFAM_ILN2[6],
        b: m,
    )
    var e = (hi >>> 48) & 0x7FFF_u64
    var r = b128_expfam_ars3(
        w0: fs.item0 ^ sm,
        w1: fs.item1 ^ sm,
        w2: fs.item2 ^ sm,
        n: 0x401A_u64 -% e,
    )
    var (el, res) = b128_expfam_eval(fs0: r.item0, fs1: r.item1, fs2: r.item2)
    if el < -16382_s64 or res == 0_u128
        return (false, nofx)
    var lz = b128_trig_clz128(x: res)
    return (
        true,
        B128Fx(
            neg: false,
            m: res << b128_trig_sh(n: lz),
            e: el -% 123_s64 -% lz,
            rel: 7.0 *! 0x1p-123,
        ),
    )

### sinh(x) for 0 < |x| < 1/4 as a B128Fx: x * (1 + T) with T = sum d_k w^k in units of 2^-128 by Horner
### (w = 4x^2 < 1/4). Each step adds at most 3.5 units (the table's rounding and the truncated product, which
### is up to 3 short) and scales the earlier error by w, so the sum is within 4.7 units and T within 4.2.
### 1 + T is kept to 2^-127, one more unit.
secret routine b128_sinh_small(x: B128Fx) -> B128Fx
    var p = b128_trig_wmul(x: x.m, y: x.m)
    # 4x^2 * 2^128 = p.hi * 2^(2e + 258), and |x| < 1/4 makes 2e + 258 <= -2
    var w = p.item0 >>> b128_trig_sh(n: 0_s64 -% (2_s64 *% x.e +% 258_s64))
    var acc = B128_SINH_POLY[11]
    var k = 11_u64
    while k > 0_u64
        k = k -% 1_u64
        acc = B128_SINH_POLY[k] +% b128_trig_mhi(x: w, y: acc)
    var t = b128_trig_mhi(x: w, y: acc)
    var one = B128Fx(
        neg: false,
        m: (1_u128 << 127_u32) | (t >>> 1_u32),
        e: -127_s64,
        rel: 0x1.8p-125,
    )
    return b128fx_mul(a: x, b: one)

### e^|x| and e^-|x| for 2^-57 <= |x| < 45, or e^|x| alone (the third item false) from 45 on, when the exp
### fast phase takes them. a is |x|'s bit pattern.
secret routine b128_exp_pair(a: U128, acc: Bool) -> (Bool, B128Fx, Bool, B128Fx)
    var (ok1, e1) = b128_exp_fx(x: B128.from_bits(bits: a), acc: acc)
    if not ok1 or a >= B128_FAST_45
        return (ok1, e1, false, e1)
    var (ok2, e2) = b128_exp_fx(x: B128.from_bits(bits: a | (1_u128 << 127_u32)), acc: acc)
    return (ok2, e1, true, e2)

### log1p(x) for 0 < |x| < 2^-20 as a B128Fx: x * P with P = sum (-x)^k/(k+1), k = 0..7 (the rest is below
### 2^-160), split as P = 1 + E - x O with E = x^2/3 + x^4/5 + x^6/7 and O = 1/2 + x^2/4 + x^4/6 + x^6/8 so
### every term is unsigned, in units of 2^-128. Each truncated product is up to 3 units short and the small
### factors (x^2 < 2^-40) damp the inner errors, so E and x O are within 4 units each and P within 12 (with
### the series tail and the final halving).
secret routine b128_log1p_small(xf: B128Fx) -> B128Fx
    # |x| * 2^128, and |x| < 2^-20 makes e <= -148
    var t = xf.m >>> b128_trig_sh(n: 0_s64 -% (xf.e +% 128_s64))
    var t2 = b128_trig_mhi(x: t, y: t)
    var ev = b128_trig_mhi(
        x: t2,
        y: B128_LOG1P_Q[0] +% b128_trig_mhi(
            x: t2,
            y: B128_LOG1P_Q[2] +% b128_trig_mhi(x: t2, y: B128_LOG1P_Q[4]),
        ),
    )
    var od = (1_u128 << 127_u32) +% b128_trig_mhi(
        x: t2,
        y: B128_LOG1P_Q[1] +% b128_trig_mhi(
            x: t2,
            y: B128_LOG1P_Q[3] +% b128_trig_mhi(x: t2, y: B128_LOG1P_Q[5]),
        ),
    )
    var tod = b128_trig_mhi(x: t, y: od)
    var p = B128Fx(
        neg: false,
        m: (1_u128 << 127_u32) +% (tod +% ev >>> 1_u32),
        e: -127_s64,
        rel: 12.0 *! 0x1p-128,
    )
    # for a positive x P = 1 - D, and D may vanish in these units (then P is 1 itself)
    if not xf.neg and tod != ev
        p = B128Fx(neg: false, m: 0_u128 -% (tod -% ev), e: -128_s64, rel: 12.0 *! 0x1p-128)
    return b128fx_mul(a: xf, b: p)

# ============================================================================
# tan, sinpi, cospi, tanpi
# ============================================================================

### A sine/cosine fast-tail result (vouched, frac, e2, sign) as a B128Fx: frac * 2^(e2-128) within 16 units
### of frac (the bound behind the rounding test of b128_trig_finish, 17 taken).
secret routine b128_trig_fx(f: (Bool, U128, S64, U128)) -> B128Fx
    return B128Fx(neg: f.item3 != 0_u128, m: f.item1, e: f.item2 -% 128_s64, rel: 17.0 *! 0x1p-127)

### The reduction of a finite nonzero |x| = m 2^(e - 112) for the CORE-MATH 384-bit path: n (in units of
### pi/256), whether the residual is negative, and the residual as a normalized 384-bit t 2^(et - 384) (below
### 2^-8 no reduction).
secret routine b128_trig_wide_parts(m: U128, e: S64) -> (S64, Bool, (U128, U128, U128), S64)
    if e < -8_s64
        return (0_s64, false, (0_u128, 0_u128, m << 15_u32), e +% 1_s64)
    return b128_trig_reduce_wide(m: m, e: e)

### sin (cosine false) or cos of n pi/256 + theta (as b128_trig_wide_parts gives it) as a B128Fx: the CORE-MATH
### 384-bit value (about 2^-370) truncated to 128 bits, within 2^-126.
secret routine b128_trig_acc_fx(parts: (S64, Bool, (U128, U128, U128), S64), cosine: Bool) -> B128Fx
    var (sg, frac, e2) = b128_trig_accurate_eval(
        n: parts.item0,
        negative: parts.item1,
        t: parts.item2,
        et: parts.item3,
        cosine: cosine,
        sign: 0_u128,
    )
    return B128Fx(neg: sg != 0_u128, m: frac.item2, e: e2 -% 128_s64, rel: 0x1p-126)

### b128_trig_reduce for pi*y instead of x, |y| = m * 2^(e-112) not a multiple of 1/256: 256|y| splits
### exactly into n + r / 2^s (s = 104 - e, |r| <= 2^(s-1)), so the residual g = r * 2^(-s-7) is exact where
### the Payne-Hanek one carries 136 bits. theta = |g| pi/2 is then formed as in b128_trig_reduce.
### :returns: As b128_trig_reduce: false or true, n mod 512, whether g < 0, and theta as t1 * 2^(et-128).
secret routine b128_trigpi_reduce(m: U128, e: S64) -> (Bool, S64, Bool, U128, S64)
    var s = 104_s64 -% e
    if s <= 0_s64
        return (false, 0_s64, false, 0_u128, 0_s64)
    var n = 0_u128
    var r = m
    var negative = false
    if s < 115_s64
        n = m +% (1_u128 << b128_trig_sh(n: s -% 1_s64)) >>> b128_trig_sh(n: s)
        var base = n << b128_trig_sh(n: s)
        if base > m
            r = base -% m
            negative = true
        else
            r = m -% base
    if r == 0_u128
        return (false, 0_s64, false, 0_u128, 0_s64)
    var lzr = b128_trig_clz128(x: r)
    var pp = b128_trig_wmul(
        x: r << b128_trig_sh(n: lzr),
        y: 0xC90FDAA22168C234C4C6628B80DC1CD1_u128,
    )
    var lzt = b128_trig_clz128(x: pp.item0)
    var t1 = b128_trig_top256(s: (pp.item1, pp.item0), shift: lzt)
    var nn = LLVM::reinterpret_bits[U64, S64](LLVM::int_truncate[U128, U64](n & 511_u128))
    return (true, nn, negative, t1, 122_s64 -% lzr -% s -% lzt)

### sin(pi|y|) (cosine false) or cos(pi|y|) as a B128Fx from a pi reduction, or false where the fast tail
### would set a tiny theta against a table entry (theta below 2^-60 with j or the cosine term in play).
secret routine b128_trigpi_fx(
    red: (Bool, S64, Bool, U128, S64),
    sq: (U128, U128, U128),
    s1: U128,
    cosine: Bool,
) -> (Bool, B128Fx)
    var k = red.item1 >> 7
    if cosine
        k = k +% 1_s64
    if red.item4 < -60_s64 and ((red.item1 & 127_s64) != 0_s64 or (k & 1_s64) != 0_s64)
        return (false, b128_trig_fx(f: (false, 0_u128, 0_s64, 0_u128)))
    var f = b128_trig_fast_tail(
        n: red.item1,
        negative: red.item2,
        rt1: red.item3,
        ret: red.item4,
        sq: sq,
        s1b: s1,
        cosine: cosine,
    )
    return (f.item0, b128_trig_fx(f: f))

### The significand and exponent of a finite nonzero |y| in the trig pipeline's form m * 2^(e-112).
secret routine b128_trigpi_parts(ax: U128) -> (U128, S64)
    var implicit = 1_u128 << 112_u32
    var ex = LLVM::reinterpret_bits[U64, S64](LLVM::int_truncate[U128, U64](ax >>> 112_u32))
    if ex == 0_s64
        return (ax, -16382_s64)
    return (ax & implicit -% 1_u128 | implicit, ex -% 16383_s64)

# ============================================================================
# Conversions, log1p and sqrt on B128Fx
# ============================================================================

### |v| as a B64 (within 2^-52), for a B128Fx whose magnitude is inside the B64 range.
secret routine b128fx_b64(v: B128Fx) -> B64
    return b128fx_top(m: v.m) *! b128fx_p2(k: v.e +% 64_s64)

### A normal B64 v as a B128Fx (exact), carrying the relative error bound rel.
secret routine b128fx_of_b64(v: B64, rel: B64) -> B128Fx
    var bits = v.to_bits()
    var ex = LLVM::reinterpret_bits[U64, S64]((bits >>> 52_u32) & 0x7FF_u64)
    var mant = LLVM::zero_extend[U64, U128](bits & 0x000FFFFFFFFFFFFF_u64 | 0x0010000000000000_u64)
    return B128Fx(neg: (bits >>> 63_u32) != 0_u64, m: mant << 75_u32, e: ex -% 1150_s64, rel: rel)

### v with its significand truncated to 113 bits, as a B128, or false outside the normal B128 range.
secret routine b128fx_to_b128(v: B128Fx) -> (Bool, B128)
    var biased = v.e +% 127_s64 +% 16383_s64
    if biased < 1_s64 or biased > 32766_s64
        return (false, B128.from_bits(bits: 0_u128))
    var bits = (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](biased)) << 112_u32) | (v.m >>> 15_u32) & (1_u128 << 112_u32) -% 1_u128
    if v.neg
        bits = bits | (1_u128 << 127_u32)
    return (true, B128.from_bits(bits: bits))

### -v.
@inline
secret routine b128fx_neg(v: B128Fx) -> B128Fx
    return B128Fx(neg: not v.neg, m: v.m, e: v.e, rel: v.rel)

### 1 (exact).
@inline
secret routine b128fx_one() -> B128Fx
    return B128Fx(neg: false, m: 1_u128 << 127_u32, e: -127_s64, rel: 0.0)

### log1p(t) for a B128Fx t > -1 at or above 2^-20 in magnitude (t.e >= -148), or false, as the fixed-point value
### (neg, mag, err): log1p(t) = (-1)^neg mag 2^-148 within err units. 1 + t is split exactly into v + c, v the
### truncation of 1 + t to 113 bits and c >= 0 the rest, and log1p(t) = log(v) + c/v with (c/v)^2/2 (below 2^-220)
### dropped: log(v) is the CORE-MATH fixed-point value (12 units, v is at least 2^-28 away from 1 so it is above
### 2^119 units), and c/v, below 2^-112 of v (under 2^37 units), is added as an integer from B64 values (within
### 2^-50 of it, plus half a unit for its rounding). t's own error moves log1p by |t| t.rel / v. The split and
### the logarithm are b128fx_log_split's, shared with log(w).
secret routine b128fx_log1p_fixed(t: B128Fx) -> (Bool, Bool, U256, B64)
    # 1 + t exactly as the integer S in units of 2^t.e (t below 2^127 in magnitude, so 1 is a whole number of
    # units, 2^-t.e <= 2^148)
    if t.e >= 0_s64
        return (false, false, 0_u256, 0.0)
    var one = 1_u256 << LLVM::zero_extend[U64, U256](LLVM::reinterpret_bits[S64, U64](0_s64 -% t.e))
    var tm = LLVM::zero_extend[U128, U256](t.m)
    var sv = one +% tm
    if t.neg
        sv = one -% tm
    return b128fx_log_split(sv: sv, e: t.e, tabs: b128fx_b64(v: t) *! t.rel)

### log(S 2^e) for a positive integer S below 2^256 known to within tabs absolute (the argument's own error), as
### the fixed-point (neg, mag, err) of b128fx_log1p_fixed: v the top 113 bits of S, c >= 0 the rest, log(v) + c/v.
secret routine b128fx_log_split(sv: U256, e: S64, tabs: B64) -> (Bool, Bool, U256, B64)
    var shi = LLVM::int_truncate[U256, U128](sv >>> 128_u32)
    var slo = LLVM::int_truncate[U256, U128](sv)
    var lead = 127_s64 -% LLVM::int_truncate[U128, S64](LLVM::leading_zeros(slo))
    if shi != 0_u128
        lead = 255_s64 -% LLVM::int_truncate[U128, S64](LLVM::leading_zeros(shi))
    var k = lead -% 112_s64
    var vm = slo
    var low = 0_u256
    if k > 0_s64
        var ku = LLVM::zero_extend[U64, U256](LLVM::reinterpret_bits[S64, U64](k))
        vm = LLVM::int_truncate[U256, U128](sv >>> ku)
        low = sv & (1_u256 << ku) -% 1_u256
    elseif k < 0_s64
        # a short S (1 + t for a t near -1): v is S itself, normalized
        vm = slo << LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](0_s64 -% k))
    var vbiased = lead +% e +% 16383_s64
    if vbiased < 1_s64 or vbiased > 32766_s64
        return (false, false, 0_u256, 0.0)
    var v = B128.from_bits(bits: (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](vbiased)) << 112_u32) | vm & (1_u128 << 112_u32) -% 1_u128)
    var (ok, hi, lo) = b128_log_scaled_ok(x: v)
    if not ok
        return (false, false, 0_u256, 0.0)
    var (lneg, mag) = b128_fs_magnitude(fs: b128_log_fs(hi: hi, lo: lo))
    if mag == 0_u256
        return (false, false, 0_u256, 0.0)
    # v within 2^-52 as a B64, the argument's own error tabs moved through log' = 1 / v
    var vb = b128fx_top(m: vm << 15_u32) *! b128fx_p2(k: lead +% e -% 63_s64)
    var err = 12.5 +! tabs *! 1.001 /! vb *! 0x1p148
    if low == 0_u256
        return (true, lneg, mag, err)
    # c = low 2^e (below 2^-112 v, so under 2^37 units of 2^-148 as c / v), exact, added as an integer
    var lhi = LLVM::int_truncate[U256, U128](low >>> 128_u32)
    var llo = LLVM::int_truncate[U256, U128](low)
    var cb = b128fx_wide_b64(hi: lhi, lo: llo)
    var cu = cb /! vb *! b128fx_p2(k: e +% 148_s64)
    var ci = LLVM::zero_extend[U64, U256](LLVM::float_to_unsigned[B64, U64](LLVM::rint[B64](value: cu)))
    # c is positive: it adds to a positive log(v) and subtracts from a negative one
    if lneg
        mag = mag -% ci
    else
        mag = mag +% ci
    return (true, lneg, mag, err +! cu *! 0x1p-49)

### log1p(t) for a B128Fx t > -1, or false: below 2^-20 in magnitude the series of b128_log1p_small, else
### b128fx_log1p_fixed normalized.
secret routine b128fx_log1p(t: B128Fx) -> (Bool, B128Fx)
    if t.e < -148_s64
        return (true, b128_log1p_small(xf: t))
    var (ok, neg, mag, err) = b128fx_log1p_fixed(t: t)
    if not ok
        return (false, t)
    return (true, b128fx_norm(neg: neg, mag: mag, scale: -148_s64, abserr: err))

### sqrt(v) for a positive B128Fx v in the normal B128 range, or false: s0 = sqrt of v's B128 truncation
### (correctly rounded, so within 2^-111 of sqrt(v)), then one Newton step s0 + (v - s0^2) / (2 s0) with
### 1/(2 s0) in B64. The step leaves (v - s0^2)^2 / (8 s0^3), below 2^-220 of the root, and the residual
### v - s0^2 carries the error of v and of s0^2 through the sums.
secret routine b128fx_sqrt(v: B128Fx) -> (Bool, B128Fx)
    var (ok, vb) = b128fx_to_b128(v: v)
    if not ok
        return (false, v)
    var s0 = vb.sqrt_unchecked()
    var s0f = b128fx_of(x: s0)
    var sq = b128fx_mul(a: s0f, b: s0f)
    var (okr, r) = b128fx_add(a: v, b: b128fx_neg(v: sq))
    if not okr
        return (
            true,
            B128Fx(neg: false, m: s0f.m, e: s0f.e, rel: (v.rel +! sq.rel) *! 0.5001 +! 0x1p-200),
        )
    var corr = b128fx_mul(a: r, b: b128fx_of_b64(v: 0.5 /! b128fx_b64(v: s0f), rel: 0x1p-50))
    var (oka, s) = b128fx_add(a: s0f, b: corr)
    if not oka
        return (false, v)
    return (true, B128Fx(neg: false, m: s.m, e: s.e, rel: s.rel +! 0x1p-200))

### The series part of the small-argument asinh and atanh for 0 < |x| < 2^-20, as the B128Fx P with
### asinh(x) = x P or atanh(x) = x P: 1 - x^2 (1/6 - x^2 (3/40 - x^2 5/112)) or 1 + x^2/3 + x^4/5 + x^6/7, the
### rest below 2^-160. In units of 2^-128 each truncated product is up to 3 short and x^2 < 2^-40 damps the
### inner errors, so P is within 6 units (12 taken).
secret routine b128_arc_small(xf: B128Fx, atanh: Bool) -> B128Fx
    var t = xf.m >>> b128_trig_sh(n: 0_s64 -% (xf.e +% 128_s64))
    var t2 = b128_trig_mhi(x: t, y: t)
    if atanh
        var ev = b128_trig_mhi(
            x: t2,
            y: B128_LOG1P_Q[0] +% b128_trig_mhi(
                x: t2,
                y: B128_LOG1P_Q[2] +% b128_trig_mhi(x: t2, y: B128_LOG1P_Q[4]),
            ),
        )
        return B128Fx(
            neg: false,
            m: (1_u128 << 127_u32) +% (ev >>> 1_u32),
            e: -127_s64,
            rel: 12.0 *! 0x1p-128,
        )
    var d = b128_trig_mhi(
        x: t2,
        y: B128_ASINH_Q[0] -% b128_trig_mhi(
            x: t2,
            y: B128_ASINH_Q[1] -% b128_trig_mhi(x: t2, y: B128_ASINH_Q[2]),
        ),
    )
    if d == 0_u128
        # P = 1 - D with D vanishing in these units: P is 1 itself
        return B128Fx(neg: false, m: 1_u128 << 127_u32, e: -127_s64, rel: 12.0 *! 0x1p-128)
    return B128Fx(neg: false, m: 0_u128 -% d, e: -128_s64, rel: 12.0 *! 0x1p-128)

# ============================================================================
# sinpi
# ============================================================================

### sin(pi y) for a finite nonzero B128 y as a signed B128Fx, or false (y a multiple of 1/256, where the
### exact reduction leaves no residual, and |y| from 2^104 on).
secret routine b128_sinpi_fx(y: B128) -> (Bool, B128Fx)
    var bits = y.to_bits()
    var signmask = 1_u128 << 127_u32
    var ax = bits & signmask -% 1_u128
    if ax >= (0x7FFF_u128 << 112_u32) or ax == 0_u128
        return (false, b128fx_one())
    var (m, e) = b128_trigpi_parts(ax: ax)
    var red = b128_trigpi_reduce(m: m, e: e)
    if not red.item0
        return (false, b128fx_one())
    var sq = b128_trig_squares(t1: red.item3, et: red.item4)
    var s1 = b128_trig_sin_frac(t1: red.item3, u: sq.item0, v: sq.item1)
    var (oks, sv) = b128_trigpi_fx(red: red, sq: sq, s1: s1, cosine: false)
    if not oks
        return (false, sv)
    return (
        true, B128Fx(neg: sv.neg != ((bits & signmask) != 0_u128), m: sv.m, e: sv.e, rel: sv.rel),
    )
