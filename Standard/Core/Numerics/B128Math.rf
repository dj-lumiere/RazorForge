### Returns `me ^ you`.
routine B128.pow!(you: B128) -> B128
    var rr = me.pow_unchecked(you: you)
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### `me^you` with raw IEEE (the full C99 pow special-case ladder). No crash. The general case is
### exp(you * ln|me|) on the 384-bit tier when the fast path leaves the rounding open, the sign of an
### odd-integer exponent reapplied.
routine B128.pow_unchecked(you: B128) -> B128
    var w = C::ingrid_b128_pow(
        low: me.low_bits(),
        high: me.high_bits(),
        y_low: you.low_bits(),
        y_high: you.high_bits(),
    )
    return b128_of_words(w: w)

