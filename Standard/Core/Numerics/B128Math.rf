### Returns `me ^ you`.
routine B128.pow!(you: B128) -> B128
  var rr = me.pow_unchecked(you: you)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me^you` with raw IEEE (the full C99 pow special-case ladder). No crash. The general case is
### exp(you * ln|me|) on the 384-bit tier when the fast path leaves the rounding open, the sign of an
### odd-integer exponent reapplied.
routine B128.pow_unchecked(you: B128) -> B128
  var (fast, v) = b128_pow_fast(x: me, y: you)
  if fast
    return v
  var (exact, w) = b128_pow_exact(x: me, y: you)
  if exact
    return w
  var one = 1.0_b128
  var negone = -1.0_b128
  # integer / odd-integer exponent classification drives the sign rules and domain checks below
  var yisint = you.is_finite() and b128_is_int(a: you)
  var yisoddint = yisint and b128_integer_is_odd(a: you)
  var poszero = B128.from_bits(bits: 0_u128)
  var negzero = B128.from_bits(bits: 1_u128 << 127_u32)
  var posinf = B128.from_bits(bits: b128_inf(sign: 0_u64))
  var neginf = B128.from_bits(bits: b128_inf(sign: 1_u64))
  var xs = 0_u64
  if me.is_negative()
    xs = 1_u64
  # a negative base raised to a non-integer power has no real result
  if me.is_negative() and me.is_finite() and not me.is_zero() and you.is_finite() and not yisint
    return B128.from_bits(bits: b128_qnan())
  if me == one or you.is_zero()
    return one
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if you.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: you.to_bits()))
  if not you.is_negative() and not you.is_zero() and me.is_zero() and yisoddint
    return me
  if me.is_zero() and not you.is_negative() and not you.is_zero() and not yisoddint
    return poszero
  if you.is_infinite() and me == negone
    return one
  var absxlt1 = negone < me and me < one
  var absxgt1 = me < negone or one < me
  if you.is_infinite() and you.is_negative() and absxlt1
    return posinf
  if you.is_infinite() and you.is_negative() and absxgt1
    return poszero
  if you.is_infinite() and not you.is_negative() and absxlt1
    return poszero
  if you.is_infinite() and not you.is_negative() and absxgt1
    return posinf
  if me.is_infinite() and me.is_negative() and you.is_negative() and yisoddint
    return negzero
  if me.is_infinite() and me.is_negative() and you.is_negative() and not you.is_zero() and not yisoddint
    return poszero
  if me.is_infinite() and me.is_negative() and not you.is_negative() and yisoddint
    return neginf
  if me.is_infinite() and me.is_negative() and not you.is_negative() and not you.is_zero() and not yisoddint
    return posinf
  if me.is_infinite() and not me.is_negative() and you.is_negative() and not you.is_zero()
    return poszero
  if me.is_infinite() and not me.is_negative() and not you.is_negative() and not you.is_zero()
    return posinf
  if me.is_zero() and yisoddint and you.is_negative()
    return B128.from_bits(bits: b128_inf(sign: xs))
  if me.is_zero() and you.is_negative() and not you.is_zero() and not yisoddint
    return posinf
  # |me|^you = e^z with z = you ln|me|; far past the range the result is infinite or zero
  var z = wx_mul(a: wx_of_b128(x: you), b: wx_log(x: wx_abs(w: wx_of_b128(x: me))))
  var zb = wx_b64(w: z)
  var r = poszero
  if zb > 12000.0
    r = posinf
  elseif zb > -12000.0
    r = wx_b128(w: wx_exp(x: z))
  if me.is_negative() and yisoddint
    return r.neg()
  return r

### Returns `asin(me)`.
routine B128.asin!() -> B128
  var rr = me.asin_unchecked()
  if rr.is_finite()
