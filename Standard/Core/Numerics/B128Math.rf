# ============================================================================
# fma, and the three-leg hypot: exact integer arithmetic, one rounding
# ============================================================================

### A finite nonzero B128 as its integer significand (113 bits, fewer when subnormal) and the exponent of
### its last bit.
secret routine b128_int_parts(x: B128) -> (U128, S64)
    var bits = x.to_bits()
    var be = LLVM::int_truncate[U128, S64]((bits >>> 112_u32) & 0x7FFF_u128)
    var f = bits & (1_u128 << 112_u32) -% 1_u128
    if be == 0_s64
        return (f, -16494_s64)
    return (f | (1_u128 << 112_u32), be -% 16495_s64)

### a + b for exact values a * 2^ea and b * 2^eb (384-bit integers, signs neg_a / neg_b): the smaller is
### aligned below the larger one's top and its bits that fall out of the 384-bit window become a sticky bit
### jammed into bit 0. Bits fall out only when the smaller is below 2^-150 of the larger (the addends here
### have at most 226 significant bits), so the sum keeps its top within one bit of the larger one's and the
### sticky bit sits far below any rounding place. A subtraction that drops bits takes one more unit off: the
### true value then lies strictly between that and the next unit up.
secret routine b128_exact_sum(
    neg_a: Bool,
    a: (U128, U128, U128),
    ea: S64,
    neg_b: Bool,
    b: (U128, U128, U128),
    eb: S64,
) -> B128Wx
    var wa = wx_make(neg: neg_a, t: a, e: ea, rel: 0.0)
    var wb = wx_make(neg: neg_b, t: b, e: eb, rel: 0.0)
    if wx_is_zero(w: wb)
        return wa
    if wx_is_zero(w: wa)
        return wb
    var x = wa
    var y = wb
    if wb.e > wa.e or (wb.e == wa.e and wx_t_gt(a: wx_t(w: wb), b: wx_t(w: wa)))
        x = wb
        y = wa
    var d = x.e -% y.e
    var yt = wx_t(w: y)
    var ys = b128_trig_shr384(x: yt, shift: d)
    var sticky = false
    if d >= 384_s64
        sticky = true
    elseif d > 0_s64
        var back = b128_trig_shl384(x: ys, shift: d)
        sticky = back.item0 != yt.item0 or back.item1 != yt.item1 or back.item2 != yt.item2
    var xt = wx_t(w: x)
    var e = x.e
    var s = xt
    if x.neg == y.neg
        s = b128_trig_add384(a: xt, b: ys)
        if wx_t_gt(a: xt, b: s)
            if (s.item0 & 1_u128) != 0_u128
                sticky = true
            var h = b128_trig_shr384(x: s, shift: 1_s64)
            s = (h.item0, h.item1, h.item2 | (1_u128 << 127_u32))
            e = e +% 1_s64
    else
        s = b128_trig_sub384(a: xt, b: ys)
        if sticky
            s = b128_trig_sub384(a: s, b: (1_u128, 0_u128, 0_u128))
    var r = wx_make(neg: x.neg, t: s, e: e, rel: 0.0)
    if sticky
        return B128Wx(neg: r.neg, m2: r.m2, m1: r.m1, m0: r.m0 | 1_u128, e: r.e, rel: 0.0)
    return r

### Returns the fused multiply-add `me*b + c` with a single rounding.
routine B128.fma!(b: B128, c: B128) -> B128
    var rr = me.fma_unchecked(b: b, c: c)
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns the fused multiply-add `me*b + c` with a single rounding, with raw IEEE 754 propagation.
routine B128.fma_unchecked(b: B128, c: B128) -> B128
    var w = C::ingrid_b128_fma(
        low: me.low_bits(),
        high: me.high_bits(),
        y_low: b.low_bits(),
        y_high: b.high_bits(),
        z_low: c.low_bits(),
        z_high: c.high_bits(),
    )
    return b128_of_words(w: w)

### Returns `sqrt(x^2 + y^2)` without spurious overflow.
### :param x: One leg.
### :param y: The other leg.
routine hypot!(x: B128, y: B128) -> B128
    var rr = hypot_unchecked(x: x, y: y)
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `sqrt(x^2 + y^2 + z^2)` without spurious overflow. Checked: crashes on non-finite.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot!(x: B128, y: B128, z: B128) -> B128
    var rr = hypot_unchecked(x: x, y: y, z: z)
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### The exact square of a finite nonzero B128 added to sum (see b128_exact_sum).
secret routine b128_add_square(sum: B128Wx, x: B128) -> B128Wx
    if x.is_zero()
        return sum
    var (m, e) = b128_int_parts(x: x)
    var p = b128_trig_wmul(x: m, y: m)
    var sq = (0_u128, p.item1, p.item0)
    if wx_is_zero(w: sum)
        return wx_make(neg: false, t: sq, e: 2_s64 *% e -% 128_s64, rel: 0.0)
    return b128_exact_sum(
        neg_a: false,
        a: wx_t(w: sum),
        ea: sum.e,
        neg_b: false,
        b: sq,
        eb: 2_s64 *% e -% 128_s64,
    )

### `sqrt(x^2 + y^2 + z^2)`, correctly rounded, with raw IEEE (any inf -> +inf, any NaN -> qNaN). No crash.
### The squares are exact and their sum exact up to a sticky bit; the root of its top 229 or 230 bits (an
### even power of two left over) is an exact integer square root whose remainder joins the sticky bit.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot_unchecked(x: B128, y: B128, z: B128) -> B128
    if x.is_infinite() or y.is_infinite() or z.is_infinite()
        return B128.from_bits(bits: b128_inf(sign: 0_u64))
    if x.is_nan() or y.is_nan() or z.is_nan()
        return B128.from_bits(bits: b128_qnan())
    var sum = b128_add_square(
        sum: b128_add_square(sum: b128_add_square(sum: wx_zero(rel: 0.0), x: x), x: y),
        x: z,
    )
    if wx_is_zero(w: sum)
        return B128.from_bits(bits: 0_u128)
    # sum = n * 2^s + rest with n its top 230 or 229 bits and s even
    var s = sum.e +% 154_s64
    if (s & 1_s64) != 0_s64
        s = s +% 1_s64
    var sh = s -% sum.e
    var t = b128_trig_shr384(x: wx_t(w: sum), shift: sh)
    var back = b128_trig_shl384(x: t, shift: sh)
    var sticky = back.item0 != sum.m0 or back.item1 != sum.m1 or back.item2 != sum.m2
    var n = (LLVM::zero_extend[U128, U256](t.item1) << 128_u32) | LLVM::zero_extend[U128, U256](t.item0)
    var root = b128_isqrt256(n: n)
    if root *% root != n
        sticky = true
    # the root's 115 bits, two zero bits below them, and the sticky bit below those
    var rt = LLVM::int_truncate[U256, U128](root) << 2_u32
    if sticky
        rt = rt | 1_u128
    return wx_b128(
        w: wx_make(neg: false, t: (0_u128, 0_u128, rt), e: (s >> 1) -% 258_s64, rel: 0.0),
    )

### Returns `sin(pi*me)`: sin(pi*n) is ±0 with the sign of me.
routine B128.sinpi() -> B128
    return b128_of_words(w: C::ingrid_b128_sinpi(low: me.low_bits(), high: me.high_bits()))

### Returns `cos(pi*me)`: cos(pi*(n + 1/2)) is +0.
routine B128.cospi() -> B128
    return b128_of_words(w: C::ingrid_b128_cospi(low: me.low_bits(), high: me.high_bits()))

### Returns `tan(pi*me)`. At an integer n it is +0 for a positive even n and -0 for a positive odd one (IEEE
### 754 tanPi), with the opposite signs for negative n since tanpi is odd.
routine B128.tanpi() -> B128
    return b128_of_words(w: C::ingrid_b128_tanpi(low: me.low_bits(), high: me.high_bits()))

### Returns the error function `erf(me)`.
routine B128.erf() -> B128
    return b128_of_words(w: C::ingrid_b128_erf(low: me.low_bits(), high: me.high_bits()))

### Returns the complementary error function `erfc(me)`.
routine B128.erfc() -> B128
    return b128_of_words(w: C::ingrid_b128_erfc(low: me.low_bits(), high: me.high_bits()))

### Returns the gamma function `tgamma(me)`.
routine B128.tgamma!() -> B128
    var rr = me.tgamma_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### `tgamma(me)` with raw IEEE (poles at 0/negative integers -> inf/qNaN). No crash.
routine B128.tgamma_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_tgamma(low: me.low_bits(), high: me.high_bits()))

### Returns the log-gamma function `lgamma(me)` (= ln|gamma(me)|).
routine B128.lgamma() -> B128
    return b128_of_words(w: C::ingrid_b128_lgamma(low: me.low_bits(), high: me.high_bits()))

# ============================================================================
# The CORE-MATH functions
# ============================================================================

### `acos(me)`, correctly rounded: the exact arc cosine rounded to the nearest `B128` (ties to even),
### identical on every platform. The result lies in [0, pi]. |me| > 1, ±infinity and a signaling NaN give
### NaN, and a quiet NaN is returned unchanged. No crash.
### :returns: The correctly rounded arc cosine in radians.
routine B128.acos_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_acos(low: me.low_bits(), high: me.high_bits()))

### `asin(me)`, correctly rounded: the exact arc sine rounded to the nearest `B128` (ties to even),
### identical on every platform. The result lies in [-pi/2, pi/2] and `asin(-x) == -asin(x)`. ±0 map to
### themselves; |me| > 1, ±infinity and a signaling NaN give NaN, and a quiet NaN is returned unchanged.
### No crash.
### :returns: The correctly rounded arc sine in radians.
routine B128.asin_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_asin(low: me.low_bits(), high: me.high_bits()))

### Returns the arc tangent of this value, correctly rounded: the exact angle in [-pi/2, pi/2] rounded to
### the nearest `B128` (ties to even), identical on every platform. `atan(-x) == -atan(x)`, ±0 map to
### themselves, ±infinity give ±pi/2 and NaN gives NaN.
### :returns: The correctly rounded arc tangent in radians.
routine B128.atan() -> B128
    return b128_of_words(w: C::ingrid_b128_atan(low: me.low_bits(), high: me.high_bits()))

### Two-argument arc tangent atan2(y, x), correctly rounded: the exact angle of the point (x, y) rounded to
### the nearest `B128` (ties to even), identical on every platform. The result lies in [-pi, pi]; the signs
### of zero and infinite coordinates select the quadrant as in IEEE 754, and a NaN coordinate gives NaN.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
### :returns: The correctly rounded angle in radians.
routine atan2(y: B128, x: B128) -> B128
    var w = C::ingrid_b128_atan2(
        y_low: y.low_bits(),
        y_high: y.high_bits(),
        x_low: x.low_bits(),
        x_high: x.high_bits(),
    )
    return b128_of_words(w: w)

### Returns the cube root of this value, correctly rounded: the exact cube root rounded to the nearest
### `B128` (ties to even), identical on every platform. `cbrt(-x) == -cbrt(x)`, and ±0, ±infinity and NaN
### map to themselves (a signaling NaN is quieted).
### :returns: The correctly rounded cube root.
routine B128.cbrt() -> B128
    return b128_of_words(w: C::ingrid_b128_cbrt(low: me.low_bits(), high: me.high_bits()))

### Returns the cosine, correctly rounded: the exact cosine of this value (in radians) rounded to the nearest
### `B128` (ties to even), identical on every platform. `cos(-x) == cos(x)`, and ±infinity and NaN give
### NaN.
### :returns: The correctly rounded cosine.
routine B128.cos() -> B128
    return b128_of_words(w: C::ingrid_b128_cos(low: me.low_bits(), high: me.high_bits()))

### Returns `e` raised to this value, correctly rounded: the exact exponential rounded to the nearest
### `B128` (ties to even), identical on every platform, with raw IEEE 754 propagation (overflow ->
### +infinity, `exp(-infinity) == 0`, NaN -> quiet NaN). No crash.
### :returns: The correctly rounded exponential, possibly +infinity.
routine B128.exp_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_exp(low: me.low_bits(), high: me.high_bits()))

### Returns 10 raised to this value, correctly rounded: the exact power rounded to the nearest `B128`
### (ties to even), identical on every platform, exact for x = 1, 2, ..., 48, with raw IEEE 754
### propagation (overflow -> +infinity, `exp10(-infinity) == 0`, NaN -> quiet NaN). No crash.
### :returns: The correctly rounded power of ten, possibly +infinity.
routine B128.exp10_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_exp10(low: me.low_bits(), high: me.high_bits()))

### Returns 2 raised to this value, correctly rounded: the exact power rounded to the nearest `B128`
### (ties to even), identical on every platform, exact for integer arguments, with raw IEEE 754
### propagation (overflow -> +infinity, `exp2(-infinity) == 0`, NaN -> quiet NaN). No crash.
### :returns: The correctly rounded power of two, possibly +infinity.
routine B128.exp2_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_exp2(low: me.low_bits(), high: me.high_bits()))

### `e^me - 1`, correctly rounded: the exact value rounded to the nearest `B128` (ties to even), identical on
### every platform, and accurate near 0. Raw IEEE 754 propagation, no crash: NaN -> quiet NaN,
### -infinity -> -1, +infinity -> +infinity, overflow -> +infinity.
### :returns: The correctly rounded `e^me - 1`.
routine B128.expm1_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_expm1(low: me.low_bits(), high: me.high_bits()))

### `sqrt(x^2 + y^2)`, correctly rounded: the exact Euclidean distance rounded to the nearest `B128` (ties
### to even), identical on every platform, without spurious overflow or underflow. Raw IEEE 754
### propagation: an infinite leg gives +infinity (even with a quiet NaN in the other leg), otherwise a NaN
### leg gives NaN.
### :param x: One leg.
### :param y: The other leg.
### :returns: The correctly rounded hypotenuse.
routine hypot_unchecked(x: B128, y: B128) -> B128
    var w = C::ingrid_b128_hypot(
        low: x.low_bits(),
        high: x.high_bits(),
        y_low: y.low_bits(),
        y_high: y.high_bits(),
    )
    return b128_of_words(w: w)

### `ln(me)`, correctly rounded: the exact natural logarithm rounded to the nearest `B128` (ties to even),
### identical on every platform. Raw IEEE 754 propagation, no crash: ±0 -> -infinity, x < 0 -> NaN,
### +infinity -> +infinity, NaN -> quiet NaN.
### :returns: The correctly rounded natural logarithm.
routine B128.log_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_log(low: me.low_bits(), high: me.high_bits()))

### Returns the sine, correctly rounded: the exact sine of this value (in radians) rounded to the nearest
### `B128` (ties to even), identical on every platform. `sin(-x) == -sin(x)`, ±0 maps to itself, and
### ±infinity and NaN give NaN.
### :returns: The correctly rounded sine.
routine B128.sin() -> B128
    return b128_of_words(w: C::ingrid_b128_sin(low: me.low_bits(), high: me.high_bits()))

### Returns the sine and the cosine together, each correctly rounded exactly as `sin()` and `cos()` return
### them. They share the argument reduction, so the pair costs little more than one of them.
### :returns: `(sin(me), cos(me))`.
routine B128.sincos() -> (B128, B128)
    var w = C::ingrid_b128_sincos(low: me.low_bits(), high: me.high_bits())
    var cos_bits = (U128(from: w.w3) << 64) | U128(from: w.w2)
    return (b128_of_words(w: w), B128.from_bits(bits: cos_bits))

### Returns the square root, correctly rounded: the exact square root rounded to the nearest `B128` (ties to
### even), identical on every platform, with raw IEEE 754 propagation (C `sqrt`): NaN for negatives and
### NaN inputs, +infinity for +infinity, ±0 for ±0.
### :returns: The correctly rounded square root.
routine B128.sqrt_unchecked() -> B128
    return b128_of_words(w: C::ingrid_b128_sqrt(low: me.low_bits(), high: me.high_bits()))

### Reads the B128 an Ingrid routine hands back: its low 64 bits in `w0`, its high 64 bits in `w1`.
secret routine b128_of_words(w: IngridWords) -> B128
    return B128.from_bits(bits: (U128(from: w.w1) << 64) | U128(from: w.w0))
