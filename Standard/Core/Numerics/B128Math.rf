  throw NumericOverflowError(description: "overflow: out of range")

### `atanh(me)` with raw IEEE (|me|=1 -> signed inf, |me|>1 -> qNaN). No crash.
routine B128.atanh_unchecked() -> B128
  var (fast, v) = b128_atanh_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 6_u64)

### Returns `asinh(me)`.
routine B128.asinh() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_zero()
    return me
  var (fast, v) = b128_asinh_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 4_u64)

### Returns `acosh(me)`.
routine B128.acosh!() -> B128
  var rr = me.acosh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `acosh(me)` with raw IEEE (me<1 -> qNaN). No crash.
routine B128.acosh_unchecked() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  var (fast, v) = b128_acosh_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 5_u64)

### Returns `tan(me)`.
routine B128.tan() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  if me.is_zero()
    return me
  var (fast, v) = b128_tan_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 0_u64)

# ============================================================================
# fma and the three-leg hypot: exact integer arithmetic, one rounding
# ============================================================================

### A finite nonzero B128 as its integer significand (113 bits, fewer when subnormal) and the exponent of
### its last bit.
secret routine b128_int_parts(x: B128) -> (U128, S64)
  var bits = x.to_bits()
  var be = LLVM::int_truncate[U128, S64]((bits >>> 112_u32) & 0x7FFF_u128)
  var f = bits & ((1_u128 << 112_u32) -% 1_u128)
  if be == 0_s64
    return (f, -16494_s64)
  return (f | (1_u128 << 112_u32), be -% 16495_s64)

### a + b for exact values a * 2^ea and b * 2^eb (384-bit integers, signs neg_a / neg_b): the smaller is
### aligned below the larger one's top and its bits that fall out of the 384-bit window become a sticky bit
### jammed into bit 0. Bits fall out only when the smaller is below 2^-150 of the larger (the addends here
### have at most 226 significant bits), so the sum keeps its top within one bit of the larger one's and the
### sticky bit sits far below any rounding place. A subtraction that drops bits takes one more unit off: the
### true value then lies strictly between that and the next unit up.
secret routine b128_exact_sum(neg_a: Bool, a: (U128, U128, U128), ea: S64, neg_b: Bool, b: (U128, U128, U128), eb: S64) -> B128Wx
  var wa = wx_make(neg: neg_a, t: a, e: ea, rel: 0.0)
  var wb = wx_make(neg: neg_b, t: b, e: eb, rel: 0.0)
  if wx_is_zero(w: wb)
    return wa
  if wx_is_zero(w: wa)
    return wb
  var x = wa
  var y = wb
  if wb.e > wa.e or (wb.e == wa.e and wx_t_gt(a: wx_t(w: wb), b: wx_t(w: wa)))
    x = wb
    y = wa
  var d = x.e -% y.e
  var yt = wx_t(w: y)
  var ys = b128_trig_shr384(x: yt, shift: d)
  var sticky = false
  if d >= 384_s64
    sticky = true
  elseif d > 0_s64
    var back = b128_trig_shl384(x: ys, shift: d)
    sticky = back.item0 != yt.item0 or back.item1 != yt.item1 or back.item2 != yt.item2
  var xt = wx_t(w: x)
  var e = x.e
  var s = xt
  if x.neg == y.neg
    s = b128_trig_add384(a: xt, b: ys)
    if wx_t_gt(a: xt, b: s)
      if (s.item0 & 1_u128) != 0_u128
        sticky = true
      var h = b128_trig_shr384(x: s, shift: 1_s64)
      s = (h.item0, h.item1, h.item2 | (1_u128 << 127_u32))
      e = e +% 1_s64
  else
    s = b128_trig_sub384(a: xt, b: ys)
    if sticky
      s = b128_trig_sub384(a: s, b: (1_u128, 0_u128, 0_u128))
  var r = wx_make(neg: x.neg, t: s, e: e, rel: 0.0)
  if sticky
    return B128Wx(neg: r.neg, m2: r.m2, m1: r.m1, m0: r.m0 | 1_u128, e: r.e, rel: 0.0)
  return r

### Returns the fused multiply-add `me*b + c` with a single rounding.
routine B128.fma!(b: B128, c: B128) -> B128
  var rr = me.fma_unchecked(b: b, c: c)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me*b + c` with a single rounding and raw IEEE propagation. No crash. The product is exact (226 bits) and
### the sum exact up to a sticky bit (b128_exact_sum), so its one rounding is the correct one.
### The bits of a * b + c, correctly rounded, for finite nonzero a, b, c (bit patterns) whose result is a
### normal B128, or false (then the general path decides): the 226-bit product and c, each normalized to the
### top of a 256-bit window, the smaller aligned below the larger with the bits it drops folded into a sticky
### bit. Bits drop only when the smaller sits more than 30 bits (the product) or 143 bits (c) below the larger,
### and then the sum keeps its top within one bit of the larger one's, so the sticky bit at bit 0 is far below
### the rounding place (bit 143); a subtraction that drops bits takes one unit off first, the true value lying
### strictly between that and the next unit up.
secret routine b128_fma_fast(a: U128, b: U128, c: U128) -> (Bool, U128)
  var signmask = 1_u128 << 127_u32
  var expmask = 0x7FFF_u128 << 112_u32
  var fracmask = (1_u128 << 112_u32) -% 1_u128
  var aa = a & (signmask -% 1_u128)
  var ba = b & (signmask -% 1_u128)
  var ca = c & (signmask -% 1_u128)
  if aa == 0_u128 or ba == 0_u128 or ca == 0_u128 or aa >= expmask or ba >= expmask or ca >= expmask
    return (false, 0_u128)
  if aa < (1_u128 << 112_u32) or ba < (1_u128 << 112_u32) or ca < (1_u128 << 112_u32)
    return (false, 0_u128)
  # value = m 2^e with m the 113-bit significand and e the exponent of its last bit
  var ma = (aa & fracmask) | (1_u128 << 112_u32)
  var mb = (ba & fracmask) | (1_u128 << 112_u32)
  var mc = (ca & fracmask) | (1_u128 << 112_u32)
  var ea = LLVM::int_truncate[U128, S64](aa >>> 112_u32) -% 16495_s64
  var eb = LLVM::int_truncate[U128, S64](ba >>> 112_u32) -% 16495_s64
  var ec = LLVM::int_truncate[U128, S64](ca >>> 112_u32) -% 16495_s64
  var pneg = ((a ^ b) & signmask) != 0_u128
  var cneg = (c & signmask) != 0_u128
  # the product (225 or 226 bits) and c with their top bits at 255, and the exponents of their bit 0
  var pr = b128_trig_wmul(x: ma, y: mb)
  var pw = (LLVM::zero_extend[U128, U256](pr.item0) << 128_u32) | LLVM::zero_extend[U128, U256](pr.item1)
  var plz = LLVM::int_truncate[U256, S64](LLVM::leading_zeros(pw))
  pw = pw << b128_trig_sh(n: plz)
  var pe = ea +% eb -% plz
  var cw = LLVM::zero_extend[U128, U256](mc) << 143_u32
  var ce = ec -% 143_s64
  var x = pw
  var xe = pe
  var xneg = pneg
  var y = cw
  var ye = ce
  var yneg = cneg
  if ce > pe or (ce == pe and cw > pw)
    x = cw
    xe = ce
    xneg = cneg
    y = pw
    ye = pe
    yneg = pneg
  var d = xe -% ye
  var ys = 0_u256
  var sticky = true
  if d < 256_s64
    ys = y >>> b128_trig_sh(n: d)
    sticky = (ys << b128_trig_sh(n: d)) != y
  var sum = 0_u256
  var e = xe
  if xneg == yneg
    sum = x +% ys
    if sum < x
      # the carry: one bit up, the dropped low bit into the sticky bit
      if (sum & 1_u256) != 0_u256
        sticky = true
      sum = (sum >>> 1_u32) | (1_u256 << 255_u32)
      e = e +% 1_s64
  else
    sum = x -% ys
    if sticky
      sum = sum -% 1_u256
    if sum == 0_u256
      # exact cancellation: +0
      return (true, 0_u128)
  var lz = LLVM::int_truncate[U256, S64](LLVM::leading_zeros(sum))
  sum = sum << b128_trig_sh(n: lz)
  e = e -% lz
  if sticky
    sum = sum | 1_u256
  var lead = e +% 255_s64
  if lead < -16382_s64 or lead > 16383_s64
    return (false, 0_u128)
  # the top 113 bits, rounded to nearest even on the 143 below
  var q = LLVM::int_truncate[U256, U128](sum >>> 143_u32)
  var rem = sum & ((1_u256 << 143_u32) -% 1_u256)
  var half = 1_u256 << 142_u32
  var bits = (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](lead +% 16383_s64)) << 112_u32) +% (q -% (1_u128 << 112_u32))
  if rem > half or (rem == half and (q & 1_u128) == 1_u128)
    bits = bits +% 1_u128
  if xneg
    bits = bits | signmask
  return (true, bits)

routine B128.fma_unchecked(b: B128, c: B128) -> B128
  var (fast, fb) = b128_fma_fast(a: me.to_bits(), b: b.to_bits(), c: c.to_bits())
  if fast
    return B128.from_bits(bits: fb)
  var nan = B128.from_bits(bits: b128_qnan())
  if me.is_nan() or b.is_nan() or c.is_nan()
    return nan
  var pneg = me.is_negative() != b.is_negative()
  var pzero = me.is_zero() or b.is_zero()
  if me.is_infinite() or b.is_infinite()
    if pzero
      return nan
    if c.is_infinite() and c.is_negative() != pneg
      return nan
    var ps = 0_u64
    if pneg
      ps = 1_u64
    return B128.from_bits(bits: b128_inf(sign: ps))
  if c.is_infinite()
    return c
  if pzero
    if c.is_zero()
      # (+0) + (+0) and (-0) + (-0) keep their sign, mixed signs give +0
      if pneg and c.is_negative()
        return c
      return B128.from_bits(bits: 0_u128)
    return c
  var (ma, ea) = b128_int_parts(x: me)
  var (mb, eb) = b128_int_parts(x: b)
  var p = b128_trig_wmul(x: ma, y: mb)
  var pt = (0_u128, p.item1, p.item0)
  var pe = ea +% eb -% 128_s64
  if c.is_zero()
    return wx_b128(w: wx_make(neg: pneg, t: pt, e: pe, rel: 0.0))
  var (mc, ec) = b128_int_parts(x: c)
  var sum = b128_exact_sum(neg_a: pneg, a: pt, ea: pe, neg_b: c.is_negative(), b: (0_u128, 0_u128, mc), eb: ec -% 256_s64)
  if wx_is_zero(w: sum)
    return B128.from_bits(bits: 0_u128)
  return wx_b128(w: sum)

### Returns `sqrt(x^2 + y^2)` without spurious overflow.
### :param x: One leg.
### :param y: The other leg.
routine hypot!(x: B128, y: B128) -> B128
  var rr = hypot_unchecked(x: x, y: y)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `sqrt(x^2 + y^2 + z^2)` without spurious overflow. Checked: crashes on non-finite.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot!(x: B128, y: B128, z: B128) -> B128
  var rr = hypot_unchecked(x: x, y: y, z: z)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### The exact square of a finite nonzero B128 added to sum (see b128_exact_sum).
secret routine b128_add_square(sum: B128Wx, x: B128) -> B128Wx
  if x.is_zero()
    return sum
  var (m, e) = b128_int_parts(x: x)
  var p = b128_trig_wmul(x: m, y: m)
  var sq = (0_u128, p.item1, p.item0)
  if wx_is_zero(w: sum)
    return wx_make(neg: false, t: sq, e: 2_s64 *% e -% 128_s64, rel: 0.0)
  return b128_exact_sum(neg_a: false, a: wx_t(w: sum), ea: sum.e, neg_b: false, b: sq, eb: 2_s64 *% e -% 128_s64)

### `sqrt(x^2 + y^2 + z^2)`, correctly rounded, with raw IEEE (any inf -> +inf, any NaN -> qNaN). No crash.
### The squares are exact and their sum exact up to a sticky bit; the root of its top 229 or 230 bits (an
### even power of two left over) is an exact integer square root whose remainder joins the sticky bit.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot_unchecked(x: B128, y: B128, z: B128) -> B128
  if x.is_infinite() or y.is_infinite() or z.is_infinite()
    return B128.from_bits(bits: b128_inf(sign: 0_u64))
  if x.is_nan() or y.is_nan() or z.is_nan()
    return B128.from_bits(bits: b128_qnan())
  var sum = b128_add_square(sum: b128_add_square(sum: b128_add_square(sum: wx_zero(rel: 0.0), x: x), x: y), x: z)
  if wx_is_zero(w: sum)
    return B128.from_bits(bits: 0_u128)
  # sum = n * 2^s + rest with n its top 230 or 229 bits and s even
  var s = sum.e +% 154_s64
  if (s & 1_s64) != 0_s64
    s = s +% 1_s64
  var sh = s -% sum.e
  var t = b128_trig_shr384(x: wx_t(w: sum), shift: sh)
  var back = b128_trig_shl384(x: t, shift: sh)
  var sticky = back.item0 != sum.m0 or back.item1 != sum.m1 or back.item2 != sum.m2
  var n = (LLVM::zero_extend[U128, U256](t.item1) << 128_u32) | LLVM::zero_extend[U128, U256](t.item0)
  var root = b128_isqrt256(n: n)
  if root *% root != n
    sticky = true
  # the root's 115 bits, two zero bits below them, and the sticky bit below those
  var rt = LLVM::int_truncate[U256, U128](root) << 2_u32
  if sticky
    rt = rt | 1_u128
  return wx_b128(w: wx_make(neg: false, t: (0_u128, 0_u128, rt), e: (s >> 1) -% 258_s64, rel: 0.0))

### Returns `sin(pi*me)`: sin(pi*n) is ±0 with the sign of me.
routine B128.sinpi() -> B128
  if me.is_nan() or me.is_zero()
    return me
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  if b128_is_int(a: me)
    return B128.from_bits(bits: me.to_bits() & (1_u128 << 127_u32))
  var (fast, v) = b128_trigpi_fast(y: me, which: 0_u64)
  if fast
    return v
  return b128_wide_pi(y: me, which: 0_u64)

### Returns `cos(pi*me)`: cos(pi*(n + 1/2)) is +0.
routine B128.cospi() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  if b128_is_int(a: me *! 2.0_b128) and not b128_is_int(a: me)
    return B128.from_bits(bits: 0_u128)
  var (fast, v) = b128_trigpi_fast(y: me, which: 1_u64)
  if fast
    return v
  return b128_wide_pi(y: me, which: 1_u64)

### Returns `tan(pi*me)`. At an integer n it is +0 for a positive even n and -0 for a positive odd one (IEEE
### 754 tanPi), with the opposite signs for negative n since tanpi is odd.
routine B128.tanpi() -> B128
  if me.is_nan() or me.is_zero()
    return me
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  if b128_is_int(a: me)
    var zb = 0_u128
    if me.is_negative() != b128_integer_is_odd(a: me)
      zb = 1_u128 << 127_u32
    return B128.from_bits(bits: zb)
  if b128_is_int(a: me *! 2.0_b128)
    # n + 1/2: +inf for an even n, -inf for an odd one
    var sg = 0_u64
    if b128_integer_is_odd(a: me.floor())
      sg = 1_u64
    return B128.from_bits(bits: b128_inf(sign: sg))
  var (fast, v) = b128_trigpi_fast(y: me, which: 2_u64)
  if fast
    return v
  return b128_wide_pi(y: me, which: 2_u64)

### Returns the error function `erf(me)`.
routine B128.erf() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  var (fast, v) = b128_erf_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 10_u64)

### Returns the complementary error function `erfc(me)`.
routine B128.erfc() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  var (fast, v) = b128_erfc_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 11_u64)

### Returns the gamma function `tgamma(me)`.
routine B128.tgamma!() -> B128
  var rr = me.tgamma_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `tgamma(me)` with raw IEEE (poles at 0/negative integers -> inf/qNaN). No crash.
routine B128.tgamma_unchecked() -> B128
  var (fast, v) = b128_tgamma_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 13_u64)

### Returns the log-gamma function `lgamma(me)` (= ln|gamma(me)|).
routine B128.lgamma() -> B128
  var (fast, v) = b128_lgamma_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 12_u64)
