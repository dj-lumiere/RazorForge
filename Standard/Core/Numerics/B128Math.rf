  throw NumericOverflowError(description: "overflow: out of range")

### `sinh(me)` with raw IEEE (large |me| -> signed inf). No crash.
routine B128.sinh_unchecked() -> B128
  var (fast, v) = b128_sinh_fast(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 1_u64)

