module Core

# ============================================================================
# B128 library functions. Each is one call to Ingrid's export (Ingrid/tessera/binfloat.tess), which is Tessera's
# correctly rounded F128 routine: the CORE-MATH port where CORE-MATH has the binary128 function, Tessera's own
# correctly rounded one elsewhere. The checked forms (`!`) crash here, in RazorForge, on a result that is not
# finite. Only the three-leg hypot is computed here (exact integer arithmetic, one rounding): Tessera has none.
# ============================================================================

### Returns `e^me`.
routine B128.exp!() -> B128
    var rr = me.exp_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `ln(me)`.
routine B128.log!() -> B128
    var rr = me.log_unchecked()
    if rr.is_finite()
        return rr
    if rr.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

