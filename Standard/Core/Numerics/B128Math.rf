module Core

# ============================================================================
# B128 transcendentals. The functions CORE-MATH provides for binary128 (acos, asin, atan, atan2, cbrt, cos,
# exp, exp10, exp2, expm1, hypot, log, sin, sqrt) are correctly rounded integer ports in CoreMath/B128*.rf.
# The rest (tan, sinh/cosh/tanh, asinh/acosh/atanh, log2/log10/log1p, pow, sinpi/cospi/tanpi, erf/erfc,
# tgamma/lgamma) first try a fast path built from the CORE-MATH fast phases with proven error bounds
# (CoreMath/B128Log.rf, B128Fast.rf, B128Erf.rf, B128Gamma.rf), kept only when its band rounds to one B128.
# The few inputs whose band reaches a rounding midpoint go to the 384-bit tier (B128Wx.rf), which rounds
# from a band of about 2^-360.
# ============================================================================

### Whether a finite B128 is an integer (every B128 from 2^112 on is).
secret routine b128_is_int(a: B128) -> Bool
  var bits = a.to_bits()
  var be = LLVM::int_truncate[U128, S64]((bits >>> 112_u32) & 0x7FFF_u128)
  if be == 0x7FFF_s64
    return false
  var f = bits & ((1_u128 << 112_u32) -% 1_u128)
  if be == 0_s64
    return f == 0_u128
  var e = be -% 16383_s64
  if e >= 112_s64
    return true
  if e < 0_s64
    return false
  return (f & ((1_u128 << b128_trig_sh(n: 112_s64 -% e)) -% 1_u128)) == 0_u128

### Whether a finite B128 integer is odd (every B128 from 2^113 on is even).
secret routine b128_integer_is_odd(a: B128) -> Bool
  var bits = a.to_bits()
  var e = LLVM::int_truncate[U128, S64]((bits >>> 112_u32) & 0x7FFF_u128) -% 16383_s64
  if e < 0_s64 or e > 112_s64
    return false
  var m = (bits & ((1_u128 << 112_u32) -% 1_u128)) | (1_u128 << 112_u32)
  return ((m >>> b128_trig_sh(n: 112_s64 -% e)) & 1_u128) == 1_u128

### f(x) on the 384-bit tier for a B128 whose fast path left the rounding open: 0 tan, 1 sinh, 2 cosh,
### 3 tanh, 4 asinh, 5 acosh, 6 atanh, 7 log2, 8 log10, 9 log1p, 10 erf, 11 erfc, 12 lgamma, 13 tgamma.
### Special values, and arguments whose result the range alone settles, are handled first.
secret routine b128_wide(x: B128, which: U64) -> B128
  if x.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: x.to_bits()))
  var nan = B128.from_bits(bits: b128_qnan())
  var posinf = B128.from_bits(bits: b128_inf(sign: 0_u64))
  var neginf = B128.from_bits(bits: b128_inf(sign: 1_u64))
  var one = wx_one()
  var w = wx_of_b128(x: x)
  var ax = x.abs()
  var neg = x.is_negative()
  var signed_one = B128.from_bits(bits: 0x3FFF_u128 << 112_u32)
  if neg
    signed_one = signed_one.neg()
  if which == 0_u64
    if x.is_infinite()
      return nan
    if x.is_zero()
      return x
    var (s, c) = wx_sincos_b128(x: x)
    return wx_b128(w: wx_div(a: s, b: c))
  if which == 1_u64
    if x.is_infinite() or x.is_zero()
      return x
    if ax > 11400.0_b128
      if neg
        return neginf
      return posinf
    return wx_b128(w: wx_sinh(x: w))
  if which == 2_u64
    if x.is_infinite() or ax > 11400.0_b128
      return posinf
    return wx_b128(w: wx_cosh(x: w))
  if which == 3_u64
    if x.is_zero()
      return x
    if x.is_infinite() or ax > 100.0_b128
      return signed_one
    return wx_b128(w: wx_tanh(x: w))
  if which == 4_u64
    if x.is_infinite() or x.is_zero()
      return x
    return wx_b128(w: wx_asinh(x: w))
  if which == 5_u64
    if x < 1.0_b128
      return nan
    if x.is_infinite()
      return x
    return wx_b128(w: wx_acosh(t: wx_sub(a: w, b: one)))
  if which == 6_u64
    if ax > 1.0_b128
      return nan
    if ax == 1.0_b128
      if neg
        return neginf
      return posinf
    if x.is_zero()
      return x
    return wx_b128(w: wx_atanh(x: w, omx: wx_sub(a: one, b: wx_abs(w: w))))
  if which == 7_u64 or which == 8_u64
    if neg and not x.is_zero()
      return nan
    if x.is_zero()
      return neginf
    if x.is_infinite()
      return x
    var scale = wx_table(i: 3_u64)
    if which == 8_u64
      scale = wx_table(i: 4_u64)
    return wx_b128(w: wx_mul(a: wx_log(x: w), b: scale))
  if which == 9_u64
    if x < -1.0_b128
      return nan
    if x == -1.0_b128
      return neginf
    if x.is_infinite() or x.is_zero()
      return x
    return wx_b128(w: wx_log1p(t: w))
  if which == 10_u64
    if x.is_zero()
      return x
    if x.is_infinite() or ax > 20.0_b128
      return signed_one
    return wx_b128(w: wx_erf(x: w, complement: false))
  if which == 11_u64
    if neg and (x.is_infinite() or ax > 20.0_b128)
      return 2.0_b128
    if x.is_infinite() or x > 110.0_b128
      return B128.from_bits(bits: 0_u128)
    return wx_b128(w: wx_erf(x: w, complement: true))
  # lgamma (12) and tgamma (13)
  if x.is_infinite()
    if which == 13_u64 and neg
      return nan
    return posinf
  if x.is_zero()
    if which == 13_u64 and neg
      return neginf
    return posinf
  if neg and b128_is_int(a: x)
    if which == 13_u64
      return nan
    return posinf
  var k = x.round()
  var r = x - k
  var k_odd = b128_integer_is_odd(a: k)
  if which == 13_u64
    if x > 1755.5_b128
      return posinf
    if x < -1800.0_b128
      # |Gamma| underflows; its sign is that of sin(pi x) = (-1)^k sin(pi r)
      var zb = 0_u128
      if r.is_negative() != k_odd
        zb = 1_u128 << 127_u32
      return B128.from_bits(bits: zb)
    return wx_b128(w: wx_tgamma(x: w, k_odd: k_odd, r: wx_of_b128(x: r)))
  return wx_b128(w: wx_lgamma(x: w, k_odd: k_odd, r: wx_of_b128(x: r)).item0)

### sinpi (which 0), cospi (1) or tanpi (2) of a finite non-integer B128 on the 384-bit tier: y = k + r with
### k the nearest integer and |r| <= 1/2 (both exact), and sin / cos(pi y) = (-1)^k sin / cos(pi r).
secret routine b128_wide_pi(y: B128, which: U64) -> B128
  var k = y.round()
  var (s, c) = wx_sincospi(r: wx_of_b128(x: y - k))
  if which == 2_u64
    return wx_b128(w: wx_div(a: s, b: c))
  var v = s
  if which == 1_u64
    v = c
  if b128_integer_is_odd(a: k)
    v = wx_neg(w: v)
  return wx_b128(w: v)

# ============================================================================
# B128 method wrappers
# ============================================================================

### Returns `e^me`.
routine B128.exp!() -> B128
  var rr = me.exp_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `ln(me)`.
routine B128.log!() -> B128
  var rr = me.log_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `e^me - 1`.
routine B128.expm1!() -> B128
  var rr = me.expm1_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `ln(1 + me)`.
routine B128.log1p!() -> B128
  var rr = me.log1p_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(1+me)` with raw IEEE (NaN -> qNaN, me=-1 -> -inf, me<-1 -> qNaN, +inf -> +inf). No crash.
routine B128.log1p_unchecked() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_zero()
    return me
  if me == -1.0_b128
    return B128.from_bits(bits: b128_inf(sign: 1_u64))
  if me < -1.0_b128
    return B128.from_bits(bits: b128_qnan())
  if me.is_infinite()
    return me
  var (fast, v) = b128_log1p_cr(x: me)
  if fast
    return v
  return b128_wide(x: me, which: 9_u64)

### Returns `log2(me)`.
routine B128.log2!() -> B128
  var rr = me.log2_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `log2(me)` with raw IEEE. No crash.
routine B128.log2_unchecked() -> B128
  var (near, nv) = b128_log_near1(x: me, ten: false)
  if near
    return nv
  var (ok, hi, lo) = b128_log_scaled_ok(x: me)
  if ok
    var (fast, v) = b128_log_scaled(hi: hi, lo: lo, c1: 0xB8AA3B295C17F0BB_u64, c0: 0xBE87FED0691D3E89_u64, p: 127_u32)
    if fast
      return v
  return b128_wide(x: me, which: 7_u64)

### Returns `log10(me)`.
routine B128.log10!() -> B128
  var rr = me.log10_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `log10(me)` with raw IEEE. No crash.
routine B128.log10_unchecked() -> B128
  var (near, nv) = b128_log_near1(x: me, ten: true)
  if near
    return nv
  var (ok, hi, lo) = b128_log_scaled_ok(x: me)
  if ok
    var (fast, v) = b128_log_scaled(hi: hi, lo: lo, c1: 0xDE5BD8A937287195_u64, c0: 0x355BAAAFAD33DC32_u64, p: 129_u32)
    if fast
      return v
  return b128_wide(x: me, which: 8_u64)

