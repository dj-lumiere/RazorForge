module Core

import Collections
# ============================================================================
# Constants
# ============================================================================

preset D64_ZERO: D64 = 0.0_d64
preset D64_ONE: D64 = 1.0_d64
# IEEE 754 decimal64: 16 significant digits, emax = 384.
preset D64_MAX: D64 = 9.999999999999999e384_d64
preset D64_MIN: D64 = -9.999999999999999e384_d64
preset D64_MIN_POSITIVE: D64 = 1e-383_d64
preset D64_EPSILON: D64 = 1e-15_d64

# ============================================================================
# D64 — IEEE 754-2008 decimal64 in BID storage. The arithmetic, rounding, conversions, DPD and math are
# computed by Ingrid's decimal engine (Ingrid/tessera/decimal/, written in Tessera), one engine for D32, D64 and
# D128 that rounds each result once to this format. This file keeps the type, its BID layout (decode and encode
# for the text forms), the checked operators, the conversions' RazorForge faces, and text parsing.
# ============================================================================

### A software decimal64 value in BID storage.
@llvm("i64")
record D64
obeys Numeric, Comparable, Assignable, Copyable
    pass

### Narrow decoded fields (U64 coefficient — decimal64 has <= 16 digits).
record D64Parts
    sign: Bool
    special: U64
    exp: S64
    coeff: U64

### Widen to D128Parts for the shared special-value rules / decimal formatter.
routine d64parts_to_d128(p: D64Parts) -> D128Parts
    return D128Parts(
        sign: p.sign,
        special: p.special,
        exp: p.exp,
        coeff: LLVM::zero_extend[U64, U128](p.coeff),
    )

### Reinterprets the 64-bit BID storage as a raw U64 (no decode).
@readonly
routine D64.to_bits() -> U64
    return LLVM::reinterpret_bits[D64, U64](me)

### Reinterprets a raw U64 as BID64 storage (no validation).
common routine D64.from_bits(bits: U64) -> D64
    return LLVM::reinterpret_bits[U64, D64](bits)

### The decimal64 value re-encoded in DPD interchange form. Never crashes.
routine D64.to_dpd() -> U64
    return C::ingrid_d64_to_dpd(x: me.to_bits())

### Decodes a DPD interchange word into a decimal64. Never crashes.
common routine D64.from_dpd(bits: U64) -> D64
    return D64.from_bits(bits: C::ingrid_d64_from_dpd(bits: bits))

### BID64 decode -> narrow parts.
@readonly
routine D64.decode() -> D64Parts
    var bits = me.to_bits()
    # sign = bit 63
    var sign = LLVM::int_ne(
        a: LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 63_u64), b: 1_u64),
        b: 0_u64,
    )
    # top5 = 5-bit combination prefix (bits 62:58) that selects form/special
    var top5 = LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 58_u64), b: 0x1F_u64)
    # 11110 -> infinity (special 1)
    if LLVM::int_eq(a: top5, b: 0x1E_u64)
        return D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
    # 11111 -> NaN; bit 57 distinguishes signaling (special 3) from quiet (special 2)
    if LLVM::int_eq(a: top5, b: 0x1F_u64)
        var sp = 2_u64
        if LLVM::int_ne(
            a: LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 57_u64), b: 1_u64),
            b: 0_u64,
        )
            sp = 3_u64
        return D64Parts(sign: sign, special: sp, exp: 0_s64, coeff: 0_u64)
    var biased = 0_u64
    var c64 = 0_u64
    # top5 >> 3 == 3 means combo prefix starts with 11 -> Form 2, else Form 1
    if LLVM::int_eq(a: LLVM::shift_right_unsigned(top5, 3_u64), b: 3_u64)
        # Form 2: exp bits 60:51, coeff = (bits 50:0) | 2^53
        biased = LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 51_u64), b: 0x3FF_u64)
        c64 = LLVM::bit_or(
            a: LLVM::bit_and(a: bits, b: 0x7FFFFFFFFFFFF_u64),
            b: 0x20000000000000_u64,
        )
    else
        # Form 1: exp bits 62:53, coeff bits 52:0
        biased = LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 53_u64), b: 0x3FF_u64)
        c64 = LLVM::bit_and(a: bits, b: 0x1FFFFFFFFFFFFF_u64)
    # unbias: stored exponent q = biased - 398 (bias=398)
    return D64Parts(
        sign: sign,
        special: 0_u64,
        exp: LLVM::sub(a: LLVM::reinterpret_bits[U64, S64](biased), b: 398_s64),
        coeff: c64,
    )

### Narrow parts -> BID64 (Form 1 / Form 2 / special). Finite parts must already be
### rounded to <= 16 digits and in the decimal64 exponent range (decfin64 guarantees it).
routine d64_of_parts(p: D64Parts) -> D64
    # sign into bit 63
    var sbit = LLVM::shift_left(value: if p.sign then 1_u64 else 0_u64, bits: 63_u64)
    if LLVM::int_ne(a: p.special, b: 0_u64)
        # special: combo prefix 11110 (inf) or 11111 (NaN) into bits 62:58
        var top5 = if LLVM::int_eq(a: p.special, b: 1_u64) then 0x1E_u64 else 0x1F_u64
        var bb = LLVM::bit_or(a: sbit, b: LLVM::shift_left(value: top5, bits: 58_u64))
        # signaling NaN sets bit 57
        if LLVM::int_eq(a: p.special, b: 3_u64)
            bb = LLVM::bit_or(a: bb, b: LLVM::shift_left(value: 1_u64, bits: 57_u64))
        return D64.from_bits(bits: bb)
    # rebias: biased = (q + 398) masked to 10 bits
    var biased = LLVM::bit_and(
        a: LLVM::add(a: LLVM::reinterpret_bits[S64, U64](p.exp), b: 398_u64),
        b: 0x3FF_u64,
    )
    var c64 = p.coeff
    # coeff < 2^53 -> Form 1, else Form 2 (implicit leading 2^53)
    if LLVM::unsigned_lt(a: c64, b: 0x20000000000000_u64)
        # Form 1: exp bits 62:53, coeff bits 52:0
        return D64.from_bits(
            bits: LLVM::bit_or(
                a: LLVM::bit_or(a: sbit, b: LLVM::shift_left(value: biased, bits: 53_u64)),
                b: c64,
            ),
        )
    # Form 2: bits 62:61 = 11, exp bits 60:51, coeff low 51 bits (implicit 2^53)
    var g2 = LLVM::shift_left(value: 0x3_u64, bits: 61_u64)  # the 11 prefix
    var ebits = LLVM::shift_left(value: biased, bits: 51_u64)
    var clow = LLVM::bit_and(a: c64, b: 0x7FFFFFFFFFFFF_u64)  # low 51 coeff bits
    return D64.from_bits(
        bits: LLVM::bit_or(a: LLVM::bit_or(a: sbit, b: g2), b: LLVM::bit_or(a: ebits, b: clow)),
    )

### Infinity / quiet NaN.
common routine D64.infinity(sign: Bool) -> D64
    return d64_of_parts(p: D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64))

### Returns a quiet NaN.
common routine D64.quiet_nan() -> D64
    return d64_of_parts(p: D64Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: 0_u64))

### Returns a signaling NaN (interop/testing; never produced by arithmetic).
common routine D64.signaling_nan() -> D64
    return d64_of_parts(p: D64Parts(sign: false, special: 3_u64, exp: 0_s64, coeff: 0_u64))

### True when this is a finite value (special field == 0).
routine D64.is_finite() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 0_u64)

### True when this is ±infinity (special field == 1).
routine D64.is_infinite() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 1_u64)

### True when this is a NaN (special field >= 2: 2 quiet, 3 signaling).
routine D64.is_nan() -> Bool
    return LLVM::unsigned_ge(a: me.decode().special, b: 2_u64)

### True when this is a SIGNALING NaN (special field == 3).
routine D64.is_signaling() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 3_u64)

### True when this is a finite zero (±0).
@readonly
routine D64.is_zero() -> Bool
    var p = me.decode()
    return LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_eq(a: p.coeff, b: 0_u64)

### Builds a finite D64 from a sign, a coefficient and a base-10 exponent: value = (-1)^sign * coeff *
### 10^exp, rounded half to even to 16 digits and brought into the exponent range.
common routine D64.from_components(sign: Bool, coeff: U64, exp: S64) -> D64
    var neg = 0_u32
    if sign
        neg = 1_u32
    return D64.from_bits(bits: C::ingrid_d64_from_parts(neg: neg, c_low: coeff, c_high: 0_u64, exp: exp))

### Builds a D64 from a 64-bit signed integer (exponent 0).
common routine D64.from_int64(value: S64) -> D64
    var neg = LLVM::signed_lt(a: value, b: 0_s64)
    var mag = if neg then LLVM::sub(a: 0_s64, b: value) else value
    return D64.from_components(sign: neg, coeff: LLVM::reinterpret_bits[S64, U64](mag), exp: 0_s64)

### An integer (sign and 256-bit magnitude) as a D64, rounded half to even to 16 digits.
routine d64_of_integer(neg: Bool, m: U256) -> D64
    var n = 0_u32
    if neg
        n = 1_u32
    var m0 = LLVM::int_truncate[U256, U64](m)
    var m1 = LLVM::int_truncate[U256, U64](m >>> 64_u32)
    var m2 = LLVM::int_truncate[U256, U64](m >>> 128_u32)
    var m3 = LLVM::int_truncate[U256, U64](m >>> 192_u32)
    return D64.from_bits(bits: C::ingrid_d64_from_integer(neg: n, m0: m0, m1: m1, m2: m2, m3: m3))

### The bits of the binary float nearest to x, `which` bits wide (16, 32, 64, or 128). An infinity keeps its sign,
### a NaN becomes the positive quiet NaN.
routine d64_to_binary(x: D64, which: U32) -> U128
    var r = C::ingrid_d64_to_binary(x: x.to_bits(), which: which)
    return (U128(from: r.w1) << 64) | U128(from: r.w0)

### A B128 as a D64, correctly rounded (a narrower binary float widens to B128 exactly first).
routine d64_of_b128(x: B128) -> D64
    return D64.from_bits(bits: C::ingrid_d64_from_binary(low: x.low_bits(), high: x.high_bits()))

# Checked arithmetic crashes with a specific cause on a non-finite result (mirrors B64/Decimal):
# ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 -> DivisionByZeroError. Use the `*_unchecked`
# operators for raw IEEE 754 propagation.

### Returns `me + you`. Checked: crashes if the result is non-finite. Use `add_unchecked` for raw
### IEEE.
@readonly
routine D64.add!(you: D64) -> D64
    var r = D64.from_bits(bits: C::ingrid_d64_add(a: me.to_bits(), b: you.to_bits()))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me - you`. Checked: crashes if the result is non-finite. Use `sub_unchecked` for raw
### IEEE.
@readonly
routine D64.sub!(you: D64) -> D64
    var r = D64.from_bits(bits: C::ingrid_d64_sub(a: me.to_bits(), b: you.to_bits()))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me * you`. Checked: crashes if the result is non-finite. Use `mul_unchecked` for raw
### IEEE.
@readonly
routine D64.mul!(you: D64) -> D64
    var r = D64.from_bits(bits: C::ingrid_d64_mul(a: me.to_bits(), b: you.to_bits()))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me / you`. Checked: `x/0` -> DivisionByZeroError, `0/0` -> domain, overflow ->
### overflow.
### Use `truediv_unchecked` for raw IEEE 754 (`x/0` -> ±inf, `0/0` -> NaN).
@readonly
routine D64.truediv!(you: D64) -> D64
    var r = D64.from_bits(bits: C::ingrid_d64_div(a: me.to_bits(), b: you.to_bits()))
    if r.is_finite()
        return r
    if you.is_zero() and not me.is_zero()
        throw DivisionByZeroError()
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D64.add_unchecked(you: D64) -> D64
    return D64.from_bits(bits: C::ingrid_d64_add(a: me.to_bits(), b: you.to_bits()))

### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D64.sub_unchecked(you: D64) -> D64
    return D64.from_bits(bits: C::ingrid_d64_sub(a: me.to_bits(), b: you.to_bits()))

### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D64.mul_unchecked(you: D64) -> D64
    return D64.from_bits(bits: C::ingrid_d64_mul(a: me.to_bits(), b: you.to_bits()))

### Returns `me / you` with raw IEEE 754 propagation (`x/0` -> ±infinity, `0/0` -> NaN). No crash.
routine D64.truediv_unchecked(you: D64) -> D64
    return D64.from_bits(bits: C::ingrid_d64_div(a: me.to_bits(), b: you.to_bits()))

### Decimal value equality (NaN never equal; infinities equal only with the same sign;
### finite values compare by value, so different cohorts of the same number are equal).
@readonly
routine D64.eq(you: D64) -> Bool
    return C::ingrid_d64_order(a: me.to_bits(), b: you.to_bits()) == 0_s64

### Three-way decimal comparison under IEEE ordered semantics. NaN is unordered and
### maps to `SAME` (matching the B128 engine convention).
@readonly
routine D64.cmp(you: D64) -> ComparisonSign
    var o = C::ingrid_d64_order(a: me.to_bits(), b: you.to_bits())
    if o == -1_s64
        return ME_SMALL
    if o == 1_s64
        return ME_LARGE
    return SAME

### Raises this value to the `you` power (IEEE semantics: inf/NaN on overflow/domain error).
@readonly
routine D64.pow!(you: D64) -> D64
    var r = me.pow_unchecked(you: you)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Shortest decimal text (widens to D128Parts and reuses the shared formatter).
@override
routine D64.represent() -> Text
    return d128_represent(p: d64parts_to_d128(p: me.decode()))

### Renders this value with exactly `places` digits after the point, rounded half to even from its
### exact value (`2.675.fixed(2)` is `2.67`, since the stored double is just below 2.675). The integer
### part is always written out in full, never in exponent form.
### :param places: The number of digits after the point (0 for none).
### :returns: The rendered `Text`.
routine D64.fixed(places: U64) -> Text
    return format_decimal_fixed(p: d64parts_to_d128(p: me.decode()), places: places)

### Debug form: `D64(<value>)`.
@override
routine D64.diagnose() -> Text
    return d128_represent_wrapped(p: d64parts_to_d128(p: me.decode()), wrap: "D64", strip: false)

### Returns the smaller of `me` and `you` under decimal ordering.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`, otherwise `you`.
routine D64.min(you: D64) -> D64
    return if me <= you then me else you

### Returns the larger of `me` and `you` under decimal ordering.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`, otherwise `you`.
routine D64.max(you: D64) -> D64
    return if me >= you then me else you

### Restricts `me` to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound.
### :param max_val: The upper bound.
### :returns: The clamped value.
@positional
routine D64.clamp(min_val: D64, max_val: D64) -> D64
    return me.min(max_val).max(min_val)

### Returns the reciprocal `1 / me`.
### :returns: The multiplicative inverse.
routine D64.recip() -> D64
    return D64_ONE.truediv_unchecked(me)

### Returns `me` raised to the integer power `n` via exponentiation by squaring.
### A negative `n` inverts the result.
### :param n: The integer exponent.
### :returns: `me ** n`.
routine D64.powi(n: S32) -> D64
    var base = if n < 0_s32 then D64_ONE.truediv_unchecked(me) else me
    var count = n.unsigned_abs()
    var result = D64_ONE
    while count > 0_u32
        if count.bitand(1_u32) == 1_u32
            result = result.mul_unchecked(base)
        base = base.mul_unchecked(base)
        count = count.lshr(1_u32)
    return result

### Returns `(me + you) / 2`.
### :param you: The other value.
### :returns: The arithmetic midpoint of `me` and `you`.
routine D64.midpoint(you: D64) -> D64
    return me.add_unchecked(you).truediv_unchecked(2.0_d64)

# ============================================================================
# Creators — integers (exact, then rounded half to even to 16 digits)
# ============================================================================

### Converts an S8 into decimal64 (exponent 0).
routine D64(from: S8) -> D64
    return D64.from_int64(value: S64(from))

### Converts an S16 into decimal64 (exponent 0).
routine D64(from: S16) -> D64
    return D64.from_int64(value: S64(from))

### Converts an S32 into decimal64 (exponent 0).
routine D64(from: S32) -> D64
    return D64.from_int64(value: S64(from))

### Converts an S64 into decimal64 (exponent 0).
routine D64(from: S64) -> D64
    return D64.from_int64(value: from)

### Converts an S128 into decimal64 (exponent 0, rounded half to even when it has more than 16 digits).
routine D64(from: S128) -> D64
    var v = LLVM::sign_extend[S128, S256](from)
    var neg = v < 0_s256
    var mag = LLVM::reinterpret_bits[S256, U256](v)
    if neg
        mag = 0_u256 -% mag
    return d64_of_integer(neg: neg, m: mag)

### Converts an S256 into decimal64 (exponent 0, rounded half to even when it has more than 16 digits).
routine D64(from: S256) -> D64
    var v = from
    var neg = v < 0_s256
    var mag = LLVM::reinterpret_bits[S256, U256](v)
    if neg
        mag = 0_u256 -% mag
    return d64_of_integer(neg: neg, m: mag)

### Converts a U8 into decimal64 (exponent 0).
routine D64(from: U8) -> D64
    return D64.from_components(sign: false, coeff: U64(from), exp: 0_s64)

### Converts a U16 into decimal64 (exponent 0).
routine D64(from: U16) -> D64
    return D64.from_components(sign: false, coeff: U64(from), exp: 0_s64)

### Converts a U32 into decimal64 (exponent 0).
routine D64(from: U32) -> D64
    return D64.from_components(sign: false, coeff: U64(from), exp: 0_s64)

### Converts a U64 into decimal64 (exponent 0).
routine D64(from: U64) -> D64
    return D64.from_components(sign: false, coeff: from, exp: 0_s64)

### Converts a U128 into decimal64 (exponent 0, rounded half to even when it has more than 16 digits).
routine D64(from: U128) -> D64
    return d64_of_integer(neg: false, m: LLVM::zero_extend[U128, U256](from))

### Converts a U256 into decimal64 (exponent 0, rounded half to even when it has more than 16 digits).
routine D64(from: U256) -> D64
    return d64_of_integer(neg: false, m: from)

# ============================================================================
# Creators — binary floats (widened to B128 exactly, then correctly rounded once)
# ============================================================================

### Converts a B16 to decimal64, correctly rounded.
routine D64(from: B16) -> D64
    return d64_of_b128(x: B128(from: from))

### Converts a B32 to decimal64, correctly rounded.
routine D64(from: B32) -> D64
    return d64_of_b128(x: B128(from: from))

### Converts a B64 to decimal64, correctly rounded.
routine D64(from: B64) -> D64
    return d64_of_b128(x: B128(from: from))

### Converts a B128 to decimal64, correctly rounded.
routine D64(from: B128) -> D64
    return d64_of_b128(x: from)

# ============================================================================
# Creators — decimal <-> decimal
# ============================================================================

### Converts a D32 to D64 (exact: every decimal32 is a decimal64).
routine D64(from: D32) -> D64
    return D64.from_bits(bits: C::ingrid_d64_from_d32(x: from.to_bits()))

### Identity conversion (D64 -> D64).
routine D64(from: D64) -> D64
    return from

### Converts a D128 to D64 (rounded half to even to 16 digits, the exponent kept where it fits).
routine D64(from: D128) -> D64
    return D64.from_bits(bits: C::ingrid_d64_from_d128(x_low: d128_low(v: from), x_high: d128_high(v: from)))

# ============================================================================
# Text parsing — the shared scanner, rounded once to decimal64
# ============================================================================

### Parses a decimal literal into a `D64` (the scanned value rounded once to 16 digits).
### :throws: {InvalidValueError} if the text is not a valid decimal literal.
routine D64!(from_text: Text) -> D64
    var p = scan_decimal_parts(from_text: from_text)
    if p.special == 1_u64
        return D64.infinity(sign: p.sign)
    if p.special >= 2_u64
        return D64.quiet_nan()
    var neg = 0_u32
    if p.sign
        neg = 1_u32
    var low = LLVM::int_truncate[U128, U64](p.coeff)
    var high = LLVM::int_truncate[U128, U64](p.coeff >>> 64)
    return D64.from_bits(bits: C::ingrid_d64_from_parts(neg: neg, c_low: low, c_high: high, exp: p.exp))

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
routine D64.to_bytes_le() -> Array[Byte, 8]
    var raw = me.to_bits()
    var result = Array[Byte, 8]()
    var i = 0_u64
    while LLVM::unsigned_lt(a: i, b: 8_u64)
        var b = LLVM::int_truncate[U64, U8](
            LLVM::shift_right_unsigned(raw, LLVM::mul(a: i, b: 8_u64)),
        )
        result = LLVM::set_byte_at(array: result, index: i, value: b)
        i = LLVM::add(a: i, b: 1_u64)
    return result

### Returns the raw bytes of this value in big-endian order.
routine D64.to_bytes_be() -> Array[Byte, 8]
    var raw = me.to_bits()
    var result = Array[Byte, 8]()
    var i = 0_u64
    while LLVM::unsigned_lt(a: i, b: 8_u64)
        var b = LLVM::int_truncate[U64, U8](
            LLVM::shift_right_unsigned(raw, LLVM::mul(a: LLVM::sub(a: 7_u64, b: i), b: 8_u64)),
        )
        result = LLVM::set_byte_at(array: result, index: i, value: b)
        i = LLVM::add(a: i, b: 1_u64)
    return result
