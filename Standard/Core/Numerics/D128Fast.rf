module Core

# ============================================================================
# Fast paths for the D128 transcendentals, from the B128 fast phases
# ============================================================================
# A D128 carries 34 digits, about 113 bits, so the B128 fast phases (exp, log, sin, cos, their compounds)
# have the precision it needs. A value c * 10^q is multiplied by the 256-bit power of ten into binary
# (d128_split): its B128 truncation xb and the rest lo, within 2^-252. A function badly conditioned at
# large arguments (exp, sin, cos, sinh, cosh) is evaluated at xb and corrected by its derivative times
# lo, a well-conditioned one takes the 128-bit value directly, and the result (a B128Fx with its proven
# error bound) is rounded to 34 digits by the 256-bit power of ten again (d128_round_fx), kept only when
# its whole band lands on one D128 and stored reduced (trailing zeros stripped), like the W=192 engine's.
# Otherwise the caller runs the W=192 engine as before.

# ln 2, ln 10, 1/ln 2 and 1/ln 10 as 128-bit significands (exponents -128, -126, -127 and -129), rounded.
secret preset D128F_LN2_M: U128 = 0xB17217F7D1CF79ABC9E3B39803F2F6AF_u128
secret preset D128F_LN10_M: U128 = 0x935D8DDDAAA8AC16EA56D62B82D30A29_u128
secret preset D128F_INV_LN2_M: U128 = 0xB8AA3B295C17F0BBBE87FED0691D3E89_u128
secret preset D128F_INV_LN10_M: U128 = 0xDE5BD8A937287195355BAAAFAD33DC32_u128

# ln 10 in units of 2^-148 (hi, lo words), rounded.
secret preset D128F_LN10_148_HI: U128 = 0x0000000000000000000000000024D763_u128
secret preset D128F_LN10_148_LO: U128 = 0x776AAA2B05BA95B58AE0B4C28A38A3FB_u128

# |x| thresholds as B128 bit patterns without the sign: 2^-57, 1/4, 2^-20 and 2^100.
secret preset D128F_TINY: U128 = 0x3FC60000000000000000000000000000_u128
secret preset D128F_QUARTER: U128 = 0x3FFD0000000000000000000000000000_u128
secret preset D128F_2M20: U128 = 0x3FEB0000000000000000000000000000_u128
secret preset D128F_2P100: U128 = 0x40630000000000000000000000000000_u128

# 1/(k + 1)! for k = 0 .. 29 in units of 2^-126, the series of (e^x - 1)/x.
secret preset D128F_EXPM1_SERIES: Array[S128, 30] = [
  85070591730234615865843651857942052864_s128, 42535295865117307932921825928971026432_s128,
  14178431955039102644307275309657008811_s128, 3544607988759775661076818827414252203_s128,
  708921597751955132215363765482850441_s128, 118153599625325855369227294247141740_s128,
  16879085660760836481318184892448820_s128, 2109885707595104560164773111556103_s128,
  234431745288344951129419234617345_s128, 23443174528834495112941923461734_s128,
  2131197684439499555721993041976_s128, 177599807036624962976832753498_s128,
  13661523618201920228987134884_s128, 975823115585851444927652492_s128,
  65054874372390096328510166_s128, 4065929648274381020531885_s128,
  239172332251434177678346_s128, 13287351791746343204353_s128,
  699334304828754905492_s128, 34966715241437745275_s128,
  1665081678163702156_s128, 75685530825622825_s128,
  3290675253287949_s128, 137111468886998_s128,
  5484458755480_s128, 210940721365_s128,
  7812619310_s128, 279022118_s128,
  9621452_s128, 320715_s128
]

### |x| of a D128 in binary: xb its B128 truncation, lo the rest (valid when has_lo), err a bound on
### |xb + lo - |x|| / |x|, full the whole value as a B128Fx (128 bits), neg the sign of x.
secret record D128Split
  neg: Bool
  xb: B128
  lo: B128Fx
  has_lo: Bool
  err: B64
  full: B128Fx

### c * 10^q (c > 0, below 2^128) in binary as a 256-bit significand v in [2^255, 2^256) with its exponent,
### and a bound on the relative error: exact from c * 5^q when 0 <= q <= 55, otherwise through the 256-bit
### power of ten (2^-254) with the product's lower bits dropped (2^-255). False outside the power table.
secret routine d128_scale_parts(c: U128, q: S64) -> (Bool, U256, S64, B64)
  var x2 = 0_u128
  var x1 = 0_u128
  var x0 = 0_u128
  var sc = q
  var err = 0.0
  if q >= 0_s64 and q <= 55_s64
    var pr = b128_trig_wmul(x: c, y: b128t_pow5(p: q))
    x1 = pr.item0
    x0 = pr.item1
  else
    if q < -4928_s64 or q > 5055_s64
      return (false, 0_u256, 0_s64, 0.0)
    var (mh, ml, e10) = b128t_pow10(n: q)
    var ph = b128_trig_wmul(x: c, y: mh)
    var pl = b128_trig_wmul(x: c, y: ml)
    var (m1, cy) = b128t_add(a: pl.item0, b: ph.item1, cin: 0_u128)
    x2 = ph.item0 +% cy
    x1 = m1
    x0 = pl.item1
    sc = e10
    err = 0x1.8p-253
  # the top 256 bits of x2 : x1 : x0
  var top = (LLVM::zero_extend[U128, U256](x2) << 128_u32) | LLVM::zero_extend[U128, U256](x1)
  if top == 0_u256
    return (false, 0_u256, 0_s64, 0.0)
  var lz = LLVM::int_truncate[U256, S64](LLVM::leading_zeros(top))
  var v = (top << b128_trig_sh(n: lz)) | (LLVM::zero_extend[U128, U256](x0) >>> b128_trig_sh(n: 128_s64 -% lz))
  if lz < 128_s64 and (x0 << b128_trig_sh(n: lz)) != 0_u128
    err = err +! 0x1p-255
  return (true, v, sc +% 128_s64 -% lz, err)

### (-1)^neg * c * 10^q as a B128Fx (c > 0 below 2^128), or false outside the power table.
secret routine d128_coeff_fx(neg: Bool, c: U128, q: S64) -> (Bool, B128Fx)
  var (ok, v, sc, err) = d128_scale_parts(c: c, q: q)
  if not ok
    return (false, b128fx_one())
  var f = b128fx_norm(neg: neg, mag: v, scale: sc, abserr: 0.0)
  return (true, B128Fx(neg: neg, m: f.m, e: f.e, rel: f.rel +! err))

### A finite nonzero D128 split as D128Split, or false (a zero, a special, or |x| outside the normal B128
### range or the power table).
secret routine d128_split(x: D128) -> (Bool, D128Split)
  var p = x.decode()
  var nosplit = D128Split(neg: false, xb: B128.from_bits(bits: 0_u128), lo: b128fx_one(), has_lo: false, err: 0.0, full: b128fx_one())
  if p.special != 0_u64 or p.coeff == 0_u128
    return (false, nosplit)
  var (ok, v, sc, err) = d128_scale_parts(c: p.coeff, q: p.exp)
  if not ok
    return (false, nosplit)
  var biased = sc +% 255_s64 +% 16383_s64
  if biased < 1_s64 or biased > 32766_s64
    return (false, nosplit)
  var sig = LLVM::int_truncate[U256, U128](v >>> 143_u32)
  var xb = B128.from_bits(bits: (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](biased)) << 112_u32) | (sig -% (1_u128 << 112_u32)))
  var rest = v & ((1_u256 << 143_u32) -% 1_u256)
  var full = b128fx_norm(neg: p.sign, mag: v, scale: sc, abserr: 0.0)
  full = B128Fx(neg: p.sign, m: full.m, e: full.e, rel: full.rel +! err)
  if rest == 0_u256
    return (true, D128Split(neg: p.sign, xb: xb, lo: b128fx_one(), has_lo: false, err: err, full: full))
  var lo = b128fx_norm(neg: false, mag: rest, scale: sc, abserr: 0.0)
  return (true, D128Split(neg: p.sign, xb: xb, lo: lo, has_lo: true, err: err +! 0x1p-238, full: full))

### xb with the sign of x.
@inline
secret routine d128_signed_xb(s: D128Split) -> B128
  if s.neg
    return B128.from_bits(bits: s.xb.to_bits() | (1_u128 << 127_u32))
  return s.xb

### lo with the sign of x.
@inline
secret routine d128_signed_lo(s: D128Split) -> B128Fx
  return B128Fx(neg: s.neg, m: s.lo.m, e: s.lo.e, rel: s.lo.rel)

### v with its relative bound raised by r.
@inline
secret routine d128_widen(v: B128Fx, r: B64) -> B128Fx
  return B128Fx(neg: v.neg, m: v.m, e: v.e, rel: v.rel +! r)

### The D128 that every value of v's band rounds to (34 digits, half to even), stored reduced, or false:
### the band is wider than 2^-116, reaches a rounding midpoint, or the result leaves the normal D128 range.
### v is scaled by 10^(33 - E), E its leading digit's exponent (estimated from the binary exponent and
### settled by the scaled value), through the 256-bit power of ten (within 3 units of 2^-128).
secret routine d128_round_fx(v: B128Fx) -> (Bool, D128)
  var zero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
  if not (v.rel < 0x1p-116) or v.m == 0_u128
    return (false, zero)
  # from 2^20417 (above 10^6146) the value overflows the largest D128 (just below 10^6145)
  if v.e >= 20290_s64
    return (true, D128.infinity(sign: v.neg))
  var lo34 = 1000000000000000000000000000000000_u128
  var hi34 = 10000000000000000000000000000000000_u128
  var e = schubfach_flog10pow2(q: v.e +% 127_s64)
  var tries = 0_s64
  while tries < 3_s64
    var p = 33_s64 -% e
    if p < -4928_s64 or p > 5055_s64
      return (false, zero)
    var (mh, ml, e10) = b128t_pow10(n: p)
    var sh = 0_s64 -% (v.e +% e10 +% 128_s64)
    if sh < 129_s64
      return (false, zero)
    var x = b128t_scale(cb: v.m, mh: mh, ml: ml, sh: sh)
    var d = LLVM::int_truncate[U256, U128](x >>> 128_u32)
    if d >= hi34
      e = e +% 1_s64
    elseif d < lo34
      e = e -% 1_s64
    else
      var frac = x & ((1_u256 << 128_u32) -% 1_u256)
      var xv = b128fx_wide_b64(hi: LLVM::int_truncate[U256, U128](x >>> 128_u32), lo: LLVM::int_truncate[U256, U128](x))
      var errf = v.rel *! xv *! 1.0001 +! 4.0
      # the band must stay below a quarter of the last digit's unit (2^128 here)
      if not (errf < 0x1p125)
        return (false, zero)
      var err = LLVM::zero_extend[U128, U256](LLVM::float_to_unsigned[B64, U128](errf) +% 1_u128)
      var half = 1_u256 << 127_u32
      if frac +% err >= half and frac <= half +% err
        return (false, zero)
      var c = d
      if frac > half
        c = c +% 1_u128
      var ex = e -% 33_s64
      if c == hi34
        c = lo34
        ex = ex +% 1_s64
      var tz = trailing_zeros10_u128(c: c, cap0: 34_s64)
      c = div_pow10_u128(x: c, k: tz)
      ex = ex +% tz
      if ex < -6176_s64 or ex > 6111_s64
        return (false, zero)
      return (true, d128_of_parts(p: D128Parts(sign: v.neg, special: 0_u64, exp: ex, coeff: c)))
    tries = tries +% 1_s64
  return (false, zero)

### ln(w) for a positive B128Fx w in the normal B128 range as a B128Fx, or false: w is split into its B128
### truncation v and the rest c (below 2^-112 v), and ln w = ln v + c/v, the CORE-MATH logarithm of v
### (at least 2^-21 away from 1, else log1p(w - 1) takes it) plus c times 1/v in B64 (ample for a term
### below 2^-110 of the result), (c/v)^2/2 (below 2^-220) dropped.
secret routine b128fx_ln(w: B128Fx) -> (Bool, B128Fx)
  var (okv, v) = b128fx_to_b128(v: w)
  if not okv or w.neg
    return (false, w)
  var (ok, hi, lo) = b128_log_scaled_ok(x: v)
  if not ok
    var (ok1, t) = b128fx_add(a: w, b: b128fx_neg(v: b128fx_one()))
    if not ok1
      return (false, w)
    return b128fx_log1p(t: t)
  var (lneg, mag) = b128_fs_magnitude(fs: b128_log_fs(hi: hi, lo: lo))
  if mag == 0_u256
    return (false, w)
  var l = b128fx_norm(neg: lneg, mag: mag, scale: -148_s64, abserr: 12.0)
  var (okc, c) = b128fx_add(a: w, b: b128fx_neg(v: b128fx_of(x: v)))
  if not okc
    return (true, d128_widen(v: l, r: w.rel *! 1.001 /! b128fx_b64(v: l)))
  var cv = b128fx_mul(a: c, b: b128fx_of_b64(v: 1.0 /! B64(from: v), rel: 0x1p-51))
  var (oka, s) = b128fx_add(a: l, b: cv)
  if not oka
    return (false, w)
  return (true, d128_widen(v: s, r: 0x1p-200))

# ============================================================================
# exp, exp2, exp10, expm1
# ============================================================================

### e^x as a B128Fx for a split x: e^xb from the CORE-MATH fast phase times 1 + lo (lo^2/2 below 2^-190
### dropped), and the split's error, absolute in the argument, as a relative one in the result.
secret routine d128_exp_split(s: D128Split) -> (Bool, B128Fx)
  var (ok, e) = b128_exp_fx(x: d128_signed_xb(s: s))
  if not ok
    return (false, e)
  var r = e
  if s.has_lo
    var (ok2, onep) = b128fx_add(a: b128fx_one(), b: d128_signed_lo(s: s))
    if not ok2
      return (false, e)
    r = d128_widen(v: b128fx_mul(a: e, b: onep), r: 0x1p-190)
  return (true, d128_widen(v: r, r: s.err *! 1.001 *! B64(from: s.xb)))

### e^x for a D128, or false when the fast path does not settle it.
secret routine d128_exp_fast(x: D128) -> (Bool, D128)
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  var (oke, r) = d128_exp_split(s: s)
  if not oke
    return (false, x)
  return d128_round_fx(v: r)

### b^x for b = 2 (ten false) or 10 (ten true): x = +-(k + f) with k an integer and 0 <= f < 1 split
### exactly in decimal, b^f = e^(f ln b) and b^k exact (a power of two in the exponent, or the 256-bit
### power of ten).
secret routine d128_exp_base_fast(x: D128, ten: Bool) -> (Bool, D128)
  var p = x.decode()
  if p.special != 0_u64 or p.coeff == 0_u128
    return (false, x)
  var k = 0_u128
  var r = 0_u128
  if p.exp >= 0_s64
    if p.exp > 5_s64
      return (false, x)
    k = p.coeff
    var j = 0_s64
    while j < p.exp
      k = k *% 10_u128
      j = j +% 1_s64
  elseif p.exp >= -34_s64
    k = div_pow10_u128(x: p.coeff, k: 0_s64 -% p.exp)
    var pw = 1_u128
    var j2 = 0_s64
    while j2 < 0_s64 -% p.exp
      pw = pw *% 10_u128
      j2 = j2 +% 1_s64
    r = p.coeff -% k *% pw
  else
    r = p.coeff
  if k > 40000_u128
    return (false, x)
  var ki = LLVM::int_truncate[U128, S64](k)
  if p.sign
    ki = 0_s64 -% ki
  var g = b128fx_one()
  if r != 0_u128
    var (okf, f) = d128_coeff_fx(neg: p.sign, c: r, q: p.exp)
    if not okf
      return (false, x)
    var lnb = B128Fx(neg: false, m: D128F_LN2_M, e: -128_s64, rel: 0x1p-128)
    if ten
      lnb = B128Fx(neg: false, m: D128F_LN10_M, e: -126_s64, rel: 0x1p-128)
    var (oke, ef) = b128fx_exp_small(w: b128fx_mul(a: f, b: lnb))
    if not oke
      return (false, x)
    g = ef
  if not ten
    return d128_round_fx(v: B128Fx(neg: false, m: g.m, e: g.e +% ki, rel: g.rel))
  if ki != 0_s64
    if ki < -4928_s64 or ki > 5055_s64
      return (false, x)
    var (mh, ml, e10) = b128t_pow10(n: ki)
    g = b128fx_mul(a: g, b: B128Fx(neg: false, m: mh, e: e10 +% 128_s64, rel: 0x1p-127))
  return d128_round_fx(v: g)

### e^x - 1 for a D128: from |x| = 1/2 on, e^x - 1 (at most a factor 2.6 of cancellation, which the sum's
### bound follows), below it x times the series (e^x - 1)/x = sum x^k / (k + 1)!, 30 terms (the rest below
### 2^-131), by Horner in units of 2^-126 with |x| < 1/2 damping every earlier error (so within 3.5 units
### of a value at least 0.78).
secret routine d128_expm1_fast(x: D128) -> (Bool, D128)
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  if s.xb.to_bits() >= (0x3FFE_u128 << 112_u32)
    var (oke, e) = d128_exp_split(s: s)
    if not oke
      return (false, x)
    var (oka, r) = b128fx_add(a: e, b: b128fx_neg(v: b128fx_one()))
    if not oka
      return (false, x)
    return d128_round_fx(v: r)
  var xf = s.full
  var sh = 0_s64 -% (xf.e +% 126_s64)
  var mag = 0_u128
  if sh < 128_s64
    mag = xf.m >>> b128_trig_sh(n: sh)
  var xs = LLVM::reinterpret_bits[U128, S128](mag)
  if xf.neg
    xs = 0_s128 -% xs
  var acc = D128F_EXPM1_SERIES[29]
  var k = 29_u64
  while k > 0_u64
    k = k -% 1_u64
    acc = D128F_EXPM1_SERIES[k] +% b128erf_smul(a: xs, b: acc)
  var pf = b128fx_norm(neg: false, mag: LLVM::zero_extend[U128, U256](LLVM::reinterpret_bits[S128, U128](acc)), scale: -126_s64, abserr: 4.5)
  return d128_round_fx(v: b128fx_mul(a: xf, b: pf))

# ============================================================================
# log, log2, log10, log1p
# ============================================================================

### ln(x) for a positive finite D128 as a B128Fx, or false. Within 1/2 of 1 it is log1p(x - 1) with x - 1
### exact in decimal. Elsewhere ln(c) + q ln 10 for x = c * 10^q (d128_ln_fixed), summed in units of
### 2^-148 so that the cancellation between the two (ln x is at least ln(3/2) in size there) costs nothing.
secret routine d128_ln_fx(p: D128Parts) -> (Bool, B128Fx)
  if p.special != 0_u64 or p.coeff == 0_u128 or p.sign
    return (false, b128fx_one())
  # |x - 1| < 1/2 when x = c * 10^q lies in (1/2, 3/2)
  if p.exp < 0_s64 and p.exp >= -38_s64
    var pw = 1_u128
    var j = 0_s64
    while j < 0_s64 -% p.exp
      pw = pw *% 10_u128
      j = j +% 1_s64
    if p.coeff +% p.coeff > pw and p.coeff < pw +% (pw >>> 1_u32)
      var neg = p.coeff < pw
      var d = p.coeff -% pw
      if neg
        d = pw -% p.coeff
      if d == 0_u128
        return (false, b128fx_one())
      var (okd, t) = d128_coeff_fx(neg: neg, c: d, q: p.exp)
      if not okd
        return (false, t)
      return b128fx_log1p(t: t)
  var (okw, sum, err) = d128_ln_fixed(p: p)
  if not okw
    return (false, b128fx_one())
  var sneg = sum < 0_s256
  var smag = LLVM::reinterpret_bits[S256, U256](sum)
  if sneg
    smag = 0_u256 -% smag
  return (true, b128fx_norm(neg: sneg, mag: smag, scale: -148_s64, abserr: err))

### ln(c) + q ln 10 for a positive D128 c * 10^q in units of 2^-148 (S256) with its error bound in those
### units: ln c is the CORE-MATH value of the exact integer c (12 units), q ln 10 exact but for the
### constant's rounding (|q| / 2 units). False when c is not below 2^113 or the sum is 0.
secret routine d128_ln_fixed(p: D128Parts) -> (Bool, S256, B64)
  if p.special != 0_u64 or p.coeff == 0_u128 or p.sign
    return (false, 0_s256, 0.0)
  var lc = 0_s256
  var err = 0.5 *! B64(from: p.exp).abs() +! 2.0
  if p.coeff != 1_u128
    if p.coeff >= (1_u128 << 113_u32)
      return (false, 0_s256, 0.0)
    var c = B128(from: p.coeff)
    var (ok, hi, lo) = b128_log_scaled_ok(x: c)
    if not ok
      return (false, 0_s256, 0.0)
    var (lneg, mag) = b128_fs_magnitude(fs: b128_log_fs(hi: hi, lo: lo))
    lc = LLVM::reinterpret_bits[U256, S256](mag)
    if lneg
      lc = 0_s256 -% lc
    err = err +! 12.0
  var ln10 = LLVM::reinterpret_bits[U256, S256]((LLVM::zero_extend[U128, U256](D128F_LN10_148_HI) << 128_u32) | LLVM::zero_extend[U128, U256](D128F_LN10_148_LO))
  var sum = lc +% ln10 *% LLVM::sign_extend[S64, S256](p.exp)
  if sum == 0_s256
    return (false, 0_s256, 0.0)
  return (true, sum, err)

### ln (which 0), log2 (1) or log10 (2) of a D128, or false: ln x times 1/ln 2 or 1/ln 10.
secret routine d128_log_fast(x: D128, which: U64) -> (Bool, D128)
  var (ok, l) = d128_ln_fx(p: x.decode())
  if not ok
    return (false, x)
  if which == 1_u64
    l = b128fx_mul(a: l, b: B128Fx(neg: false, m: D128F_INV_LN2_M, e: -127_s64, rel: 0x1p-128))
  elseif which == 2_u64
    l = b128fx_mul(a: l, b: B128Fx(neg: false, m: D128F_INV_LN10_M, e: -129_s64, rel: 0x1p-128))
  return d128_round_fx(v: l)

### ln(1 + x) for a D128 x > -1, or false: log1p of the 128-bit value, except below -1/2, where 1 + x is
### formed exactly in decimal first (the condition number grows as 1 + x shrinks).
secret routine d128_log1p_fast(x: D128) -> (Bool, D128)
  var p = x.decode()
  if p.special != 0_u64 or p.coeff == 0_u128
    return (false, x)
  if p.sign and p.exp < 0_s64 and p.exp >= -38_s64
    var pw = 1_u128
    var j = 0_s64
    while j < 0_s64 -% p.exp
      pw = pw *% 10_u128
      j = j +% 1_s64
    if p.coeff +% p.coeff >= pw
      if p.coeff >= pw
        return (false, x)
      var (okw, w) = d128_coeff_fx(neg: false, c: pw -% p.coeff, q: p.exp)
      if not okw
        return (false, x)
      var (okl, l) = b128fx_ln(w: w)
      if not okl
        return (false, x)
      return d128_round_fx(v: l)
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  if p.sign and s.xb.to_bits() >= (0x3FFF_u128 << 112_u32)
    return (false, x)
  var (ok2, l2) = b128fx_log1p(t: s.full)
  if not ok2
    return (false, x)
  return d128_round_fx(v: l2)

# ============================================================================
# sin, cos, tan
# ============================================================================

# 2/sqrt(pi) as a 128-bit significand (exponent -127), rounded, and 10 as a B128 bit pattern.
secret preset D128F_TWO_OVER_SQRTPI_M: U128 = 0x906EBA8214DB688D71D48A7F6BFEC344_u128
secret preset D128F_ERF_TEN: U128 = 0x40024000000000000000000000000000_u128

# 1/6 as a 128-bit significand (exponent -130), rounded.
secret preset D128F_SIXTH_M: U128 = 0xAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAB_u128

### sin(xb) and cos(xb) for a finite nonzero B128 xb as signed B128Fx values, or false: one argument
### reduction for both (the CORE-MATH fast path, 16 units each), and below 2^-57 x - x^3/6 and 1 - x^2/2
### (the next terms are below 2^-225 of each).
secret routine b128_sincos_fx(xb: B128) -> (Bool, B128Fx, B128Fx)
  var bits = xb.to_bits()
  var signmask = 1_u128 << 127_u32
  var implicit = 1_u128 << 112_u32
  var ax = bits & (signmask -% 1_u128)
  var one = b128fx_one()
  if ax >= (0x7FFF_u128 << 112_u32) or ax == 0_u128
    return (false, one, one)
  var neg = (bits & signmask) != 0_u128
  if ax < D128F_TINY
    var xf = b128fx_of(x: xb)
    var x2 = b128fx_mul(a: xf, b: xf)
    var x3 = b128fx_mul(a: x2, b: xf)
    var (ok1, sn) = b128fx_add(a: xf, b: b128fx_neg(v: b128fx_mul(a: x3, b: B128Fx(neg: false, m: D128F_SIXTH_M, e: -130_s64, rel: 0x1p-128))))
    var (ok2, cs) = b128fx_add(a: one, b: B128Fx(neg: true, m: x2.m, e: x2.e -% 1_s64, rel: x2.rel))
    return (ok1 and ok2, d128_widen(v: sn, r: 0x1p-225), d128_widen(v: cs, r: 0x1p-225))
  var m = (ax & (implicit -% 1_u128)) | implicit
  var e = LLVM::reinterpret_bits[U64, S64](LLVM::int_truncate[U128, U64](ax >>> 112_u32)) -% 16383_s64
  var fs = (false, 0_u128, 0_s64, 0_u128)
  var fc = fs
  if e < -8_s64
    fs = b128_trig_fast(m: m, e: e, cosine: false)
    fc = b128_trig_fast(m: m, e: e, cosine: true)
  else
    var r = b128_trig_reduce(m: m, e: e)
    if not r.item0
      return (false, one, one)
    var sq = b128_trig_squares(t1: r.item3, et: r.item4)
    var s1 = b128_trig_sin_frac(t1: r.item3, u: sq.item0, v: sq.item1)
    fs = b128_trig_fast_tail(n: r.item1, negative: r.item2, rt1: r.item3, ret: r.item4, sq: sq, s1b: s1, cosine: false)
    fc = b128_trig_fast_tail(n: r.item1, negative: r.item2, rt1: r.item3, ret: r.item4, sq: sq, s1b: s1, cosine: true)
  if not fs.item0 or not fc.item0
    return (false, one, one)
  var sf = b128_trig_fx(f: fs)
  return (true, B128Fx(neg: sf.neg != neg, m: sf.m, e: sf.e, rel: sf.rel), b128_trig_fx(f: fc))

### sin (which 0), cos (1) or tan (2) of a D128, or false: by the angle addition formulas over xb and lo,
### with the split's error, absolute in the argument, added as absolute in the result.
secret routine d128_trig_fast(x: D128, which: U64) -> (Bool, D128)
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  var (okt, sn, cs) = b128_sincos_fx(xb: d128_signed_xb(s: s))
  if not okt
    return (false, x)
  var ea = s.err *! 1.001 *! B64(from: s.xb) +! 0x1p-200
  if s.has_lo
    # lo reaches 2^-112 |x|, so for a large x its own sine and cosine are needed: lo is taken to its
    # B128 truncation lb (the rest, below 2^-112 lo, joins the argument's error) and the angle addition
    # formulas combine sin/cos xb with sin/cos lb
    var lo = d128_signed_lo(s: s)
    var (okb, lb) = b128fx_to_b128(v: lo)
    if not okb
      return (false, x)
    var (okl, sl, cl) = b128_sincos_fx(xb: lb)
    if not okl
      return (false, x)
    var (ok1, s2) = b128fx_add(a: b128fx_mul(a: sn, b: cl), b: b128fx_mul(a: cs, b: sl))
    var (ok2, c2) = b128fx_add(a: b128fx_mul(a: cs, b: cl), b: b128fx_neg(v: b128fx_mul(a: sn, b: sl)))
    if not ok1 or not ok2
      return (false, x)
    sn = s2
    cs = c2
    ea = ea +! b128fx_b64(v: lo) *! 0x1p-111
  sn = d128_widen(v: sn, r: ea /! b128fx_b64(v: sn))
  cs = d128_widen(v: cs, r: ea /! b128fx_b64(v: cs))
  if which == 0_u64
    return d128_round_fx(v: sn)
  if which == 1_u64
    return d128_round_fx(v: cs)
  var (okd, q) = b128fx_div(a: sn, b: cs)
  if not okd
    return (false, x)
  return d128_round_fx(v: q)

# ============================================================================
# sinh, cosh, tanh
# ============================================================================

### sinh (which 0), cosh (1) or tanh (2) of a D128, or false. Below |x| = 1/4 from the 128-bit value:
### sinh by its series, cosh = 1 + 2 sinh(x/2)^2. From there sinh|xb| and cosh|xb| from the CORE-MATH exp
### pair, corrected by the derivative (sinh x = sinh xb + cosh xb lo, cosh x = cosh xb + sinh xb lo).
secret routine d128_hyp_fast(x: D128, which: U64) -> (Bool, D128)
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  var a = s.xb.to_bits()
  var sh = b128fx_one()
  var ch = b128fx_one()
  if a < D128F_QUARTER
    var af = B128Fx(neg: false, m: s.full.m, e: s.full.e, rel: s.full.rel)
    sh = b128_sinh_small(x: af)
    var h = b128_sinh_small(x: B128Fx(neg: false, m: af.m, e: af.e -% 1_s64, rel: af.rel))
    var h2 = b128fx_mul(a: h, b: h)
    var (okc, c) = b128fx_add(a: b128fx_one(), b: B128Fx(neg: false, m: h2.m, e: h2.e +% 1_s64, rel: h2.rel))
    if not okc
      return (false, x)
    ch = c
  else
    var (oks, sx) = b128_sinh_fx(a: a)
    var (okc2, cx) = b128_cosh_fx(a: a)
    if not oks or not okc2
      return (false, x)
    sh = sx
    ch = cx
    if s.has_lo
      var (ok1, s2) = b128fx_add(a: sh, b: b128fx_mul(a: ch, b: s.lo))
      var (ok2, c2) = b128fx_add(a: ch, b: b128fx_mul(a: sh, b: s.lo))
      if not ok1 or not ok2
        return (false, x)
      sh = s2
      ch = c2
    var ea = s.err *! 1.001 *! B64(from: s.xb) *! 1.001
    sh = d128_widen(v: sh, r: ea *! b128fx_b64(v: ch) /! b128fx_b64(v: sh))
    ch = d128_widen(v: ch, r: ea)
  if which == 0_u64
    return d128_round_fx(v: B128Fx(neg: s.neg, m: sh.m, e: sh.e, rel: sh.rel))
  if which == 1_u64
    return d128_round_fx(v: ch)
  var (okd, q) = b128fx_div(a: sh, b: ch)
  if not okd
    return (false, x)
  return d128_round_fx(v: B128Fx(neg: s.neg, m: q.m, e: q.e, rel: q.rel))

# ============================================================================
# asinh, acosh, atanh
# ============================================================================

### ln(2|x|) + the dropped 1/(4x^2) (below 2^-200) for |x| >= 2^100, from the decimal logarithm.
secret routine d128_ln_twice(p: D128Parts) -> (Bool, B128Fx)
  var (ok, l) = d128_ln_fx(p: D128Parts(sign: false, special: p.special, exp: p.exp, coeff: p.coeff))
  if not ok
    return (false, l)
  var (oka, r) = b128fx_add(a: l, b: B128Fx(neg: false, m: D128F_LN2_M, e: -128_s64, rel: 0x1p-128))
  return (oka, d128_widen(v: r, r: 0x1p-200))

### asinh (which 0), acosh (1) or atanh (2) of a D128, or false, by the formulas of the B128 versions
### (log1p forms without cancellation) on the 128-bit value; acosh takes x - 1 exact in decimal, and atanh
### from |x| = 1/2 on takes ln(1 + |x|) - ln(1 - |x|) with both exact in decimal.
secret routine d128_arch_fast(x: D128, which: U64) -> (Bool, D128)
  var p = x.decode()
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  var a = s.xb.to_bits()
  var af = B128Fx(neg: false, m: s.full.m, e: s.full.e, rel: s.full.rel)
  var r = b128fx_one()
  if which == 0_u64
    if a < D128F_2M20
      r = b128fx_mul(a: af, b: b128_arc_small(xf: af, atanh: false))
    elseif a >= D128F_2P100
      var (okl, l) = d128_ln_twice(p: p)
      if not okl
        return (false, x)
      r = l
    else
      var a2 = b128fx_mul(a: af, b: af)
      var (ok1, q) = b128fx_add(a: b128fx_one(), b: a2)
      var (ok2, sq) = b128fx_sqrt(v: q)
      if not ok1 or not ok2
        return (false, x)
      var t = sq
      if a >= (0x3FFF_u128 << 112_u32)
        var (ok3, am1) = b128fx_add(a: af, b: b128fx_neg(v: b128fx_one()))
        var (ok4, t1) = b128fx_add(a: am1, b: sq)
        if not ok3 or not ok4
          return (false, x)
        t = t1
      else
        var (ok5, den) = b128fx_add(a: b128fx_one(), b: sq)
        var (ok6, f) = b128fx_div(a: a2, b: den)
        if not ok5 or not ok6
          return (false, x)
        var (ok7, t2) = b128fx_add(a: af, b: f)
        if not ok7
          return (false, x)
        t = t2
      var (ok8, l2) = b128fx_log1p(t: t)
      if not ok8
        return (false, x)
      r = l2
    return d128_round_fx(v: B128Fx(neg: s.neg, m: r.m, e: r.e, rel: r.rel))
  if which == 1_u64
    if s.neg or a < (0x3FFF_u128 << 112_u32)
      return (false, x)
    if a >= D128F_2P100
      var (okl2, l3) = d128_ln_twice(p: p)
      if not okl2
        return (false, x)
      return d128_round_fx(v: l3)
    # d = x - 1, exact in decimal
    var df = b128fx_one()
    if p.exp >= 0_s64
      var (ok9, d0) = b128fx_add(a: af, b: b128fx_neg(v: b128fx_one()))
      if not ok9
        return (false, x)
      df = d0
    else
      if p.exp < -38_s64
        return (false, x)
      var pw = 1_u128
      var j = 0_s64
      while j < 0_s64 -% p.exp
        pw = pw *% 10_u128
        j = j +% 1_s64
      if p.coeff <= pw
        return (false, x)
      var (ok10, d1) = d128_coeff_fx(neg: false, c: p.coeff -% pw, q: p.exp)
      if not ok10
        return (false, x)
      df = d1
    var (ok11, xp1) = b128fx_add(a: af, b: b128fx_one())
    if not ok11
      return (false, x)
    var (ok12, sq2) = b128fx_sqrt(v: b128fx_mul(a: df, b: xp1))
    if not ok12
      return (false, x)
    var (ok13, t3) = b128fx_add(a: df, b: sq2)
    var (ok14, l4) = b128fx_log1p(t: t3)
    if not ok13 or not ok14
      return (false, x)
    return d128_round_fx(v: l4)
  # atanh
  if a >= (0x3FFF_u128 << 112_u32)
    return (false, x)
  if a < D128F_2M20
    var sm = b128fx_mul(a: af, b: b128_arc_small(xf: af, atanh: true))
    return d128_round_fx(v: B128Fx(neg: s.neg, m: sm.m, e: sm.e, rel: sm.rel))
  var u = b128fx_one()
  var w = b128fx_one()
  if a < (0x3FFE_u128 << 112_u32)
    var (ok15, l5) = b128fx_log1p(t: af)
    var (ok16, l6) = b128fx_log1p(t: b128fx_neg(v: af))
    if not ok15 or not ok16
      return (false, x)
    u = l5
    w = l6
  else
    if p.exp >= 0_s64 or p.exp < -38_s64
      return (false, x)
    var pw2 = 1_u128
    var j3 = 0_s64
    while j3 < 0_s64 -% p.exp
      pw2 = pw2 *% 10_u128
      j3 = j3 +% 1_s64
    if p.coeff >= pw2
      return (false, x)
    var (ok17, onep) = d128_coeff_fx(neg: false, c: pw2 +% p.coeff, q: p.exp)
    var (ok18, onem) = d128_coeff_fx(neg: false, c: pw2 -% p.coeff, q: p.exp)
    if not ok17 or not ok18
      return (false, x)
    var (ok19, l7) = b128fx_ln(w: onep)
    var (ok20, l8) = b128fx_ln(w: onem)
    if not ok19 or not ok20
      return (false, x)
    u = l7
    w = l8
  var (ok21, dd) = b128fx_add(a: u, b: b128fx_neg(v: w))
  if not ok21
    return (false, x)
  return d128_round_fx(v: B128Fx(neg: s.neg, m: dd.m, e: dd.e -% 1_s64, rel: dd.rel))

# ============================================================================
# asin, acos, atan, atan2: one Newton step from the correctly rounded B128 value
# ============================================================================

### f(x) = r0 + delta for the inverse trigonometric functions: r0 is the correctly rounded B128 result at
### xb (within 2^-112 of it), delta = num / den the Newton correction. delta is below 2^-110 of the result,
### so its own relative error only needs to be small (the products are 128-bit, and every cancelling sum
### carries its bound), and the second-order term (delta^2 times tan r0 / 2, or cot, or 0 for atan) is
### added as an error.
secret routine d128_newton_finish(r0: B128, num: B128Fx, den: B128Fx, second: B64, argerr: B64) -> (Bool, D128)
  var zero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
  var rf = b128fx_of(x: r0)
  var r = rf
  if num.m != 0_u128
    var (okd, dl) = b128fx_div(a: num, b: den)
    if not okd
      return (false, zero)
    var dv = b128fx_b64(v: dl)
    var (oka, s) = b128fx_add(a: rf, b: dl)
    if not oka
      return (false, zero)
    r = d128_widen(v: s, r: dv *! dv *! second /! B64(from: r0).abs())
  return d128_round_fx(v: d128_widen(v: r, r: argerr /! B64(from: r0).abs()))

### xb - v + lo as a B128Fx (x's split minus a B128Fx v), or false when it cancels to zero. When xb - v
### cancels exactly, v's own error (|v| v.rel) still bounds the difference, so it is carried into lo's bound.
secret routine d128_residual(s: D128Split, v: B128Fx) -> (Bool, B128Fx)
  var (ok, d) = b128fx_add(a: b128fx_of(x: d128_signed_xb(s: s)), b: b128fx_neg(v: v))
  if not s.has_lo
    return (ok, d)
  if not ok
    var lo = d128_signed_lo(s: s)
    return (true, d128_widen(v: lo, r: v.rel *! 1.001 *! b128fx_b64(v: v) /! b128fx_b64(v: lo)))
  return b128fx_add(a: d, b: d128_signed_lo(s: s))

### asin (which 0), acos (1) or atan (2) of a D128, or false: from r0 = the B128 function at xb, asin x =
### r0 + (x - sin r0) / cos r0, acos x = r0 - (x - cos r0) / sin r0, atan x = r0 + (x - tan r0) /
### (1 + x tan r0), each to first order (atan's step is its exact tangent difference, so its next term is
### cubic).
secret routine d128_arctrig_fast(x: D128, which: U64) -> (Bool, D128)
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  var xs = d128_signed_xb(s: s)
  var r0 = xs
  if which == 0_u64
    if s.xb.to_bits() >= (0x3FFF_u128 << 112_u32)
      return (false, x)
    r0 = xs.asin_unchecked()
  elseif which == 1_u64
    if s.xb.to_bits() >= (0x3FFF_u128 << 112_u32)
      return (false, x)
    r0 = xs.acos_unchecked()
  else
    r0 = xs.atan()
  if not r0.is_finite() or r0.is_zero()
    return (false, x)
  var (okt, sn, cs) = b128_sincos_fx(xb: r0)
  if not okt
    return (false, x)
  var argerr = s.err *! 1.001 *! B64(from: s.xb)
  if which == 0_u64
    var (okr, num) = d128_residual(s: s, v: sn)
    if not okr
      return (false, x)
    return d128_newton_finish(r0: r0, num: num, den: cs, second: b128fx_b64(v: sn) /! b128fx_b64(v: cs), argerr: argerr /! b128fx_b64(v: cs))
  if which == 1_u64
    var (okr2, num2) = d128_residual(s: s, v: cs)
    if not okr2
      return (false, x)
    return d128_newton_finish(r0: r0, num: b128fx_neg(v: num2), den: sn, second: b128fx_b64(v: cs) /! b128fx_b64(v: sn), argerr: argerr /! b128fx_b64(v: sn))
  var (okq, t) = b128fx_div(a: sn, b: cs)
  if not okq
    return (false, x)
  var (okr3, num3) = d128_residual(s: s, v: t)
  var (okd, den) = b128fx_add(a: b128fx_one(), b: b128fx_mul(a: s.full, b: t))
  if not okr3 or not okd
    return (false, x)
  return d128_newton_finish(r0: r0, num: num3, den: den, second: 0.0, argerr: argerr /! b128fx_b64(v: den))

### atan2(y, x) for finite nonzero D128 y and x, or false: r0 = the B128 atan2 at (yb, xb), and the step
### (y cos r0 - x sin r0) / (x cos r0 + y sin r0), the tangent of the remaining angle (cubic next term).
secret routine d128_atan2_fast(y: D128, x: D128) -> (Bool, D128)
  var (oky, sy) = d128_split(x: y)
  var (okx, sx) = d128_split(x: x)
  if not oky or not okx
    return (false, x)
  var r0 = atan2(y: d128_signed_xb(s: sy), x: d128_signed_xb(s: sx))
  if not r0.is_finite() or r0.is_zero()
    return (false, x)
  var (okt, sn, cs) = b128_sincos_fx(xb: r0)
  if not okt
    return (false, x)
  var (ok1, num) = b128fx_add(a: b128fx_mul(a: sy.full, b: cs), b: b128fx_neg(v: b128fx_mul(a: sx.full, b: sn)))
  var (ok2, den) = b128fx_add(a: b128fx_mul(a: sx.full, b: cs), b: b128fx_mul(a: sy.full, b: sn))
  if not ok2
    return (false, x)
  var argerr = (sy.err *! B64(from: sy.xb) +! sx.err *! B64(from: sx.xb)) *! 1.001 /! b128fx_b64(v: den)
  if not ok1
    # the two products cancel exactly: their own errors bound the step
    var pe = (b128fx_b64(v: sy.full) *! b128fx_b64(v: cs) *! (sy.full.rel +! cs.rel) +! b128fx_b64(v: sx.full) *! b128fx_b64(v: sn) *! (sx.full.rel +! sn.rel)) *! 1.01
    return d128_newton_finish(r0: r0, num: B128Fx(neg: false, m: 0_u128, e: 0_s64, rel: 0.0), den: den, second: 0.0, argerr: argerr +! pe /! b128fx_b64(v: den))
  return d128_newton_finish(r0: r0, num: num, den: den, second: 0.0, argerr: argerr)

# ============================================================================
# pow
# ============================================================================

### |x|^y for finite nonzero D128 x (not 1) and y, with the sign of a negative x raised to an integer y,
### or false. z = y ln|x| is formed from the 256-bit y and ln|x| in units of 2^-148 (the decimal logarithm
### of d128_ln_fx, taken in fixed point here, so a large z keeps its absolute accuracy), then e^z as in
### the B128 pow. Near |x| = 1 ln|x| is only a 128-bit value, which is enough while |z| stays below 16.
secret routine d128_pow_fast(x: D128, y: D128) -> (Bool, D128)
  var px = x.decode()
  var py = y.decode()
  if px.special != 0_u64 or py.special != 0_u64 or px.coeff == 0_u128 or py.coeff == 0_u128
    return (false, x)
  var neg = false
  if px.sign
    # y must be an integer, its parity the sign
    if py.exp < 0_s64
      if py.exp < -38_s64
        return (false, x)
      var pw = 1_u128
      var j = 0_s64
      while j < 0_s64 -% py.exp
        pw = pw *% 10_u128
        j = j +% 1_s64
      var q = py.coeff // pw
      if q *% pw != py.coeff
        return (false, x)
      neg = (q & 1_u128) == 1_u128
    elseif py.exp == 0_s64
      neg = (py.coeff & 1_u128) == 1_u128
  var ax = D128Parts(sign: false, special: 0_u64, exp: px.exp, coeff: px.coeff)
  var (oky, vy, sy, ey) = d128_scale_parts(c: py.coeff, q: py.exp)
  if not oky
    return (false, x)
  # ln|x| as a 256-bit magnitude lm * 2^lsc with relative error lrel: the fixed-point sum where it applies,
  # else (near 1) the 128-bit value
  var lm = 0_u256
  var lsc = 0_s64
  var lrel = 0.0
  var lneg = false
  var (okw, lw, lerr) = d128_ln_fixed(p: ax)
  if okw
    lneg = lw < 0_s256
    lm = LLVM::reinterpret_bits[S256, U256](lw)
    if lneg
      lm = 0_u256 -% lm
    var llz = LLVM::int_truncate[U256, S64](LLVM::leading_zeros(lm))
    lm = lm << b128_trig_sh(n: llz)
    lsc = -148_s64 -% llz
    lrel = lerr *! b128fx_p2(k: -148_s64) /! (b128fx_top(m: LLVM::int_truncate[U256, U128](lm >>> 128_u32)) *! b128fx_p2(k: lsc +% 192_s64))
  else
    var (okl, l) = d128_ln_fx(p: ax)
    if not okl
      return (false, x)
    lneg = l.neg
    lm = LLVM::zero_extend[U128, U256](l.m) << 128_u32
    lsc = l.e -% 128_s64
    lrel = l.rel
  # z = y * ln|x|: the two 256-bit significands' product, its lower half dropped
  var hi = u256_mulhi(a: vy, b: lm)
  var zneg = py.sign != lneg
  var zscale = sy +% lsc +% 256_s64
  if hi == 0_u256
    return (false, x)
  var lead = 255_s64 -% LLVM::int_truncate[U256, S64](LLVM::leading_zeros(hi))
  var biased = lead +% zscale +% 16383_s64
  if biased < 1_s64 or biased > 32766_s64
    return (false, x)
  # |z| as a B64, and its absolute error: l's relative error times |z|, plus y's and the product's
  var zv = b128fx_top(m: LLVM::int_truncate[U256, U128](hi >>> b128_trig_sh(n: lead -% 127_s64))) *! b128fx_p2(k: lead +% zscale -% 63_s64)
  if not (zv < 11000.0)
    return (false, x)
  var zerr = zv *! (lrel +! ey +! 0x1p-250) *! 1.001
  var sh = b128_trig_sh(n: lead -% 112_s64)
  var zsig = LLVM::int_truncate[U256, U128](hi >>> sh)
  var rest = hi & ((1_u256 << sh) -% 1_u256)
  var zbits = (LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](biased)) << 112_u32) | (zsig -% (1_u128 << 112_u32))
  if zneg
    zbits = zbits | (1_u128 << 127_u32)
  var (oke, ez) = b128_exp_fx(x: B128.from_bits(bits: zbits))
  if not oke
    return (false, x)
  var r = d128_widen(v: ez, r: zerr)
  if rest != 0_u256
    var zl = b128fx_norm(neg: zneg, mag: rest, scale: zscale, abserr: 0.0)
    var (oko, onep) = b128fx_add(a: b128fx_one(), b: zl)
    if not oko
      return (false, x)
    r = d128_widen(v: b128fx_mul(a: ez, b: onep), r: zerr +! 0x1p-190)
  return d128_round_fx(v: B128Fx(neg: neg, m: r.m, e: r.e, rel: r.rel))

# ============================================================================
# erf, erfc, lgamma, tgamma: the B128 value at xb and the derivative times lo
# ============================================================================

### erf (which 0) or erfc (1) of a D128, or false: the B128 core at xb plus (or minus) (2/sqrt(pi))
### e^(-xb^2) lo (the next term, 2|x| e^(-x^2) lo^2, is below 2^-200 of it for |x| < 106.5).
secret routine d128_erf_fast(x: D128, which: U64) -> (Bool, D128)
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  var xs = d128_signed_xb(s: s)
  var (okc, f) = b128_erf_fx(x: xs)
  if which == 1_u64
    var (okc2, f2) = b128_erfc_fx(x: xs)
    okc = okc2
    f = f2
  if not okc
    return (false, x)
  var xv = B64(from: s.xb)
  # erf is +-1 from 10 on (1 - erf(10) < 2^-148), erfc keeps its correction
  if s.has_lo and (which == 1_u64 or s.xb.to_bits() < D128F_ERF_TEN)
    var g = b128fx_one()
    if s.xb.to_bits() >= D128F_TINY
      var (okg, eg) = b128_exp_neg_sq(a: s.xb)
      if not okg
        return (false, x)
      g = eg
    var d = b128fx_mul(a: b128fx_mul(a: g, b: B128Fx(neg: false, m: D128F_TWO_OVER_SQRTPI_M, e: -127_s64, rel: 0x1p-128)), b: d128_signed_lo(s: s))
    if which == 1_u64
      d = b128fx_neg(v: d)
    var (oka, r) = b128fx_add(a: f, b: d)
    if not oka
      return (false, x)
    f = d128_widen(v: r, r: 0x1p-200)
  # the split's error moves the result by at most 2 e^(-x^2) |x| err <= 2 |x| err absolute
  return d128_round_fx(v: d128_widen(v: f, r: 2.0 *! s.err *! (xv +! 1.0) /! b128fx_b64(v: f)))

### lgamma (which 0) or tgamma (1) of a positive D128, or false: the B128 core at xb and the digamma
### correction psi(xb) lo (added for lgamma, as a factor 1 + psi lo for tgamma), psi in B64 within its
### bound; the next term, trigamma lo^2 / 2, is below 2^-200 of the result away from the poles. An integer
### up to 57 is (n - 1)! exactly, 1 and 2 give lgamma 0.
secret routine d128_gamma_fast(x: D128, which: U64) -> (Bool, D128)
  var p = x.decode()
  if p.special != 0_u64 or p.coeff == 0_u128 or p.sign
    return (false, x)
  var (ok, s) = d128_split(x: x)
  if not ok
    return (false, x)
  if not s.has_lo and s.err == 0.0
    var (isn, fac) = b128_gamma_int(x: s.xb)
    if isn and which == 1_u64
      return (true, d128_of_parts(p: decfinB(sign: false, coeff: fac, exp: 0_s64, pref: 6111_s64)))
    if isn and fac == 1_u256
      return (true, D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64))
  var (okc, g) = b128_lgamma_fx(x: s.xb)
  if which == 1_u64
    var (okc2, g2) = b128_tgamma_fx(x: s.xb)
    okc = okc2
    g = g2
  if not okc
    return (false, x)
  var xv = B64(from: s.xb)
  var (psi, epsi) = b64_digamma_approx(x: xv)
  if not psi.is_finite() or not epsi.is_finite()
    return (false, x)
  var r = g
  if s.has_lo and psi != 0.0
    var pl = b128fx_mul(a: s.lo, b: b128fx_of_b64(v: psi, rel: epsi /! psi.abs() +! 0x1p-50))
    var ok2 = false
    if which == 0_u64
      var (oka, sum) = b128fx_add(a: g, b: pl)
      ok2 = oka
      r = sum
    else
      var (okb, f) = b128fx_add(a: b128fx_one(), b: pl)
      ok2 = okb
      r = b128fx_mul(a: g, b: f)
    if not ok2
      return (false, x)
  # x's rounding to B64 in psi and the split's error: |x psi| err, absolute for lgamma, relative for tgamma
  var moved = s.err *! 1.001 *! (xv *! psi).abs() +! 0x1p-200
  if which == 0_u64
    moved = moved /! b128fx_b64(v: r)
  return d128_round_fx(v: d128_widen(v: r, r: moved))
