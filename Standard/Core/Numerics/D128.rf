module Core

import Collections
# ============================================================================
# Constants
# ============================================================================

preset D128_ZERO: D128 = 0.0_d128
preset D128_ONE: D128 = 1.0_d128
# IEEE 754 decimal128: 34 significant digits, emax = 6144.
preset D128_MAX: D128 = 9.999999999999999999999999999999999e6144_d128
preset D128_MIN: D128 = -9.999999999999999999999999999999999e6144_d128
preset D128_MIN_POSITIVE: D128 = 1e-6143_d128
preset D128_EPSILON: D128 = 1e-33_d128

# ============================================================================
# D128 — IEEE 754-2008 decimal128 in BID storage. The arithmetic, rounding, conversions, DPD and math are
# computed by Ingrid's decimal engine (Ingrid/tessera/decimal/, written in Tessera), one engine for D32, D64 and
# D128 that rounds each result once to this format. This file keeps the type, its BID layout (decode and encode
# for the text forms), the checked operators, the conversions' RazorForge faces, and text parsing.
# ============================================================================

### A software decimal128 value in BID storage.
@llvm("i128")
record D128
obeys Numeric, Comparable, Assignable, Copyable
    pass

### The decoded fields of a decimal128: value = (-1)^sign * coeff * 10^exp.
### `special`: 0 finite, 1 infinity, 2 quiet NaN, 3 signaling NaN. Specials are
### encoded with the IEEE combination prefix (11110 = Inf, 11111 = NaN), which the
### finite range never reaches (biased exp <= 12287, top 2 bits never 11).
record D128Parts
    ### Sign bit.
    sign: Bool
    ### 0 finite, 1 inf, 2 qNaN, 3 sNaN.
    special: U64
    ### Unbiased exponent (finite only).
    exp: S64
    ### Integer significand 0..10^34-1 (finite only).
    coeff: U128

### Reinterprets this value as its raw decimal128 bit pattern.
@readonly
routine D128.to_bits() -> U128
    return LLVM::reinterpret_bits[D128, U128](me)

### Builds a value directly from a raw decimal128 bit pattern.
common routine D128.from_bits(bits: U128) -> D128
    return LLVM::reinterpret_bits[U128, D128](bits)

### Builds a value from its low/high 64-bit words (matching Core.D128 layout).
common routine D128.from_words(low: U64, high: U64) -> D128
    var bits = LLVM::bit_or(
        a: LLVM::zero_extend[U64, U128](low),
        b: LLVM::shift_left(
            value: LLVM::zero_extend[U64, U128](high),
            bits: U128.to_width(s: 64_s64),
        ),
    )
    return D128.from_bits(bits: bits)

### The decimal128 value re-encoded in DPD interchange form. Never crashes.
routine D128.to_dpd() -> U128
    var r = C::ingrid_d128_to_dpd(x_low: d128_low(v: me), x_high: d128_high(v: me))
    return (U128(from: r.w1) << 64) | U128(from: r.w0)

### Decodes a DPD interchange word into a decimal128. Never crashes.
common routine D128.from_dpd(bits: U128) -> D128
    var low = LLVM::int_truncate[U128, U64](bits)
    var high = LLVM::int_truncate[U128, U64](bits >>> 64)
    return d128_of_words(w: C::ingrid_d128_from_dpd(low: low, high: high))

### BINARY decode — sign / specials (combination prefix) / 14-bit biased exponent /
### 113-bit coefficient.
@readonly
routine D128.decode() -> D128Parts
    var bits = me.to_bits()
    # bit127 = sign.
    var sign = LLVM::int_ne[U128](
        a: LLVM::bit_and[U128](
            a: bits,
            b: LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: 127_s64)),
        ),
        b: 0,
    )
    # Combination prefix = top 5 bits (126..122): 11110 (0x1E) = Inf, 11111 (0x1F) = NaN.
    var top5 = LLVM::int_truncate[U128, U64](
        LLVM::bit_and(
            a: LLVM::shift_right_unsigned(bits, U128.to_width(s: 122_s64)),
            b: LLVM::zero_extend[U64, U128](0x1F_u64),
        ),
    )
    if LLVM::int_eq(a: top5, b: 0x1E_u64)
        return D128Parts(
            sign: sign,
            special: 1_u64,
            exp: 0_s64,
            coeff: LLVM::zero_extend[U64, U128](0_u64),
        )
    if LLVM::int_eq(a: top5, b: 0x1F_u64)
        # NaN: bit121 is the signaling flag (1 = sNaN -> special 3, else qNaN -> 2).
        var sp = 2_u64
        if LLVM::int_ne[U128](
            a: LLVM::bit_and[U128](
                a: LLVM::shift_right_unsigned[U128](bits, U128.to_width(s: 121_s64)),
                b: LLVM::zero_extend[U64, U128](1_u64),
            ),
            b: 0,
        )
            sp = 3_u64
        return D128Parts(
            sign: sign,
            special: sp,
            exp: 0_s64,
            coeff: LLVM::zero_extend[U64, U128](0_u64),
        )
    # Finite: bits 126..113 = 14-bit biased exponent; bits 112..0 = 113-bit coefficient.
    var biased = LLVM::int_truncate[U128, U64](
        LLVM::bit_and(
            a: LLVM::shift_right_unsigned(bits, U128.to_width(s: 113_s64)),
            b: LLVM::zero_extend[U64, U128](0x3FFF_u64),
        ),
    )
    var coeff = LLVM::bit_and[U128](
        a: bits,
        b: LLVM::sub[U128](
            a: LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: 113_s64)),
            b: 1,
        ),
    )
    # Unbias by 6176 to recover the true base-10 exponent.
    return D128Parts(
        sign: sign,
        special: 0_u64,
        exp: LLVM::sub(a: LLVM::reinterpret_bits[U64, S64](biased), b: 6176_s64),
        coeff: coeff,
    )

### BINARY encode — pack sign / specials / exponent / coefficient.
routine d128_of_parts(p: D128Parts) -> D128
    # Sign goes to bit127.
    var sbit = LLVM::shift_left(
        value: LLVM::zero_extend[U64, U128](if p.sign then 1_u64 else 0_u64),
        bits: U128.to_width(s: 127_s64),
    )
    if LLVM::int_ne(a: p.special, b: 0_u64)
        # Combination prefix 0x1E (Inf) or 0x1F (NaN) into bits 126..122; bit121 set for sNaN.
        var top5 = if LLVM::int_eq(a: p.special, b: 1_u64) then 0x1E_u64 else 0x1F_u64
        var b = LLVM::bit_or(
            a: sbit,
            b: LLVM::shift_left(
                value: LLVM::zero_extend[U64, U128](top5),
                bits: U128.to_width(s: 122_s64),
            ),
        )
        if LLVM::int_eq(a: p.special, b: 3_u64)
            b = LLVM::bit_or[U128](
                a: b,
                b: LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: 121_s64)),
            )
        return D128.from_bits(bits: b)
    # Finite: rebias the exponent (+6176), mask to 14 bits at bits 126..113, OR in the coefficient.
    var biased = LLVM::add(a: LLVM::reinterpret_bits[S64, U64](p.exp), b: 6176_u64)
    var ebits = LLVM::shift_left(
        value: LLVM::zero_extend[U64, U128](LLVM::bit_and(a: biased, b: 0x3FFF_u64)),
        bits: U128.to_width(s: 113_s64),
    )
    return D128.from_bits(bits: LLVM::bit_or(a: LLVM::bit_or(a: sbit, b: ebits), b: p.coeff))

### Infinity with the given sign.
common routine D128.infinity(sign: Bool) -> D128
    return d128_of_parts(
        p: D128Parts(
            sign: sign,
            special: 1_u64,
            exp: 0_s64,
            coeff: LLVM::zero_extend[U64, U128](0_u64),
        ),
    )

### A quiet NaN.
common routine D128.quiet_nan() -> D128
    return d128_of_parts(
        p: D128Parts(
            sign: false,
            special: 2_u64,
            exp: 0_s64,
            coeff: LLVM::zero_extend[U64, U128](0_u64),
        ),
    )

### Returns a signaling NaN (interop/testing; never produced by arithmetic).
common routine D128.signaling_nan() -> D128
    return d128_of_parts(
        p: D128Parts(
            sign: false,
            special: 3_u64,
            exp: 0_s64,
            coeff: LLVM::zero_extend[U64, U128](0_u64),
        ),
    )

### True when finite (neither inf nor NaN).
routine D128.is_finite() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 0_u64)

### True when infinite.
routine D128.is_infinite() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 1_u64)

### True when NaN (quiet or signaling).
routine D128.is_nan() -> Bool
    return LLVM::unsigned_ge(a: me.decode().special, b: 2_u64)

### True when this is a SIGNALING NaN (special field == 3).
routine D128.is_signaling() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 3_u64)

### True when this is a finite zero (±0).
@readonly
routine D128.is_zero() -> Bool
    var p = me.decode()
    return LLVM::int_eq(a: p.special, b: 0_u64)
        and LLVM::int_eq(a: p.coeff, b: LLVM::zero_extend[U64, U128](0_u64))

### Builds a finite D128 from a sign, a coefficient and a base-10 exponent: value = (-1)^sign * coeff *
### 10^exp, rounded half to even to 34 digits and brought into the exponent range.
common routine D128.from_components(sign: Bool, coeff: U128, exp: S64) -> D128
    var neg = 0_u32
    if sign
        neg = 1_u32
    return d128_of_words(
        w: C::ingrid_d128_from_parts(
            neg: neg,
            c_low: LLVM::int_truncate[U128,
            U64](coeff),
            c_high: LLVM::int_truncate[U128,
            U64](coeff >>> 64),
            exp: exp,
        ),
    )

### Builds a D128 from a 64-bit signed integer (exponent 0).
common routine D128.from_int64(value: S64) -> D128
    var neg = LLVM::signed_lt(a: value, b: 0_s64)
    var mag = if neg then LLVM::sub(a: 0_s64, b: value) else value
    return D128.from_components(
        sign: neg,
        coeff: LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](mag)),
        exp: 0_s64,
    )

### An integer (sign and 256-bit magnitude) as a D128, rounded half to even to 34 digits.
routine d128_of_integer(neg: Bool, m: U256) -> D128
    var n = 0_u32
    if neg
        n = 1_u32
    var m0 = LLVM::int_truncate[U256, U64](m)
    var m1 = LLVM::int_truncate[U256, U64](m >>> 64_u32)
    var m2 = LLVM::int_truncate[U256, U64](m >>> 128_u32)
    var m3 = LLVM::int_truncate[U256, U64](m >>> 192_u32)
    return d128_of_words(w: C::ingrid_d128_from_integer(neg: n, m0: m0, m1: m1, m2: m2, m3: m3))

### The bits of the binary float nearest to x, `which` bits wide (16, 32, 64, or 128). An infinity keeps its sign,
### a NaN becomes the positive quiet NaN.
routine d128_to_binary(x: D128, which: U32) -> U128
    var r = C::ingrid_d128_to_binary(x_low: d128_low(v: x), x_high: d128_high(v: x), which: which)
    return (U128(from: r.w1) << 64) | U128(from: r.w0)

### A B128 as a D128, correctly rounded (a narrower binary float widens to B128 exactly first).
routine d128_of_b128(x: B128) -> D128
    return d128_of_words(w: C::ingrid_d128_from_binary(low: x.low_bits(), high: x.high_bits()))

### The truncated integer magnitude of a finite decimal coeff * 10^exp as a U256. Throws when it exceeds U256.
routine d128_int_magnitude!(coeff: U128, exp: S64) -> U256
    if coeff == 0_u128
        return 0_u256
    if exp < 0_s64
        if exp < -38_s64
            return 0_u256
        var c = coeff
        var k = exp
        while k < 0_s64
            c = u128_floordiv(a: c, b: 10_u128)
            k = k +% 1_s64
        return LLVM::zero_extend[U128, U256](c)
    if exp > 77_s64
        throw NumericOverflowError(description: "decimal magnitude exceeds a 256-bit integer")
    var m = LLVM::zero_extend[U128, U256](coeff)
    var i = 0_s64
    while i < exp
        var prod = LLVM::unsigned_mul_checked[U256](m, 10_u256)
        if prod.item1
            throw NumericOverflowError(description: "decimal magnitude exceeds a 256-bit integer")
        m = prod.item0
        i = i +% 1_s64
    return m

### The truncated integer magnitude of a finite decimal as a U128. Throws when it exceeds U128.
routine d128_int_magnitude_u128!(coeff: U128, exp: S64) -> U128
    var m = d128_int_magnitude(coeff: coeff, exp: exp)
    if (m >>> 128_u32) != 0_u256
        throw NumericOverflowError(description: "decimal magnitude exceeds a 128-bit integer")
    return LLVM::int_truncate[U256, U128](m)

### Truncates toward zero to an unsigned 128-bit integer. Throws on a non-finite value, a
### negative value, or an integer part beyond U128.
routine U128!(from: D128) -> U128
    var p = from.decode()
    if p.special != 0_u64
        throw NumericDomainError(description: "non-finite decimal is not an integer")
    if p.sign and p.coeff != 0_u128
        throw NumericOverflowError(description: "negative decimal to unsigned integer")
    return d128_int_magnitude_u128(coeff: p.coeff, exp: p.exp)

### Truncates toward zero to a signed 128-bit integer. Throws on a non-finite value or an
### integer part outside [-2^127, 2^127-1].
routine S128!(from: D128) -> S128
    var p = from.decode()
    if p.special != 0_u64
        throw NumericDomainError(description: "non-finite decimal is not an integer")
    var mag = d128_int_magnitude_u128(coeff: p.coeff, exp: p.exp)
    var lim = 1_u128 << 127_u32
    if p.sign
        if mag > lim
            throw NumericOverflowError(description: "decimal out of range for target integer")
        if mag == lim
            return LLVM::reinterpret_bits[U128, S128](lim)
        return 0_s128 -% LLVM::reinterpret_bits[U128, S128](mag)
    if mag >= lim
        throw NumericOverflowError(description: "decimal out of range for target integer")
    return LLVM::reinterpret_bits[U128, S128](mag)

### Truncates toward zero to an unsigned 256-bit integer. Throws on a non-finite value, a
### negative value, or an integer part beyond U256.
routine U256!(from: D128) -> U256
    var p = from.decode()
    if p.special != 0_u64
        throw NumericDomainError(description: "non-finite decimal is not an integer")
    if p.sign and p.coeff != 0_u128
        throw NumericOverflowError(description: "negative decimal to unsigned integer")
    return d128_int_magnitude(coeff: p.coeff, exp: p.exp)

### Truncates toward zero to a signed 256-bit integer. Throws on a non-finite value or an
### integer part outside [-2^255, 2^255-1].
routine S256!(from: D128) -> S256
    var p = from.decode()
    if p.special != 0_u64
        throw NumericDomainError(description: "non-finite decimal is not an integer")
    var mag = d128_int_magnitude(coeff: p.coeff, exp: p.exp)
    var lim = 1_u256 << 255_u32
    if p.sign
        if mag > lim
            throw NumericOverflowError(description: "decimal out of range for target integer")
        if mag == lim
            return LLVM::reinterpret_bits[U256, S256](lim)
        return 0_s256 -% LLVM::reinterpret_bits[U256, S256](mag)
    if mag >= lim
        throw NumericOverflowError(description: "decimal out of range for target integer")
    return LLVM::reinterpret_bits[U256, S256](mag)

# Checked arithmetic crashes with a specific cause on a non-finite result (mirrors B64/Decimal):
# ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 -> DivisionByZeroError. Use the `*_unchecked`
# operators for raw IEEE 754 propagation.

### Returns `me + you`. Checked: crashes if the result is non-finite. Use `add_unchecked` for raw
### IEEE.
@readonly
routine D128.add!(you: D128) -> D128
    var r = d128_of_words(w: C::ingrid_d128_add(
        a_low: d128_low(v: me),
        a_high: d128_high(v: me),
        b_low: d128_low(v: you),
        b_high: d128_high(v: you),
    ))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me - you`. Checked: crashes if the result is non-finite. Use `sub_unchecked` for raw
### IEEE.
@readonly
routine D128.sub!(you: D128) -> D128
    var r = d128_of_words(w: C::ingrid_d128_sub(
        a_low: d128_low(v: me),
        a_high: d128_high(v: me),
        b_low: d128_low(v: you),
        b_high: d128_high(v: you),
    ))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me * you`. Checked: crashes if the result is non-finite. Use `mul_unchecked` for raw
### IEEE.
@readonly
routine D128.mul!(you: D128) -> D128
    var r = d128_of_words(w: C::ingrid_d128_mul(
        a_low: d128_low(v: me),
        a_high: d128_high(v: me),
        b_low: d128_low(v: you),
        b_high: d128_high(v: you),
    ))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me / you`. Checked: `x/0` -> DivisionByZeroError, `0/0` -> domain, overflow ->
### overflow.
### Use `truediv_unchecked` for raw IEEE 754 (`x/0` -> ±inf, `0/0` -> NaN).
@readonly
routine D128.truediv!(you: D128) -> D128
    var r = d128_of_words(w: C::ingrid_d128_div(
        a_low: d128_low(v: me),
        a_high: d128_high(v: me),
        b_low: d128_low(v: you),
        b_high: d128_high(v: you),
    ))
    if r.is_finite()
        return r
    if you.is_zero() and not me.is_zero()
        throw DivisionByZeroError()
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D128.add_unchecked(you: D128) -> D128
    return d128_of_words(w: C::ingrid_d128_add(
        a_low: d128_low(v: me),
        a_high: d128_high(v: me),
        b_low: d128_low(v: you),
        b_high: d128_high(v: you),
    ))

### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D128.sub_unchecked(you: D128) -> D128
    return d128_of_words(w: C::ingrid_d128_sub(
        a_low: d128_low(v: me),
        a_high: d128_high(v: me),
        b_low: d128_low(v: you),
        b_high: d128_high(v: you),
    ))

### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D128.mul_unchecked(you: D128) -> D128
    return d128_of_words(w: C::ingrid_d128_mul(
        a_low: d128_low(v: me),
        a_high: d128_high(v: me),
        b_low: d128_low(v: you),
        b_high: d128_high(v: you),
    ))

### Returns `me / you` with raw IEEE 754 propagation (`x/0` -> ±infinity, `0/0` -> NaN). No crash.
routine D128.truediv_unchecked(you: D128) -> D128
    return d128_of_words(w: C::ingrid_d128_div(
        a_low: d128_low(v: me),
        a_high: d128_high(v: me),
        b_low: d128_low(v: you),
        b_high: d128_high(v: you),
    ))

### The low 64 bits of a D128's BID bits, as an Ingrid routine takes them.
secret routine d128_low(v: D128) -> U64
    return LLVM::int_truncate[U128, U64](v.to_bits())

### The high 64 bits of a D128's BID bits.
secret routine d128_high(v: D128) -> U64
    return LLVM::int_truncate[U128, U64](v.to_bits() >>> 64)

### The D128 an Ingrid routine hands back: its low 64 bits in `w0`, its high 64 bits in `w1`.
secret routine d128_of_words(w: IngridWords) -> D128
    return D128.from_words(low: w.w0, high: w.w1)

### d128_order, computed by Ingrid.
secret routine d128_ingrid_order(a: D128, b: D128) -> S64
    return C::ingrid_d128_order(
        a_low: d128_low(v: a),
        a_high: d128_high(v: a),
        b_low: d128_low(v: b),
        b_high: d128_high(v: b),
    )

### Decimal value equality. NaN is never equal to anything (including itself);
### infinities are equal only with the same sign; finite values compare by value
### (so different cohorts of the same number — e.g. 1.0 and 1.00 — are equal).
@readonly
routine D128.eq(you: D128) -> Bool
    return d128_ingrid_order(a: me, b: you) == 0_s64

### Three-way decimal comparison under IEEE ordered semantics. NaN is unordered and
### maps to `SAME` (matching the B128 engine convention).
@readonly
routine D128.cmp(you: D128) -> ComparisonSign
    var o = d128_ingrid_order(a: me, b: you)
    if o == -1_s64
        return ME_SMALL
    if o == 1_s64
        return ME_LARGE
    return SAME

### Returns `me` raised to the `you` power. Delegates to the transcendental `pow`;
### follows IEEE semantics (overflow/domain errors yield inf/NaN, never throw), so the
### wired `pow!` is crashable and satisfies `Exponentiable`.
@readonly
routine D128.pow!(you: D128) -> D128
    var r = me.pow_unchecked(you: you)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Decimal text of decoded parts (decNumber decToString: plain when exp<=0 and the
### adjusted exponent >= -6, else scientific with an explicit-sign exponent).
routine d128_represent(p: D128Parts) -> Text
    return d128_represent_wrapped(p: p, wrap: "", strip: false)

### d128_represent written straight into one character buffer, as `wrap(...)` when wrap is nonempty (the
### diagnose form). With strip, fractional trailing zeros are dropped first, up toward exponent 0 (the
### canonical Decimal text).
routine d128_represent_wrapped(p: D128Parts, wrap: Text, strip: Bool) -> Text
    if LLVM::int_ne(a: p.special, b: 0_u64)
        var sp = "NaN"
        if LLVM::int_eq(a: p.special, b: 1_u64)
            sp = "inf"
            if p.sign
                sp = "-inf"
        elseif LLVM::int_eq(a: p.special, b: 3_u64)
            sp = "sNaN"
        if wrap.count() > 0_u64
            return wrap + "(" + sp + ")"
        return sp
    danger
        var dig = Array[U32, 40]()
        var dp = LLVM::reinterpret_bits[Hijacked[Array[U32, 40]], Hijacked[U32]](dig.hijack())
        var nd = b128t_digits(v: p.coeff, buf: dp)
        if nd == 0_s64
            dp.poke(value: 0x30_u32)
            nd = 1_s64
        var e = p.exp
        var lo = 0_s64
        if strip and p.coeff != 0_u128
            while e < 0_s64 and dp.stride(count: lo).peek() == 0x30_u32
                lo = lo +% 1_s64
                e = e +% 1_s64
        # the digits dp[lo .. nd - 1], most significant at nd - 1
        var k = nd -% lo
        var adj = e +% k -% 1_s64
        var buf = Array[Character, 96]()
        var o = LLVM::reinterpret_bits[Hijacked[Array[Character, 96]], Hijacked[Character]](buf.hijack())
        var n = 0_s64
        var wn = LLVM::reinterpret_bits[U64, S64](wrap.count())
        if wn > 0_s64
            while n < wn
                o.stride(count: n).poke(value: wrap[LLVM::reinterpret_bits[S64, U64](n)])
                n = n +% 1_s64
            o.stride(count: n).poke(value: Character(0x28_u32))
            n = n +% 1_s64
        if p.sign
            o.stride(count: n).poke(value: Character(0x2D_u32))
            n = n +% 1_s64
        if e <= 0_s64 and adj >= -6_s64
            var point = k +% e
            if point <= 0_s64
                # 0.000ddd
                o.stride(count: n).poke(value: Character(0x30_u32))
                o.stride(count: n +% 1_s64).poke(value: Character(0x2E_u32))
                n = n +% 2_s64
                var z = 0_s64
                while z < 0_s64 -% point
                    o.stride(count: n).poke(value: Character(0x30_u32))
                    n = n +% 1_s64
                    z = z +% 1_s64
            var i = k -% 1_s64
            var written = 0_s64
            while i >= 0_s64
                if point > 0_s64 and written == point and e != 0_s64
                    o.stride(count: n).poke(value: Character(0x2E_u32))
                    n = n +% 1_s64
                o.stride(count: n).poke(value: Character(dp.stride(count: lo +% i).peek()))
                n = n +% 1_s64
                written = written +% 1_s64
                i = i -% 1_s64
        else
            # d[.ddd]E+-x
            o.stride(count: n).poke(value: Character(dp.stride(count: lo +% k -% 1_s64).peek()))
            n = n +% 1_s64
            if k > 1_s64
                o.stride(count: n).poke(value: Character(0x2E_u32))
                n = n +% 1_s64
                var j = k -% 2_s64
                while j >= 0_s64
                    o.stride(count: n).poke(value: Character(dp.stride(count: lo +% j).peek()))
                    n = n +% 1_s64
                    j = j -% 1_s64
            o.stride(count: n).poke(value: Character(0x45_u32))
            n = n +% 1_s64
            var mag = adj
            if adj < 0_s64
                mag = 0_s64 -% adj
                o.stride(count: n).poke(value: Character(0x2D_u32))
            else
                o.stride(count: n).poke(value: Character(0x2B_u32))
            n = n +% 1_s64
            var ed = Array[U32, 20]()
            var edp = LLVM::reinterpret_bits[Hijacked[Array[U32, 20]], Hijacked[U32]](ed.hijack())
            var en = b128t_digits(
                v: LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](mag)),
                buf: edp,
            )
            if en == 0_s64
                edp.poke(value: 0x30_u32)
                en = 1_s64
            var t = en -% 1_s64
            while t >= 0_s64
                o.stride(count: n).poke(value: Character(edp.stride(count: t).peek()))
                n = n +% 1_s64
                t = t -% 1_s64
        if wn > 0_s64
            o.stride(count: n).poke(value: Character(0x29_u32))
            n = n +% 1_s64
        return Text(from_span: o, count: LLVM::reinterpret_bits[S64, U64](n))

### Returns the decimal text of this value.
@override
routine D128.represent() -> Text
    return d128_represent(p: me.decode())

### Renders this value with exactly `places` digits after the point, rounded half to even from its
### exact value (`2.675.fixed(2)` is `2.67`, since the stored double is just below 2.675). The integer
### part is always written out in full, never in exponent form.
### :param places: The number of digits after the point (0 for none).
### :returns: The rendered `Text`.
routine D128.fixed(places: U64) -> Text
    return format_decimal_fixed(p: me.decode(), places: places)

### Returns a diagnostic representation tagged with the type name.
@override
routine D128.diagnose() -> Text
    return d128_represent_wrapped(p: me.decode(), wrap: "D128", strip: false)

### Returns the smaller of `me` and `you` under decimal ordering.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`, otherwise `you`.
routine D128.min(you: D128) -> D128
    return if me <= you then me else you

### Returns the larger of `me` and `you` under decimal ordering.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`, otherwise `you`.
routine D128.max(you: D128) -> D128
    return if me >= you then me else you

### Restricts `me` to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound.
### :param max_val: The upper bound.
### :returns: The clamped value.
@positional
routine D128.clamp(min_val: D128, max_val: D128) -> D128
    return me.min(max_val).max(min_val)

### Returns the reciprocal `1 / me`.
### :returns: The multiplicative inverse.
routine D128.recip() -> D128
    return D128_ONE.truediv_unchecked(me)

### Returns `me` raised to the integer power `n` via exponentiation by squaring.
### A negative `n` inverts the result.
### :param n: The integer exponent.
### :returns: `me ** n`.
routine D128.powi(n: S32) -> D128
    var base = if n < 0_s32 then D128_ONE.truediv_unchecked(me) else me
    var count = n.unsigned_abs()
    var result = D128_ONE
    while count > 0_u32
        if count.bitand(1_u32) == 1_u32
            result = result.mul_unchecked(base)
        base = base.mul_unchecked(base)
        count = count.lshr(1_u32)
    return result

### Returns `(me + you) / 2`.
### :param you: The other value.
### :returns: The arithmetic midpoint of `me` and `you`.
routine D128.midpoint(you: D128) -> D128
    return me.add_unchecked(you).truediv_unchecked(2.0_d128)

# ============================================================================
# Creators — integers (exact, then rounded half to even to 34 digits)
# ============================================================================

### Converts an S8 into decimal128 (exponent 0).
routine D128(from: S8) -> D128
    return D128.from_int64(value: S64(from))

### Converts an S16 into decimal128 (exponent 0).
routine D128(from: S16) -> D128
    return D128.from_int64(value: S64(from))

### Converts an S32 into decimal128 (exponent 0).
routine D128(from: S32) -> D128
    return D128.from_int64(value: S64(from))

### Converts an S64 into decimal128 (exponent 0).
routine D128(from: S64) -> D128
    return D128.from_int64(value: from)

### Converts an S128 into decimal128 (exponent 0, rounded half to even when it has more than 34 digits).
routine D128(from: S128) -> D128
    var v = LLVM::sign_extend[S128, S256](from)
    var neg = v < 0_s256
    var mag = LLVM::reinterpret_bits[S256, U256](v)
    if neg
        mag = 0_u256 -% mag
    return d128_of_integer(neg: neg, m: mag)

### Converts an S256 into decimal128 (exponent 0, rounded half to even when it has more than 34 digits).
routine D128(from: S256) -> D128
    var v = from
    var neg = v < 0_s256
    var mag = LLVM::reinterpret_bits[S256, U256](v)
    if neg
        mag = 0_u256 -% mag
    return d128_of_integer(neg: neg, m: mag)

### Converts a U8 into decimal128 (exponent 0).
routine D128(from: U8) -> D128
    return D128.from_components(sign: false, coeff: U128(from), exp: 0_s64)

### Converts a U16 into decimal128 (exponent 0).
routine D128(from: U16) -> D128
    return D128.from_components(sign: false, coeff: U128(from), exp: 0_s64)

### Converts a U32 into decimal128 (exponent 0).
routine D128(from: U32) -> D128
    return D128.from_components(sign: false, coeff: U128(from), exp: 0_s64)

### Converts a U64 into decimal128 (exponent 0).
routine D128(from: U64) -> D128
    return D128.from_components(sign: false, coeff: U128(from), exp: 0_s64)

### Converts a U128 into decimal128 (exponent 0, rounded half to even when it has more than 34 digits).
routine D128(from: U128) -> D128
    return d128_of_integer(neg: false, m: LLVM::zero_extend[U128, U256](from))

### Converts a U256 into decimal128 (exponent 0, rounded half to even when it has more than 34 digits).
routine D128(from: U256) -> D128
    return d128_of_integer(neg: false, m: from)

# ============================================================================
# Creators — binary floats (widened to B128 exactly, then correctly rounded once)
# ============================================================================

### Converts a B16 to decimal128, correctly rounded.
routine D128(from: B16) -> D128
    return d128_of_b128(x: B128(from: from))

### Converts a B32 to decimal128, correctly rounded.
routine D128(from: B32) -> D128
    return d128_of_b128(x: B128(from: from))

### Converts a B64 to decimal128, correctly rounded.
routine D128(from: B64) -> D128
    return d128_of_b128(x: B128(from: from))

### Converts a B128 to decimal128, correctly rounded.
routine D128(from: B128) -> D128
    return d128_of_b128(x: from)

# ============================================================================
# Creators — decimal <-> decimal
# ============================================================================

### Widens a decimal32 to decimal128 (exact).
routine D128(from: D32) -> D128
    return d128_of_words(w: C::ingrid_d128_from_d32(x: from.to_bits()))

### Widens a decimal64 to decimal128 (exact).
routine D128(from: D64) -> D128
    return d128_of_words(w: C::ingrid_d128_from_d64(x: from.to_bits()))

### Identity conversion (decimal128 -> decimal128).
routine D128(from: D128) -> D128
    return from

# ============================================================================
# Text parsing — the shared scanner, rounded once to decimal128
# ============================================================================

### Scans decimal text into its parts (sign, special, coefficient, base-10 exponent) without rounding: the shared
### front end of the decimal parsers. An optional sign, an integer and fraction mantissa, an optional `e`/`E`
### exponent, and the special values `inf`/`infinity`/`nan` (any case). A mantissa longer than 38 digits keeps its
### first 38 and folds the rest into a sticky last digit (every format rounds away at least 4 digits, so the
### rounding is still exact), and an exponent beyond ±10^9 saturates.
### :throws: {InvalidValueError} on malformed input.
routine scan_decimal_parts!(from_text: Text) -> D128Parts
    var len = from_text.count()
    if len == 0u64
        throw InvalidValueError(input: from_text, target: "decimal number")
    var i = 0u64
    var neg = false
    var first = from_text[0u64]
    if first == Character(0x002Bu32) or first == Character(0x002Du32)
        neg = first == Character(0x002Du32)
        i = 1u64
        if i >= len
            throw InvalidValueError(input: from_text, target: "decimal number")
    # special values
    var rest = len - i
    if rest == 3u64 or rest == 8u64
        var c0 = from_text[i].to_lowercase()
        var c1 = from_text[i + 1u64].to_lowercase()
        var c2 = from_text[i + 2u64].to_lowercase()
        if rest == 3u64
            and c0 == Character(0x006Eu32)
            and c1 == Character(0x0061u32)
            and c2 == Character(0x006Eu32)
            return D128Parts(sign: neg, special: 2_u64, exp: 0_s64, coeff: 0_u128)
        if c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
            if rest == 3u64
                return D128Parts(sign: neg, special: 1_u64, exp: 0_s64, coeff: 0_u128)
            var c3 = from_text[i + 3u64].to_lowercase()
            var c4 = from_text[i + 4u64].to_lowercase()
            var c5 = from_text[i + 5u64].to_lowercase()
            var c6 = from_text[i + 6u64].to_lowercase()
            var c7 = from_text[i + 7u64].to_lowercase()
            if c3 == Character(0x0069u32)
                and c4 == Character(0x006Eu32)
                and c5 == Character(0x0069u32)
                and c6 == Character(0x0074u32)
                and c7 == Character(0x0079u32)
                return D128Parts(sign: neg, special: 1_u64, exp: 0_s64, coeff: 0_u128)
        # not a special value: a 3- or 8-character number like "0.5" or "12345678" falls through to the scan
    # numeric: accumulate the coefficient (38 digits at most) and the base-10 exponent
    var coeff = 0_u128
    var full = 10000000000000000000000000000000000000_u128
    var sticky = false
    var exp10 = 0_s64
    var seen_dot = false
    var has_digit = false
    while i < len
        var ch = from_text[i]
        if ch.is_numeric()
            var d = LLVM::zero_extend[U32, U128](LLVM::reinterpret_bits[S32, U32](ch.digit_value()))
            if coeff >= full
                # past 38 digits: the digit only sets the sticky bit, and before the point it scales by ten
                if d != 0_u128
                    sticky = true
                if not seen_dot
                    exp10 = exp10 +% 1_s64
            else
                coeff = coeff *% 10_u128 +% d
                if seen_dot
                    exp10 = exp10 -% 1_s64
            has_digit = true
        elseif ch == Character(0x002Eu32)
            if seen_dot
                throw InvalidValueError(input: from_text, target: "decimal number")
            seen_dot = true
        elseif ch == Character(0x0065u32) or ch == Character(0x0045u32)
            if not has_digit
                throw InvalidValueError(input: from_text, target: "decimal number")
            i = i + 1u64
            var esign = false
            if i < len
                and (from_text[i] == Character(0x002Bu32) or from_text[i] == Character(0x002Du32))
                esign = from_text[i] == Character(0x002Du32)
                i = i + 1u64
            var eval = 0_s64
            var has_edigit = false
            while i < len
                var ec = from_text[i]
                if not ec.is_numeric()
                    throw InvalidValueError(input: from_text, target: "decimal number")
                if eval < 1000000000_s64
                    eval = eval *% 10_s64 +% S64(ec.digit_value())
                has_edigit = true
                i = i + 1u64
            if not has_edigit
                throw InvalidValueError(input: from_text, target: "decimal number")
            if esign
                eval = 0_s64 -% eval
            exp10 = exp10 +% eval
            break
        else
            throw InvalidValueError(input: from_text, target: "decimal number")
        i = i + 1u64
    if not has_digit
        throw InvalidValueError(input: from_text, target: "decimal number")
    if sticky
        coeff = coeff | 1_u128
    return D128Parts(sign: neg, special: 0_u64, exp: exp10, coeff: coeff)

### Parses decimal text into a `D128` (the scanned value rounded half to even to 34 digits).
### :throws: {InvalidValueError} on malformed input.
routine parse_decimal_d128!(from_text: Text) -> D128
    var p = scan_decimal_parts(from_text: from_text)
    if p.special == 1_u64
        return D128.infinity(sign: p.sign)
    if p.special >= 2_u64
        return D128.quiet_nan()
    return D128.from_components(sign: p.sign, coeff: p.coeff, exp: p.exp)

### Parses a decimal literal into a `D128`.
### :throws: {InvalidValueError} if the text is not a valid decimal literal.
routine D128!(from_text: Text) -> D128
    return parse_decimal_d128(from_text: from_text)

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
routine D128.to_bytes_le() -> Array[Byte, 16]
    var raw = me.to_bits()
    var result = Array[Byte, 16]()
    var i = 0_u64
    while LLVM::unsigned_lt(a: i, b: 16_u64)
        var b = LLVM::int_truncate[U128, U8](
            LLVM::shift_right_unsigned(
                raw,
                LLVM::zero_extend[U64, U128](LLVM::mul(a: i, b: 8_u64)),
            ),
        )
        result = LLVM::set_byte_at(array: result, index: i, value: b)
        i = LLVM::add(a: i, b: 1_u64)
    return result

### Returns the raw bytes of this value in big-endian order.
routine D128.to_bytes_be() -> Array[Byte, 16]
    var raw = me.to_bits()
    var result = Array[Byte, 16]()
    var i = 0_u64
    while LLVM::unsigned_lt(a: i, b: 16_u64)
        var b = LLVM::int_truncate[U128, U8](
            LLVM::shift_right_unsigned(
                raw,
                LLVM::zero_extend[U64, U128](LLVM::mul(a: LLVM::sub(a: 15_u64, b: i), b: 8_u64)),
            ),
        )
        result = LLVM::set_byte_at(array: result, index: i, value: b)
        i = LLVM::add(a: i, b: 1_u64)
    return result
