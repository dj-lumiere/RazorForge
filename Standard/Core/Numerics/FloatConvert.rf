    0x4A59D101758E1F9C, 0x5EFDF5C50CBCF5AB, 0x76F61B3588E365C7, 0x4B2FEFA1ADFB22AB,
    0x5F2B48F7A0B5EB06, 0x08F3261AF195B555, 0x4C22A0C61A2B226B, 0x20C284E25ADE2AAB,
    0x79D1013CF6AB6A45, 0x1AD0D49D5E304444, 0x617400FD9222BB6A, 0x48A7107DE4F369D0,
    0x4DF6673141B562BB, 0x53B8D9FE50C2BB0D, 0x7CBD71E869223792, 0x52C15CCA1AD12B48,
    0x63CAC186BA81C60E, 0x75677D6E7BDA8906, 0x4FD5679EFB9B04D8, 0x5DEC645863153A6C,
    0x7FBBD8FE5F5E6E27, 0x497A3A2704EEC3DF,
]

# ============================================================================
# Pure-RF binary-float text conversion (formatting + parsing) for B16/B32/B64/B128.
#
# Replaces the old C runtime (snprintf "%g" / strtof / strtod, plus the b16
# software shims). Both directions are EXACT-RATIONAL: a binary float is
# f = m · 2^e with integer m, e, so every question ("what are the first N
# decimal digits, correctly rounded?" / "which float is nearest this decimal?")
# is an exact big-integer comparison. The unbounded `Integer` is
# the scratch type — formatting is a cold path, so clarity/correctness beat the
# table-heavy speed tricks (Ryū/Grisu) that only pay off in a hot loop.
#
# FORMAT: `format_binary(value, sig)` renders `value` to `sig` significant
# decimal digits (round-half-even), then lays them out with C `%g` rules
# (scientific when the decimal exponent is < -4 or >= sig, else fixed). B16/B32
# widen EXACTLY to B64 first, so one core covers all three. `represent` instead
# prints the SHORTEST decimal that reads back as the same float
# (`format_binary_shortest`, `format_b128_shortest`), decoded in the source
# format, since the shortest digits depend on that format's spacing.
#
# PARSE: `parse_float_components` validates + extracts (kind, sign, significand,
# decimal-exponent); `b{16,32,64,128}_from_ratio` builds the exact rational and
# rounds it straight to the TARGET precision (single rounding — no B64 detour,
# so no double-rounding error), then packs the IEEE 754 bit pattern.
# ============================================================================

# Small result records carry a `Text` alongside scalars. (A managed `Integer`
# field is deliberately NOT used: the LLVM emitter currently drops a cross-module
# `Integer` field from a Core record's layout — see the codegen to-fix note — so
# the parsed significand travels as its decimal digit STRING and is rebuilt into
# an `Integer` at the use site. The binary-float round/pack keeps its `Integer`s
# as locals and returns a scalar `U64` bit pattern, never an aggregate.)

### Correctly-rounded decimal digits of a float, with the exponent of the leading digit.
record FloatDigits
    ### The significant digit string (exactly `sig` characters).
    digits: Text
    ### Decimal exponent E: the value equals d0.d1… × 10^E.
    point_exp: S64

### A parsed decimal-float string: a finite magnitude equals digits × 10^dec_exp.
record FloatParsed
    ### 0 finite, 1 NaN, 2 infinity, 3 invalid (malformed input).
    kind: S32
    ### Whether a leading `-` was present.
    is_neg: Bool
    ### The significand as a decimal digit string (rebuilt into an `Integer` by the caller).
    digits: Text
    ### The base-10 exponent applied to the significand.
    dec_exp: S64

# ----------------------------------------------------------------------------
# Big-integer helpers
# ----------------------------------------------------------------------------

### Returns 10^k as an Integer. `k` must be non-negative.
routine pow10_int(k: S64) -> Integer
    var ten: Integer = 10
    return ten.pow(exp: LLVM::int_truncate[S64, U32](k))

### Returns round-half-to-even of n/d for non-negative n and positive d.
routine div_round_half_even(n: Integer, d: Integer) -> Integer
    var qr = n.divmod(other: d)
    var q = qr.item0
    var r = qr.item1
    var r2 = r.add(other: r)
    var c = r2.compare(you: d)
    if c == ME_LARGE
        return q.add(other: Integer.one())
    if c == SAME
        if q.is_odd()
            return q.add(other: Integer.one())
        return q
    return q

### True when num/den >= 2^k (k may be negative), an exact big-integer test.
routine ratio_ge_pow2(num: Integer, den: Integer, k: S64) -> Bool
    if k >= 0
        return num.compare(you: den.shift_left(bits: LLVM::int_truncate[S64, U32](k))) != ME_SMALL
    return num.shift_left(bits: LLVM::int_truncate[S64, U32](0 - k)).compare(you: den) != ME_SMALL

# ----------------------------------------------------------------------------
# Formatting: significant-digit extraction + %g layout
# ----------------------------------------------------------------------------

### Extracts `sig` correctly-rounded significant decimal digits of the positive
### value m·2^e2. Returns (digits, E) where the value equals d0.d1d2… × 10^E and
### `digits` is exactly `sig` characters long.
routine binary_float_digits(m: U64, e2: S64, sig: U64) -> FloatDigits
    var num = m.to[Integer]()
    var den = Integer.one()
    if e2 >= 0
        num = num.shift_left(bits: LLVM::int_truncate[S64, U32](e2))
    else
        den = den.shift_left(bits: LLVM::int_truncate[S64, U32](0 - e2))
    var sigi = LLVM::reinterpret_bits[U64, S64](sig)
    var sigm1 = sigi - 1
    var lo = pow10_int(k: sigm1)
    var hi = pow10_int(k: sigi)
    # Decimal-exponent estimate: log10(value) ≈ (bitlen(num) - bitlen(den))·log10(2).
    var bl = LLVM::reinterpret_bits[U64, S64](num.bit_length()) - LLVM::reinterpret_bits[U64, S64](den.bit_length())
    var ee = bl * 30103 // 100000
    var dd = Integer.zero()
    var guard = 0
    var done = false
    while not done
        var pp = sigm1 - ee
        var n2 = num
        var d2 = den
        if pp >= 0
            n2 = num.mul(other: pow10_int(k: pp))
        else
            d2 = den.mul(other: pow10_int(k: 0 - pp))
        dd = div_round_half_even(n: n2, d: d2)
        if guard >= 6
            done = true
        elseif dd.compare(you: hi) != ME_SMALL
            ee = ee + 1
            guard = guard + 1
        elseif dd.compare(you: lo) == ME_SMALL
            ee = ee - 1
            guard = guard + 1
        else
            done = true
    # Safety: if the guard tripped with a rounded-up extra digit, drop it.
    if dd.compare(you: hi) != ME_SMALL
        dd = dd.floordiv(other: 10)
        ee = ee + 1
    return FloatDigits(digits: dd.represent(), point_exp: ee)

### Builds `n` copies of '0' as Text.
routine zeros_text(n: U64) -> Text
    var r = Text()
    var i: U64 = 0
    while i < n
        r = r + "0"
        i = i + 1
    return r

### Lays out the significant digits with C `%g` rules. `digits` is the sig-digit
### string, `E` the exponent of the leading digit (value ≈ d0.d1… × 10^E).
routine assemble_decimal(neg: Bool, digits: Text, ee: S64, sig: U64) -> Text
    var k = digits.count()
    while k > 1 and digits[k - 1] == '0'
        k = k - 1
    var s = digits[0 til k]
    var sigi = LLVM::reinterpret_bits[U64, S64](sig)
    var body = Text()
    if ee < -4 or ee >= sigi
        # Scientific: d[.ddd]e±XX
        if k == 1
            body = s
        else
            body = s[0 til 1] + "." + s[1 til k]
        var ea = ee
        var esign = "+"
        if ee < 0
            ea = 0 - ee
            esign = "-"
        var edig = int_to_text(mag: LLVM::reinterpret_bits[S64, U64](ea), negative: false)
        if edig.count() < 2
            edig = "0" + edig
        body = body + "e" + esign + edig
    elseif ee >= 0
        var iplen = LLVM::reinterpret_bits[S64, U64](ee + 1)
        if k <= iplen
            body = s + zeros_text(n: iplen - k)
        else
            body = s[0 til iplen] + "." + s[iplen til k]
    else
        var zc = LLVM::reinterpret_bits[S64, U64](0 - ee - 1)
        body = "0." + zeros_text(n: zc) + s
    if neg
        return "-" + body
    return body

### Renders a B64 to `sig` significant digits with `%g` layout. B16/B32 widen to
### B64 EXACTLY before calling here, so this single core serves all three.
### Specials: "NaN" / "inf" / "-inf"; zero renders as "0" / "-0".
routine format_binary(value: B64, sig: U64) -> Text
    if value.is_nan()
        return "NaN"
    if value.is_infinite()
        if value.is_sign_negative()
            return "-inf"
        return "inf"
    var neg = value.is_sign_negative()
    if value.is_zero()
        if neg
            return "-0"
        return "0"
    var raw = value.to_bits()
    var bits = LLVM::bit_and(a: raw, b: 0x7FFFFFFFFFFFFFFF)
    var ef = LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 52), b: 0x7FF)
    var mf = LLVM::bit_and(a: bits, b: 0xFFFFFFFFFFFFF)
    var m: U64 = 0
    var e2 = 0
    if LLVM::int_eq(a: ef, b: 0)
        m = mf
        e2 = -1074
    else
        m = LLVM::bit_or(a: mf, b: 0x10000000000000)
        e2 = LLVM::reinterpret_bits[U64, S64](ef) - 1075
    var (fast, txt) = b128t_sig_binary(
        neg: neg,
        c: LLVM::zero_extend[U64, U128](m),
        q: e2,
        sig: sig,
    )
    if fast
        return txt
    var pr = binary_float_digits(m: m, e2: e2, sig: sig)
    return assemble_decimal(neg: neg, digits: pr.digits, ee: pr.point_exp, sig: sig)

# ----------------------------------------------------------------------------
# Shortest round-trip formatting (what `represent` prints)
# ----------------------------------------------------------------------------
# A binary float owns the interval of reals that round to it: halfway to the next float below and
# halfway to the next float above. Any decimal inside that interval reads back as the same float,
# so `represent` prints the SHORTEST such decimal (and, among equally short ones, the closest to the
# exact value). This is the free-format algorithm of Steele & White / Burger & Dybvig carried out on
# exact `Integer` ratios: v = r/s, and the half-gaps to the neighbours are m_minus/s and m_plus/s.
# Every parser in the family rounds half to even, so an interval end counts as inside exactly when
# the significand is even.

### Returns the shortest decimal digits of the positive value m · 2^e2 that read back as the same
### float, with the exponent of the leading digit (value ≈ d0.d1… × 10^E).
### :param m: The full significand (hidden bit included for a normal value).
### :param e2: The binary exponent of the significand's last bit.
### :param lower_closer: Whether the float below is half as far away as the float above (the
###   value is an exact power of two above the smallest normal exponent).
### :returns: The digit string and the exponent of its leading digit.
routine shortest_float_digits(m: Integer, e2: S64, lower_closer: Bool) -> FloatDigits
    var inclusive = m.is_even()
    var ten: Integer = 10
    var r = Integer.zero()
    var s = Integer.one()
    var m_plus = Integer.one()
    var m_minus = Integer.one()
    # Everything is scaled by 2 (by 4 when the lower gap is the narrow one) so the half-gaps stay integers.
    if e2 >= 0
        var ulp = Integer.one().shift_left(bits: LLVM::int_truncate[S64, U32](e2))
        if lower_closer
            r = m.mul(other: ulp).shift_left(bits: 2)
            s = 4
            m_plus = ulp.shift_left(bits: 1)
            m_minus = ulp
        else
            r = m.mul(other: ulp).shift_left(bits: 1)
            s = 2
            m_plus = ulp
            m_minus = ulp
    elseif lower_closer
        r = m.shift_left(bits: 2)
        s = Integer.one().shift_left(bits: LLVM::int_truncate[S64, U32](2 - e2))
        m_plus = 2
    else
        r = m.shift_left(bits: 1)
        s = Integer.one().shift_left(bits: LLVM::int_truncate[S64, U32](1 - e2))
    # Find k with 10^(k-1) <= (upper interval end) < 10^k: estimate from the bit lengths, then settle
    # it exactly in whichever direction the estimate was off.
    var bl = LLVM::reinterpret_bits[U64, S64](r.bit_length()) - LLVM::reinterpret_bits[U64, S64](s.bit_length())
    var k = bl * 30103 // 100000
    if k >= 0
        s = s.mul(other: pow10_int(k: k))
    else
        var scale = pow10_int(k: 0 - k)
        r = r.mul(other: scale)
        m_plus = m_plus.mul(other: scale)
        m_minus = m_minus.mul(other: scale)
    var settled = false
    while not settled
        var top = r.add(other: m_plus).compare(you: s)
        if top == ME_LARGE or (inclusive and top == SAME)
            s = s.mul(other: ten)
            k = k + 1
        else
            var below = r
                .add(other: m_plus)
                .mul(other: ten)
                .compare(you: s)
            if below == ME_SMALL or (not inclusive and below == SAME)
                r = r.mul(other: ten)
                m_plus = m_plus.mul(other: ten)
                m_minus = m_minus.mul(other: ten)
                k = k - 1
            else
                settled = true
    # Emit digits until the prefix alone (rounded down, or its last digit rounded up) lands inside
    # the interval.
    var digits = Text()
    var done = false
    while not done
        r = r.mul(other: ten)
        m_plus = m_plus.mul(other: ten)
        m_minus = m_minus.mul(other: ten)
        var qr = r.divmod(other: s)
        var d = qr.item0.to[U64]()
        r = qr.item1
        var low_c = r.compare(you: m_minus)
        var low = low_c == ME_SMALL or (inclusive and low_c == SAME)
        var high_c = r.add(other: m_plus).compare(you: s)
        var high = high_c == ME_LARGE or (inclusive and high_c == SAME)
        if low and high
            # Both d and d + 1 read back correctly: keep the one closer to the exact value, even on a tie.
            var half = r.shift_left(bits: 1).compare(you: s)
            if half == ME_LARGE
                or (half == SAME and LLVM::int_ne(a: LLVM::bit_and(a: d, b: 1), b: 0))
                d = d + 1
            done = true
        elseif high
            d = d + 1
            done = true
        elseif low
            done = true
        digits = digits + int_to_text(mag: d, negative: false)
    return FloatDigits(digits: digits, point_exp: k - 1)

### Renders the shortest decimal that reads back as the same float, in `%g` layout: scientific when
### the leading digit's exponent is below -4 or at least `sci_from`, otherwise positional.
### :param neg: Whether the sign bit is set.
### :param m: The full significand (zero for a zero value).
### :param e2: The binary exponent of the significand's last bit.
### :param lower_closer: Whether the float below is half as far away as the float above.
### :param sci_from: The leading-digit exponent from which scientific form is used.
### :returns: The rendered `Text` ("0" / "-0" for zero).
routine format_shortest(neg: Bool, m: Integer, e2: S64, lower_closer: Bool, sci_from: U64) -> Text
    if m.is_zero()
        if neg
            return "-0"
        return "0"
    var pr = shortest_float_digits(m: m, e2: e2, lower_closer: lower_closer)
    return assemble_decimal(neg: neg, digits: pr.digits, ee: pr.point_exp, sig: sci_from)

### floor(q * log10(2)) for |q| <= 5456721.
@inline
routine schubfach_flog10pow2(q: S64) -> S64
    return q *% 661971961083 >> 41

### floor(q * log10(2) + log10(3/4)) for |q| <= 5456721.
@inline
routine schubfach_flog10_three_quarters_pow2(q: S64) -> S64
    return q *% 661971961083 -% 274743187321 >> 41

### floor(e * log2(10)) for |e| <= 6432162.
@inline
routine schubfach_flog2pow10(e: S64) -> S64
    return e *% 913124641741 >> 38

### (g1 * 2^63 + g0) * cp / 2^127 rounded to odd: the integer part, with its lowest bit set when a
### fraction was dropped.
@inline
routine schubfach_rop(g1: U64, g0: U64, cp: U64) -> U64
    var x1 = LLVM::int_truncate[U128, U64](LLVM::zero_extend[U64, U128](g0) *% LLVM::zero_extend[U64, U128](cp) >>> 64)
    var p = LLVM::zero_extend[U64, U128](g1) *% LLVM::zero_extend[U64, U128](cp)
    var y0 = LLVM::int_truncate[U128, U64](p)
    var y1 = LLVM::int_truncate[U128, U64](p >>> 64)
    var z = (y0 >>> 1) +% x1
    var vbp = y1 +% (z >>> 63)
    return vbp | ((z & 0x7FFFFFFFFFFFFFFF) +% 0x7FFFFFFFFFFFFFFF >>> 63)

### The shortest decimal f * 10^e inside the rounding interval of the positive value c * 2^q (the closest
### to the value among the shortest, ties to even), for a format whose normal significands start at c_min
### and whose smallest exponent is q_min. An interval end counts as inside when c is even.
routine schubfach_decimal(q: S64, c: U64, c_min: U64, q_min: S64) -> (U64, S64)
    var out = c & 1
    var cb = c << 2
    var cbr = cb +% 2
    var cbl = cb -% 2
    var k = schubfach_flog10pow2(q: q)
    if c == c_min and q != q_min
        # the float below is half as far away: the interval is lopsided
        cbl = cb -% 1
        k = schubfach_flog10_three_quarters_pow2(q: q)
    var h = LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](q +% schubfach_flog2pow10(e: 0 -% k) +% 2))
    var idx = LLVM::reinterpret_bits[S64, U64](k +% 324) *% 2
    var g1 = SCHUBFACH_G[idx]
    var g0 = SCHUBFACH_G[idx +% 1]
    var vb = schubfach_rop(g1: g1, g0: g0, cp: cb << h)
    var vbl = schubfach_rop(g1: g1, g0: g0, cp: cbl << h)
    var vbr = schubfach_rop(g1: g1, g0: g0, cp: cbr << h)
    var s = vb >>> 2
    if s >= 10
        # one digit shorter: the interval spans less than ten units, so at most one of the two neighbouring
        # multiples of ten fits in it (Java looks here only from s = 100, since it always prints two digits)
        var sp10 = s // 10 *% 10
        var tp10 = sp10 +% 10
        var upin = vbl +% out <= (sp10 << 2)
        var wpin = (tp10 << 2) +% out <= vbr
        if upin and not wpin
            return (sp10, k)
        if wpin and not upin
            return (tp10, k)
    var t = s +% 1
    var uin = vbl +% out <= (s << 2)
    var win = (t << 2) +% out <= vbr
    if uin and not win
        return (s, k)
    if win and not uin
        return (t, k)
    # both fit: the closer one, the even one on a tie
    var cmp = LLVM::reinterpret_bits[U64, S64](vb) -% LLVM::reinterpret_bits[U64, S64](s +% t << 1)
    if cmp < 0 or (cmp == 0 and (s & 1) == 0)
        return (s, k)
    return (t, k)

### The decimal f * 10^e (f > 0, below 10^38) in `%g` layout (as assemble_decimal lays it out) with scientific form
### from a leading-digit exponent of sci_from, written straight into one character buffer. A nonempty wrap
### (a type name) is written around it as `wrap(...)`, the diagnose form.
routine shortest_decimal_text(neg: Bool, f: U128, e: S64, sci_from: U64, wrap: Text) -> Text
    var ee = e
    danger
        # the digits of f, least significant first (f = hi * 10^19 + lo, one wide division at most)
        var raw = Array[U32, 40]()
        var nraw = 0
        var hi: U64 = 0
        var lo = LLVM::int_truncate[U128, U64](f)
        if (f >>> 64) != 0
            var hq = f // 10000000000000000000
            hi = LLVM::int_truncate[U128, U64](hq)
            lo = LLVM::int_truncate[U128, U64](f -% hq *% 10000000000000000000)
            while nraw < 19
                raw[LLVM::reinterpret_bits[S64, U64](nraw)] = 0x30 +% LLVM::int_truncate[U64, U32](lo % 10)
                lo = lo // 10
                nraw = nraw +% 1
            lo = hi
        while lo != 0
            raw[LLVM::reinterpret_bits[S64, U64](nraw)] = 0x30 +% LLVM::int_truncate[U64, U32](lo % 10)
            lo = lo // 10
            nraw = nraw +% 1
        # drop the trailing zeros (the lowest digits)
        var z = 0
        while raw[LLVM::reinterpret_bits[S64, U64](z)] == 0x30
            z = z +% 1
        ee = ee +% z
        var dig = Array[U32, 40]()
        var k = 0
        while z +% k < nraw
            dig[LLVM::reinterpret_bits[S64, U64](k)] = raw[LLVM::reinterpret_bits[S64, U64](z +% k)]
            k = k +% 1
        var pe = ee +% k -% 1
        var buf = Array[Char, 96]()
        var p = LLVM::reinterpret_bits[Hijacked[Array[Char, 96]], Hijacked[Char]](buf.hijack())
        var n = 0
        var wn = LLVM::reinterpret_bits[U64, S64](wrap.count())
        if wn > 0
            while n < wn
                p.stride(count: n).poke(value: wrap[LLVM::reinterpret_bits[S64, U64](n)])
                n = n +% 1
            p.stride(count: n).poke(value: '(')
            n = n +% 1
        if neg
            p.stride(count: n).poke(value: '-')
            n = n +% 1
        if pe < -4 or pe >= LLVM::reinterpret_bits[U64, S64](sci_from)
            # d[.ddd]e+-XX
            p
                .stride(count: n)
                .poke(value: Char(dig[LLVM::reinterpret_bits[S64, U64](k -% 1)]))
            n = n +% 1
            if k > 1
                p.stride(count: n).poke(value: '.')
                n = n +% 1
                var i = k -% 2
                while i >= 0
                    p
                        .stride(count: n)
                        .poke(value: Char(dig[LLVM::reinterpret_bits[S64, U64](i)]))
                    n = n +% 1
                    i = i -% 1
            p.stride(count: n).poke(value: 'e')
            n = n +% 1
            var ea = pe
            if pe < 0
                ea = 0 -% pe
                p.stride(count: n).poke(value: '-')
            else
                p.stride(count: n).poke(value: '+')
            n = n +% 1
            # at least two exponent digits
            var nd = 2
            if ea >= 1000
                nd = 4
            elseif ea >= 100
                nd = 3
            var j = nd -% 1
            while j >= 0
                p
                    .stride(count: n +% j)
                    .poke(value: Char(0x30 +% LLVM::int_truncate[S64, U32](ea % 10)))
                ea = ea // 10
                j = j -% 1
            n = n +% nd
        elseif pe >= 0
            # the integer part, then the fraction if any digits are left
            var i = k -% 1
            var pos = 0
            while pos <= pe
                var c: U32 = 0x30
                if i >= 0
                    c = dig[LLVM::reinterpret_bits[S64, U64](i)]
                p.stride(count: n).poke(value: Char(c))
                n = n +% 1
                i = i -% 1
                pos = pos +% 1
            if i >= 0
                p.stride(count: n).poke(value: '.')
                n = n +% 1
                while i >= 0
                    p
                        .stride(count: n)
                        .poke(value: Char(dig[LLVM::reinterpret_bits[S64, U64](i)]))
                    n = n +% 1
                    i = i -% 1
        else
            # 0.000ddd
            p.stride(count: n).poke(value: '0')
            p.stride(count: n +% 1).poke(value: '.')
            n = n +% 2
            var pad = 0
            while pad < 0 -% pe -% 1
                p.stride(count: n).poke(value: '0')
                n = n +% 1
                pad = pad +% 1
            var i = k -% 1
            while i >= 0
                p.stride(count: n).poke(value: Char(dig[LLVM::reinterpret_bits[S64, U64](i)]))
                n = n +% 1
                i = i -% 1
        if wn > 0
            p.stride(count: n).poke(value: ')')
            n = n +% 1
        return Text(from_span: p, count: LLVM::reinterpret_bits[S64, U64](n))

### Renders the raw bits of a B16/B32/B64 as the shortest decimal that reads back as the same value.
### The shortest digits depend on the SOURCE format's spacing, so the bits are decoded in that format
### (never widened first).
### :param raw: The IEEE 754 bit pattern in the low bits.
### :param fmt: 0 = B64, 1 = B32, 2 = B16.
### :returns: The rendered `Text`. Specials: "NaN" / "inf" / "-inf".
routine format_binary_shortest(raw: U64, fmt: S32) -> Text
    return format_binary_shortest_wrapped(raw: raw, fmt: fmt, wrap: "")

### format_binary_shortest written as `wrap(...)` when wrap is nonempty (a type name, for diagnose).
routine format_binary_shortest_wrapped(raw: U64, fmt: S32, wrap: Text) -> Text
    # mant_bits = stored fraction bits, exp_bits = exponent field width, sci_from = the leading-digit
    # exponent where scientific form starts (the format's DIG + 1, as C's %g at DIG + 1 digits would).
    var mant_bits: U64 = 52
    var exp_bits: U64 = 11
    var sci_from: U64 = 16
    if fmt == 1
        mant_bits = 23
        exp_bits = 8
        sci_from = 7
    elseif fmt == 2
        mant_bits = 10
        exp_bits = 5
        sci_from = 4
    elseif fmt == 3
        # bfloat16: B32's exponent with 7 fraction bits
        mant_bits = 7
        exp_bits = 8
        sci_from = 3
    var exp_all_ones = LLVM::sub(a: LLVM::shift_left(1, exp_bits), b: 1)
    var bias = LLVM::reinterpret_bits[U64, S64](LLVM::shift_right_unsigned(exp_all_ones, 1))
    var neg = LLVM::int_ne(
        a: LLVM::shift_right_unsigned(raw, LLVM::add(a: mant_bits, b: exp_bits)),
        b: 0,
    )
    var ef = LLVM::bit_and(a: LLVM::shift_right_unsigned(raw, mant_bits), b: exp_all_ones)
    var mf = LLVM::bit_and(a: raw, b: LLVM::sub(a: LLVM::shift_left(1, mant_bits), b: 1))
    var mbits = LLVM::reinterpret_bits[U64, S64](mant_bits)
    if LLVM::int_eq(a: ef, b: exp_all_ones)
        var sp = "inf"
        if LLVM::int_ne(a: mf, b: 0)
            sp = "NaN"
        elseif neg
            sp = "-inf"
        if wrap.count() > 0
            return wrap + "(" + sp + ")"
        return sp
    var c_min: U64 = 1 << LLVM::int_truncate[U64, U32](mant_bits)
    var q_min = 1 -% bias -% mbits
    if ef == 0
        if mf == 0
            var zt = "0"
            if neg
                zt = "-0"
            if wrap.count() > 0
                return wrap + "(" + zt + ")"
            return zt
        var (fs, es) = schubfach_decimal(q: q_min, c: mf, c_min: c_min, q_min: q_min)
        return shortest_decimal_text(
            neg: neg,
            f: LLVM::zero_extend[U64, U128](fs),
            e: es,
            sci_from: sci_from,
            wrap: wrap,
        )
    var c = mf | c_min
    var q = LLVM::reinterpret_bits[U64, S64](ef) -% bias -% mbits
    # an integer below 2^(mant_bits + 1) is its own shortest decimal
    var mq = 0 -% q
    if mq > 0 and mq <= mbits
        var fi = c >>> LLVM::int_truncate[S64, U32](mq)
        if (fi << LLVM::int_truncate[S64, U32](mq)) == c
            return shortest_decimal_text(
                neg: neg,
                f: LLVM::zero_extend[U64, U128](fi),
                e: 0,
                sci_from: sci_from,
                wrap: wrap,
            )
    var (f, e) = schubfach_decimal(q: q, c: c, c_min: c_min, q_min: q_min)
    return shortest_decimal_text(
        neg: neg,
        f: LLVM::zero_extend[U64, U128](f),
        e: e,
        sci_from: sci_from,
        wrap: wrap,
    )

### Renders a B128 as the shortest decimal that reads back as the same value (scientific from a
### leading-digit exponent of 34, FLT128_DIG + 1). Specials: "NaN" / "inf" / "-inf".
### :param value: The value to render.
### :returns: The rendered `Text`.
routine format_b128_shortest(value: B128) -> Text
    return format_b128_shortest_wrapped(value: value, wrap: "")

# ----------------------------------------------------------------------------
# Fixed-point formatting: exactly `places` digits after the point
# ----------------------------------------------------------------------------
# Every real type reduces to sign × num / den exactly (a binary float is m · 2^e, a decimal float
# c · 10^e), so `fixed(places)` is one exact big-integer step: round num · 10^places / den to an
# integer, half to even, then put the point `places` digits from the right. No %g switch to
# scientific form: the whole integer part is always written out.

### Renders `scaled` (the value times 10^places, already an integer) with `places` digits after the
### point and a leading `-` when `neg`.
routine fixed_from_scaled(neg: Bool, scaled: Integer, places: U64) -> Text
    var digits = scaled.represent()
    if digits.count() <= places
        digits = zeros_text(n: places + 1 - digits.count()) + digits
    var body = digits
    if places > 0
        var point = digits.count() - places
        body = digits[0 til point] + "." + digits[point til digits.count()]
    if neg
        return "-" + body
    return body

### The exact non-negative value `num / den` rendered with `places` digits after the point, rounded
### half to even.
routine fixed_from_ratio(neg: Bool, num: Integer, den: Integer, places: U64) -> Text
    var scaled = div_round_half_even(
        n: num.mul(other: pow10_int(k: LLVM::reinterpret_bits[U64, S64](places))),
        d: den,
    )
    return fixed_from_scaled(neg: neg, scaled: scaled, places: places)

### The exact value m · 2^e2 (m non-negative) with `places` digits after the point.
routine fixed_from_binary(neg: Bool, m: Integer, e2: S64, places: U64) -> Text
    var num = m
    var den = Integer.one()
    if e2 >= 0
        num = num.shift_left(bits: LLVM::int_truncate[S64, U32](e2))
    else
        den = den.shift_left(bits: LLVM::int_truncate[S64, U32](0 - e2))
    return fixed_from_ratio(neg: neg, num: num, den: den, places: places)

### Renders a B64 with exactly `places` digits after the point (B16/B32 widen to B64 exactly first).
### Specials: "NaN" / "inf" / "-inf".
routine format_binary_fixed(value: B64, places: U64) -> Text
    if value.is_nan()
        return "NaN"
    if value.is_infinite()
        if value.is_sign_negative()
            return "-inf"
        return "inf"
    var raw = value.to_bits()
    var bits = LLVM::bit_and(a: raw, b: 0x7FFFFFFFFFFFFFFF)
    var ef = LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 52), b: 0x7FF)
    var mf = LLVM::bit_and(a: bits, b: 0xFFFFFFFFFFFFF)
    var m = mf
    var e2 = -1074
    if LLVM::int_ne(a: ef, b: 0)
        m = LLVM::bit_or(a: mf, b: 0x10000000000000)
        e2 = LLVM::reinterpret_bits[U64, S64](ef) - 1075
    if m != 0
        var (fast, txt) = b128t_fixed_binary(
            neg: value.is_sign_negative(),
            c: LLVM::zero_extend[U64, U128](m),
            q: e2,
            places: places,
        )
        if fast
            return txt
    return fixed_from_binary(neg: value.is_sign_negative(), m: m.to[Integer](), e2: e2, places: places)

### Renders the raw bits of a B128 with exactly `places` digits after the point.
routine format_b128_fixed(value: B128, places: U64) -> Text
    if value.is_nan()
        return "NaN"
    if value.is_infinite()
        if value.is_sign_negative()
            return "-inf"
        return "inf"
    var bits = value.to_bits()
    var ef = LLVM::int_truncate[U128, U64](
        LLVM::bit_and(
            a: LLVM::shift_right_unsigned(bits, LLVM::zero_extend[U64, U128](112)),
            b: LLVM::zero_extend[U64, U128](0x7FFF),
        ),
    )
    var mf = LLVM::bit_and(
        a: bits,
        b: LLVM::sub(
            a: LLVM::shift_left(
                LLVM::zero_extend[U64, U128](1),
                LLVM::zero_extend[U64, U128](112),
            ),
            b: LLVM::zero_extend[U64, U128](1),
        ),
    )
    var m = mf
    var e2 = -16494
    if LLVM::int_ne(a: ef, b: 0)
        m = LLVM::bit_or(
            a: mf,
            b: LLVM::shift_left(
                LLVM::zero_extend[U64, U128](1),
                LLVM::zero_extend[U64, U128](112),
            ),
        )
        e2 = LLVM::reinterpret_bits[U64, S64](ef) - 16495
    if m != 0
        var (fast, txt) = b128t_fixed_binary(neg: value.is_sign_negative(), c: m, q: e2, places: places)
        if fast
            return txt
    return fixed_from_binary(neg: value.is_sign_negative(), m: m.to[Integer](), e2: e2, places: places)

### Renders decoded decimal-float parts (c · 10^e) with exactly `places` digits after the point.
### Specials: "NaN" / "sNaN" / "inf" / "-inf".
routine format_decimal_fixed(p: D128Parts, places: U64) -> Text
    if LLVM::int_eq(a: p.special, b: 1)
        return if p.sign then "-inf" else "inf"
    if LLVM::int_eq(a: p.special, b: 3)
        return "sNaN"
    if LLVM::unsigned_ge(a: p.special, b: 2)
        return "NaN"
    var (fast, txt) = decimal_fixed_fast(p: p, places: places)
    if fast
        return txt
    var num = p.coeff.to[Integer]()
    var den = Integer.one()
    if p.exp >= 0
        num = num.mul(other: pow10_int(k: p.exp))
    else
        den = pow10_int(k: 0 - p.exp)
    return fixed_from_ratio(neg: p.sign, num: num, den: den, places: places)

### coeff * 10^exp with `places` digits after the point, exactly in U128 arithmetic when the scaled value
### stays below 10^37 (places up to 40), or false.
routine decimal_fixed_fast(p: D128Parts, places: U64) -> (Bool, Text)
    if places > 40
        return (false, "")
    var sh = p.exp +% LLVM::reinterpret_bits[U64, S64](places)
    var n = p.coeff
    if n == 0
        return (true, b128t_fixed_text(neg: p.sign, n: 0, places: places))
    if sh >= 0
        # n * 10^sh must stay below 10^37
        var j = 0
        while j < sh
            if n >= 1000000000000000000000000000000000000
                return (false, "")
            n = n *% 10
            j = j +% 1
    elseif sh > -39
        var d: U128 = 1
        var j2 = 0
        while j2 < 0 -% sh
            d = d *% 10
            j2 = j2 +% 1
        var q = n // d
        var r = n -% q *% d
        var twice = r +% r
        if twice > d or (twice == d and (q & 1) == 1)
            q = q +% 1
        n = q
    elseif n >= 10000000000000000000000000000000000000
        return (false, "")
    else
        # the coefficient is below 10^37, so below half a unit of 10^-38 and more: it rounds to 0
        n = 0
    return (true, b128t_fixed_text(neg: p.sign, n: n, places: places))

# ----------------------------------------------------------------------------
# Parsing: decimal text -> nearest binary float (rounded straight to target)
# ----------------------------------------------------------------------------

### Rounds the positive rational num_in/den_in to the nearest binary float of the
### given format (ties to even) and returns the full IEEE 754 bit pattern in the low
### bits of a `U64` (the caller truncates for B32/B16). Every `Integer` stays a local
### here — no aggregate carries a managed value across the routine boundary.
### `fmt` selects the format's field widths: 0 = B64, 1 = B32, 2 = B16.
routine round_and_pack(neg: Bool, num_in: Integer, den_in: Integer, fmt: S32) -> U64
    # Format constants: p = significand bits, min_lsb = smallest representable bit-
    # exponent, emin/emax = unbiased normal-exponent range, bias, mant_bits = p-1,
    # exp_bits = exponent field width. Defaults are B64; narrower formats override.
    var p = 53
    var min_lsb = -1074
    var emin = -1022
    var emax = 1023
    var bias = 1023
    var mant_bits: U64 = 52
    var exp_bits: U64 = 11
    if fmt == 1
        p = 24
        min_lsb = -149
        emin = -126
        emax = 127
        bias = 127
        mant_bits = 23
        exp_bits = 8
    elseif fmt == 2
        p = 11
        min_lsb = -24
        emin = -14
        emax = 15
        bias = 15
        mant_bits = 10
        exp_bits = 5
    elseif fmt == 3
        p = 8
        min_lsb = -133
        emin = -126
        emax = 127
        bias = 127
        mant_bits = 7
        exp_bits = 8
    var num = num_in
    var den = den_in
    # Binary exponent of the leading significand bit: 2^ee <= value < 2^(ee+1).
    var ee = LLVM::reinterpret_bits[U64, S64](num.bit_length()) - LLVM::reinterpret_bits[U64, S64](den.bit_length()) - 1
    while ratio_ge_pow2(num: num, den: den, k: ee + 1)
        ee = ee + 1
    while not ratio_ge_pow2(num: num, den: den, k: ee)
        ee = ee - 1
    var lsb = ee - (p - 1)
    if lsb < min_lsb
        lsb = min_lsb
    var n2 = num
    var d2 = den
    if lsb >= 0
        d2 = den.shift_left(bits: LLVM::int_truncate[S64, U32](lsb))
    else
        n2 = num.shift_left(bits: LLVM::int_truncate[S64, U32](0 - lsb))
    var q = div_round_half_even(n: n2, d: d2)
    # A round-up can carry to 2^p; renormalize one bit.
    var pbits = Integer.one().shift_left(bits: LLVM::int_truncate[S64, U32](p))
    if q.compare(you: pbits) != ME_SMALL
        q = q.arith_shift_right(bits: 1)
        lsb = lsb + 1
    # Pack the IEEE fields (generic over the format's widths).
    var sign: U64 = 0
    if neg
        sign = LLVM::shift_left(1, LLVM::add(a: mant_bits, b: exp_bits))
    if q.is_zero()
        return sign
    var leading = LLVM::reinterpret_bits[U64, S64](q.bit_length())
    var efinal = lsb + leading - 1
    var exp_all_ones = LLVM::sub(a: LLVM::shift_left(1, exp_bits), b: 1)
    if efinal > emax
        return LLVM::bit_or(a: sign, b: LLVM::shift_left(exp_all_ones, mant_bits))
    var qbits = q.to[U64]()
    var mant_mask = LLVM::sub(a: LLVM::shift_left(1, mant_bits), b: 1)
    if leading == p and efinal >= emin
        var biased = LLVM::reinterpret_bits[S64, U64](efinal + bias)
        var mant = LLVM::bit_and(a: qbits, b: mant_mask)
        return LLVM::bit_or(
            a: sign,
            b: LLVM::bit_or(a: LLVM::shift_left(biased, mant_bits), b: mant),
        )
    return LLVM::bit_or(a: sign, b: qbits)

### Validates a decimal float string and extracts (kind, neg, significand, dec_exp)
### where a finite magnitude equals significand × 10^dec_exp. kind: 0 finite,
### 1 NaN, 2 infinity. Throws {InvalidValueError} on malformed input.
routine parse_float_components(from_text: Text, target: Text) -> FloatParsed
    var len = from_text.count()
    if len == 0
        return FloatParsed(kind: 3, is_neg: false, digits: "0", dec_exp: 0)
    var i: U64 = 0
    var neg = false
    var first = from_text[0]
    if first == '+' or first == '-'
        neg = first == '-'
        i = 1
        if i >= len
            return FloatParsed(kind: 3, is_neg: false, digits: "0", dec_exp: 0)
    var rest = len - i
    if rest >= 3
        var c0 = from_text[i].to_lowercase()
        var c1 = from_text[i + 1].to_lowercase()
        var c2 = from_text[i + 2].to_lowercase()
        if rest == 3
            and c0 == 'n'
            and c1 == 'a'
            and c2 == 'n'
            return FloatParsed(kind: 1, is_neg: neg, digits: "0", dec_exp: 0)
        if rest == 3
            and c0 == 'i'
            and c1 == 'n'
            and c2 == 'f'
            return FloatParsed(kind: 2, is_neg: neg, digits: "0", dec_exp: 0)
        if rest == 8
            and c0 == 'i'
            and c1 == 'n'
            and c2 == 'f'
            var c3 = from_text[i + 3].to_lowercase()
            var c4 = from_text[i + 4].to_lowercase()
            var c5 = from_text[i + 5].to_lowercase()
            var c6 = from_text[i + 6].to_lowercase()
            var c7 = from_text[i + 7].to_lowercase()
            if c3 == 'i'
                and c4 == 'n'
                and c5 == 'i'
                and c6 == 't'
                and c7 == 'y'
                return FloatParsed(kind: 2, is_neg: neg, digits: "0", dec_exp: 0)
    var m = Integer.zero()
    var ten: Integer = 10
    var frac_digits = 0
    var seen_dot = false
    var has_digit = false
    var has_exp = false
    var exp_val = 0
    var exp_neg = false
    var exp_has_digit = false
    while i < len
        var ch = from_text[i]
        if ch.is_numeric()
            if has_exp
                exp_has_digit = true
                if exp_val < 1000000
                    exp_val = exp_val * 10 + ch.digit_value().to[S64]()
            else
                has_digit = true
                m = m.mul(other: ten).add(other: ch.digit_value().to[Integer]())
                if seen_dot
                    frac_digits = frac_digits + 1
        elseif ch == '.'
            if seen_dot or has_exp
                return FloatParsed(kind: 3, is_neg: false, digits: "0", dec_exp: 0)
            seen_dot = true
        elseif ch == 'e' or ch == 'E'
            if has_exp or not has_digit
                return FloatParsed(kind: 3, is_neg: false, digits: "0", dec_exp: 0)
            has_exp = true
            if i + 1 < len
                var next_ch = from_text[i + 1]
                if next_ch == '+' or next_ch == '-'
                    exp_neg = next_ch == '-'
                    i = i + 1
        else
            return FloatParsed(kind: 3, is_neg: false, digits: "0", dec_exp: 0)
        i = i + 1
    if not has_digit
        return FloatParsed(kind: 3, is_neg: false, digits: "0", dec_exp: 0)
    if has_exp and not exp_has_digit
        return FloatParsed(kind: 3, is_neg: false, digits: "0", dec_exp: 0)
    var signed_exp = exp_val
    if exp_neg
        signed_exp = 0 - exp_val
    return FloatParsed(
        kind: 0,
        is_neg: neg,
        digits: m.represent(),
        dec_exp: signed_exp - frac_digits,
    )

# ----------------------------------------------------------------------------
# Per-type entry points: rational -> IEEE 754 bit pattern (via round_and_pack)
# ----------------------------------------------------------------------------

### Rounds significand × 10^dec_exp to the nearest B64.
routine b64_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> B64
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        var z: U64 = 0
        if neg
            z = 0x8000000000000000
        return B64.from_bits(bits: z)
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 320
        var big: U64 = 0x7FF0000000000000
        if neg
            big = 0xFFF0000000000000
        return B64.from_bits(bits: big)
    if mag < -330
        var zz: U64 = 0
        if neg
            zz = 0x8000000000000000
        return B64.from_bits(bits: zz)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0 - dec_exp)
    var bits = round_and_pack(neg: neg, num_in: num, den_in: den, fmt: 0)
    return B64.from_bits(bits: bits)

### Rounds significand × 10^dec_exp to the nearest B32 (single rounding).
routine b32_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> B32
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        var z: U32 = 0
        if neg
            z = 0x80000000
        return B32.from_bits(bits: z)
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 320
        var big: U32 = 0x7F800000
        if neg
            big = 0xFF800000
        return B32.from_bits(bits: big)
    if mag < -330
        var zz: U32 = 0
        if neg
            zz = 0x80000000
        return B32.from_bits(bits: zz)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0 - dec_exp)
    var bits = round_and_pack(neg: neg, num_in: num, den_in: den, fmt: 1)
    return B32.from_bits(bits: LLVM::int_truncate[U64, U32](bits))

### Rounds significand × 10^dec_exp to the nearest B16 (single rounding).
routine b16_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> B16
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        var z: U16 = 0
        if neg
            z = 0x8000
        return B16.from_bits(bits: z)
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 320
        var big: U16 = 0x7C00
        if neg
            big = 0xFC00
        return B16.from_bits(bits: big)
    if mag < -330
        var zz: U16 = 0
        if neg
            zz = 0x8000
        return B16.from_bits(bits: zz)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0 - dec_exp)
    var bits = round_and_pack(neg: neg, num_in: num, den_in: den, fmt: 2)
    return B16.from_bits(bits: LLVM::int_truncate[U64, U16](bits))

### Rounds significand × 10^dec_exp to the nearest BF16 (single rounding, ties to even).
routine bf16_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> BF16
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        var z: U16 = 0
        if neg
            z = 0x8000
        return BF16.from_bits(bits: z)
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 320
        var big: U16 = 0x7F80
        if neg
            big = 0xFF80
        return BF16.from_bits(bits: big)
    if mag < -330
        var zz: U16 = 0
        if neg
            zz = 0x8000
        return BF16.from_bits(bits: zz)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0 - dec_exp)
    var bits = round_and_pack(neg: neg, num_in: num, den_in: den, fmt: 3)
    return BF16.from_bits(bits: LLVM::int_truncate[U64, U16](bits))

### Rounds significand × 10^dec_exp to the nearest B128 (single rounding, ties to even) and packs
### the IEEE 754 binary128 bit pattern: 113 significand bits, normal exponents -16382..16383,
### subnormals down to 2^-16494, overflow to infinity.
routine b128_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> B128
    var sign: U64 = 0
    if neg
        sign = 1
    var sign_bit = LLVM::shift_left(value: LLVM::zero_extend[U64, U128](sign), bits: 127)
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        return B128.from_bits(bits: sign_bit)
    # value < 10^mag, so mag bounds the magnitude cheaply before any big power of ten is built.
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 4940
        return B128.from_bits(bits: b128_inf(sign: sign))
    if mag < -4970
        return B128.from_bits(bits: sign_bit)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0 - dec_exp)
    # Binary exponent of the leading significand bit: 2^ee <= value < 2^(ee+1).
    var ee = LLVM::reinterpret_bits[U64, S64](num.bit_length()) - LLVM::reinterpret_bits[U64, S64](den.bit_length()) - 1
    while ratio_ge_pow2(num: num, den: den, k: ee + 1)
        ee = ee + 1
    while not ratio_ge_pow2(num: num, den: den, k: ee)
        ee = ee - 1
    var lsb = ee - 112
    if lsb < -16494
        lsb = -16494
    var n2 = num
    var d2 = den
    if lsb >= 0
        d2 = den.shift_left(bits: LLVM::int_truncate[S64, U32](lsb))
    else
        n2 = num.shift_left(bits: LLVM::int_truncate[S64, U32](0 - lsb))
    var q = div_round_half_even(n: n2, d: d2)
    # A round-up can carry to 2^113; renormalize one bit.
    if q.compare(you: Integer.one().shift_left(bits: 113)) != ME_SMALL
        q = q.arith_shift_right(bits: 1)
        lsb = lsb + 1
    if q.is_zero()
        return B128.from_bits(bits: sign_bit)
    var leading = LLVM::reinterpret_bits[U64, S64](q.bit_length())
    var efinal = lsb + leading - 1
    if efinal > 16383
        return B128.from_bits(bits: b128_inf(sign: sign))
    var q_hi = q.arith_shift_right(bits: 64)
    var q_lo = q.sub(other: q_hi.shift_left(bits: 64))
    var qbits = LLVM::bit_or(
        a: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](q_hi.to[U64]()), bits: 64),
        b: LLVM::zero_extend[U64, U128](q_lo.to[U64]()),
    )
    if leading == 113 and efinal >= -16382
        var biased = LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](efinal + 16383))
        var mant = LLVM::bit_and(
            a: qbits,
            b: LLVM::sub(a: LLVM::shift_left[U128](value: 1, bits: 112), b: 1),
        )
        qbits = LLVM::bit_or(a: LLVM::shift_left(value: biased, bits: 112), b: mant)
    return B128.from_bits(bits: LLVM::bit_or(a: sign_bit, b: qbits))
