]

### floor(q * log10(2)) for |q| <= 5456721.
@inline
routine schubfach_flog10pow2(q: S64) -> S64
    return (q *% 661971961083_s64) >> 41

### floor(q * log10(2) + log10(3/4)) for |q| <= 5456721.
@inline
routine schubfach_flog10_three_quarters_pow2(q: S64) -> S64
    return (q *% 661971961083_s64 -% 274743187321_s64) >> 41

### floor(e * log2(10)) for |e| <= 6432162.
@inline
routine schubfach_flog2pow10(e: S64) -> S64
    return (e *% 913124641741_s64) >> 38

### (g1 * 2^63 + g0) * cp / 2^127 rounded to odd: the integer part, with its lowest bit set when a
### fraction was dropped.
@inline
routine schubfach_rop(g1: U64, g0: U64, cp: U64) -> U64
    var x1 = LLVM::int_truncate[U128, U64]((LLVM::zero_extend[U64, U128](g0) *% LLVM::zero_extend[U64, U128](cp)) >>> 64_u32)
    var p = LLVM::zero_extend[U64, U128](g1) *% LLVM::zero_extend[U64, U128](cp)
    var y0 = LLVM::int_truncate[U128, U64](p)
    var y1 = LLVM::int_truncate[U128, U64](p >>> 64_u32)
    var z = (y0 >>> 1_u32) +% x1
    var vbp = y1 +% (z >>> 63_u32)
    return vbp | (((z & 0x7FFFFFFFFFFFFFFF_u64) +% 0x7FFFFFFFFFFFFFFF_u64) >>> 63_u32)

### The shortest decimal f * 10^e inside the rounding interval of the positive value c * 2^q (the closest
### to the value among the shortest, ties to even), for a format whose normal significands start at c_min
### and whose smallest exponent is q_min. An interval end counts as inside when c is even.
routine schubfach_decimal(q: S64, c: U64, c_min: U64, q_min: S64) -> (U64, S64)
    var out = c & 1_u64
    var cb = c << 2_u32
    var cbr = cb +% 2_u64
    var cbl = cb -% 2_u64
    var k = schubfach_flog10pow2(q: q)
    if c == c_min and q != q_min
        # the float below is half as far away: the interval is lopsided
        cbl = cb -% 1_u64
        k = schubfach_flog10_three_quarters_pow2(q: q)
    var h = LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](q +% schubfach_flog2pow10(e: 0_s64 -% k) +% 2_s64))
    var idx = LLVM::reinterpret_bits[S64, U64](k +% 324_s64) *% 2_u64
    var g1 = SCHUBFACH_G[idx]
    var g0 = SCHUBFACH_G[idx +% 1_u64]
    var vb = schubfach_rop(g1: g1, g0: g0, cp: cb << h)
    var vbl = schubfach_rop(g1: g1, g0: g0, cp: cbl << h)
    var vbr = schubfach_rop(g1: g1, g0: g0, cp: cbr << h)
    var s = vb >>> 2_u32
    if s >= 10_u64
        # one digit shorter: the interval spans less than ten units, so at most one of the two neighbouring
        # multiples of ten fits in it (Java looks here only from s = 100, since it always prints two digits)
        var sp10 = (s // 10_u64) *% 10_u64
        var tp10 = sp10 +% 10_u64
        var upin = vbl +% out <= (sp10 << 2_u32)
        var wpin = (tp10 << 2_u32) +% out <= vbr
        if upin and not wpin
            return (sp10, k)
        if wpin and not upin
            return (tp10, k)
    var t = s +% 1_u64
    var uin = vbl +% out <= (s << 2_u32)
    var win = (t << 2_u32) +% out <= vbr
    if uin and not win
        return (s, k)
    if win and not uin
        return (t, k)
    # both fit: the closer one, the even one on a tie
    var cmp = LLVM::reinterpret_bits[U64, S64](vb) -% LLVM::reinterpret_bits[U64, S64]((s +% t) << 1_u32)
    if cmp < 0_s64 or (cmp == 0_s64 and (s & 1_u64) == 0_u64)
        return (s, k)
    return (t, k)

### The decimal f * 10^e (f > 0, below 10^38) in `%g` layout (as assemble_decimal lays it out) with scientific form
### from a leading-digit exponent of sci_from, written straight into one character buffer. A nonempty wrap
### (a type name) is written around it as `wrap(...)`, the diagnose form.
routine shortest_decimal_text(neg: Bool, f: U128, e: S64, sci_from: U64, wrap: Text) -> Text
    var ee = e
    danger
        # the digits of f, least significant first (f = hi * 10^19 + lo, one wide division at most)
        var raw = Array[U32, 40]()
        var nraw = 0_s64
        var hi = 0_u64
        var lo = LLVM::int_truncate[U128, U64](f)
        if (f >>> 64_u32) != 0_u128
            var hq = f // 10000000000000000000_u128
            hi = LLVM::int_truncate[U128, U64](hq)
            lo = LLVM::int_truncate[U128, U64](f -% hq *% 10000000000000000000_u128)
            while nraw < 19_s64
                raw[LLVM::reinterpret_bits[S64, U64](nraw)] = 0x30_u32 +% LLVM::int_truncate[U64, U32](lo % 10_u64)
                lo = lo // 10_u64
                nraw = nraw +% 1_s64
            lo = hi
        while lo != 0_u64
            raw[LLVM::reinterpret_bits[S64, U64](nraw)] = 0x30_u32 +% LLVM::int_truncate[U64, U32](lo % 10_u64)
            lo = lo // 10_u64
            nraw = nraw +% 1_s64
        # drop the trailing zeros (the lowest digits)
        var z = 0_s64
        while raw[LLVM::reinterpret_bits[S64, U64](z)] == 0x30_u32
            z = z +% 1_s64
        ee = ee +% z
        var dig = Array[U32, 40]()
        var k = 0_s64
        while z +% k < nraw
            dig[LLVM::reinterpret_bits[S64, U64](k)] = raw[LLVM::reinterpret_bits[S64, U64](z +% k)]
            k = k +% 1_s64
        var pe = ee +% k -% 1_s64
        var buf = Array[Character, 96]()
        var p = LLVM::reinterpret_bits[Hijacked[Array[Character, 96]], Hijacked[Character]](buf.hijack())
        var n = 0_s64
        var wn = LLVM::reinterpret_bits[U64, S64](wrap.count())
        if wn > 0_s64
            while n < wn
                p.stride(count: n).poke(value: wrap[LLVM::reinterpret_bits[S64, U64](n)])
                n = n +% 1_s64
            p.stride(count: n).poke(value: Character(0x28_u32))
            n = n +% 1_s64
        if neg
            p.stride(count: n).poke(value: Character(0x2D_u32))
            n = n +% 1_s64
        if pe < -4_s64 or pe >= LLVM::reinterpret_bits[U64, S64](sci_from)
            # d[.ddd]e+-XX
            p.stride(count: n).poke(value: Character(dig[LLVM::reinterpret_bits[S64, U64](k -% 1_s64)]))
            n = n +% 1_s64
            if k > 1_s64
                p.stride(count: n).poke(value: Character(0x2E_u32))
                n = n +% 1_s64
                var i = k -% 2_s64
                while i >= 0_s64
                    p.stride(count: n).poke(value: Character(dig[LLVM::reinterpret_bits[S64, U64](i)]))
                    n = n +% 1_s64
                    i = i -% 1_s64
            p.stride(count: n).poke(value: Character(0x65_u32))
            n = n +% 1_s64
            var ea = pe
            if pe < 0_s64
                ea = 0_s64 -% pe
                p.stride(count: n).poke(value: Character(0x2D_u32))
            else
                p.stride(count: n).poke(value: Character(0x2B_u32))
            n = n +% 1_s64
            # at least two exponent digits
            var nd = 2_s64
            if ea >= 1000_s64
                nd = 4_s64
            elseif ea >= 100_s64
                nd = 3_s64
            var j = nd -% 1_s64
            while j >= 0_s64
                p.stride(count: n +% j).poke(value: Character(0x30_u32 +% LLVM::int_truncate[S64, U32](ea % 10_s64)))
                ea = ea // 10_s64
                j = j -% 1_s64
            n = n +% nd
        elseif pe >= 0_s64
            # the integer part, then the fraction if any digits are left
            var i = k -% 1_s64
            var pos = 0_s64
            while pos <= pe
                var c = 0x30_u32
                if i >= 0_s64
                    c = dig[LLVM::reinterpret_bits[S64, U64](i)]
                p.stride(count: n).poke(value: Character(c))
                n = n +% 1_s64
                i = i -% 1_s64
                pos = pos +% 1_s64
            if i >= 0_s64
                p.stride(count: n).poke(value: Character(0x2E_u32))
                n = n +% 1_s64
                while i >= 0_s64
                    p.stride(count: n).poke(value: Character(dig[LLVM::reinterpret_bits[S64, U64](i)]))
                    n = n +% 1_s64
                    i = i -% 1_s64
        else
            # 0.000ddd
            p.stride(count: n).poke(value: Character(0x30_u32))
            p.stride(count: n +% 1_s64).poke(value: Character(0x2E_u32))
            n = n +% 2_s64
            var pad = 0_s64
            while pad < 0_s64 -% pe -% 1_s64
                p.stride(count: n).poke(value: Character(0x30_u32))
                n = n +% 1_s64
                pad = pad +% 1_s64
            var i = k -% 1_s64
            while i >= 0_s64
                p.stride(count: n).poke(value: Character(dig[LLVM::reinterpret_bits[S64, U64](i)]))
                n = n +% 1_s64
                i = i -% 1_s64
        if wn > 0_s64
            p.stride(count: n).poke(value: Character(0x29_u32))
            n = n +% 1_s64
        return Text(from_span: p, count: LLVM::reinterpret_bits[S64, U64](n))

### Renders the raw bits of a B16/B32/B64 as the shortest decimal that reads back as the same value.
### The shortest digits depend on the SOURCE format's spacing, so the bits are decoded in that format
### (never widened first).
### :param raw: The IEEE 754 bit pattern in the low bits.
### :param fmt: 0 = B64, 1 = B32, 2 = B16.
### :returns: The rendered `Text`. Specials: "NaN" / "inf" / "-inf".
routine format_binary_shortest(raw: U64, fmt: S32) -> Text
    return format_binary_shortest_wrapped(raw: raw, fmt: fmt, wrap: "")

### format_binary_shortest written as `wrap(...)` when wrap is nonempty (a type name, for diagnose).
routine format_binary_shortest_wrapped(raw: U64, fmt: S32, wrap: Text) -> Text
    # mant_bits = stored fraction bits, exp_bits = exponent field width, sci_from = the leading-digit
    # exponent where scientific form starts (the format's DIG + 1, as C's %g at DIG + 1 digits would).
    var mant_bits = 52u64
    var exp_bits = 11u64
    var sci_from = 16u64
    if fmt == 1_s32
        mant_bits = 23u64
        exp_bits = 8u64
        sci_from = 7u64
    elseif fmt == 2_s32
        mant_bits = 10u64
        exp_bits = 5u64
        sci_from = 4u64
    elseif fmt == 3_s32
        # bfloat16: B32's exponent with 7 fraction bits
        mant_bits = 7u64
        exp_bits = 8u64
        sci_from = 3u64
    var exp_all_ones = LLVM::sub(a: LLVM::shift_left(1u64, exp_bits), b: 1u64)
    var bias = LLVM::reinterpret_bits[U64, S64](LLVM::shift_right_unsigned(exp_all_ones, 1u64))
    var neg = LLVM::int_ne(a: LLVM::shift_right_unsigned(raw, LLVM::add(a: mant_bits, b: exp_bits)), b: 0u64)
    var ef = LLVM::bit_and(a: LLVM::shift_right_unsigned(raw, mant_bits), b: exp_all_ones)
    var mf = LLVM::bit_and(a: raw, b: LLVM::sub(a: LLVM::shift_left(1u64, mant_bits), b: 1u64))
    var mbits = LLVM::reinterpret_bits[U64, S64](mant_bits)
    if LLVM::int_eq(a: ef, b: exp_all_ones)
        var sp = "inf"
        if LLVM::int_ne(a: mf, b: 0u64)
            sp = "NaN"
        elseif neg
            sp = "-inf"
        if wrap.count() > 0u64
            return wrap + "(" + sp + ")"
        return sp
    var c_min = 1_u64 << LLVM::int_truncate[U64, U32](mant_bits)
    var q_min = 1_s64 -% bias -% mbits
    if ef == 0_u64
        if mf == 0_u64
            var zt = "0"
            if neg
                zt = "-0"
            if wrap.count() > 0u64
                return wrap + "(" + zt + ")"
            return zt
        var (fs, es) = schubfach_decimal(q: q_min, c: mf, c_min: c_min, q_min: q_min)
        return shortest_decimal_text(neg: neg, f: LLVM::zero_extend[U64, U128](fs), e: es, sci_from: sci_from, wrap: wrap)
    var c = mf | c_min
    var q = LLVM::reinterpret_bits[U64, S64](ef) -% bias -% mbits
    # an integer below 2^(mant_bits + 1) is its own shortest decimal
    var mq = 0_s64 -% q
    if mq > 0_s64 and mq <= mbits
        var fi = c >>> LLVM::int_truncate[S64, U32](mq)
        if (fi << LLVM::int_truncate[S64, U32](mq)) == c
            return shortest_decimal_text(neg: neg, f: LLVM::zero_extend[U64, U128](fi), e: 0_s64, sci_from: sci_from, wrap: wrap)
    var (f, e) = schubfach_decimal(q: q, c: c, c_min: c_min, q_min: q_min)
    return shortest_decimal_text(neg: neg, f: LLVM::zero_extend[U64, U128](f), e: e, sci_from: sci_from, wrap: wrap)

### Renders a B128 as the shortest decimal that reads back as the same value (scientific from a
### leading-digit exponent of 34, FLT128_DIG + 1). Specials: "NaN" / "inf" / "-inf".
### :param value: The value to render.
### :returns: The rendered `Text`.
routine format_b128_shortest(value: B128) -> Text
    return format_b128_shortest_wrapped(value: value, wrap: "")

# ----------------------------------------------------------------------------
# Fixed-point formatting: exactly `places` digits after the point
# ----------------------------------------------------------------------------
# Every real type reduces to sign × num / den exactly (a binary float is m · 2^e, a decimal float
# c · 10^e), so `fixed(places)` is one exact big-integer step: round num · 10^places / den to an
# integer, half to even, then put the point `places` digits from the right. No %g switch to
# scientific form: the whole integer part is always written out.

### Renders `scaled` (the value times 10^places, already an integer) with `places` digits after the
### point and a leading `-` when `neg`.
routine fixed_from_scaled(neg: Bool, scaled: Integer, places: U64) -> Text
    var digits = scaled.represent()
    if digits.count() <= places
        digits = zeros_text(n: places + 1u64 - digits.count()) + digits
    var body = digits
    if places > 0u64
        var point = digits.count() - places
        body = digits[0u64 til point] + "." + digits[point til digits.count()]
    if neg
        return "-" + body
    return body

### The exact non-negative value `num / den` rendered with `places` digits after the point, rounded
### half to even.
routine fixed_from_ratio(neg: Bool, num: Integer, den: Integer, places: U64) -> Text
    var scaled = div_round_half_even(n: num.mul(other: pow10_int(k: LLVM::reinterpret_bits[U64, S64](places))), d: den)
    return fixed_from_scaled(neg: neg, scaled: scaled, places: places)

### The exact value m · 2^e2 (m non-negative) with `places` digits after the point.
routine fixed_from_binary(neg: Bool, m: Integer, e2: S64, places: U64) -> Text
    var num = m
    var den = Integer.one()
    if e2 >= 0_s64
        num = num.shl(bits: LLVM::int_truncate[S64, S32](e2))
    else
        den = den.shl(bits: LLVM::int_truncate[S64, S32](0_s64 - e2))
    return fixed_from_ratio(neg: neg, num: num, den: den, places: places)

### Renders a B64 with exactly `places` digits after the point (B16/B32 widen to B64 exactly first).
### Specials: "NaN" / "inf" / "-inf".
routine format_binary_fixed(value: B64, places: U64) -> Text
    if value.is_nan()
        return "NaN"
    if value.is_infinite()
        if value.signbit()
            return "-inf"
        return "inf"
    var raw = value.to_bits()
    var bits = LLVM::bit_and(a: raw, b: 0x7FFFFFFFFFFFFFFFu64)
    var ef = LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 52u64), b: 0x7FFu64)
    var mf = LLVM::bit_and(a: bits, b: 0xFFFFFFFFFFFFFu64)
    var m = mf
    var e2 = -1074_s64
    if LLVM::int_ne(a: ef, b: 0u64)
        m = LLVM::bit_or(a: mf, b: 0x10000000000000u64)
        e2 = LLVM::reinterpret_bits[U64, S64](ef) - 1075_s64
    if m != 0u64
        var (fast, txt) = b128t_fixed_binary(neg: value.signbit(), c: LLVM::zero_extend[U64, U128](m), q: e2, places: places)
        if fast
            return txt
    return fixed_from_binary(neg: value.signbit(), m: Integer(value: m), e2: e2, places: places)

### Renders the raw bits of a B128 with exactly `places` digits after the point.
routine format_b128_fixed(value: B128, places: U64) -> Text
    if value.is_nan()
        return "NaN"
    if value.is_infinite()
        if value.signbit()
            return "-inf"
        return "inf"
    var bits = value.to_bits()
    var ef = LLVM::int_truncate[U128, U64](LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, LLVM::zero_extend[U64, U128](112u64)), b: LLVM::zero_extend[U64, U128](0x7FFFu64)))
    var mf = LLVM::bit_and(a: bits, b: LLVM::sub(a: LLVM::shift_left(LLVM::zero_extend[U64, U128](1u64), LLVM::zero_extend[U64, U128](112u64)), b: LLVM::zero_extend[U64, U128](1u64)))
    var m = mf
    var e2 = -16494_s64
    if LLVM::int_ne(a: ef, b: 0u64)
        m = LLVM::bit_or(a: mf, b: LLVM::shift_left(LLVM::zero_extend[U64, U128](1u64), LLVM::zero_extend[U64, U128](112u64)))
        e2 = LLVM::reinterpret_bits[U64, S64](ef) - 16495_s64
    if m != 0_u128
        var (fast, txt) = b128t_fixed_binary(neg: value.signbit(), c: m, q: e2, places: places)
        if fast
            return txt
    return fixed_from_binary(neg: value.signbit(), m: Integer(from: m), e2: e2, places: places)

### Renders decoded decimal-float parts (c · 10^e) with exactly `places` digits after the point.
### Specials: "NaN" / "sNaN" / "inf" / "-inf".
routine format_decimal_fixed(p: D128Parts, places: U64) -> Text
    if LLVM::int_eq(a: p.special, b: 1_u64)
        return if p.sign then "-inf" else "inf"
    if LLVM::int_eq(a: p.special, b: 3_u64)
        return "sNaN"
    if LLVM::unsigned_ge(a: p.special, b: 2_u64)
        return "NaN"
    var (fast, txt) = decimal_fixed_fast(p: p, places: places)
    if fast
        return txt
    var num = Integer(from: p.coeff)
    var den = Integer.one()
    if p.exp >= 0_s64
        num = num.mul(other: pow10_int(k: p.exp))
    else
        den = pow10_int(k: 0_s64 - p.exp)
    return fixed_from_ratio(neg: p.sign, num: num, den: den, places: places)

### coeff * 10^exp with `places` digits after the point, exactly in U128 arithmetic when the scaled value
### stays below 10^37 (places up to 40), or false.
routine decimal_fixed_fast(p: D128Parts, places: U64) -> (Bool, Text)
    if places > 40_u64
        return (false, "")
    var sh = p.exp +% LLVM::reinterpret_bits[U64, S64](places)
    var n = p.coeff
    if n == 0_u128
        return (true, b128t_fixed_text(neg: p.sign, n: 0_u128, places: places))
    if sh >= 0_s64
        # n * 10^sh must stay below 10^37
        var j = 0_s64
        while j < sh
            if n >= 1000000000000000000000000000000000000_u128
                return (false, "")
            n = n *% 10_u128
            j = j +% 1_s64
    elseif sh > -39_s64
        var d = 1_u128
        var j2 = 0_s64
        while j2 < 0_s64 -% sh
            d = d *% 10_u128
            j2 = j2 +% 1_s64
        var q = n // d
        var r = n -% q *% d
        var twice = r +% r
        if twice > d or (twice == d and (q & 1_u128) == 1_u128)
            q = q +% 1_u128
        n = q
    elseif n >= 10000000000000000000000000000000000000_u128
        return (false, "")
    else
        # the coefficient is below 10^37, so below half a unit of 10^-38 and more: it rounds to 0
        n = 0_u128
    return (true, b128t_fixed_text(neg: p.sign, n: n, places: places))

# ----------------------------------------------------------------------------
# Parsing: decimal text -> nearest binary float (rounded straight to target)
# ----------------------------------------------------------------------------

### Rounds the positive rational num_in/den_in to the nearest binary float of the
### given format (ties to even) and returns the full IEEE 754 bit pattern in the low
### bits of a `U64` (the caller truncates for B32/B16). Every `Integer` stays a local
### here — no aggregate carries a managed value across the routine boundary.
### `fmt` selects the format's field widths: 0 = B64, 1 = B32, 2 = B16.
routine round_and_pack(neg: Bool, num_in: Integer, den_in: Integer, fmt: S32) -> U64
    # Format constants: p = significand bits, min_lsb = smallest representable bit-
    # exponent, emin/emax = unbiased normal-exponent range, bias, mant_bits = p-1,
    # exp_bits = exponent field width. Defaults are B64; narrower formats override.
    var p = 53_s64
    var min_lsb = -1074_s64
    var emin = -1022_s64
    var emax = 1023_s64
    var bias = 1023_s64
    var mant_bits = 52u64
    var exp_bits = 11u64
    if fmt == 1_s32
        p = 24_s64
        min_lsb = -149_s64
        emin = -126_s64
        emax = 127_s64
        bias = 127_s64
        mant_bits = 23u64
        exp_bits = 8u64
    elseif fmt == 2_s32
        p = 11_s64
        min_lsb = -24_s64
        emin = -14_s64
        emax = 15_s64
        bias = 15_s64
        mant_bits = 10u64
        exp_bits = 5u64
    elseif fmt == 3_s32
        p = 8_s64
        min_lsb = -133_s64
        emin = -126_s64
        emax = 127_s64
        bias = 127_s64
        mant_bits = 7u64
        exp_bits = 8u64
    var num = num_in
    var den = den_in
    # Binary exponent of the leading significand bit: 2^ee <= value < 2^(ee+1).
    var ee = (LLVM::reinterpret_bits[U64, S64](num.bit_length()) - LLVM::reinterpret_bits[U64, S64](den.bit_length())) - 1_s64
    while ratio_ge_pow2(num: num, den: den, k: ee + 1_s64)
        ee = ee + 1_s64
    while not ratio_ge_pow2(num: num, den: den, k: ee)
        ee = ee - 1_s64
    var lsb = ee - (p - 1_s64)
    if lsb < min_lsb
        lsb = min_lsb
    var n2 = num
    var d2 = den
    if lsb >= 0_s64
        d2 = den.shl(bits: LLVM::int_truncate[S64, S32](lsb))
    else
        n2 = num.shl(bits: LLVM::int_truncate[S64, S32](0_s64 - lsb))
    var q = div_round_half_even(n: n2, d: d2)
    # A round-up can carry to 2^p; renormalize one bit.
    var pbits = Integer(value: 1u64).shl(bits: LLVM::int_truncate[S64, S32](p))
    if q.cmp(you: pbits) != ME_SMALL
        q = q.shr(bits: 1_s32)
        lsb = lsb + 1_s64
    # Pack the IEEE fields (generic over the format's widths).
    var sign = 0u64
    if neg
        sign = LLVM::shift_left(1u64, LLVM::add(a: mant_bits, b: exp_bits))
    if q.is_zero()
        return sign
    var leading = LLVM::reinterpret_bits[U64, S64](q.bit_length())
    var efinal = lsb + leading - 1_s64
    var exp_all_ones = LLVM::sub(a: LLVM::shift_left(1u64, exp_bits), b: 1u64)
    if efinal > emax
        return LLVM::bit_or(a: sign, b: LLVM::shift_left(exp_all_ones, mant_bits))
    var qbits = U64(from: q)
    var mant_mask = LLVM::sub(a: LLVM::shift_left(1u64, mant_bits), b: 1u64)
    if leading == p and efinal >= emin
        var biased = LLVM::reinterpret_bits[S64, U64](efinal + bias)
        var mant = LLVM::bit_and(a: qbits, b: mant_mask)
        return LLVM::bit_or(a: sign, b: LLVM::bit_or(a: LLVM::shift_left(biased, mant_bits), b: mant))
    return LLVM::bit_or(a: sign, b: qbits)

### Validates a decimal float string and extracts (kind, neg, significand, dec_exp)
### where a finite magnitude equals significand × 10^dec_exp. kind: 0 finite,
### 1 NaN, 2 infinity. Throws {InvalidValueError} on malformed input.
routine parse_float_components(from_text: Text, target: Text) -> FloatParsed
    var len = from_text.count()
    if len == 0u64
        return FloatParsed(kind: 3_s32, is_neg: false, digits: "0", dec_exp: 0_s64)
    var i = 0u64
    var neg = false
    var first = from_text[0u64]
    if first == Character(0x002Bu32) or first == Character(0x002Du32)
        neg = first == Character(0x002Du32)
        i = 1u64
        if i >= len
            return FloatParsed(kind: 3_s32, is_neg: false, digits: "0", dec_exp: 0_s64)
    var rest = len - i
    if rest >= 3u64
        var c0 = from_text[i].to_lowercase()
        var c1 = from_text[i + 1u64].to_lowercase()
        var c2 = from_text[i + 2u64].to_lowercase()
        if rest == 3u64 and c0 == Character(0x006Eu32) and c1 == Character(0x0061u32) and c2 == Character(0x006Eu32)
            return FloatParsed(kind: 1_s32, is_neg: neg, digits: "0", dec_exp: 0_s64)
        if rest == 3u64 and c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
            return FloatParsed(kind: 2_s32, is_neg: neg, digits: "0", dec_exp: 0_s64)
        if rest == 8u64 and c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
            var c3 = from_text[i + 3u64].to_lowercase()
            var c4 = from_text[i + 4u64].to_lowercase()
            var c5 = from_text[i + 5u64].to_lowercase()
            var c6 = from_text[i + 6u64].to_lowercase()
            var c7 = from_text[i + 7u64].to_lowercase()
            if c3 == Character(0x0069u32) and c4 == Character(0x006Eu32) and c5 == Character(0x0069u32) and c6 == Character(0x0074u32) and c7 == Character(0x0079u32)
                return FloatParsed(kind: 2_s32, is_neg: neg, digits: "0", dec_exp: 0_s64)
    var m = Integer.zero()
    var ten = Integer(value: 10u64)
    var frac_digits = 0_s64
    var seen_dot = false
    var has_digit = false
    var has_exp = false
    var exp_val = 0_s64
    var exp_neg = false
    var exp_has_digit = false
    while i < len
        var ch = from_text[i]
        if ch.is_numeric()
            if has_exp
                exp_has_digit = true
                if exp_val < 1000000_s64
                    exp_val = exp_val * 10_s64 + S64(from: ch.digit_value())
            else
                has_digit = true
                m = m.mul(other: ten).add(other: Integer(from: ch.digit_value()))
                if seen_dot
                    frac_digits = frac_digits + 1_s64
        elseif ch == Character(0x002Eu32)
            if seen_dot or has_exp
                return FloatParsed(kind: 3_s32, is_neg: false, digits: "0", dec_exp: 0_s64)
            seen_dot = true
        elseif ch == Character(0x0065u32) or ch == Character(0x0045u32)
            if has_exp or not has_digit
                return FloatParsed(kind: 3_s32, is_neg: false, digits: "0", dec_exp: 0_s64)
            has_exp = true
            if i + 1u64 < len
                var next_ch = from_text[i + 1u64]
                if next_ch == Character(0x002Bu32) or next_ch == Character(0x002Du32)
                    exp_neg = next_ch == Character(0x002Du32)
                    i = i + 1u64
        else
            return FloatParsed(kind: 3_s32, is_neg: false, digits: "0", dec_exp: 0_s64)
        i = i + 1u64
    if not has_digit
        return FloatParsed(kind: 3_s32, is_neg: false, digits: "0", dec_exp: 0_s64)
    if has_exp and not exp_has_digit
        return FloatParsed(kind: 3_s32, is_neg: false, digits: "0", dec_exp: 0_s64)
    var signed_exp = exp_val
    if exp_neg
        signed_exp = 0_s64 - exp_val
    return FloatParsed(kind: 0_s32, is_neg: neg, digits: m.represent(), dec_exp: signed_exp - frac_digits)

# ----------------------------------------------------------------------------
# Per-type entry points: rational -> IEEE 754 bit pattern (via round_and_pack)
# ----------------------------------------------------------------------------

### Rounds significand × 10^dec_exp to the nearest B64.
routine b64_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> B64
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        var z = 0u64
        if neg
            z = 0x8000000000000000u64
        return B64.from_bits(bits: z)
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 320_s64
        var big = 0x7FF0000000000000u64
        if neg
            big = 0xFFF0000000000000u64
        return B64.from_bits(bits: big)
    if mag < -330_s64
        var zz = 0u64
        if neg
            zz = 0x8000000000000000u64
        return B64.from_bits(bits: zz)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0_s64
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0_s64 - dec_exp)
    var bits = round_and_pack(neg: neg, num_in: num, den_in: den, fmt: 0_s32)
    return B64.from_bits(bits: bits)

### Rounds significand × 10^dec_exp to the nearest B32 (single rounding).
routine b32_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> B32
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        var z = 0u32
        if neg
            z = 0x80000000u32
        return B32.from_bits(bits: z)
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 320_s64
        var big = 0x7F800000u32
        if neg
            big = 0xFF800000u32
        return B32.from_bits(bits: big)
    if mag < -330_s64
        var zz = 0u32
        if neg
            zz = 0x80000000u32
        return B32.from_bits(bits: zz)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0_s64
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0_s64 - dec_exp)
    var bits = round_and_pack(neg: neg, num_in: num, den_in: den, fmt: 1_s32)
    return B32.from_bits(bits: LLVM::int_truncate[U64, U32](bits))

### Rounds significand × 10^dec_exp to the nearest B16 (single rounding).
routine b16_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> B16
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        var z = 0u16
        if neg
            z = 0x8000u16
        return B16.from_bits(bits: z)
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 320_s64
        var big = 0x7C00u16
        if neg
            big = 0xFC00u16
        return B16.from_bits(bits: big)
    if mag < -330_s64
        var zz = 0u16
        if neg
            zz = 0x8000u16
        return B16.from_bits(bits: zz)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0_s64
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0_s64 - dec_exp)
    var bits = round_and_pack(neg: neg, num_in: num, den_in: den, fmt: 2_s32)
    return B16.from_bits(bits: LLVM::int_truncate[U64, U16](bits))

### Rounds significand × 10^dec_exp to the nearest BF16 (single rounding, ties to even).
routine bf16_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> BF16
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        var z = 0u16
        if neg
            z = 0x8000u16
        return BF16.from_bits(bits: z)
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 320_s64
        var big = 0x7F80u16
        if neg
            big = 0xFF80u16
        return BF16.from_bits(bits: big)
    if mag < -330_s64
        var zz = 0u16
        if neg
            zz = 0x8000u16
        return BF16.from_bits(bits: zz)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0_s64
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0_s64 - dec_exp)
    var bits = round_and_pack(neg: neg, num_in: num, den_in: den, fmt: 3_s32)
    return BF16.from_bits(bits: LLVM::int_truncate[U64, U16](bits))

### Rounds significand × 10^dec_exp to the nearest B128 (single rounding, ties to even) and packs
### the IEEE 754 binary128 bit pattern: 113 significand bits, normal exponents -16382..16383,
### subnormals down to 2^-16494, overflow to infinity.
routine b128_from_ratio(neg: Bool, digits: Text, dec_exp: S64) -> B128
    var sign = 0u64
    if neg
        sign = 1u64
    var sign_bit = LLVM::shift_left(value: LLVM::zero_extend[U64, U128](sign), bits: 127_u128)
    var m = Integer.from_literal(text: digits)
    if m.is_zero()
        return B128.from_bits(bits: sign_bit)
    # value < 10^mag, so mag bounds the magnitude cheaply before any big power of ten is built.
    var mag = LLVM::reinterpret_bits[U64, S64](m.represent().count()) + dec_exp
    if mag > 4940_s64
        return B128.from_bits(bits: b128_inf(sign: sign))
    if mag < -4970_s64
        return B128.from_bits(bits: sign_bit)
    var num = m
    var den = Integer.one()
    if dec_exp >= 0_s64
        num = m.mul(other: pow10_int(k: dec_exp))
    else
        den = pow10_int(k: 0_s64 - dec_exp)
    # Binary exponent of the leading significand bit: 2^ee <= value < 2^(ee+1).
    var ee = (LLVM::reinterpret_bits[U64, S64](num.bit_length()) - LLVM::reinterpret_bits[U64, S64](den.bit_length())) - 1_s64
    while ratio_ge_pow2(num: num, den: den, k: ee + 1_s64)
        ee = ee + 1_s64
    while not ratio_ge_pow2(num: num, den: den, k: ee)
        ee = ee - 1_s64
    var lsb = ee - 112_s64
    if lsb < -16494_s64
        lsb = -16494_s64
    var n2 = num
    var d2 = den
    if lsb >= 0_s64
        d2 = den.shl(bits: LLVM::int_truncate[S64, S32](lsb))
    else
        n2 = num.shl(bits: LLVM::int_truncate[S64, S32](0_s64 - lsb))
    var q = div_round_half_even(n: n2, d: d2)
    # A round-up can carry to 2^113; renormalize one bit.
    if q.cmp(you: Integer(value: 1u64).shl(bits: 113_s32)) != ME_SMALL
        q = q.shr(bits: 1_s32)
        lsb = lsb + 1_s64
    if q.is_zero()
        return B128.from_bits(bits: sign_bit)
    var leading = LLVM::reinterpret_bits[U64, S64](q.bit_length())
    var efinal = lsb + leading - 1_s64
    if efinal > 16383_s64
        return B128.from_bits(bits: b128_inf(sign: sign))
    var q_hi = q.shr(bits: 64_s32)
    var q_lo = q.sub(other: q_hi.shl(bits: 64_s32))
    var qbits = LLVM::bit_or(a: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](U64(from: q_hi)), bits: 64_u128), b: LLVM::zero_extend[U64, U128](U64(from: q_lo)))
    if leading == 113_s64 and efinal >= -16382_s64
        var biased = LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](efinal + 16383_s64))
        var mant = LLVM::bit_and(a: qbits, b: LLVM::sub(a: LLVM::shift_left(value: 1_u128, bits: 112_u128), b: 1_u128))
        qbits = LLVM::bit_or(a: LLVM::shift_left(value: biased, bits: 112_u128), b: mant)
    return B128.from_bits(bits: LLVM::bit_or(a: sign_bit, b: qbits))
