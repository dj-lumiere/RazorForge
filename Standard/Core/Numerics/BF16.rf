### Returns `me` raised to `exp` with raw IEEE 754 results, correctly rounded; the special cases follow C `pow`.
### :param exp: The exponent.
### :returns: The correctly rounded power.
@readonly
routine BF16.pow_unchecked(exp: BF16) -> BF16
    return BF16.from_bits(bits: C::ingrid_bf16_pow(x: me.to_bits(), y: exp.to_bits()))

### Returns `me` raised to `exp`, correctly rounded. Checked: crashes when the result isn't finite. Use `pow_unchecked` for raw IEEE 754 results.
### :param exp: The exponent.
### :returns: The result.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
@readonly
routine BF16.pow!(exp: BF16) -> BF16
    var r = me.pow_unchecked(exp)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### The angle of the point (x, y) in [-pi, pi], correctly rounded (C `atan2`).
### :param y: The y-coordinate.
### :param x: The x-coordinate.
### :returns: The correctly rounded angle.
routine atan2(y: BF16, x: BF16) -> BF16
    return BF16.from_bits(bits: C::ingrid_bf16_atan2(y: y.to_bits(), x: x.to_bits()))

### The hypotenuse sqrt(x^2 + y^2) with raw IEEE 754 results, correctly rounded.
### :param x: One leg.
### :param y: The other leg.
### :returns: The correctly rounded hypotenuse.
routine hypot_unchecked(x: BF16, y: BF16) -> BF16
    return BF16.from_bits(bits: C::ingrid_bf16_hypot(x: x.to_bits(), y: y.to_bits()))

### The hypotenuse sqrt(x^2 + y^2), correctly rounded. Checked: crashes when the result isn't finite.
### :param x: One leg.
### :param y: The other leg.
### :returns: The correctly rounded hypotenuse.
### :throws: {NumericDomainError} when there is no real result.
### :throws: {NumericOverflowError} when the result is out of range.
routine hypot!(x: BF16, y: BF16) -> BF16
    var r = hypot_unchecked(x: x, y: y)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")
