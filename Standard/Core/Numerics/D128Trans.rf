### sqrt(me). Crashes: NumericDomainError for me < 0.
routine D128.sqrt!() -> D128
    var r = me.sqrt_unchecked()
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### sqrt(me), correctly rounded (d128_sqrt_exact), raw IEEE: NaN for me < 0, sqrt(-0) = -0.
routine D128.sqrt_unchecked() -> D128
    var p = me.decode()
    if p.special >= 2_u64
        return D128.quiet_nan()
    if p.coeff == 0_u128 and p.special == 0_u64
        return me
    if p.sign
        return D128.quiet_nan()
    if p.special == 1_u64
        return me
    return d128_sqrt_exact(c: p.coeff, q: p.exp)

### The real cube root, correctly rounded (d128_cbrt_exact). Finite-preserving.
routine D128.cbrt() -> D128
    var p = me.decode()
    if p.special >= 2_u64
        return D128.quiet_nan()
    if p.special == 1_u64 or p.coeff == 0_u128
        return me
    var r = d128_cbrt_exact(c: p.coeff, q: p.exp)
    if p.sign
        return d128_neg(a: r)
    return r

### `me^you` with raw IEEE (the full C99 pow special-case ladder). The general case is exp(you ln|me|) on
### the 384-bit tier when the fast path leaves the rounding open, the sign of an odd-integer exponent
### reapplied.
routine D128.pow_unchecked(you: D128) -> D128
    var (fast, v) = d128_pow_fast(x: me, y: you)
    if fast
        return v
    var (done, d, w) = d128_pow_w(x: me, y: you)
    if done
        return d
    return wx_d128(w: w)

### x^y past the fast path: the C99 special cases as (true, the result), else (false, x, e^(y ln|x|) on the
### 384-bit tier, negated for a negative x and an odd integer y).
secret routine d128_pow_w(x: D128, y: D128) -> (Bool, D128, B128Wx)
    var mp = x.decode()
    var yp = y.decode()
    var one = d128_lit(c: 1_u128, q: 0_s64)
    var negone = d128_neg(a: one)
    var poszero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
    var negzero = D128.from_components(sign: true, coeff: 0_u128, exp: 0_s64)
    var posinf = D128.infinity(sign: false)
    var neginf = D128.infinity(sign: true)
    var nan = D128.quiet_nan()
    var menan = mp.special >= 2_u64
    var younan = yp.special >= 2_u64
    var meinf = mp.special == 1_u64
    var youinf = yp.special == 1_u64
    var mezero = not menan and not meinf and mp.coeff == 0_u128
    var youzero = not younan and not youinf and yp.coeff == 0_u128
    var youfin = not younan and not youinf
    var yisint = youfin and d128_is_int(p: yp)
    var yisoddint = yisint and d128_int_odd(p: yp)
    if mp.sign and not menan and not meinf and not mezero and youfin and not yisint
        return (true, nan, wx_zero(rel: 0.0))
    if (not menan and x == one) or youzero
        return (true, one, wx_zero(rel: 0.0))
    if menan or younan
        return (true, nan, wx_zero(rel: 0.0))
    if not yp.sign and not youzero and mezero and yisoddint
        return (true, x, wx_zero(rel: 0.0))
    if mezero and not yp.sign and not youzero and not yisoddint
        return (true, poszero, wx_zero(rel: 0.0))
    if youinf and x == negone
        return (true, one, wx_zero(rel: 0.0))
    var absxlt1 = not meinf and negone < x and x < one
    var absxgt1 = meinf or x < negone or one < x
    if youinf and yp.sign and absxlt1
        return (true, posinf, wx_zero(rel: 0.0))
    if youinf and yp.sign and absxgt1
        return (true, poszero, wx_zero(rel: 0.0))
    if youinf and not yp.sign and absxlt1
        return (true, poszero, wx_zero(rel: 0.0))
    if youinf and not yp.sign and absxgt1
        return (true, posinf, wx_zero(rel: 0.0))
    if meinf and mp.sign and yp.sign and yisoddint
        return (true, negzero, wx_zero(rel: 0.0))
    if meinf and mp.sign and yp.sign and not yisoddint
        return (true, poszero, wx_zero(rel: 0.0))
    if meinf and mp.sign and not yp.sign and yisoddint
        return (true, neginf, wx_zero(rel: 0.0))
    if meinf and mp.sign and not yp.sign and not yisoddint
        return (true, posinf, wx_zero(rel: 0.0))
    if meinf and yp.sign
        return (true, poszero, wx_zero(rel: 0.0))
    if meinf
        return (true, posinf, wx_zero(rel: 0.0))
    if mezero and yisoddint and yp.sign
        return (true, D128.infinity(sign: mp.sign), wx_zero(rel: 0.0))
    if mezero and yp.sign
        return (true, posinf, wx_zero(rel: 0.0))
    # |x|^y = e^z with z = y ln|x|; far past the range the result is infinite or zero
    var z = wx_mul(a: wx_of_d128(p: yp), b: d128_wide_log(x: x.abs()))
    var zb = wx_b64(w: z)
    var rneg = mp.sign and yisoddint
    if zb > 15000.0
        return (true, D128.infinity(sign: rneg), wx_zero(rel: 0.0))
    if zb <= -15000.0
        return (
            true, D128.from_components(sign: rneg, coeff: 0_u128, exp: 0_s64), wx_zero(rel: 0.0),
        )
    var r = wx_exp(x: z)
    if rneg
        r = wx_neg(w: r)
    return (false, x, r)

### hypot(x, y) = sqrt(x^2 + y^2), no spurious overflow. Crashes on a non-finite result.
routine hypot!(x: D128, y: D128) -> D128
    var r = hypot_unchecked(x: x, y: y)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### sqrt(x^2 + y^2), correctly rounded (d128_hypot_exact), raw IEEE (any inf -> +inf, else NaN propagates).
routine hypot_unchecked(x: D128, y: D128) -> D128
    var px = x.decode()
    var py = y.decode()
    if px.special == 1_u64 or py.special == 1_u64
        return D128.infinity(sign: false)
    if px.special >= 2_u64 or py.special >= 2_u64
        return D128.quiet_nan()
    return d128_hypot_exact(
        x: px,
        y: py,
        z: D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64).decode(),
    )

### hypot(x, y, z) = sqrt(x^2 + y^2 + z^2), no spurious overflow. Crashes on a non-finite result.
routine hypot!(x: D128, y: D128, z: D128) -> D128
    var r = hypot_unchecked(x: x, y: y, z: z)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### sqrt(x^2 + y^2 + z^2), correctly rounded (d128_hypot_exact), raw IEEE.
routine hypot_unchecked(x: D128, y: D128, z: D128) -> D128
    var px = x.decode()
    var py = y.decode()
    var pz = z.decode()
    if px.special == 1_u64 or py.special == 1_u64 or pz.special == 1_u64
        return D128.infinity(sign: false)
    if px.special >= 2_u64 or py.special >= 2_u64 or pz.special >= 2_u64
        return D128.quiet_nan()
    return d128_hypot_exact(x: px, y: py, z: pz)

### Fused multiply-add me*b + c with a single rounding. Crashes on a non-finite result.
routine D128.fma!(b: D128, c: D128) -> D128
    var r = me.fma_unchecked(b: b, c: c)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### me*b + c with a single rounding (d128_fma_exact), raw IEEE.
routine D128.fma_unchecked(b: D128, c: D128) -> D128
    var pa = me.decode()
    var pb = b.decode()
    var pc = c.decode()
    if pa.special >= 2_u64 or pb.special >= 2_u64 or pc.special >= 2_u64
        return D128.quiet_nan()
    var pneg = pa.sign != pb.sign
    if pa.special == 1_u64 or pb.special == 1_u64
        if (pa.special == 0_u64 and pa.coeff == 0_u128)
            or (pb.special == 0_u64 and pb.coeff == 0_u128)
            return D128.quiet_nan()
        if pc.special == 1_u64 and pc.sign != pneg
            return D128.quiet_nan()
        return D128.infinity(sign: pneg)
    if pc.special == 1_u64
        return c
    return d128_fma_exact(a: pa, b: pb, c: pc)

### asin(me). Crashes: NumericDomainError for |me| > 1.
routine D128.asin!() -> D128
    var r = me.asin_unchecked()
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### asin(me), raw IEEE (NaN for |me| > 1).
routine D128.asin_unchecked() -> D128
    var (fast, v) = d128_arctrig_fast(x: me, which: 0_u64)
    if fast
        return v
    return d128_wide(x: me, which: 8_u64)

### acos(me). Crashes: NumericDomainError for |me| > 1.
routine D128.acos!() -> D128
    var r = me.acos_unchecked()
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### acos(me), raw IEEE (NaN for |me| > 1).
routine D128.acos_unchecked() -> D128
    var (fast, v) = d128_arctrig_fast(x: me, which: 1_u64)
    if fast
        return v
    return d128_wide(x: me, which: 9_u64)

### atan(me). Finite-preserving (atan(±inf) = ±pi/2).
routine D128.atan() -> D128
    var (fast, v) = d128_arctrig_fast(x: me, which: 2_u64)
    if fast
        return v
    return d128_wide(x: me, which: 10_u64)

### atan2(y, x), the angle of (x, y) in (-pi, pi], with the C99 special cases for zeros and infinities.
routine atan2(y: D128, x: D128) -> D128
    var (fast, v) = d128_atan2_fast(y: y, x: x)
    if fast
        return v
    var (done, d, w) = d128_atan2_w(y: y, x: x)
    if done
        return d
    return wx_d128(w: w)

### atan2(y, x) past the fast path: NaN and a zero result as (true, the result), else (false, x, the angle on the
### 384-bit tier).
secret routine d128_atan2_w(y: D128, x: D128) -> (Bool, D128, B128Wx)
    var py = y.decode()
    var px = x.decode()
    if py.special >= 2_u64 or px.special >= 2_u64
        return (true, D128.quiet_nan(), wx_zero(rel: 0.0))
    var yzero = py.special == 0_u64 and py.coeff == 0_u128
    var xzero = px.special == 0_u64 and px.coeff == 0_u128
    var r = wx_zero(rel: 0.0)
    if yzero
        if px.sign
            r = wx_table(i: 1_u64)
    elseif xzero
        r = wx_table(i: 9_u64)
    elseif py.special == 1_u64
        r = wx_table(i: 9_u64)
        if px.special == 1_u64
            r = wx_scale(w: wx_table(i: 1_u64), k: -2_s64)
            if px.sign
                r = wx_mul(a: r, b: wx_of_u128(v: 3_u128))
    elseif px.special == 1_u64
        if px.sign
            r = wx_table(i: 1_u64)
    else
        r = wx_atan2(y: wx_of_d128(p: py), x: wx_of_d128(p: px))
    if py.sign
        r = wx_neg(w: wx_abs(w: r))
    if wx_is_zero(w: r)
        return (
            true, D128.from_components(sign: py.sign, coeff: 0_u128, exp: 0_s64), wx_zero(rel: 0.0),
        )
    return (false, x, r)

