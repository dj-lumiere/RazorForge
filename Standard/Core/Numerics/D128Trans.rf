module Core

# ============================================================================
# D128Trans — decimal128 (Pmax=34) transcendentals and libm surface.
# Each transcendental first tries its fast path (D128Fast.rf: CORE-MATH fast phases with proven error
# bounds, kept only when the band rounds to one D128). The inputs whose band reaches a decimal rounding
# midpoint go to the 384-bit tier (B128Wx.rf): the argument becomes a 384-bit value (exactly when it is an
# integer below 2^384 or a binary fraction), the differences that cancel (x - 1, 1 - |x|, x minus the
# nearest integer) are taken exactly in decimal first, and the result is rounded to 34 digits once.
# sqrt, cbrt, hypot and fma are exact integer computations with one rounding.
# ============================================================================

### A D128 as a D128 of the literal c * 10^q.
@inline
secret routine d128_lit(c: U128, q: S64) -> D128
    return D128.from_components(sign: false, coeff: c, exp: q)

### Whether a finite D128 is an integer.
secret routine d128_is_int(p: D128Parts) -> Bool
    if p.coeff == 0_u128 or p.exp >= 0_s64
        return true
    if p.exp < -38_s64
        return false
    var d = LLVM::int_truncate[U256, U128](pow10b(k: 0_s64 -% p.exp))
    return p.coeff % d == 0_u128

### Whether a finite D128 integer is odd.
secret routine d128_int_odd(p: D128Parts) -> Bool
    if p.coeff == 0_u128 or p.exp > 0_s64
        return false
    if p.exp < -38_s64
        return false
    return (div_pow10_u128(x: p.coeff, k: 0_s64 -% p.exp) & 1_u128) == 1_u128

### ln(x) of a finite positive D128 on the tier: within 1/4 of 1 as log1p(x - 1) with x - 1 exact in decimal
### (its coefficient needs no more digits than x's).
secret routine d128_wide_log(x: D128) -> B128Wx
    if x >= d128_lit(c: 75_u128, q: -2_s64) and x <= d128_lit(c: 125_u128, q: -2_s64)
        return wx_log1p(t: wx_of_d128(p: d128_sub(a: x, b: d128_lit(c: 1_u128, q: 0_s64)).decode()))
    return wx_log(x: wx_of_d128(p: x.decode()))

### 1 - |x| for a finite D128 with |x| <= 1 on the tier: exact in decimal from |x| = 1/2 on (the coefficient
### of the difference is no longer than x's), else on the tier (no cancellation there).
secret routine d128_wide_omx(x: D128) -> B128Wx
    var ax = x.abs()
    if ax >= d128_lit(c: 5_u128, q: -1_s64)
        return wx_of_d128(p: d128_sub(a: d128_lit(c: 1_u128, q: 0_s64), b: ax).decode())
    return wx_sub(a: wx_one(), b: wx_abs(w: wx_of_d128(p: x.decode())))

### f(x) on the 384-bit tier for a D128 whose fast path left the rounding open: 0 exp, 1 expm1, 2 exp2,
### 3 exp10, 4 log, 5 log1p, 6 log2, 7 log10, 8 asin, 9 acos, 10 atan, 11 sinh, 12 cosh, 13 tanh, 14 asinh,
### 15 acosh, 16 atanh, 17 erf, 18 erfc, 19 tgamma, 20 lgamma. Special values, and arguments whose result the
### range alone settles, are handled first: they come back as (true, the D128 result), every other argument as
### (false, x, the 384-bit value) for the caller to round.
secret routine d128_wide_w(x: D128, which: U64) -> (Bool, D128, B128Wx)
    var p = x.decode()
    var nan = D128.quiet_nan()
    if p.special >= 2_u64
        return (true, nan, wx_zero(rel: 0.0))
    var neg = p.sign
    var inf = p.special == 1_u64
    var zero = not inf and p.coeff == 0_u128
    var one = d128_lit(c: 1_u128, q: 0_s64)
    var signed_one = one
    if neg
        signed_one = d128_neg(a: one)
    var posinf = D128.infinity(sign: false)
    var neginf = D128.infinity(sign: true)
    var pzero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
    var ax = x.abs()
    var w = wx_zero(rel: 0.0)
    if not inf
        w = wx_of_d128(p: p)
    var r = w
    if which <= 3_u64
        # exp, expm1, exp2, exp10
        if zero
            if which == 1_u64
                return (true, x, wx_zero(rel: 0.0))
            return (true, one, wx_zero(rel: 0.0))
        var big = d128_lit(c: 15000_u128, q: 0_s64)
        if which == 2_u64
            big = d128_lit(c: 22000_u128, q: 0_s64)
        elseif which == 3_u64
            big = d128_lit(c: 6300_u128, q: 0_s64)
        if inf or ax > big
            if not neg
                return (true, posinf, wx_zero(rel: 0.0))
            if which == 1_u64
                return (true, signed_one, wx_zero(rel: 0.0))
            return (true, pzero, wx_zero(rel: 0.0))
        if which == 1_u64
            if neg and ax > d128_lit(c: 100_u128, q: 0_s64)
                return (true, signed_one, wx_zero(rel: 0.0))
            return (false, x, wx_expm1(x: w))
        if which == 2_u64
            w = wx_mul(a: w, b: wx_table(i: 0_u64))
        elseif which == 3_u64
            w = wx_mul(a: w, b: wx_div(a: wx_one(), b: wx_table(i: 4_u64)))
        return (false, x, wx_exp(x: w))
    if which <= 7_u64
        # log, log1p, log2, log10
        if which == 5_u64
            if x < d128_sub(a: pzero, b: one)
                return (true, nan, wx_zero(rel: 0.0))
            if x == d128_sub(a: pzero, b: one)
                return (true, neginf, wx_zero(rel: 0.0))
            if zero or (inf and not neg)
                return (true, x, wx_zero(rel: 0.0))
            if x < d128_lit(c: 5_u128, q: -1_s64).neg()
                return (false, x, wx_log(x: wx_of_d128(p: d128_add(a: one, b: x).decode())))
            return (false, x, wx_log1p(t: w))
        if neg and not zero
            return (true, nan, wx_zero(rel: 0.0))
        if zero
            return (true, neginf, wx_zero(rel: 0.0))
        if inf
            return (true, x, wx_zero(rel: 0.0))
        var l = d128_wide_log(x: x)
        if which == 6_u64
            l = wx_mul(a: l, b: wx_table(i: 3_u64))
        elseif which == 7_u64
            l = wx_mul(a: l, b: wx_table(i: 4_u64))
        return (false, x, l)
    if which <= 10_u64
        # asin, acos, atan
        if which == 10_u64
            if zero
                return (true, x, wx_zero(rel: 0.0))
            if inf
                r = wx_table(i: 9_u64)
                if neg
                    r = wx_neg(w: r)
                return (false, x, r)
            return (false, x, wx_atan(z: w))
        if inf or ax > one
            return (true, nan, wx_zero(rel: 0.0))
        if which == 8_u64
            if zero
                return (true, x, wx_zero(rel: 0.0))
            return (false, x, wx_asin(x: w, omx: d128_wide_omx(x: x)))
        return (false, x, wx_acos(x: w, omx: d128_wide_omx(x: x)))
    if which <= 16_u64
        # sinh, cosh, tanh, asinh, acosh, atanh
        if which == 11_u64
            if zero or inf
                return (true, x, wx_zero(rel: 0.0))
            if ax > d128_lit(c: 15000_u128, q: 0_s64)
                return (true, D128.infinity(sign: neg), wx_zero(rel: 0.0))
            return (false, x, wx_sinh(x: w))
        if which == 12_u64
            if inf or ax > d128_lit(c: 15000_u128, q: 0_s64)
                return (true, posinf, wx_zero(rel: 0.0))
            return (false, x, wx_cosh(x: w))
        if which == 13_u64
            if zero
                return (true, x, wx_zero(rel: 0.0))
            if inf or ax > d128_lit(c: 100_u128, q: 0_s64)
                return (true, signed_one, wx_zero(rel: 0.0))
            return (false, x, wx_tanh(x: w))
        if which == 14_u64
            if zero or inf
                return (true, x, wx_zero(rel: 0.0))
            return (false, x, wx_asinh(x: w))
        if which == 15_u64
            if x < one
                return (true, nan, wx_zero(rel: 0.0))
            if inf
                return (true, x, wx_zero(rel: 0.0))
            var t = wx_sub(a: w, b: wx_one())
            if x < d128_lit(c: 2_u128, q: 0_s64)
                t = wx_of_d128(p: d128_sub(a: x, b: one).decode())
            return (false, x, wx_acosh(t: t))
        if inf or ax > one
            return (true, nan, wx_zero(rel: 0.0))
        if ax == one
            return (true, D128.infinity(sign: neg), wx_zero(rel: 0.0))
        if zero
            return (true, x, wx_zero(rel: 0.0))
        return (false, x, wx_atanh(x: w, omx: d128_wide_omx(x: x)))
    if which <= 18_u64
        # erf, erfc
        var twenty = d128_lit(c: 20_u128, q: 0_s64)
        if which == 17_u64
            if zero
                return (true, x, wx_zero(rel: 0.0))
            if inf or ax > twenty
                return (true, signed_one, wx_zero(rel: 0.0))
            return (false, x, wx_erf(x: w, complement: false))
        if neg and (inf or ax > twenty)
            return (true, d128_lit(c: 2_u128, q: 0_s64), wx_zero(rel: 0.0))
        if inf or x > d128_lit(c: 130_u128, q: 0_s64)
            return (true, pzero, wx_zero(rel: 0.0))
        return (false, x, wx_erf(x: w, complement: true))
    # tgamma (19) and lgamma (20)
    if inf
        if which == 19_u64 and neg
            return (true, nan, wx_zero(rel: 0.0))
        return (true, posinf, wx_zero(rel: 0.0))
    if zero
        if which == 19_u64
            return (true, D128.infinity(sign: neg), wx_zero(rel: 0.0))
        return (true, posinf, wx_zero(rel: 0.0))
    if neg and d128_is_int(p: p)
        if which == 19_u64
            return (true, nan, wx_zero(rel: 0.0))
        return (true, posinf, wx_zero(rel: 0.0))
    var k = x.round()
    var rd = d128_sub(a: x, b: k)
    var k_odd = d128_int_odd(p: k.decode())
    if which == 19_u64
        if x > d128_lit(c: 3300_u128, q: 0_s64)
            return (true, posinf, wx_zero(rel: 0.0))
        if x < d128_lit(c: 3300_u128, q: 0_s64).neg()
            # |Gamma| underflows; its sign is that of sin(pi x) = (-1)^k sin(pi r)
            return (
                true,
                D128.from_components(sign: rd.decode().sign != k_odd, coeff: 0_u128, exp: 0_s64),
                wx_zero(rel: 0.0),
            )
        return (false, x, wx_tgamma(x: w, k_odd: k_odd, r: wx_of_d128(p: rd.decode())))
    return (false, x, wx_lgamma(x: w, k_odd: k_odd, r: wx_of_d128(p: rd.decode())).item0)

### f(x) on the 384-bit tier (d128_wide_w) rounded to 34 digits.
secret routine d128_wide(x: D128, which: U64) -> D128
    var (done, d, w) = d128_wide_w(x: x, which: which)
    if done
        return d
    return wx_d128(w: w)

# ============================================================================
# Exact integer sqrt, cbrt, hypot and fma
# ============================================================================

### sqrt(c * 10^q) for a finite positive D128, to 34 digits exactly: C = c * 10^t with q - t even and C of 67
### or 68 digits has an integer square root s of 34 digits (below 2^113). s starts from the B128 square root of C's
### truncation (a few units off at most) and is settled by s^2 <= C < (s + 1)^2 with 128 x 128-bit products; the
### root lies above s + 1/2 exactly when (2s + 1)^2 < 4C, that is when C - s^2 > s.
secret routine d128_sqrt_exact(c: U128, q: S64) -> D128
    var t = 67_s64 -% digits10_u128(c: c)
    if (q -% t & 1_s64) != 0_s64
        t = t +% 1_s64
    var cc = cwb(c: c) *% pow10b(k: t)
    var sc = LLVM::int_truncate[U256, U128](b128_floor_u256(v: b128_of_u256_trunc(n: cc).sqrt_unchecked()))
    var sq = d128_square256(s: sc)
    while sq > cc
        sc = sc -% 1_u128
        sq = d128_square256(s: sc)
    # (s + 1)^2 = s^2 + 2s + 1
    var step = (LLVM::zero_extend[U128, U256](sc) << 1_u32) +% 1_u256
    while sq +% step <= cc
        sq = sq +% step
        sc = sc +% 1_u128
        step = step +% 2_u256
    if cc -% sq > LLVM::zero_extend[U128, U256](sc)
        sc = sc +% 1_u128
    var ex = q -% t >> 1
    if sc == 10000000000000000000000000000000000_u128
        sc = 1000000000000000000000000000000000_u128
        ex = ex +% 1_s64
    return wx_d128_pack(neg: false, c: sc, q: ex, inf: false)

### s^2 for a 128-bit s, as a U256 (exact).
@inline
secret routine d128_square256(s: U128) -> U256
    var p = b128_trig_wmul(x: s, y: s)
    return (LLVM::zero_extend[U128, U256](p.item0) << 128_u32) | LLVM::zero_extend[U128, U256](p.item1)

### a * b of a 256-bit a and b, the low 384 bits (exact when the product fits).
secret routine d128_mul256(a: U256, b: U256) -> (U128, U128, U128)
    var a1 = LLVM::int_truncate[U256, U128](a >>> 128_u32)
    var b1 = LLVM::int_truncate[U256, U128](b >>> 128_u32)
    var low = wx_product_t(c: LLVM::int_truncate[U256, U128](a), p: b)
    var high = wx_product_t(
        c: a1,
        p: LLVM::zero_extend[U128, U256](LLVM::int_truncate[U256, U128](b)),
    )
    var top = a1 *% b1
    return b128_trig_add384(a: low, b: (0_u128, high.item0, high.item1 +% top))

### cbrt(c * 10^q) for a finite positive D128, to 34 digits exactly: C = c * 10^t with q - t divisible by 3
### and C of 100 to 102 digits (exact in 384 bits) has an integer cube root s of 34 digits, from the B128 cube
### root of C (within 2 units) settled by s^3 <= C < (s + 1)^3, and (2s + 1)^3 against 8C (odd against
### even) says whether the root lies above s + 1/2.
secret routine d128_cbrt_exact(c: U128, q: S64) -> D128
    var t = 100_s64 -% digits10_u128(c: c)
    while (q -% t) % 3_s64 != 0_s64
        t = t +% 1_s64
    # C = (c 10^38) 10^(t - 38), t in 66..103
    var cbig = d128_mul256(a: cwb(c: c) *% pow10b(k: 38_s64), b: pow10b(k: t -% 38_s64))
    var s0 = wx_b128(w: wx_make(neg: false, t: cbig, e: 0_s64, rel: 0.0)).cbrt()
    var sb = s0.to_bits()
    var se = LLVM::int_truncate[U128, S64](sb >>> 112_u32) -% 16383_s64
    var s = (sb & (1_u128 << 112_u32) -% 1_u128 | (1_u128 << 112_u32)) >>> b128_trig_sh(n: 112_s64 -% se)
    # s^3 <= C < (s + 1)^3
    var tries = 0_s64
    while tries < 4_s64
        var cube = wx_product_t(c: s, p: d128_wmul256(x: s, y: s))
        if wx_t_gt(a: cube, b: cbig)
            s = s -% 1_u128
        else
            var s1 = s +% 1_u128
            var cube1 = wx_product_t(c: s1, p: d128_wmul256(x: s1, y: s1))
            if wx_t_gt(a: cube1, b: cbig)
                break
            s = s1
        tries = tries +% 1_s64
    var m = s *% 2_u128 +% 1_u128
    var mc = wx_product_t(c: m, p: d128_wmul256(x: m, y: m))
    if wx_t_gt(a: b128_trig_shl384(x: cbig, shift: 3_s64), b: mc)
        s = s +% 1_u128
    var ex = (q -% t) // 3_s64
    if s == 10000000000000000000000000000000000_u128
        s = 1000000000000000000000000000000000_u128
        ex = ex +% 1_s64
    return wx_d128_pack(neg: false, c: s, q: ex, inf: false)

### x * y as a U256 (x, y below 2^128).
@inline
secret routine d128_wmul256(x: U128, y: U128) -> U256
    var p = b128_trig_wmul(x: x, y: y)
    return (LLVM::zero_extend[U128, U256](p.item0) << 128_u32) | LLVM::zero_extend[U128, U256](p.item1)

### sqrt(x^2 + y^2 + z^2) for finite D128 parts, exactly up to a sticky digit: the squares c^2 10^(2q) scaled to a
### common even exponent B where the largest has `lead` or lead + 1 digits (the smaller ones floored, a sticky bit
### for what drops), the integer square root s of their sum (the remainder into the sticky bit), and s 10 + sticky
### with its exponent, for a rounding to fewer digits than s has (the appended digit breaks a tie only when the
### root is inexact). (true, ...) when every leg is zero.
secret routine d128_hypot_core(
    x: D128Parts,
    y: D128Parts,
    z: D128Parts,
    lead: S64,
) -> (Bool, U256, S64)
    var parts = (x, y, z)
    var top = -30000_s64
    var i = 0_s64
    while i < 3_s64
        var pp = parts.item0
        if i == 1_s64
            pp = parts.item1
        elseif i == 2_s64
            pp = parts.item2
        if pp.coeff != 0_u128
            var sq_top = 2_s64 *% pp.exp +% digits10b(c: cwb(c: pp.coeff) *% cwb(c: pp.coeff))
            if sq_top > top
                top = sq_top
        i = i +% 1_s64
    if top == -30000_s64
        return (true, 0_u256, 0_s64)
    var b = top -% lead
    if (b & 1_s64) != 0_s64
        b = b -% 1_s64
    var sum = 0_u256
    var sticky = false
    i = 0_s64
    while i < 3_s64
        var pp = parts.item0
        if i == 1_s64
            pp = parts.item1
        elseif i == 2_s64
            pp = parts.item2
        if pp.coeff != 0_u128
            var sq = cwb(c: pp.coeff) *% cwb(c: pp.coeff)
            var sh = 2_s64 *% pp.exp -% b
            if sh >= 0_s64
                sum = sum +% sq *% pow10b(k: sh)
            elseif sh >= -76_s64
                var qv = div_pow10b(x: sq, k: 0_s64 -% sh)
                if qv *% pow10b(k: 0_s64 -% sh) != sq
                    sticky = true
                sum = sum +% qv
            else
                sticky = true
        i = i +% 1_s64
    var s = b128_isqrt256(n: sum)
    if s *% s != sum
        sticky = true
    var coeff = s *% 10_u256
    if sticky
        coeff = coeff +% 1_u256
    return (false, coeff, (b >> 1) -% 1_s64)

### sqrt(x^2 + y^2 + z^2) for finite D128s, correctly rounded to 34 digits (d128_hypot_core with 70-digit squares).
secret routine d128_hypot_exact(x: D128Parts, y: D128Parts, z: D128Parts) -> D128
    var (zero, coeff, ex) = d128_hypot_core(x: x, y: y, z: z, lead: 70_s64)
    if zero
        return D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
    return d128_of_parts(p: decfinB(sign: false, coeff: coeff, exp: ex, pref: 6111_s64))

### a * b + c for finite D128 parts, exactly up to a sticky digit, as (sign, coefficient, exponent, preferred
### exponent) for one rounding (the preferred exponent the smaller of the product's and c's): the addend with
### the larger exponent is scaled up to the other's exponent while it stays within 75 digits; past that it is
### scaled to 75 digits and the other one is floored to that exponent, what drops becoming a sticky digit
### appended below (a subtraction then takes one unit off first, the true value lying strictly between).
@inline
secret routine d128_fma_core(a: D128Parts, b: D128Parts, c: D128Parts) -> (Bool, U256, S64, S64)
    var pneg = a.sign != b.sign
    var pc = cwb(c: a.coeff) *% cwb(c: b.coeff)
    var pe = a.exp +% b.exp
    var cc = cwb(c: c.coeff)
    if pc == 0_u256 and cc == 0_u256
        # (+0) + (+0) and (-0) + (-0) keep their sign, mixed signs give +0
        var zs = pneg and c.sign
        var ze = pe
        if c.exp < ze
            ze = c.exp
        return (zs, 0_u256, ze, ze)
    if cc == 0_u256
        return (pneg, pc, pe, pe)
    if pc == 0_u256
        return (c.sign, cc, c.exp, c.exp)
    # h: the addend with the larger exponent, l: the other
    var hc = pc
    var he = pe
    var hs = pneg
    var lc = cc
    var le = c.exp
    var ls = c.sign
    if c.exp > pe
        hc = cc
        he = c.exp
        hs = c.sign
        lc = pc
        le = pe
        ls = pneg
    var shift = he -% le
    var pref = le
    var hd = digits10b(c: hc)
    var sticky = false
    var ew = le
    if hd +% shift <= 75_s64
        hc = hc *% pow10b(k: shift)
    else
        var k = 75_s64 -% hd
        hc = hc *% pow10b(k: k)
        ew = he -% k
        var drop = shift -% k
        if drop > 76_s64
            sticky = lc != 0_u256
            lc = 0_u256
        else
            var ql = div_pow10b(x: lc, k: drop)
            sticky = ql *% pow10b(k: drop) != lc
            lc = ql
    var rc = 0_u256
    var rs = hs
    if hs == ls
        rc = hc +% lc
    elseif hc >= lc
        rc = hc -% lc
        if sticky
            rc = rc -% 1_u256
    else
        rc = lc -% hc
        rs = ls
        if sticky
            rc = rc -% 1_u256
    if rc == 0_u256 and not sticky
        return (false, 0_u256, ew, pref)
    if sticky
        return (rs, rc *% 10_u256 +% 1_u256, ew -% 1_s64, pref)
    return (rs, rc, ew, pref)

### a * b + c for finite D128s, rounded once to 34 digits (d128_fma_core).
secret routine d128_fma_exact(a: D128Parts, b: D128Parts, c: D128Parts) -> D128
    var (sign, coeff, ex, pref) = d128_fma_core(a: a, b: b, c: c)
    return d128_of_parts(p: decfinB(sign: sign, coeff: coeff, exp: ex, pref: pref))

# ============================================================================
# Transcendentals. The bare `op()` is CHECKED (crashes if the result is non-finite — domain/overflow);
# `op_unchecked()` propagates inf/NaN. Finite-preserving ops (cbrt, atan/atan2, tanh, asinh, erf) need no split.
# ============================================================================

### e^me. Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.exp!() -> D128
    var r = me.exp_unchecked()
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### e^me, raw IEEE (+inf on overflow, NaN propagates).
routine D128.exp_unchecked() -> D128
    var (fast, v) = d128_exp_fast(x: me)
    if fast
        return v
    return d128_wide(x: me, which: 0_u64)

### e^me - 1 (accurate near 0). Crashes on a non-finite result.
routine D128.expm1!() -> D128
    var r = me.expm1_unchecked()
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

