module Core

# The amount of a shift and the index of a subscript may be any integer: the builder turns one of another type into
# the type the routine takes with these. Both are counts, so a negative one crashes, and one too large for the type
# becomes its largest value, which is still past every width and every end.

### This value as an index: the same count as a `U64`, or `U64_MAX` when it is larger.
### :returns: The count as a `U64`.
### :throws: {NumericDomainError} when this value is below 0.
routine S8.to_index!() -> U64
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and an index counts from 0")
    return LLVM::zero_extend[S8, U64](me)

### This value as a shift amount: the same count as a `U32`, or `U32_MAX` when it is larger.
### :returns: The count as a `U32`.
### :throws: {NumericDomainError} when this value is below 0.
routine S8.to_shift_amount!() -> U32
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and a shift amount counts from 0")
    return LLVM::zero_extend[S8, U32](me)

### This value as an index: the same count as a `U64`, or `U64_MAX` when it is larger.
### :returns: The count as a `U64`.
### :throws: {NumericDomainError} when this value is below 0.
routine S16.to_index!() -> U64
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and an index counts from 0")
    return LLVM::zero_extend[S16, U64](me)

### This value as a shift amount: the same count as a `U32`, or `U32_MAX` when it is larger.
### :returns: The count as a `U32`.
### :throws: {NumericDomainError} when this value is below 0.
routine S16.to_shift_amount!() -> U32
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and a shift amount counts from 0")
    return LLVM::zero_extend[S16, U32](me)

### This value as an index: the same count as a `U64`, or `U64_MAX` when it is larger.
### :returns: The count as a `U64`.
### :throws: {NumericDomainError} when this value is below 0.
routine S32.to_index!() -> U64
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and an index counts from 0")
    return LLVM::zero_extend[S32, U64](me)

### This value as a shift amount: the same count as a `U32`, or `U32_MAX` when it is larger.
### :returns: The count as a `U32`.
### :throws: {NumericDomainError} when this value is below 0.
routine S32.to_shift_amount!() -> U32
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and a shift amount counts from 0")
    return LLVM::reinterpret_bits[S32, U32](me)

### This value as an index: the same count as a `U64`, or `U64_MAX` when it is larger.
### :returns: The count as a `U64`.
### :throws: {NumericDomainError} when this value is below 0.
routine S64.to_index!() -> U64
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and an index counts from 0")
    return LLVM::reinterpret_bits[S64, U64](me)

### This value as a shift amount: the same count as a `U32`, or `U32_MAX` when it is larger.
### :returns: The count as a `U32`.
### :throws: {NumericDomainError} when this value is below 0.
routine S64.to_shift_amount!() -> U32
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and a shift amount counts from 0")
    if me > 4294967295
        return U32_MAX
    return LLVM::int_truncate[S64, U32](me)

### This value as an index: the same count as a `U64`, or `U64_MAX` when it is larger.
### :returns: The count as a `U64`.
### :throws: {NumericDomainError} when this value is below 0.
routine S128.to_index!() -> U64
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and an index counts from 0")
    if me > 18446744073709551615
        return U64_MAX
    return LLVM::int_truncate[S128, U64](me)

### This value as a shift amount: the same count as a `U32`, or `U32_MAX` when it is larger.
### :returns: The count as a `U32`.
### :throws: {NumericDomainError} when this value is below 0.
routine S128.to_shift_amount!() -> U32
    if me < 0
        throw NumericDomainError(description: f"{me} is below 0, and a shift amount counts from 0")
    if me > 4294967295
        return U32_MAX
    return LLVM::int_truncate[S128, U32](me)

