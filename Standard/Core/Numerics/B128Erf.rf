# 1/(n! (2n+1)) for n = 1 .. 24 in units of 2^-128, the erf series in w = x^2.
secret preset B128_ERF_SERIES: Array[U128, 24] = [
    0x55555555555555555555555555555555_u128, 0x1999999999999999999999999999999A_u128,
    0x06186186186186186186186186186186_u128, 0x012F684BDA12F684BDA12F684BDA12F7_u128,
    0x0031A6031A6031A6031A6031A6031A60_u128, 0x00070070070070070070070070070070_u128,
    0x0000DDEBBC99A778556334111EEFCCDB_u128, 0x0000187A00187A00187A00187A00187A_u128,
    0x0000026EEF8AAAD199A35557C444E000_u128, 0x000000385C60A90E166F15218A7181FB_u128,
    0x00000004AD9CC42AA7CE8854BE9714E8_u128, 0x000000005BD12384FA1783A018DA16F0_u128,
    0x00000000068A27B9F903DCE28F435122_u128, 0x00000000006F55DF9963408090769AD5_u128,
    0x000000000006F18943EC508C25A332F2_u128, 0x000000000000685CE859FEE932B1D2FE_u128,
    0x00000000000005C9C72F9618FB112D43_u128, 0x000000000000004DDF08443C820C0CC2_u128,
    0x0000000000000003E3680E76694CF3DB_u128, 0x00000000000000002F57AE44B1F6DC25_u128,
    0x0000000000000000022648D579C37BAE_u128, 0x00000000000000000017E6B81382CD42_u128,
    0x00000000000000000000FEB5F5EB2884_u128, 0x000000000000000000000A2E0541C77F_u128
