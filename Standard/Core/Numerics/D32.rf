module Core

import Collections
# ============================================================================
# Constants
# ============================================================================

preset D32_ZERO: D32 = 0.0_d32
preset D32_ONE: D32 = 1.0_d32
# IEEE 754 decimal32: 7 significant digits, emax = 96.
preset D32_MAX: D32 = 9.999999e96_d32
preset D32_MIN: D32 = -9.999999e96_d32
preset D32_MIN_POSITIVE: D32 = 1e-95_d32
preset D32_EPSILON: D32 = 1e-6_d32

# ============================================================================
# D32 — IEEE 754-2008 decimal32 in BID storage. The arithmetic, rounding, conversions, DPD and math are
# computed by Ingrid's decimal engine (Ingrid/tessera/decimal/, written in Tessera), one engine for D32, D64 and
# D128 that rounds each result once to this format. This file keeps the type, its BID layout (decode and encode
# for the text forms), the checked operators, the conversions' RazorForge faces, and text parsing.
# ============================================================================

### A software decimal32 value in BID storage.
@llvm("i32")
record D32
obeys Numeric, Comparable, Assignable, Copyable
    pass

### Narrow decoded fields (U64 coefficient — decimal32 has <= 7 digits).
record D32Parts
    sign: Bool
    special: U64
    exp: S64
    coeff: U64

### Widen to D128Parts for the shared special-value rules / decimal formatter.
routine d32parts_to_d128(p: D32Parts) -> D128Parts
    return D128Parts(
        sign: p.sign,
        special: p.special,
        exp: p.exp,
        coeff: LLVM::zero_extend[U64, U128](p.coeff),
    )

### Reinterprets the 32-bit BID storage as a raw U32 (no decode).
@readonly
routine D32.to_bits() -> U32
    return LLVM::reinterpret_bits[D32, U32](me)

### Reinterprets a raw U32 as BID32 storage (no validation).
common routine D32.from_bits(bits: U32) -> D32
    return LLVM::reinterpret_bits[U32, D32](bits)

### The decimal32 value re-encoded in DPD interchange form. Never crashes.
routine D32.to_dpd() -> U32
    return C::ingrid_d32_to_dpd(x: me.to_bits())

### Decodes a DPD interchange word into a decimal32. Never crashes.
common routine D32.from_dpd(bits: U32) -> D32
    return D32.from_bits(bits: C::ingrid_d32_from_dpd(bits: bits))

### BID32 decode -> narrow parts.
@readonly
routine D32.decode() -> D32Parts
    var bits = me.to_bits()
    # sign = bit 31
    var sign = LLVM::int_ne(
        a: LLVM::bit_and(a: bits, b: LLVM::shift_left(value: 1_u32, bits: 31_u32)),
        b: 0_u32,
    )
    # top5 = 5-bit combination prefix (bits 30:26) that selects form/special
    var top5 = LLVM::zero_extend[U32, U64](
        LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 26_u32), b: 0x1F_u32),
    )
    # 11110 -> infinity (special 1)
    if LLVM::int_eq(a: top5, b: 0x1E_u64)
        return D32Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
    # 11111 -> NaN; bit 25 distinguishes signaling (special 3) from quiet (special 2)
    if LLVM::int_eq(a: top5, b: 0x1F_u64)
        var sp = 2_u64
        if LLVM::int_ne(
            a: LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 25_u32), b: 1_u32),
            b: 0_u32,
        )
            sp = 3_u64
        return D32Parts(sign: sign, special: sp, exp: 0_s64, coeff: 0_u64)
    var biased = 0_u64
    var c32 = 0_u32
    # top5 >> 3 == 3 means combo prefix starts with 11 -> Form 2, else Form 1
    if LLVM::int_eq(a: LLVM::shift_right_unsigned(top5, 3_u64), b: 3_u64)
        # Form 2: exp bits 28:21, coeff = (bits 20:0) | 2^23
        biased = LLVM::zero_extend[U32, U64](
            LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 21_u32), b: 0xFF_u32),
        )
        c32 = LLVM::bit_or(
            a: LLVM::bit_and(a: bits, b: 0x1FFFFF_u32),
            b: LLVM::shift_left(value: 1_u32, bits: 23_u32),
        )
    else
        # Form 1: exp bits 30:23, coeff bits 22:0
        biased = LLVM::zero_extend[U32, U64](
            LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 23_u32), b: 0xFF_u32),
        )
        c32 = LLVM::bit_and(a: bits, b: 0x7FFFFF_u32)
    # unbias: stored exponent q = biased - 101 (bias=101)
    return D32Parts(
        sign: sign,
        special: 0_u64,
        exp: LLVM::sub(a: LLVM::reinterpret_bits[U64, S64](biased), b: 101_s64),
        coeff: LLVM::zero_extend[U32, U64](c32),
    )

### Narrow parts -> BID32 (Form 1 / Form 2 / special). Finite parts must already be
### rounded to <= 7 digits and in the decimal32 exponent range (decfin32 guarantees this).
routine d32_of_parts(p: D32Parts) -> D32
    # sign into bit 31
    var sbit = LLVM::shift_left(value: if p.sign then 1_u32 else 0_u32, bits: 31_u32)
    if LLVM::int_ne(a: p.special, b: 0_u64)
        # special: combo prefix 11110 (inf) or 11111 (NaN) into bits 30:26
        var top5 = if LLVM::int_eq(a: p.special, b: 1_u64) then 0x1E_u32 else 0x1F_u32
        var bb = LLVM::bit_or(a: sbit, b: LLVM::shift_left(value: top5, bits: 26_u32))
        # signaling NaN sets bit 25
        if LLVM::int_eq(a: p.special, b: 3_u64)
            bb = LLVM::bit_or(a: bb, b: LLVM::shift_left(value: 1_u32, bits: 25_u32))
        return D32.from_bits(bits: bb)
    # rebias: 8-bit biased exponent = (q + 101) masked to 8 bits
    var ebits8 = LLVM::int_truncate[U64, U32](
        LLVM::bit_and(
            a: LLVM::add(a: LLVM::reinterpret_bits[S64, U64](p.exp), b: 101_u64),
            b: 0xFF_u64,
        ),
    )
    var c32 = LLVM::int_truncate[U64, U32](p.coeff)
    # coeff < 2^23 -> Form 1, else Form 2 (implicit leading 2^23)
    if LLVM::unsigned_lt(a: c32, b: 0x800000_u32)
        # Form 1: exp bits 30:23, coeff bits 22:0
        return D32.from_bits(
            bits: LLVM::bit_or(
                a: LLVM::bit_or(a: sbit, b: LLVM::shift_left(value: ebits8, bits: 23_u32)),
                b: c32,
            ),
        )
    # Form 2: bits 30:29 = 11, exp bits 28:21, coeff low 21 bits (implicit 2^23)
    var g2 = LLVM::shift_left(value: 0x3_u32, bits: 29_u32)  # the 11 prefix
    var ebits = LLVM::shift_left(value: ebits8, bits: 21_u32)
    var clow = LLVM::bit_and(a: c32, b: 0x1FFFFF_u32)  # low 21 coeff bits
    return D32.from_bits(
        bits: LLVM::bit_or(a: LLVM::bit_or(a: sbit, b: g2), b: LLVM::bit_or(a: ebits, b: clow)),
    )

### Infinity / quiet NaN.
common routine D32.infinity(sign: Bool) -> D32
    return d32_of_parts(p: D32Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64))

### Returns a quiet NaN.
common routine D32.quiet_nan() -> D32
    return d32_of_parts(p: D32Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: 0_u64))

### Returns a signaling NaN (interop/testing; never produced by arithmetic).
common routine D32.signaling_nan() -> D32
    return d32_of_parts(p: D32Parts(sign: false, special: 3_u64, exp: 0_s64, coeff: 0_u64))

### True when this is a finite value (special field == 0).
routine D32.is_finite() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 0_u64)

### True when this is ±infinity (special field == 1).
routine D32.is_infinite() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 1_u64)

### True when this is a NaN (special field >= 2: 2 quiet, 3 signaling).
routine D32.is_nan() -> Bool
    return LLVM::unsigned_ge(a: me.decode().special, b: 2_u64)

### True when this is a SIGNALING NaN (special field == 3).
routine D32.is_signaling() -> Bool
    return LLVM::int_eq(a: me.decode().special, b: 3_u64)

### True when this is a finite zero (±0).
@readonly
routine D32.is_zero() -> Bool
    var p = me.decode()
    return LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_eq(a: p.coeff, b: 0_u64)

### Builds a finite D32 from a sign, a coefficient and a base-10 exponent: value = (-1)^sign * coeff *
### 10^exp, rounded half to even to 7 digits and brought into the exponent range.
common routine D32.from_components(sign: Bool, coeff: U64, exp: S64) -> D32
    var neg = 0_u32
    if sign
        neg = 1_u32
    return D32.from_bits(bits: C::ingrid_d32_from_parts(neg: neg, c_low: coeff, c_high: 0_u64, exp: exp))

### Builds a D32 from a 64-bit signed integer (exponent 0).
common routine D32.from_int64(value: S64) -> D32
    var neg = LLVM::signed_lt(a: value, b: 0_s64)
    var mag = if neg then LLVM::sub(a: 0_s64, b: value) else value
    return D32.from_components(sign: neg, coeff: LLVM::reinterpret_bits[S64, U64](mag), exp: 0_s64)

### An integer (sign and 256-bit magnitude) as a D32, rounded half to even to 7 digits.
routine d32_of_integer(neg: Bool, m: U256) -> D32
    var n = 0_u32
    if neg
        n = 1_u32
    var m0 = LLVM::int_truncate[U256, U64](m)
    var m1 = LLVM::int_truncate[U256, U64](m >>> 64_u32)
    var m2 = LLVM::int_truncate[U256, U64](m >>> 128_u32)
    var m3 = LLVM::int_truncate[U256, U64](m >>> 192_u32)
    return D32.from_bits(bits: C::ingrid_d32_from_integer(neg: n, m0: m0, m1: m1, m2: m2, m3: m3))

### The bits of the binary float nearest to x, `which` bits wide (16, 32, 64, or 128). An infinity keeps its sign,
### a NaN becomes the positive quiet NaN.
routine d32_to_binary(x: D32, which: U32) -> U128
    var r = C::ingrid_d32_to_binary(x: x.to_bits(), which: which)
    return (U128(from: r.w1) << 64) | U128(from: r.w0)

### A B128 as a D32, correctly rounded (a narrower binary float widens to B128 exactly first).
routine d32_of_b128(x: B128) -> D32
    return D32.from_bits(bits: C::ingrid_d32_from_binary(low: x.low_bits(), high: x.high_bits()))

# Checked arithmetic crashes with a specific cause on a non-finite result (mirrors B64/Decimal):
# ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 -> DivisionByZeroError. Use the `*_unchecked`
# operators for raw IEEE 754 propagation.

### Returns `me + you`. Checked: crashes if the result is non-finite. Use `add_unchecked` for raw
### IEEE.
@readonly
routine D32.add!(you: D32) -> D32
    var r = D32.from_bits(bits: C::ingrid_d32_add(a: me.to_bits(), b: you.to_bits()))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me - you`. Checked: crashes if the result is non-finite. Use `sub_unchecked` for raw
### IEEE.
@readonly
routine D32.sub!(you: D32) -> D32
    var r = D32.from_bits(bits: C::ingrid_d32_sub(a: me.to_bits(), b: you.to_bits()))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me * you`. Checked: crashes if the result is non-finite. Use `mul_unchecked` for raw
### IEEE.
@readonly
routine D32.mul!(you: D32) -> D32
    var r = D32.from_bits(bits: C::ingrid_d32_mul(a: me.to_bits(), b: you.to_bits()))
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me / you`. Checked: `x/0` -> DivisionByZeroError, `0/0` -> domain, overflow ->
### overflow.
### Use `truediv_unchecked` for raw IEEE 754 (`x/0` -> ±inf, `0/0` -> NaN).
@readonly
routine D32.truediv!(you: D32) -> D32
    var r = D32.from_bits(bits: C::ingrid_d32_div(a: me.to_bits(), b: you.to_bits()))
    if r.is_finite()
        return r
    if you.is_zero() and not me.is_zero()
        throw DivisionByZeroError()
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D32.add_unchecked(you: D32) -> D32
    return D32.from_bits(bits: C::ingrid_d32_add(a: me.to_bits(), b: you.to_bits()))

### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D32.sub_unchecked(you: D32) -> D32
    return D32.from_bits(bits: C::ingrid_d32_sub(a: me.to_bits(), b: you.to_bits()))

### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D32.mul_unchecked(you: D32) -> D32
    return D32.from_bits(bits: C::ingrid_d32_mul(a: me.to_bits(), b: you.to_bits()))

### Returns `me / you` with raw IEEE 754 propagation (`x/0` -> ±infinity, `0/0` -> NaN). No crash.
routine D32.truediv_unchecked(you: D32) -> D32
    return D32.from_bits(bits: C::ingrid_d32_div(a: me.to_bits(), b: you.to_bits()))

### Decimal value equality (NaN never equal; infinities equal only with the same sign;
### finite values compare by value, so different cohorts of the same number are equal).
@readonly
routine D32.eq(you: D32) -> Bool
    return C::ingrid_d32_order(a: me.to_bits(), b: you.to_bits()) == 0_s64

### Three-way decimal comparison under IEEE ordered semantics. NaN is unordered and
### maps to `SAME` (matching the B128 engine convention).
@readonly
routine D32.cmp(you: D32) -> ComparisonSign
    var o = C::ingrid_d32_order(a: me.to_bits(), b: you.to_bits())
    if o == -1_s64
        return ME_SMALL
    if o == 1_s64
        return ME_LARGE
    return SAME

### Raises this value to the `you` power (IEEE semantics: inf/NaN on overflow/domain error).
@readonly
routine D32.pow!(you: D32) -> D32
    var r = me.pow_unchecked(you: you)
    if r.is_finite()
        return r
    if r.is_nan()
        throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")

### Shortest decimal text (widens to D128Parts and reuses the shared formatter).
@override
routine D32.represent() -> Text
    return d128_represent(p: d32parts_to_d128(p: me.decode()))

### Renders this value with exactly `places` digits after the point, rounded half to even from its
### exact value (`2.675.fixed(2)` is `2.67`, since the stored double is just below 2.675). The integer
### part is always written out in full, never in exponent form.
### :param places: The number of digits after the point (0 for none).
### :returns: The rendered `Text`.
routine D32.fixed(places: U64) -> Text
    return format_decimal_fixed(p: d32parts_to_d128(p: me.decode()), places: places)

### Debug form: `D32(<value>)`.
@override
routine D32.diagnose() -> Text
    return d128_represent_wrapped(p: d32parts_to_d128(p: me.decode()), wrap: "D32", strip: false)

### Returns the smaller of `me` and `you` under decimal ordering.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`, otherwise `you`.
routine D32.min(you: D32) -> D32
    return if me <= you then me else you

### Returns the larger of `me` and `you` under decimal ordering.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`, otherwise `you`.
routine D32.max(you: D32) -> D32
    return if me >= you then me else you

### Restricts `me` to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound.
### :param max_val: The upper bound.
### :returns: The clamped value.
@positional
routine D32.clamp(min_val: D32, max_val: D32) -> D32
    return me.min(max_val).max(min_val)

### Returns the reciprocal `1 / me`.
### :returns: The multiplicative inverse.
routine D32.recip() -> D32
    return D32_ONE.truediv_unchecked(me)

### Returns `me` raised to the integer power `n` via exponentiation by squaring.
### A negative `n` inverts the result.
### :param n: The integer exponent.
### :returns: `me ** n`.
routine D32.powi(n: S32) -> D32
    var base = if n < 0_s32 then D32_ONE.truediv_unchecked(me) else me
    var count = n.unsigned_abs()
    var result = D32_ONE
    while count > 0_u32
        if count.bitand(1_u32) == 1_u32
            result = result.mul_unchecked(base)
        base = base.mul_unchecked(base)
        count = count.lshr(1_u32)
    return result

### Returns `(me + you) / 2`.
### :param you: The other value.
### :returns: The arithmetic midpoint of `me` and `you`.
routine D32.midpoint(you: D32) -> D32
    return me.add_unchecked(you).truediv_unchecked(2.0_d32)

# ============================================================================
# Creators — integers (exact, then rounded half to even to 7 digits)
# ============================================================================

### Converts an S8 into decimal32 (exponent 0).
routine D32(from: S8) -> D32
    return D32.from_int64(value: S64(from))

### Converts an S16 into decimal32 (exponent 0).
routine D32(from: S16) -> D32
    return D32.from_int64(value: S64(from))

### Converts an S32 into decimal32 (exponent 0).
routine D32(from: S32) -> D32
    return D32.from_int64(value: S64(from))

### Converts an S64 into decimal32 (exponent 0).
routine D32(from: S64) -> D32
    return D32.from_int64(value: from)

### Converts an S128 into decimal32 (exponent 0, rounded half to even when it has more than 7 digits).
routine D32(from: S128) -> D32
    var v = LLVM::sign_extend[S128, S256](from)
    var neg = v < 0_s256
    var mag = LLVM::reinterpret_bits[S256, U256](v)
    if neg
        mag = 0_u256 -% mag
    return d32_of_integer(neg: neg, m: mag)

### Converts an S256 into decimal32 (exponent 0, rounded half to even when it has more than 7 digits).
routine D32(from: S256) -> D32
    var v = from
    var neg = v < 0_s256
    var mag = LLVM::reinterpret_bits[S256, U256](v)
    if neg
        mag = 0_u256 -% mag
    return d32_of_integer(neg: neg, m: mag)

### Converts a U8 into decimal32 (exponent 0).
routine D32(from: U8) -> D32
    return D32.from_components(sign: false, coeff: U64(from), exp: 0_s64)

### Converts a U16 into decimal32 (exponent 0).
routine D32(from: U16) -> D32
    return D32.from_components(sign: false, coeff: U64(from), exp: 0_s64)

### Converts a U32 into decimal32 (exponent 0).
routine D32(from: U32) -> D32
    return D32.from_components(sign: false, coeff: U64(from), exp: 0_s64)

### Converts a U64 into decimal32 (exponent 0).
routine D32(from: U64) -> D32
    return D32.from_components(sign: false, coeff: from, exp: 0_s64)

### Converts a U128 into decimal32 (exponent 0, rounded half to even when it has more than 7 digits).
routine D32(from: U128) -> D32
    return d32_of_integer(neg: false, m: LLVM::zero_extend[U128, U256](from))

### Converts a U256 into decimal32 (exponent 0, rounded half to even when it has more than 7 digits).
routine D32(from: U256) -> D32
    return d32_of_integer(neg: false, m: from)

# ============================================================================
# Creators — binary floats (widened to B128 exactly, then correctly rounded once)
# ============================================================================

### Converts a B16 to decimal32, correctly rounded.
routine D32(from: B16) -> D32
    return d32_of_b128(x: B128(from: from))

### Converts a B32 to decimal32, correctly rounded.
routine D32(from: B32) -> D32
    return d32_of_b128(x: B128(from: from))

### Converts a B128 to decimal32, correctly rounded.
routine D32(from: B128) -> D32
    return d32_of_b128(x: from)

### Converts a B64 to decimal32, correctly rounded.
routine D32(from: B64) -> D32
    return d32_of_b128(x: B128(from: from))

### The D32 value as a B64, correctly rounded.
routine B64(from: D32) -> B64
    return B64.from_bits(bits: LLVM::int_truncate[U128, U64](d32_to_binary(x: from, which: 64_u32)))

# ============================================================================
# Creators — decimal <-> decimal
# ============================================================================

### Identity conversion (D32 -> D32).
routine D32(from: D32) -> D32
    return from

### Converts a D64 to D32 (rounded half to even to 7 digits, then reduced).
routine D32(from: D64) -> D32
    return D32.from_bits(bits: C::ingrid_d32_from_d64(x: from.to_bits()))

### Converts a D128 to D32 (rounded half to even to 7 digits, then reduced).
routine D32(from: D128) -> D32
    return D32.from_bits(bits: C::ingrid_d32_from_d128(x_low: d128_low(v: from), x_high: d128_high(v: from)))

# ============================================================================
# Text parsing — the shared scanner, rounded once to decimal32
# ============================================================================

### Parses a decimal literal into a `D32` (the scanned value rounded once to 7 digits).
### :throws: {InvalidValueError} if the text is not a valid decimal literal.
routine D32!(from_text: Text) -> D32
    var p = scan_decimal_parts(from_text: from_text)
    if p.special == 1_u64
        return D32.infinity(sign: p.sign)
    if p.special >= 2_u64
        return D32.quiet_nan()
    var neg = 0_u32
    if p.sign
        neg = 1_u32
    var low = LLVM::int_truncate[U128, U64](p.coeff)
    var high = LLVM::int_truncate[U128, U64](p.coeff >>> 64)
    return D32.from_bits(bits: C::ingrid_d32_from_parts(neg: neg, c_low: low, c_high: high, exp: p.exp))

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
routine D32.to_bytes_le() -> Array[Byte, 4]
    var raw = me.to_bits()
    var result = Array[Byte, 4]()
    var i = 0_u64
    while LLVM::unsigned_lt(a: i, b: 4_u64)
        var b = LLVM::int_truncate[U32, U8](
            LLVM::shift_right_unsigned(
                raw,
                LLVM::int_truncate[U64, U32](LLVM::mul(a: i, b: 8_u64)),
            ),
        )
        result = LLVM::set_byte_at(array: result, index: i, value: b)
        i = LLVM::add(a: i, b: 1_u64)
    return result

### Returns the raw bytes of this value in big-endian order.
routine D32.to_bytes_be() -> Array[Byte, 4]
    var raw = me.to_bits()
    var result = Array[Byte, 4]()
    var i = 0_u64
    while LLVM::unsigned_lt(a: i, b: 4_u64)
        var b = LLVM::int_truncate[U32, U8](
            LLVM::shift_right_unsigned(
                raw,
                LLVM::int_truncate[U64, U32](LLVM::mul(a: LLVM::sub(a: 3_u64, b: i), b: 8_u64)),
            ),
        )
        result = LLVM::set_byte_at(array: result, index: i, value: b)
        i = LLVM::add(a: i, b: 1_u64)
    return result
