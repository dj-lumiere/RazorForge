module Core

# ============================================================================
# D128 near-midpoint tier: 256-bit fixed point for the tiny arguments where the fast path cannot decide
# ============================================================================
# The 128-bit fast paths carry about 2^-121 of relative error, a few bits past a D128 digit. For an exact
# short decimal next to 1 (x = 1 + d 10^-k), log(x) and lgamma(x) fall within 2^-199 or so of a rounding
# midpoint: log1p(t) = t - t^2/2 + t^3/3 ... with t - t^2/2 exact in decimal, and only the next term deciding.
# Here the series runs in 256-bit fixed point (U256, about 2^-250 of the value), and the product with the
# exact decimal coefficient is formed in 384 bits and rounded to 34 digits.

# gamma and 1 - gamma in units of 2^-255 (hi, lo), rounded.
secret preset D128X_EULER_HI: U128 = 0x49E233F1BED863D268DF1FC080A965AB_u128
secret preset D128X_EULER_LO: U128 = 0x50E7661D7B2E600C8601EF9A384D7FDF_u128
secret preset D128X_ONE_MINUS_EULER_HI: U128 = 0x361DCC0E41279C2D9720E03F7F569A54_u128
secret preset D128X_ONE_MINUS_EULER_LO: U128 = 0xAF1899E284D19FF379FE1065C7B28021_u128
# zeta(k) / k for k = 2 .. 16 in units of 2^-255 (hi, lo), rounded.
secret preset D128X_ZETA_K: Array[U128, 30] = [
  0x694699894C1F4C8C39EC4891005D672F_u128, 0x5AE446D5408B16C599AC16018D2F79B5_u128,
  0x3349AAB7D565ADEB3D92E4B9A66D6A84_u128, 0x8401EA483E188ABA4D8C4BF1D87953C9_u128,
  0x22A264558FB0906D7E4484465B948D7E_u128, 0xF161AC4C2E00A164B7A3FAB6D9CF9A0B_u128,
  0x1A8B9C17AA614925D04D49FB5C33209B_u128, 0x81330DA6E4765BF1054C9F4EBB337B70_u128,
  0x15B40CB100C30614A79940F15695B1DF_u128, 0x6855DDC2E2B9AFD63D4FBCD723DC43E6_u128,
  0x12703A1DCEA3AE58C1FF41E52B0E0348_u128, 0x7F8DBAA7AC1F33794F93C188EA06C33E_u128,
  0x1010B36AF86396E8BE59CA4DDB5A64CD_u128, 0xB86F39709D49AFD8254897BA4B171178_u128,
  0x0E4033836ABEDA2AD5500DFBA7DB2223_u128, 0x1E90DACEB13011B58722BD732CE4EC98_u128,
  0x0CD00F1C2EAFC79813418F3768CD66B0_u128, 0xEE3DE34B6DF9D6FAC7BC2BE6ABD73F15_u128,
  0x0BA461988A636B07A95D890201C7F158_u128, 0x7B33F9590CBD968940F4F8BA45C520C3_u128,
  0x0AAB56B1921DE202BBD0B01F5D03A1CC_u128, 0xCD6ABE647ED46FA68C510C5E73A17DD3_u128,
  0x09D8ECB8FE2CC261A79F81B6C2036AFF_u128, 0x1C896E05D44BB2D86FD211CB0C075578_u128,
  0x0924B6FC19062FB9E9695C0817D0A644_u128, 0x16623B1742E8EDEA528B61D64256D9DD_u128,
  0x088899A3B73FF01DC9A4FF396EE34EC2_u128, 0x31069EA2D71851D5342B8610850A589C_u128,
  0x08000803266F5917879D0156AFFDBC10_u128, 0xB5834005BD89BCE2341CDD75F45C7D80_u128
]
# (zeta(k) - 1) / k for k = 2 .. 16 in units of 2^-255 (hi, lo), rounded.
secret preset D128X_ZETAM1_K: Array[U128, 30] = [
  0x294699894C1F4C8C39EC4891005D672F_u128, 0x5AE446D5408B16C599AC16018D2F79B5_u128,
  0x089F000D2ABB034092E83A0EFBC2BFD9_u128, 0xD9573F9D936DE00FA2E1A1472DCEA91F_u128,
  0x02A264558FB0906D7E4484465B948D7E_u128, 0xF161AC4C2E00A164B7A3FAB6D9CF9A0B_u128,
  0x00F2027E10C7AF8C36B3B061C2998701_u128, 0xE799740D4ADCC2576BB305B52199E1D7_u128,
  0x005EB75BAB6DB0BF5243EB9C01405C8A_u128, 0x1300886D8D645A80E7FA6781CE86EE90_u128,
  0x0027158B857F1C0F9D6CF8C098C4DEB6_u128, 0x3669285E878CEA54BD4A9CF6A0E230F5_u128,
  0x0010B36AF86396E8BE59CA4DDB5A64CD_u128, 0xB86F39709D49AFD8254897BA4B171178_u128,
  0x00074FF531DB4BF1F1C1D51819A23E94_u128, 0xE5AD4C95CDA1D8D1F8E9D9E4F4015E5F_u128,
  0x0003424F61E2FACB4674C26A9C0099E4_u128, 0x2171167EA12D0A2DFAEF5F19DF0A7248_u128,
  0x000178DE5BD7C81EEF2EFD5F190DC2CC_u128, 0xD84B3F2A811AADCF126955D18B969520_u128,
  0x0000AC06E773375811260574B258F722_u128, 0x22C013B9D429C4FBE1A661B3C8F6D329_u128,
  0x00004F2F258F38890A15A919382ACD75_u128, 0x43EBE42D36C1DA3AE5F974413369CB9F_u128,
  0x000024B2F473E69557203775CEAC13FA_u128, 0xF1CFF1F2B09FC9580966CF8D1DC490B8_u128,
  0x0000111B2EB76795411C76B0E65AC639_u128, 0xA87E161A4E8FC94CABA2FD87FC81D013_u128,
  0x00000803266F5917879D0156AFFDBC10_u128, 0xB5834005BD89BCE2341CDD75F45C7D80_u128
]

### (a * b) / 2^254 truncated toward zero, for signed fixed-point values below 1 in magnitude (units of
### 2^-254, so strictly below 2^254), exact but for the truncation.
@inline
secret routine d128x_smul(a: S256, b: S256) -> S256
  var ua = LLVM::reinterpret_bits[S256, U256](a)
  var ub = LLVM::reinterpret_bits[S256, U256](b)
  if a < 0_s256
    ua = 0_u256 -% ua
  if b < 0_s256
    ub = 0_u256 -% ub
  var r = LLVM::reinterpret_bits[U256, S256](u256_mulhi(a: ua << 2_u32, b: ub))
  if (a < 0_s256) != (b < 0_s256)
    return 0_s256 -% r
  return r

### a / k truncated toward zero for a small k, by 64-bit limb division.
secret routine d128x_div_small(a: S256, k: U64) -> S256
  var neg = a < 0_s256
  var u = LLVM::reinterpret_bits[S256, U256](a)
  if neg
    u = 0_u256 -% u
  var q = 0_u256
  var rem = 0_u128
  var i = 4_u32
  while i > 0_u32
    i = i -% 1_u32
    var cur = (rem << 64_u32) | LLVM::zero_extend[U64, U128](LLVM::int_truncate[U256, U64](u >>> (i *% 64_u32)))
    var qq = cur // LLVM::zero_extend[U64, U128](k)
    rem = cur -% qq *% LLVM::zero_extend[U64, U128](k)
    q = q | (LLVM::zero_extend[U128, U256](qq) << (i *% 64_u32))
  var r = LLVM::reinterpret_bits[U256, S256](q)
  if neg
    return 0_s256 -% r
  return r

### A 256-bit fixed-point constant (hi, lo) in units of 2^-255, as a signed value in units of 2^-254.
@inline
secret routine d128x_const(hi: U128, lo: U128, neg: Bool) -> S256
  var v = LLVM::reinterpret_bits[U256, S256](((LLVM::zero_extend[U128, U256](hi) << 128_u32) | LLVM::zero_extend[U128, U256](lo)) >>> 1_u32)
  if neg
    return 0_s256 -% v
  return v

### |t| * 2^254 for a D128 t = c * 10^q with |t| < 1, as a signed value (the sign of t), within 2 units:
### c times the 256-bit power of ten.
secret routine d128x_fixed(t: D128Parts) -> (Bool, S256)
  if t.exp < -6208_s64 or t.exp > 0_s64 or t.coeff == 0_u128
    return (false, 0_s256)
  var (mh, ml, e10) = b128t_pow10(n: t.exp)
  var sh = 0_s64 -% (e10 +% 254_s64)
  if sh < 129_s64 -% b128_trig_clz128(x: t.coeff) or sh >= 400_s64
    return (false, 0_s256)
  var v = LLVM::reinterpret_bits[U256, S256](b128t_scale(cb: t.coeff, mh: mh, ml: ml, sh: sh))
  if t.sign
    return (true, 0_s256 -% v)
  return (true, v)

### (-1)^neg * d * 10^q * f / 2^254 rounded to 34 digits (half to even), stored reduced, for d < 10^34 and
### f a positive fixed-point value known to within ferr units: d * 10^s times f exactly in 384 bits, s
### chosen so the integer part has 34 digits (a product past 34 digits is divided by 10 once, one more
### unit). False when the result's fraction sits within the error of one half, or outside the normal range.
secret routine d128x_round_product(neg: Bool, d: U128, q: S64, f: U256, ferr: U128) -> (Bool, D128)
  var zero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
  var lo34 = 1000000000000000000000000000000000_u128
  var hi34 = 10000000000000000000000000000000000_u128
  var s = 34_s64 -% digits10_u128(c: d)
  var tries = 0_s64
  while tries < 3_s64
    if s < 0_s64
      return (false, zero)
    var dd = d
    var j = 0_s64
    while j < s
      dd = dd *% 10_u128
      j = j +% 1_s64
    var fh = LLVM::int_truncate[U256, U128](f >>> 128_u32)
    var fl = LLVM::int_truncate[U256, U128](f)
    var pl = b128_trig_wmul(x: dd, y: fl)
    var ph = b128_trig_wmul(x: dd, y: fh)
    var (mid, cy) = b128t_add(a: ph.item1, b: pl.item0, cin: 0_u128)
    var top = ph.item0 +% cy
    # the integer part (N >> 254) and the 254-bit fraction
    var ip = (top << 2_u32) | (mid >>> 126_u32)
    var frac = ((LLVM::zero_extend[U128, U256](mid & ((1_u128 << 126_u32) -% 1_u128))) << 128_u32) | LLVM::zero_extend[U128, U256](pl.item1)
    var err = LLVM::zero_extend[U128, U256](ferr) *% LLVM::zero_extend[U128, U256](dd) +% 2_u256
    if ip >= hi34
      # divide the whole 384-bit product by 10 (a unit more of error)
      var limbs = Array[U64, 6]()
      limbs[5_u64] = LLVM::int_truncate[U128, U64](top >>> 64_u32)
      limbs[4_u64] = LLVM::int_truncate[U128, U64](top)
      limbs[3_u64] = LLVM::int_truncate[U128, U64](mid >>> 64_u32)
      limbs[2_u64] = LLVM::int_truncate[U128, U64](mid)
      limbs[1_u64] = LLVM::int_truncate[U128, U64](pl.item1 >>> 64_u32)
      limbs[0_u64] = LLVM::int_truncate[U128, U64](pl.item1)
      var rem = 0_u128
      var i = 6_u64
      while i > 0_u64
        i = i -% 1_u64
        var cur = (rem << 64_u32) | LLVM::zero_extend[U64, U128](limbs[i])
        var qq = cur // 10_u128
        rem = cur -% qq *% 10_u128
        limbs[i] = LLVM::int_truncate[U128, U64](qq)
      top = (LLVM::zero_extend[U64, U128](limbs[5_u64]) << 64_u32) | LLVM::zero_extend[U64, U128](limbs[4_u64])
      mid = (LLVM::zero_extend[U64, U128](limbs[3_u64]) << 64_u32) | LLVM::zero_extend[U64, U128](limbs[2_u64])
      var low = (LLVM::zero_extend[U64, U128](limbs[1_u64]) << 64_u32) | LLVM::zero_extend[U64, U128](limbs[0_u64])
      ip = (top << 2_u32) | (mid >>> 126_u32)
      frac = ((LLVM::zero_extend[U128, U256](mid & ((1_u128 << 126_u32) -% 1_u128))) << 128_u32) | LLVM::zero_extend[U128, U256](low)
      err = err +% 1_u256
      s = s -% 1_s64
      if ip >= hi34 or ip < lo34
        return (false, zero)
    elseif ip < lo34
      s = s +% 1_s64
      tries = tries +% 1_s64
      continue
    var half = 1_u256 << 253_u32
    if frac +% err >= half and frac <= half +% err
      return (false, zero)
    var c = ip
    if frac > half
      c = c +% 1_u128
    var ex = q -% s
    if c == hi34
      c = lo34
      ex = ex +% 1_s64
    var tz = trailing_zeros10_u128(c: c, cap0: 34_s64)
    c = div_pow10_u128(x: c, k: tz)
    ex = ex +% tz
    if ex < -6176_s64 or ex > 6111_s64
      return (false, zero)
    return (true, d128_of_parts(p: D128Parts(sign: neg, special: 0_u64, exp: ex, coeff: c)))
  return (false, zero)

### log1p(t) for a D128 t with |t| < 10^-6, rounded to 34 digits, or false: t * F with F = sum (-t)^k / (k + 1)
### in 256-bit fixed point (each power and quotient truncated once, the sum within 2 (K + 1)^2 + 8 units of
### 2^-254 over K terms). For the inputs next to 1 whose logarithm lies too close to a rounding midpoint for
### the 128-bit fast path (as close as 2^-199 of the value), this still decides.
secret routine d128x_log1p_tiny(t: D128Parts) -> (Bool, D128)
  var zero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
  var (ok, ts) = d128x_fixed(t: t)
  if not ok
    return (false, zero)
  var f = LLVM::reinterpret_bits[U256, S256](1_u256 << 254_u32)
  var p = ts
  var k = 1_u64
  while k < 20_u64 and p != 0_s256
    var term = d128x_div_small(a: p, k: k +% 1_u64)
    if (k & 1_u64) == 1_u64
      f = f -% term
    else
      f = f +% term
    p = d128x_smul(a: p, b: ts)
    k = k +% 1_u64
  if p != 0_s256
    return (false, zero)
  var kk = LLVM::zero_extend[U64, U128](k)
  return d128x_round_product(neg: t.sign, d: t.coeff, q: t.exp, f: LLVM::reinterpret_bits[S256, U256](f), ferr: 2_u128 *% (kk +% 1_u128) *% (kk +% 1_u128) +% 8_u128)

### lgamma(1 + z) (two false) or lgamma(2 + z) (two true) for a D128 z with |z| < 10^-6, rounded to 34
### digits, or false: z * G with G = -gamma + sum (-1)^k zeta(k)/k z^(k-1) (or 1 - gamma and (zeta(k) - 1)/k)
### in 256-bit fixed point, k up to 16 (the rest below 2^-300).
secret routine d128x_lgamma_tiny(z: D128Parts, two: Bool) -> (Bool, D128)
  var zero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
  var (ok, zs) = d128x_fixed(t: z)
  if not ok
    return (false, zero)
  var g = d128x_const(hi: D128X_EULER_HI, lo: D128X_EULER_LO, neg: true)
  if two
    g = d128x_const(hi: D128X_ONE_MINUS_EULER_HI, lo: D128X_ONE_MINUS_EULER_LO, neg: false)
  var p = zs
  var k = 2_u64
  while k <= 16_u64 and p != 0_s256
    var idx = (k -% 2_u64) *% 2_u64
    var c = d128x_const(hi: D128X_ZETA_K[idx], lo: D128X_ZETA_K[idx +% 1_u64], neg: false)
    if two
      c = d128x_const(hi: D128X_ZETAM1_K[idx], lo: D128X_ZETAM1_K[idx +% 1_u64], neg: false)
    var term = d128x_smul(a: c, b: p)
    if (k & 1_u64) == 0_u64
      g = g +% term
    else
      g = g -% term
    p = d128x_smul(a: p, b: zs)
    k = k +% 1_u64
  if p != 0_s256
    return (false, zero)
  var gneg = g < 0_s256
  var gm = LLVM::reinterpret_bits[S256, U256](g)
  if gneg
    gm = 0_u256 -% gm
  return d128x_round_product(neg: z.sign != gneg, d: z.coeff, q: z.exp, f: gm, ferr: 40_u128)

### expm1(t) for a D128 t with |t| < 10^-6, rounded to 34 digits, or false: t * F with F = sum t^k / (k + 1)!
### in 256-bit fixed point, each term from the previous one (times t, over k + 1), within 2 (K + 1) + 8 units.
secret routine d128x_expm1_tiny(t: D128Parts) -> (Bool, D128)
  var zero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
  var (ok, ts) = d128x_fixed(t: t)
  if not ok
    return (false, zero)
  # term k is t^k / (k + 1)!, starting from t / 2 (1 itself, 2^254, is past d128x_smul's range)
  var term = d128x_div_small(a: ts, k: 2_u64)
  var f = LLVM::reinterpret_bits[U256, S256](1_u256 << 254_u32) +% term
  var k = 2_u64
  while k < 20_u64 and term != 0_s256
    term = d128x_div_small(a: d128x_smul(a: term, b: ts), k: k +% 1_u64)
    f = f +% term
    k = k +% 1_u64
  if term != 0_s256
    return (false, zero)
  var kk = LLVM::zero_extend[U64, U128](k)
  return d128x_round_product(neg: t.sign, d: t.coeff, q: t.exp, f: LLVM::reinterpret_bits[S256, U256](f), ferr: 2_u128 *% kk +% 8_u128)

### cos (hyperbolic false) or cosh (true) of a D128 x with |x| < 10^-6, rounded to 34 digits, or false: the
### value is 1 -+ u with u = x^2/2 -+ x^4/24 + ... in 256-bit fixed point (within 2K + 8 units of 2^-254),
### and u times 10^34 (10^33 for cosh, which is above 1) is split into its integer part and fraction to
### round 1 -+ u exactly.
secret routine d128x_cos_tiny(x: D128Parts, hyperbolic: Bool) -> (Bool, D128)
  var zero = D128.from_components(sign: false, coeff: 0_u128, exp: 0_s64)
  var (ok, xs) = d128x_fixed(t: x)
  if not ok
    return (false, zero)
  var w = d128x_smul(a: xs, b: xs)
  var term = d128x_div_small(a: w, k: 2_u64)
  var u = term
  var k = 1_u64
  while k < 12_u64 and term != 0_s256
    term = d128x_div_small(a: d128x_smul(a: term, b: w), k: (2_u64 *% k +% 1_u64) *% (2_u64 *% k +% 2_u64))
    if hyperbolic or (k & 1_u64) == 0_u64
      u = u +% term
    else
      u = u -% term
    k = k +% 1_u64
  if term != 0_s256 or u <= 0_s256
    return (false, zero)
  var uu = LLVM::reinterpret_bits[S256, U256](u)
  # V = u * 10^digits in 384 bits: its integer part and 254-bit fraction
  var scale = 10000000000000000000000000000000000_u128
  if hyperbolic
    scale = 1000000000000000000000000000000000_u128
  var pl = b128_trig_wmul(x: scale, y: LLVM::int_truncate[U256, U128](uu))
  var ph = b128_trig_wmul(x: scale, y: LLVM::int_truncate[U256, U128](uu >>> 128_u32))
  var (mid, cy) = b128t_add(a: ph.item1, b: pl.item0, cin: 0_u128)
  var top = ph.item0 +% cy
  var ip = (top << 2_u32) | (mid >>> 126_u32)
  var frac = ((LLVM::zero_extend[U128, U256](mid & ((1_u128 << 126_u32) -% 1_u128))) << 128_u32) | LLVM::zero_extend[U128, U256](pl.item1)
  var err = LLVM::zero_extend[U128, U256](scale) *% LLVM::zero_extend[U64, U256](2_u64 *% k +% 8_u64) +% 2_u256
  var half = 1_u256 << 253_u32
  if frac +% err >= half and frac <= half +% err
    return (false, zero)
  var c = 0_u128
  var ex = 0_s64
  if hyperbolic
    # 1 + u: 10^33 + V rounded
    c = scale +% ip
    if frac > half
      c = c +% 1_u128
    ex = -33_s64
  else
    # 1 - u: 10^34 - V rounded (the fraction of 10^34 - V is 1 - frac)
    c = 10000000000000000000000000000000000_u128 -% ip
    if frac > half
      c = c -% 1_u128
    ex = -34_s64
  var tz = trailing_zeros10_u128(c: c, cap0: 34_s64)
  c = div_pow10_u128(x: c, k: tz)
  return (true, d128_of_parts(p: D128Parts(sign: false, special: 0_u64, exp: ex +% tz, coeff: c)))

### log1p(t) for a D128 t with |t| < 10^-6 as (sign, mag, scale, rel): log1p(t) = (-1)^sign mag 2^scale with
### mag normalized to [2^255, 2^256), within rel of it. t in fixed point (2 units of 2^-254) times the series
### F = sum (-t)^k / (k + 1).
secret routine d128x_log1p_wide(t: D128Parts) -> (Bool, Bool, U256, S64, B64)
  var (ok, ts) = d128x_fixed(t: t)
  if not ok or ts == 0_s256
    return (false, false, 0_u256, 0_s64, 0.0)
  var f = LLVM::reinterpret_bits[U256, S256](1_u256 << 254_u32)
  var p = ts
  var k = 1_u64
  while k < 20_u64 and p != 0_s256
    var term = d128x_div_small(a: p, k: k +% 1_u64)
    if (k & 1_u64) == 1_u64
      f = f -% term
    else
      f = f +% term
    p = d128x_smul(a: p, b: ts)
    k = k +% 1_u64
  if p != 0_s256
    return (false, false, 0_u256, 0_s64, 0.0)
  var tm = LLVM::reinterpret_bits[S256, U256](ts)
  if t.sign
    tm = 0_u256 -% tm
  # |t| F / 2^256 in units of 2^-252
  var l = u256_mulhi(a: tm, b: LLVM::reinterpret_bits[S256, U256](f))
  if l == 0_u256
    return (false, false, 0_u256, 0_s64, 0.0)
  var lz = LLVM::int_truncate[U256, S64](LLVM::leading_zeros(l))
  var kk = B64(from: k)
  var tv = b128fx_wide_b64(hi: LLVM::int_truncate[U256, U128](tm >>> 128_u32), lo: LLVM::int_truncate[U256, U128](tm))
  var rel = 3.0 /! tv +! (2.0 *! (kk +! 1.0) *! (kk +! 1.0) +! 8.0) *! 0x1p-253
  return (true, t.sign, l << b128_trig_sh(n: lz), -252_s64 -% lz, rel)
