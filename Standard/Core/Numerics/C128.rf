module Core

### A complex number with double-precision real and imaginary components.
### `C128` stores two `B64` values and is the standard complex type for general
### scientific and numeric code. Use `C256` when quadruple precision is needed.
record C128
obeys Numeric, Equatable, Hashable
    ### The real part.
    real: B64
    ### The imaginary part.
    imag: B64

# The math lives in Ingrid's Tessera library (`Ingrid/tessera/complex.tess`), which RazorForge and Suflae share:
# each routine below that computes hands the parts to a `C::ingrid_c128_*` routine (declared in
# Core/NativeDeclarations.rf). Its `+ - * /` are checked like B64's own, so a part that overflows or has no real
# value crashes as it does here, and the elementary functions are the same correctly rounded ones.

# Complex constants. `common routine` factories (not `preset`s): a `C128` value is a two-`B64` record, not
# a buildtime scalar constant, so inlining it at every use (what a `preset` does) leaves the
# construction unresolved / emits an undefined creator symbol at codegen.
### The complex zero value (0 + 0i). :returns: The resulting `C128` value.
common routine C128.zero() -> C128
    return C128(real: 0.0_b64, imag: 0.0_b64)

### The complex unit value (1 + 0i). :returns: The resulting `C128` value.
common routine C128.one() -> C128
    return C128(real: 1.0_b64, imag: 0.0_b64)

### The imaginary unit (0 + 1i). :returns: The resulting `C128` value.
common routine C128.i() -> C128
    return C128(real: 0.0_b64, imag: 1.0_b64)

### Reads the C128 an Ingrid routine hands back: the real part's bits in `w0`, the imaginary part's in `w1`.
secret routine c128_from_words(w: IngridWords) -> C128
    return C128(real: B64.from_bits(bits: w.w0), imag: B64.from_bits(bits: w.w1))

# ============================================================================
# Creators
# ============================================================================

### Constructs a `C128` with the given real component and zero imaginary part.
### :param from: The real-axis value.
### :returns: The corresponding `C128` value.
routine C128(from: B64) -> C128
    return C128(real: from, imag: 0.0_b64)

### Widens a `C64` to `C128` by extending each component to `B64`.
### :param from: The single-precision complex value to widen.
### :returns: A `C128` carrying the same numeric value.
routine C128(from: C64) -> C128
    return C128(real: B64(from.real), imag: B64(from.imag))

### Narrows a `C256` to `C128` by truncating each component to `B64`.
### :param from: The quadruple-precision complex value to narrow.
### :returns: The nearest representable `C128`.
routine C128(from: C256) -> C128
    return C128(real: B64(from.real), imag: B64(from.imag))

### Real scalar -> `C128` (imaginary part 0), routing the value through `B64`.
### :param from: A real integer or float value.
### :returns: `from + 0i` in double precision.
routine C128(from: S8) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `S16` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: S16) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `S32` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: S32) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `S64` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: S64) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `S128` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: S128) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `S256` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: S256) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `U8` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: U8) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `U16` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: U16) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `U32` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: U32) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `U64` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: U64) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `U128` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: U128) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `U256` scalar -> `C128` (imaginary part 0), value routed through `B64`.
### :param from: A real integer value.
### :returns: `from + 0i` in double precision.
routine C128(from: U256) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `B16` scalar -> `C128` (imaginary part 0), value widened to `B64`.
### :param from: A real float value.
### :returns: `from + 0i` in double precision.
routine C128(from: B16) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `B32` scalar -> `C128` (imaginary part 0), value widened to `B64`.
### :param from: A real float value.
### :returns: `from + 0i` in double precision.
routine C128(from: B32) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Real `B128` scalar -> `C128` (imaginary part 0), value narrowed to `B64`.
### :param from: A real float value.
### :returns: `from + 0i` in double precision.
routine C128(from: B128) -> C128
    return C128(real: B64(from: from), imag: 0.0_b64)

### Constructs a `C128` from polar coordinates: `r·cos(θ) + r·sin(θ)·i`.
### :param r: The modulus (distance from origin).
### :param theta: The argument (angle in radians).
### :returns: The complex value at that polar position.
routine C128.from_polar(r: B64, theta: B64) -> C128
    return c128_from_words(w: C::ingrid_c128_from_polar(r: r, theta: theta))

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Returns the complex sum `me + you` (component-wise addition).
### :param you: The addend.
### :returns: A `C128` whose components are the sums of the corresponding components.
@readonly
routine C128.add(you: C128) -> C128
    return C128(real: me.real + you.real, imag: me.imag + you.imag)

### Returns the complex difference `me - you` (component-wise subtraction).
### :param you: The value to subtract.
### :returns: A `C128` whose components are the differences of the corresponding components.
@readonly
routine C128.sub(you: C128) -> C128
    return C128(real: me.real - you.real, imag: me.imag - you.imag)

### Returns `me + you`, promoting the real `you` to complex (imaginary part 0). `+`/`-`/`*`/`/` accept
### a real operand; the component width must match (B64 pairs with C128).
### :param you: The real addend.
### :returns: The complex sum.
routine C128.add(you: B64) -> C128
    return me.add(C128(from: you))

### Returns `me - you`, promoting the real `you` to complex (imaginary part 0).
### :param you: The real value to subtract.
### :returns: The complex difference.
routine C128.sub(you: B64) -> C128
    return me.sub(C128(from: you))

### Returns `me * you` for a real `you` (both components scaled).
### :param you: The real factor.
### :returns: The scaled complex value.
@readonly
routine C128.mul(you: B64) -> C128
    return C128(real: me.real * you, imag: me.imag * you)

### Returns `me / you` for a real `you` (both components divided).
### :param you: The real divisor.
### :returns: The divided complex value.
@readonly
routine C128.truediv(you: B64) -> C128
    return C128(real: me.real / you, imag: me.imag / you)

### Returns the complex product `me * you` using the formula `(ac−bd) + (ad+bc)i`.
### :param you: The right operand.
### :returns: The Gaussian product.
routine C128.mul(you: C128) -> C128
    var w = C::ingrid_c128_mul(real: me.real, imag: me.imag, other_real: you.real, other_imag: you.imag)
    return c128_from_words(w: w)

### Returns the complex quotient `me / you`.
### Divides by the squared modulus of `you`.
### :param you: The divisor.
### :returns: The complex quotient.
routine C128.truediv(you: C128) -> C128
    var w = C::ingrid_c128_div(real: me.real, imag: me.imag, other_real: you.real, other_imag: you.imag)
    return c128_from_words(w: w)

### Returns the arithmetic negation of this value.
### :returns: A `C128` with both components negated.
@readonly
routine C128.neg() -> C128
    return C128(real: -me.real, imag: -me.imag)

# ============================================================================
# Comparison
# ============================================================================

### Returns `true` if both components compare equal.
### :param you: The value to compare against.
### :returns: `true` if `me.real == you.real` and `me.imag == you.imag`.
@readonly
routine C128.eq(you: C128) -> Bool
    return me.real == you.real and me.imag == you.imag

# ============================================================================
# Components and Properties
# ============================================================================

### Returns the modulus (absolute value) of this complex number.
### :returns: `√(real² + imag²)`.
routine C128.abs() -> B64
    return C::ingrid_c128_abs(real: me.real, imag: me.imag)

### Returns the phase angle of this complex value in radians.
### :returns: `atan2(imag, real)`, in the range (−π, π].
routine C128.arg() -> B64
    return C::ingrid_c128_arg(real: me.real, imag: me.imag)

### Returns the complex conjugate (negates the imaginary part).
### :returns: `real - imag·i`.
routine C128.conjugate() -> C128
    return C128(real: me.real, imag: -me.imag)

### Returns the squared modulus (avoids the square root of `abs`).
### :returns: `real² + imag²`.
routine C128.norm() -> B64
    return C::ingrid_c128_norm(real: me.real, imag: me.imag)

# ============================================================================
# Trigonometric (sinh/cosh computed from exp since B64 lacks native versions)
# ============================================================================

### Returns the complex sine using the identity `sin(a+bi) = sin(a)cosh(b) + i·cos(a)sinh(b)`.
### :returns: The complex sine of this value.
routine C128.sin() -> C128
    return c128_from_words(w: C::ingrid_c128_sin(real: me.real, imag: me.imag))

### Returns the complex cosine using the identity `cos(a+bi) = cos(a)cosh(b) − i·sin(a)sinh(b)`.
### :returns: The complex cosine of this value.
routine C128.cos() -> C128
    return c128_from_words(w: C::ingrid_c128_cos(real: me.real, imag: me.imag))

### Returns the complex tangent of this value.
### :returns: The complex tangent.
routine C128.tan() -> C128
    return c128_from_words(w: C::ingrid_c128_tan(real: me.real, imag: me.imag))

### Returns the complex arcsine of this value.
### :returns: The principal value of `arcsin(me)`.
routine C128.asin() -> C128
    return c128_from_words(w: C::ingrid_c128_asin(real: me.real, imag: me.imag))

### Returns the complex arccosine of this value.
### :returns: The principal value of `arccos(me)`.
routine C128.acos() -> C128
    return c128_from_words(w: C::ingrid_c128_acos(real: me.real, imag: me.imag))

### Returns the complex arctangent of this value.
### :returns: The principal value of `arctan(me)`.
routine C128.atan() -> C128
    return c128_from_words(w: C::ingrid_c128_atan(real: me.real, imag: me.imag))

# ============================================================================
# Hyperbolic (sinh/cosh computed from exp since B64 lacks native versions)
# ============================================================================

### Returns the complex hyperbolic sine of this value.
### :returns: The complex hyperbolic sine.
routine C128.sinh_unchecked() -> C128
    return c128_from_words(w: C::ingrid_c128_sinh(real: me.real, imag: me.imag))

### Returns the complex hyperbolic cosine of this value.
### :returns: The complex hyperbolic cosine.
routine C128.cosh_unchecked() -> C128
    return c128_from_words(w: C::ingrid_c128_cosh(real: me.real, imag: me.imag))

### Returns the complex hyperbolic tangent of this value.
### :returns: The complex hyperbolic tangent.
routine C128.tanh() -> C128
    return c128_from_words(w: C::ingrid_c128_tanh(real: me.real, imag: me.imag))

### Returns the complex inverse hyperbolic sine of this value.
### :returns: The principal value of `arcsinh(me)`.
routine C128.asinh() -> C128
    return c128_from_words(w: C::ingrid_c128_asinh(real: me.real, imag: me.imag))

### Returns the complex inverse hyperbolic cosine of this value.
### :returns: The principal value of `arccosh(me)`.
routine C128.acosh() -> C128
    return c128_from_words(w: C::ingrid_c128_acosh(real: me.real, imag: me.imag))

### Returns the complex inverse hyperbolic tangent of this value.
### :returns: The principal value of `arctanh(me)`.
routine C128.atanh() -> C128
    return c128_from_words(w: C::ingrid_c128_atanh(real: me.real, imag: me.imag))

# ============================================================================
# Exponential, Logarithmic, and Square Root
# ============================================================================

### Returns `e` raised to this complex value using `exp(a+bi) = eᵃ(cos(b) + i·sin(b))`.
### :returns: The complex exponential.
routine C128.exp_unchecked() -> C128
    return c128_from_words(w: C::ingrid_c128_exp(real: me.real, imag: me.imag))

### Returns the principal natural logarithm of this complex value.
### :returns: `log(|me|) + i·arg(me)`.
routine C128.log_unchecked() -> C128
    return c128_from_words(w: C::ingrid_c128_ln(real: me.real, imag: me.imag))

### Returns the base-10 logarithm of this complex value.
### :returns: `log(me) / ln(10)`.
routine C128.log10() -> C128
    return c128_from_words(w: C::ingrid_c128_log10(real: me.real, imag: me.imag))

### Returns the base-2 logarithm of this complex value.
### :returns: `log(me) / ln(2)`.
routine C128.log2() -> C128
    return c128_from_words(w: C::ingrid_c128_log2(real: me.real, imag: me.imag))

### Returns the multiplicative inverse `1/me` (conjugate over the squared modulus).
### :returns: `conj(me) / |me|²`.
routine C128.reciprocal() -> C128
    return c128_from_words(w: C::ingrid_c128_reciprocal(real: me.real, imag: me.imag))

### Returns the polar form `(magnitude, angle-in-radians)` — the inverse of `from_polar`.
### :returns: A tuple `(abs, arg)`.
routine C128.to_polar() -> (B64, B64)
    return (me.abs(), me.arg())

### Returns the complex square root, choosing the root with non-negative real part.
### :returns: The principal square root of this value.
routine C128.sqrt_unchecked() -> C128
    return c128_from_words(w: C::ingrid_c128_sqrt(real: me.real, imag: me.imag))

### Returns this complex value raised to the complex power `you`.
### :param you: The complex exponent.
### :returns: `me ** you`, computed as `exp(you · log(me))`.
@readonly
routine C128.pow(you: C128) -> C128
    var w = C::ingrid_c128_pow(real: me.real, imag: me.imag, other_real: you.real, other_imag: you.imag)
    return c128_from_words(w: w)

### Crashes unless both parts of `r` are finite: a NaN part is a domain error, an infinite part an
### overflow. The check behind the `!` forms of `exp`/`log`/`sqrt`/`sinh`/`cosh`.
routine c128_checked!(r: C128) -> C128
    if r.real.is_finite() and r.imag.is_finite()
        return r
    if r.real.is_nan() or r.imag.is_nan()
        throw NumericDomainError(description: "domain error: no complex result")
    throw NumericOverflowError(description: "overflow: out of range")

### Returns `e` raised to this value. Checked: crashes if a part of the result is not finite.
### Use `exp_unchecked` for raw IEEE 754 propagation.
### :returns: The complex exponential.
routine C128.exp!() -> C128
    return c128_checked(r: me.exp_unchecked())

### Returns the principal natural logarithm. Checked: crashes on `log(0)` (an infinite real part).
### Use `log_unchecked` for raw IEEE 754 propagation.
### :returns: `log(|me|) + i·arg(me)`.
routine C128.log!() -> C128
    return c128_checked(r: me.log_unchecked())

### Returns the principal square root. Checked: crashes if a part of the result is not finite.
### Use `sqrt_unchecked` for raw IEEE 754 propagation.
### :returns: The square root with non-negative real part.
routine C128.sqrt!() -> C128
    return c128_checked(r: me.sqrt_unchecked())

### Returns the hyperbolic sine. Checked: crashes if a part of the result is not finite.
### :returns: The complex hyperbolic sine.
routine C128.sinh!() -> C128
    return c128_checked(r: me.sinh_unchecked())

### Returns the hyperbolic cosine. Checked: crashes if a part of the result is not finite.
### :returns: The complex hyperbolic cosine.
routine C128.cosh!() -> C128
    return c128_checked(r: me.cosh_unchecked())

### Returns this value raised to the integer power `exp` by repeated squaring (exact up to rounding of
### each product, no `log`/`exp` round trip). A negative `exp` inverts first; `exp` 0 gives `1`.
### :param exp: The integer exponent.
### :returns: `me ** exp`.
routine C128.pow(exp: S64) -> C128
    return c128_from_words(w: C::ingrid_c128_powi(real: me.real, imag: me.imag, n: exp))

# ============================================================================
# Query Routines
# ============================================================================

### Returns `true` if both the real and imaginary parts are exactly zero.
### :returns: `true` if `me == C128.zero()`.
routine C128.is_zero() -> Bool
    return me.real == 0.0_b64 and me.imag == 0.0_b64

### Returns `true` if the imaginary part is exactly zero (the value lies on the real axis).
### :returns: `true` if `me.imag == 0.0`.
routine C128.is_real() -> Bool
    return me.imag == 0.0_b64

### Returns `true` if the real part is exactly zero (the value lies on the imaginary axis).
### :returns: `true` if `me.real == 0.0`.
routine C128.is_imaginary() -> Bool
    return me.real == 0.0_b64

### Returns `true` if either part is NaN.
routine C128.is_nan() -> Bool
    return me.real.is_nan() or me.imag.is_nan()

### Returns `true` if either part is infinite.
routine C128.is_infinite() -> Bool
    return me.real.is_infinite() or me.imag.is_infinite()

### Returns `true` if both parts are finite.
routine C128.is_finite() -> Bool
    return me.real.is_finite() and me.imag.is_finite()

# ============================================================================
# Text Representation
# ============================================================================

### Formats this value compactly as `a+bi` / `a-bi` (e.g. `1.5+2i`). The `i`
### spelling matches the imaginary literal suffixes, so output is valid
### literal syntax. Standard `represent` shape (no args) for f-string dispatch.
### :returns: The resulting `Text` value.
@override
routine C128.represent() -> Text
    var real_text = me.real.represent()
    var imag_abs = me.imag.abs().represent()
    if me.imag < 0.0_b64
        return real_text + "-" + imag_abs + "i"
    return real_text + "+" + imag_abs + "i"

### Formats this value as `a+bi` / `a-bi` with exactly `places` digits after the point in each part
### (see `B64.fixed`).
### :param places: The number of digits after the point.
### :returns: The resulting `Text` value.
routine C128.fixed(places: U64) -> Text
    var imag_abs = me.imag.abs().fixed(places)
    if me.imag < 0.0_b64
        return me.real.fixed(places) + "-" + imag_abs + "i"
    return me.real.fixed(places) + "+" + imag_abs + "i"

### Parses `a`, `bi`, `a+bi` or `a-bi` (a bare `i` / `-i` is a unit imaginary part), the form
### `represent` writes. Each part uses `B64`'s own number syntax.
### :param from_text: The text to parse.
### :returns: The parsed value.
### :throws: {InvalidValueError} if the text is not a complex number.
routine C128!(from_text: Text) -> C128
    var parts = split_complex_text(text: from_text, target: "C128")
    return C128(real: B64(from_text: parts.real), imag: B64(from_text: parts.imag))

### Returns the real component (the `real` field is also public).
### :returns: The real part as `B64`.
routine C128.real_part() -> B64
    return me.real

### Returns the imaginary component (the `imag` field is also public).
### :returns: The imaginary part as `B64`.
routine C128.imag_part() -> B64
    return me.imag

### Returns a diagnostic string wrapping the value with its type name (e.g. `C128(1.5+2i)`).
### Standard `diagnose` shape (no args) for f-string dispatch.
### :returns: The resulting `Text` value.
@override
routine C128.diagnose() -> Text
    return "C128(" + me.represent() + ")"

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this complex value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
@readonly
routine C128.hash(k0: U64, k1: U64) -> U64
    var acc = __hash_round(acc: 0u64, h: me.real.hash(k0: k0, k1: k1))
    acc = __hash_round(acc: acc, h: me.imag.hash(k0: k0, k1: k1))
    return __hash_finalize(h: acc)
