module Core

import BuilderQuery
### Multi-threaded strong reference to shared data under an access discipline `TPolicy`. Thin pointer to
### {GuardController[T, TPolicy]}. The atomic-refcount twin of {Retained[T]} — equivalent to `Arc[T]` in Rust.
### Cloning bumps the strong count atomically (`.share()`); dropping decrements it. Safe across threads.
###
### The discipline `TPolicy` (a {LockPolicy}: {ReadOnly} / {Exclusive} / {MultiRead}) is part of the type, so
### it is fixed at build time and selected by monomorphization — no runtime dispatch. Unlike
### {Retained[T]}, `Guarded` does NOT obey `Controlling[T]`: multi-threaded access to the guarded data is
### granted exclusively through the `Amending[T]` / `Consulting[T]` tokens (a later phase), whose legality
### the readers-XOR-writer access discipline derives from `TPolicy`. A `Guarded` is therefore an ownership handle —
### it refcounts and hands out weak references; reaching the inner value goes through a token.
### :typeparam T: The exclusively owned entity type.
### :typeparam TPolicy: The access-discipline lock policy.
@llvm("ptr")
record Guarded[T, TPolicy]
obeys Assignable
needs EntityType T
needs TPolicy obeys LockPolicy
    pass

# ============================================================================
# Construction
# ============================================================================

### `Guarded[T, TPolicy](from: n)`: ownership of the entity moves into the RC system.
routine Guarded[T, TPolicy](from: T) -> Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys LockPolicy
    danger
        var ctrl = GuardController[T, TPolicy](data: from.hijack()).hijack()
        return Guarded[T, TPolicy](ctrl)

# ============================================================================
# Reference counting
# ============================================================================

### Returns a new strong reference to the same entity, atomically incrementing the strong count.
### :returns: A new strong handle sharing the same underlying entity.
routine Guarded[T, TPolicy].share() -> Guarded[T, TPolicy]
    danger
        var ctrl = Hijacked[GuardController[T, TPolicy]](me).as_entity()
        ctrl.hold()
    return me

### A copy of this handle is one more holder of the same entity: assigning it shares it.
### :returns: A new handle to the same entity.
routine Guarded[T, TPolicy].assign() -> Guarded[T, TPolicy]
    return me.share()

### Creates a weak reference to the same entity.
### :returns: A new weak handle to the same entity's controller.
routine Guarded[T, TPolicy].observe() -> Witnessed[T, TPolicy]
    danger
        var ctrl = Hijacked[GuardController[T, TPolicy]](me).as_entity()
        ctrl.observe()
        return Witnessed[T, TPolicy](me)

# ============================================================================
# Access — open a scoped token over the guarded entity (use with `using`)
# ============================================================================

### Opens shared (multi-reader) access to the guarded entity. The returned {Consulting[T]} must be
### opened with `using`: entering the scope acquires the reader hold, leaving it releases. Legal only
### when `TPolicy` admits readers (`ReadOnly` / `MultiRead`); the access discipline rejects it otherwise.
### :returns: A scoped `Consulting[T, TPolicy]` read token.
### :note: Use as `using s.consult() as v` — a bare `consult()` never acquires the lock.
routine Guarded[T, TPolicy].consult() -> Consulting[T, TPolicy]
needs TPolicy in [MultiRead, ReadOnly]
    danger
        return Consulting[T, TPolicy](me)

### Opens shared (multi-reader) access for a *fallible*, non-blocking acquisition. Identical to
### `consult()` except intended for `using ... fallback`: entering the scope tries the reader hold
### once (via `try_enter`) and, on contention, runs the `fallback` branch instead of blocking.
### :returns: A scoped `Consulting[T, TPolicy]` read token.
### :note: Use as `using s.try_consult() as v` followed by a `fallback` branch.
routine Guarded[T, TPolicy].try_consult() -> Consulting[T, TPolicy]
needs TPolicy in [MultiRead, ReadOnly]
    danger
        return Consulting[T, TPolicy](me)

### Opens exclusive (read/write) access to the guarded entity. The returned {Amending[T]} must be
### opened with `using`: entering the scope acquires the exclusive amender hold, leaving it releases.
### Legal only when `TPolicy` admits a writer (`Exclusive` / `MultiRead`); the access discipline rejects it on
### `ReadOnly`.
### :returns: A scoped `Amending[T, TPolicy]` write token.
### :note: Use as `using s.amend() as c` — a bare `amend()` never acquires the lock.
routine Guarded[T, TPolicy].amend() -> Amending[T, TPolicy]
needs TPolicy in [Exclusive, MultiRead]
    danger
        return Amending[T, TPolicy](me)

### Opens exclusive access for a *fallible*, non-blocking acquisition. Identical to `amend()` except
### intended for `using ... fallback`: entering the scope tries the exclusive hold once (via
### `try_enter`) and, on contention, runs the `fallback` branch instead of blocking.
### :returns: A scoped `Amending[T, TPolicy]` write token.
### :note: Use as `using s.try_amend() as c` followed by a `fallback` branch.
routine Guarded[T, TPolicy].try_amend() -> Amending[T, TPolicy]
needs TPolicy in [Exclusive, MultiRead]
    danger
        return Amending[T, TPolicy](me)

# ============================================================================
# Inspection
# ============================================================================

### Returns the current strong reference count.
### :returns: The number of live strong handles to this entity.
routine Guarded[T, TPolicy].strong_count() -> U64
    danger
        var ctrl = Hijacked[GuardController[T, TPolicy]](me).as_entity()
        return ctrl.strong_count()

### Returns the current weak reference count.
### :returns: The number of live weak handles to this entity's controller.
routine Guarded[T, TPolicy].weak_count() -> U64
    danger
        var ctrl = Hijacked[GuardController[T, TPolicy]](me).as_entity()
        return ctrl.weak_count()

# ============================================================================
# Display (opaque — the inner value is reachable only through an access token)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Guarded[T, TPolicy].represent() -> Text
    danger
        return me.type_name()

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Guarded[T, TPolicy].diagnose() -> Text
    danger
        var ctrl = Hijacked[GuardController[T, TPolicy]](me).as_entity()
        var rc = ctrl.strong_count()
        var weak = ctrl.weak_count()
        var addr = ctrl.raw_data().get_address()
        return me.type_name() + "(holding: " + rc.represent() + ", observing: " + weak.represent() + ", addr: " + addr.represent() + ")"

### Decrements the strong count, tearing down the entity at zero (and the controller when both counts
### reach zero). This IS the decrement — no separate `release` verb; `destroy` is the teardown.
@override
dangerous routine Guarded[T, TPolicy].destroy()
    if Hijacked[GuardController[T, TPolicy]](me).get_address() == 0_addr
        return
    var ctrl = Hijacked[GuardController[T, TPolicy]](me).as_entity()
    ctrl.unhold()
    return
