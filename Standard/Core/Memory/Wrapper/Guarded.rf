module Core

import BuilderQuery
### Multi-threaded strong reference to shared data under an access discipline `TPolicy`. Thin pointer to
### {GuardManager[T, TPolicy]}. The atomic-refcount twin of {Retained[T]} — equivalent to `Arc[T]` in Rust.
### Cloning bumps the strong count atomically (`.share()`); dropping decrements it. Safe across threads.
###
### The discipline `TPolicy` (a {LockPolicy}: {ReadOnly} / {Exclusive} / {MultiRead}) is part of the type, so
### it is fixed at build time and selected by monomorphization — no runtime dispatch. Unlike
### {Retained[T]}, the guarded value is reached only through a token: `using g.view() as v` binds a {Viewing[T]}
### and `using g.modify() as m` a {Modifying[T]}. Under a lock (`Exclusive`, `MultiRead`) entering the `using` block
### takes the lock and leaving it releases it. Which accesses a policy admits (`view` or `modify`) follows from `TPolicy`.
### A `ReadOnly` value has no lock and is read directly.
### :typeparam T: The exclusively owned entity type.
### :typeparam TPolicy: The access-discipline lock policy.
@llvm("ptr")
record Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys LockPolicy
    pass

# ============================================================================
# Construction
# ============================================================================

### `Guarded[T, TPolicy](from: n)`: the entity moves into the handle, which shares it across threads.
routine Guarded[T, TPolicy](from: T) -> Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys LockPolicy
    danger
        var ctrl = GuardManager[T, TPolicy](data: from.hijack()).hijack()
        return Guarded[T, TPolicy](ctrl)

### The absent `Guarded[T, TPolicy]`: a null handle owning nothing. Sharing and tearing it down do nothing, so a
### value that holds one only sometimes (an empty `Text`) needs no flag of its own.
### :returns: The absent `Guarded[T, TPolicy]`.
routine guarded_none[T, TPolicy]() -> Guarded[T, TPolicy]
needs EntityType T
needs TPolicy obeys LockPolicy
    danger
        var null_address: Address = 0
        return Guarded[T, TPolicy](Hijacked[GuardManager[T, TPolicy]](from: null_address))

# ============================================================================
# Reference counting
# ============================================================================

### Returns a new strong reference to the same entity, atomically incrementing the strong count.
### :returns: A new strong handle sharing the same underlying entity.
@readonly
@override
secret routine Guarded[T, TPolicy].share() -> Guarded[T, TPolicy]
    danger
        if Hijacked[GuardManager[T, TPolicy]](me).get_address() == 0
            return me
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.hold()
    return me

### Creates a weak reference to the same entity.
### :returns: A new weak handle to the same entity's controller.
routine Guarded[T, TPolicy].observe() -> Witnessed[T, TPolicy]
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.observe()
        return Witnessed[T, TPolicy](me)

# ============================================================================
# Access — read or change the guarded entity (opened with `using` under a lock)
# ============================================================================

### Opens read access to the value of a `Guarded` with the `MultiRead` policy: `using g.view() as v`. Entering the
### `using` block takes a read hold on the lock (other readers may hold one at the same time, a writer waits) and binds
### `v`, a {Viewing[T]}. Every way out of the block releases the hold. The hold lasts exactly as long as the block, so
### `view()` on this policy is opened only by `using`.
### :returns: What `using` opens: it takes the read hold and binds the {Viewing[T]}.
@readonly
routine Guarded[T, TPolicy].view() -> ViewingGuarded[T, TPolicy]
needs TPolicy in [MultiRead]
    danger
        return ViewingGuarded[T, TPolicy](me)

### Read access to the value of a `Guarded` with the `ReadOnly` policy, which has no lock to take: `g.name` and
### `g.label()` read through it directly, and `using g.view() as v` binds the same {Viewing[T]}.
### :returns: A read token on the guarded entity.
@readonly
routine Guarded[T, TPolicy].view() -> Viewing[T]
needs TPolicy in [ReadOnly]
    danger
        return Viewing[T](Hijacked[GuardManager[T, TPolicy]](me).as_entity().raw_data())

### Opens read access without waiting: `using g.try_view() as v` followed by a `fallback` branch. Entering the `using`
### block tries the read hold once. When a writer holds the lock right now, the `fallback` branch runs instead and
### nothing is held.
### :returns: What `using` opens: it tries the read hold and binds the {Viewing[T]}.
@readonly
routine Guarded[T, TPolicy].try_view() -> ViewingGuarded[T, TPolicy]
needs TPolicy in [MultiRead, ReadOnly]
    danger
        return ViewingGuarded[T, TPolicy](me)

### Opens write access to the value of a `Guarded` with the `Exclusive` or `MultiRead` policy:
### `using g.modify() as m`. Entering the `using` block takes the write hold on the lock (it waits until no reader and
### no other writer holds it) and binds `m`, a {Modifying[T]}. Every way out of the block releases the hold. The hold
### lasts exactly as long as the block, so `modify()` is opened only by `using`.
### :returns: What `using` opens: it takes the write hold and binds the {Modifying[T]}.
@readonly
routine Guarded[T, TPolicy].modify() -> ModifyingGuarded[T, TPolicy]
needs TPolicy in [Exclusive, MultiRead]
    danger
        return ModifyingGuarded[T, TPolicy](me)

### Opens write access without waiting: `using g.try_modify() as m` followed by a `fallback` branch. Entering the
### `using` block tries the write hold once. When any reader or writer holds the lock right now, the `fallback` branch
### runs instead and nothing is held.
### :returns: What `using` opens: it tries the write hold and binds the {Modifying[T]}.
@readonly
routine Guarded[T, TPolicy].try_modify() -> ModifyingGuarded[T, TPolicy]
needs TPolicy in [Exclusive, MultiRead]
    danger
        return ModifyingGuarded[T, TPolicy](me)

# ============================================================================
# Inspection
# ============================================================================

### Returns the current strong reference count.
### :returns: The number of live strong handles to this entity.
routine Guarded[T, TPolicy].strong_count() -> U64
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return ctrl.strong_count()

### Returns the current weak reference count.
### :returns: The number of live weak handles to this entity's controller.
routine Guarded[T, TPolicy].weak_count() -> U64
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return ctrl.weak_count()

# ============================================================================
# Display (opaque — the inner value is reachable only through a token)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Guarded[T, TPolicy].represent() -> Text
    danger
        return me.type_name()

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@readonly
@override
routine Guarded[T, TPolicy].diagnose() -> Text
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        var rc = ctrl.strong_count()
        var weak = ctrl.weak_count()
        var addr = ctrl.raw_data().get_address()
        return me.type_name() + "(holding: " + rc.represent() + ", observing: " + weak.represent() + ", addr: " + addr.represent() + ")"

### `steal handle`: the entity comes out of the handle, which ends. The builder calls this for `steal` on a
### `Guarded`, for example to share a table under another policy once the threads that filled it are done. Weak
### handles see the entity gone afterwards.
### :returns: The entity.
### :throws: {SharedHandleStealError} when another strong handle still shares the entity.
failable dangerous routine Guarded[T, TPolicy].release_inner() -> T
    var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
    var holders = ctrl.strong_count()
    if holders != 1
        throw SharedHandleStealError(holders: holders)
    return ctrl.release_data().as_entity()

### Decrements the strong count, tearing down the entity at zero (and the controller when both counts
### reach zero). This IS the decrement — no separate `release` verb; `destruct` is the teardown.
@override
routine Guarded[T, TPolicy].destruct()
    danger
        if Hijacked[GuardManager[T, TPolicy]](me).get_address() == 0
            return
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.unhold()
        return
