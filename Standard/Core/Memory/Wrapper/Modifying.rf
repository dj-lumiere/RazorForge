module Core

import BuilderQuery
### Represents temporary mutable access to a value where it is stored: an entity, or a record in its place
### (a container slot). It is the address of that place, the same as `Hijacked[T]`.
### `Modifying[T]` is the non-Assignable access type used for explicit low-level manipulation outside the scoped-access wrappers.
### :typeparam T: The type being accessed.
### :see: {Viewing[T]}, {Hijacked[T]}, {Access-Types}
@llvm("ptr")
record Modifying[T]
obeys Controlling[T], Enterable
    pass

### Produces a temporary unmanaged mutable view of `me`.
### :returns: The resulting `Modifying[T]` value.
### :note: Entity-only. Records are value-typed — `me` would be a by-value copy, so mutating
###        through the returned `Modifying[T]` would write to a stack temporary rather than the
###        caller's storage. Use `entity` for scoped mutation.
routine T.modify() -> Modifying[T]
needs EntityType T
    danger
        return Modifying[T](me.hijack())

# NOTE: No creators, no manual methods - all operations handled by builder
# The address member variable is managed internally by the `.modify()` implementation
# Users should NEVER create Modifying[T] values directly

# ============================================================================
# Resource management — enables `using entity.modify() as h`
# ============================================================================

### Called on entry to a `using` block; passes the modify through as the bound value (access is
### already established by `.modify()`).
### :returns: This modify token as `Modifying[T]`.
routine Modifying[T].enter() -> Modifying[T]
    return me

### Called on exit from a `using` block; no-op for a modify (the builder handles scope cleanup).
routine Modifying[T].exit()
    return

# ============================================================================
# Marker-protocol coercion (access/control) — yields the inner entity as T
# ============================================================================

### Yields the value the token points at, for read-only access: a record read out of its place as a holder
### of its own (as `getitem` gives one). Inserted implicitly at call sites whose parameter is `Accessing[T]`.
### :returns: The value as `T`.
@readonly
@inline
@overridable
routine Modifying[T].access() -> T
needs AnyType T
needs T obeys Assignable
    danger
        return Hijacked[T](me).peek().assign()

### `access` for a single-owner entity: the entity itself as an in-flight `T` reference.
### :returns: The inner entity as `T`.
@readonly
@inline
@override
routine Modifying[T].access() -> T
needs EntityType T
    danger
        return Hijacked[T](me).as_entity()

### Yields the value the token points at, for read/write access: a record read out of its place. A write to a
### record's member through the token goes to the place itself, not to this value.
### Inserted implicitly at call sites whose parameter is `Controlling[T]`.
### :returns: The value as `T`.
@inline
@overridable
routine Modifying[T].control() -> T
needs AnyType T
needs T obeys Assignable
    danger
        return Hijacked[T](me).peek().assign()

### `control` for a single-owner entity: the entity itself as an in-flight `T` reference, changed in place.
### :returns: The inner entity as `T`.
@inline
@override
routine Modifying[T].control() -> T
needs EntityType T
    danger
        return Hijacked[T](me).as_entity()

# ============================================================================
# Display (transparent - delegates to inner value)
# ============================================================================

### Returns the display form of the modifying entity.
### :returns: The resulting `Text` value.
@readonly
@override
routine Modifying[T].represent() -> Text
    # Through `access`, which reads an entity in place and a record out of its slot.
    return me.access().represent()

### Returns the diagnostic form of the modifying entity.
### :returns: The resulting `Text` value.
@readonly
@override
routine Modifying[T].diagnose() -> Text
    return me.type_name() + "(" + me.access().diagnose() + ")"

@override
dangerous routine Modifying[T].destroy()
    return
