module Core

import BuilderQuery
### Represents temporary thread-safe exclusive (read/write) access to data guarded by a {Guarded[T, TPolicy]}.
### `Amending[T]` is the non-Assignable token produced by `Guarded.amend()` for exclusive access. It holds
### the shared {GuardManager[T, TPolicy]} pointer; entering its `using` scope (`enter`) acquires the
### exclusive amender hold on the controller's access-discipline lock and exiting (`exit`) releases it,
### so the lock spans exactly the `using` block. At most one amender may exist, with no concurrent
### {Consulting[T]}; the readers-XOR-writer access discipline enforces this. Must be opened with `using` —
### a bare/inline `amend()` would never acquire the lock.
### :typeparam T: The entity type being amended.
### :typeparam TPolicy: The access-discipline lock policy of the originating `Guarded`.
### :see: {Consulting[T]}, {Modifying[T]}, {Guarded[T, TPolicy]}, {Access-Types}
@llvm("ptr")
record Amending[T, TPolicy]
obeys Enterable
needs EntityType T
needs TPolicy obeys LockPolicy
    pass

# NOTE: No creators, no manual methods — the token is produced only by `Guarded.amend()`, which
# constructs it from the controller pointer. Users never create one.

# ============================================================================
# Resource management — enables `using shared.amend() as c`
# ============================================================================

### Called on entry to the `using` block: acquires the exclusive amender hold on the controller's
### access-discipline lock, then passes the token through as the bound value. Pairs with `exit`,
### so the lock spans exactly the `using` scope.
### :returns: This token as `Amending[T, TPolicy]`.
routine Amending[T, TPolicy].enter() -> Amending[T, TPolicy]
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.add_claimer()
    return me

### Called on entry to a *fallible* `using ... fallback` block: attempts the exclusive amender hold
### once, without blocking. Returns `true` if the hold was acquired (the `using` body runs and `exit`
### will release it) or `false` on contention (the `fallback` branch runs; nothing is held).
### :returns: `true` if the exclusive hold was acquired, `false` otherwise.
routine Amending[T, TPolicy].try_enter() -> Bool
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return ctrl.try_add_claimer()

### Called on exit from the `using` block (and on every escape): releases the amender hold.
routine Amending[T, TPolicy].exit()
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        ctrl.remove_claimer()
    return

# ============================================================================
# Tokens on the held entity
# ============================================================================

### Read access to the guarded entity while the hold lasts. A call hands this to a `Viewing[T]` parameter given the `Amending` token.
### :returns: The token.
@readonly
routine Amending[T, TPolicy].view() -> Viewing[T]
    danger
        return Viewing[T](Hijacked[GuardManager[T, TPolicy]](me).as_entity().raw_data())

### Write access to the guarded entity while the hold lasts. A call hands this to a `Modifying[T]` parameter given the `Amending` token.
### :returns: The token.
routine Amending[T, TPolicy].modify() -> Modifying[T]
    danger
        return Modifying[T](Hijacked[GuardManager[T, TPolicy]](me).as_entity().raw_data())

# ============================================================================
# Display (transparent — delegates to the guarded entity through the controller)
# ============================================================================

### Returns the display form of the amended entity.
### :returns: The resulting `Text` value.
@readonly
@override
routine Amending[T, TPolicy].represent() -> Text
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return ctrl
            .raw_data()
            .as_entity()
            .represent()

### Returns the diagnostic form of the amended entity.
### :returns: The resulting `Text` value.
@readonly
@override
routine Amending[T, TPolicy].diagnose() -> Text
    danger
        var ctrl = Hijacked[GuardManager[T, TPolicy]](me).as_entity()
        return me.type_name() + "(" + ctrl
            .raw_data()
            .as_entity()
            .diagnose() + ")"

### No-op: the token owns no heap (it only aliases the controller), and the amender hold is
### released by `exit`. Releasing here too would double-release the lock.
@override
routine Amending[T, TPolicy].destruct()
    return
