module Core

### Represents the protocol for moving a position back by a number of bytes, and for the distance between two
### positions. `OffsetSubtractable` is used by memory positions such as `Address`.
protocol OffsetSubtractable
    ### Returns this position moved back by `offset` bytes.
    ### :param offset: The byte count to subtract.
    ### :returns: The resulting `Me` value.
    @readonly
    routine Me.sub(offset: ByteSize) -> Me

    ### Returns the number of bytes from `you` to this position.
    ### :param you: The other position.
    ### :returns: The distance as a `ByteSize`.
    @readonly
    routine Me.sub(you: Me) -> ByteSize
