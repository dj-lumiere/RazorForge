### Builds an `Address` from its serialized text. :throws: {SerialShapeError} or a parse error.
routine Address!(from: SerialValue) -> Address
    return Address(from_text: serial_text(value: from))

# ============================================================================
# Collections
# ============================================================================

### Builds a `List[T]` from its serialized element list.
### :throws: {SerialShapeError} when the value is not a list or an element does not fit `T`.
routine List[T]!(from: SerialValue) -> List[T]
    var result = List[T]()
    when from
        is List[SerialValue] items =>
            each item in items
                result.add_last(value: serial_decode[T](value: item))
        else =>
            throw SerialShapeError(detail: "expected a list")
    return steal result
