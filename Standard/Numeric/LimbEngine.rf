module Numerics

# The 64-bit limb layer of the libbf port that {Integer}'s engine (IntegerEngine.rf) is built on: add,
# subtract, the schoolbook and NTT multiplies, Newton division and the Karatsuba square root, each over
# little-endian U64 limbs. Like the integer engine it allocates nothing: every temporary comes from the
# call's scratch arena (Ingrid/tessera/scratch.tess), and each routine that takes scratch has a `_scratch`
# routine that bounds it. See THIRD-PARTY-NOTICES.md for libbf.

# Low 64 bits of a 128-bit value (the stdlib only narrows U128->U64 via this intrinsic, since U64(from: U128)
# is a CHECKED conversion that throws on overflow, so it can't take a limb's low word).
secret routine u128_lo(t: U128) -> U64
    danger
        return LLVM::int_truncate[U128, U64](t)

# Low 64 bits of a signed 128-bit value (for the borrow arithmetic in mp_sub).
secret routine s128_lo(t: S128) -> U64
    danger
        return LLVM::int_truncate[S128, U64](t)

# Take `n` zeroed U64 limbs from the call's scratch arena. An admission covering them comes first.
secret dangerous routine alloc_limbs(n: U64) -> Hijacked[U64]
    return C::ingrid_scratch_take(limbs: n)

# True when `limbs` more limbs fit in the call's scratch arena. A refusal exhausts the call.
secret routine scratch_admit(limbs: U64) -> Bool
    danger
        return C::ingrid_scratch_admit(limbs: limbs)

# limb i of a buffer (pointer + element stride).
secret dangerous routine limb(tab: Hijacked[U64], i: U64) -> U64
    return tab.stride(count: S64(from: i)).peek()

secret dangerous routine set_limb(tab: Hijacked[U64], i: U64, value: U64)
    tab.stride(count: S64(from: i)).poke(value: value)
    return

# res[0..n) = op1 + op2 + carry_in. Returns the carry out (0 or 1). (libbf mp_add)
secret dangerous routine limbs_add(
    res: Hijacked[U64],
    op1: Hijacked[U64],
    op2: Hijacked[U64],
    n: U64,
    carry: U64,
) -> U64
    var k = U128(from: carry)
    var i = 0u64
    while i < n
        var a = U128(from: limb(tab: op1, i: i)) +% U128(from: limb(tab: op2, i: i)) +% k
        set_limb(tab: res, i: i, value: u128_lo(t: a))
        k = a >> 64
        i = i +% 1u64
    return u128_lo(t: k)

# tab[0..n) += b, propagating carry, stopping early once it dies. Returns the final carry. (libbf mp_add_ui)
secret dangerous routine limbs_add_word(tab: Hijacked[U64], b: U64, n: U64) -> U64
    var k = U128(from: b)
    var i = 0u64
    while i < n
        if k == 0u128
            return 0u64
        var a = U128(from: limb(tab: tab, i: i)) +% k
        set_limb(tab: tab, i: i, value: u128_lo(t: a))
        k = a >> 64
        i = i +% 1u64
    return u128_lo(t: k)

# res[0..n) = op1 - op2 - borrow_in. Returns the borrow out (0 or 1). (libbf mp_sub)
secret dangerous routine limbs_sub(
    res: Hijacked[U64],
    op1: Hijacked[U64],
    op2: Hijacked[U64],
    n: U64,
    borrow_in: U64,
) -> U64
    var borrow = S128(from: borrow_in)
    var i = 0u64
    while i < n
        var d = S128(from: limb(tab: op1, i: i)) -% S128(from: limb(tab: op2, i: i)) -% borrow
        if d < 0s128
            d = d +% 18446744073709551616s128
            borrow = 1s128
        else
            borrow = 0s128
        set_limb(tab: res, i: i, value: s128_lo(t: d))
        i = i +% 1u64
    return s128_lo(t: borrow)

# tabr[0..n) = taba * b + l. Returns the high carry. (libbf mp_mul1)
secret dangerous routine limbs_mul_word(
    tabr: Hijacked[U64],
    taba: Hijacked[U64],
    n: U64,
    b: U64,
    l: U64,
) -> U64
    var carry = U128(from: l)
    var i = 0u64
    while i < n
        var t = U128(from: limb(tab: taba, i: i)) *% U128(from: b) +% carry
        set_limb(tab: tabr, i: i, value: u128_lo(t: t))
        carry = t >> 64
        i = i +% 1u64
    return u128_lo(t: carry)

# tabr[0..n) += taba * b. Returns the high word. (libbf mp_add_mul1)
secret dangerous routine limbs_addmul_word(
    tabr: Hijacked[U64],
    taba: Hijacked[U64],
    n: U64,
    b: U64,
) -> U64
    var l = U128(from: 0u64)
    var i = 0u64
    while i < n
        var t = U128(from: limb(tab: taba, i: i)) *% U128(from: b) +% l +% U128(
            from: limb(tab: tabr, i: i),
        )
        set_limb(tab: tabr, i: i, value: u128_lo(t: t))
        l = t >> 64
        i = i +% 1u64
    return u128_lo(t: l)

# tab[0..n) -= b, propagating borrow, stopping early once it dies. Returns the final borrow. (libbf mp_sub_ui)
secret dangerous routine limbs_sub_word(tab: Hijacked[U64], b: U64, n: U64) -> U64
    var k = b
    var i = 0u64
    while i < n
        var v = limb(tab: tab, i: i)
        var a = v -% k
        k = if a > v then 1u64 else 0u64
        set_limb(tab: tab, i: i, value: a)
        if k == 0u64
            return 0u64
        i = i +% 1u64
    return k

# tab_r[0..n) = (tab + high*B^n) >> shift. Returns the shifted-out remainder (0 <= r < 2^shift).
# 1 <= shift <= 63. (libbf mp_shr)
secret dangerous routine limbs_shr(
    tab_r: Hijacked[U64],
    tab: Hijacked[U64],
    n: U64,
    shift: U32,
    high: U64,
) -> U64
    var l = high
    var i = n
    while i > 0u64
        i = i -% 1u64
        var a = limb(tab: tab, i: i)
        set_limb(tab: tab_r, i: i, value: (a >> shift) | (l << 64u32 -% shift))
        l = a
    return l & (1u64 << shift) -% 1u64

# tabr[0..n) -= taba * b. Returns the value to subtract from the high word (the borrow). (libbf mp_sub_mul1)
secret dangerous routine limbs_submul_word(
    tabr: Hijacked[U64],
    taba: Hijacked[U64],
    n: U64,
    b: U64,
) -> U64
    var l = 0u64
    var i = 0u64
    while i < n
        var t = U128(from: limb(tab: tabr, i: i)) -% U128(
            from: limb(tab: taba, i: i),
        ) *% U128(from: b) -% U128(from: l)
        set_limb(tab: tabr, i: i, value: u128_lo(t: t))
        l = 0u64 -% u128_lo(t: t >> 64)
        i = i +% 1u64
    return l

# result[0..op1_size+op2_size) = op1 * op2 (schoolbook). result must hold op1_size+op2_size limbs.
# (libbf mp_mul_basecase)
secret dangerous routine limbs_mul_schoolbook(
    result: Hijacked[U64],
    op1: Hijacked[U64],
    op1_size: U64,
    op2: Hijacked[U64],
    op2_size: U64,
)
    set_limb(
        tab: result,
        i: op1_size,
        value: limbs_mul_word(
            tabr: result,
            taba: op1,
            n: op1_size,
            b: limb(tab: op2, i: 0u64),
            l: 0u64,
        ),
    )
    var i = 1u64
    while i < op2_size
        var r = limbs_addmul_word(
            tabr: result.stride(count: S64(from: i)),
            taba: op1,
            n: op1_size,
            b: limb(tab: op2, i: i),
        )
        set_limb(tab: result, i: i +% op1_size, value: r)
        i = i +% 1u64
    return

# ── NTT modular arithmetic primitives (libbf.c ~7421-7511) ──────────────────────────────────
# 64-bit config: NB_MODS=5, NTT_MOD_LOG2_MIN=61, NTT_MOD_LOG2_MAX=62, NTT_PROOT_2EXP=51. The five
# NTT-friendly primes (each ~2^62, = k*2^51 + 1 so 2^51 | (m-1), enough roots of unity for the FFT).
secret routine ntt_mod(idx: U64) -> U64
    if idx == 0u64
        return 0x28D8000000000001u64
    if idx == 1u64
        return 0x2A88000000000001u64
    if idx == 2u64
        return 0x2ED8000000000001u64
    if idx == 3u64
        return 0x3508000000000001u64
    return 0x3AA8000000000001u64

# High 64 bits of a U128.
secret routine u128_hi(t: U128) -> U64
    danger
        return u128_lo(t: t >> 64)

# Arithmetic (sign-propagating) shift-right-by-1 of a limb, treating it as signed. Used by mod_fast to
# turn the high word into an all-ones / all-zeros correction mask.
secret routine asr1(x: U64) -> U64
    danger
        return LLVM::reinterpret_bits[S64, U64](LLVM::reinterpret_bits[U64, S64](x) >> 1u32)

# add/sub modulo (a, b already reduced enough that one conditional fixup suffices). (libbf add_mod/sub_mod)
secret routine add_mod(a: U64, b: U64, m: U64) -> U64
    var r = a +% b
    return if r >= m then r -% m else r

secret routine sub_mod(a: U64, b: U64, m: U64) -> U64
    var r = a -% b
    return if r > a then r +% m else r

# Reciprocal seed for mod_fast: floor(2^(64+61) / m). (libbf init_mul_mod_fast)
secret routine init_mul_mod_fast(m: U64) -> U64
    danger
        return u128_lo(t: (1u128 << 125) // U128(from: m))

# Reduce a 125-bit product r modulo m using the precomputed m_inv. Precondition 0 <= r < 2^125.
# (libbf mod_fast — Barrett-style with two conditional add-backs of m via the sign mask.)
secret routine mod_fast(r: U128, m: U64, m_inv: U64) -> U64
    danger
        var a1 = u128_lo(t: r >> 61)
        var q = u128_lo(t: U128(from: a1) *% U128(from: m_inv) >> 64)
        var rr = r -% U128(from: q) *% U128(from: m) -% (U128(from: m) << 1)
        var r1 = u128_hi(t: rr)
        var t0 = asr1(x: r1)
        rr = rr +% U128(from: m & t0)
        var r0 = u128_lo(t: rr)
        r1 = u128_hi(t: rr)
        r0 = r0 +% (m & r1)
        return r0

# (a * b) mod m via mod_fast. Precondition 0 <= a*b < 2^125 (holds for a, b < m ~ 2^62). (mul_mod_fast)
secret routine mul_mod_fast(a: U64, b: U64, m: U64, m_inv: U64) -> U64
    danger
        return mod_fast(r: U128(from: a) *% U128(from: b), m: m, m_inv: m_inv)

# Constant-multiplier reciprocal: floor(b * 2^64 / m). (libbf init_mul_mod_fast2)
secret routine init_mul_mod_fast2(b: U64, m: U64) -> U64
    danger
        return u128_lo(t: (U128(from: b) << 64) // U128(from: m))

# (a * b) mod m with b constant (b_inv = init_mul_mod_fast2(b, m)), the result fully reduced. (mul_mod_fast2)
secret routine mul_mod_fast2(a: U64, b: U64, m: U64, b_inv: U64) -> U64
    danger
        var q = u128_lo(t: U128(from: a) *% U128(from: b_inv) >> 64)
        var r = a *% b -% q *% m
        return if r >= m then r -% m else r

# Like mul_mod_fast2 but returns r or r+m (one extra m allowed — the FFT butterflies tolerate it).
secret routine mul_mod_fast3(a: U64, b: U64, m: U64, b_inv: U64) -> U64
    danger
        var q = u128_lo(t: U128(from: a) *% U128(from: b_inv) >> 64)
        return a *% b -% q *% m

# Zero n limbs.
secret dangerous routine zero_limbs(tab: Hijacked[U64], n: U64)
    var i = 0u64
    while i < n
        set_limb(tab: tab, i: i, value: 0u64)
        i = i +% 1u64
    return

# ceil(log2(a)) = bit-length of (a-1), 0 for a <= 1. (libbf ceil_log2, clz-free)
secret routine ceil_log2(a: U64) -> U64
    if a <= 1u64
        return 0u64
    var v = a -% 1u64
    var n = 0u64
    while v > 0u64
        v = v >> 1u32
        n = n +% 1u64
    return n

# Bits [pos, pos+64) of a little-endian limb buffer (0 past the end). (libbf get_bits)
secret dangerous routine get_bits(tab: Hijacked[U64], len: U64, pos: U64) -> U64
    var i = pos >> 6u32
    var p = U32(from: pos & 63u64)
    var a0 = if i < len then limb(tab: tab, i: i) else 0u64
    if p == 0u32
        return a0
    var i1 = i +% 1u64
    var a1 = if i1 < len then limb(tab: tab, i: i1) else 0u64
    return (a0 >> p) | (a1 << 64u32 -% p)

# OR `val`'s bits into the buffer at bit position `pos`. (libbf put_bits)
secret dangerous routine put_bits(tab: Hijacked[U64], len: U64, pos: U64, val: U64)
    var i = pos >> 6u32
    var p = U32(from: pos & 63u64)
    if i < len
        set_limb(tab: tab, i: i, value: limb(tab: tab, i: i) | (val << p))
    if p != 0u32
        var i1 = i +% 1u64
        if i1 < len
            set_limb(tab: tab, i: i1, value: limb(tab: tab, i: i1) | (val >> 64u32 -% p))
    return

# NTT integer-bit budget per mod count (ntt_int_bits[5], 64-bit).
secret routine ntt_int_bits(idx: U64) -> U64
    if idx == 0u64
        return 307u64
    if idx == 1u64
        return 246u64
    if idx == 2u64
        return 185u64
    if idx == 3u64
        return 123u64
    return 61u64

# m_inv for mod idx (= s->ntt_mods_div[idx]).
secret routine ntt_mod_div(idx: U64) -> U64
    danger
        return init_mul_mod_fast(m: ntt_mod(idx: idx))

# NTT-limb <-> int (scalar): int_to is identity, to_int reduces once.
secret routine ntt_limb_to_int(a: U64, m: U64) -> U64
    danger
        return if a >= m then a -% m else a

# The 10 CRT constants (ntt_mods_cr[10], 64-bit).
secret routine ntt_mod_cr(l: U64) -> U64
    if l == 0u64
        return 0x08A9ED097B425EEAu64
    if l == 1u64
        return 0x18A44AAAAAAAAAB3u64
    if l == 2u64
        return 0x2493F57F57F57F5Du64
    if l == 3u64
        return 0x126B8D0649A7F8D4u64
    if l == 4u64
        return 0x09D80ED7303B5CCCu64
    if l == 5u64
        return 0x25B8BCF3CF3CF3D5u64
    if l == 6u64
        return 0x2CE6CE63398CE638u64
    if l == 7u64
        return 0x0E31FAD40A57EB59u64
    if l == 8u64
        return 0x02A3529FD4A7F52Fu64
    return 0x3A5493E93E93E94Au64

# The mod index k paired with each CRT constant l in the (j,k) triangle over all 5 mods.
secret routine cr_k(l: U64) -> U64
    if l == 0u64
        return 1u64
    if l == 1u64
        return 2u64
    if l == 2u64
        return 3u64
    if l == 3u64
        return 4u64
    if l == 4u64
        return 2u64
    if l == 5u64
        return 3u64
    if l == 6u64
        return 4u64
    if l == 7u64
        return 3u64
    if l == 8u64
        return 4u64
    return 4u64

# cr_inv[l] = init_mul_mod_fast2(cr[l], ntt_mods[cr_k(l)]). (ntt_static_init)
secret routine ntt_mod_cr_inv(l: U64) -> U64
    danger
        return init_mul_mod_fast2(b: ntt_mod_cr(l: l), m: ntt_mod(idx: cr_k(l: l)))

# Choose (fft_len_log2, dpl, nb_mods) minimizing FFT cost for a product of `len` limbs. (bf_get_fft_size)
secret routine bf_get_fft_size(len: U64) -> (U64, U64, U64)
    var min_cost = 0xFFFFFFFFFFFFFFFFu64
    var dpl_found = 0u64
    var nb_mods_found = 4u64
    var fft_len_log2_found = 0u64
    var nb_mods = 3u64
    while nb_mods <= 5u64
        var int_bits = ntt_int_bits(idx: 5u64 -% nb_mods)
        var cap = 2u64 *% 64u64 +% 2u64 *% 61u64 -% 62u64  # 2*LIMB_BITS + 2*MIN - MAX = 188
        var half = (int_bits -% 4u64) // 2u64
        var dpl = if half < cap then half else cap
        var brk = false
        while not brk
            var fll = ceil_log2(a: (len *% 64u64 +% dpl -% 1u64) // dpl)
            if fll > 51u64  # NTT_PROOT_2EXP
                brk = true
            else
                var n_bits = fll +% 2u64 *% dpl
                if n_bits <= int_bits
                    var cost = (fll +% 1u64 << U32(from: fll)) *% nb_mods
                    if cost < min_cost
                        min_cost = cost
                        dpl_found = dpl
                        nb_mods_found = nb_mods
                        fft_len_log2_found = fll
                    brk = true
                else
                    dpl = dpl -% 1u64
                    if dpl == 0u64
                        brk = true
        nb_mods = nb_mods +% 1u64
    if dpl_found > 125u64 and (125u64 << U32(from: fft_len_log2_found)) >= len *% 64u64
        dpl_found = 125u64
    return (fft_len_log2_found, dpl_found, nb_mods_found)

# Repack `a_len` limbs of `taba` into dpl-bit digits, each reduced mod the top nb_mods primes, laid out
# as tabr[i + j*fft_len]. (libbf limb_to_ntt)
secret dangerous routine limb_to_ntt(
    tabr: Hijacked[U64],
    fft_len: U64,
    taba: Hijacked[U64],
    a_len: U64,
    dpl: U64,
    first_m_idx: U64,
    nb_mods: U64,
)
    zero_limbs(tab: tabr, n: fft_len *% nb_mods)
    var shift = U32(from: dpl & 63u64)
    var base_mask1 = if shift == 0u32 then 0xFFFFFFFFFFFFFFFFu64 else (1u64 << shift) -% 1u64
    var ndig = (a_len *% 64u64 +% dpl -% 1u64) // dpl
    var n = if fft_len < ndig then fft_len else ndig
    var i = 0u64
    while i < n
        var a0 = get_bits(tab: taba, len: a_len, pos: i *% dpl)
        var a = U128(from: 0u64)
        if dpl <= 64u64
            a0 = a0 & base_mask1
            a = U128(from: a0)
        else
            var a1 = get_bits(tab: taba, len: a_len, pos: i *% dpl +% 64u64)
            if dpl <= 125u64
                a = U128(from: a0) | (U128(from: a1 & base_mask1) << 64)
            else
                var a2 = 0u64
                if dpl > 128u64
                    a2 = get_bits(tab: taba, len: a_len, pos: i *% dpl +% 128u64) & base_mask1
                else
                    a1 = a1 & base_mask1
                a = U128(from: a0 >> 63u32) | (U128(from: a1) << 1) | (U128(from: a2) << 65)
                a0 = a0 & (1u64 << 63u32) -% 1u64
        var j = 0u64
        while j < nb_mods
            var m = ntt_mod(idx: first_m_idx +% j)
            var m_inv = ntt_mod_div(idx: first_m_idx +% j)
            var r = mod_fast(r: a, m: m, m_inv: m_inv)
            if dpl > 125u64
                var b = (U128(from: r) << 63) | U128(from: a0)
                r = mod_fast(r: b, m: m, m_inv: m_inv)
            set_limb(tab: tabr, i: i +% j *% fft_len, value: r)
            j = j +% 1u64
        i = i +% 1u64
    return

# CRT-combine the per-mod residues in `buf` back into `r_len` limbs. (libbf ntt_to_limb, scalar)
secret dangerous routine ntt_to_limb(
    tabr: Hijacked[U64],
    r_len: U64,
    buf: Hijacked[U64],
    fft_len_log2: U64,
    dpl: U64,
    nb_mods: U64,
)
    var base_idx = 5u64 -% nb_mods
    var cr_off = 10u64 -% nb_mods *% (nb_mods -% 1u64) // 2u64
    var shift = U32(from: dpl & 63u64)
    var base_mask1 = if shift == 0u32 then 0xFFFFFFFFFFFFFFFFu64 else (1u64 << shift) -% 1u64
    var n_limb1 = (dpl -% 1u64) // 64u64
    var y = alloc_limbs(n: 5u64)
    var u = alloc_limbs(n: 5u64)
    var carry = alloc_limbs(n: 5u64)
    zero_limbs(tab: carry, n: 5u64)
    zero_limbs(tab: tabr, n: r_len)
    var fft_len = 1u64 << U32(from: fft_len_log2)
    var ndig = (r_len *% 64u64 +% dpl -% 1u64) // dpl
    var len = if fft_len < ndig then fft_len else ndig
    var i = 0u64
    while i < len
        var j0 = 0u64
        while j0 < nb_mods
            var mj = ntt_mod(idx: base_idx +% j0)
            set_limb(
                tab: y,
                i: j0,
                value: ntt_limb_to_int(a: limb(tab: buf, i: i +% fft_len *% j0), m: mj),
            )
            j0 = j0 +% 1u64
        # CRT to mixed-radix
        var l = 0u64
        var jj = 0u64
        while jj < nb_mods -% 1u64
            var kk = jj +% 1u64
            while kk < nb_mods
                var m = ntt_mod(idx: base_idx +% kk)
                var diff = limb(tab: y, i: kk) -% limb(tab: y, i: jj) +% m
                set_limb(
                    tab: y,
                    i: kk,
                    value: mul_mod_fast2(
                        a: diff,
                        b: ntt_mod_cr(l: cr_off +% l),
                        m: m,
                        b_inv: ntt_mod_cr_inv(l: cr_off +% l),
                    ),
                )
                l = l +% 1u64
                kk = kk +% 1u64
            jj = jj +% 1u64
        # mixed-radix -> normal
        set_limb(tab: u, i: 0u64, value: limb(tab: y, i: nb_mods -% 1u64))
        var ll = 1u64
        var jd = nb_mods -% 2u64
        while jd >= 1u64
            var r = limb(tab: y, i: jd)
            var mjd = ntt_mod(idx: base_idx +% jd)
            var k2 = 0u64
            while k2 < ll
                var t = U128(from: limb(tab: u, i: k2)) *% U128(from: mjd) +% U128(from: r)
                r = u128_hi(t: t)
                set_limb(tab: u, i: k2, value: u128_lo(t: t))
                k2 = k2 +% 1u64
            set_limb(tab: u, i: ll, value: r)
            ll = ll +% 1u64
            jd = jd -% 1u64
        # last step folds in the carry (uses mods[0])
        var r2 = limb(tab: y, i: 0u64)
        var m0 = ntt_mod(idx: base_idx)
        var k3 = 0u64
        while k3 < ll
            var t2 = U128(from: limb(tab: u, i: k3)) *% U128(from: m0) +% U128(from: r2) +% U128(
                from: limb(tab: carry, i: k3),
            )
            r2 = u128_hi(t: t2)
            set_limb(tab: u, i: k3, value: u128_lo(t: t2))
            k3 = k3 +% 1u64
        set_limb(tab: u, i: ll, value: r2 +% limb(tab: carry, i: ll))
        # write dpl bits of the reconstructed digit
        var pos = i *% dpl
        var jw = 0u64
        while jw < n_limb1
            put_bits(tab: tabr, len: r_len, pos: pos, val: limb(tab: u, i: jw))
            pos = pos +% 64u64
            jw = jw +% 1u64
        put_bits(tab: tabr, len: r_len, pos: pos, val: limb(tab: u, i: n_limb1) & base_mask1)
        # shift out dpl digits into the carry for the next position
        if shift == 0u32
            var jc = n_limb1 +% 1u64
            while jc < nb_mods
                set_limb(tab: carry, i: jc -% (n_limb1 +% 1u64), value: limb(tab: u, i: jc))
                jc = jc +% 1u64
        else
            var jc2 = n_limb1
            while jc2 < nb_mods -% 1u64
                set_limb(
                    tab: carry,
                    i: jc2 -% n_limb1,
                    value: (limb(tab: u, i: jc2) >> shift) | (limb(
                        tab: u,
                        i: jc2 +% 1u64,
                    ) << 64u32 -% shift),
                )
                jc2 = jc2 +% 1u64
            set_limb(
                tab: carry,
                i: nb_mods -% 1u64 -% n_limb1,
                value: limb(tab: u, i: nb_mods -% 1u64) >> shift,
            )
        i = i +% 1u64
    return

# The 5x2 primitive roots (ntt_proot[inverse][j]).
secret routine ntt_proot(inverse: U64, j: U64) -> U64
    if inverse == 0u64
        if j == 0u64
            return 0x1B8EA61034A2BEA7u64
        if j == 1u64
            return 0x21A9762DE58206FBu64
        if j == 2u64
            return 0x02CA782F0756A8EAu64
        if j == 3u64
            return 0x278384537A3E50A1u64
        return 0x106E13FEE74CE0ABu64
    if j == 0u64
        return 0x233513AF133E13B8u64
    if j == 1u64
        return 0x1D13140D1C6F75F1u64
    if j == 2u64
        return 0x12CDE57F97E3EEDAu64
    if j == 3u64
        return 0x0D6149E23CBE654Fu64
    return 0x36CD204F522A1379u64

# ntt_proot_pow[j][inverse][k] = proot^(2^(51-k)) mod m (51-k repeated squarings). NTT_PROOT_2EXP=51.
secret routine ntt_proot_pow(j: U64, inverse: U64, k: U64) -> U64
    danger
        var m = ntt_mod(idx: j)
        var m_inv = ntt_mod_div(idx: j)
        var c = ntt_proot(inverse: inverse, j: j)
        var e = 51u64 -% k
        var i = 0u64
        while i < e
            c = mul_mod_fast(a: c, b: c, m: m, m_inv: m_inv)
            i = i +% 1u64
        return c

secret routine ntt_proot_pow_inv(j: U64, inverse: U64, k: U64) -> U64
    danger
        return init_mul_mod_fast2(
            b: ntt_proot_pow(j: j, inverse: inverse, k: k),
            m: ntt_mod(idx: j),
        )

# ntt_len_inv[j][k][0] = (1/2)^k mod m (inverse of 2^k), [1] = its init_mul_mod_fast2 reciprocal.
secret routine ntt_len_inv0(j: U64, k: U64) -> U64
    danger
        var m = ntt_mod(idx: j)
        var m_inv = ntt_mod_div(idx: j)
        var half = (m +% 1u64) // 2u64
        var c = 1u64
        var i = 0u64
        while i < k
            c = mul_mod_fast(a: c, b: half, m: m, m_inv: m_inv)
            i = i +% 1u64
        return c

secret routine ntt_len_inv1(j: U64, k: U64) -> U64
    danger
        return init_mul_mod_fast2(b: ntt_len_inv0(j: j, k: k), m: ntt_mod(idx: j))

# Build the level-k twiddle table: pairs (c, init_mul_mod_fast2(c, m)) for c = w^0, w^1, ... where
# w = the primitive 2^k-th root. Size 2^(k-1) pairs = 2^k limbs. (libbf get_trig, scalar)
secret dangerous routine get_trig(k: U64, inverse: U64, m_idx: U64) -> Hijacked[U64]
    var n2 = 1u64 << U32(from: k -% 1u64)
    var m = ntt_mod(idx: m_idx)
    var tab = alloc_limbs(n: n2 *% 2u64)
    var c = 1u64
    var c_mul = ntt_proot_pow(j: m_idx, inverse: inverse, k: k)
    var c_mul_inv = ntt_proot_pow_inv(j: m_idx, inverse: inverse, k: k)
    var i = 0u64
    while i < n2
        set_limb(tab: tab, i: 2u64 *% i, value: c)
        set_limb(tab: tab, i: 2u64 *% i +% 1u64, value: init_mul_mod_fast2(b: c, m: m))
        c = mul_mod_fast2(a: c, b: c_mul, m: m, b_inv: c_mul_inv)
        i = i +% 1u64
    return tab

# In-place decimation FFT (or inverse) mod ntt_mods[m_idx]. Ping-pongs in_buf<->tmp_buf, final -> out_buf.
# Values stay < 2m throughout. (libbf ntt_fft, scalar)
secret dangerous routine ntt_fft(
    out_buf: Hijacked[U64],
    in_buf: Hijacked[U64],
    tmp_buf: Hijacked[U64],
    fft_len_log2: U64,
    inverse: U64,
    m_idx: U64,
)
    var m = ntt_mod(idx: m_idx)
    var m2 = 2u64 *% m
    var n = 1u64 << U32(from: fft_len_log2)
    var nb_blocks = n
    var fft_per_block = 1u64
    var stride_in = n // 2u64
    var tab_in = in_buf
    var tab_out = tmp_buf
    var l = fft_len_log2
    while nb_blocks != 2u64
        nb_blocks = nb_blocks >> 1u32
        var p = 0u64
        var kk = 0u64
        var trig = get_trig(k: l, inverse: inverse, m_idx: m_idx)
        var i = 0u64
        while i < nb_blocks
            var c = limb(tab: trig, i: 2u64 *% i)
            var c_inv = limb(tab: trig, i: 2u64 *% i +% 1u64)
            var jb = 0u64
            while jb < fft_per_block
                var a0 = limb(tab: tab_in, i: kk +% jb)
                var a1 = limb(tab: tab_in, i: kk +% jb +% stride_in)
                var b0 = add_mod(a: a0, b: a1, m: m2)
                var b1 = a0 -% a1 +% m2
                b1 = mul_mod_fast3(a: b1, b: c, m: m, b_inv: c_inv)
                set_limb(tab: tab_out, i: p +% jb, value: b0)
                set_limb(tab: tab_out, i: p +% jb +% fft_per_block, value: b1)
                jb = jb +% 1u64
            kk = kk +% fft_per_block
            p = p +% 2u64 *% fft_per_block
            i = i +% 1u64
        fft_per_block = fft_per_block << 1u32
        l = l -% 1u64
        var tmp = tab_in
        tab_in = tab_out
        tab_out = tmp
    # last butterfly level (no twiddle) writes to out_buf
    tab_out = out_buf
    var k2 = 0u64
    while k2 < stride_in
        var a0 = limb(tab: tab_in, i: k2)
        var a1 = limb(tab: tab_in, i: k2 +% stride_in)
        set_limb(tab: tab_out, i: k2, value: add_mod(a: a0, b: a1, m: m2))
        set_limb(tab: tab_out, i: k2 +% stride_in, value: sub_mod(a: a0, b: a1, m: m2))
        k2 = k2 +% 1u64
    return

# Pointwise multiply tab1 *= tab2 with 1/2^k_tot normalization, mod ntt_mods[m_idx]. (libbf ntt_vec_mul)
secret dangerous routine ntt_vec_mul(
    tab1: Hijacked[U64],
    tab2: Hijacked[U64],
    fft_len_log2: U64,
    k_tot: U64,
    m_idx: U64,
)
    var m = ntt_mod(idx: m_idx)
    var m_inv = ntt_mod_div(idx: m_idx)
    var norm = ntt_len_inv0(j: m_idx, k: k_tot)
    var norm_inv = ntt_len_inv1(j: m_idx, k: k_tot)
    var n = 1u64 << U32(from: fft_len_log2)
    var i = 0u64
    while i < n
        var a = limb(tab: tab1, i: i)
        if a >= m
            a = a -% m
        a = mul_mod_fast(a: a, b: limb(tab: tab2, i: i), m: m, m_inv: m_inv)
        a = mul_mod_fast3(a: a, b: norm, m: m, b_inv: norm_inv)
        set_limb(tab: tab1, i: i, value: a)
        i = i +% 1u64
    return

# buf[i] *= c_mul^i, mod m. (libbf mul_trig — used by the recursive strip FFT.)
secret dangerous routine mul_trig(buf: Hijacked[U64], n: U64, c_mul: U64, m: U64, m_inv: U64)
    var c0 = 1u64
    var c_mul_inv = init_mul_mod_fast2(b: c_mul, m: m)
    var i = 0u64
    while i < n
        set_limb(
            tab: buf,
            i: i,
            value: mul_mod_fast(a: limb(tab: buf, i: i), b: c0, m: m, m_inv: m_inv),
        )
        c0 = mul_mod_fast2(a: c0, b: c_mul, m: m, b_inv: c_mul_inv)
        i = i +% 1u64
    return

# Six-step (recursive) FFT of a k1+k2 transform stored row-major as n1 x n2. k2==0 -> plain ntt_fft.
# (libbf ntt_fft_partial. The k2!=0 path only triggers for k > NTT_TRIG_K_MAX=19, i.e. huge transforms.)
secret dangerous routine ntt_fft_partial(
    buf1: Hijacked[U64],
    k1: U64,
    k2: U64,
    n1: U64,
    n2: U64,
    inverse: U64,
    m_idx: U64,
)
    var buf3 = alloc_limbs(n: n1)
    if k2 == 0u64
        ntt_fft(
            out_buf: buf1,
            in_buf: buf1,
            tmp_buf: buf3,
            fft_len_log2: k1,
            inverse: inverse,
            m_idx: m_idx,
        )
        return
    var strip_len = 16u64
    var buf2 = alloc_limbs(n: n1 *% strip_len)
    var m = ntt_mod(idx: m_idx)
    var m_inv = ntt_mod_div(idx: m_idx)
    var c0 = ntt_proot_pow(j: m_idx, inverse: inverse, k: k1 +% k2)
    var c_mul = 1u64
    var j = 0u64
    while j < n2
        var i = 0u64
        while i < n1
            var l = 0u64
            while l < strip_len
                set_limb(tab: buf2, i: i +% l *% n1, value: limb(tab: buf1, i: i *% n2 +% (j +% l)))
                l = l +% 1u64
            i = i +% 1u64
        var l2 = 0u64
        while l2 < strip_len
            if inverse != 0u64
                mul_trig(
                    buf: buf2.stride(count: S64(from: l2 *% n1)),
                    n: n1,
                    c_mul: c_mul,
                    m: m,
                    m_inv: m_inv,
                )
            ntt_fft(
                out_buf: buf2.stride(count: S64(from: l2 *% n1)),
                in_buf: buf2.stride(count: S64(from: l2 *% n1)),
                tmp_buf: buf3,
                fft_len_log2: k1,
                inverse: inverse,
                m_idx: m_idx,
            )
            if inverse == 0u64
                mul_trig(
                    buf: buf2.stride(count: S64(from: l2 *% n1)),
                    n: n1,
                    c_mul: c_mul,
                    m: m,
                    m_inv: m_inv,
                )
            c_mul = mul_mod_fast(a: c_mul, b: c0, m: m, m_inv: m_inv)
            l2 = l2 +% 1u64
        var i2 = 0u64
        while i2 < n1
            var l3 = 0u64
            while l3 < strip_len
                set_limb(
                    tab: buf1,
                    i: i2 *% n2 +% (j +% l3),
                    value: limb(tab: buf2, i: i2 +% l3 *% n1),
                )
                l3 = l3 +% 1u64
            i2 = i2 +% 1u64
        j = j +% strip_len
    return

# Cyclic convolution buf1 = buf1 (*) buf2 mod ntt_mods[m_idx], via forward FFTs, pointwise mul, inverse FFT.
# (libbf ntt_conv)
secret dangerous routine ntt_conv(
    buf1: Hijacked[U64],
    buf2: Hijacked[U64],
    k: U64,
    k_tot: U64,
    m_idx: U64,
)
    var k1 = 0u64
    if k <= 19u64
        k1 = k
    else
        var half = k // 2u64
        k1 = if half < 19u64 then half else 19u64
    var k2 = k -% k1
    var n1 = 1u64 << U32(from: k1)
    var n2 = 1u64 << U32(from: k2)
    ntt_fft_partial(buf1: buf1, k1: k1, k2: k2, n1: n1, n2: n2, inverse: 0u64, m_idx: m_idx)
    ntt_fft_partial(buf1: buf2, k1: k1, k2: k2, n1: n1, n2: n2, inverse: 0u64, m_idx: m_idx)
    if k2 == 0u64
        ntt_vec_mul(tab1: buf1, tab2: buf2, fft_len_log2: k, k_tot: k_tot, m_idx: m_idx)
    else
        var i = 0u64
        while i < n1
            ntt_conv(
                buf1: buf1.stride(count: S64(from: i *% n2)),
                buf2: buf2.stride(count: S64(from: i *% n2)),
                k: k2,
                k_tot: k_tot,
                m_idx: m_idx,
            )
            i = i +% 1u64
    ntt_fft_partial(buf1: buf1, k1: k1, k2: k2, n1: n1, n2: n2, inverse: 1u64, m_idx: m_idx)
    return

# ── fft_mul + mp_mul dispatch ───────────────────────────────────────────────────────────────
# result[0 .. a_len+b_len) = a * b via NTT. result must hold a_len+b_len limbs. (libbf fft_mul, stripped of
# the bf_t/reduced-mem/overlap bookkeeping — the raw integer multiply.)
secret dangerous routine limbs_mul_ntt(
    result: Hijacked[U64],
    a_tab: Hijacked[U64],
    a_len: U64,
    b_tab: Hijacked[U64],
    b_len: U64,
)
    var len = a_len +% b_len
    var params = bf_get_fft_size(len: len)
    var fft_len_log2 = params.item0
    var dpl = params.item1
    var nb_mods = params.item2
    var fft_len = 1u64 << U32(from: fft_len_log2)
    var first_m_idx = 5u64 -% nb_mods
    var buf1 = alloc_limbs(n: fft_len *% nb_mods)
    limb_to_ntt(
        tabr: buf1,
        fft_len: fft_len,
        taba: a_tab,
        a_len: a_len,
        dpl: dpl,
        first_m_idx: first_m_idx,
        nb_mods: nb_mods,
    )
    var buf2 = alloc_limbs(n: fft_len *% nb_mods)
    limb_to_ntt(
        tabr: buf2,
        fft_len: fft_len,
        taba: b_tab,
        a_len: b_len,
        dpl: dpl,
        first_m_idx: first_m_idx,
        nb_mods: nb_mods,
    )
    var j = 0u64
    while j < nb_mods
        ntt_conv(
            buf1: buf1.stride(count: S64(from: fft_len *% j)),
            buf2: buf2.stride(count: S64(from: fft_len *% j)),
            k: fft_len_log2,
            k_tot: fft_len_log2,
            m_idx: first_m_idx +% j,
        )
        j = j +% 1u64
    ntt_to_limb(
        tabr: result,
        r_len: len,
        buf: buf1,
        fft_len_log2: fft_len_log2,
        dpl: dpl,
        nb_mods: nb_mods,
    )
    return

# result[0 .. op1_size+op2_size) = op1 * op2. Dispatches schoolbook <-> NTT at FFT_MUL_THRESHOLD=100
# limbs of the smaller factor. (libbf mp_mul)
secret dangerous routine limbs_mul(
    result: Hijacked[U64],
    op1: Hijacked[U64],
    op1_size: U64,
    op2: Hijacked[U64],
    op2_size: U64,
)
    var smaller = if op1_size < op2_size then op1_size else op2_size
    if smaller >= 100u64
        limbs_mul_ntt(result: result, a_tab: op1, a_len: op1_size, b_tab: op2, b_len: op2_size)
    else
        limbs_mul_schoolbook(
            result: result,
            op1: op1,
            op1_size: op1_size,
            op2: op2,
            op2_size: op2_size,
        )
    return

# The most limbs `limbs_mul` takes for an op1_size x op2_size product (the NTT's buffers), 0 for the
# schoolbook.
secret routine limbs_mul_scratch(op1_size: U64, op2_size: U64) -> U64
    var smaller = if op1_size < op2_size then op1_size else op2_size
    if smaller < 100u64
        return 0u64
    var params = bf_get_fft_size(len: op1_size +% op2_size)
    var fft_len_log2 = params.item0
    var nb_mods = params.item2
    var fft_len = 1u64 << U32(from: fft_len_log2)
    # buf1 and buf2, each convolution, and ntt_to_limb's three 5-limb vectors
    return 2u64 *% fft_len *% nb_mods +% nb_mods *% ntt_conv_scratch(k: fft_len_log2) +% 15u64

# The most limbs one `ntt_conv` of a 2^k transform takes.
secret routine ntt_conv_scratch(k: U64) -> U64
    var k1 = 0u64
    if k <= 19u64
        k1 = k
    else
        var half = k // 2u64
        k1 = if half < 19u64 then half else 19u64
    var k2 = k -% k1
    # two forward transforms and the inverse
    var total = 3u64 *% ntt_fft_partial_scratch(k1: k1, k2: k2)
    if k2 != 0u64
        total = total +% (1u64 << U32(from: k1)) *% ntt_conv_scratch(k: k2)
    return total

# The most limbs one `ntt_fft_partial` of a 2^(k1+k2) transform takes.
secret routine ntt_fft_partial_scratch(k1: U64, k2: U64) -> U64
    var n1 = 1u64 << U32(from: k1)
    if k2 == 0u64
        return n1 +% ntt_fft_scratch(k: k1)
    # buf3, buf2's 16 strips, and a transform of each column (strips of 16 columns, at least one strip)
    var n2 = 1u64 << U32(from: k2)
    return 17u64 *% n1 +% (n2 +% 16u64) *% ntt_fft_scratch(k: k1)

# The most limbs one `ntt_fft` of a 2^k transform takes: a twiddle table per level.
secret routine ntt_fft_scratch(k: U64) -> U64
    return 2u64 << U32(from: k)

# res = 0 - op2 - carry (n limbs). Returns the final borrow. (libbf mp_neg)
secret dangerous routine limbs_neg(
    res: Hijacked[U64],
    op2: Hijacked[U64],
    n: U64,
    carry: U64,
) -> U64
    var k = carry
    var i = 0u64
    while i < n
        var v = 0u64
        var a = v -% limb(tab: op2, i: i)
        var k1 = if a > v then 1u64 else 0u64
        var vv = a -% k
        k = (if vv > a then 1u64 else 0u64) | k1
        set_limb(tab: res, i: i, value: vv)
        i = i +% 1u64
    return k

# 1 if any of tab[0..n) is nonzero, else 0. (libbf mp_scan_nz)
secret dangerous routine limbs_any_nonzero(tab: Hijacked[U64], n: U64) -> U64
    var i = 0u64
    while i < n
        if limb(tab: tab, i: i) != 0u64
            return 1u64
        i = i +% 1u64
    return 0u64

# -1 / 0 / 1 comparing two n-limb magnitudes. (libbf mp_cmp)
secret dangerous routine limbs_cmp(a: Hijacked[U64], b: Hijacked[U64], n: U64) -> S64
    var i = n
    while i > 0u64
        i = i -% 1u64
        var av = limb(tab: a, i: i)
        var bv = limb(tab: b, i: i)
        if av != bv
            return if av < bv then -1s64 else 1s64
    return 0s64

# tabr[0..n) = taba / b, returning the remainder. b must be normalized. Uses the arch-gated Core word
# division (reciprocal_word / div2by1) — hardware divq on x86-64, Möller-Granlund on arm64/wasm. (mp_div1norm)
secret dangerous routine limbs_divmod_word(
    tabr: Hijacked[U64],
    taba: Hijacked[U64],
    n: U64,
    b: U64,
    r0: U64,
) -> U64
    var r = r0
    var b_inv = reciprocal_word(d: b)
    var i = n
    while i > 0u64
        i = i -% 1u64
        var qr = div2by1(u1: r, u0: limb(tab: taba, i: i), d: b, v: b_inv)
        set_limb(tab: tabr, i: i, value: qr.q)
        r = qr.r
    return r

# r = floor(B^(2n)/a), with a normalized (a[n-1] >= B/2) and n>=1. r has n+1 limbs (r[n]=1). Newton
# doubling. (libbf mp_recip)
secret dangerous routine limbs_reciprocal(tabr: Hijacked[U64], taba: Hijacked[U64], n: U64)
    if n <= 2u64
        var tabu = alloc_limbs(n: 2u64 *% n +% 1u64)
        var tabt = alloc_limbs(n: n +% 2u64)
        zero_limbs(tab: tabu, n: 2u64 *% n)
        set_limb(tab: tabu, i: 2u64 *% n, value: 1u64)
        limbs_divmod_norm(tabq: tabt, taba: tabu, na: 2u64 *% n +% 1u64, tabb: taba, nb: n)
        var i = 0u64
        while i < n +% 1u64
            set_limb(tab: tabr, i: i, value: limb(tab: tabt, i: i))
            i = i +% 1u64
        if limbs_any_nonzero(tab: tabu, n: n) == 0u64
            discard limbs_sub_word(tab: tabr, b: 1u64, n: n +% 1u64)
        return
    var l = (n -% 1u64) // 2u64
    var h = n -% l
    var tabt = alloc_limbs(n: n +% h +% 1u64)
    var tabu = alloc_limbs(n: n +% 2u64 *% h -% l +% 2u64)
    var tabxh = tabr.stride(count: S64(from: l))
    limbs_reciprocal(tabr: tabxh, taba: taba.stride(count: S64(from: l)), n: h)
    limbs_mul(result: tabt, op1: taba, op1_size: n, op2: tabxh, op2_size: h +% 1u64)
    while limb(tab: tabt, i: n +% h) != 0u64
        discard limbs_sub_word(tab: tabxh, b: 1u64, n: h +% 1u64)
        var c = limbs_sub(res: tabt, op1: tabt, op2: taba, n: n, borrow_in: 0u64)
        discard limbs_sub_word(tab: tabt.stride(count: S64(from: n)), b: c, n: h +% 1u64)
    # T = B^(n+h) - T
    discard limbs_neg(res: tabt, op2: tabt, n: n +% h +% 1u64, carry: 0u64)
    set_limb(tab: tabt, i: n +% h, value: limb(tab: tabt, i: n +% h) +% 1u64)
    limbs_mul(
        result: tabu,
        op1: tabt.stride(count: S64(from: l)),
        op1_size: n +% h +% 1u64 -% l,
        op2: tabxh,
        op2_size: h +% 1u64,
    )
    var k = 2u64 *% h -% l
    var i2 = 0u64
    while i2 < l
        set_limb(tab: tabr, i: i2, value: limb(tab: tabu, i: i2 +% k))
        i2 = i2 +% 1u64
    discard limbs_add(
        res: tabr.stride(count: S64(from: l)),
        op1: tabr.stride(count: S64(from: l)),
        op2: tabu.stride(count: S64(from: 2u64 *% h)),
        n: h,
        carry: 0u64,
    )
    return

# Subquadratic base-case division: taba (na) / tabb (nb, normalized) -> tabq (na-nb+1), remainder left in
# taba[0..nb). nq = na-nb >= 1. (libbf mp_divnorm_large)
secret dangerous routine limbs_divmod_newton(
    tabq: Hijacked[U64],
    taba: Hijacked[U64],
    na: U64,
    tabb: Hijacked[U64],
    nb: U64,
)
    var nq = na -% nb
    var n = nq
    if nq < nb
        n = n +% 1u64
    var tabb_inv = alloc_limbs(n: n +% 1u64)
    var tabt = alloc_limbs(n: 2u64 *% (n +% 1u64))
    var did_recip = false
    if n >= nb
        var i = 0u64
        while i < n -% nb
            set_limb(tab: tabt, i: i, value: 0u64)
            i = i +% 1u64
        var i2 = 0u64
        while i2 < nb
            set_limb(tab: tabt, i: i2 +% n -% nb, value: limb(tab: tabb, i: i2))
            i2 = i2 +% 1u64
    else
        var i = 0u64
        while i < n
            set_limb(tab: tabt, i: i, value: limb(tab: tabb, i: i +% nb -% n))
            i = i +% 1u64
        if limbs_add_word(tab: tabt, b: 1u64, n: n) != 0u64
            zero_limbs(tab: tabb_inv, n: n)
            set_limb(tab: tabb_inv, i: n, value: 1u64)
            did_recip = true
    if not did_recip
        limbs_reciprocal(tabr: tabb_inv, taba: tabt, n: n)
    # Q = A * B^-1
    limbs_mul(
        result: tabt,
        op1: tabb_inv,
        op1_size: n +% 1u64,
        op2: taba.stride(count: S64(from: na -% (n +% 1u64))),
        op2_size: n +% 1u64,
    )
    var iq = 0u64
    while iq < nq +% 1u64
        set_limb(
            tab: tabq,
            i: iq,
            value: limb(tab: tabt, i: iq +% 2u64 *% (n +% 1u64) -% (nq +% 1u64)),
        )
        iq = iq +% 1u64
    # R = A - B*Q
    var tabt2 = alloc_limbs(n: na +% 1u64)
    limbs_mul(result: tabt2, op1: tabq, op1_size: nq +% 1u64, op2: tabb, op2_size: nb)
    discard limbs_sub(res: taba, op1: taba, op2: tabt2, n: nb +% 1u64, borrow_in: 0u64)
    # the approximate quotient is <= exact, so increment while the remainder is still >= B
    var going = true
    while going
        if limb(tab: taba, i: nb) == 0u64 and limbs_cmp(a: taba, b: tabb, n: nb) < 0s64
            going = false
        else
            var bw = limbs_sub(res: taba, op1: taba, op2: tabb, n: nb, borrow_in: 0u64)
            set_limb(tab: taba, i: nb, value: limb(tab: taba, i: nb) -% bw)
            discard limbs_add_word(tab: tabq, b: 1u64, n: nq +% 1u64)
    return

# Base-case division of a normalized divisor: taba(na)/tabb(nb) -> tabq(na-nb+1), remainder left in
# taba[0..nb). Dispatches single-limb / subquadratic / quadratic. (libbf mp_divnorm)
secret dangerous routine limbs_divmod_norm(
    tabq: Hijacked[U64],
    taba: Hijacked[U64],
    na: U64,
    tabb: Hijacked[U64],
    nb: U64,
)
    var b1 = limb(tab: tabb, i: nb -% 1u64)
    if nb == 1u64
        set_limb(
            tab: taba,
            i: 0u64,
            value: limbs_divmod_word(tabr: tabq, taba: taba, n: na, b: b1, r0: 0u64),
        )
        return
    var n = na -% nb
    # Newton only pays off once both the quotient and the divisor are long. libbf switches at 50 limbs, but
    # measured here the quadratic path wins up to about 2000 x 2000 limbs (2x faster at 1000 limbs) and
    # Newton wins from about 2500.
    if (if n < nb then n else nb) >= 2300u64
        limbs_divmod_newton(tabq: tabq, taba: taba, na: na, tabb: tabb, nb: nb)
        return
    var b1_inv = reciprocal_word(d: b1)
    # first quotient limb is 0 or 1
    var q = 1u64
    var j = nb
    while j > 0u64
        j = j -% 1u64
        if limb(tab: taba, i: n +% j) != limb(tab: tabb, i: j)
            if limb(tab: taba, i: n +% j) < limb(tab: tabb, i: j)
                q = 0u64
            j = 0u64  # break
        elseif j == 0u64
            j = 0u64
    set_limb(tab: tabq, i: n, value: q)
    if q != 0u64
        discard limbs_sub(
            res: taba.stride(count: S64(from: n)),
            op1: taba.stride(count: S64(from: n)),
            op2: tabb,
            n: nb,
            borrow_in: 0u64,
        )
    var i = n
    while i > 0u64
        i = i -% 1u64
        var qq = 0u64
        if limb(tab: taba, i: i +% nb) >= b1
            qq = 0xFFFFFFFFFFFFFFFFu64  # q = -1
        else
            var qr = div2by1(
                u1: limb(tab: taba, i: i +% nb),
                u0: limb(tab: taba, i: i +% nb -% 1u64),
                d: b1,
                v: b1_inv,
            )
            qq = qr.q
        var r = limbs_submul_word(tabr: taba.stride(count: S64(from: i)), taba: tabb, n: nb, b: qq)
        var v = limb(tab: taba, i: i +% nb)
        var a = v -% r
        var c = if a > v then 1u64 else 0u64
        set_limb(tab: taba, i: i +% nb, value: a)
        if c != 0u64
            var neg = true
            while neg
                qq = qq -% 1u64
                var cc = limbs_add(
                    res: taba.stride(count: S64(from: i)),
                    op1: taba.stride(count: S64(from: i)),
                    op2: tabb,
                    n: nb,
                    carry: 0u64,
                )
                if cc != 0u64
                    var t = limb(tab: taba, i: i +% nb) +% 1u64
                    set_limb(tab: taba, i: i +% nb, value: t)
                    if t == 0u64
                        neg = false
        set_limb(tab: tabq, i: i, value: qq)
    return

# ── Integer square root (Karatsuba sqrt, Zimmermann): mp_sqrtrem1/2/rec/sqrtrem ───────────────────────
# floor(sqrt(x)) for x < 2^16 (seeds mp_sqrtrem1, replacing libbf's 192-entry sqrt_table).
secret routine isqrt_small(x: U64) -> U64
    var s = 0u64
    while (s +% 1u64) *% (s +% 1u64) <= x
        s = s +% 1u64
    return s

# floor(sqrt(a)) and remainder for a single normalized limb (a >= 2^62). Returns (s, r), r = a - s^2.
secret routine limbs_sqrt_word(a: U64) -> (U64, U64)
    danger
        var s1 = isqrt_small(x: a >> 56u32 << 8u32)
        var r1 = (a >> 48u32) -% s1 *% s1
        if r1 > 2u64 *% s1
            r1 = r1 -% (2u64 *% s1 +% 1u64)
            s1 = s1 +% 1u64
        # 32 -> 16 bit
        var num = (r1 << 8u32) | (a >> 40u32) & 0xFFu64
        var q = num // (2u64 *% s1)
        var u = num -% q *% (2u64 *% s1)
        var s = (s1 << 8u32) +% q
        var r = (u << 8u32) | (a >> 32u32) & 0xFFu64
        r = r -% q *% q
        if (r >> 63u32) != 0u64
            s = s -% 1u64
            r = r +% (2u64 *% s +% 1u64)
        # 64 -> 32 bit
        s1 = s
        r1 = r
        num = (r1 << 16u32) | (a >> 16u32) & 0xFFFFu64
        q = num // (2u64 *% s1)
        u = num -% q *% (2u64 *% s1)
        s = (s1 << 16u32) +% q
        r = (u << 16u32) | a & 0xFFFFu64
        r = r -% q *% q
        if (r >> 63u32) != 0u64
            s = s -% 1u64
            r = r +% (2u64 *% s +% 1u64)
        return (s, r)

# floor(sqrt) of a 2-limb normalized value taba[0..1]: writes tabs[0]=s and taba[0]=low(r), returns hi(r).
secret dangerous routine limbs_sqrt_2word(tabs: Hijacked[U64], taba: Hijacked[U64]) -> U64
    var a0 = limb(tab: taba, i: 0u64)
    var sr = limbs_sqrt_word(a: limb(tab: taba, i: 1u64))
    var s1 = sr.item0
    var r1 = sr.item1
    var s1x2 = U128(from: 2u64 *% s1)
    var num = (U128(from: r1) << 32) | U128(from: a0 >> 32u32)
    var q = num // s1x2
    var u = num -% q *% s1x2
    var s = (U128(from: s1) << 32) +% q
    var r = (u << 32) | U128(from: a0 & 0xFFFFFFFFu64)
    if u128_lo(t: q >> 32) != 0u64
        r = r -% (U128(from: 1u64) << 64)
    else
        r = r -% q *% q
    if (u128_lo(t: r >> 64) >> 63u32) != 0u64
        s = s -% U128(from: 1u64)
        r = r +% (U128(from: 2u64) *% s +% U128(from: 1u64))
    set_limb(tab: tabs, i: 0u64, value: u128_lo(t: s))
    set_limb(tab: taba, i: 0u64, value: u128_lo(t: r))
    return u128_lo(t: r >> 64)

# Recursive Karatsuba sqrt: taba has 2n limbs (taba[2n-1] >= 2^(64-2)). Writes tabs[0..n-1]=floor(sqrt(a)),
# the remainder into taba[0..n-1], and returns the remainder's high limb. tmp_buf has n/2+1 limbs. (mp_sqrtrem_rec)
secret dangerous routine limbs_sqrt_rec(
    tabs: Hijacked[U64],
    taba: Hijacked[U64],
    n: U64,
    tmp_buf: Hijacked[U64],
) -> U64
    if n == 1u64
        return limbs_sqrt_2word(tabs: tabs, taba: taba)
    var l = n // 2u64
    var h = n -% l
    var qh = limbs_sqrt_rec(
        tabs: tabs.stride(count: S64(from: l)),
        taba: taba.stride(count: S64(from: 2u64 *% l)),
        n: h,
        tmp_buf: tmp_buf,
    )
    if qh != 0u64
        discard limbs_sub(
            res: taba.stride(count: S64(from: 2u64 *% l)),
            op1: taba.stride(count: S64(from: 2u64 *% l)),
            op2: tabs.stride(count: S64(from: l)),
            n: h,
            borrow_in: 0u64,
        )
    limbs_divmod_norm(
        tabq: tmp_buf,
        taba: taba.stride(count: S64(from: l)),
        na: n,
        tabb: tabs.stride(count: S64(from: l)),
        nb: h,
    )
    qh = qh +% limb(tab: tmp_buf, i: l)
    var i = 0u64
    while i < l
        set_limb(tab: tabs, i: i, value: limb(tab: tmp_buf, i: i))
        i = i +% 1u64
    var ql = limbs_shr(tab_r: tabs, tab: tabs, n: l, shift: 1u32, high: qh & 1u64)
    qh = qh >> 1u32
    var rh = 0u64
    if ql != 0u64
        rh = limbs_add(
            res: taba.stride(count: S64(from: l)),
            op1: taba.stride(count: S64(from: l)),
            op2: tabs.stride(count: S64(from: l)),
            n: h,
            carry: 0u64,
        )
    discard limbs_add_word(tab: tabs.stride(count: S64(from: l)), b: qh, n: h)
    var c = 0u64
    if qh != 0u64
        c = qh
    else
        limbs_mul(
            result: taba.stride(count: S64(from: n)),
            op1: tabs,
            op1_size: l,
            op2: tabs,
            op2_size: l,
        )
        c = limbs_sub(
            res: taba,
            op1: taba,
            op2: taba.stride(count: S64(from: n)),
            n: 2u64 *% l,
            borrow_in: 0u64,
        )
    rh = rh -% limbs_sub_word(
        tab: taba.stride(count: S64(from: 2u64 *% l)),
        b: c,
        n: n -% 2u64 *% l,
    )
    if (rh >> 63u32) != 0u64
        discard limbs_sub_word(tab: tabs, b: 1u64, n: n)
        rh = rh +% limbs_addmul_word(tabr: taba, taba: tabs, n: n, b: 2u64)
        rh = rh +% limbs_add_word(tab: taba, b: 1u64, n: n)
    return rh

# Top-level: taba has 2n limbs (normalized top), tabs gets floor(sqrt), returns the remainder's high limb.
secret dangerous routine limbs_sqrt_rem(tabs: Hijacked[U64], taba: Hijacked[U64], n: U64) -> U64
    var tmp_buf = alloc_limbs(n: n // 2u64 +% 1u64)
    return limbs_sqrt_rec(tabs: tabs, taba: taba, n: n, tmp_buf: tmp_buf)

# ── Integer engine wrappers: general divmod (normalize/denormalize around mp_divnorm) ─────────────────
# dst[0..n) = src << shift bits, returning the bits shifted out of the top limb.
secret dangerous routine limbs_shl(
    dst: Hijacked[U64],
    src: Hijacked[U64],
    n: U64,
    shift: U64,
) -> U64
    if shift == 0u64
        var i0 = 0u64
        while i0 < n
            set_limb(tab: dst, i: i0, value: limb(tab: src, i: i0))
            i0 = i0 +% 1u64
        return 0u64
    var sh = U32(from: shift)
    var carry = 0u64
    var i = 0u64
    while i < n
        var v = limb(tab: src, i: i)
        set_limb(tab: dst, i: i, value: (v << sh) | carry)
        carry = v >> 64u32 -% sh
        i = i +% 1u64
    return carry

# q = a / b, r = a mod b, for a general (non-normalized) divisor. Requires na >= nb, b[nb-1] != 0.
# q has na-nb+1 limbs, r has nb limbs. Normalizes b (top bit set), shifts a, divides, denormalizes r.
secret dangerous routine limbs_divmod(
    q: Hijacked[U64],
    r: Hijacked[U64],
    a: Hijacked[U64],
    na: U64,
    b: Hijacked[U64],
    nb: U64,
)
    var shift = LLVM::leading_zeros(limb(tab: b, i: nb -% 1u64))
    var bn = alloc_limbs(n: nb)
    discard limbs_shl(dst: bn, src: b, n: nb, shift: shift)
    var an = alloc_limbs(n: na +% 1u64)
    set_limb(tab: an, i: na, value: limbs_shl(dst: an, src: a, n: na, shift: shift))
    var qq = alloc_limbs(n: na +% 2u64 -% nb)
    limbs_divmod_norm(tabq: qq, taba: an, na: na +% 1u64, tabb: bn, nb: nb)
    var qi = 0u64
    while qi < na +% 1u64 -% nb
        set_limb(tab: q, i: qi, value: limb(tab: qq, i: qi))
        qi = qi +% 1u64
    if shift == 0u64
        var ri = 0u64
        while ri < nb
            set_limb(tab: r, i: ri, value: limb(tab: an, i: ri))
            ri = ri +% 1u64
    else
        discard limbs_shr(tab_r: r, tab: an, n: nb, shift: U32(from: shift), high: 0u64)
    return

# The most limbs `limbs_divmod_norm` takes dividing na limbs by nb (Newton's buffers, 0 on the quadratic
# path).
secret routine limbs_divmod_norm_scratch(na: U64, nb: U64) -> U64
    if nb == 1u64
        return 0u64
    var n = na -% nb
    if (if n < nb then n else nb) >= 2300u64
        return limbs_divmod_newton_scratch(na: na, nb: nb)
    return 0u64

# The most limbs `limbs_divmod_newton` takes dividing na limbs by nb.
secret routine limbs_divmod_newton_scratch(na: U64, nb: U64) -> U64
    var nq = na -% nb
    var n = nq
    if nq < nb
        n = n +% 1u64
    var own = (n +% 1u64) +% 2u64 *% (n +% 1u64) +% (na +% 1u64)
    return own +% limbs_reciprocal_scratch(n: n) +% limbs_mul_scratch(
        op1_size: n +% 1u64,
        op2_size: n +% 1u64,
    ) +% limbs_mul_scratch(op1_size: nq +% 1u64, op2_size: nb)

# The most limbs `limbs_reciprocal` of n limbs takes.
secret routine limbs_reciprocal_scratch(n: U64) -> U64
    if n <= 2u64
        return (2u64 *% n +% 1u64) +% (n +% 2u64) +% limbs_divmod_norm_scratch(
            na: 2u64 *% n +% 1u64,
            nb: n,
        )
    var l = (n -% 1u64) // 2u64
    var h = n -% l
    var own = (n +% h +% 1u64) +% (n +% 2u64 *% h -% l +% 2u64)
    return own +% limbs_reciprocal_scratch(n: h) +% limbs_mul_scratch(
        op1_size: n,
        op2_size: h +% 1u64,
    ) +% limbs_mul_scratch(op1_size: n +% h +% 1u64 -% l, op2_size: h +% 1u64)

# The most limbs `limbs_divmod` takes dividing na limbs by nb (its normalized copies and quotient, and the
# division under them).
secret routine limbs_divmod_scratch(na: U64, nb: U64) -> U64
    return nb +% (na +% 1u64) +% (na +% 2u64 -% nb) +% limbs_divmod_norm_scratch(na: na +% 1u64, nb: nb)

# The most limbs `limbs_sqrt_rem` of 2n limbs takes.
secret routine limbs_sqrt_rem_scratch(n: U64) -> U64
    return n // 2u64 +% 1u64 +% limbs_sqrt_rec_scratch(n: n)

# The most limbs `limbs_sqrt_rec` of 2n limbs takes.
secret routine limbs_sqrt_rec_scratch(n: U64) -> U64
    if n <= 1u64
        return 0u64
    var l = n // 2u64
    var h = n -% l
    return limbs_sqrt_rec_scratch(n: h) +% limbs_divmod_norm_scratch(na: n, nb: h) +% limbs_mul_scratch(
        op1_size: l,
        op2_size: l,
    )
