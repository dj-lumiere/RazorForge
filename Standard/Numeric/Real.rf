module Numerics

### Arbitrary-precision binary floating-point real, computed by the libbf engine in Ingrid.
###
### `Real` is a value record that mirrors {Integer}: its mantissa limbs live in one heap buffer shared
### by copies under an atomic refcount (a copy bumps the count, no number data is copied), and the last
### drop frees it. Addition, subtraction and multiplication are EXACT (the precision grows as needed, up to
### 2^32 bits).
### Division, `sqrt` and the transcendentals round to a generous default working precision (1024 bits,
### about 308 decimal digits) under round-to-nearest-ties-to-even, or to a requested number of decimal
### digits in the `precision:` variants.
###
### `Real` is FINITE-ONLY, like {Decimal}: no operation ever hands back an infinity or a NaN. Where the
### engine would produce one, the operation throws instead, and `try` or `grab` recover it like any
### other failable call:
### - {DivisionByZeroError} for a pole: `x / 0` with `x` not zero (also `divide`), `0 ** -n`, `log(0)`
###   (and `log2` / `log10`), and `atanh(1)` / `atanh(-1)`.
### - {NumericDomainError} when no real result exists: `0 / 0`, the square root or logarithm of a
###   negative value, `asin` / `acos` outside [-1, 1], `acosh` below 1, `atanh` outside [-1, 1], and a
###   negative base raised to a non-integer power.
### - {NumericOverflowError} when the result is too large for Real's binary exponent range (about
###   2^(2^60)): `exp`, `exp2`, `exp10`, `sinh`, `cosh`, `pow`, `hypot`, and arithmetic at that edge. An
###   exact sum, difference or product whose result would need more than 2^32 bits throws it too (a sum of
###   operands whose exponents are far apart, a product of two very long mantissas), before anything is
###   allocated, rather than rounding.
### Text such as `nan` or `inf` is not a `Real`, and building one from a non-finite `B64` throws.
### :see: {Integer}, {Decimal}
record Real
obeys Assignable, Copyable, Equatable, Comparable, Negatable, Addable, Subtractable, Multiplicable,
    Divisible, Exponentiable, Hashable
    ### The sign (true = negative). Zero and infinity carry a sign too.
    secret sign: Bool
    ### The binary exponent: the value is 0.mantissa * 2^expn. Zero, infinity and NaN use reserved values.
    secret expn: S64
    ### The number of 64-bit mantissa limbs (0 for zero, infinity and NaN).
    secret len: U64
    ### The mantissa limbs, little-endian and normalized (the top bit of the last limb is set).
    secret tab: Hijacked[U64]
    ### Atomic strong-count cell governing the limb buffer's lifetime (none when there are no limbs).
    secret ctrl: Hijacked[FrozenController]

# ============================================================================
# Calls into Ingrid
# ============================================================================
# The bodies are Numeric/RealEngine.rf, which runs in Ingrid (Ingrid/tessera/generated/numerics.tess, written
# from RazorForge/IngridExport/numerics.rf, which describes the call protocol). RazorForge allocates every
# buffer: the result buffer, which becomes the new value's limbs, and the scratch the engine takes its
# temporaries from (`limb_buffer` and the retry rule are Integer.rf's). A call that needs more of either says so,
# and is made again with that much.

# Default working precision in bits for inexact {Real} operations (~308 decimal digits).
secret routine real_prec() -> U64
    return 1024u64

# Decimal significant digits -> binary working precision (digits * log2(10) + 16 guard bits). A
# non-positive digit count selects the default working precision.
secret routine real_prec_bits(digits: S32) -> U64
    if digits <= 0s32
        return real_prec()
    return U64(from: S64(from: digits)) *% 3402u64 // 1024u64 +% 16u64

# The exponent of zero, of an infinity and of a NaN (none of them has limbs).
secret preset REAL_EXPN_ZERO: S64 = -9223372036854775808s64
secret preset REAL_EXPN_INF: S64 = 9223372036854775806s64
secret preset REAL_EXPN_NAN: S64 = 9223372036854775807s64

# The most limbs an exact sum, difference or product may take (2^32 bits). Past it the operation throws
# NumericOverflowError before it allocates anything: a sum whose operands' exponents are too far apart, or a
# product of two very long mantissas.
secret preset REAL_EXACT_MAX_LIMBS: U64 = 67108864u64

# True when the exact sum or difference of `a` and `b` would need more than REAL_EXACT_MAX_LIMBS limbs.
secret routine real_sum_too_long(a: Real, b: Real) -> Bool
    danger
        var limbs = C::ingrid_real_sum_size(a_len: a.len, a_expn: a.expn, b_len: b.len, b_expn: b.expn)
        return limbs > REAL_EXACT_MAX_LIMBS

# True when the exact product of `a` and `b` would need more than REAL_EXACT_MAX_LIMBS limbs.
secret routine real_product_too_long(a: Real, b: Real) -> Bool
    return a.len +% b.len > REAL_EXACT_MAX_LIMBS

# The numbers of Ingrid's Real functions (ingrid_real_function).
secret preset REAL_SQRT: U64 = 0u64
secret preset REAL_EXP: U64 = 1u64
secret preset REAL_LOG: U64 = 2u64
secret preset REAL_SIN: U64 = 3u64
secret preset REAL_COS: U64 = 4u64
secret preset REAL_TAN: U64 = 5u64
secret preset REAL_ASIN: U64 = 6u64
secret preset REAL_ACOS: U64 = 7u64
secret preset REAL_ATAN: U64 = 8u64
secret preset REAL_SINH: U64 = 9u64
secret preset REAL_COSH: U64 = 10u64
secret preset REAL_TANH: U64 = 11u64
secret preset REAL_ASINH: U64 = 12u64
secret preset REAL_ACOSH: U64 = 13u64
secret preset REAL_ATANH: U64 = 14u64
secret preset REAL_LOG2: U64 = 15u64
secret preset REAL_LOG10: U64 = 16u64
secret preset REAL_CBRT: U64 = 17u64
secret preset REAL_RINT: U64 = 18u64
secret preset REAL_FLOOR: U64 = 19u64
secret preset REAL_CEIL: U64 = 20u64
secret preset REAL_TRUNC: U64 = 21u64
secret preset REAL_ROUND: U64 = 22u64

# The numbers of the two-argument calls (`real_binary`).
secret preset REAL_DIVIDE: U32 = 0u32
secret preset REAL_ATAN2: U32 = 1u32
secret preset REAL_HYPOT: U32 = 2u32
secret preset REAL_POW: U32 = 3u32
secret preset REAL_ADD: U32 = 4u32
secret preset REAL_SUB: U32 = 5u32
secret preset REAL_MUL: U32 = 6u32

# A limbless Real: zero, an infinity or a NaN by its exponent.
secret routine real_special(sign: Bool, expn: S64) -> Real
    danger
        return Real(
            sign: sign,
            expn: expn,
            len: 0u64,
            tab: hijacked_none[U64](),
            ctrl: hijacked_none[FrozenController](),
        )

# The Real an Ingrid call left in `out`, as its words describe it. Frees `out` when the value has no limbs.
secret dangerous routine real_adopt(out: Hijacked[U64], w: IngridWords) -> Real
    var sign = (w.w2 & 1u64) != 0u64
    var expn = LLVM::reinterpret_bits[U64, S64](w.w3)
    if w.w1 == 0u64
        limb_free(p: out)
        return real_special(sign: sign, expn: expn)
    return Real(sign: sign, expn: expn, len: w.w1, tab: out, ctrl: fresh_frozen_controller())

# The limbs a value rounded to `prec` bits has at most.
secret routine real_rounded_capacity(prec: U64) -> U64
    return prec // 64u64 +% 2u64

# -1, 0 or 1 as a is below, equal to or above b (2 when either is a NaN).
secret routine real_compare(a: Real, b: Real) -> S64
    danger
        return C::ingrid_real_compare(
            a_sign: sign_word(neg: a.sign),
            a_expn: a.expn,
            a_len: a.len,
            a_tab: a.tab,
            b_sign: sign_word(neg: b.sign),
            b_expn: b.expn,
            b_len: b.len,
            b_tab: b.tab,
        )

# The comparison of a with positive zero.
secret routine real_compare_zero(a: Real) -> S64
    return real_compare(a: a, b: real_special(sign: false, expn: REAL_EXPN_ZERO))

# One Real function of `a` at `prec` bits (REAL_SQRT to REAL_ROUND), unchecked: an argument outside the
# domain gives a NaN, an overflow an infinity.
secret routine real_function(op: U64, a: Real, prec: U64) -> Real
    danger
        # a rounding to an integer keeps at most the argument's limbs
        var cap = if op >= REAL_RINT then a.len +% 1u64 else real_rounded_capacity(prec: prec)
        var room = C::ingrid_real_scratch_size(a_len: a.len, b_len: 0u64, prec: prec)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_real_function(
                op: op,
                a_sign: sign_word(neg: a.sign),
                a_expn: a.expn,
                a_len: a.len,
                a_tab: a.tab,
                prec: prec,
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0u64
                return real_adopt(out: out, w: w)
            limb_free(p: out)
            if w.w0 == 1u64
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# One two-argument call: REAL_DIVIDE, REAL_ATAN2, REAL_HYPOT or REAL_POW at `prec` bits, or the exact
# REAL_ADD, REAL_SUB or REAL_MUL (`prec` unused). Unchecked like `real_function`.
secret routine real_binary(op: U32, a: Real, b: Real, prec: U64) -> Real
    danger
        var cap = real_rounded_capacity(prec: prec)
        var room = 0u64
        if op == REAL_ADD or op == REAL_SUB
            cap = C::ingrid_real_sum_size(a_len: a.len, a_expn: a.expn, b_len: b.len, b_expn: b.expn)
            room = cap
        elseif op == REAL_MUL
            cap = a.len +% b.len
            room = C::ingrid_real_mul_scratch_size(a_len: a.len, b_len: b.len)
        else
            room = C::ingrid_real_scratch_size(a_len: a.len, b_len: b.len, prec: prec)
        var a_sign = sign_word(neg: a.sign)
        var b_sign = sign_word(neg: b.sign)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = IngridWords(w0: 0u64, w1: 0u64, w2: 0u64, w3: 0u64)
            if op == REAL_ADD
                w = C::ingrid_real_add(
                    a_sign: a_sign,
                    a_expn: a.expn,
                    a_len: a.len,
                    a_tab: a.tab,
                    b_sign: b_sign,
                    b_expn: b.expn,
                    b_len: b.len,
                    b_tab: b.tab,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            elseif op == REAL_SUB
                w = C::ingrid_real_sub(
                    a_sign: a_sign,
                    a_expn: a.expn,
                    a_len: a.len,
                    a_tab: a.tab,
                    b_sign: b_sign,
                    b_expn: b.expn,
                    b_len: b.len,
                    b_tab: b.tab,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            elseif op == REAL_MUL
                w = C::ingrid_real_mul(
                    a_sign: a_sign,
                    a_expn: a.expn,
                    a_len: a.len,
                    a_tab: a.tab,
                    b_sign: b_sign,
                    b_expn: b.expn,
                    b_len: b.len,
                    b_tab: b.tab,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            elseif op == REAL_DIVIDE
                w = C::ingrid_real_divide(
                    a_sign: a_sign,
                    a_expn: a.expn,
                    a_len: a.len,
                    a_tab: a.tab,
                    b_sign: b_sign,
                    b_expn: b.expn,
                    b_len: b.len,
                    b_tab: b.tab,
                    prec: prec,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            elseif op == REAL_ATAN2
                w = C::ingrid_real_atan2(
                    y_sign: a_sign,
                    y_expn: a.expn,
                    y_len: a.len,
                    y_tab: a.tab,
                    x_sign: b_sign,
                    x_expn: b.expn,
                    x_len: b.len,
                    x_tab: b.tab,
                    prec: prec,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            elseif op == REAL_HYPOT
                w = C::ingrid_real_hypot(
                    x_sign: a_sign,
                    x_expn: a.expn,
                    x_len: a.len,
                    x_tab: a.tab,
                    y_sign: b_sign,
                    y_expn: b.expn,
                    y_len: b.len,
                    y_tab: b.tab,
                    prec: prec,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            else
                w = C::ingrid_real_pow(
                    x_sign: a_sign,
                    x_expn: a.expn,
                    x_len: a.len,
                    x_tab: a.tab,
                    y_sign: b_sign,
                    y_expn: b.expn,
                    y_len: b.len,
                    y_tab: b.tab,
                    prec: prec,
                    out: out,
                    out_cap: cap,
                    scratch: scratch,
                    scratch_cap: room,
                )
            limb_free(p: scratch)
            if w.w0 == 0u64
                return real_adopt(out: out, w: w)
            limb_free(p: out)
            if w.w0 == 1u64
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# Parses `text` in `radix` (2 to 36) at `prec` bits: (value, ok), ok false for malformed text. The value can
# be an infinity or a NaN (the engine reads "inf" and "nan"), which the caller rejects.
secret routine real_parse(text: Text, radix: U64, prec: U64) -> (Real, Bool)
    danger
        var count = text.count()
        var chars = Hijacked[Character](from: C::rf_allocate_dynamic_uninit(size: 4u64 *% count +% 4u64))
        var i = 0u64
        while i < count
            chars.stride(count: S64(from: i)).poke(value: text[i])
            i = i +% 1u64
        var cap = real_rounded_capacity(prec: prec)
        var room = C::ingrid_real_scratch_size(a_len: count *% 6u64 // 64u64 +% 2u64, b_len: 0u64, prec: prec)
        loop
            var out = limb_buffer(n: cap)
            var scratch = limb_buffer(n: room)
            var w = C::ingrid_real_parse(
                chars: chars,
                count: count,
                radix: radix,
                prec: prec,
                out: out,
                out_cap: cap,
                scratch: scratch,
                scratch_cap: room,
            )
            limb_free(p: scratch)
            if w.w0 == 0u64
                chars.invalidate()
                return (real_adopt(out: out, w: w), (w.w2 & 2u64) == 0u64)
            limb_free(p: out)
            if w.w0 == 1u64
                room = scratch_retry(room: room, need: w.w1)
            else
                cap = w.w1

# True when `r` is an infinity. Only the unchecked helpers above can hand one back, and every public
# routine turns it into a throw before a caller sees it.
secret routine real_is_infinite(r: Real) -> Bool
    return r.len == 0u64 and r.expn == REAL_EXPN_INF

# True when `r` is a NaN (same rule as `real_is_infinite`).
secret routine real_is_nan(r: Real) -> Bool
    return r.len == 0u64 and r.expn == REAL_EXPN_NAN

# ============================================================================
# Construction
# ============================================================================

### Constructs the real value zero.
### :returns: The resulting `Real` value.
routine Real() -> Real
    return real_special(sign: false, expn: REAL_EXPN_ZERO)

### Constructs a `Real` from a signed 64-bit integer (exact).
### :param from: The initial signed value.
### :returns: The resulting `Real` value.
routine Real(from: S64) -> Real
    if from == 0s64
        return Real()
    # one limb, normalized so its top bit is set: |from| = 0.limb * 2^(64 - shift)
    var neg = from < 0s64
    var bits = LLVM::reinterpret_bits[S64, U64](from)
    var mag = if neg then 0u64 -% bits else bits
    var shift = LLVM::leading_zeros(mag)
    danger
        var tab = limb_buffer(n: 1u64)
        tab.poke(value: mag << U32(from: shift))
        return Real(
            sign: neg,
            expn: S64(from: 64u64 -% shift),
            len: 1u64,
            tab: tab,
            ctrl: fresh_frozen_controller(),
        )

### Constructs a `Real` from an B64 (exact — the double is widened, not re-rounded).
### :param from: The initial double value, which must be finite.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} if `from` is an infinity, {NumericDomainError} if it is NaN (Real is
###     finite-only, like {Decimal}).
routine Real!(from: B64) -> Real
    if from.is_nan()
        throw NumericDomainError(description: "domain error: NaN is not a Real")
    if from.is_infinite()
        throw NumericOverflowError(description: "overflow: an infinity is not a Real")
    danger
        var out = limb_buffer(n: 1u64)
        var scratch = limb_buffer(n: 1u64)
        var w = C::ingrid_real_from_b64(
            bits: from.to_bits(),
            out: out,
            out_cap: 1u64,
            scratch: scratch,
            scratch_cap: 1u64,
        )
        limb_free(p: scratch)
        return real_adopt(out: out, w: w)

### Returns the real value zero.
### :returns: The resulting `Real` value.
common routine Real.zero() -> Real
    return Real()

### Returns the real value one.
### :returns: The resulting `Real` value.
common routine Real.one() -> Real
    return Real(from: 1_s64)

### Constructs a `Real` from text in `radix` (2 to 36), rounded to the working precision. Accepts an
### optional sign, digits with at most one `.`, an optional exponent of the radix written in decimal
### (`e`/`E` in radix 10, `@` in any radix), and a `0x` prefix in radix 16. Real is finite-only, so
### `nan`, `inf` and `infinity` are rejected, as is a number too large for the exponent range.
### :param text: The textual real representation.
### :param radix: The numeric base to use.
### :returns: The resulting `Real` value.
### :throws: {InvalidValueError} if `radix` is outside 2 to 36 or `text` is not a valid finite real in
###     `radix`.
routine Real!(text: Text, radix: S32 = 10) -> Real
    if radix < 2_s32 or radix > 36_s32
        throw InvalidValueError(input: text, target: "Real")
    var parsed = real_parse(text: text, radix: U64(from: S64(from: radix)), prec: real_prec())
    var ok = parsed.item1
    var r = parsed.item0
    if not ok or real_is_infinite(r: r) or real_is_nan(r: r)
        throw InvalidValueError(input: text, target: "Real")
    return r

### Materializes a `Real` from a tokenizer-validated decimal string (literal lowering).
### :param text: The decimal string (no suffix, no separators).
### :returns: The resulting `Real` value.
common routine Real.from_literal(text: Text) -> Real
    return real_parse(text: text, radix: 10u64, prec: real_prec()).item0

# ============================================================================
# Lifetime (atomic refcount over the shared limb buffer)
# ============================================================================

### Returns a copy with the underlying refcount bumped; the limb buffer is shared.
### :returns: The resulting `Real` value.
@readonly
@inline
routine Real.assign() -> Real
    danger
        if not me.ctrl.is_none()
            me.ctrl.as_entity().hold()
    return Real(sign: me.sign, expn: me.expn, len: me.len, tab: me.tab, ctrl: me.ctrl)

### Releases this reference; frees the limb buffer when this was the last live ref.
@override
dangerous routine Real.destroy()
    if me.ctrl.is_none()
        return
    var prev = me.ctrl.as_entity().unhold()
    if prev <= 1_u64
        me.tab.invalidate()
        me.ctrl.invalidate()
    return

# ============================================================================
# Arithmetic (+, -, * exact; / rounded to the working precision)
# ============================================================================

### Adds `other` to this value (exact).
### :param you: The value to add.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the sum is too large for Real's exponent range, or would need more
###     than 2^32 bits to be exact.
@readonly
routine Real.add!(you: Real) -> Real
    if real_sum_too_long(a: me, b: you)
        throw NumericOverflowError(description: "overflow: the exact sum would need more than 2^32 bits")
    var r = real_binary(op: REAL_ADD, a: me, b: you, prec: 0u64)
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the sum is too large for Real")
    return r

### Subtracts `other` from this value (exact).
### :param you: The value to subtract.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the difference is too large for Real's exponent range, or would
###     need more than 2^32 bits to be exact.
@readonly
routine Real.sub!(you: Real) -> Real
    if real_sum_too_long(a: me, b: you)
        throw NumericOverflowError(description: "overflow: the exact difference would need more than 2^32 bits")
    var r = real_binary(op: REAL_SUB, a: me, b: you, prec: 0u64)
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the difference is too large for Real")
    return r

### Returns `me + you`, promoting the real `me` to complex (imaginary part 0). Only `+`/`-` allow
### real↔complex mixing (arbitrary Real pairs with arbitrary Complex).
### :param you: The complex addend.
### :returns: The complex sum.
@readonly
routine Real.add(you: Complex) -> Complex
    return Complex(real: me).add(you)

### Returns `me - you`, promoting the real `me` to complex (imaginary part 0).
### :param you: The complex value to subtract.
### :returns: The complex difference.
@readonly
routine Real.sub(you: Complex) -> Complex
    return Complex(real: me).sub(you)

### Multiplies this value by `other` (exact).
### :param you: The value to multiply by.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the product is too large for Real's exponent range, or would need
###     more than 2^32 bits to be exact.
@readonly
routine Real.mul!(you: Real) -> Real
    if real_product_too_long(a: me, b: you)
        throw NumericOverflowError(description: "overflow: the exact product would need more than 2^32 bits")
    var r = real_binary(op: REAL_MUL, a: me, b: you, prec: 0u64)
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the product is too large for Real")
    return r

### Divides this value by `other`, rounded to the working precision.
### :param you: The non-zero divisor.
### :returns: The resulting `Real` value.
### :throws: {DivisionByZeroError} when `you` is zero and this value is not, and {NumericDomainError}
###     for 0 / 0, as with the binary and decimal floats.
### :throws: {NumericOverflowError} when the quotient is too large for Real's exponent range.
@readonly
routine Real.truediv!(you: Real) -> Real
    if you.is_zero()
        if me.is_zero()
            throw NumericDomainError(description: "domain error: 0 / 0 has no real result")
        throw DivisionByZeroError()
    var r = real_binary(op: REAL_DIVIDE, a: me, b: you, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the quotient is too large for Real")
    return r

### Returns the additive inverse of this value.
### :returns: The resulting `Real` value.
@readonly
routine Real.neg() -> Real
    # the limbs are shared, the sign flips (zero included, as -0)
    danger
        if not me.ctrl.is_none()
            me.ctrl.as_entity().hold()
    return Real(sign: not me.sign, expn: me.expn, len: me.len, tab: me.tab, ctrl: me.ctrl)

### Returns `true` when this value is strictly less than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Real.is_negative() -> Bool
    return real_compare_zero(a: me) < 0s64

### Returns `true` when this value is exactly zero.
### :returns: The resulting `Bool` value.
@readonly
routine Real.is_zero() -> Bool
    return real_compare_zero(a: me) == 0s64

### Returns the absolute value of this real number.
### :returns: The resulting `Real` value.
@readonly
routine Real.abs() -> Real
    if me.is_negative()
        return me.neg()
    return me.assign()

# ============================================================================
# Comparison
# ============================================================================

### Returns `true` when both values represent the same real number.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Real.eq(you: Real) -> Bool
    return real_compare(a: me, b: you) == 0s64

### Compares this value with `you` under numeric ordering.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine Real.cmp(you: Real) -> ComparisonSign
    var c = real_compare(a: me, b: you)
    if c < 0s64
        return ME_SMALL
    elseif c > 0s64
        return ME_LARGE
    return SAME

# ============================================================================
# libm surface (rounded to the working precision)
# ============================================================================

### Square root.
### :returns: The resulting `Real` value.
### :throws: {NumericDomainError} when this value is negative (no real square root).
@readonly
routine Real.sqrt!() -> Real
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real square root")
    return me.sqrt(precision: 0_s32)

### Natural exponential e**me.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.exp!() -> Real
    var r = real_function(op: REAL_EXP, a: me, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of exp is too large for Real")
    return r

### Natural logarithm.
### :returns: The resulting `Real` value.
### :throws: {DivisionByZeroError} when this value is zero (the logarithm's pole), and
###     {NumericDomainError} when it is negative.
@readonly
routine Real.log!() -> Real
    if me.is_zero()
        throw DivisionByZeroError()
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real logarithm")
    return me.log(precision: 0_s32)

### Raises this value to the power `exp`.
### :param exp: The exponent.
### :returns: The resulting `Real` value.
### :throws: {NumericDomainError} when the base is negative and the exponent is not an
###          integer — that power has no real result (it would be complex).
### :throws: {DivisionByZeroError} when the base is zero and the exponent is negative, as 1 / 0 is.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.pow!(exp: Real) -> Real
    if me.is_zero() and exp.is_negative()
        throw DivisionByZeroError()
    if me.is_negative() and not exp.eq(you: exp.trunc())
        throw NumericDomainError(description: "pow: negative base with non-integer exponent has no real result")
    var r = real_binary(op: REAL_POW, a: me, b: exp, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the power is too large for Real")
    return r

### Sine (radians).
### :returns: The resulting `Real` value.
@readonly
routine Real.sin() -> Real
    return me.sin(precision: 0_s32)

### Cosine (radians).
### :returns: The resulting `Real` value.
@readonly
routine Real.cos() -> Real
    return me.cos(precision: 0_s32)

### Tangent (radians).
@readonly
routine Real.tan() -> Real
    return me.tan(precision: 0_s32)

### Inverse sine (radians).
### :throws: {NumericDomainError} when this value is outside [-1, 1].
@readonly
routine Real.asin!() -> Real
    if me.abs().cmp(you: Real.one()) == ME_LARGE
        throw NumericDomainError(description: "domain error: asin needs a value between -1 and 1")
    return me.asin(precision: 0_s32)

### Inverse cosine (radians).
### :throws: {NumericDomainError} when this value is outside [-1, 1].
@readonly
routine Real.acos!() -> Real
    if me.abs().cmp(you: Real.one()) == ME_LARGE
        throw NumericDomainError(description: "domain error: acos needs a value between -1 and 1")
    return me.acos(precision: 0_s32)

### Inverse tangent (radians).
@readonly
routine Real.atan() -> Real
    return me.atan(precision: 0_s32)

### Two-argument inverse tangent of `y / x` (radians), quadrant-aware.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
routine atan2(y: Real, x: Real) -> Real
    return atan2(y: y, x: x, precision: 0_s32)

### Hyperbolic sine.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.sinh!() -> Real
    var r = real_function(op: REAL_SINH, a: me, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of sinh is too large for Real")
    return r

### Hyperbolic cosine.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.cosh!() -> Real
    var r = real_function(op: REAL_COSH, a: me, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of cosh is too large for Real")
    return r

### Hyperbolic tangent.
@readonly
routine Real.tanh() -> Real
    return real_function(op: REAL_TANH, a: me, prec: real_prec())

### Inverse hyperbolic sine.
@readonly
routine Real.asinh() -> Real
    return real_function(op: REAL_ASINH, a: me, prec: real_prec())

### Inverse hyperbolic cosine.
### :throws: {NumericDomainError} when this value is below 1.
@readonly
routine Real.acosh!() -> Real
    if me.cmp(you: Real.one()) == ME_SMALL
        throw NumericDomainError(description: "domain error: acosh needs a value of at least 1")
    return real_function(op: REAL_ACOSH, a: me, prec: real_prec())

### Inverse hyperbolic tangent.
### :throws: {DivisionByZeroError} when this value is 1 or -1 (the poles), and {NumericDomainError}
###     when it is outside [-1, 1].
@readonly
routine Real.atanh!() -> Real
    var size = me.abs().cmp(you: Real.one())
    if size == SAME
        throw DivisionByZeroError()
    if size == ME_LARGE
        throw NumericDomainError(description: "domain error: atanh needs a value between -1 and 1")
    return me.atanh(precision: 0_s32)

### Base-2 logarithm.
### :throws: {DivisionByZeroError} when this value is zero, and {NumericDomainError} when it is negative.
@readonly
routine Real.log2!() -> Real
    if me.is_zero()
        throw DivisionByZeroError()
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real logarithm")
    return me.log2(precision: 0_s32)

### Base-10 logarithm.
### :throws: {DivisionByZeroError} when this value is zero, and {NumericDomainError} when it is negative.
@readonly
routine Real.log10!() -> Real
    if me.is_zero()
        throw DivisionByZeroError()
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real logarithm")
    return me.log10(precision: 0_s32)

### Euclidean distance `sqrt(x^2 + y^2)` without intermediate overflow.
### :param x: One leg.
### :param y: The other leg.
### :throws: {NumericOverflowError} when the distance is too large for Real's exponent range.
routine hypot!(x: Real, y: Real) -> Real
    var r = real_binary(op: REAL_HYPOT, a: x, b: y, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the distance is too large for Real")
    return r

### 3D Euclidean distance `sqrt(x^2 + y^2 + z^2)` without intermediate overflow. Composed as
### `hypot(hypot(x, y), z)`.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
### :throws: {NumericOverflowError} when the distance is too large for Real's exponent range.
routine hypot!(x: Real, y: Real, z: Real) -> Real
    var xy = real_binary(op: REAL_HYPOT, a: x, b: y, prec: real_prec())
    if real_is_infinite(r: xy)
        throw NumericOverflowError(description: "overflow: the distance is too large for Real")
    var r = real_binary(op: REAL_HYPOT, a: xy, b: z, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the distance is too large for Real")
    return r

### Cube root.
@readonly
routine Real.cbrt() -> Real
    return me.cbrt(precision: 0_s32)

# --- Precision-aware variants (precision = decimal significant digits; 0 or less = the default) ---

### Divides this value by `other`, rounding to `precision` decimal digits.
### :param you: The non-zero divisor.
### :param precision: The number of decimal significant digits.
### :returns: The resulting `Real` value.
### :throws: {DivisionByZeroError} when `you` is zero and this value is not, and {NumericDomainError}
###     for 0 / 0.
### :throws: {NumericOverflowError} when the quotient is too large for Real's exponent range.
@readonly
routine Real.divide!(you: Real, precision: S32) -> Real
    if you.is_zero()
        if me.is_zero()
            throw NumericDomainError(description: "domain error: 0 / 0 has no real result")
        throw DivisionByZeroError()
    var r = real_binary(op: REAL_DIVIDE, a: me, b: you, prec: real_prec_bits(digits: precision))
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the quotient is too large for Real")
    return r

### Square root to `precision` decimal digits.
### :throws: {NumericDomainError} when this value is negative (no real square root).
@readonly
routine Real.sqrt!(precision: S32) -> Real
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real square root")
    var r = real_function(op: REAL_SQRT, a: me, prec: real_prec_bits(digits: precision))
    return r

### Natural exponential to `precision` decimal digits.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.exp!(precision: S32) -> Real
    var r = real_function(op: REAL_EXP, a: me, prec: real_prec_bits(digits: precision))
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of exp is too large for Real")
    return r

### Natural logarithm to `precision` decimal digits.
### :throws: {DivisionByZeroError} when this value is zero (the logarithm's pole), and
###     {NumericDomainError} when it is negative.
@readonly
routine Real.log!(precision: S32) -> Real
    if me.is_zero()
        throw DivisionByZeroError()
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real logarithm")
    var r = real_function(op: REAL_LOG, a: me, prec: real_prec_bits(digits: precision))
    return r

### Raises this value to `exp` to `precision` decimal digits.
### :param exp: The exponent.
### :param precision: The number of decimal significant digits.
### :returns: The resulting `Real` value.
### :throws: {NumericDomainError} when the base is negative and the exponent is not an integer.
### :throws: {DivisionByZeroError} when the base is zero and the exponent is negative, as 1 / 0 is.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.pow!(exp: Real, precision: S32) -> Real
    if me.is_zero() and exp.is_negative()
        throw DivisionByZeroError()
    if me.is_negative() and not exp.eq(you: exp.trunc())
        throw NumericDomainError(description: "pow: negative base with non-integer exponent has no real result")
    var r = real_binary(op: REAL_POW, a: me, b: exp, prec: real_prec_bits(digits: precision))
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the power is too large for Real")
    return r

### Sine (radians) to `precision` decimal digits.
@readonly
routine Real.sin(precision: S32) -> Real
    var r = real_function(op: REAL_SIN, a: me, prec: real_prec_bits(digits: precision))
    return r

