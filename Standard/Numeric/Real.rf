### Hyperbolic sine to `precision` decimal digits.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.sinh!(precision: S32) -> Real
    var r = real_sinhcosh_raw(a: me, prec: real_prec_bits(digits: precision), is_cosh: false)
