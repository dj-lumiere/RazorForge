routine Real.asinh(precision: S32) -> Real
    return real_asinh_acosh_raw(a: me, prec: real_prec_bits(digits: precision), is_acosh: false)

### Inverse hyperbolic cosine to `precision` decimal digits.
### :throws: {NumericDomainError} when this value is below 1.
@readonly
routine Real.acosh!(precision: S32) -> Real
    if me.cmp(you: Real.one()) == ME_SMALL
        throw NumericDomainError(description: "domain error: acosh needs a value of at least 1")
    return real_asinh_acosh_raw(a: me, prec: real_prec_bits(digits: precision), is_acosh: true)

### Inverse hyperbolic tangent to `precision` decimal digits.
### :throws: {DivisionByZeroError} when this value is 1 or -1 (the poles), and {NumericDomainError}
###     when it is outside [-1, 1].
@readonly
routine Real.atanh!(precision: S32) -> Real
    var size = me.abs().cmp(you: Real.one())
    if size == SAME
        throw DivisionByZeroError()
    if size == ME_LARGE
        throw NumericDomainError(description: "domain error: atanh needs a value between -1 and 1")
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(
            x: bf_atanh(a: real_bf(r: me), prec: real_prec_bits(digits: precision)),
        )
        C::rf_region_release(mark: mark)
        return r

