module Numerics

### Arbitrary-precision binary floating-point real, computed by the pure-RazorForge libbf engine.
###
### `Real` is a value record that mirrors {Integer}: its mantissa limbs live in one heap buffer shared
### by copies under an atomic refcount (a copy bumps the count, no number data is copied), and the last
### drop frees it. Addition, subtraction and multiplication are EXACT (the precision grows as needed).
### Division, `sqrt` and the transcendentals round to a generous default working precision (1024 bits,
### about 308 decimal digits) under round-to-nearest-ties-to-even, or to a requested number of decimal
### digits in the `precision:` variants.
###
### `Real` is FINITE-ONLY, like {Decimal}: no operation ever hands back an infinity or a NaN. Where the
### engine would produce one, the operation throws instead, and `try` or `grab` recover it like any
### other failable call:
### - {DivisionByZeroError} for a pole: `x / 0` with `x` not zero (also `divide`), `0 ** -n`, `log(0)`
###   (and `log2` / `log10`), and `atanh(1)` / `atanh(-1)`.
### - {NumericDomainError} when no real result exists: `0 / 0`, the square root or logarithm of a
###   negative value, `asin` / `acos` outside [-1, 1], `acosh` below 1, `atanh` outside [-1, 1], and a
###   negative base raised to a non-integer power.
### - {NumericOverflowError} when the result is too large for Real's binary exponent range (about
###   2^(2^60)): `exp`, `exp2`, `exp10`, `sinh`, `cosh`, `pow`, `hypot`, and arithmetic at that edge.
### Text such as `nan` or `inf` is not a `Real`, and building one from a non-finite `B64` throws.
### :see: {Integer}, {Decimal}
record Real
obeys Assignable, Copyable, Equatable, Comparable, Negatable, Addable, Subtractable, Multiplicable,
    Divisible, Exponentiable, Hashable
    ### The sign (true = negative). Zero and infinity carry a sign too.
    secret sign: Bool
    ### The binary exponent: the value is 0.mantissa * 2^expn. Zero, infinity and NaN use reserved values.
    secret expn: S64
    ### The number of 64-bit mantissa limbs (0 for zero, infinity and NaN).
    secret len: U64
    ### The mantissa limbs, little-endian and normalized (the top bit of the last limb is set).
    secret tab: Hijacked[U64]
    ### Atomic strong-count cell governing the limb buffer's lifetime (none when there are no limbs).
    secret ctrl: Hijacked[FrozenController]

# ============================================================================
# Bridge to the engine
# ============================================================================

# Borrows this value's limbs as an engine value (no copy). The engine never writes an input's limbs.
secret routine real_bf(r: Real) -> BfT
    return BfT(sign: r.sign, expn: r.expn, len: r.len, tab: r.tab)

# Copies an engine result into a new owned `Real`. The engine's buffers live in the scratch region, so
# the limbs are copied out before the caller releases it.
secret routine real_from_bf(x: BfT) -> Real
    danger
        if x.len == 0u64
            return Real(
                sign: x.sign,
                expn: x.expn,
                len: 0u64,
                tab: hijacked_none[U64](),
                ctrl: hijacked_none[FrozenController](),
            )
        var tab = Hijacked[U64](from: C::rf_allocate_dynamic_uninit(size: 8u64 *% x.len))
        var i = 0u64
        while i < x.len
            tab.stride(count: S64(from: i)).poke(value: x.tab.stride(count: S64(from: i)).peek())
            i = i +% 1u64
        return Real(
            sign: x.sign,
            expn: x.expn,
            len: x.len,
            tab: tab,
            ctrl: fresh_frozen_controller(),
        )

# True when `r` is an infinity. Only the unchecked engine helpers below can hold one, and every
# public routine turns it into a throw before a caller sees it.
secret routine real_is_infinite(r: Real) -> Bool
    return r.len == 0u64 and r.expn == bf_exp_inf()

# True when `r` is a NaN (same rule as `real_is_infinite`).
secret routine real_is_nan(r: Real) -> Bool
    return r.len == 0u64 and r.expn == bf_exp_nan()

# The positive infinity the unchecked helpers report an overflow with.
secret routine real_overflow() -> Real
    danger
        return real_from_bf(x: bf_set_inf(is_neg: false))

# e**a at `prec` bits, unchecked: a result past the exponent range comes back as an infinity. An
# argument of 2^61 or more never reaches the engine, whose range reduction needs a/log(2) to fit in
# 63 bits: that result is certainly out of range (an infinity) or certainly below it (zero).
secret routine real_exp_raw(a: Real, prec: U64) -> Real
    if a.expn > 61s64
        if a.sign
            return Real()
        return real_overflow()
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(x: bf_exp(a: real_bf(r: a), prec: prec, fl: 0u32))
        C::rf_region_release(mark: mark)
        return r

# sinh(a) or cosh(a) at `prec` bits, unchecked like `real_exp_raw` (an overflow is an infinity).
secret routine real_sinhcosh_raw(a: Real, prec: U64, is_cosh: Bool) -> Real
    if a.expn > 61s64
        return real_overflow()
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(x: bf_sinhcosh(a: real_bf(r: a), prec: prec, is_cosh: is_cosh))
        C::rf_region_release(mark: mark)
        return r

# x ** y at `prec` bits, unchecked: an overflow is an infinity. The caller has already rejected a zero
# base with a negative exponent and a negative base with a non-integer exponent. Before the engine
# runs, y * log2|x| is estimated at 64 bits: at 2^61 or more in size the result is certainly out of the
# exponent range (an infinity) or certainly below it (zero), and the engine is not asked to build it.
# The estimate is skipped when |y| < 2^31 and |log2|x|| < 2^27, where the result is surely in range.
secret routine real_pow_raw(x: Real, y: Real, prec: U64) -> Real
    danger
        var mark = C::rf_region_mark()
        var bbase = real_bf(r: x)
        var bexp = real_bf(r: y)
        var magnitude = bf_with_sign(a: bbase, sign: false)
        var small = bexp.expn <= 31s64 and bbase.expn < 134217728s64 and bbase.expn > -134217728s64
        if not small
            and bbase.len > 0u64
            and bexp.len > 0u64
            and bf_cmp(a: magnitude, b: bf_set_ui(a: 1u64)) != 0s64
            var estimate = bf_mul(
                a: bexp,
                b: bf_logbase(a: magnitude, prec: 64u64, base10: false),
                prec: 64u64,
                fl: 0u32,
            )
            if estimate.expn > 61s64
                C::rf_region_release(mark: mark)
                if estimate.sign
                    return Real()
                return real_overflow()
        var r = real_from_bf(x: bf_pow(x: bbase, y: bexp, prec: prec, fl: 0u32))
        C::rf_region_release(mark: mark)
        return r

# tanh(a) at `prec` bits, always finite. The engine forms e^(2a), which overflows for a large positive
# `a`, so a positive argument from 2^30 up is computed as -tanh(-a). From 2^60 up the result is +-1 at
# any precision.
secret routine real_tanh_raw(a: Real, prec: U64) -> Real
    if a.expn > 60s64
        if a.sign
            return Real(from: -1_s64)
        return Real(from: 1_s64)
    danger
        var mark = C::rf_region_mark()
        var x = real_bf(r: a)
        var t = bf_set_zero(is_neg: false)
        if not a.sign and a.expn > 30s64
            t = bf_neg(a: bf_tanh(a: bf_neg(a: x), prec: prec))
        else
            t = bf_tanh(a: x, prec: prec)
        var r = real_from_bf(x: t)
        C::rf_region_release(mark: mark)
        return r

# asinh(a) (or acosh(a), whose caller has already rejected a < 1) at `prec` bits, always finite. A
# negative asinh argument is computed as -asinh(-a), since a + sqrt(a^2 + 1) cancels to zero for a large
# negative `a`. Once a^2 + 1 rounds to a^2 the result is log(2a) = log(a) + log(2), computed that way
# so a^2 never leaves the exponent range.
secret routine real_asinh_acosh_raw(a: Real, prec: U64, is_acosh: Bool) -> Real
    danger
        var mark = C::rf_region_mark()
        var x = real_bf(r: a)
        var negate = a.sign and not is_acosh
        if negate
            x = bf_neg(a: x)
        var r = bf_set_zero(is_neg: false)
        if x.expn > S64(from: prec >> 1u32) +% 2s64
            r = bf_add(
                a: bf_log(a: x, prec: prec, fl: 0u32),
                b: bf_const_log2(prec: prec, fl: 0u32),
                prec: prec,
                fl: 0u32,
            )
        else
            r = bf_asinh_acosh(a: x, prec: prec, is_acosh: is_acosh)
        if negate
            r = bf_neg(a: r)
        var result = real_from_bf(x: r)
        C::rf_region_release(mark: mark)
        return result

# sqrt(x^2 + y^2) at `prec` bits, unchecked: an overflow is an infinity. Both legs are scaled by the
# same power of two first (exact), so the squares stay inside the exponent range whenever the result
# does.
secret routine real_hypot_raw(x: Real, y: Real, prec: U64) -> Real
    danger
        var mark = C::rf_region_mark()
        var a = real_bf(r: x)
        var b = real_bf(r: y)
        var k = 0s64
        if a.len > 0u64 and b.len > 0u64
            k = if a.expn > b.expn then a.expn else b.expn
        elseif a.len > 0u64
            k = a.expn
        elseif b.len > 0u64
            k = b.expn
        if a.len > 0u64
            a = BfT(sign: a.sign, expn: a.expn -% k, len: a.len, tab: a.tab)
        if b.len > 0u64
            b = BfT(sign: b.sign, expn: b.expn -% k, len: b.len, tab: b.tab)
        var r = bf_mul_2exp(a: bf_hypot(a: a, b: b, prec: prec), e: k, prec: prec, fl: 0u32)
        var result = real_from_bf(x: r)
        C::rf_region_release(mark: mark)
        return result

# ============================================================================
# Construction
# ============================================================================

### Constructs the real value zero.
### :returns: The resulting `Real` value.
routine Real() -> Real
    danger
        return real_from_bf(x: bf_set_zero(is_neg: false))

### Constructs a `Real` from a signed 64-bit integer (exact).
### :param from: The initial signed value.
### :returns: The resulting `Real` value.
routine Real(from: S64) -> Real
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(x: bf_set_si(a: from))
        C::rf_region_release(mark: mark)
        return r

### Constructs a `Real` from an B64 (exact — the double is widened, not re-rounded).
### :param from: The initial double value, which must be finite.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} if `from` is an infinity, {NumericDomainError} if it is NaN (Real is
###     finite-only, like {Decimal}).
routine Real!(from: B64) -> Real
    if from.is_nan()
        throw NumericDomainError(description: "domain error: NaN is not a Real")
    if from.is_infinite()
        throw NumericOverflowError(description: "overflow: an infinity is not a Real")
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(x: bf_set_b64(d: from))
        C::rf_region_release(mark: mark)
        return r

### Returns the real value zero.
### :returns: The resulting `Real` value.
common routine Real.zero() -> Real
    return Real()

### Returns the real value one.
### :returns: The resulting `Real` value.
common routine Real.one() -> Real
    return Real(from: 1_s64)

### Constructs a `Real` from text in `radix` (2 to 36), rounded to the working precision. Accepts an
### optional sign, digits with at most one `.`, an optional exponent of the radix written in decimal
### (`e`/`E` in radix 10, `@` in any radix), and a `0x` prefix in radix 16. Real is finite-only, so
### `nan`, `inf` and `infinity` are rejected, as is a number too large for the exponent range.
### :param text: The textual real representation.
### :param radix: The numeric base to use.
### :returns: The resulting `Real` value.
### :throws: {InvalidValueError} if `radix` is outside 2 to 36 or `text` is not a valid finite real in
###     `radix`.
routine Real!(text: Text, radix: S32 = 10) -> Real
    if radix < 2_s32 or radix > 36_s32
        throw InvalidValueError(input: text, target: "Real")
    danger
        var mark = C::rf_region_mark()
        var parsed = bf_atof(text: text, radix: U64(from: S64(from: radix)), prec: real_prec())
        var ok = parsed.item1
        var r = real_from_bf(x: parsed.item0)
        C::rf_region_release(mark: mark)
        if not ok or real_is_infinite(r: r) or real_is_nan(r: r)
            throw InvalidValueError(input: text, target: "Real")
        return r

### Materializes a `Real` from a tokenizer-validated decimal string (literal lowering).
### :param text: The decimal string (no suffix, no separators).
### :returns: The resulting `Real` value.
common routine Real.from_literal(text: Text) -> Real
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(x: bf_atof(text: text, radix: 10u64, prec: real_prec()).item0)
        C::rf_region_release(mark: mark)
        return r

# ============================================================================
# Lifetime (atomic refcount over the shared limb buffer)
# ============================================================================

### Returns a copy with the underlying refcount bumped; the limb buffer is shared.
### :returns: The resulting `Real` value.
@readonly
@inline
routine Real.assign() -> Real
    danger
        if not me.ctrl.is_none()
            me.ctrl.as_entity().hold()
    return Real(sign: me.sign, expn: me.expn, len: me.len, tab: me.tab, ctrl: me.ctrl)

### Releases this reference; frees the limb buffer when this was the last live ref.
@override
dangerous routine Real.destroy()
    if me.ctrl.is_none()
        return
    var prev = me.ctrl.as_entity().unhold()
    if prev <= 1_u64
        me.tab.invalidate()
        me.ctrl.invalidate()
    return

# ============================================================================
# Arithmetic (+, -, * exact; / rounded to the working precision)
# ============================================================================

### Adds `other` to this value (exact).
### :param you: The value to add.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the sum is too large for Real's exponent range.
@readonly
routine Real.add!(you: Real) -> Real
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(
            x: bf_add(a: real_bf(r: me), b: real_bf(r: you), prec: bf_prec_inf(), fl: 0u32),
        )
        C::rf_region_release(mark: mark)
        if real_is_infinite(r: r)
            throw NumericOverflowError(description: "overflow: the sum is too large for Real")
        return r

### Subtracts `other` from this value (exact).
### :param you: The value to subtract.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the difference is too large for Real's exponent range.
@readonly
routine Real.sub!(you: Real) -> Real
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(
            x: bf_sub(a: real_bf(r: me), b: real_bf(r: you), prec: bf_prec_inf(), fl: 0u32),
        )
        C::rf_region_release(mark: mark)
        if real_is_infinite(r: r)
            throw NumericOverflowError(description: "overflow: the difference is too large for Real")
        return r

### Returns `me + you`, promoting the real `me` to complex (imaginary part 0). Only `+`/`-` allow
### real↔complex mixing (arbitrary Real pairs with arbitrary Complex).
### :param you: The complex addend.
### :returns: The complex sum.
@readonly
routine Real.add(you: Complex) -> Complex
    return Complex(real: me).add(you)

### Returns `me - you`, promoting the real `me` to complex (imaginary part 0).
### :param you: The complex value to subtract.
### :returns: The complex difference.
@readonly
routine Real.sub(you: Complex) -> Complex
    return Complex(real: me).sub(you)

### Multiplies this value by `other` (exact).
### :param you: The value to multiply by.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the product is too large for Real's exponent range.
@readonly
routine Real.mul!(you: Real) -> Real
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(
            x: bf_mul(a: real_bf(r: me), b: real_bf(r: you), prec: bf_prec_inf(), fl: 0u32),
        )
        C::rf_region_release(mark: mark)
        if real_is_infinite(r: r)
            throw NumericOverflowError(description: "overflow: the product is too large for Real")
        return r

### Divides this value by `other`, rounded to the working precision.
### :param you: The non-zero divisor.
### :returns: The resulting `Real` value.
### :throws: {DivisionByZeroError} when `you` is zero and this value is not, and {NumericDomainError}
###     for 0 / 0, as with the binary and decimal floats.
### :throws: {NumericOverflowError} when the quotient is too large for Real's exponent range.
@readonly
routine Real.truediv!(you: Real) -> Real
    if you.is_zero()
        if me.is_zero()
            throw NumericDomainError(description: "domain error: 0 / 0 has no real result")
        throw DivisionByZeroError()
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(
            x: bf_div(a: real_bf(r: me), b: real_bf(r: you), prec: real_prec(), fl: 0u32),
        )
        C::rf_region_release(mark: mark)
        if real_is_infinite(r: r)
            throw NumericOverflowError(description: "overflow: the quotient is too large for Real")
        return r

### Returns the additive inverse of this value.
### :returns: The resulting `Real` value.
@readonly
routine Real.neg() -> Real
    danger
        return real_from_bf(x: bf_neg(a: real_bf(r: me)))

### Returns `true` when this value is strictly less than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Real.is_negative() -> Bool
    return bf_cmp(a: real_bf(r: me), b: bf_set_zero(is_neg: false)) < 0s64

### Returns `true` when this value is exactly zero.
### :returns: The resulting `Bool` value.
@readonly
routine Real.is_zero() -> Bool
    return bf_cmp(a: real_bf(r: me), b: bf_set_zero(is_neg: false)) == 0s64

### Returns the absolute value of this real number.
### :returns: The resulting `Real` value.
@readonly
routine Real.abs() -> Real
    if me.is_negative()
        return me.neg()
    return me.assign()

# ============================================================================
# Comparison
# ============================================================================

### Returns `true` when both values represent the same real number.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Real.eq(you: Real) -> Bool
    return bf_cmp(a: real_bf(r: me), b: real_bf(r: you)) == 0s64

### Compares this value with `you` under numeric ordering.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine Real.cmp(you: Real) -> ComparisonSign
    var c = bf_cmp(a: real_bf(r: me), b: real_bf(r: you))
    if c < 0s64
        return ME_SMALL
    elseif c > 0s64
        return ME_LARGE
    return SAME

# ============================================================================
# libm surface (rounded to the working precision)
# ============================================================================

### Square root.
### :returns: The resulting `Real` value.
### :throws: {NumericDomainError} when this value is negative (no real square root).
@readonly
routine Real.sqrt!() -> Real
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real square root")
    return me.sqrt(precision: 0_s32)

### Natural exponential e**me.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.exp!() -> Real
    var r = real_exp_raw(a: me, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of exp is too large for Real")
    return r

### Natural logarithm.
### :returns: The resulting `Real` value.
### :throws: {DivisionByZeroError} when this value is zero (the logarithm's pole), and
###     {NumericDomainError} when it is negative.
@readonly
routine Real.log!() -> Real
    if me.is_zero()
        throw DivisionByZeroError()
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real logarithm")
    return me.log(precision: 0_s32)

### Raises this value to the power `exp`.
### :param exp: The exponent.
### :returns: The resulting `Real` value.
### :throws: {NumericDomainError} when the base is negative and the exponent is not an
###          integer — that power has no real result (it would be complex).
### :throws: {DivisionByZeroError} when the base is zero and the exponent is negative, as 1 / 0 is.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.pow!(exp: Real) -> Real
    if me.is_zero() and exp.is_negative()
        throw DivisionByZeroError()
    if me.is_negative() and not exp.eq(you: exp.trunc())
        throw NumericDomainError(description: "pow: negative base with non-integer exponent has no real result")
    var r = real_pow_raw(x: me, y: exp, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the power is too large for Real")
    return r

### Sine (radians).
### :returns: The resulting `Real` value.
@readonly
routine Real.sin() -> Real
    return me.sin(precision: 0_s32)

### Cosine (radians).
### :returns: The resulting `Real` value.
@readonly
routine Real.cos() -> Real
    return me.cos(precision: 0_s32)

### Tangent (radians).
@readonly
routine Real.tan() -> Real
    return me.tan(precision: 0_s32)

### Inverse sine (radians).
### :throws: {NumericDomainError} when this value is outside [-1, 1].
@readonly
routine Real.asin!() -> Real
    if me.abs().cmp(you: Real.one()) == ME_LARGE
        throw NumericDomainError(description: "domain error: asin needs a value between -1 and 1")
    return me.asin(precision: 0_s32)

### Inverse cosine (radians).
### :throws: {NumericDomainError} when this value is outside [-1, 1].
@readonly
routine Real.acos!() -> Real
    if me.abs().cmp(you: Real.one()) == ME_LARGE
        throw NumericDomainError(description: "domain error: acos needs a value between -1 and 1")
    return me.acos(precision: 0_s32)

### Inverse tangent (radians).
@readonly
routine Real.atan() -> Real
    return me.atan(precision: 0_s32)

### Two-argument inverse tangent of `y / x` (radians), quadrant-aware.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
routine atan2(y: Real, x: Real) -> Real
    return atan2(y: y, x: x, precision: 0_s32)

### Hyperbolic sine.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.sinh!() -> Real
    var r = real_sinhcosh_raw(a: me, prec: real_prec(), is_cosh: false)
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of sinh is too large for Real")
    return r

### Hyperbolic cosine.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.cosh!() -> Real
    var r = real_sinhcosh_raw(a: me, prec: real_prec(), is_cosh: true)
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of cosh is too large for Real")
    return r

### Hyperbolic tangent.
@readonly
routine Real.tanh() -> Real
    return real_tanh_raw(a: me, prec: real_prec())

### Inverse hyperbolic sine.
@readonly
routine Real.asinh() -> Real
    return real_asinh_acosh_raw(a: me, prec: real_prec(), is_acosh: false)

### Inverse hyperbolic cosine.
### :throws: {NumericDomainError} when this value is below 1.
@readonly
routine Real.acosh!() -> Real
    if me.cmp(you: Real.one()) == ME_SMALL
        throw NumericDomainError(description: "domain error: acosh needs a value of at least 1")
    return real_asinh_acosh_raw(a: me, prec: real_prec(), is_acosh: true)

### Inverse hyperbolic tangent.
### :throws: {DivisionByZeroError} when this value is 1 or -1 (the poles), and {NumericDomainError}
###     when it is outside [-1, 1].
@readonly
routine Real.atanh!() -> Real
    var size = me.abs().cmp(you: Real.one())
    if size == SAME
        throw DivisionByZeroError()
    if size == ME_LARGE
        throw NumericDomainError(description: "domain error: atanh needs a value between -1 and 1")
    return me.atanh(precision: 0_s32)

### Base-2 logarithm.
### :throws: {DivisionByZeroError} when this value is zero, and {NumericDomainError} when it is negative.
@readonly
routine Real.log2!() -> Real
    if me.is_zero()
        throw DivisionByZeroError()
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real logarithm")
    return me.log2(precision: 0_s32)

### Base-10 logarithm.
### :throws: {DivisionByZeroError} when this value is zero, and {NumericDomainError} when it is negative.
@readonly
routine Real.log10!() -> Real
    if me.is_zero()
        throw DivisionByZeroError()
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real logarithm")
    return me.log10(precision: 0_s32)

### Euclidean distance `sqrt(x^2 + y^2)` without intermediate overflow.
### :param x: One leg.
### :param y: The other leg.
### :throws: {NumericOverflowError} when the distance is too large for Real's exponent range.
routine hypot!(x: Real, y: Real) -> Real
    var r = real_hypot_raw(x: x, y: y, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the distance is too large for Real")
    return r

### 3D Euclidean distance `sqrt(x^2 + y^2 + z^2)` without intermediate overflow. Composed as
### `hypot(hypot(x, y), z)`.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
### :throws: {NumericOverflowError} when the distance is too large for Real's exponent range.
routine hypot!(x: Real, y: Real, z: Real) -> Real
    var xy = real_hypot_raw(x: x, y: y, prec: real_prec())
    if real_is_infinite(r: xy)
        throw NumericOverflowError(description: "overflow: the distance is too large for Real")
    var r = real_hypot_raw(x: xy, y: z, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the distance is too large for Real")
    return r

### Cube root.
@readonly
routine Real.cbrt() -> Real
    return me.cbrt(precision: 0_s32)

# --- Precision-aware variants (precision = decimal significant digits; 0 or less = the default) ---

### Divides this value by `other`, rounding to `precision` decimal digits.
### :param you: The non-zero divisor.
### :param precision: The number of decimal significant digits.
### :returns: The resulting `Real` value.
### :throws: {DivisionByZeroError} when `you` is zero and this value is not, and {NumericDomainError}
###     for 0 / 0.
### :throws: {NumericOverflowError} when the quotient is too large for Real's exponent range.
@readonly
routine Real.divide!(you: Real, precision: S32) -> Real
    if you.is_zero()
        if me.is_zero()
            throw NumericDomainError(description: "domain error: 0 / 0 has no real result")
        throw DivisionByZeroError()
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(
            x: bf_div(
                a: real_bf(r: me),
                b: real_bf(r: you),
                prec: real_prec_bits(digits: precision),
                fl: 0u32,
            ),
        )
        C::rf_region_release(mark: mark)
        if real_is_infinite(r: r)
            throw NumericOverflowError(description: "overflow: the quotient is too large for Real")
        return r

### Square root to `precision` decimal digits.
### :throws: {NumericDomainError} when this value is negative (no real square root).
@readonly
routine Real.sqrt!(precision: S32) -> Real
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real square root")
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(
            x: bf_sqrt(a: real_bf(r: me), prec: real_prec_bits(digits: precision), fl: 0u32),
        )
        C::rf_region_release(mark: mark)
        return r

### Natural exponential to `precision` decimal digits.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.exp!(precision: S32) -> Real
    var r = real_exp_raw(a: me, prec: real_prec_bits(digits: precision))
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of exp is too large for Real")
    return r

### Natural logarithm to `precision` decimal digits.
### :throws: {DivisionByZeroError} when this value is zero (the logarithm's pole), and
###     {NumericDomainError} when it is negative.
@readonly
routine Real.log!(precision: S32) -> Real
    if me.is_zero()
        throw DivisionByZeroError()
    if me.is_negative()
        throw NumericDomainError(description: "domain error: a negative number has no real logarithm")
    danger
        var mark = C::rf_region_mark()
        var r = real_from_bf(
            x: bf_log(a: real_bf(r: me), prec: real_prec_bits(digits: precision), fl: 0u32),
        )
        C::rf_region_release(mark: mark)
        return r

### Raises this value to `exp` to `precision` decimal digits.
### :param exp: The exponent.
### :param precision: The number of decimal significant digits.
### :returns: The resulting `Real` value.
### :throws: {NumericDomainError} when the base is negative and the exponent is not an integer.
### :throws: {DivisionByZeroError} when the base is zero and the exponent is negative, as 1 / 0 is.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.pow!(exp: Real, precision: S32) -> Real
    if me.is_zero() and exp.is_negative()
        throw DivisionByZeroError()
    if me.is_negative() and not exp.eq(you: exp.trunc())
        throw NumericDomainError(description: "pow: negative base with non-integer exponent has no real result")
    var r = real_pow_raw(x: me, y: exp, prec: real_prec_bits(digits: precision))
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the power is too large for Real")
    return r

