# ============================================================================
# Sign predicates, selection, rounding, extra exponentials, and constants
# ============================================================================

### Returns `true` when this value is strictly greater than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Real.is_positive() -> Bool
    var c = bf_cmp(a: real_bf(r: me), b: bf_set_zero(is_neg: false))
    return c > 0s64 and c != 2s64

### Returns the sign of this value as a `Real` -1, 0, or +1.
### :returns: The resulting `Real` value.
@readonly
routine Real.signum() -> Real
    if me.is_negative()
        return Real(from: -1_s64)
    if me.is_zero()
        return Real.zero()
    return Real(from: 1_s64)

### Returns the smaller of this value and `other`.
### :param you: The value to compare against.
### :returns: The resulting `Real` value.
@readonly
routine Real.min(you: Real) -> Real
    if me.cmp(you: you) == ME_LARGE
        return you.assign()
    return me.assign()

### Returns the larger of this value and `other`.
### :param you: The value to compare against.
### :returns: The resulting `Real` value.
@readonly
routine Real.max(you: Real) -> Real
    if me.cmp(you: you) == ME_SMALL
        return you.assign()
    return me.assign()

### Returns this value's magnitude carrying the sign of `you`.
### :param you: The value supplying the sign.
### :returns: The resulting `Real` value.
@readonly
routine Real.copysign(you: Real) -> Real
    if you.is_negative()
        return me.abs().neg()
    return me.abs()

# Rounds `r` to an integer in the engine rounding mode `rnd`.
secret routine real_rint(r: Real, rnd: U32) -> Real
    danger
        var mark = C::rf_region_mark()
        var result = real_from_bf(x: bf_rint(a: real_bf(r: r), rnd: rnd))
        C::rf_region_release(mark: mark)
        return result

### Rounds toward negative infinity (the largest integer not greater than `me`).
### :returns: The resulting `Real` value.
@readonly
routine Real.floor() -> Real
    return real_rint(r: me, rnd: 2u32)

### Rounds toward positive infinity (the smallest integer not less than `me`).
### :returns: The resulting `Real` value.
@readonly
routine Real.ceil() -> Real
    return real_rint(r: me, rnd: 3u32)

### Truncates toward zero (drops the fractional part).
### :returns: The resulting `Real` value.
@readonly
routine Real.trunc() -> Real
    return real_rint(r: me, rnd: 1u32)

### Rounds to the nearest integer, ties away from zero.
### :returns: The resulting `Real` value.
@readonly
routine Real.round() -> Real
    return real_rint(r: me, rnd: 4u32)

### Rounds to the nearest integer, ties to even (banker's rounding).
### :returns: The resulting `Real` value.
@readonly
routine Real.rint() -> Real
    return real_rint(r: me, rnd: 0u32)

### Returns the fractional part `me - trunc(me)` (same sign as `me`).
### :returns: The resulting `Real` value.
@readonly
routine Real.frac() -> Real
    return me - me.trunc()

### Base-2 exponential `2^me`, rounded to the working precision.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.exp2!() -> Real
    var r = real_pow_raw(x: Real(from: 2_s64), y: me, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of exp2 is too large for Real")
    return r

### Base-10 exponential `10^me`, rounded to the working precision.
### :returns: The resulting `Real` value.
### :throws: {NumericOverflowError} when the result is too large for Real's exponent range.
@readonly
routine Real.exp10!() -> Real
    var r = real_pow_raw(x: Real(from: 10_s64), y: me, prec: real_prec())
    if real_is_infinite(r: r)
        throw NumericOverflowError(description: "overflow: the result of exp10 is too large for Real")
    return r

### The constant e (base of the natural logarithm), at the working precision.
### :returns: The resulting `Real` value.
common routine Real.e() -> Real
    return Real.one().exp()

### The constant e to `precision` decimal digits.
### :param precision: The number of decimal significant digits.
### :returns: The resulting `Real` value.
common routine Real.e(precision: S32) -> Real
    return Real.one().exp(precision: precision)

### The constant pi (computed as `4 * atan(1)`), at the working precision.
### :returns: The resulting `Real` value.
common routine Real.pi() -> Real
    return Real.one().atan() * Real(from: 4_s64)

### The constant pi to `precision` decimal digits.
### :param precision: The number of decimal significant digits.
### :returns: The resulting `Real` value.
common routine Real.pi(precision: S32) -> Real
    return Real.one().atan(precision: precision) * Real(from: 4_s64)

# ============================================================================
# Conversion / representation / hashing
# ============================================================================

### Rounds this value to the nearest B64.
### :returns: The resulting `B64` value.
@readonly
routine Real.to_b64() -> B64
    danger
        var mark = C::rf_region_mark()
        var d = bf_get_b64(a: real_bf(r: me))
        C::rf_region_release(mark: mark)
        return d

### Serializes this value as its shortest round-tripping decimal text (see `represent`).
### :returns: The `SerialValue` text arm.
@readonly
@override
routine Real.serialize() -> SerialValue
    return SerialValue(from: me.represent())

### Builds a `Real` from its serialized decimal text.
### :param from: The serialized value.
### :returns: The parsed value.
### :throws: {SerialShapeError} when the value is not text, or a parse error when the text is not a number.
routine Real!(from: SerialValue) -> Real
    return Real(text: serial_text(value: from))

### Formats this value as base-10 decimal text: the fewest digits that read back to exactly this value
### at the working precision.
### :returns: The resulting `Text` value.
@readonly
@override
routine Real.represent() -> Text
    danger
        var mark = C::rf_region_mark()
        var text = bf_ftoa_free_min(a: real_bf(r: me), prec: real_prec())
        C::rf_region_release(mark: mark)
        return text

### Renders this value with exactly `places` digits after the point, the integer part written out in
### full. Same as `represent_with_places`, so ties round away from zero (the binary and decimal floats'
### `fixed` round ties to even).
### :param places: The number of digits after the point (0 for none).
### :returns: The rendered `Text`.
@readonly
routine Real.fixed(places: U64) -> Text
    return me.represent_with_places(decimal_places: LLVM::int_truncate[U64, S32](places))

### Formats this value with EXACTLY `decimal_places` digits after the decimal point,
### rounding to nearest (ties away from zero). A negative `decimal_places` is treated as 0.
### Works by scaling to an integer (`value * 10^places`), rounding, then placing the point on
### the resulting exact digit string — so the output is not perturbed by binary float artifacts.
### :param decimal_places: The number of fractional digits to render.
### :returns: The resulting `Text` value.
@readonly
routine Real.represent_with_places(decimal_places: S32) -> Text
    var places = if decimal_places < 0_s32 then 0_s32 else decimal_places
    var n = U64(from: LLVM::reinterpret_bits[S32, U32](places))
    var neg = me.is_negative()
    var ten = Real.from_literal(text: "10")
    var scale = Real.from_literal(text: "1")
    var k = 0u64
    while k < n
        scale = scale.mul(you: ten)
        k = k + 1u64
    var scaled = me
        .abs()
        .mul(you: scale)
        .round()
    var digits = scaled.represent()
    # Guarantee at least one integer digit before the point (e.g. 0.5 with places=2 -> "050").
    while digits.count() <= n
        digits = "0" + digits
    # Split the exact digit string at `count - n` into integer + fractional parts (char loop —
    # Text range-slicing is not relied on here).
    var len = digits.count()
    var cut = len - n
    var int_chars = List[Character]()
    var frac_chars = List[Character]()
    var idx = 0u64
    while idx < len
        if idx < cut
            int_chars.add_last(value: digits[idx])
        else
            frac_chars.add_last(value: digits[idx])
        idx = idx + 1u64
    var body = Text(from_list: steal int_chars)
    if n > 0u64
        body = body + "." + Text(from_list: steal frac_chars)
    if neg and not scaled.is_zero()
        return "-" + body
    return body

### Hashes the canonical decimal representation, so equal reals hash equally.
### :param k0: The first hash key half.
### :param k1: The second hash key half.
### :returns: The resulting `U64` value.
@readonly
routine Real.hash(k0: U64, k1: U64) -> U64
    return me.represent().hash(k0: k0, k1: k1)
