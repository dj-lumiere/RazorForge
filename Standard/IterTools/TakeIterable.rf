module IterTools

### Represents a lazy adapter that yields at most `limit` elements from a source sequence.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSource: The concrete source iterable type (borrowed; enables build-time dispatch).
entity TakeIterable[T, TSource]
relates TakeEmittable[T, TSource/Iter] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
    ### Stores the source iterable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### Stores the maximum number of values to yield.
    secret limit: U64

### Iterates over at most the configured number of values from the source sequence.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSourceIter: The concrete source iterator type (owned).
entity TakeEmittable[T, TSourceIter]
obeys Emittable[T]
needs TSourceIter obeys Emittable[T]
    ### Stores the underlying source iterator (owned; destroyed with the adapter).
    secret source: TSourceIter
    ### Stores how many values may still be yielded.
    secret remaining: U64

### Returns the stateful iterator that enforces the configured take limit.
### The emitted iterator decrements its remaining budget on each successful
### yield.
### :returns: The resulting `TakeEmittable[T, TSource/Iter]` value.
@readonly
routine TakeIterable[T, TSource].iter() -> TakeEmittable[T, TSource/Iter]
    danger
        return TakeEmittable[T, TSource/Iter](source: me.source.as_entity().iter(), remaining: me.limit)

### Returns the next value while the remaining take budget is still positive.
### Iteration stops once the configured limit has been reached, even if the
### source still has more values available.
### :returns: The resulting `T` value.
### :absent: Returns absent when the take limit has been exhausted or the source ends first.
routine TakeEmittable[T, TSourceIter].emit!() -> T
    danger
        if me.remaining == 0u64
            absent
        var _result = me.source.emit()
        me.remaining = me.remaining - 1u64
        return _result

### Returns a lazy adapter that yields at most `count` values.
### This is useful for truncating potentially long or infinite iterables.
### :param count: The maximum number of values to take.
### :returns: The resulting `TakeIterable[T, Me]` value.
@readonly
routine Iterable[T].take(count: U64) -> TakeIterable[T, Me]
    danger
        return TakeIterable[T, Me](source: me.hijack(), limit: count)
