module IterTools

### Represents a lazy filtering adapter over a source iterable.
### The adapter can keep either matching or non-matching items depending on `inverted`.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSource: The concrete source iterable type (borrowed; enables build-time dispatch).
entity WhereIterable[T, TSource]
relates WhereEmittable[T, TSource/Iter] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
    ### Stores the source iterable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### Stores the predicate used to test each source value.
    secret predicate: Routine[(T,), Bool]
    ### Stores whether the predicate result should be inverted.
    secret inverted: Bool

### Iterates over a source sequence while yielding only values that satisfy the effective filter.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSourceIter: The concrete source iterator type (owned).
entity WhereEmittable[T, TSourceIter]
obeys Emittable[T]
needs TSourceIter obeys Emittable[T]
    ### Stores the underlying source iterator (owned; destroyed with the adapter).
    secret source: TSourceIter
    ### Stores the predicate used for filtering.
    secret predicate: Routine[(T,), Bool]
    ### Stores whether matches should be inverted.
    secret inverted: Bool

### Returns the stateful iterator that applies the filter lazily.
### Source values are examined only as the caller requests more output values.
### :returns: The resulting `WhereEmittable[T, TSource/Iter]` value.
@readonly
routine WhereIterable[T, TSource].iter() -> WhereEmittable[T, TSource/Iter]
    danger
        return WhereEmittable[T, TSource/Iter](
            source: me.source.as_entity().iter(),
            predicate: me.predicate,
            inverted: me.inverted,
        )

### Returns the next value that satisfies the effective filter condition.
### Source values are consumed and discarded until one passes the filter.
### :returns: The resulting `T` value.
routine WhereEmittable[T, TSourceIter].emit!() -> TSourceIter/Item
    danger
        loop
            var item = me.source.emit()
            var matches = me.predicate(item)
            if me.inverted
                matches = not matches
            if matches
                return item

### Returns a lazy adapter that keeps only values for which `predicate` returns
### `true`.
### :param predicate: The filter predicate.
### :returns: The resulting `WhereIterable[T, Me]` value.
@readonly
routine Iterable[T].where(predicate: Routine[(T,), Bool]) -> WhereIterable[T, Me]
    danger
        return WhereIterable[T, Me](source: me.hijack(), predicate: predicate, inverted: false)

### Returns a lazy adapter that keeps only values for which `predicate` returns
### `false`.
### :param predicate: The filter predicate.
### :returns: The resulting `WhereIterable[T, Me]` value.
@readonly
routine Iterable[T].where_not(predicate: Routine[(T,), Bool]) -> WhereIterable[T, Me]
    danger
        return WhereIterable[T, Me](source: me.hijack(), predicate: predicate, inverted: true)
