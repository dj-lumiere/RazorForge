module IterTools

### Represents a lazy adapter that pairs elements from two sources into tuples.
### Iteration stops as soon as either source is exhausted.
### :typeparam TFirst: The element type of the first source sequence.
### :typeparam TSecond: The element type of the second source sequence.
### :typeparam TFirstSource: The concrete first source emittable type (referenced, not owned).
### :typeparam TSecondSource: The concrete second source emittable type (referenced, not owned).
entity ZipEmittable[TFirst, TSecond, TFirstSource, TSecondSource]
relates ZipEmitter[TFirst, TSecond, TFirstSource/Emitter, TSecondSource/Emitter] as Emitter
obeys Emittable[Tuple[TFirst, TSecond]]
needs TFirstSource obeys Emittable[TFirst]
needs TSecondSource obeys Emittable[TSecond]
    ### Stores the first source emittable (referenced, not owned).
    secret first: Hijacked[TFirstSource]
    ### Stores the second source emittable (referenced, not owned).
    secret second: Hijacked[TSecondSource]

### Iterates over two source sequences simultaneously, pairing one element from each.
### Iteration ends when either source is exhausted.
### :typeparam TFirst: The element type of the first source.
### :typeparam TSecond: The element type of the second source.
### :typeparam TFirstEmitter: The concrete first source emitter type (referenced, not owned).
### :typeparam TSecondEmitter: The concrete second source emitter type (referenced, not owned).
entity ZipEmitter[TFirst, TSecond, TFirstEmitter, TSecondEmitter]
obeys Emitter[Tuple[TFirst, TSecond]]
needs TFirstEmitter obeys Emitter[TFirst]
needs TSecondEmitter obeys Emitter[TSecond]
    ### Stores the emitter for the first source (referenced, not owned).
    secret first: TFirstEmitter
    ### Stores the emitter for the second source (referenced, not owned).
    secret second: TSecondEmitter

### Represents a lazy adapter that pairs elements from three sources into triples.
### Iteration stops as soon as any source is exhausted.
### :typeparam TFirst: The element type of the first source sequence.
### :typeparam TSecond: The element type of the second source sequence.
### :typeparam TThird: The element type of the third source sequence.
### :typeparam TFirstSource: The concrete first source emittable type (referenced, not owned).
### :typeparam TSecondSource: The concrete second source emittable type (referenced, not owned).
### :typeparam TThirdSource: The concrete third source emittable type (referenced, not owned).
entity Zip3Emittable[TFirst, TSecond, TThird, TFirstSource, TSecondSource, TThirdSource]
relates Zip3Emitter[TFirst, TSecond, TThird, TFirstSource/Emitter, TSecondSource/Emitter, TThirdSource/Emitter] as Emitter
obeys Emittable[Tuple[TFirst, TSecond, TThird]]
needs TFirstSource obeys Emittable[TFirst]
needs TSecondSource obeys Emittable[TSecond]
needs TThirdSource obeys Emittable[TThird]
    ### Stores the first source emittable (referenced, not owned).
    secret first: Hijacked[TFirstSource]
    ### Stores the second source emittable (referenced, not owned).
    secret second: Hijacked[TSecondSource]
    ### Stores the third source emittable (referenced, not owned).
    secret third: Hijacked[TThirdSource]

### Iterates over three source sequences simultaneously, pairing one element from each.
### Iteration ends when any source is exhausted.
### :typeparam TFirst: The element type of the first source.
### :typeparam TSecond: The element type of the second source.
### :typeparam TThird: The element type of the third source.
### :typeparam TFirstEmitter: The concrete first source emitter type (referenced, not owned).
### :typeparam TSecondEmitter: The concrete second source emitter type (referenced, not owned).
### :typeparam TThirdEmitter: The concrete third source emitter type (referenced, not owned).
entity Zip3Emitter[TFirst, TSecond, TThird, TFirstEmitter, TSecondEmitter, TThirdEmitter]
obeys Emitter[Tuple[TFirst, TSecond, TThird]]
needs TFirstEmitter obeys Emitter[TFirst]
needs TSecondEmitter obeys Emitter[TSecond]
needs TThirdEmitter obeys Emitter[TThird]
    ### Stores the emitter for the first source (referenced, not owned).
    secret first: TFirstEmitter
    ### Stores the emitter for the second source (referenced, not owned).
    secret second: TSecondEmitter
    ### Stores the emitter for the third source (referenced, not owned).
    secret third: TThirdEmitter

### Represents a lazy adapter that pairs elements from four sources into quadruples.
### Iteration stops as soon as any source is exhausted.
### :typeparam TFirst: The element type of the first source sequence.
### :typeparam TSecond: The element type of the second source sequence.
### :typeparam TThird: The element type of the third source sequence.
### :typeparam TFourth: The element type of the fourth source sequence.
### :typeparam TFirstSource: The concrete first source emittable type (referenced, not owned).
### :typeparam TSecondSource: The concrete second source emittable type (referenced, not owned).
### :typeparam TThirdSource: The concrete third source emittable type (referenced, not owned).
### :typeparam TFourthSource: The concrete fourth source emittable type (referenced, not owned).
entity Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstSource, TSecondSource, TThirdSource, TFourthSource]
relates Zip4Emitter[TFirst, TSecond, TThird, TFourth, TFirstSource/Emitter, TSecondSource/Emitter, TThirdSource/Emitter, TFourthSource/Emitter] as Emitter
obeys Emittable[Tuple[TFirst, TSecond, TThird, TFourth]]
needs TFirstSource obeys Emittable[TFirst]
needs TSecondSource obeys Emittable[TSecond]
needs TThirdSource obeys Emittable[TThird]
needs TFourthSource obeys Emittable[TFourth]
    ### Stores the first source emittable (referenced, not owned).
    secret first: Hijacked[TFirstSource]
    ### Stores the second source emittable (referenced, not owned).
    secret second: Hijacked[TSecondSource]
    ### Stores the third source emittable (referenced, not owned).
    secret third: Hijacked[TThirdSource]
    ### Stores the fourth source emittable (referenced, not owned).
    secret fourth: Hijacked[TFourthSource]

### Iterates over four source sequences simultaneously, pairing one element from each.
### Iteration ends when any source is exhausted.
### :typeparam TFirst: The element type of the first source.
### :typeparam TSecond: The element type of the second source.
### :typeparam TThird: The element type of the third source.
### :typeparam TFourth: The element type of the fourth source.
### :typeparam TFirstEmitter: The concrete first source emitter type (referenced, not owned).
### :typeparam TSecondEmitter: The concrete second source emitter type (referenced, not owned).
### :typeparam TThirdEmitter: The concrete third source emitter type (referenced, not owned).
### :typeparam TFourthEmitter: The concrete fourth source emitter type (referenced, not owned).
entity Zip4Emitter[TFirst, TSecond, TThird, TFourth, TFirstEmitter, TSecondEmitter, TThirdEmitter, TFourthEmitter]
obeys Emitter[Tuple[TFirst, TSecond, TThird, TFourth]]
needs TFirstEmitter obeys Emitter[TFirst]
needs TSecondEmitter obeys Emitter[TSecond]
needs TThirdEmitter obeys Emitter[TThird]
needs TFourthEmitter obeys Emitter[TFourth]
    ### Stores the emitter for the first source (referenced, not owned).
    secret first: TFirstEmitter
    ### Stores the emitter for the second source (referenced, not owned).
    secret second: TSecondEmitter
    ### Stores the emitter for the third source (referenced, not owned).
    secret third: TThirdEmitter
    ### Stores the emitter for the fourth source (referenced, not owned).
    secret fourth: TFourthEmitter

### Returns the stateful emitter that produces paired tuples lazily.
### :returns: The resulting `ZipEmitter[TFirst, TSecond, TFirstSource/Emitter, TSecondSource/Emitter]` value.
@readonly
routine ZipEmittable[TFirst, TSecond, TFirstSource, TSecondSource].emitter() -> ZipEmitter[TFirst, TSecond, TFirstSource/Emitter, TSecondSource/Emitter]
    danger
        return ZipEmitter[TFirst, TSecond, TFirstSource/Emitter, TSecondSource/Emitter](
            first: me.first.referent().emitter(),
            second: me.second.referent().emitter(),
        )

### Returns the next paired tuple from both source emitters.
### Propagates absence as soon as either source is exhausted.
### :returns: The resulting `Tuple[TFirst, TSecond]` value.
failable routine ZipEmitter[TFirst, TSecond, TFirstEmitter, TSecondEmitter].emit() -> Tuple[TFirst, TSecond]
    danger
        var a = me.first.emit()
        var b = me.second.emit()
        return (a, b)

### Returns a lazy adapter that pairs each element of `a` with an element of `b`.
### Stops when either source is exhausted.
### `zip` is a symmetric n-ary combinator, so `zip(a, b)` reads as a peer combination
### rather than a method call on one operand.
### :param a: The first source emittable to zip.
### :param b: The second source emittable to zip.
### :returns: The resulting `ZipEmittable[TFirst, TSecond, TFirstSource, TSecondSource]` value.
routine zip[TFirst, TSecond, TFirstSource, TSecondSource](a: Viewing[TFirstSource], b: Viewing[TSecondSource]) -> ZipEmittable[TFirst, TSecond, TFirstSource, TSecondSource]
needs TFirstSource obeys Emittable[TFirst]
needs TSecondSource obeys Emittable[TSecond]
    danger
        return ZipEmittable[TFirst, TSecond, TFirstSource, TSecondSource](first: a.hijack(), second: b.hijack())

### Returns the stateful emitter that produces paired triples lazily.
### :returns: The resulting `Zip3Emitter[TFirst, TSecond, TThird, TFirstSource/Emitter, TSecondSource/Emitter, TThirdSource/Emitter]` value.
@readonly
routine Zip3Emittable[TFirst, TSecond, TThird, TFirstSource, TSecondSource, TThirdSource].emitter() -> Zip3Emitter[TFirst, TSecond, TThird, TFirstSource/Emitter, TSecondSource/Emitter, TThirdSource/Emitter]
    danger
        return Zip3Emitter[TFirst, TSecond, TThird, TFirstSource/Emitter, TSecondSource/Emitter, TThirdSource/Emitter](
            first: me.first.referent().emitter(),
            second: me.second.referent().emitter(),
            third: me.third.referent().emitter(),
        )

### Returns the next paired triple from all three source emitters.
### Propagates absence as soon as any source is exhausted.
### :returns: The resulting `Tuple[TFirst, TSecond, TThird]` value.
failable routine Zip3Emitter[TFirst, TSecond, TThird, TFirstEmitter, TSecondEmitter, TThirdEmitter].emit() -> Tuple[TFirst, TSecond, TThird]
    danger
        var a = me.first.emit()
        var b = me.second.emit()
        var c = me.third.emit()
        return (a, b, c)

### Returns a lazy adapter that pairs each element of `a`, `b`, and `c` into a triple.
### Stops when the shortest of the three sources is exhausted.
### :param a: The first source emittable to zip.
### :param b: The second source emittable to zip.
### :param c: The third source emittable to zip.
### :returns: The resulting `Zip3Emittable[TFirst, TSecond, TThird, TFirstSource, TSecondSource, TThirdSource]` value.
routine zip[TFirst, TSecond, TThird, TFirstSource, TSecondSource, TThirdSource](
    a: Viewing[TFirstSource],
    b: Viewing[TSecondSource],
    c: Viewing[TThirdSource],
) -> Zip3Emittable[TFirst, TSecond, TThird, TFirstSource, TSecondSource, TThirdSource]
needs TFirstSource obeys Emittable[TFirst]
needs TSecondSource obeys Emittable[TSecond]
needs TThirdSource obeys Emittable[TThird]
    danger
        return Zip3Emittable[TFirst, TSecond, TThird, TFirstSource, TSecondSource, TThirdSource](
            first: a.hijack(),
            second: b.hijack(),
            third: c.hijack(),
        )

### Returns the stateful emitter that produces paired quadruples lazily.
### :returns: The resulting `Zip4Emitter[...]` value.
@readonly
routine Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstSource, TSecondSource, TThirdSource, TFourthSource].emitter() -> Zip4Emitter[TFirst, TSecond, TThird, TFourth, TFirstSource/Emitter, TSecondSource/Emitter, TThirdSource/Emitter, TFourthSource/Emitter]
    danger
        return Zip4Emitter[TFirst, TSecond, TThird, TFourth, TFirstSource/Emitter, TSecondSource/Emitter, TThirdSource/Emitter, TFourthSource/Emitter](
            first: me.first.referent().emitter(),
            second: me.second.referent().emitter(),
            third: me.third.referent().emitter(),
            fourth: me.fourth.referent().emitter(),
        )

### Returns the next paired quadruple from all four source emitters.
### Propagates absence as soon as any source is exhausted.
### :returns: The resulting `Tuple[TFirst, TSecond, TThird, TFourth]` value.
failable routine Zip4Emitter[TFirst, TSecond, TThird, TFourth, TFirstEmitter, TSecondEmitter, TThirdEmitter, TFourthEmitter].emit() -> Tuple[TFirst, TSecond, TThird, TFourth]
    danger
        var a = me.first.emit()
        var b = me.second.emit()
        var c = me.third.emit()
        var d = me.fourth.emit()
        return (a, b, c, d)

### Returns a lazy adapter that pairs each element of `a`, `b`, `c`, and `d` into a quadruple.
### Stops when the shortest of the four sources is exhausted.
### :param a: The first source emittable to zip.
### :param b: The second source emittable to zip.
### :param c: The third source emittable to zip.
### :param d: The fourth source emittable to zip.
### :returns: The resulting `Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstSource, TSecondSource, TThirdSource, TFourthSource]` value.
routine zip[TFirst, TSecond, TThird, TFourth, TFirstSource, TSecondSource, TThirdSource, TFourthSource](
    a: Viewing[TFirstSource],
    b: Viewing[TSecondSource],
    c: Viewing[TThirdSource],
    d: Viewing[TFourthSource],
) -> Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstSource, TSecondSource, TThirdSource, TFourthSource]
needs TFirstSource obeys Emittable[TFirst]
needs TSecondSource obeys Emittable[TSecond]
needs TThirdSource obeys Emittable[TThird]
needs TFourthSource obeys Emittable[TFourth]
    danger
        return Zip4Emittable[TFirst, TSecond, TThird, TFourth, TFirstSource, TSecondSource, TThirdSource, TFourthSource](
            first: a.hijack(),
            second: b.hijack(),
            third: c.hijack(),
            fourth: d.hijack(),
        )
