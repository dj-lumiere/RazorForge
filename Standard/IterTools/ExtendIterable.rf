module IterTools

### Represents a lazy adapter that yields one iterable after another.
### The second sequence is not touched until the first one is exhausted.
### :typeparam T: The element type produced by both source sequences.
### :typeparam TFirstSource: The concrete first source iterable type (borrowed).
### :typeparam TSecondSource: The concrete second source iterable type (borrowed).
entity ExtendIterable[T, TFirstSource, TSecondSource]
relates ExtendEmittable[T, TFirstSource/Iter, TSecondSource/Iter] as Iter
obeys Iterable[T]
needs TFirstSource obeys Iterable[T]
needs TSecondSource obeys Iterable[T]
    ### Stores the first source iterable (borrowed, not owned).
    secret first: Hijacked[TFirstSource]
    ### Stores the second source iterable (borrowed, not owned).
    secret second: Hijacked[TSecondSource]

### Iterates over an `ExtendIterable` by exhausting the first source before moving to the second.
### :typeparam T: The element type produced by the concatenated sequence.
### :typeparam TFirstIter: The concrete first source iterator type (owned).
### :typeparam TSecondIter: The concrete second source iterator type (owned).
entity ExtendEmittable[T, TFirstIter, TSecondIter]
obeys Emittable[T]
needs TFirstIter obeys Emittable[T]
needs TSecondIter obeys Emittable[T]
    ### Stores the iterator for the first source (owned; destroyed with the adapter).
    secret first: TFirstIter
    ### Stores the iterator for the second source (owned; destroyed with the adapter).
    secret second: TSecondIter
    ### Stores whether iteration has already advanced into the second source.
    secret in_second: Bool

### Returns the stateful iterator that concatenates the two source sequences.
### The returned emitter walks `first` to completion before switching to `second`.
### :returns: The resulting `ExtendEmittable[T, TFirstSource/Iter, TSecondSource/Iter]` value.
@readonly
routine ExtendIterable[T, TFirstSource, TSecondSource].iter() -> ExtendEmittable[T, TFirstSource/Iter, TSecondSource/Iter]
    danger
        return ExtendEmittable[T, TFirstSource/Iter, TSecondSource/Iter](
            first: me.first.as_entity().iter(),
            second: me.second.as_entity().iter(),
            in_second: false,
        )

### Returns the next value from the concatenated sequence.
### Once the first iterator is exhausted, all remaining values come from the second iterator.
### :returns: The resulting `T` value.
routine ExtendEmittable[T, TFirstIter, TSecondIter].emit!() -> T
    danger
        if not me.in_second
            var result = try me.first.emit()
            when result
                is None => me.in_second = true
                else item =>
                    return item
        return me.second.emit()

### Returns a lazy concatenation of this iterable and `other`.
### :param other: The iterable to consume after `me`.
### :returns: The resulting `ExtendIterable[T, Me, TOther]` value.
@readonly
routine Iterable[T].extend[TOther](other: Accessing[TOther]) -> ExtendIterable[T, Me, TOther]
needs TOther obeys Iterable[T]
    danger
        return ExtendIterable[T, Me, TOther](first: me.hijack(), second: other.hijack())
