module IterTools

### Represents a lazy adapter that yields elements present in both this iterable and another.
### The second iterable is fully materialized into a set when iteration begins.
### :typeparam T: The element type of both source sequences.
### :typeparam TSource: The concrete primary source iterable type (borrowed).
### :typeparam TOther: The concrete membership-test iterable type (borrowed).
entity IntersectIterable[T, TSource, TOther]
relates IntersectEmittable[T, TSource/Iter] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
needs TOther obeys Iterable[T]
    ### Stores the primary source iterable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### Stores the membership-test iterable to materialize at iteration start (borrowed).
    secret you: Hijacked[TOther]

### Iterates over a source sequence and keeps only elements that appear in the membership set.
### :typeparam T: The element type of the filtered sequence.
### :typeparam TSourceIter: The concrete source iterator type (owned).
entity IntersectEmittable[T, TSourceIter]
obeys Emittable[T]
needs TSourceIter obeys Emittable[T]
    ### Stores the underlying source iterator (owned; destroyed with the adapter).
    secret source: TSourceIter
    ### Stores the pre-materialized membership set.
    secret you: Set[T]

### Represents a lazy adapter that suppresses elements present in another iterable.
### The exclusion iterable is fully materialized into a set when iteration begins.
### :typeparam T: The element type of both source sequences.
### :typeparam TSource: The concrete primary source iterable type (borrowed).
### :typeparam TOther: The concrete exclusion iterable type (borrowed).
entity ExcludeIterable[T, TSource, TOther]
relates ExcludeEmittable[T, TSource/Iter] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
needs TOther obeys Iterable[T]
    ### Stores the primary source iterable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### Stores the exclusion iterable to materialize at iteration start (borrowed).
    secret you: Hijacked[TOther]

### Iterates over a source sequence and suppresses elements found in the exclusion set.
### :typeparam T: The element type of the filtered sequence.
### :typeparam TSourceIter: The concrete source iterator type (owned).
entity ExcludeEmittable[T, TSourceIter]
obeys Emittable[T]
needs TSourceIter obeys Emittable[T]
    ### Stores the underlying source iterator (owned; destroyed with the adapter).
    secret source: TSourceIter
    ### Stores the pre-materialized exclusion set.
    secret you: Set[T]

### Materializes `other` into a set and returns an iterator that filters `source` against it.
### :returns: The resulting `IntersectEmittable[T, TSource/Iter]` value.
@readonly
routine IntersectIterable[T, TSource, TOther].iter() -> IntersectEmittable[T, TSource/Iter]
needs T obeys Hashable, Comparable
    danger
        var other_set = me.you.as_entity().Set()
        return IntersectEmittable[T, TSource/Iter](
            source: me.source.as_entity().iter(),
            you: steal other_set,
        )

### Returns the next source element that is also present in the membership set.
### Source elements not found in the set are consumed and discarded.
### :returns: The resulting `T` value.
routine IntersectEmittable[T, TSourceIter].emit!() -> TSourceIter/Item
needs T obeys Hashable, Comparable
    danger
        loop
            var item = me.source.emit()
            if me.you.contains(item)
                return item

### Returns a lazy adapter that keeps only elements also present in `other`.
### :param you: The iterable that defines the membership set.
### :returns: The resulting `IntersectIterable[T, Me, TOther]` value.
@readonly
routine Iterable[T].intersect[TOther](you: Accessing[TOther]) -> IntersectIterable[T, Me, TOther]
needs TOther obeys Iterable[T]
needs T obeys Hashable, Comparable
    danger
        return IntersectIterable[T, Me, TOther](source: me.hijack(), you: you.hijack())

### Materializes `other` into a set and returns an iterator that removes matching elements.
### :returns: The resulting `ExcludeEmittable[T, TSource/Iter]` value.
@readonly
routine ExcludeIterable[T, TSource, TOther].iter() -> ExcludeEmittable[T, TSource/Iter]
needs T obeys Hashable, Comparable
    danger
        var other_set = me.you.as_entity().Set()
        return ExcludeEmittable[T, TSource/Iter](
            source: me.source.as_entity().iter(),
            you: steal other_set,
        )

### Returns the next source element that is not present in the exclusion set.
### Source elements found in the set are consumed and discarded.
### :returns: The resulting `T` value.
routine ExcludeEmittable[T, TSourceIter].emit!() -> TSourceIter/Item
needs T obeys Hashable, Comparable
    danger
        loop
            var item = me.source.emit()
            if not me.you.contains(item)
                return item

### Returns a lazy adapter that suppresses all elements also found in `other`.
### :param you: The iterable that defines the exclusion set.
### :returns: The resulting `ExcludeIterable[T, Me, TOther]` value.
@readonly
routine Iterable[T].exclude[TOther](you: Accessing[TOther]) -> ExcludeIterable[T, Me, TOther]
needs TOther obeys Iterable[T]
needs T obeys Hashable, Comparable
    danger
        return ExcludeIterable[T, Me, TOther](source: me.hijack(), you: you.hijack())

### Returns a lazy adapter that yields all distinct elements from this iterable followed by `other`.
### Duplicate values across both sources are suppressed.
### :param you: The iterable to concatenate before deduplication.
### :returns: The resulting `DistinctIterable[T, ExtendIterable[T, Me, TOther]]` value.
@readonly
routine Iterable[T].union[TOther](you: Accessing[TOther]) -> DistinctIterable[T, ExtendIterable[T, Me, TOther]]
needs TOther obeys Iterable[T]
needs T obeys Hashable, Comparable
    return me.extend(you).distinct()
