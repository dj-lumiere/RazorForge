module IterTools

### Represents a lazy filtering adapter over a source emittable.
### The adapter can keep either matching or non-matching items depending on `inverted`.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSource: The concrete source emittable type (borrowed; enables build-time dispatch).
entity WhereEmittable[T, TSource]
relates WhereEmitter[T, TSource/Emitter] as Emitter
obeys Emittable[T]
needs TSource obeys Emittable[T]
    ### Stores the source emittable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### Stores the predicate used to test each source value.
    secret predicate: failable Callable[(T,), Bool]
    ### Stores whether the predicate result should be inverted.
    secret inverted: Bool

### Iterates over a source sequence while yielding only values that satisfy the effective filter.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSourceEmitter: The concrete source emitter type (owned).
entity WhereEmitter[T, TSourceEmitter]
obeys Emitter[T]
needs TSourceEmitter obeys Emitter[T]
    ### Stores the underlying source emitter (owned; destroyed with the adapter).
    secret source: TSourceEmitter
    ### Stores the predicate used for filtering.
    secret predicate: failable Callable[(T,), Bool]
    ### Stores whether matches should be inverted.
    secret inverted: Bool

### Returns the stateful emitter that applies the filter lazily.
### Source values are examined only as the caller requests more output values.
### :returns: The resulting `WhereEmitter[T, TSource/Emitter]` value.
@readonly
routine WhereEmittable[T, TSource].emitter() -> WhereEmitter[T, TSource/Emitter]
    danger
        return WhereEmitter[T, TSource/Emitter](
            source: me.source.referent().emitter(),
            predicate: me.predicate,
            inverted: me.inverted,
        )

### Returns the next value that satisfies the effective filter condition.
### Source values are consumed and discarded until one passes the filter.
### :returns: The resulting `T` value.
failable routine WhereEmitter[T, TSourceEmitter].emit() -> TSourceEmitter/Item
    danger
        loop
            var item = me.source.emit()
            var matches = me.predicate(item)
            if me.inverted
                matches = not matches
            if matches
                return item

### Returns a lazy adapter that keeps only values for which `predicate` returns
### `true`.
### :param predicate: The filter predicate.
### :returns: The resulting `WhereEmittable[T, Me]` value.
@readonly
routine Emittable[T].where(predicate: failable Callable[(T,), Bool]) -> WhereEmittable[T, Me]
    danger
        return WhereEmittable[T, Me](source: me.hijack(), predicate: predicate, inverted: false)

### Returns a lazy adapter that keeps only values for which `predicate` returns
### `false`.
### :param predicate: The filter predicate.
### :returns: The resulting `WhereEmittable[T, Me]` value.
@readonly
routine Emittable[T].where_not(predicate: failable Callable[(T,), Bool]) -> WhereEmittable[T, Me]
    danger
        return WhereEmittable[T, Me](source: me.hijack(), predicate: predicate, inverted: true)
