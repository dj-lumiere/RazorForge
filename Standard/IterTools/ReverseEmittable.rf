module IterTools

### Represents a lazy adapter that yields source elements in reverse order.
### The source is fully materialized when iteration begins.
### :typeparam T: The element type of the source sequence.
### :typeparam TSource: The concrete source emittable type (borrowed; enables build-time dispatch).
entity ReverseEmittable[T, TSource]
relates ReverseEmitter[T] as Emitter
obeys Emittable[T]
needs TSource obeys Emittable[T]
    ### Stores the source emittable to materialize and reverse (borrowed, not owned).
    secret source: Hijacked[TSource]

### Iterates over a pre-materialized buffer from back to front.
### The buffer holds the source's values as read, not copies it owns: an adapter is used only in the statement
### that makes it, so the source outlives it, and a source cannot change while it is iterated. The buffer frees
### its storage and leaves the values to the source.
### :typeparam T: The element type of the reversed sequence.
entity ReverseEmitter[T]
obeys Emitter[T]
    ### Stores the source's values in source order, read through, not owned.
    secret buffer: List[T]
    ### Stores the next read position, counting down toward zero.
    secret index: U64

### Materializes the source into a buffer and returns an emitter that walks it backwards.
### :returns: The resulting `ReverseEmitter[T]` value.
@readonly
routine ReverseEmittable[T, TSource].emitter() -> ReverseEmitter[T]
    danger
        var buffer = me.source.as_entity().to[List]()
        var n = buffer.count()
        return ReverseEmitter[T](buffer: buffer, index: n)

### Returns the next element counting backward through the buffer.
### Signals absence once all elements have been yielded.
### :returns: The resulting `T` value.
failable routine ReverseEmitter[T].emit() -> T
    if me.index == 0
        throw AbsentValueError()
    me.index = me.index - 1
    return me.buffer.get_raw(index: me.index)

### Frees the buffer's storage without tearing down the values in it, which belong to the source.
@override
routine ReverseEmitter[T].destruct()
    me.buffer.clear()
    me.buffer.destruct()
    return

### Returns a lazy adapter that yields this emittable's elements in reverse order.
### The source is fully consumed when the returned adapter is first iterated.
### :returns: The resulting `ReverseEmittable[T, Me]` value.
@readonly
routine Emittable[T].reverse() -> ReverseEmittable[T, Me]
    danger
        return ReverseEmittable[T, Me](source: me.hijack())
