module Core

### Represents a lazy adapter that pairs each produced element with an index.
### The emitted index starts at `0` by default or at the caller-supplied offset.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSource: The concrete source iterable type (borrowed; enables build-time dispatch).
entity EnumerateIterable[T, TSource]
relates EnumerateEmittable[T, TSource/Iter] as Iter
obeys Iterable[Tuple[U64, T]]
needs TSource obeys Iterable[T]
    ### Stores the source iterable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### Stores the first index value to assign.
    secret start_index: U64

### Iterates over a source sequence, pairing each element with an incrementing index.
### :typeparam T: The element type of the source sequence.
### :typeparam TSourceIter: The concrete source iterator type (owned).
entity EnumerateEmittable[T, TSourceIter]
obeys Emittable[Tuple[U64, T]]
needs TSourceIter obeys Emittable[T]
    ### Stores the iterator over the source sequence (owned; destroyed with the adapter).
    secret source: TSourceIter
    ### Stores the next index value to assign.
    secret index: U64

### Returns the stateful iterator that produces indexed tuples lazily.
### :returns: The resulting `EnumerateEmittable[T, TSource/Iter]` value.
@readonly
routine EnumerateIterable[T, TSource].iter() -> EnumerateEmittable[T, TSource/Iter]
    danger
        return EnumerateEmittable[T, TSource/Iter](
            source: me.source.as_entity().iter(),
            index: me.start_index,
        )

### Returns the next value from this iterator.
### The returned tuple contains the current index followed by the source item.
### :returns: The resulting `Tuple[U64, T]` value.
routine EnumerateEmittable[T, TSourceIter].emit!() -> Tuple[U64, T]
    danger
        var item = me.source.emit()
        var index = me.index
        me.index = me.index + 1u64
        return (index, item)

### Returns a lazy enumerating adapter over this iterable.
### The first yielded index is `0`.
### :returns: The resulting `EnumerateIterable[T, Me]` value.
@readonly
routine Iterable[T].enumerate() -> EnumerateIterable[T, Me]
    danger
        return EnumerateIterable[T, Me](source: me.hijack(), start_index: 0u64)

### Returns a lazy enumerating adapter over this iterable.
### The first yielded index is `start`.
### :param start: The inclusive starting position.
### :returns: The resulting `EnumerateIterable[T, Me]` value.
@readonly
routine Iterable[T].enumerate(start: U64) -> EnumerateIterable[T, Me]
    danger
        return EnumerateIterable[T, Me](source: me.hijack(), start_index: start)
