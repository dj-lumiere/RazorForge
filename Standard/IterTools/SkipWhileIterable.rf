module IterTools

### Represents a lazy adapter that discards leading values while a predicate stays true.
### Once the predicate fails, all remaining source values are yielded unchanged.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSource: The concrete source iterable type (borrowed; enables build-time dispatch).
entity SkipWhileIterable[T, TSource]
relates SkipWhileEmittable[T, TSource/Iter] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
    ### Stores the source iterable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### Stores the predicate used to decide whether a value should be skipped.
    secret predicate: Routine[(T,), Bool]

### Iterates over a source sequence after dropping its leading predicate-matching prefix.
### :typeparam T: The element type produced by the source sequence.
### :typeparam TSourceIter: The concrete source iterator type (owned).
entity SkipWhileEmittable[T, TSourceIter]
obeys Emittable[T]
needs TSourceIter obeys Emittable[T]
    ### Stores the underlying source iterator (owned; destroyed with the adapter).
    secret source: TSourceIter
    ### Stores the predicate used while skipping.
    secret predicate: Routine[(T,), Bool]
    ### Stores whether the emitter is still discarding leading values.
    secret skipping: Bool

### Returns the stateful iterator that skips leading values while the predicate succeeds.
### The returned emitter tracks whether it is still in the skipping phase.
### :returns: The resulting `SkipWhileEmittable[T, TSource/Iter]` value.
@readonly
routine SkipWhileIterable[T, TSource].iter() -> SkipWhileEmittable[T, TSource/Iter]
    danger
        return SkipWhileEmittable[T, TSource/Iter](
            source: me.source.as_entity().iter(),
            predicate: me.predicate,
            skipping: true,
        )

### Returns the next value after any remaining skippable prefix has been consumed.
### After the first predicate failure, later values are yielded without rechecking earlier skip state.
### :returns: The resulting `T` value.
routine SkipWhileEmittable[T, TSourceIter].emit!() -> TSourceIter/Item
    danger
        if me.skipping
            loop
                var item = me.source.emit()
                if not me.predicate(item)
                    me.skipping = false
                    return item
        return me.source.emit()

### Returns a lazy adapter that skips values while `predicate` returns `true`.
### :param predicate: The predicate that controls the initial skipping phase.
### :returns: The resulting `SkipWhileIterable[T, Me]` value.
@readonly
routine Iterable[T].skip_while(predicate: Routine[(T,), Bool]) -> SkipWhileIterable[T, Me]
    danger
        return SkipWhileIterable[T, Me](source: me.hijack(), predicate: predicate)
