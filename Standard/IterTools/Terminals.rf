module IterTools

### Materializes this emittable into a `List[T]`.
### Values are consumed eagerly in iteration order.
### :returns: The resulting `List[T]` value.
@readonly
routine Emittable[T].to[List[T]]() -> List[T]
    var result = List[T]()
    each item in me
        result.add_last(item)
    return result

### Materializes this emittable into a `Set[T]`.
### Duplicate values collapse according to the set's equality and ordering semantics.
### :returns: The resulting `Set[T]` value.
@readonly
routine Emittable[T].to[Set[T]]() -> Set[T]
needs T obeys Hashable, Comparable
    var result = Set[T]()
    each item in me
        result.add(item)
    return result

### Collects `(key, value)` pairs into a `Dict`, in order: a later pair whose key is there already replaces its value.
### :returns: The dict.
@readonly
routine Emittable[Tuple[TKey, TValue]].to[Dict[TKey, TValue]]() -> Dict[TKey, TValue]
needs TKey obeys Hashable, Equatable
needs RecordType TKey, RecordType TValue
    var result = Dict[TKey, TValue]()
    each item in me
        var pair: Tuple[TKey, TValue] = item
        result[pair.item0] = pair.item1
    return result

### Collects the values into an `Array[T, N]`, in order. The bracket names the size: `xs.to[Array[S64, 3]]()`.
### :returns: The array.
### :throws: {ElementCountMismatchError} if there are fewer or more than `N` values.
@readonly
failable routine Emittable[T].to[Array[T, N]]() -> Array[T, N]
needs U64 N
needs RecordType T
    var result = Array[T, N]()
    var filled: U64 = 0
    each item in me
        if filled >= N
            throw ElementCountMismatchError(expected: N, found: N + 1)
        result[filled] = item
        filled = filled + 1
    if filled < N
        throw ElementCountMismatchError(expected: N, found: filled)
    return result

### Counts how many values this emittable produces.
### This consumes the emittable from start to finish.
### :returns: The resulting `U64` value.
@readonly
routine Emittable[T].get_count() -> U64
    var n: U64 = 0
    each _ in me
        n = n + 1
    return n

### Returns the first value produced by this emittable.
### This is a convenience terminal operation over the first emitter element.
### :returns: The resulting `T` value.
@readonly
failable routine Emittable[T].first() -> T
    var walk = me.emitter()
    return walk.emit()

### Returns the last value produced by this emittable.
### The emittable is consumed fully in order to find the final element.
### :returns: The resulting `T` value.
@readonly
failable routine Emittable[T].last() -> T
    var walk = me.emitter()
    var latest: T = walk.emit()
    loop
        var item = try walk.emit()
        when item
            is None => return latest
            else as value => latest = value

### Returns `true` when any produced value satisfies `predicate`.
### Iteration stops as soon as a matching value is found.
### :param predicate: The predicate to test against each item.
### :returns: The resulting `Bool` value.
@readonly
routine Emittable[T].any(predicate: Callable[(T,), Bool]) -> Bool
    each item in me
        if predicate(item)
            return true
    return false

### Returns `true` when every produced value satisfies `predicate`.
### Iteration stops as soon as a failing value is found.
### :param predicate: The predicate to test against each item.
### :returns: The resulting `Bool` value.
@readonly
routine Emittable[T].all(predicate: Callable[(T,), Bool]) -> Bool
    each item in me
        if not predicate(item)
            return false
    return true

### Folds this emittable into a single result value.
### The combiner receives the current accumulator and the next item in iteration
### order.
### :param start: The initial accumulator value.
### :param combiner: The routine used to produce the next accumulator value.
### :returns: The resulting `TState` value.
@readonly
routine Emittable[T].accumulate[TState](start: TState, combiner: Callable[(TState, T), TState]) -> TState
    var result = steal start
    each item in me
        result = combiner(result, item)
    return result

### Returns the sum of all values in this emittable.
### The first element is used as the initial accumulator; subsequent elements are added to it.
### :returns: The resulting `T` value.
@readonly
failable routine Emittable[T].sum() -> T
needs T obeys Addable
    var walk = me.emitter()
    var result: T = walk.emit()
    loop
        var item = try walk.emit()
        when item
            is None => return result
            else as value => result = result + value

### Returns the smallest value in this emittable.
### :returns: The resulting `T` value.
@readonly
failable routine Emittable[T].min() -> T
needs T obeys Comparable
    var walk = me.emitter()
    var result: T = walk.emit()
    loop
        var item = try walk.emit()
        when item
            is None => return result
            else as value =>
                if value < result
                    result = value

### Returns the largest value in this emittable.
### :returns: The resulting `T` value.
@readonly
failable routine Emittable[T].max() -> T
needs T obeys Comparable
    var walk = me.emitter()
    var result: T = walk.emit()
    loop
        var item = try walk.emit()
        when item
            is None => return result
            else as value =>
                if value > result
                    result = value

### Returns the element for which `selector` returns the smallest key.
### :param selector: The routine that extracts a comparable key from each element.
### :returns: The resulting `T` value.
@readonly
failable routine Emittable[T].min_by[TKey](selector: Callable[(T,), TKey]) -> T
needs TKey obeys Comparable
    var walk = me.emitter()
    var best: T = walk.emit()
    var best_key = selector(best)
    loop
        var item = try walk.emit()
        when item
            is None => return best
            else as value =>
                var k = selector(value)
                if k < best_key
                    best = value
                    best_key = steal k

### Returns the element for which `selector` returns the largest key.
### :param selector: The routine that extracts a comparable key from each element.
### :returns: The resulting `T` value.
@readonly
failable routine Emittable[T].max_by[TKey](selector: Callable[(T,), TKey]) -> T
needs TKey obeys Comparable
    var walk = me.emitter()
    var best: T = walk.emit()
    var best_key = selector(best)
    loop
        var item = try walk.emit()
        when item
            is None => return best
            else as value =>
                var k = selector(value)
                if k > best_key
                    best = value
                    best_key = steal k

### Counts how many values satisfy `predicate`.
### :param predicate: The test applied to each element.
### :returns: The resulting `U64` value.
@readonly
routine Emittable[T].get_count(predicate: Callable[(T,), Bool]) -> U64
    var n: U64 = 0
    each item in me
        if predicate(item)
            n = n + 1
    return n

### Returns the first value produced by this emittable, or `default` when the emittable is empty.
### :param default: The value to return when the emittable yields nothing.
### :returns: The resulting `T` value.
@readonly
routine Emittable[T].first_or_default(default: T) -> T
    var walk = me.emitter()
    var result = try walk.emit()
    when result
        is None => return default
        else as item => return item

### Returns the last value produced by this emittable, or `default` when the emittable is empty.
### :param default: The value to return when the emittable yields nothing.
### :returns: The resulting `T` value.
@readonly
routine Emittable[T].last_or_default(default: T) -> T
    var latest = steal default
    each item in me
        latest = item
    return latest

### Joins the produced `Text` values into a single `Text`, inserting `separator`
### between successive parts. The separator is not added before the first or
### after the last element.
### :param separator: The text inserted between successive parts.
### :returns: The resulting `Text` value.
@readonly
routine Emittable[Text].join(separator: Text) -> Text
    var result = List[Char]()
    var first = true
    each part in me
        if not first
            each i in 0 til separator.count()
                result.add_last(separator[i])
        each i in 0 til part.count()
            result.add_last(part[i])
        first = false
    return Text(from_list: result)
