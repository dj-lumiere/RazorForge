module IterTools

### Represents a lazy adapter that suppresses duplicate values from a source emittable.
### Two values are considered equal when they produce the same hash and compare as equal.
### :typeparam T: The element type of the source sequence.
### :typeparam TSource: The concrete source emittable type (borrowed; enables build-time dispatch).
entity DistinctEmittable[T, TSource]
relates DistinctEmitter[T, TSource/Emitter] as Emitter
obeys Emittable[T]
needs TSource obeys Emittable[T]
    ### Stores the source emittable (borrowed, not owned).
    secret source: Hijacked[TSource]

### Iterates over a source sequence while suppressing values already produced.
### :typeparam T: The element type of the source sequence.
### :typeparam TSourceEmitter: The concrete source emitter type (owned).
entity DistinctEmitter[T, TSourceEmitter]
obeys Emitter[T]
needs TSourceEmitter obeys Emitter[T]
    ### Stores the underlying source emitter (owned; destroyed with the adapter).
    secret source: TSourceEmitter
    ### Stores the set of values already yielded.
    secret seen: Set[T]

### Represents a lazy adapter that suppresses elements whose key has already been seen.
### Two elements are considered duplicates when their computed keys produce the same hash
### and compare as equal.
### :typeparam T: The source element type.
### :typeparam TKey: The key type used for equality comparison.
### :typeparam TSource: The concrete source emittable type (borrowed).
entity DistinctByEmittable[T, TKey, TSource]
relates DistinctByEmitter[T, TKey, TSource/Emitter] as Emitter
obeys Emittable[T]
needs TSource obeys Emittable[T]
    ### Stores the source emittable (borrowed, not owned).
    secret source: Hijacked[TSource]
    ### Stores the key-selector routine.
    secret key: Callable[(T,), TKey]

### Iterates over a source sequence while suppressing elements whose key has already been produced.
### :typeparam T: The source element type.
### :typeparam TKey: The key type used for equality comparison.
### :typeparam TSourceEmitter: The concrete source emitter type (owned).
entity DistinctByEmitter[T, TKey, TSourceEmitter]
obeys Emitter[T]
needs TSourceEmitter obeys Emitter[T]
    ### Stores the underlying source emitter (owned; destroyed with the adapter).
    secret source: TSourceEmitter
    ### Stores the key-selector routine.
    secret key: Callable[(T,), TKey]
    ### Stores the set of keys already seen.
    secret seen: Set[TKey]

### Returns the stateful emitter that tracks already-seen values across calls.
### :returns: The resulting `DistinctEmitter[T, TSource/Emitter]` value.
@readonly
routine DistinctEmittable[T, TSource].emitter() -> DistinctEmitter[T, TSource/Emitter]
needs T obeys Hashable, Comparable
    var seen = Set[T]()
    danger
        return DistinctEmitter[T, TSource/Emitter](source: me.source.referent().emitter(), seen: seen)

### Returns the next value not yet yielded by this emitter.
### Source values that have already been seen are discarded until a new one is found.
### :returns: The resulting `T` value.
@reshaping
failable routine DistinctEmitter[T, TSourceEmitter].emit() -> TSourceEmitter/Item
needs T obeys Hashable, Comparable
    danger
        loop
            var item = me.source.emit()
            if not me.seen.has(item)
                drop me.seen.add(item)
                return item

### Returns a lazy adapter that suppresses duplicate values.
### :returns: The resulting `DistinctEmittable[T, Me]` value.
@readonly
routine Emittable[T].distinct() -> DistinctEmittable[T, Me]
needs T obeys Hashable, Comparable
    danger
        return DistinctEmittable[T, Me](source: me.hijack())

### Returns the stateful emitter that tracks already-seen keys across calls.
### :returns: The resulting `DistinctByEmitter[T, TKey, TSource/Emitter]` value.
@readonly
routine DistinctByEmittable[T, TKey, TSource].emitter() -> DistinctByEmitter[T, TKey, TSource/Emitter]
needs TKey obeys Hashable, Comparable
    var seen = Set[TKey]()
    danger
        return DistinctByEmitter[T, TKey, TSource/Emitter](
            source: me.source.referent().emitter(),
            key: me.key,
            seen: seen,
        )

### Returns the next element whose key has not yet been yielded.
### Elements are consumed and discarded until one with a fresh key is found.
### :returns: The resulting `T` value.
@reshaping
failable routine DistinctByEmitter[T, TKey, TSourceEmitter].emit() -> TSourceEmitter/Item
needs TKey obeys Hashable, Comparable
    danger
        loop
            var item = me.source.emit()
            var k = me.key(item)
            if not me.seen.has(k)
                drop me.seen.add(k)
                return item

### Returns a lazy adapter that suppresses elements whose computed key has already appeared.
### :param key: The routine that extracts the comparison key from each element.
### :returns: The resulting `DistinctByEmittable[T, TKey, Me]` value.
@readonly
routine Emittable[T].distinct_by[TKey](key: Callable[(T,), TKey]) -> DistinctByEmittable[T, TKey, Me]
needs TKey obeys Hashable, Comparable
    danger
        return DistinctByEmittable[T, TKey, Me](source: me.hijack(), key: key)
