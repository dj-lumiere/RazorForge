module IterTools

### Represents a lazy adapter that yields source elements in reverse order.
### The source is fully materialized when iteration begins.
### :typeparam T: The element type of the source sequence.
### :typeparam TSource: The concrete source iterable type (borrowed; enables build-time dispatch).
entity ReverseIterable[T, TSource]
relates ReverseEmittable[T] as Iter
obeys Iterable[T]
needs TSource obeys Iterable[T]
    ### Stores the source iterable to materialize and reverse (borrowed, not owned).
    secret source: Hijacked[TSource]

### Iterates over a pre-materialized buffer from back to front.
### The buffer holds the source's values as read, not copies it owns: an adapter is used only in the statement
### that makes it, so the source outlives it, and a source cannot change while it is iterated. The buffer frees
### its storage and leaves the values to the source.
### :typeparam T: The element type of the reversed sequence.
entity ReverseEmittable[T]
obeys Emittable[T]
    ### Stores the source's values in source order, read through, not owned.
    secret buffer: List[T]
    ### Stores the next read position, counting down toward zero.
    secret index: U64

### Materializes the source into a buffer and returns an iterator that walks it backwards.
### :returns: The resulting `ReverseEmittable[T]` value.
@readonly
routine ReverseIterable[T, TSource].iter() -> ReverseEmittable[T]
    danger
        var buffer = me.source.as_entity().List()
        var n = buffer.count()
        return ReverseEmittable[T](buffer: steal buffer, index: n)

### Returns the next element counting backward through the buffer.
### Signals absence once all elements have been yielded.
### :returns: The resulting `T` value.
routine ReverseEmittable[T].emit!() -> T
    if me.index == 0u64
        absent
    me.index = me.index - 1u64
    return me.buffer.get_raw(index: me.index)

### Frees the buffer's storage without tearing down the values in it, which belong to the source.
@override
dangerous routine ReverseEmittable[T].destroy()
    me.buffer.clear()
    me.buffer.destroy()
    me.hijack().invalidate()
    return

### Returns a lazy adapter that yields this iterable's elements in reverse order.
### The source is fully consumed when the returned adapter is first iterated.
### :returns: The resulting `ReverseIterable[T, Me]` value.
@readonly
routine Iterable[T].reverse() -> ReverseIterable[T, Me]
    danger
        return ReverseIterable[T, Me](source: me.hijack())
