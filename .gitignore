# Scratch scripts, but keep the packaging machinery and the tracked tools (must be /scripts/* not
# /scripts/ — git cannot re-include children of an excluded directory)
/scripts/*
!/scripts/package.ps1
!/scripts/package.sh
!/scripts/package-assets/
