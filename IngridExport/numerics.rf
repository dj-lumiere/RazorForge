# The arbitrary-precision Integer and Real bodies Ingrid exports: `RazorForge export-ingrid` writes these
# routines, with the engines they call (Numeric/IntegerEngine.rf and Numeric/RealEngine.rf), to
# Ingrid/tessera/generated/numerics.tess. {Integer} and {Real} call them through the C:: declarations in
# Core/NativeDeclarations.rf.
#
# The engines are `secret` to module Numerics, so this file is in that module too: it reaches them without
# making them visible to programs. It is not part of the standard library, only the export reads it.
#
# A value crosses the C ABI as its parts: an Integer as (neg, len, tab), a Real as (sign, expn, len, tab), a
# sign as a U64 (1 when negative), `tab` the little-endian limbs. RazorForge allocates and frees every buffer:
# the inputs, the result buffer `out` (`out_cap` limbs, or characters for text), and `scratch` (`scratch_cap`
# limbs), the room the engine takes its temporaries from (Ingrid/tessera/scratch.tess). The engine allocates
# nothing. Each routine that takes scratch has a `_scratch_size` routine that says how much to hand over.
#
# A result comes back in IngridWords. `w0` is the status: 0 done, 1 the scratch was too small (`w1` is the
# room the call needs at least: retry with more), 2 the result buffer was too small (`w1` is the limbs or
# characters it needs: retry with that). When done, an Integer is `w1` limbs long and negative when `w2` is 1,
# and a Real is `w1` limbs long with sign `w2` and exponent `w3` (an S64's bits; zero has no limbs and the
# zero exponent). Failures that throw in RazorForge (a division by zero, an overflow to infinity, a domain
# error) are RazorForge's to check: a Real routine returns the infinity or NaN the engine computes.
module Numerics

### The exports: each common routine below is the C symbol `ingrid_<its name>`.
record Ingrid
    pass

# ============================================================================
# The call protocol
# ============================================================================

# An engine integer from its parts as they cross the C ABI. A zero is never negative, whatever sign word a
# caller passes with no limbs: the engine assumes a zero is positive.
secret routine abi_intv(neg: U64, len: U64, tab: Hijacked[U64]) -> IntV
    return IntV(neg: neg != 0u64 and len != 0u64, len: len, tab: tab)

# An engine real from its parts as they cross the C ABI.
secret routine abi_bft(sign: U64, expn: S64, len: U64, tab: Hijacked[U64]) -> BfT
    return BfT(sign: sign != 0u64, expn: expn, len: len, tab: tab)

# The words of a status other than done: 1 (scratch) or 2 (result buffer), with the room needed.
secret routine words_need(status: U64, need: U64) -> IngridWords
    return IngridWords(w0: status, w1: need, w2: 0u64, w3: 0u64)

# 1 for true, 0 for false.
secret routine bit_of(value: Bool) -> U64
    return if value then 1u64 else 0u64

# Copies `len` limbs from `src` to `dst` (the same buffer is fine).
secret dangerous routine copy_out(dst: Hijacked[U64], src: Hijacked[U64], len: U64)
    var i = 0u64
    while i < len
        set_limb(tab: dst, i: i, value: limb(tab: src, i: i))
        i = i +% 1u64
    return

# Closes the call's scratch arena and hands back integer result `r` in `out`.
secret dangerous routine integer_done(r: IntV, out: Hijacked[U64], out_cap: U64) -> IngridWords
    var need = C::ingrid_scratch_close()
    if need != 0u64
        return words_need(status: 1u64, need: need)
    if r.len > out_cap
        return words_need(status: 2u64, need: r.len)
    copy_out(dst: out, src: r.tab, len: r.len)
    return IngridWords(w0: 0u64, w1: r.len, w2: bit_of(value: r.neg), w3: 0u64)

# Closes the call's scratch arena and hands back real result `r` in `out`.
secret dangerous routine real_done(r: BfT, out: Hijacked[U64], out_cap: U64) -> IngridWords
    var need = C::ingrid_scratch_close()
    if need != 0u64
        return words_need(status: 1u64, need: need)
    if r.len > out_cap
        return words_need(status: 2u64, need: r.len)
    copy_out(dst: out, src: r.tab, len: r.len)
    return IngridWords(
        w0: 0u64,
        w1: r.len,
        w2: bit_of(value: r.sign),
        w3: LLVM::reinterpret_bits[S64, U64](r.expn),
    )

# ============================================================================
# Integer
# ============================================================================

### a + b into `out` (at least max(a_len, b_len) + 1 limbs). Takes no scratch.
common routine Ingrid.integer_add(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
) -> IngridWords
    danger
        var a = abi_intv(neg: a_neg, len: a_len, tab: a_tab)
        var b = abi_intv(neg: b_neg, len: b_len, tab: b_tab)
        var cap = bigint_add_capacity(a: a, b: b)
        if out_cap < cap
            return words_need(status: 2u64, need: cap)
        C::ingrid_scratch_open(base: out, limbs: 0u64)
        return integer_done(r: bigint_add_into(a: a, b: b, r: out), out: out, out_cap: out_cap)

### a * b.
common routine Ingrid.integer_mul(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var r = bigint_mul(
            a: abi_intv(neg: a_neg, len: a_len, tab: a_tab),
            b: abi_intv(neg: b_neg, len: b_len, tab: b_tab),
        )
        return integer_done(r: r, out: out, out_cap: out_cap)

### The scratch `integer_mul` takes for a_len x b_len limbs.
common routine Ingrid.integer_mul_scratch_size(a_len: U64, b_len: U64) -> U64
    return bigint_mul_scratch(a_len: a_len, b_len: b_len)

### The Euclidean quotient and remainder of a / b (b nonzero): the quotient into `q_out`, the remainder (never
### negative) into `r_out`. Done: `w1` the quotient's length, `w2` its sign, `w3` the remainder's length. Status
### 2: `w1` and `w2` the quotient's and the remainder's lengths needed.
common routine Ingrid.integer_divmod(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    q_out: Hijacked[U64],
    q_cap: U64,
    r_out: Hijacked[U64],
    r_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var qr = bigint_divmod(
            a: abi_intv(neg: a_neg, len: a_len, tab: a_tab),
            b: abi_intv(neg: b_neg, len: b_len, tab: b_tab),
        )
        var q = qr.item0
        var r = qr.item1
        var need = C::ingrid_scratch_close()
        if need != 0u64
            return words_need(status: 1u64, need: need)
        if q.len > q_cap or r.len > r_cap
            return IngridWords(w0: 2u64, w1: q.len, w2: r.len, w3: 0u64)
        copy_out(dst: q_out, src: q.tab, len: q.len)
        copy_out(dst: r_out, src: r.tab, len: r.len)
        return IngridWords(w0: 0u64, w1: q.len, w2: bit_of(value: q.neg), w3: r.len)

### The scratch `integer_divmod` takes dividing a_len limbs by b_len.
common routine Ingrid.integer_divmod_scratch_size(a_len: U64, b_len: U64) -> U64
    return bigint_divmod_scratch(a_len: a_len, b_len: b_len)

### a * 2^bits into `out` (at least a_len + bits / 64 + 1 limbs). Takes no scratch.
common routine Ingrid.integer_shift_left(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    bits: U64,
    out: Hijacked[U64],
    out_cap: U64,
) -> IngridWords
    danger
        var a = abi_intv(neg: a_neg, len: a_len, tab: a_tab)
        var cap = bigint_shl_capacity(a: a, bits: bits)
        if out_cap < cap
            return words_need(status: 2u64, need: cap)
        C::ingrid_scratch_open(base: out, limbs: 0u64)
        return integer_done(r: bigint_shl_into(a: a, bits: bits, r: out), out: out, out_cap: out_cap)

### floor(a / 2^bits), the arithmetic shift of the two's-complement form, into `out` (at least
### a_len - bits / 64 + 1 limbs, and 1). Takes no scratch.
common routine Ingrid.integer_shift_right(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    bits: U64,
    out: Hijacked[U64],
    out_cap: U64,
) -> IngridWords
    danger
        var a = abi_intv(neg: a_neg, len: a_len, tab: a_tab)
        var cap = bigint_shr_capacity(a: a, bits: bits)
        if out_cap < cap
            return words_need(status: 2u64, need: cap)
        C::ingrid_scratch_open(base: out, limbs: 0u64)
        return integer_done(r: bigint_shr_into(a: a, bits: bits, r: out), out: out, out_cap: out_cap)

# One two's-complement bitwise operation (0 AND, 1 OR, 2 XOR) into `out`.
secret dangerous routine integer_bitop(a: IntV, b: IntV, op: U32, out: Hijacked[U64], out_cap: U64) -> IngridWords
    var cap = bigint_bitop_capacity(a: a, b: b)
    if out_cap < cap
        return words_need(status: 2u64, need: cap)
    C::ingrid_scratch_open(base: out, limbs: 0u64)
    return integer_done(r: bigint_bitop_into(a: a, b: b, op: op, r: out), out: out, out_cap: out_cap)

### a AND b over the two's-complement forms, into `out` (at least max(a_len, b_len) + 1 limbs). Takes no
### scratch.
common routine Ingrid.integer_and(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
) -> IngridWords
    danger
        return integer_bitop(
            a: abi_intv(neg: a_neg, len: a_len, tab: a_tab),
            b: abi_intv(neg: b_neg, len: b_len, tab: b_tab),
            op: 0u32,
            out: out,
            out_cap: out_cap,
        )

### a OR b over the two's-complement forms, like `integer_and`.
common routine Ingrid.integer_or(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
) -> IngridWords
    danger
        return integer_bitop(
            a: abi_intv(neg: a_neg, len: a_len, tab: a_tab),
            b: abi_intv(neg: b_neg, len: b_len, tab: b_tab),
            op: 1u32,
            out: out,
            out_cap: out_cap,
        )

### a XOR b over the two's-complement forms, like `integer_and`.
common routine Ingrid.integer_xor(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
) -> IngridWords
    danger
        return integer_bitop(
            a: abi_intv(neg: a_neg, len: a_len, tab: a_tab),
            b: abi_intv(neg: b_neg, len: b_len, tab: b_tab),
            op: 2u32,
            out: out,
            out_cap: out_cap,
        )

### a^e by square and multiply (0^0 = 1).
common routine Ingrid.integer_pow(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    e: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var r = bigint_pow(a: abi_intv(neg: a_neg, len: a_len, tab: a_tab), e: e)
        return integer_done(r: r, out: out, out_cap: out_cap)

### The scratch `integer_pow` takes for an a_len-limb base of `a_bits` significant bits and exponent `e`.
common routine Ingrid.integer_pow_scratch_size(a_len: U64, a_bits: U64, e: U64) -> U64
    return bigint_pow_scratch(a_len: a_len, bits: a_bits, e: e)

### floor(sqrt(a)) of a non-negative a.
common routine Ingrid.integer_sqrt(
    a_len: U64,
    a_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var r = bigint_isqrt(a: abi_intv(neg: 0u64, len: a_len, tab: a_tab))
        return integer_done(r: r, out: out, out_cap: out_cap)

### s = floor(sqrt(a)) into `s_out` and a - s*s into `r_out`, for a non-negative a. Done: `w1` the root's
### length, `w3` the remainder's. Status 2: `w1` and `w2` the root's and the remainder's lengths needed.
common routine Ingrid.integer_sqrtrem(
    a_len: U64,
    a_tab: Hijacked[U64],
    s_out: Hijacked[U64],
    s_cap: U64,
    r_out: Hijacked[U64],
    r_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var a = abi_intv(neg: 0u64, len: a_len, tab: a_tab)
        var s = bigint_isqrt(a: a)
        var r = bigint_sub(a: a, b: bigint_mul(a: s, b: s))
        var need = C::ingrid_scratch_close()
        if need != 0u64
            return words_need(status: 1u64, need: need)
        if s.len > s_cap or r.len > r_cap
            return IngridWords(w0: 2u64, w1: s.len, w2: r.len, w3: 0u64)
        copy_out(dst: s_out, src: s.tab, len: s.len)
        copy_out(dst: r_out, src: r.tab, len: r.len)
        return IngridWords(w0: 0u64, w1: s.len, w2: 0u64, w3: r.len)

### The scratch `integer_sqrt` and `integer_sqrtrem` take for an a_len-limb value.
common routine Ingrid.integer_sqrt_scratch_size(a_len: U64) -> U64
    return bigint_isqrt_scratch(a_len: a_len)

### gcd(|a|, |b|), with gcd(0, 0) = 0.
common routine Ingrid.integer_gcd(
    a_len: U64,
    a_tab: Hijacked[U64],
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var r = bigint_gcd(
            a: abi_intv(neg: 0u64, len: a_len, tab: a_tab),
            b: abi_intv(neg: 0u64, len: b_len, tab: b_tab),
        )
        return integer_done(r: r, out: out, out_cap: out_cap)

### lcm(|a|, |b|), 0 when either is 0.
common routine Ingrid.integer_lcm(
    a_len: U64,
    a_tab: Hijacked[U64],
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var r = bigint_lcm(
            a: abi_intv(neg: 0u64, len: a_len, tab: a_tab),
            b: abi_intv(neg: 0u64, len: b_len, tab: b_tab),
        )
        return integer_done(r: r, out: out, out_cap: out_cap)

### The scratch `integer_gcd` and `integer_lcm` take for a_len and b_len limbs.
common routine Ingrid.integer_gcd_scratch_size(a_len: U64, b_len: U64) -> U64
    return bigint_gcd_scratch(a_len: a_len, b_len: b_len) +% bigint_mul_scratch(a_len: a_len, b_len: b_len)

### -1, 0 or 1 as a is below, equal to or above b.
common routine Ingrid.integer_compare(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_neg: U64,
    b_len: U64,
    b_tab: Hijacked[U64],
) -> S64
    return bigint_cmp(
        a: abi_intv(neg: a_neg, len: a_len, tab: a_tab),
        b: abi_intv(neg: b_neg, len: b_len, tab: b_tab),
    )

### The most characters `integer_to_text` writes for an a_len-limb value in `radix` (2 to 64).
common routine Ingrid.integer_text_capacity(a_len: U64, radix: U64) -> U64
    return bigint_text_capacity(len: a_len, radix: radix)

### `a` in `radix` (2 to 64) into the characters at `out`: an optional '-' then the digits (0-9, A-Z, a-z,
### '+', '/'), "0" for zero. Takes a_len limbs of scratch. Done: `w1` the character count. Status 2: `w1` the
### characters needed (`integer_text_capacity`).
common routine Ingrid.integer_to_text(
    a_neg: U64,
    a_len: U64,
    a_tab: Hijacked[U64],
    radix: U64,
    out: Hijacked[Character],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        var cap = bigint_text_capacity(len: a_len, radix: radix)
        if out_cap < cap
            return words_need(status: 2u64, need: cap)
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var count = bigint_to_text_into(a: abi_intv(neg: a_neg, len: a_len, tab: a_tab), radix: radix, out: out)
        var need = C::ingrid_scratch_close()
        if need != 0u64
            return words_need(status: 1u64, need: need)
        return IngridWords(w0: 0u64, w1: count, w2: 0u64, w3: 0u64)

### Parses the `count` characters at `chars` in `radix` (2 to 64): an optional leading '-', then digits up to
### the first character outside the radix, where the text must end or hold a '\r' or '\n'. Empty digits read
### as 0. Takes count * 6 / 64 + 2 limbs of scratch and of result. Done: the value as for an Integer, and `w3`
### 1 when the text is an integer (0 when it isn't, the value then meaning nothing).
common routine Ingrid.integer_parse(
    chars: Hijacked[Character],
    count: U64,
    radix: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var parsed = bigint_parse(chars: chars, count: count, radix: radix)
        var w = integer_done(r: parsed.item0, out: out, out_cap: out_cap)
        if w.w0 != 0u64
            return w
        return IngridWords(w0: 0u64, w1: w.w1, w2: w.w2, w3: bit_of(value: parsed.item1))

# ============================================================================
# Real
# ============================================================================

### The scratch a Real routine takes for arguments of a_len and b_len limbs at `prec` bits (0 for the exact
### sum and product, whose own sizes are below). An estimate: a call that needs more says so.
common routine Ingrid.real_scratch_size(a_len: U64, b_len: U64, prec: U64) -> U64
    return real_scratch_estimate(a_len: a_len, b_len: b_len, prec: prec)

### The scratch and the result limbs the exact sum or difference of a (a_len limbs, exponent a_expn) and b
### takes.
common routine Ingrid.real_sum_size(a_len: U64, a_expn: S64, b_len: U64, b_expn: S64) -> U64
    if a_len == 0u64
        return b_len +% 2u64
    if b_len == 0u64
        return a_len +% 2u64
    var gap = if a_expn > b_expn then a_expn -% b_expn else b_expn -% a_expn
    var longer = if a_len > b_len then a_len else b_len
    return longer +% (LLVM::reinterpret_bits[S64, U64](gap) +% 63u64) // 64u64 +% 3u64

### The scratch the exact product of a_len x b_len limbs takes.
common routine Ingrid.real_mul_scratch_size(a_len: U64, b_len: U64) -> U64
    return a_len +% b_len +% limbs_mul_scratch(op1_size: a_len, op2_size: b_len)

### a + b, exact.
common routine Ingrid.real_add(
    a_sign: U64,
    a_expn: S64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_sign: U64,
    b_expn: S64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var r = bf_add(
            a: abi_bft(sign: a_sign, expn: a_expn, len: a_len, tab: a_tab),
            b: abi_bft(sign: b_sign, expn: b_expn, len: b_len, tab: b_tab),
            prec: bf_prec_inf(),
            fl: 0u32,
        )
        return real_done(r: r, out: out, out_cap: out_cap)

### a - b, exact.
common routine Ingrid.real_sub(
    a_sign: U64,
    a_expn: S64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_sign: U64,
    b_expn: S64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var r = bf_sub(
            a: abi_bft(sign: a_sign, expn: a_expn, len: a_len, tab: a_tab),
            b: abi_bft(sign: b_sign, expn: b_expn, len: b_len, tab: b_tab),
            prec: bf_prec_inf(),
            fl: 0u32,
        )
        return real_done(r: r, out: out, out_cap: out_cap)

### a * b, exact.
common routine Ingrid.real_mul(
    a_sign: U64,
    a_expn: S64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_sign: U64,
    b_expn: S64,
    b_len: U64,
    b_tab: Hijacked[U64],
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var r = bf_mul(
            a: abi_bft(sign: a_sign, expn: a_expn, len: a_len, tab: a_tab),
            b: abi_bft(sign: b_sign, expn: b_expn, len: b_len, tab: b_tab),
            prec: bf_prec_inf(),
            fl: 0u32,
        )
        return real_done(r: r, out: out, out_cap: out_cap)

# A two-argument Real function, by number: 0 a / b, 1 atan2(a, b), 2 hypot(a, b), 3 a ** b.
secret routine real_binary_body(op: U32, a: BfT, b: BfT, prec: U64) -> BfT
    if op == 0u32
        return bf_div(a: a, b: b, prec: prec, fl: 0u32)
    if op == 1u32
        return bf_atan2(y: a, x: b, prec: prec, fl: 0u32)
    if op == 2u32
        return real_hypot_body(x: a, y: b, prec: prec)
    return real_pow_body(x: a, y: b, prec: prec)

# One call of a two-argument Real function at `prec` bits.
secret dangerous routine real_binary(
    op: U32,
    a: BfT,
    b: BfT,
    prec: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
    return real_done(r: real_binary_body(op: op, a: a, b: b, prec: prec), out: out, out_cap: out_cap)

### a / b rounded to nearest at `prec` bits (b nonzero: a zero b gives the infinity or NaN).
common routine Ingrid.real_divide(
    a_sign: U64,
    a_expn: S64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_sign: U64,
    b_expn: S64,
    b_len: U64,
    b_tab: Hijacked[U64],
    prec: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        return real_binary(
            op: 0u32,
            a: abi_bft(sign: a_sign, expn: a_expn, len: a_len, tab: a_tab),
            b: abi_bft(sign: b_sign, expn: b_expn, len: b_len, tab: b_tab),
            prec: prec,
            out: out,
            out_cap: out_cap,
            scratch: scratch,
            scratch_cap: scratch_cap,
        )

### atan2(y, x) at `prec` bits, correctly rounded.
common routine Ingrid.real_atan2(
    y_sign: U64,
    y_expn: S64,
    y_len: U64,
    y_tab: Hijacked[U64],
    x_sign: U64,
    x_expn: S64,
    x_len: U64,
    x_tab: Hijacked[U64],
    prec: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        return real_binary(
            op: 1u32,
            a: abi_bft(sign: y_sign, expn: y_expn, len: y_len, tab: y_tab),
            b: abi_bft(sign: x_sign, expn: x_expn, len: x_len, tab: x_tab),
            prec: prec,
            out: out,
            out_cap: out_cap,
            scratch: scratch,
            scratch_cap: scratch_cap,
        )

### sqrt(x^2 + y^2) at `prec` bits (an overflow is an infinity).
common routine Ingrid.real_hypot(
    x_sign: U64,
    x_expn: S64,
    x_len: U64,
    x_tab: Hijacked[U64],
    y_sign: U64,
    y_expn: S64,
    y_len: U64,
    y_tab: Hijacked[U64],
    prec: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        return real_binary(
            op: 2u32,
            a: abi_bft(sign: x_sign, expn: x_expn, len: x_len, tab: x_tab),
            b: abi_bft(sign: y_sign, expn: y_expn, len: y_len, tab: y_tab),
            prec: prec,
            out: out,
            out_cap: out_cap,
            scratch: scratch,
            scratch_cap: scratch_cap,
        )

### x ** y at `prec` bits, correctly rounded (an overflow is an infinity). A zero base with a negative
### exponent and a negative base with a non-integer exponent are the caller's to reject.
common routine Ingrid.real_pow(
    x_sign: U64,
    x_expn: S64,
    x_len: U64,
    x_tab: Hijacked[U64],
    y_sign: U64,
    y_expn: S64,
    y_len: U64,
    y_tab: Hijacked[U64],
    prec: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        return real_binary(
            op: 3u32,
            a: abi_bft(sign: x_sign, expn: x_expn, len: x_len, tab: x_tab),
            b: abi_bft(sign: y_sign, expn: y_expn, len: y_len, tab: y_tab),
            prec: prec,
            out: out,
            out_cap: out_cap,
            scratch: scratch,
            scratch_cap: scratch_cap,
        )

# A one-argument Real function at `prec` bits, by number: 0 sqrt, 1 exp, 2 log, 3 sin, 4 cos, 5 tan, 6 asin,
# 7 acos, 8 atan, 9 sinh, 10 cosh, 11 tanh, 12 asinh, 13 acosh, 14 atanh, 15 log2, 16 log10, 17 cbrt, 18 the
# integer nearest (ties to even), 19 floor, 20 ceil, 21 trunc, 22 the integer nearest (ties away from zero).
secret routine real_unary_body(op: U32, a: BfT, prec: U64) -> BfT
    if op == 0u32
        return bf_sqrt(a: a, prec: prec, fl: 0u32)
    if op == 1u32
        return real_exp_body(a: a, prec: prec)
    if op == 2u32
        return bf_log(a: a, prec: prec, fl: 0u32)
    if op == 3u32
        return bf_sin(a: a, prec: prec, fl: 0u32)
    if op == 4u32
        return bf_cos(a: a, prec: prec, fl: 0u32)
    if op == 5u32
        return bf_tan(a: a, prec: prec, fl: 0u32)
    if op == 6u32
        return bf_asin(a: a, prec: prec, fl: 0u32)
    if op == 7u32
        return bf_acos(a: a, prec: prec, fl: 0u32)
    if op == 8u32
        return bf_atan(a: a, prec: prec, fl: 0u32)
    if op == 9u32
        return real_sinhcosh_body(a: a, prec: prec, is_cosh: false)
    if op == 10u32
        return real_sinhcosh_body(a: a, prec: prec, is_cosh: true)
    if op == 11u32
        return real_tanh_body(a: a, prec: prec)
    if op == 12u32
        return real_asinh_acosh_body(a: a, prec: prec, is_acosh: false)
    if op == 13u32
        return real_asinh_acosh_body(a: a, prec: prec, is_acosh: true)
    if op == 14u32
        return bf_atanh(a: a, prec: prec)
    if op == 15u32
        return bf_logbase(a: a, prec: prec, base10: false)
    if op == 16u32
        return bf_logbase(a: a, prec: prec, base10: true)
    if op == 17u32
        return bf_cbrt(a: a, prec: prec)
    if op == 18u32
        return bf_rint(a: a, rnd: 0u32)
    if op == 19u32
        return bf_rint(a: a, rnd: 2u32)
    if op == 20u32
        return bf_rint(a: a, rnd: 3u32)
    if op == 21u32
        return bf_rint(a: a, rnd: 1u32)
    return bf_rint(a: a, rnd: 4u32)

# One call of a one-argument Real function at `prec` bits.
secret dangerous routine real_unary(
    op: U32,
    a: BfT,
    prec: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
    return real_done(r: real_unary_body(op: op, a: a, prec: prec), out: out, out_cap: out_cap)

### One Real function of `a` at `prec` bits, correctly rounded, by number: 0 sqrt, 1 exp, 2 log, 3 sin, 4 cos,
### 5 tan, 6 asin, 7 acos, 8 atan, 9 sinh, 10 cosh, 11 tanh, 12 asinh, 13 acosh, 14 atanh, 15 log2, 16 log10,
### 17 cbrt (sinh to log10 and cbrt are composed of correctly rounded steps). 18 to 22 round to an integer
### (`prec` unused): 18 nearest with ties to even, 19 floor, 20 ceil, 21 trunc, 22 nearest with ties away from
### zero. An argument outside the domain gives a NaN and an overflow an infinity: the caller checks the domain.
common routine Ingrid.real_function(
    op: U64,
    a_sign: U64,
    a_expn: S64,
    a_len: U64,
    a_tab: Hijacked[U64],
    prec: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        return real_unary(
            op: U32(from: op),
            a: abi_bft(sign: a_sign, expn: a_expn, len: a_len, tab: a_tab),
            prec: prec,
            out: out,
            out_cap: out_cap,
            scratch: scratch,
            scratch_cap: scratch_cap,
        )

### -1, 0 or 1 as a is below, equal to or above b (2 when either is a NaN).
common routine Ingrid.real_compare(
    a_sign: U64,
    a_expn: S64,
    a_len: U64,
    a_tab: Hijacked[U64],
    b_sign: U64,
    b_expn: S64,
    b_len: U64,
    b_tab: Hijacked[U64],
) -> S64
    return bf_cmp(
        a: abi_bft(sign: a_sign, expn: a_expn, len: a_len, tab: a_tab),
        b: abi_bft(sign: b_sign, expn: b_expn, len: b_len, tab: b_tab),
    )

### The exact Real of an S64 (one limb at most).
common routine Ingrid.real_from_s64(
    v: S64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        return real_done(r: bf_set_si(a: v), out: out, out_cap: out_cap)

### The exact Real of a B64 given by its bits (one limb at most, an infinity or NaN for those).
common routine Ingrid.real_from_b64(
    bits: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        return real_done(r: bf_set_b64(d: B64.from_bits(bits: bits)), out: out, out_cap: out_cap)

### The B64 nearest a (ties to even, with subnormals): done with its bits in `w1`. Takes a_len limbs of
### scratch.
common routine Ingrid.real_to_b64(
    a_sign: U64,
    a_expn: S64,
    a_len: U64,
    a_tab: Hijacked[U64],
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var d = bf_get_b64(a: abi_bft(sign: a_sign, expn: a_expn, len: a_len, tab: a_tab))
        var need = C::ingrid_scratch_close()
        if need != 0u64
            return words_need(status: 1u64, need: need)
        return IngridWords(w0: 0u64, w1: d.to_bits(), w2: 0u64, w3: 0u64)

### The most characters `real_to_text` writes at `prec` bits.
common routine Ingrid.real_text_capacity(prec: U64) -> U64
    return bf_ftoa_capacity(prec: prec)

### The shortest decimal text that reads back to exactly `a` at `prec` bits (nearest), into the characters at
### `out`: plain notation unless the decimal exponent is below -5 or beyond the digit budget, then
### `d.ddde<exp>`. Done: `w1` the character count. Status 2: `w1` the characters needed.
common routine Ingrid.real_to_text(
    a_sign: U64,
    a_expn: S64,
    a_len: U64,
    a_tab: Hijacked[U64],
    prec: U64,
    out: Hijacked[Character],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        var cap = bf_ftoa_capacity(prec: prec)
        if out_cap < cap
            return words_need(status: 2u64, need: cap)
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var count = bf_ftoa_into(a: abi_bft(sign: a_sign, expn: a_expn, len: a_len, tab: a_tab), prec: prec, out: out)
        var need = C::ingrid_scratch_close()
        if need != 0u64
            return words_need(status: 1u64, need: need)
        return IngridWords(w0: 0u64, w1: count, w2: 0u64, w3: 0u64)

### Parses the `count` characters at `chars` in `radix` (2 to 36) to the nearest Real at `prec` bits: an
### optional sign, "nan" / "inf" / "infinity" (any case, radix up to 16), a "0x" prefix in radix 16, digits with
### at most one '.', and an optional exponent of the radix ('e' or 'E' in radix 10, '@' in any radix) written in
### decimal. Done: the value as for a Real, except that `w2` holds the sign in bit 0 and sets bit 1 when the
### text is malformed (the value then meaning nothing).
common routine Ingrid.real_parse(
    chars: Hijacked[Character],
    count: U64,
    radix: U64,
    prec: U64,
    out: Hijacked[U64],
    out_cap: U64,
    scratch: Hijacked[U64],
    scratch_cap: U64,
) -> IngridWords
    danger
        C::ingrid_scratch_open(base: scratch, limbs: scratch_cap)
        var parsed = bf_atof(chars: chars, count: count, radix: radix, prec: prec)
        var w = real_done(r: parsed.item0, out: out, out_cap: out_cap)
        if w.w0 != 0u64 or parsed.item1
            return w
        return IngridWords(w0: 0u64, w1: w.w1, w2: w.w2 | 2u64, w3: w.w3)
