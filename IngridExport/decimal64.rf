# The D64 (IEEE 754 decimal64, BID) arithmetic Ingrid exports: `RazorForge export-ingrid` writes these routines,
# with the Core engine they call (Core/Numerics/D64.rf and the D128 helpers it shares), to
# Ingrid/tessera/generated/decimal64.tess. Core's D64 methods call them through the C:: declarations in
# Core/NativeDeclarations.rf.
#
# A D64 crosses the C ABI as its 64 BID bits in a U64. Each routine is the raw IEEE operation (an infinity or a NaN
# passes through), so the checked operators keep their crash in RazorForge, where it gets RazorForge's crash trace.
module IngridExport/Decimal64

### The exports: each common routine below is the C symbol `ingrid_<its name>`.
record Ingrid
    pass

### `a + b`, rounded half to even to 16 digits.
common routine Ingrid.d64_add(a: U64, b: U64) -> U64
    return d64_add(a: D64.from_bits(bits: a), b: D64.from_bits(bits: b)).to_bits()

### `a - b`, rounded half to even to 16 digits.
common routine Ingrid.d64_sub(a: U64, b: U64) -> U64
    return d64_sub(a: D64.from_bits(bits: a), b: D64.from_bits(bits: b)).to_bits()

### `a * b`, rounded half to even to 16 digits.
common routine Ingrid.d64_mul(a: U64, b: U64) -> U64
    return d64_mul(a: D64.from_bits(bits: a), b: D64.from_bits(bits: b)).to_bits()

### `a / b`, rounded half to even to 16 digits: a nonzero value over zero is an infinity, zero over zero a NaN.
common routine Ingrid.d64_div(a: U64, b: U64) -> U64
    return d64_div(a: D64.from_bits(bits: a), b: D64.from_bits(bits: b)).to_bits()

### The order of a and b: -1, 0 or 1 as a is below, equal to or above b (+0 and -0 equal, cohorts equal), 2 when
### either is a NaN.
common routine Ingrid.d64_order(a: U64, b: U64) -> S64
    return d64_order(a: D64.from_bits(bits: a), b: D64.from_bits(bits: b))
