<idea-plugin>
    <id>com.revare.rider</id>
    <name>Revare</name>
    <vendor email="djminstar573@gmail.com">revare</vendor>

    <description><![CDATA[
        Revare (<code>.rvr</code>) in Rider: syntax highlighting, comment and bracket handling, and the Revare
        language server (<code>Revare lsp</code>) for diagnostics, completion, hover, navigation, rename, inlay hints
        and formatting.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.revare.rider.RevareEditorListener"/>
        <textmate.bundleProvider implementation="com.revare.rider.RevareBundleProvider"/>
        <lang.syntaxHighlighterFactory language="revare" implementationClass="com.revare.rider.RevareSyntaxHighlighterFactory"/>
        <fileIconProvider implementation="com.revare.rider.RevareIconProvider"/>
        <platform.lsp.integrationProvider implementation="com.revare.rider.RevareLanguageServer"/>
        <actionConfigurationCustomizer order="last" implementation="com.revare.rider.RevareCleanupActions"/>
        <colorSettingsPage implementation="com.revare.rider.RevareColorSettingsPage"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/RevareDarcula.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/RevareDefault.xml"/>
        <applicationConfigurable
            parentId="language"
            id="com.revare.rider.settings"
            displayName="Revare"
            instance="com.revare.rider.RevareConfigurable"/>
    </extensions>

    <projectListeners>
        <listener
            class="com.revare.rider.RevareFileOpenListener"
            topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
