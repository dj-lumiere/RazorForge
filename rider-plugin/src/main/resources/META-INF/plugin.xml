<idea-plugin>
    <id>com.razorforge.rider</id>
    <name>RazorForge</name>
    <vendor email="djminstar573@gmail.com">razorforge</vendor>

    <description><![CDATA[
        RazorForge (<code>.rf</code>) in Rider: syntax highlighting, comment and bracket handling, and the RazorForge
        language server (<code>RazorForge lsp</code>) for diagnostics, completion, hover, navigation, rename, inlay hints
        and formatting.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="com.razorforge.rider.RazorForgeBundleProvider"/>
        <lang.syntaxHighlighterFactory language="razorforge" implementationClass="com.razorforge.rider.RazorForgeSyntaxHighlighterFactory"/>
        <fileIconProvider implementation="com.razorforge.rider.RazorForgeIconProvider"/>
        <platform.lsp.integrationProvider implementation="com.razorforge.rider.RazorForgeLanguageServer"/>
        <colorSettingsPage implementation="com.razorforge.rider.RazorForgeColorSettingsPage"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/RazorForgeDarcula.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/RazorForgeDefault.xml"/>
        <applicationConfigurable
            parentId="language"
            id="com.razorforge.rider.settings"
            displayName="RazorForge"
            instance="com.razorforge.rider.RazorForgeConfigurable"/>
    </extensions>

    <projectListeners>
        <listener
            class="com.razorforge.rider.RazorForgeFileOpenListener"
            topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
