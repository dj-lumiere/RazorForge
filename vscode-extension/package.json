{
  "name": "razorforge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "lumifoundry",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "razorforge",
        "aliases": [
          "RazorForge",
          "razorforge"
        ],
        "extensions": [
          ".rf",
          ".razorforge"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/razorforge.svg",
          "dark": "./icons/razorforge.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "razorforge",
        "scopeName": "source.razorforge",
        "path": "./syntaxes/RazorForge.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "type",
        "superType": "type",
        "description": "%token.type%"
      },
      {
        "id": "recordType",
        "superType": "struct",
        "description": "%token.recordType%"
      },
      {
        "id": "entityType",
        "superType": "class",
        "description": "%token.entityType%"
      },
      {
        "id": "bundleType",
        "superType": "struct",
        "description": "%token.bundleType%"
      },
      {
        "id": "constant",
        "superType": "variable",
        "description": "%token.constant%"
      },
      {
        "id": "docTag",
        "superType": "keyword",
        "description": "%token.docTag%"
      },
      {
        "id": "docValue",
        "superType": "variable",
        "description": "%token.docValue%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "razorforge",
        "scopes": {
          "type": [
            "entity.name.type"
          ],
          "recordType": [
            "entity.name.type.struct",
            "entity.name.type"
          ],
          "entityType": [
            "entity.name.type.class",
            "entity.name.type"
          ],
          "bundleType": [
            "entity.name.type.struct",
            "entity.name.type"
          ],
          "constant": [
            "variable.other.constant"
          ],
          "docTag": [
            "storage.type.class.jsdoc"
          ],
          "docValue": [
            "variable.other.jsdoc"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[razorforge]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "bundleType:razorforge": "#F78FC6",
          "decorator:razorforge": "#E5C07B",
          "interface:razorforge": {
            "foreground": "#8CCBFF",
            "fontStyle": "italic"
          }
        }
      }
    },
    "configuration": {
      "title": "RazorForge",
      "properties": {
        "razorforge.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.path%"
        }
      }
    },
    "commands": [
      {
        "command": "razorforge.restartServer",
        "title": "%command.restart%",
        "category": "RazorForge"
      }
    ]
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "compile": "npm run assets && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o dist/razorforge.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
