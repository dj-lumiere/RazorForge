{
  "name": "revare",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "lumifoundry",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "revare",
        "aliases": [
          "Revare",
          "revare"
        ],
        "extensions": [
          ".rvr",
          ".revare"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/revare.svg",
          "dark": "./icons/revare.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "revare",
        "scopeName": "source.revare",
        "path": "./syntaxes/Revare.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "type",
        "superType": "type",
        "description": "%token.type%"
      },
      {
        "id": "recordType",
        "superType": "struct",
        "description": "%token.recordType%"
      },
      {
        "id": "entityType",
        "superType": "class",
        "description": "%token.entityType%"
      },
      {
        "id": "memberKindType",
        "superType": "struct",
        "description": "%token.memberKindType%"
      },
      {
        "id": "constant",
        "superType": "variable",
        "description": "%token.constant%"
      },
      {
        "id": "docTag",
        "superType": "keyword",
        "description": "%token.docTag%"
      },
      {
        "id": "docValue",
        "superType": "variable",
        "description": "%token.docValue%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "revare",
        "scopes": {
          "type": [
            "entity.name.type"
          ],
          "recordType": [
            "entity.name.type.struct",
            "entity.name.type"
          ],
          "entityType": [
            "entity.name.type.class",
            "entity.name.type"
          ],
          "memberKindType": [
            "entity.name.type.struct",
            "entity.name.type"
          ],
          "constant": [
            "variable.other.constant"
          ],
          "docTag": [
            "storage.type.class.jsdoc"
          ],
          "docValue": [
            "variable.other.jsdoc"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[revare]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "memberKindType:revare": "#F78FC6",
          "decorator:revare": "#E5C07B",
          "interface:revare": {
            "foreground": "#8CCBFF",
            "fontStyle": "italic"
          },
          "recordType:revare": "#4EC9B0",
          "entityType:revare": "#5CB2FF"
        }
      }
    },
    "configuration": {
      "title": "Revare",
      "properties": {
        "revare.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.path%"
        }
      }
    },
    "commands": [
      {
        "command": "revare.restartServer",
        "title": "%command.restart%",
        "category": "Revare"
      },
      {
        "command": "revare.runFile",
        "title": "%command.runFile%",
        "category": "Revare",
        "icon": "$(play)"
      },
      {
        "command": "revare.runFolder",
        "title": "%command.runFolder%",
        "category": "Revare",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "revare.runFile",
          "when": "resourceLangId == revare",
          "group": "z_commands@1"
        },
        {
          "command": "revare.runFolder",
          "when": "resourceLangId == revare",
          "group": "z_commands@2"
        }
      ],
      "explorer/context": [
        {
          "command": "revare.runFile",
          "when": "resourceLangId == revare",
          "group": "z_commands@1"
        }
      ],
      "editor/title": [
        {
          "command": "revare.runFile",
          "when": "resourceLangId == revare",
          "group": "navigation@1"
        },
        {
          "command": "revare.runFolder",
          "when": "resourceLangId == revare",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "revare.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == revare"
      },
      {
        "command": "revare.runFolder",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "editorLangId == revare"
      }
    ]
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "compile": "npm run assets && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o dist/revare.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
