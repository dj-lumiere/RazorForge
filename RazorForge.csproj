<Project Sdk="Microsoft.NET.Sdk">
  <!-- RazorForge: the RazorForge front end (its lexer) and the `razorforge` command line, over the Anvila
       builder core. Ships the RazorForge standard library, which Suflae builds also use. -->
  <PropertyGroup>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.4.0</Version>
    <AssemblyName>RazorForge</AssemblyName>
    <RootNamespace>RazorForge</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <!-- Canonical command name. `forge` is deliberately NOT used: it collides with
         Foundry's forge (Ethereum toolchain) on developer machines. Users who want
         `forge` can alias it locally; packages also ship an `rf` short alias. -->
    <ToolCommandName>razorforge</ToolCommandName>
    <PackageId>RazorForge</PackageId>
    <Description>The RazorForge toolchain.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anvila\Anvila.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Suflae"/>
    <InternalsVisibleTo Include="RazorForge.Tests"/>
  </ItemGroup>

  <!-- The RazorForge standard library, laid out as Standard\RazorForge next to the executable. -->
  <ItemGroup>
    <Content Include="Standard\**\*" Link="Standard\RazorForge\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" PackageCopyToOutput="true"/>
    <None Remove="Standard\**\*"/>
  </ItemGroup>

  <!-- Emit the modular compiled-stdlib .pbrf artifacts as a BUILD BYPRODUCT (the daemon/cold path LOADS
       them instead of paying a ~8s stdlib capture on first run). Runs the JUST-BUILT toolchain after Build.
       MSBuild Inputs/Outputs make this INCREMENTAL: when no stdlib source and no toolchain dll changed since
       the last emit, the whole target is SKIPPED (no process launch → zero per-build cost). Disable with
       -p:EmitPbrf=false. Best-effort (ContinueOnError) so a toolchain hiccup never fails the build. -->
  <ItemGroup>
    <RfStdlibSource Include="Standard\**\*.rf"/>
  </ItemGroup>
  <Target Name="EmitModularPbrf" AfterTargets="Build"
          Condition="'$(EmitPbrf)' != 'false' and Exists('$(TargetPath)')"
          Inputs="@(RfStdlibSource);$(TargetPath)"
          Outputs="$(TargetDir)Standard\.pbrf\RazorForge\index.pbrf">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; emit-pbrf" WorkingDirectory="$(TargetDir)" ContinueOnError="true"/>
  </Target>

  <Import Project="..\Ingrid\StageIngridRuntime.targets"/>

  <!-- rider-plugin\ is the Rider plugin, a Gradle project of its own. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);rider-plugin\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- tests\ is its own project. -->
  <ItemGroup>
    <Compile Remove="tests\**"/>
    <None Remove="tests\**"/>
    <Content Remove="tests\**"/>
    <EmbeddedResource Remove="tests\**"/>
  </ItemGroup>
</Project>
