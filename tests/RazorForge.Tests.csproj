<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Tests are never packed or shipped; this assembly stays out of every publish. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- This is the test project (the compiler project sets this false). -->
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <!-- Workstation GC for the test host. StdlibApiTests spawns ~150 sequential `buildandrun`
         children (each compiling the full stdlib + opt -O2/-O3); under default Server GC the host's
         per-core heap reservation stacks onto that peak and the OS OOM-kills processes across the
         tree during long runs (test host aborts; "exit=143, no output" child kills). Workstation GC
         keeps the host footprint small. The children get the same via env vars in StdlibApiTests. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anvila\Anvila.csproj"/>
    <ProjectReference Include="..\RazorForge\RazorForge.csproj"/>
    <ProjectReference Include="..\Suflae\Suflae.csproj"/>
  </ItemGroup>

  <!-- Test/tooling packages live ONLY here so they never reach the compiler publish. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
    <PackageReference Include="xunit" Version="2.6.6"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6"/>
    <!-- Emits an OpenCover XML coverage report when `dotnet test` runs with the XPlat Code
         Coverage collector; SonarQube reads it via sonar.cs.opencover.reportsPaths (wired in CI). -->
    <PackageReference Include="coverlet.collector" Version="6.0.2"/>
  </ItemGroup>

  <!-- StdlibApiTests spawns `RazorForge.dll`/`Suflae.dll buildandrun` from this project's output
       directory (AppContext.BaseDirectory), and F128EncoderTests P/Invokes razorforge_runtime
       directly. A project reference copies the assemblies but NOT their Content items, so mirror the
       standard libraries here and stage Ingrid's native runtime at build time. -->
  <ItemGroup>
    <Content Include="..\RazorForge\Standard\**\*" LinkBase="Standard\RazorForge" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="..\Suflae\Standard\**\*" LinkBase="Standard\Suflae" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <Import Project="..\Ingrid\StageIngridRuntime.targets"/>

</Project>
