import IO/Console

# Names that are Tessera keywords (block, claim, local, branch, jump) as a member variable, a parameter and a local:
# the Tessera backend writes each between backticks.
record Tile
    block: S64
    claim: S64

entity Counter
    local: S64

routine jump(block: S64, claim: S64) -> S64
    var branch = block + claim
    return branch

routine start()
    var tile = Tile(block: 2, claim: 3)
    var counter = Counter(local: 4)
    counter.local += jump(block: tile.block, claim: tile.claim)
    show(f"{tile.block} {tile.claim} {counter.local}")
    return
