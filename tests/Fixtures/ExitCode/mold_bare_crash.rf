module Tests/ExitCode/MoldBareCrash

import IO/Console
# A failure no keyword receives crashes loudly with its own message (status 82), after a check on the same flow kept
# an earlier failure: the crash reports the new failure, and the kept Check still holds the earlier one.

crashable CodeError
    code: S64

routine CodeError.crash_message() -> Text
    return f"the code was {me.code}"

failable routine fail_with_code(code: S64) -> S64
    if code > 0
        throw CodeError(code: code)
    return 0

routine start()
    var kept = check fail_with_code(code: 1)
    show(f"kept: {kept}")
    show(f"bare: {fail_with_code(code: 9)}")
    show("not reached")
    return
