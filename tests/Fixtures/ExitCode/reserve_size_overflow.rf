module Tests/ExitCode/ReserveSizeOverflow

import IO/Console
# The byte size of a list's storage never wraps around: room for 2^61 + 1 elements of eight bytes is more than a
# U64 counts, so the reserve crashes instead of taking eight bytes for them (Rust I-unsound port, C46).

routine start()
    var xs = List[S64]()
    show("reserving")
    var n: U64 = 2305843009213693953
    xs.reserve(new_capacity: n)
    show("not reached")
    return
