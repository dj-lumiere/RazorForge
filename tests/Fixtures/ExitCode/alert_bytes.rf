module Tests/ExitCode/AlertBytes

import IO/Console

# `alert(bytes)` writes the bytes raw to standard error through `alert(value: Bytes)`, not their diagnostic form through `alert[T]`.

routine start()
    var raw = "ab".encode_as_utf8()
    alert(raw)
    alert("cd".encode_as_utf8(), end: "|\n")
    show("done")
    return
