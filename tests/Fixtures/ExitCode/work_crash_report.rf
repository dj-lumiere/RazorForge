module Tests/ExitCode/WorkCrashReport

import IO/Console

failable routine boom(n: S64) -> S64
    if n > 2
        throw IndexOutOfBoundsError(index: n.to[U64](), count: 2)
    return n

failable routine work(n: S64) -> S64
    return boom(n: n) + 1

routine start()
    var job = work.to[Work](n: 5)
    job.start_now()
    show(f"{job.retrieve()}")
    show("not reached")
    return
