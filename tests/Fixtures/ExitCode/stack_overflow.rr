module Tests/ExitCode/StackOverflow

import IO/Console
# Calls that go deeper than the stack holds crash with a stack overflow report (status 82), on the main thread and in
# a Work, instead of ending with a bare segmentation fault.

routine depth(n: S64) -> S64
    if n == 0
        return 0
    return depth(n: n - 1) + 1

routine start()
    show(f"shallow {depth(n: 100)}")
    var jobs = List[Work[S64]]()
    jobs.add_last(value: depth.to[Work](n: 100))
    show(f"work {jobs.gather()}")
    var deep = List[Work[S64]]()
    deep.add_last(value: depth.to[Work](n: 100000000))
    show(f"{deep.gather()}")
    show("not reached")
    return
