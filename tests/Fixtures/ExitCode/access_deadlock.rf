module Tests/ExitCode/AccessDeadlock

import IO/Console
# Two agents open two Guarded handles in opposite orders, one block inside the other, and end up waiting on each
# other. A debug build has `deadlock-check` on: the agent that closes the cycle stops the program with a DeadlockError
# naming both agents, instead of hanging.

entity Account
    balance: D128

routine forward(first: Guarded[Account, Exclusive], second: Guarded[Account, Exclusive])
    modifying first as a
        waitfor(50ms)
        modifying second as b
            b.balance += a.balance
    return

routine start()
    var ana = Guarded[Account, Exclusive](from: Account(balance: 50.00))
    var bo = Guarded[Account, Exclusive](from: Account(balance: 20.00))
    var one = forward.to[Agent](first: ana, second: bo)
    var two = forward.to[Agent](first: bo, second: ana)
    show("starting")
    one.start_now()
    two.start_now()
    one.retrieve()
    two.retrieve()
    show("not reached")
    return
