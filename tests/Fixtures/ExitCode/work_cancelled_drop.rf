module Tests/ExitCode/WorkCancelledDrop

import IO/Console

# A Work the program cancels before dropping it throws away what it came to, a failure included.

failable routine nope() -> S64
    throw VerificationFailedError()

routine start()
    if true
        var job = nope.to[Work]()
        job.start_now()
        waitfor(50ms)
        job.cancel()
    show("after the cancelled work")
    return
