module Tests/ExitCode/DestructFailureUnderCheck

import IO/Console

# `destruct` is never failable, so a failure inside it has nowhere to go: it crashes even under `check`.

entity Q
    n: S64

failable routine nope() -> S64
    throw VerificationFailedError()

routine Q.destruct()
    drop nope()
    return

routine make() -> S64
    var q = Q(n: 1)
    return 3

routine start()
    show("making")
    when check make()
        is S64 as v =>
            show(f"value {v}")
        is Crashables as e =>
            show(f"recovered {e.crash_message()}")
    show("not reached")
    return
