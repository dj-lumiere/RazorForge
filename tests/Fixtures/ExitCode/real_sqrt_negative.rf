module Tests/ExitCode/RealSqrtNegative

import IO/Console
import Numerics.[Real]
# Real is finite-only: a bare square root of a negative value is not recovered, so it crashes loudly
# (status 82) with the NumericDomainError instead of printing a NaN.

routine start()
    var minus_four = Real(from: -4_s64)
    show("taking the square root of -4")
    show(f"{minus_four.sqrt()}")
    show("not reached")
    return
