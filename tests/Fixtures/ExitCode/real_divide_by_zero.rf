module Tests/ExitCode/RealDivideByZero

import IO/Console
import Numerics.[Real]
# A bare Real division by zero is not recovered, so it crashes loudly (status 82) with the
# DivisionByZeroError instead of printing an infinity.

routine start()
    var seven = Real(from: 7_s64)
    show("dividing by zero")
    show(f"{seven / Real()}")
    show("not reached")
    return
