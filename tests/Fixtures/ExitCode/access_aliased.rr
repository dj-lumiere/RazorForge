module Tests/ExitCode/AccessAliased

import IO/Console
# One block opens two names that turn out to be the same Guarded. It enters the first, and entering the second is
# entering an access this job has open already, which would wait forever: it stops the program with
# ReenterDuringAccessError.

entity Account
    balance: D128

routine move(payer: Guarded[Account, Exclusive], payee: Guarded[Account, Exclusive], amount: D128)
    modifying payer, payee
        payer.balance -= amount
        payee.balance += amount
    return

routine start()
    var ana = Guarded[Account, Exclusive](from: Account(balance: 50.00))
    var bo = Guarded[Account, Exclusive](from: Account(balance: 20.00))
    move(payer: ana, payee: bo, amount: 5.00)
    show("moved")
    move(payer: ana, payee: ana, amount: 5.00)
    show("not reached")
    return
