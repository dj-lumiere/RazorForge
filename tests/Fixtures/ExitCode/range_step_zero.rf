module Tests/ExitCode/RangeStepZero

import IO/Console
# A range step held in a variable is checked when the range is iterated: a negative step counts down, and a step
# of zero crashes loudly (status 82) instead of looping forever.

routine count_down(step: S64)
    for i in 10 til 0 by step
        show(f"step {i}")
    return

routine start()
    count_down(step: -3)
    count_down(step: 0)
    show("not reached")
    return
