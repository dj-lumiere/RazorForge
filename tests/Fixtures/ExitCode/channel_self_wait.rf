module Tests/ExitCode/ChannelSelfWait

import IO/Console
# Reading a channel to its end while this same scope still holds its transmitter waits for a close that never comes. With
# no other work running, the runtime sees that nothing can wake the wait and crashes (status 82) instead of hanging.

routine start()
    var channel = make_channel[S64](capacity: 2)
    var tx = channel.item0
    var rx = channel.item1
    tx.transmit(item: 1)
    each x in rx
        show(f"got {x}")
    show("not reached")
    return
