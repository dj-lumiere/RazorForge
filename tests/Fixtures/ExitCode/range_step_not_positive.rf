module Tests/ExitCode/RangeStepNotPositive

import IO/Console
# A range step held in a variable is checked when the range is iterated: a step that is zero or negative crashes
# loudly (status 82) instead of looping forever. A positive step in the same variable works.

routine count_down(step: S64)
    each i in 10 til 0 by step
        show(f"step {i}")
    return

routine start()
    count_down(step: 3)
    count_down(step: -3)
    show("not reached")
    return
