module Tests/ExitCode/SetExitCode

import IO/Console
# A normal exit with a status of the program's choosing: `set_exit_code` sets it, the last call wins, and
# `start` returning ends the process with it.

routine start()
    show("setting the exit status")
    set_exit_code(7)
    set_exit_code(42)
    show("returning")
    return
