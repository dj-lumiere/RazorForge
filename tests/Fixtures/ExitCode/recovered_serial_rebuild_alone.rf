module Tests/ExitCode/RecoveredSerialRebuildAlone

import IO/Console
# Built on its own, a program whose only failure is a recovered serial rebuild links and runs. The rebuild's
# SerialShapeError has a derived diagnose that the builder reaches only in its first collection round, before
# that body is lowered, and its lowered body (an each-loop over a text in quoted_source) still has to be walked
# so the routines the lowering calls are defined.

routine start()
    show(f"bad element: {try ["a"].serialize().to[List[S64]]()}")
    return
