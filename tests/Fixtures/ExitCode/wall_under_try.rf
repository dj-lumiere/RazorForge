module Tests/ExitCode/WallUnderTry

import IO/Console
# Every routine passes its failures on, a lambda handed to a `Callable` parameter too, so `try` receives them.
# An `infallible` routine is a wall: a division by zero inside it breaks its promise and stops the program there
# (status 82), even under `try` above the routine that calls it.

crashable NegativeTotalError

routine NegativeTotalError.crash_message() -> Text
    return "the total is negative"

routine apply(f: Callable[(S64,), S64], x: S64) -> S64
    return f(x)

infallible routine share(total: S64, parts: S64) -> S64
    return total // parts

routine split(total: S64, parts: S64) -> S64
    if total < 0
        throw NegativeTotalError()
    return share(total: total, parts: parts)

routine start()
    show(f"recovered lambda: {try apply(f: t => 100 // t, x: 0)}")
    show(f"value: {try apply(f: t => 100 // t, x: 4)}")
    show(f"recovered throw: {try split(total: -1, parts: 2)}")
    show(f"split: {try split(total: 10, parts: 2)}")
    show("dividing by zero")
    show(f"{try split(total: 10, parts: 0)}")
    show("not reached")
    return
