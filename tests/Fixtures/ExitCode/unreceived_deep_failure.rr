module Tests/ExitCode/UnreceivedDeepFailure

import IO/Console
# A failure deep in a recursion goes to the `try` above the first call. The same call with no keyword above it
# stops the program where the failure happened, with that line in the report and every routine on the way in the trace.

routine eval(depth: S64, divisor: S64) -> S64
    if depth == 0
        return 100 // divisor
    var below = eval(depth: depth - 1, divisor: divisor)
    return below + 1

routine start()
    show(f"received: {try eval(depth: 4, divisor: 0)}")
    show(f"value: {eval(depth: 4, divisor: 5)}")
    var stops = eval(depth: 4, divisor: 0)
    show(f"not reached {stops}")
    return
