module Tests/ExitCode/LambdaBareCrash

import IO/Console
import IterTools
# A lambda's failure is recovered only beneath a recovery keyword. The same lambda called with no keyword above
# the call crashes loudly (status 82), and an `each` loop over an adapter holding it does not quietly end early:
# the failure inside the lambda crashes the loop.

routine apply(f: Routine[(S32,), S32], x: S32) -> S32
    return f(x)

routine start()
    show(f"recovered: {try apply(f: x => 10 // x, x: 0)}")
    var xs = List[S32]()
    xs.add_last(value: 5)
    xs.add_last(value: 0)
    xs.add_last(value: 2)
    each y in xs.select(transform: x => 10 // x)
        show(f"step {y}")
    show("not reached")
    return
