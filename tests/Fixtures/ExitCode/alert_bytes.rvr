module Tests/ExitCode/AlertBytes

import IO/Console

# `alert(bytes)` writes the diagnostic form of the bytes to standard error, like any other value, and
# `stderr().push(data:)` writes the bytes themselves.

routine start()
    var raw = "ab".encode_as_utf8()
    alert(raw)
    drop stderr().push(data: "cd|\n".encode_as_utf8())
    show("done")
    return
