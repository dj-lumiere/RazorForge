module Tests/ExitCode/GlobalDestructOrder

import IO/Console
# A global whose destruct reads another global is torn down before that one, whatever order they are declared in
# (globals are torn down in the opposite order they are initialized, Rust I-unsound port, C46).

entity Reporter
    tag: S64

routine Reporter.destruct()
    show(f"reporter {me.tag} reads the log: {LOG.lines.count()} lines, first {LOG.lines[0]}")
    return

entity Log
    lines: List[Text]

routine Log.destruct()
    show(f"log destruct with {me.lines.count()} lines")
    return

global REP: Reporter = Reporter(tag: 7)
global LOG: Log = Log(lines: ["a line long enough to be kept on the heap", "b", "c"])

routine start()
    show(f"start {REP.tag} {LOG.lines.count()}")
    return
