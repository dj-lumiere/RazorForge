module Tests/ExitCode/StackOverflowMain

import IO/Console
# Calls that go deeper than the main thread's stack holds crash with a stack overflow report (status 82) instead of
# ending with a bare segmentation fault.

routine depth(n: S64) -> S64
    if n == 0
        return 0
    return depth(n: n - 1) + 1

routine start()
    show(f"shallow {depth(n: 100)}")
    show(f"{depth(n: 100000000)}")
    show("not reached")
    return
