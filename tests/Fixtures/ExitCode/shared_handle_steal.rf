module Tests/ExitCode/SharedHandleSteal

import IO/Console
# `steal` takes the entity out of a handle only when it is the last strong one. With a second holder it crashes
# with status 82 instead of leaving the other holder pointing at nothing.

entity Node
    value: S64

routine start()
    var a = Retained[Node](from: Node(value: 1))
    var b = a
    show("before")
    var n = steal a
    show("not reached")
    return
