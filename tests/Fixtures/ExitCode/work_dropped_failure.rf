module Tests/ExitCode/WorkDroppedFailure

import IO/Console

# A started Work nobody retrieves ends with the scope that holds it. Its work failed, and that failure crashes the
# program there instead of vanishing.

failable routine nope() -> S64
    throw VerificationFailedError()

routine start()
    show("starting")
    if true
        var job = nope.to[Work]()
        job.start_now()
        waitfor(50ms)
    show("not reached")
    return
