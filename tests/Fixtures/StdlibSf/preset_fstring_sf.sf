module Tests/StdlibSf/PresetFstringSf
import IO/Console

# A preset whose value is an f-string is inlined at every use as its own lowered copy, and a preset it
# names is inlined inside that copy too.
preset NAME: Text = "lumi"
preset LABEL: Text = f"name={NAME}"
preset BANNER: Text = f"<{LABEL}>"

routine greet() -> Text
    return f"hello {LABEL}"

routine start()
    show(LABEL)
    show(f"[{LABEL}]")
    show(BANNER)
    show(greet())
    return
