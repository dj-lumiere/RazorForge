module Tests/CycleCollector/MtUafStress

import IO/Console
# Multithreaded stop-the-world regression for the cycle collector's UAF fix (RoamManager's rwlock STW).
# MUTATOR threads churn LOCAL Roamed rings (each build+drop feeds the GLOBAL candidate buffer); COLLECTOR
# threads concurrently drain it with cyclic_collect(). A controller built on one OS thread is trial-deleted
# on ANOTHER — a data race on its non-atomic count/state UNLESS the collector's EXCLUSIVE lock and the
# mutator's SHARED lock mutually exclude them. A clean finish (`DONE - no UAF`, exit 0) = the lock holds;
# a re-introduced UAF would crash or hang. Reclaim counts are non-deterministic (genuine interleaving), so
# the test asserts completion, not an exact count. Counts kept modest so the suite stays fast while still
# hammering the concurrent collect-vs-mutate path tens of thousands of times.

entity Node
    next: Roamed[Node]
    id: S64

routine build_ring(n: S64)
    danger
        var head = Roamed(from: Node(next: roamed_none(), id: 0))
        var prev = head
        var i = 1
        while i < n
            var node = Roamed(from: Node(next: roamed_none(), id: i))
            prev.raw_inner().next = node
            prev = node
            i = i + 1
        prev.raw_inner().next = head
    return

routine mutator(rounds: S64, ring_size: S64) -> S64
    var i = 0
    while i < rounds
        build_ring(n: ring_size)
        i = i + 1
    return i

routine collector(rounds: S64) -> S64
    var total: U64 = 0
    var i = 0
    while i < rounds
        total = total + cyclic_collect()
        i = i + 1
    return total.to[S64]()

routine start()
    var kids = List[Agent[S64]]()
    var m = 0
    while m < 4
        kids.add_last(value: mutator.to[Agent](rounds: 700, ring_size: 40))
        m = m + 1
    var c = 0
    while c < 4
        kids.add_last(value: collector.to[Agent](rounds: 8000))
        c = c + 1
    var results = kids.gather()
    var total = 0
    var k: U64 = 0
    while k < results.count()
        total = total + results[k]
        k = k + 1
    show(f"DONE - no UAF (mutator+collector work units={total})")
    return
