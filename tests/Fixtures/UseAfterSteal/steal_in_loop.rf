module Tests/UseAfterSteal/StealInLoop

import IO/Console
# The loop moves `a` out on its first pass and would read the emptied binding on the second: a build error
# (RF-S616).

entity Box
    v: S64

routine consume(b: Box)
    show(f"consumed {b.v}")
    return

routine start()
    var a = Box(v: 1)
    var i = 0
    until i >= 2
        consume(b: steal a)
        i += 1
    show("not reached")
    return
