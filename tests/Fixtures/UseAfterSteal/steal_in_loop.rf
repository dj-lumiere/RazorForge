module Tests/UseAfterSteal/StealInLoop

import IO/Console
# The loop moves `a` out on its first pass. The build cannot see that the second pass reads the emptied
# binding, so the read is guarded at runtime and crashes with UseAfterStealError naming the binding.

entity Box
    v: S64

routine consume(b: Box)
    show(f"consumed {b.v}")
    return

routine start()
    var a = Box(v: 1)
    var i = 0
    while i < 2
        consume(b: steal a)
        i += 1
    show("not reached")
    return
