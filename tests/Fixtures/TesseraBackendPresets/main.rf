module Tests/TesseraBackendPresets

# A preset made by a construction and a global, read in routines, on the Tessera backend: each is a module-level cell
# that start() fills first.

import IO/Console

record Point
    x: S64
    y: S64

record Label
    name: Text
    at: Point

preset ORIGIN: Point = Point(x: 0, y: 0)
preset CORNER: Point = Point(x: 3, y: 4)
preset HOME: Label = Label(name: "home", at: Point(x: 1, y: 2))

global STEP: S64 = 5

routine distance_sum() -> S64
    return CORNER.x + CORNER.y + ORIGIN.x + STEP

routine start()
    var p = ORIGIN
    show(f"{p.x} {p.y} {distance_sum()} {HOME.name} {HOME.at.y}")
    return
