module Tests/Stdlib/ChoiceCollectionsApi

import IO/Console
# A choice is Equatable and Hashable from the start, so a member variable may be a Set or Dict of it, and a record or
# variant holding one goes in a List or Dict. `when` over a token an `each` loop binds matches the value it reaches.

choice Color
    RED
    GREEN

entity Holder
    effects: Set[Color]
    counts: Dict[Color, S64]

record Paint
    color: Color

variant Mark
    Color
    Paint

routine start()
    var h = Holder(effects: Set[Color](), counts: Dict[Color, S64]())
    h.effects.add(value: Color.RED)
    h.counts[Color.GREEN] = 2
    var paints = List[Paint]()
    paints.add_last(value: Paint(color: Color.GREEN))
    var d = Dict[S64, Paint]()
    d[1] = Paint(color: Color.RED)
    show(f"{h.effects.count()} {h.counts[Color.GREEN]} {paints[0].color} {d[1].color}")
    var marks = List[Mark]()
    marks.add_last(value: Color.RED)
    marks.add_last(value: Paint(color: Color.GREEN))
    var dm = Dict[S64, Mark]()
    dm[1] = Color.GREEN
    each m in marks
        when m
            is Color as c => show(f"color {c}")
            is Paint as p => show(f"paint {p.color}")
    show(f"{dm.count()}")
    show("DONE")
    return
