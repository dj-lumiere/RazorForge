module Tests/Stdlib/FloatMathApi

import IO/Console
# Float math: sqrt/pow/log/exp/trig, rounding, classification, clamping.
routine start()
    show(f"sqrt(2): {2.0.sqrt_unchecked()}")
    show(f"sqrt(16): {16.0.sqrt_unchecked()}")
    show(f"pow(2, 10): {2.0 ** 10.0}")
    show(f"exp(0): {0.0.exp_unchecked()}")
    show(f"exp(1): {1.0.exp_unchecked()}")
    show(f"log(e): {1.0.exp_unchecked().log_unchecked()}")
    show(f"log10(1000): {1000.0.log10_unchecked()}")

    # Trig (radians)
    show(f"sin(0): {0.0.sin()}")
    show(f"cos(0): {0.0.cos()}")

    # Rounding
    show(f"floor(3.7): {3.7.floor()}")
    show(f"ceil(3.2): {3.2.ceil()}")
    show(f"round(3.5): {3.5.round()}")
    show(f"round(3.4): {3.4.round()}")

    # Min/max/clamp
    show(f"min(3.0, 7.0): {3.0.min(you: 7.0)}")
    show(f"max(3.0, 7.0): {3.0.max(you: 7.0)}")
    show(f"clamp(5, 1..10): {5.0.clamp(min_val: 1.0, max_val: 10.0)}")
    show(f"clamp(-1, 0..10): {(-1.0).clamp(min_val: 0.0, max_val: 10.0)}")
    show(f"clamp(100, 0..10): {100.0.clamp(min_val: 0.0, max_val: 10.0)}")

    # Classification
    show(f"is_positive(1.0): {1.0.is_positive()}")
    show(f"is_negative(-1.0): {(-1.0).is_negative()}")
    show(f"is_zero(0.0): {0.0.is_zero()}")
    show(f"is_finite(1.0): {1.0.is_finite()}")
    show(f"is_finite(inf): {B64_INFINITY.is_finite()}")
    show(f"signum(-5.0): {(-5.0).signum()}")
    show(f"signum(5.0): {5.0.signum()}")

    show("DONE")
    return
