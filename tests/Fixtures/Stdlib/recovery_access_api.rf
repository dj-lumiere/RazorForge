module Tests/Stdlib/RecoveryAccessApi

import IO/Console
# With `try` or `check` in front of a call, a failing subscript or conversion anywhere beneath it is
# recovered: an index out of range on a list or a text, a missing dictionary key, a value that does not fit
# the target type, a text that does not parse, also through a generic routine and a routine that is not
# failable. Only the carrier differs.

crashable NopeError

routine NopeError.crash_message() -> Text
    return "nope"

failable routine pick(xs: Viewing[List[S64]], i: U64) -> S64
    if i > 1000
        throw NopeError()
    var v = xs[i]
    return v

failable routine letter(t: Text, i: U64) -> Char
    if i > 1000
        throw AbsentValueError()
    return t[i]

failable routine score(d: Viewing[Dict[Text, S64]], name: Text) -> S64
    if name == ""
        throw NopeError()
    return d[name] * 10

failable routine narrow(n: S64) -> S8
    if n < 0
        throw AbsentValueError()
    var b = n.to[S8]()
    return b

failable routine parsed(t: Text) -> S64
    if t == ""
        throw AbsentValueError()
    var big = t.to[Int]()
    return big.to[S64]()

# a generic routine: the subscript is the instance's own
failable routine first_of[T](xs: Viewing[List[T]]) -> T
needs RecordType T
    if xs.count() > 1000
        throw AbsentValueError()
    return xs[0]

# a failable routine with a subscript, called bare by another failable one
failable routine last_of(xs: Viewing[List[S64]]) -> S64
    return xs[xs.count() - 1]

failable routine last_plus_one(xs: Viewing[List[S64]]) -> S64
    if xs.count() > 1000
        throw AbsentValueError()
    return last_of(xs: xs) + 1

routine start()
    var xs = List[S64]()
    xs.add_last(value: 4)
    xs.add_last(value: 5)
    var empty = List[S64]()
    show(f"try pick(1): {try pick(xs: xs.view(), i: 1)}")
    show(f"try pick(9): {try pick(xs: xs.view(), i: 9)}")
    show(f"grab pick(9): {check pick(xs: xs.view(), i: 9)}")
    show(f"check pick(9): {check pick(xs: xs.view(), i: 9)}")
    show(f"try letter(1): {try letter(t: "abc", i: 1)}")
    show(f"grab letter(9): {check letter(t: "abc", i: 9)}")
    var d = Dict[Text, S64]()
    d["ann"] = 3
    show(f"try score(ann): {try score(d: d.view(), name: "ann")}")
    show(f"check score(bob): {check score(d: d.view(), name: "bob")}")
    show(f"grab score(empty): {check score(d: d.view(), name: "")}")
    show(f"try narrow(100): {try narrow(n: 100)}")
    show(f"grab narrow(300): {check narrow(n: 300)}")
    show(f"try parsed(42): {try parsed(t: "42")}")
    show(f"grab parsed(4x): {check parsed(t: "4x")}")
    show(f"grab parsed(huge): {check parsed(t: "99999999999999999999")}")
    show(f"try first_of(xs): {try first_of(xs: xs.view())}")
    show(f"try first_of(empty): {try first_of(xs: empty.view())}")
    var words = List[Text]()
    show(f"check first_of(words): {check first_of(xs: words.view())}")
    show(f"try last_plus_one(xs): {try last_plus_one(xs: xs.view())}")
    show(f"grab last_plus_one(empty): {check last_plus_one(xs: empty.view())}")
    show(f"try xs[7]: {try xs[7]}")
    show(f"try xs[0] + xs[1]: {try xs[0] + xs[1]}")
    show("DONE")
    return
