module Tests/Stdlib/IntegerExtraApi

import IO/Console
# Regression coverage for the arbitrary-precision Int API added in the numeric arc (commit
# 3a021a9): is_even/is_odd/is_power_of_two, bit_length, min/max/clamp, divmod!, modpow!.
# divmod! (tuple-of-Int return inside a danger block) regression-tests the RecordCopyLoweringPass
# DangerStatement fix — before it, the failable-call argument missed its retaining copy -> double-free.
routine start()
    var a = 1234.to[Int]()
    var b = 56.to[Int]()
    show(f"is_even(1234): {a.is_even()}")
    show(f"is_odd(1234): {a.is_odd()}")
    show(f"is_power_of_two(1024): {1024.to[Int]().is_power_of_two()}")
    show(f"is_power_of_two(1000): {1000.to[Int]().is_power_of_two()}")
    show(f"bit_length(1234): {1234.to[Int]().bit_length()}")
    show(f"min(1234,56): {a.min(other: b)}")
    show(f"max(1234,56): {a.max(other: b)}")
    show(f"clamp(1234,0,100): {a.clamp(low: 0.to[Int](), high: 100.to[Int]())}")
    danger
        var qr = a.divmod(other: b)
        show(f"divmod(1234,56): q={qr.item0} r={qr.item1}")
        show(f"modpow(7,13,100): {7.to[Int]().modpow(exp: 13.to[Int](), modulus: 100.to[Int]())}")
    show("DONE")
    return
