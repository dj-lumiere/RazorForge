module Tests/Stdlib/EmittableSetOpsRangeApi

import EmitterTools
import IO/Console

# `intersect` and `exclude` read the other sequence through `Hijacked[TOther].referent()`, which is the entity itself for
# a list and the stored value for a record, so two ranges (records) link and run as lists do.
routine start()
    var a = 1 to 4
    var b = 3 to 6
    show(f"intersect: {a.intersect(b).to[List]()}")
    show(f"exclude: {a.exclude(b).to[List]()}")
    show(f"intersect of lists: {[5, 1, 7, 9].intersect([9, 5, 2]).to[List]()}")
    show(f"exclude of lists: {[5, 1, 7, 9].exclude([9, 5, 2]).to[List]()}")
    show(f"range with a list: {a.intersect([4, 2, 8]).to[List]()}")
    show(f"list with a range: {[8, 3, 4, 3].exclude(b).to[List]()}")
    return
