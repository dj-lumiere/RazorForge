module Tests/Stdlib/B128SoftfloatApi

import IO/Console
# Covers the software B128: arithmetic, comparison, and libm all run as pure-integer RF
# (no TLFloat FFI, no LLVM fp128). Integer constructors (S64/U64/S128/U128) and float
# widen/narrow are pure-RF too.

routine start()
    var a = 2_s64.to[B128]()
    var b = 3_s64.to[B128]()
    show(f"2+3 = {a + b}")
    show(f"2-3 = {a - b}")
    show(f"2*3 = {a * b}")
    show(f"3/2 = {b / a}")
    show(f"sqrt(2) = {a.sqrt_unchecked()}")
    show(f"exp(1) = {1_s64.to[B128]().exp_unchecked()}")
    show(f"log(2) = {a.log_unchecked()}")
    show(f"2<3 = {a < b}")
    show(f"2==2 = {a == 2_s64.to[B128]()}")
    show(f"max(2,3) = {a.max(you: b)}")
    show(f"clamp(3,0,2) = {b.clamp(min_val: 0_s64.to[B128](), max_val: a)}")

    # Integer constructors through the engine.
    var big = 1000000000000000000_s64.to[B128]()
    show(f"from s64 1e18 = {big}")
    var u = 18446744073709551615_u64.to[B128]()
    show(f"from u64 max = {u}")
    var s128v = 170141183460469231731687303715884105727_s128.to[B128]()
    show(f"from s128 max = {s128v}")

    # Float widen (B64 -> B128, exact) and narrow (B128 -> B64, correctly rounded).
    var w = 1.5_b64.to[B128]()
    show(f"from b64 1.5 = {w}")
    show(f"to b64 1.5 = {w.to[B64]()}")
    show(f"3/2 to b64 = {(b / a).to[B64]()}")
    show(f"pi to b64 = {B128_PI.to[B64]()}")
    show(f"to b32 = {w.to[B32]()}")
    return
