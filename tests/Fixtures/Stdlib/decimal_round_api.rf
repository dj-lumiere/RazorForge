module Tests/Stdlib/DecimalRoundApi

import IO/Console
# Without `places:`, `Decimal.add(you:, rule:)`, `subtract(you:)`, `multiply(by:)` and `divide(by:)` round the exact result
# once to the nearest 34-significant-digit value under `rule:` (half up when left out) where `+ - *` stop with
# NumericOverflowError. With `places:` they round to that many digits after the point. A result past the Decimal range
# still stops.

routine start()
    var huge: Decimal = 1e30
    var tiny: Decimal = 1e-30
    show(f"sum: {try (huge + tiny)} {huge.add(you: tiny, rule: RoundingRule.HALF_UP)} {huge.add(you: tiny, rule: RoundingRule.CEIL)} {huge.add(you: tiny, places: 2)}")
    show(f"difference: {try (huge - tiny)} {huge.subtract(you: tiny)} {huge.subtract(you: tiny, rule: RoundingRule.FLOOR)} {huge.subtract(you: tiny, places: 2)}")
    var wide: Decimal = 1.23456789012345678901
    show(f"product: {try (wide * wide)} {wide.multiply(by: wide)} {wide.multiply(by: wide, rule: RoundingRule.FLOOR)} {wide.multiply(by: wide, places: 10)}")
    var one: Decimal = 1
    var two: Decimal = 2
    var three: Decimal = 3
    show(f"quotient: {one.divide(by: three)} {one.divide(by: three, rule: RoundingRule.CEIL)} {two.divide(by: three)} {two.divide(by: three, rule: RoundingRule.FLOOR)} {one.divide(by: three, places: 2)}")
    var nines: Decimal = 9999999999999999999999999999999999
    var half: Decimal = 0.5
    show(f"carry: {try (nines + half)} {nines.add(you: half, rule: RoundingRule.HALF_UP)} {nines.add(you: half, rule: RoundingRule.FLOOR)}")
    var mid: Decimal = 1234567890123456789012345678901234
    var neg: Decimal = -1234567890123456789012345678901234
    show(f"ties: {mid.add(you: half, rule: RoundingRule.HALF_UP)} {mid.add(you: half, rule: RoundingRule.HALF_EVEN)} {neg.subtract(you: half, rule: RoundingRule.HALF_UP)} {neg.subtract(you: half, rule: RoundingRule.HALF_AWAY)} {neg.subtract(you: half, rule: RoundingRule.HALF_EVEN)}")
    var big: Decimal = 9.999999999999999999999999999999999e6144
    when check big.multiply(by: big)
        is NumericOverflowError as e => show(e.crash_message())
        else => show("fits")
    when check big.add(you: big, rule: RoundingRule.HALF_UP)
        is NumericOverflowError as e => show(e.crash_message())
        else => show("fits")
    show("DONE")
    return
