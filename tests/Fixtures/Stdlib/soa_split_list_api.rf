module Tests/Stdlib/SoaSplitListApi

import BuilderExpansion
import Collections
import IO/Console
# Exercises the growable struct-of-arrays `SplitList[T]` (Standard/RazorForge/Collections/SplitList.rf):
# each field of `Particle` lives in its own `Hijacked[fieldType]` column, grown by reallocation. Drives
# append (past the initial capacity, forcing a grow), get, set, count — proving the decl-position `expand`
# columns + `$typeof(m)` type-arg splices (`hijacked_from[$typeof(m)]`) + `$typeof(m).data_size()` offsets all
# work through a real reallocating collection.

record Particle
obeys Equatable, Splittable
    id: S64
    mass: B32

routine start()
    var s = SplitList[Particle]()
    show(f"empty: count={s.count()} cap={s.capacity()}")

    for i in 0 til 6
        s.add_last(value: Particle(id: i, mass: i.to[B32]() + 0.5))
    show(f"filled: count={s.count()} cap={s.capacity()}")

    # Indexing (ModifyingIndexable): read via `s[i]`, write via `s[i] = value`.
    var p2 = s[2]
    var p5 = s[5]
    show(f"p2: id={p2.id} mass={p2.mass}")
    show(f"p5: id={p5.id} mass={p5.mass}")

    s[2] = Particle(id: 99, mass: 9.5)
    var p2b = s[2]
    show(f"p2 after set: id={p2b.id} mass={p2b.mass}")

    # Iterate: `for` walks the elements, reconstructing each `Particle` from the columns in order.
    var id_sum = 0
    for p in s
        id_sum = id_sum + p.id
    show(f"id_sum={id_sum}")

    # Membership (Container): compares reconstructed elements by value (Particle obeys Equatable).
    var has99 = s.has(value: Particle(id: 99, mass: 9.5))
    var has_missing = s.has(value: Particle(id: 7, mass: 0.0))
    show(f"contains: has99={has99} missing={has_missing}")

    # `s` is an entity — its column buffers + the entity itself are freed by scope-exit teardown.
    show("DONE")
    return
