module Tests/Stdlib/DecimalCompareApi

import IO/Console
# Arbitrary-precision Decimal comparison — Decimal obeys Comparable, so ==, !=, <,
# >, <=, >= are all available (the relational family is generated from cmp/eq).
# Comparison is by decoded parts (never by subtraction), so it does not crash.
routine start()
    var a: Decimal = 3.14159
    var b: Decimal = 2.71828
    var c: Decimal = 3.14159
    var neg: Decimal = -2.5

    show(f"a == c: {a == c}")
    show(f"a == b: {a == b}")
    show(f"a != b: {a != b}")
    show(f"a > b: {a > b}")
    show(f"b < a: {b < a}")
    show(f"a >= c: {a >= c}")
    show(f"a <= c: {a <= c}")
    show(f"neg < b: {neg < b}")
    show(f"neg < a: {neg < a}")

    # Cohort equality: 1.0 and 1.00 are the same value.
    var decimal_1_0: Decimal = 1.0
    var decimal_1_00: Decimal = 1.00
    show(f"1.0 == 1.00: {decimal_1_0 == decimal_1_00}")

    # Zero compares equal regardless of sign.
    var decimal_0_0: Decimal = 0.0
    show(f"0.0 == -0.0: {decimal_0_0 == -decimal_0_0}")

    show("DONE")
    return
