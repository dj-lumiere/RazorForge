module Tests/Stdlib/MaybeParamApi

import IO/Console
# A plain value passed where a `T?` / `Maybe[T]` parameter is expected is present; `none` is absent.

record Point
    x: S64
    y: S64

entity Counter
    total: S64

routine maybe_kind(m: S64?) -> Text
    when m
        is None => return "absent"
        else v => return f"present {v}"

routine maybe_pt(p: Maybe[Point]) -> Text
    when p
        is None => return "no point"
        else q => return f"point {q.x}"

routine maybe_text(t: Text?) -> Text
    when t
        is None => return "no text"
        else s => return s

routine Counter.add(amount: S64?)
    when amount
        is None => pass
        else a => me.total = me.total + a
    return

routine start()
    show(maybe_kind(m: 3))
    show(maybe_kind(m: none))
    var n = 7_s64
    show(maybe_kind(n))
    show(maybe_pt(p: Point(x: 4, y: 5)))
    show(maybe_pt(p: none))
    show(maybe_text(t: "hi"))
    show(maybe_text(t: none))
    var c = Counter(total: 0)
    c.add(amount: 5)
    c.add(amount: none)
    c.add(amount: n)
    show(f"total {c.total}")
    return
