module Tests/Stdlib/TcheckF128Transcendentals

import IO/Console
# Merged per-function softfloat transcendental checks (was tcheck_b128_{exp,sin,...}; consolidated
# post macOS-fix to cut CI time). Each prints represent() of the function at a known input.
routine start()
    var b128_1_0: B128 = 1.0
    show(b128_1_0.exp_unchecked().represent())
    show(b128_1_0.exp2_unchecked().represent())
    show(b128_1_0.sin().represent())
    show(b128_1_0.cos().represent())
    show(b128_1_0.tan().represent())
    show(b128_1_0.sinh_unchecked().represent())
    show(b128_1_0.cosh_unchecked().represent())
    show(b128_1_0.asinh().represent())
    show(b128_1_0.atan().represent())
    var b128_2_0: B128 = 2.0
    show(b128_2_0.sqrt_unchecked().represent())
    show(b128_2_0.cbrt().represent())
    show(b128_2_0.ln_unchecked().represent())
    show(b128_2_0.log2_unchecked().represent())
    return
