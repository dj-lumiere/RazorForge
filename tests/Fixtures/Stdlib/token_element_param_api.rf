module Tests/Stdlib/TokenElementParamApi

import IO/Console
# Through a token on a list of entities, `s[i]` is the element's token, as on a local list: a call on it reads the
# element in place, and `var r = s[i]` holds a token on it. In `for (i, d) in xs.enumerate()` the element token `d`
# ends only when `xs` changes, not when an unrelated local does. A slice is a new list holding nothing of its
# source, so stealing it leaves the source free to grow.

routine size_of(s: Modifying[List[Dict[S32, S32]]], at: U64) -> U64
    return s[at].count()

routine size_through_view(s: Viewing[List[Dict[S32, S32]]]) -> U64
    return s[0].count()

routine put(s: Modifying[List[Dict[S32, S32]]])
    var result = s[0]
    result[7] = 70
    return

routine show_sorted(sets: Viewing[List[Dict[S32, S32]]])
    for (index, set) in sets.enumerate()
        var keys = set.keys()
        keys.sort()
        var line = f"{index}:"
        for key in keys
            line += f" {key}={set[key]}"
        show(line)
    return

routine total(cells: List[S64]) -> S64
    var sum: S64 = 0
    for c in cells
        sum += c
    return sum

routine grow(cells: Modifying[List[S64]])
    cells.add_last(value: 9)
    return

routine start()
    var sets: List[Dict[S32, S32]] = [{2: 20, 1: 10}, {:}]
    show(f"{size_of(s: sets, at: 0)} {size_of(s: sets, at: 1)} {size_through_view(s: sets)}")
    put(s: sets)
    show_sorted(sets)
    var level = [1, 2, 3, 4]
    var first = level[0 til 2]
    var job = total.to[Work](cells: steal first)
    show(f"{job.retrieve()}")
    grow(cells: level.modify())
    show(f"{level}")
    show("DONE")
    return
