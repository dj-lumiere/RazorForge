module Tests/Stdlib/EdgeFloatSpecial

import IO/Console
# IEEE 754 special values: NaN, ±Infinity, signed zero.
routine start()
    var not_a_number: B64 = nan
    var infinity: B64 = inf
    var ninf: B64 = -inf
    var pz: B64 = 0.0
    var nz: B64 = -0.0

    show(f"nan: {not_a_number}")
    show(f"inf: {infinity}")
    show(f"-inf: {ninf}")
    show(f"+0: {pz}")
    show(f"-0: {nz}")

    # NaN propagation (unchecked: arithmetic with NaN yields NaN, not error)
    danger
        show(f"nan + 1: {not_a_number.add_unchecked(you: 1.0)}")
    show(f"nan == nan: {not_a_number == not_a_number}")
    show(f"nan != nan: {not_a_number != not_a_number}")
    show(f"nan.is_nan(): {not_a_number.is_nan()}")
    show(f"1.0.is_nan(): {1.0.is_nan()}")

    # Infinity arithmetic (unchecked: inf+inf=inf, inf-inf=NaN)
    danger
        show(f"inf + inf: {infinity.add_unchecked(you: infinity)}")
        show(f"inf - inf: {infinity.sub_unchecked(you: infinity).is_nan()}")
    danger
        show(f"1.0 / 0.0: {1.0.truediv_unchecked(you: 0.0)}")
        show(f"-1.0 / 0.0: {(-1.0).truediv_unchecked(you: 0.0)}")

    # Signed zero
    show(f"+0 == -0: {pz == nz}")
    danger
        show(f"1.0 / +0: {1.0.truediv_unchecked(you: pz)}")
        show(f"1.0 / -0: {1.0.truediv_unchecked(you: nz)}")

    # An exact zero from x - x or x + (-x) is +0 (round to nearest), and -0 - 0 / -0 + -0 stay -0.
    # B128 is software arithmetic, so it is checked against the hardware B64 rule too.
    var m2: B128 = -2.0
    var d128 = m2 - m2
    show(f"B128 -2 - (-2): {d128} bits={d128.to_bits().hex()}")
    var s128 = m2 + 2.0
    show(f"B128 -2 + 2: {s128} bits={s128.to_bits().hex()}")
    var nz128: B128 = -0.0
    show(f"B128 -0 - 0: {nz128 - 0.0}")
    show(f"B128 -0 + -0: {nz128 + nz128}")
    var m2_64: B64 = -2.0
    show(f"B64 -2 - (-2): {m2_64 - m2_64}")
    show(f"B64 -0 - 0: {nz - pz}")

    show("DONE")
    return
