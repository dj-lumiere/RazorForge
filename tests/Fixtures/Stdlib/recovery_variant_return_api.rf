module Tests/Stdlib/RecoveryVariantReturnApi

import IO/Console
# A failable routine that returns a variant and gives back one of its types directly (`return Deposit(...)`)
# is wrapped into the variant on every path: a direct call, `check`, `try`, and a recovered value kept in a
# `var` all match the right arm. An arm may also name one of the variant's own types (`is Deposit`) on the
# recovered value, or on a variant that holds the variant.
record Deposit
    amount: S64
record Withdraw
    amount: S64
variant Command
    Deposit
    Withdraw

routine parse!(word: Text) -> Command
    if word == "d"
        return Deposit(amount: 5)
    if word == "w"
        return Withdraw(amount: 3)
    throw InvalidValueError(input: word, target: "Command")

routine describe(c: Command) -> Text
    when c
        is Deposit as d =>
            return f"deposit {d.amount}"
        is Withdraw as w =>
            return f"withdraw {w.amount}"

variant Event
    Command
    Text

routine run(word: Text)
    when check parse(word: word)
        is Deposit as d =>
            show(f"check deposit {d.amount}")
        is Withdraw as w =>
            show(f"check withdraw {w.amount}")
        is Crashables as e =>
            show("check bad")
    when try parse(word: word)
        is Withdraw as w =>
            show(f"try withdraw {w.amount}")
        is Deposit =>
            show("try deposit")
        is None =>
            show("try none")
    return

routine show_event(e: Event)
    when e
        is Deposit as d =>
            show(f"event deposit {d.amount}")
        is Withdraw =>
            show("event withdraw")
        is Text as t =>
            show(f"event text {t}")
    return

routine start()
    var a = parse(word: "d")
    show(describe(c: a))
    when check parse(word: "w")
        is Command as c =>
            show(describe(c: c))
        is Crashables as e =>
            show("bad")
    when try parse(word: "d")
        is Command as c =>
            show(describe(c: c))
        is None =>
            show("none")
    var kept = check parse(word: "w")
    when kept
        is Command as c =>
            show(describe(c: c))
        is Crashables as e =>
            show("bad")
    when try parse(word: "x")
        is Command as c =>
            show(describe(c: c))
        is None =>
            show("none")
    run(word: "d")
    run(word: "w")
    run(word: "x")
    var event: Command = Withdraw(amount: 1)
    show_event(e: event)
    show_event(e: "hello")
    return
