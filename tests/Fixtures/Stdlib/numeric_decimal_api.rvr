module Tests/Stdlib/NumericDecimalApi

import IO/Console
# Exercises D32, D64, D128 — IEEE 754 decimal arithmetic (no binary FP rounding).
routine start()
    var d32: D32 = 1.10
    var d64: D64 = 0.1 + 0.2
    var d128: D128 = 1.0 / 3.0

    show(f"D32: {d32}")
    show(f"D64 0.1 + 0.2: {d64}")
    show(f"D128 1/3: {d128}")

    # Comparison & arithmetic
    var d64_0_1: D64 = 0.1
    var d64_0_2: D64 = 0.2
    var d64_0_3: D64 = 0.3
    show(f"D64 0.1 + 0.2 == 0.3: {d64_0_1 + d64_0_2 == d64_0_3}")
    var d64_0_5: D64 = 0.5
    show(f"D64 add: {d64_0_5 + d64_0_5}")
    var d64_2_0: D64 = 2.0
    var d64_3_0: D64 = 3.0
    show(f"D64 mul: {d64_2_0 * d64_3_0}")
    var d64_1_0: D64 = 1.0
    var d64_4_0: D64 = 4.0
    show(f"D64 div: {d64_1_0 / d64_4_0}")

    show("DONE")
    return
