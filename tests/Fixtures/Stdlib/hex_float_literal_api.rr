module Tests/Stdlib/HexFloatLiteralApi

import IO/Console
# Hex float literals (0x1.8p3 = hex mantissa × 2^exponent) on every binary float, stored exactly,
# plus hex integer literals whose digits look like a type suffix (0x1b16, 0xFF_AB).
routine start()
    show(0x1.8p3)
    var b32_0x1pm23: B32 = 0x1p-23
    show(b32_0x1pm23)
    var h: B16 = 0x1.FFCp15
    show(h)
    var b128_value: B128 = 0x1.0000000000000000000000000001p0
    show(b128_value)
    show(0x1.FFFFFFFFFFFFFp1023)
    show(0x1p-1074)
    show(0x1.8p+1 == 3.0)
    var c: C128 = 0x1p-2
    show(c)
    show(0xFF.to_text(radix: 16))
    show(0x1B16)
    show(0xFF_AB)
    var u8_0xff: U8 = 0xFF
    show(u8_0xff)
    var s32_0x7f: S32 = 0x7F
    show(s32_0x7f)
    return
