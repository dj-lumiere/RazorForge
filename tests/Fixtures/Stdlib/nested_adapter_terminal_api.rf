module Tests/Stdlib/NestedAdapterTerminalApi

import IO/Console
import IterTools
# An adapter's terminal (`to[List]`) inside the lambda of another adapter: the outer adapter's step can fail through
# the lambda, so the inner terminal is reached through its recovering form.

routine start()
    var src = [1, 2, 3]
    var ranges = src.select_many(transform: x => (1 to x).select(transform: i => i * 10).to[List]()).to[List]()
    show(f"numbers: {ranges}")
    var words = ["ab", "c"]
    var letters = words.select_many(transform: w => w.select(transform: c => f"{c}!").to[List]()).to[List]()
    show(f"texts: {letters}")
    when try src.select_many(transform: x => (1 to x).select(transform: i => i).to[List]()).to[List]()
        is None => show("try: None")
        else as all => show(f"try: {all}")
    return
