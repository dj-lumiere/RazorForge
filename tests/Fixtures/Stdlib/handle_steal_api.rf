module Tests/Stdlib/HandleStealApi

import IO/Console
# `steal` on the last strong handle takes the entity out: a table filled under one policy is shared again under
# another, and a weak handle sees the entity gone.

entity Table
    values: List[S64]

routine start()
    var shared = Guarded[Table, MultiRead](from: Table(values: List[S64]()))
    using shared.modify() as t
        t.values.add_last(value: 3)
        t.values.add_last(value: 4)
    var table: Table = steal shared
    table.values.add_last(value: 5)
    var frozen = Guarded[Table, ReadOnly](from: steal table)
    show(f"{frozen.values.count()}")
    var r = Retained[Table](from: Table(values: List[S64]()))
    var w = r.observe()
    var plain = steal r
    show(f"{plain.values.count()} {w.is_alive()}")
    show("DONE")
    return
