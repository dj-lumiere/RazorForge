module Tests/Stdlib/B128ParseRoundtrip

import IO/Console
# Regression coverage for the provably-correct Text -> B128 parser: the F512 fast path
# (correctly-rounded for every non-tie input) plus the exact-tie resolution (exp >= 0 is
# exact in F512; exp < 0 with 5^|exp| | coeff uses the exact ldexp path), and the shared
# decimal scanner. All assertions are BIT-EXACT booleans so they are stable regardless of
# how B128.represent formats values.

routine ck(got: B128, want: B128, label: Text)
    show(label + ": " + f"{LLVM::int_eq[U128](a: got.to_bits(), b: want.to_bits())}")
    return

routine start()
    var p112 = (LLVM::shift_left[U128](1, 112)).to[B128]()  # 2^112 (even mantissa)
    var p113 = (LLVM::shift_left[U128](1, 113)).to[B128]()  # 2^113 (even mantissa)
    var p112p2 = p112 + 2.to[B128]()

    # Exact ties must round half-to-even, both directions, both code paths.
    ck(
        got: "5192296858534827628530496329220096.5".to[B128](),
        want: p112,
        label: "tie -1 (ldexp) -> 2^112",
    )
    ck(
        got: "10384593717069655257060992658440193".to[B128](),
        want: p113,
        label: "tie  0 (fast)  -> 2^113",
    )
    ck(
        got: "5192296858534827628530496329220097.5".to[B128](),
        want: p112p2,
        label: "tie -1 odd     -> 2^112+2",
    )

    # 36-significant-digit references round to the exact bits (binary128 round-trip width).
    ck(
        got: "1.41421356237309504880168872420969808".to[B128](),
        want: 2.to[B128]().sqrt_unchecked(),
        label: "sqrt(2) 36-digit",
    )
    ck(
        got: "1.73205080756887729352744634150587237".to[B128](),
        want: 3.to[B128]().sqrt_unchecked(),
        label: "sqrt(3) 36-digit",
    )
    ck(
        got: "0.333333333333333333333333333333333333".to[B128](),
        want: 1.to[B128]() / 3.to[B128](),
        label: "1/3 36-digit",
    )

    # Short numerics (exactly 3 and 8 characters) must SCAN, not throw — regression for the
    # special-value check that used to reject any 3/8-char non-nan/inf input.
    ck(got: "0.5".to[B128](), want: 1.to[B128]() / 2.to[B128](), label: "0.5 (3-char)")
    ck(got: "100".to[B128](), want: 100.to[B128](), label: "100 (3-char)")
    ck(got: "12345678".to[B128](), want: 12345678.to[B128](), label: "12345678 (8-char)")
    ck(got: "1e-300".to[B128](), want: 10.to[B128]() ** (-300).to[B128](), label: "1e-300")

    # Special values parse correctly.
    var vinf = "inf".to[B128]()
    var vninf = "-inf".to[B128]()
    var vnan = "nan".to[B128]()
    show("inf  parses inf: " + f"{vinf.is_infinite()}")
    show("-inf parses neg: " + f"{vninf.is_infinite() and vninf.is_negative()}")
    show("nan  parses nan: " + f"{vnan.is_nan()}")
    return
