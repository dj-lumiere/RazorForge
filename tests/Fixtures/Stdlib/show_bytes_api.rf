module Tests/Stdlib/ShowBytesApi

import IO/Console
# `show(bytes)` writes the bytes raw through `show(value: Bytes)`, not their representable form (`\x61\x62`) through
# `show[T]`: the overload with the parameter type written out takes the call, with `end` left to its default too.

routine start()
    var raw = "ab".encode_as_utf8()
    show(raw)
    show(raw, end: "|\n")
    show("cd".encode_as_utf8())
    show(raw.count())
    show("text")
    show("DONE")
    return
