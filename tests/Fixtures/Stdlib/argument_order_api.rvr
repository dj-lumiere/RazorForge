module Tests/Stdlib/ArgumentOrderApi

import IO/Console
# Arguments, receivers, member variables, f-text holes, operands and tuple items run left to right, also when a
# later one holds `and` / `or`: each line below says which ran, in the order they ran.

record Both
    first: Bool
    second: Bool

record Probe
    label: Text

routine say(text: Text) -> Bool
    show(text)
    return true

routine pair(first: Bool, second: Bool) -> Bool
    return first and second

routine probe(label: Text) -> Probe
    show(label)
    return Probe(label: label)

routine Probe.verify(ok: Bool) -> Bool
    return ok

routine start()
    drop pair(first: say(text: "argument 1"), second: say(text: "argument 2") or say(text: "not run"))
    drop probe(label: "receiver").verify(ok: say(text: "after the receiver") and say(text: "and its right side"))
    var both = Both(first: say(text: "member 1"), second: say(text: "member 2") or say(text: "not run"))
    show(f"{say(text: "hole 1")} {say(text: "hole 2") or say(text: "not run")}")
    var same = say(text: "left operand") == (say(text: "right operand") and say(text: "its right side"))
    var items = (say(text: "item 1"), say(text: "item 2") or say(text: "not run"))
    show(f"{both.first} {same} {items.item0}")
    return
