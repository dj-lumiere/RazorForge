module Tests/Stdlib/CstrDecodeApi

import IO/Console
# CStr.to[Text]() decodes UTF-8, and a malformed sequence becomes one U+FFFD per offending lead byte.
routine codepoints(text: Text) -> Text
    var out = ""
    for c in text
        out = f"{out} {c.codepoint()}"
    return out

routine decode(label: Text, bytes: List[Byte])
    var text = Bytes(from_list: bytes.duplicate()).to[CStr]().to[Text]()
    show(f"{label}: count {text.count()}, code points{codepoints(text: text)}")
    return

routine start()
    var u8_0x41: U8 = 0x41
    var u8_0x42: U8 = 0x42
    decode(label: "ascii", bytes: [Byte(u8_0x41), Byte(u8_0x42)])
    var u8_0xed: U8 = 0xED
    var u8_0x95: U8 = 0x95
    var u8_0x9c: U8 = 0x9C
    decode(label: "korean", bytes: [Byte(u8_0xed), Byte(u8_0x95), Byte(u8_0x9c)])
    var u8_0xf0: U8 = 0xF0
    var u8_0x9f: U8 = 0x9F
    var u8_0x98: U8 = 0x98
    var u8_0x80: U8 = 0x80
    decode(label: "four-byte", bytes: [Byte(u8_0xf0), Byte(u8_0x9f), Byte(u8_0x98), Byte(u8_0x80)])
    decode(label: "stray continuation", bytes: [Byte(u8_0x41), Byte(u8_0x80), Byte(u8_0x42)])
    var u8_0xc0: U8 = 0xC0
    decode(label: "overlong", bytes: [Byte(u8_0xc0), Byte(u8_0x80)])
    var u8_0xa0: U8 = 0xA0
    decode(label: "surrogate", bytes: [Byte(u8_0xed), Byte(u8_0xa0), Byte(u8_0x80)])
    var u8_0xf4: U8 = 0xF4
    var u8_0x90: U8 = 0x90
    decode(label: "past U+10FFFF", bytes: [Byte(u8_0xf4), Byte(u8_0x90), Byte(u8_0x80), Byte(u8_0x80)])
    var u8_0xe2: U8 = 0xE2
    var u8_0x82: U8 = 0x82
    decode(label: "truncated", bytes: [Byte(u8_0x41), Byte(u8_0xe2), Byte(u8_0x82)])
    return
