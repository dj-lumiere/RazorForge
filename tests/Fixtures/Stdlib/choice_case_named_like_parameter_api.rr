module Tests/Stdlib/ChoiceCaseNamedLikeParameterApi

import IO/Console
# A choice case named like a parameter of a standard type (`COUNT` of `Array[T, COUNT]`) does not take the
# parameter's place: the list literal keeps all its elements and `count()` reports them.

choice FunctionName
    SUM
    MIN
    MAX
    AVERAGE
    COUNT

routine start()
    var names = ["SUM", "COUNT", "AVERAGE", "MIN", "MAX"]
    show(f"{names.count()}")
    show(names[0])
    show(names[4])
    var picked: FunctionName = COUNT
    show(f"{picked == FunctionName.COUNT}")
    show("DONE")
    return
