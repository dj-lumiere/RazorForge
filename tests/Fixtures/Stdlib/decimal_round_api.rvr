module Tests/Stdlib/DecimalRoundApi

import IO/Console
# Without `places:`, `Decimal.add_round`, `sub_round`, `mul_round` and `div_round` round the exact result
# once to the nearest 34-significant-digit value under `rule:` (half up when left out) where `+ - *` stop with
# NumericOverflowError. With `places:` they round to that many digits after the point. A result past the Decimal range
# still stops.

routine start()
    var huge: Decimal = 1e30
    var tiny: Decimal = 1e-30
    show(f"sum: {try (huge + tiny)} {huge.add_round(tiny, rule: RoundingRule.HALF_UP)} {huge.add_round(tiny, rule: RoundingRule.CEIL)} {huge.add_round(tiny, places: 2)}")
    show(f"difference: {try (huge - tiny)} {huge.sub_round(tiny)} {huge.sub_round(tiny, rule: RoundingRule.FLOOR)} {huge.sub_round(tiny, places: 2)}")
    var wide: Decimal = 1.23456789012345678901
    show(f"product: {try (wide * wide)} {wide.mul_round(wide)} {wide.mul_round(wide, rule: RoundingRule.FLOOR)} {wide.mul_round(wide, places: 10)}")
    var one: Decimal = 1
    var two: Decimal = 2
    var three: Decimal = 3
    show(f"quotient: {one.div_round(three)} {one.div_round(three, rule: RoundingRule.CEIL)} {two.div_round(three)} {two.div_round(three, rule: RoundingRule.FLOOR)} {one.div_round(three, places: 2)}")
    var nines: Decimal = 9999999999999999999999999999999999
    var half: Decimal = 0.5
    show(f"carry: {try (nines + half)} {nines.add_round(half, rule: RoundingRule.HALF_UP)} {nines.add_round(half, rule: RoundingRule.FLOOR)}")
    var mid: Decimal = 1234567890123456789012345678901234
    var neg: Decimal = -1234567890123456789012345678901234
    show(f"ties: {mid.add_round(half, rule: RoundingRule.HALF_UP)} {mid.add_round(half, rule: RoundingRule.HALF_EVEN)} {neg.sub_round(half, rule: RoundingRule.HALF_UP)} {neg.sub_round(half, rule: RoundingRule.HALF_AWAY)} {neg.sub_round(half, rule: RoundingRule.HALF_EVEN)}")
    var big: Decimal = 9.999999999999999999999999999999999e6144
    when check big.mul_round(big)
        is NumericOverflowError as e => show(e.crash_message())
        else => show("fits")
    when check big.add_round(big, rule: RoundingRule.HALF_UP)
        is NumericOverflowError as e => show(e.crash_message())
        else => show("fits")
    show("DONE")
    return
