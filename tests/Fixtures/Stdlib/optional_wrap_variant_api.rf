module Tests/Stdlib/OptionalWrapVariantApi

# A variant, a choice or a flags value goes into its `T?` the way a record does: at a declaration and at a later
# assignment.
import IO/Console

variant N
    S64
    Text

choice Color
    RED
    BLUE

routine start()
    var v: N = 5
    var m: N? = v
    when m
        is None => show("none")
        else as n =>
            when n
                is S64 as k => show(f"num {k}")
                is Text as t => show(t)
    var c: Color = Color.BLUE
    var oc: Color? = c
    show(f"{oc ?? Color.RED}")
    var later: N? = none
    later = v
    when later
        is None => show("later none")
        else => show("later set")
    return
