module Tests/Stdlib/TupleSerializeApi

import IO/Console
# Tuple `serialize()` — field-walk item0/item1/… into a `Dict[Text, SerialValue]`, via the same
# universal derive template as records/entities. Registered (in GetOrCreateTupleType) only when every
# element is serializable; a generic tuple (`Tuple[U64, T]`) is skipped and cloned per concrete
# instantiation. Nested tuples and mixed element types are covered.

record Point
    x: S32
    y: S32

routine start()
    var s32_1: S32 = 1
    var s32_2: S32 = 2
    var pair = (s32_1, s32_2)
    show(f"{pair.serialize()}")

    var s32_42: S32 = 42
    var mixed = (s32_42, "hi", true)
    show(f"{mixed.serialize()}")

    var s32_3: S32 = 3
    var nested = ((s32_1, s32_2), s32_3)
    show(f"{nested.serialize()}")

    var s32_9: S32 = 9
    var with_record = (Point(x: 7, y: 8), s32_9)
    show(f"{with_record.serialize()}")

    show("DONE")
    return
