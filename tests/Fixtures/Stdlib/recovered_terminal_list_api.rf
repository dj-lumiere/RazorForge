module Tests/Stdlib/RecoveredTerminalListApi

import IO/Console
import IterTools
# A `try` / `check` over a terminal that builds a list (`to[List]()`) and fails partway tears down the list it built,
# with the entities already in it, for each adapter's instance of the terminal. An item a `where` predicate fails on is
# torn down too.

entity Item
    n: S64

routine Item.destruct()
    show(f"destruct {me.n}")
    return

routine start()
    var items = List[Item]()
    items.add_last(value: Item(n: 5))
    items.add_last(value: Item(n: 2))
    items.add_last(value: Item(n: 0))
    show(f"select try: {try items.select(transform: it => Item(n: 10 // it.n)).to[List]()}")
    show(f"select check: {check items.select(transform: it => Item(n: 20 // it.n)).to[List]()}")
    show(f"where try: {try items.select(transform: it => Item(n: it.n + 100)).where(predicate: it => 10 // (it.n - 100) > 0).to[List]()}")
    show("DONE")
    return
