module Tests/Stdlib/PresetBuildtimeApi

import IO/Console
# A preset is computed once, when the program is built: a routine call, arithmetic or a filled-in text becomes the
# value it came to (a number, a Bool, a Text, a Char, or a record, tuple or choice of those), and a preset made by a
# construction is one value everywhere, so an entity preset keeps one identity.

entity Counter
    start: S64

record Pair
    left: S64
    right: Text

choice Mode
    FAST
    SAFE

routine square(n: S64) -> S64
    return n * n

routine pair_of(n: S64) -> Pair
    return Pair(left: square(n: n), right: f"{n}²")

routine pick() -> Mode
    return Mode.SAFE

preset ROOT: B64 = (2.0).sqrt()
preset AREA: S64 = square(n: 12)
preset NAME: Text = f"area {AREA}"
preset BUILT: Pair = pair_of(n: 3)
preset BOTH: (S64, Bool) = (AREA - 44, AREA > 100)
preset MODE: Mode = pick()
preset ONE: Counter = Counter(start: 7)

routine same_counter() -> Bool
    return ONE === ONE

routine start()
    show(f"{ROOT} {AREA} {NAME}")
    show(f"{BUILT} {BOTH} {MODE}")
    show(f"{ONE.start} {same_counter()}")
    show("DONE")
    return
