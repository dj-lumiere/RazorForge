module Tests/Stdlib/AddrApi

import IO/Console
# Addr: an address with no pointee type (LLVM `ptr`).
# Two addresses are compared by identity (`===` / `!==`). An address moves by a ByteSize with `+%` and `-%`, and
# `b -% a` is the distance from `a` to `b`. All three wrap around and check no bounds.
routine start()
    var u64_0x1000: U64 = 0x1000
    var a = u64_0x1000.to[Addr]()
    var u64_0x2000: U64 = 0x2000
    var b = u64_0x2000.to[Addr]()

    show(f"a: {a}")
    show(f"b: {b}")

    # Moving forward and back by a ByteSize
    show(f"a +% 256b: {a +% 256b}")
    show(f"b -% 256b: {b -% 256b}")
    var step = ByteSize(bytes: 16)
    show(f"a +% step * 2: {a +% step * 2}")

    # The distance between two addresses
    var distance = b -% a
    show(f"b -% a in bytes: {distance.byte_size()}")
    show(f"a +% (b -% a) === b: {a +% distance === b}")

    # Wrapping: back past the address 0 and forward again
    show(f"a -% 8192b +% 8192b === a: {a -% 8192b +% 8192b === a}")

    # Identity
    show(f"a === a: {a === a}")
    show(f"a === b: {a === b}")
    show(f"a !== b: {a !== b}")

    # The address 0
    show(f"Addr.hollow().is_hollow(): {Addr.hollow().is_hollow()}")
    show(f"a.is_not_hollow(): {a.is_not_hollow()}")

    show("DONE")
    return
