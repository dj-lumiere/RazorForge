module Tests/Stdlib/AddrApi

import IO/Console
# Addr: an address with no pointee type (LLVM `ptr`).
# Two addresses are compared by identity (`===` / `!==`), an address moves by a signed byte count with
# `offset(bytes:)`, and the distance between two is measured through `to[U64]()`.
routine start()
    var u64_0x1000: U64 = 0x1000
    var a = u64_0x1000.to[Addr]()
    var u64_0x2000: U64 = 0x2000
    var b = u64_0x2000.to[Addr]()

    show(f"a: {a}")
    show(f"b: {b}")

    # Moving: offset(bytes:) forward and back
    show(f"a.offset(bytes: 256): {a.offset(bytes: 256)}")
    show(f"b.offset(bytes: -256): {b.offset(bytes: -256)}")

    # Distance through to[U64]()
    show(f"b - a in bytes: {b.to[U64]() - a.to[U64]()}")

    # Identity
    show(f"a === a: {a === a}")
    show(f"a === b: {a === b}")
    show(f"a !== b: {a !== b}")
    show(f"a.offset(bytes: 0x1000) === b: {a.offset(bytes: 0x1000) === b}")

    # The address 0
    show(f"Addr.hollow().is_hollow(): {Addr.hollow().is_hollow()}")
    show(f"a.is_not_hollow(): {a.is_not_hollow()}")

    show("DONE")
    return
