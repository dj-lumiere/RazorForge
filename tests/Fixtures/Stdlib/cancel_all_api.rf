module Tests/Stdlib/CancelAllApi

# Operations over a `List[Agent[T]]` are member routines on the list: `agents.race()`, `agents.gather()`,
# `agents.cancel_all()`. They work on the list in place (no consume, no hidden steal). This fixture exercises
# a set nobody collects, `gather`, and `cancel_all` (which asks each Agent to stop and waits until each has).

import IO/Console
# Coroutine child: parks `x` ms, then returns x*10.
routine compute(x: S64) -> S64
    waitfor(Duration.from_milliseconds(ms: x))
    return x * 10

# Cooperative worker: spins, polling for cancellation; the moment it is asked to stop it returns -1.
# The bound is a safety ceiling — in practice it exits at the first poll after cancel_all.
routine cancellable() -> S64
    var i = 0_s64
    while i < 1000000000
        if cancellation_requested()
            return -1
        i = i + 1
    return i

# Builds a scope (a plain List), adopts a long-running child, and returns WITHOUT gathering. At this
# routine's return the List is torn down and the un-awaited child is abandoned cleanly — the
# no-orphans guarantee, from ownership alone, no wrapper needed.
routine spawn_and_abandon()
    var agents = List[Agent[S64]]()
    agents.add_last(value: agent compute(x: 100000))
    return

routine start()
    # 1. Abandon-on-exit: the list drops a never-awaited child cleanly.
    spawn_and_abandon()
    show("abandon => ok")

    # 2. gather! over an all-coroutine set: results in input order though the middle one finishes first.
    var coros = List[Agent[S64]]()
    coros.add_last(value: agent compute(x: 30))
    coros.add_last(value: agent compute(x: 5))
    coros.add_last(value: agent compute(x: 15))
    var rs = coros.gather()
    show(f"coros => {rs[0]} {rs[1]} {rs[2]}")

    # 3. cancel_all: two workers spin until asked to stop. cancel_all asks each to stop, then waits until each
    #    has: each observes the request and returns.
    var jobs = List[Agent[S64]]()
    jobs.add_last(value: agent cancellable())
    jobs.add_last(value: agent cancellable())
    jobs[0].start_apart()
    jobs[1].start_apart()
    waitfor(Duration.from_milliseconds(ms: 20))
    jobs.cancel_all()
    show(f"cancel => {jobs[0].is_done()} {jobs[1].is_done()}")
    return
