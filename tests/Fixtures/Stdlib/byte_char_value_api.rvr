module Tests/Stdlib/ByteCharValueApi

import IO/Console
# Byte and Char numbers: named routines, not conversions. A byte is eight bits with bit operations only.
routine start()
    var b = Byte(0xC3)
    show(f"value: {b.value()}")
    show(f"wide: {b.value().to[S64]() + 1000}")
    show(f"and: {(b & 0x0F).value()}")
    show(f"or: {(b | 0x0C).value()}")
    show(f"xor: {(b ^ 0xFF).value()}")
    show(f"not: {(~b).value()}")
    show(f"shl: {(b << 1).value()}")
    show(f"shr: {(b >>> 4).value()}")
    show(f"top bit: {(b & 0x80) == 0x80}")
    var next = Byte(b.value() +% 1)
    show(f"next: {next.value()}")

    var c = 'A'
    show(f"codepoint: {c.codepoint()}")
    show(f"from_codepoint: {Char.from_codepoint(n: 0xD55C)}")
    when try Char.from_codepoint(n: 0xD800)
        is None => show("surrogate: none")
        else as ch => show(f"surrogate: {ch}")
    when try Char.from_codepoint(n: 0x110000)
        is None => show("too big: none")
        else as ch => show(f"too big: {ch}")

    show(f"digit: {'7'.digit_value()}")
    show(f"hex: {'f'.digit_value(base: 16)} {'B'.digit_value(base: 16)}")
    when try 'x'.digit_value()
        is None => show("not a digit: none")
        else as d => show(f"not a digit: {d}")
    when try '9'.digit_value(base: 8)
        is None => show("9 in base 8: none")
        else as d => show(f"9 in base 8: {d}")
    show(f"to_byte: {'A'.to_byte().value()}")
    when try 'é'.to_byte()
        is None => show("non-ascii to_byte: none")
        else as v => show(f"non-ascii to_byte: {v.value()}")
    show(f"hex escapes: {b'\x07'.value()} {b'\x7F'.value()} {b'\\'.value()}")
    show("DONE")
    return
