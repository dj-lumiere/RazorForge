routine run_s256(a: S256, b: S256)
    var p = a.widening_mul(you: b)
    show(f"S256 {a} * {b}: low {p.item0} high {p.item1}")
    return

routine start()
    run_u8(a: U8_MAX, b: U8_MAX)
    run_u8(a: 0, b: U8_MAX)
    run_u8(a: 1, b: U8_MAX)
    run_u8(a: 3, b: 128)
    run_u8(a: 21, b: 177)
    carry_u8(a: U8_MAX, b: U8_MAX, c: U8_MAX)
    carry_u8(a: 0, b: 0, c: U8_MAX)
    carry_u8(a: 1, b: 1, c: 5)
    carry_u8(a: U8_MAX, b: 1, c: U8_MAX)
    carry_u8(a: 128, b: 2, c: 1)
    run_u16(a: U16_MAX, b: U16_MAX)
    run_u16(a: 0, b: U16_MAX)
    run_u16(a: 1, b: U16_MAX)
    run_u16(a: 3, b: 32768)
    run_u16(a: 52501, b: 26801)
    carry_u16(a: U16_MAX, b: U16_MAX, c: U16_MAX)
    carry_u16(a: 0, b: 0, c: U16_MAX)
    carry_u16(a: 1, b: 1, c: 5)
    carry_u16(a: U16_MAX, b: 1, c: U16_MAX)
    carry_u16(a: 32768, b: 2, c: 1)
    run_u32(a: U32_MAX, b: U32_MAX)
    run_u32(a: 0, b: U32_MAX)
    run_u32(a: 1, b: U32_MAX)
    run_u32(a: 3, b: 2147483648)
    run_u32(a: 123456789, b: 987654321)
    carry_u32(a: U32_MAX, b: U32_MAX, c: U32_MAX)
    carry_u32(a: 0, b: 0, c: U32_MAX)
    carry_u32(a: 1, b: 1, c: 5)
    carry_u32(a: U32_MAX, b: 1, c: U32_MAX)
    carry_u32(a: 2147483648, b: 2, c: 1)
    run_u64(a: U64_MAX, b: U64_MAX)
    run_u64(a: 0, b: U64_MAX)
    run_u64(a: 1, b: U64_MAX)
    run_u64(a: 3, b: 9223372036854775808)
    run_u64(a: 123456789, b: 987654321)
    carry_u64(a: U64_MAX, b: U64_MAX, c: U64_MAX)
    carry_u64(a: 0, b: 0, c: U64_MAX)
    carry_u64(a: 1, b: 1, c: 5)
    carry_u64(a: U64_MAX, b: 1, c: U64_MAX)
    carry_u64(a: 9223372036854775808, b: 2, c: 1)
    run_u128(a: U128_MAX, b: U128_MAX)
    run_u128(a: 0, b: U128_MAX)
    run_u128(a: 1, b: U128_MAX)
    run_u128(a: 3, b: 170141183460469231731687303715884105728)
    run_u128(a: 123456789, b: 987654321)
    carry_u128(a: U128_MAX, b: U128_MAX, c: U128_MAX)
    carry_u128(a: 0, b: 0, c: U128_MAX)
    carry_u128(a: 1, b: 1, c: 5)
    carry_u128(a: U128_MAX, b: 1, c: U128_MAX)
    carry_u128(a: 170141183460469231731687303715884105728, b: 2, c: 1)
    run_u256(a: U256_MAX, b: U256_MAX)
    run_u256(a: 0, b: U256_MAX)
    run_u256(a: 1, b: U256_MAX)
    run_u256(a: 3, b: 57896044618658097711785492504343953926634992332820282019728792003956564819968)
    run_u256(a: 123456789, b: 987654321)
    carry_u256(a: U256_MAX, b: U256_MAX, c: U256_MAX)
    carry_u256(a: 0, b: 0, c: U256_MAX)
    carry_u256(a: 1, b: 1, c: 5)
    carry_u256(a: U256_MAX, b: 1, c: U256_MAX)
    carry_u256(a: 57896044618658097711785492504343953926634992332820282019728792003956564819968, b: 2, c: 1)
    run_s8(a: S8_MIN, b: S8_MIN)
    run_s8(a: S8_MIN, b: S8_MAX)
    run_s8(a: S8_MAX, b: S8_MAX)
    run_s8(a: -1, b: 1)
    run_s8(a: -1, b: -1)
    run_s8(a: S8_MIN, b: -1)
    run_s8(a: 7, b: -3)
    run_s8(a: 0, b: S8_MIN)
    run_s16(a: S16_MIN, b: S16_MIN)
    run_s16(a: S16_MIN, b: S16_MAX)
    run_s16(a: S16_MAX, b: S16_MAX)
    run_s16(a: -1, b: 1)
    run_s16(a: -1, b: -1)
    run_s16(a: S16_MIN, b: -1)
    run_s16(a: 7, b: -3)
    run_s16(a: 0, b: S16_MIN)
    run_s32(a: S32_MIN, b: S32_MIN)
    run_s32(a: S32_MIN, b: S32_MAX)
    run_s32(a: S32_MAX, b: S32_MAX)
    run_s32(a: -1, b: 1)
    run_s32(a: -1, b: -1)
    run_s32(a: S32_MIN, b: -1)
    run_s32(a: 7, b: -3)
    run_s32(a: 0, b: S32_MIN)
    run_s64(a: S64_MIN, b: S64_MIN)
    run_s64(a: S64_MIN, b: S64_MAX)
    run_s64(a: S64_MAX, b: S64_MAX)
    run_s64(a: -1, b: 1)
    run_s64(a: -1, b: -1)
    run_s64(a: S64_MIN, b: -1)
    run_s64(a: 7, b: -3)
    run_s64(a: 0, b: S64_MIN)
    run_s128(a: S128_MIN, b: S128_MIN)
    run_s128(a: S128_MIN, b: S128_MAX)
    run_s128(a: S128_MAX, b: S128_MAX)
    run_s128(a: -1, b: 1)
    run_s128(a: -1, b: -1)
    run_s128(a: S128_MIN, b: -1)
    run_s128(a: 7, b: -3)
    run_s128(a: 0, b: S128_MIN)
    run_s256(a: S256_MIN, b: S256_MIN)
    run_s256(a: S256_MIN, b: S256_MAX)
    run_s256(a: S256_MAX, b: S256_MAX)
    run_s256(a: -1, b: 1)
    run_s256(a: -1, b: -1)
    run_s256(a: S256_MIN, b: -1)
    run_s256(a: 7, b: -3)
    run_s256(a: 0, b: S256_MIN)
    show("DONE")
    return
