routine run_s64(a: S64, b: S64)
    var p = a.widening_mul(you: b)
    show(f"S64 {a} * {b}: low {p.item0} high {p.item1}")
    var w = a.mul_wide(you: b)
    show(f"S64 {a} * {b}: wide {w}")
