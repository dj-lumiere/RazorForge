routine run_s8(a: S8, b: S8)
    var p = a.widening_mul(you: b)
    show(f"S8 {a} * {b}: low {p.item0} high {p.item1}")
    var w = a.mul_wide(you: b)
    show(f"S8 {a} * {b}: wide {w}")
    return

routine run_s16(a: S16, b: S16)
    var p = a.widening_mul(you: b)
    show(f"S16 {a} * {b}: low {p.item0} high {p.item1}")
    var w = a.mul_wide(you: b)
    show(f"S16 {a} * {b}: wide {w}")
    return

routine run_s32(a: S32, b: S32)
    var p = a.widening_mul(you: b)
    show(f"S32 {a} * {b}: low {p.item0} high {p.item1}")
    var w = a.mul_wide(you: b)
    show(f"S32 {a} * {b}: wide {w}")
