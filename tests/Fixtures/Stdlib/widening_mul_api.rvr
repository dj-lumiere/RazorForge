module Tests/Stdlib/WideningMulApi

import IO/Console
# Widening multiplication on every width: mul_wide (one double-width value), widening_mul ((low, high)) and
# carrying_mul ((low, high) of the product plus a carry). The expected output was computed beforehand in Python.

routine run_u8(a: U8, b: U8)
    var p = a.widening_mul(you: b)
    show(f"U8 {a} * {b}: low {p.item0} high {p.item1}")
    var w = a.mul_wide(you: b)
    show(f"U8 {a} * {b}: wide {w}")
    return

routine carry_u8(a: U8, b: U8, c: U8)
    var p = a.carrying_mul(you: b, carry: c)
    show(f"U8 {a} * {b} + {c}: low {p.item0} high {p.item1}")
    return

routine run_u16(a: U16, b: U16)
    var p = a.widening_mul(you: b)
    show(f"U16 {a} * {b}: low {p.item0} high {p.item1}")
    var w = a.mul_wide(you: b)
    show(f"U16 {a} * {b}: wide {w}")
    return

routine carry_u16(a: U16, b: U16, c: U16)
    var p = a.carrying_mul(you: b, carry: c)
    show(f"U16 {a} * {b} + {c}: low {p.item0} high {p.item1}")
    return

