routine run_s128(a: S128, b: S128)
    var p = a.widening_mul(you: b)
    show(f"S128 {a} * {b}: low {p.item0} high {p.item1}")
    var w = a.mul_wide(you: b)
    show(f"S128 {a} * {b}: wide {w}")
