module Tests/Stdlib/GenericVariantApi

import IO/Console
# A generic variant: arms written with its parameters (`T`, `List[T]`) are substituted in each instance, each
# instance has its arm constructors, and a `when` over an instance is exhaustive when it names every arm.
record Point
    x: S64
    y: S64

variant Either[L, R]
    L
    R

variant Bag[T]
    None
    List[T]
    T

routine side[L, R](e: Either[L, R]) -> Text
    when e
        is L v => return f"left {v}"
        is R v => return f"right {v}"

routine count(b: Bag[S64]) -> S64
    when b
        is None => return 0
        is List[S64] l => return l.count().S64()
        is S64 v => return 1

routine start()
    show(side(e: Either[S64, Text](from: 7_s64)))
    show(side(e: Either[S64, Text](from: "seven")))
    show(side(e: Either[Point, Text](from: Point(x: 1, y: 2))))
    var l: List[S64] = [1, 2, 3]
    show(count(b: Bag[S64](from: steal l)))
    show(count(b: Bag[S64](from: 9_s64)))
    var empty: Bag[S64] = none
    show(count(b: empty))
    return
