module Tests/Stdlib/RoundingRuleApi

import IO/Console
# A routine that rounds on purpose takes a RoundingRule: `round(places:, rule:)`, `fixed(places, rule:)` and
# `Decimal.divide(by:, places:, rule:)`. Left out, the rule is the type's own: half up for Decimal, a tie to the even
# one for D32, D64 and D128.

routine decimal_rules(x: Decimal) -> Text
    return f"{x}: {x.round(rule: RoundingRule.HALF_UP)} {x.round(rule: RoundingRule.HALF_EVEN)} {x.round(rule: RoundingRule.HALF_AWAY)} {x.round(rule: RoundingRule.FLOOR)} {x.round(rule: RoundingRule.CEIL)} {x.round(rule: RoundingRule.TRUNC)} default {x.round()}"

routine d64_rules(x: D64) -> Text
    return f"{x}: {x.round(rule: RoundingRule.HALF_UP)} {x.round(rule: RoundingRule.HALF_EVEN)} {x.round(rule: RoundingRule.HALF_AWAY)} {x.round(rule: RoundingRule.FLOOR)} {x.round(rule: RoundingRule.CEIL)} {x.round(rule: RoundingRule.TRUNC)} default {x.round()}"

routine start()
    show("Decimal: half up, half even, half away, floor, ceil, trunc")
    show(decimal_rules(x: 2.5))
    show(decimal_rules(x: -2.5))
    show(decimal_rules(x: 2.4))
    show(decimal_rules(x: -2.6))
    show("D64: half up, half even, half away, floor, ceil, trunc")
    show(d64_rules(x: 2.5))
    show(d64_rules(x: -2.5))
    show(d64_rules(x: 2.4))
    show(d64_rules(x: -2.6))

    var price: Decimal = 2.675
    var tie: D64 = 2.665
    show(f"places: {price.round(places: 2)} {price.round(places: 2, rule: RoundingRule.TRUNC)} {tie.round(places: 2)} {tie.round(places: 2, rule: RoundingRule.HALF_UP)}")
    show(f"fixed: {price.fixed(places: 2)} {price.fixed(places: 2, rule: RoundingRule.FLOOR)} {tie.fixed(places: 2)} {tie.fixed(places: 2, rule: RoundingRule.CEIL)}")
    var one: Decimal = 1
    var two: Decimal = 2
    var three: Decimal = 3
    var eight: Decimal = 8
    var ntwo: Decimal = -2
    var mone: Decimal = -1
    show(f"divide: {one.divide(by: three, places: 2)} {two.divide(by: three, places: 2, rule: RoundingRule.FLOOR)} {ntwo.divide(by: three, places: 2)} {one.divide(by: eight, places: 2)} {mone.divide(by: eight, places: 2)} {one.divide(by: eight, places: 2, rule: RoundingRule.HALF_EVEN)}")
    when check one.divide(by: three, places: 40)
        is NumericOverflowError as e => show(e.crash_message())
        else => show("fits")
    var wide: Decimal = 1.23456789012345678901
    show(f"multiply: {try (wide * wide)} {wide.multiply(by: wide, places: 10)}")
    var huge: Decimal = 1e30
    var tiny: Decimal = 1e-30
    show(f"add: {try (huge + tiny)} {huge.add(you: tiny, places: 2)} {huge.add(you: tiny, places: 0, rule: RoundingRule.CEIL)}")
    var p: Decimal = 1.25
    var h: Decimal = 0.5
    var n: Decimal = -1.25
    show(f"rules: {p.multiply(by: h, places: 2)} {p.multiply(by: h, places: 2, rule: RoundingRule.HALF_EVEN)} {n.multiply(by: h, places: 2, rule: RoundingRule.HALF_AWAY)} {n.multiply(by: h, places: 2, rule: RoundingRule.FLOOR)} {tiny.subtract(you: huge, places: 0, rule: RoundingRule.CEIL)} {p.subtract(you: tiny, places: 1, rule: RoundingRule.TRUNC)}")
    show("DONE")
    return
