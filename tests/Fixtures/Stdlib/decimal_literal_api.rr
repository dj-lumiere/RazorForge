module Tests/Stdlib/DecimalLiteralApi

import IO/Console
# Arbitrary-precision Decimal LITERALS (the `dn` suffix). These bake to a buildtime
# i256 BID constant via the managed EncodeDecimal encoder — no runtime from-string call.
# Exercises fraction, large integer (within the 70-digit coefficient), small magnitude,
# scientific notation, negatives, presets, and arithmetic.
routine start()
    var a: Decimal = 3.14159
    var big: Decimal = 1234567890123456789012345678901234567890
    var small: Decimal = 0.001
    var sci: Decimal = 6.02214076e23
    var neg: Decimal = -2.5

    show(f"a: {a}")
    show(f"big: {big}")
    show(f"small: {small}")
    show(f"sci: {sci}")
    show(f"neg: {neg}")

    # Presets (fixed 70-digit constants)
    show(f"PI: {DECIMAL_PI}")
    show(f"E: {DECIMAL_E}")

    # Arithmetic on literals (Decimal obeys the arithmetic protocols)
    show(f"a + small: {a + small}")
    show(f"a - small: {a - small}")
    show(f"neg * neg: {neg * neg}")
    show(f"a / neg: {a / neg}")

    # Every Decimal rounding is half up: x goes to the n with n - 0.5 <= x < n + 0.5 (at the digit kept)
    var up: Decimal = 2.5
    var nhalf: Decimal = -0.5
    var past: Decimal = -2.6
    var m: Decimal = -7.125
    var p: Decimal = 7.125
    show(f"round: {up.round()} {neg.round()} {nhalf.round()} {past.round()} {neg.rint()}")
    show(f"fixed: {p.fixed(places: 2)} {m.fixed(places: 2)} {neg.fixed(places: 0)} {up.fixed(places: 0)}")
    show(f"floor ceil trunc: {neg.floor()} {neg.ceil()} {neg.trunc()}")
    var odd: Decimal = 2000000000000000000000000000000001
    show(f"divide: {odd / 2} {-odd / 2}")
    show(f"text: {"1.0000000000000000000000000000000005".to[Decimal]()} {"-1.0000000000000000000000000000000005".to[Decimal]()}")

    show("DONE")
    return
