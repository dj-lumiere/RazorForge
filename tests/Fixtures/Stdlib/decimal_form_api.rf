module Tests/Stdlib/DecimalFormApi

import IO/Console
# Decimal has one form per value: no -0 (a zero result is +0), and no trailing zeros in the coefficient, so `1.0`
# and `1.00` are the same bits and hash the same. Every rounding is half up, `pow` included, and a negative literal
# with more than 34 digits rounds its tie half up too.
routine start()
    var zero: Decimal = 0
    var nhalf: Decimal = -0.5
    var m1: Decimal = -1
    var nz: Decimal = -0
    show(f"no -0: {nz} {-zero} {zero * m1} {zero / m1} {m1 + 1} {nhalf.round()} {nhalf.fixed(places: 0)}")
    show(f"parsed: {"-0".to[Decimal]()} {"-0.00".to[Decimal]()} {nz.diagnose()} {nz.is_sign_negative()}")
    var small: Decimal = -0.0004
    show(f"fixed of a small negative: {small.fixed(places: 2)} {small.round(places: 2)}")

    var one0: Decimal = 1.0
    var one00: Decimal = 1.00
    var read: Decimal = "1.000".to[Decimal]()
    show(f"one form: {one0.to_bits() == one00.to_bits()} {one0.to_bits() == read.to_bits()} {one0.hash(k0: 1, k1: 2) == one00.hash(k0: 1, k1: 2)}")
    var sum: Decimal = 1.5 + 2.5
    var four: Decimal = 4
    var hundred: Decimal = 100
    var sci: Decimal = 1e2
    show(f"sum: {sum} {sum.to_bits() == four.to_bits()} {hundred} {sci} {hundred.to_bits() == sci.to_bits()} {hundred.diagnose()}")
    var keys = Set[Decimal]()
    drop keys.add(one0)
    drop keys.add(2.50)
    show(f"set: {keys.has(one00)} {keys.has(2.5)} {keys.has(3)}")
    var big: Decimal = 9999999999999999999999999999999999
    var t1: Decimal = 1.50e2
    var t2: Decimal = 12.5e3
    var t3: Decimal = 0.000001
    var t4: Decimal = 0.0000001
    show(f"text: {t1} {big + 1} {t2} {t3} {t4} {t1.diagnose()}")

    var px: Decimal = 1.00000000000000005
    var two: Decimal = 2
    var dx: D128 = 1.00000000000000005
    var dtwo: D128 = 2
    show(f"pow tie: {px.pow(you: two)} {px.powi(n: 2)} D128 to even: {dx.pow(you: dtwo)}")
    var nl: Decimal = -1.0000000000000000000000000000000005
    var pl: Decimal = 1.0000000000000000000000000000000005
    var nl2: Decimal = -2.0000000000000000000000000000000015
    show(f"long literals: {nl} {pl} {nl2}")
    show("DONE")
    return
