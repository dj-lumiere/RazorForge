module Tests/Stdlib/DiagnoseElementsApi

import IO/Console
# diagnose never reads two different values the same: a variant names the member type its value has, and a text
# element is quoted with its escapes, in a container and in a tuple.

routine start()
    var a: S32 | S64 = S32(1)
    var b: S32 | S64 = S64(1)
    show(f"a: {a:?}")
    show(f"b: {b:?}")
    var nums = List[S32 | S64]()
    nums.add_last(value: a)
    nums.add_last(value: b)
    show(f"list of variants: {nums:?}")
    var t: Text | S64 = "x\ny"
    show(f"text member: {t:?}")
    var one = ["a\", \"b"]
    var two = ["a", "b"]
    show(f"one text: {one:?}")
    show(f"two texts: {two:?}")
    var keyed = {"k\"": 2}
    show(f"dict: {keyed:?}")
    show(f"tuple: {("q\\", 1):?}")
    return
