module Tests/Stdlib/StampedApi

import IO/Console
# PoolManager and Stamped[E]: entities of many types live in the pool, and a stamp is a link a member variable or a list
# can keep. `fetch()` gives a write token while the entity is in the pool and fails with StaleStampError once it was
# removed. `remove` takes effect at once but runs no destruct, so a token fetched before still reads. `sweep` runs the
# destructs and frees the slots, a freed slot coming back to the next entity with a newer generation, so the old stamp
# still fails. The pool ends at the end of its scope: every stamp fails first, then each entity left is destructed.

entity Node
    value: S64
    parent: Stamped[Node]?

entity Counted
    hits: S64

routine Counted.destruct()
    show(f"counted ends with {me.hits}")
    return

entity Box[T]
    item: T

routine value_of(s: Stamped[Node]) -> S64
    when try s.fetch()
        is None => return -1
        else as n => return n.value

routine parent_value(n: Modifying[Node]) -> S64
    when n.parent
        is None => return -1
        else as p => return value_of(s: p)

routine start()
    var pool = PoolManager.set_up()
    var s = PoolManager.add(value: Node(value: 1, parent: none))
    var again = s
    show(f"fetch: {value_of(s: s)}, same: {s === again}")
    var m = s.fetch()
    m.value = 10
    show(f"changed through the stamp: {s.fetch().value}")

    var child = PoolManager.add(value: Node(value: 2, parent: s))
    show(f"parent: {parent_value(n: child.fetch())}")

    # A stamp is a value: a list keeps it, and it names the same entity wherever it is.
    var kept = List[Stamped[Node]]()
    kept.add_last(value: s)
    show(f"in a list: {value_of(s: kept[0])}")

    # The entity is removed: its stamps fail at once, and a token fetched before still reads.
    PoolManager.remove(s)
    show(f"after remove: {value_of(s: s)}, in the list: {value_of(s: kept[0])}, token: {m.value}")
    show(f"the child's parent: {parent_value(n: child.fetch())}")
    PoolManager.sweep()

    # The freed slot goes to the next entity of its type, a generation later.
    var u = PoolManager.add(value: Node(value: 3, parent: none))
    show(f"new: {value_of(s: u)}, old: {value_of(s: s)}, different: {u !== s}")

    # A written destruct runs on sweep, once.
    var w = PoolManager.add(value: Counted(hits: 0))
    w.fetch().hits = 4
    PoolManager.remove(w)
    show("counted removed")
    PoolManager.sweep()
    when try w.fetch()
        is None => show("counted: stale")
        else => show("counted: alive")

    # A generic entity, and a second Counted that the pool ends.
    var bs = PoolManager.add(value: Box[S64](item: 7))
    show(f"box: {bs.fetch().item}")
    var last = PoolManager.add(value: Counted(hits: 9))
    show("DONE")
    return
