module Tests/Stdlib/FileStorageApi

import IO/Console
import IO/Environment
import IO/Errors
import IO/File

# Writes one cell through a write token: the routine changes the storage in place.
routine stamp(storage: Modifying[FileStorage[Byte]], at: U64, value: Byte)
    storage[at] = value
    return

# A file seen as cells: a storage is mapped by the block that opens it (`viewing` for reading only, `modifying` for
# writing) and unmapped at the block's end. Bytes read and written in place, a window of the file, Unicode scalars in
# four-byte cells, and the failures an index past the end, a cell that isn't a scalar and a missing file give.
routine start()
    var root = Environment.temp_directory().go_to(name: "rf_fixture_file_storage_api")
    if FileManager.exists(at: root)
        FileManager.delete_all(at: root)
    drop FileManager.make_directory(at: root, parents: true)

    var f = FileManager.make_file(at: root.file(name: "cells.bin"))
    FileManager.write_text(at: f, content: "abcdef")
    viewing FileManager.storage[Byte](at: f) as v
        show(f"count: {v.count()}")
        show(f"first: {v[0].value()}")
        show(f"past the end: {try v[6]}")
    modifying FileManager.storage[Byte](at: f) as m
        m[0] = b'A'
        stamp(storage: m, at: 5, value: b'F')
    show(f"written: {FileManager.read_text(at: f)}")

    viewing FileManager.storage[Byte](at: f, start: 2, count: 10) as window
        show(f"window: {window.count()} {window[0].value()}")

    var g = FileManager.make_file(at: root.file(name: "letters.utf32"))
    FileManager.set_size(at: g, bytes: 12)
    modifying FileManager.storage[Char](at: g) as m
        m[0] = 'h'
        m[1] = 'é'
        m[2] = '한'
    viewing FileManager.storage[Char](at: g) as letters
        show(f"letters: {letters.count()} {letters[0]}{letters[1]}{letters[2]}")
    show(f"utf-32 size: {FileManager.size(at: g)}")

    var bad = FileManager.make_file(at: root.file(name: "bad.utf32"))
    FileManager.write_text(at: bad, content: "ÿFFÿFFÿFFÿFF")
    viewing FileManager.storage[Char](at: bad) as broken
        when check broken[0]
            is Char => show("bad cell: read")
            is InvalidValueError => show("bad cell: InvalidValueError")

    try viewing FileManager.storage[Byte](at: root.file(name: "missing.bin")) as missing
        when missing
            is None => show("missing: none")
            else as cells => show(f"missing: opened {cells.count()}")

    FileManager.delete_all(at: root)
    return
