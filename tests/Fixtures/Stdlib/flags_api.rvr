module Tests/Stdlib/FlagsApi

import IO/Console
flags Permission
    READ
    WRITE
    EXECUTE

# Every member says which bit it is, or none does.
flags Mode
    LOW: 3
    HIGH: 0

routine start()
    # Single flag
    var single = Permission.EXECUTE
    show(f"single: {single}")
    show(f"single (diagnose): {single:?}")

    # Combination
    var rw = Permission.READ and Permission.WRITE
    show(f"rw: {rw}")
    show(f"rw (diagnose): {rw:?}")

    var all = Permission.READ and Permission.WRITE and Permission.EXECUTE
    show(f"all: {all}")
    show(f"all (diagnose): {all:?}")

    # Equality
    show(f"rw == READ and WRITE: {rw == (Permission.READ and Permission.WRITE)}")
    show(f"rw == READ: {rw == Permission.READ}")
    show(f"rw have WRITE: {rw.has(WRITE)}")
    show(f"rw lack EXECUTE: {rw.lacks(EXECUTE)}")
    show(f"(rw have READ and WRITE) or rw have EXECUTE: {(rw.has(READ and WRITE)) or rw.has(EXECUTE)}")
    show(f"all == rw: {all == rw}")
    show(f"all have rw: {all.has(rw)}")
    show(f"all without WRITE: {all.without(WRITE)}")
    show(f"all without READ and EXECUTE: {all.without(READ and EXECUTE)}")
    show(f"rw without rw: {rw.without(rw)}")

    # Members with written bits
    var mode = Mode.LOW and Mode.HIGH
    show(f"mode bits: {mode.to[U64]()}")
    show(f"LOW bits: {Mode.LOW.to[U64]()}")
    show(f"mode: {mode}")
    show(f"mode without HIGH has LOW: {mode.without(HIGH).has(LOW)}")

    show("DONE")
    return
