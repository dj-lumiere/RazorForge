module Tests/Stdlib/UfEngineBits

import IO/Console
# Exact-output regression lock for the B128 / D128 / D64 transcendentals (once the consumers of the
# retired UnpackedFloat soft-float engine, now correctly rounded fast paths over the 384-bit tier). B128
# prints raw bits so a one-ulp drift fails.
