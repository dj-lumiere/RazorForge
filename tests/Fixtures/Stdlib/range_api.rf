module Tests/Stdlib/RangeApi

import IO/Console
# Range expressions: `to` (inclusive) and `til` (exclusive), with optional `by`.
routine print_range(label: Text, r: Emittable[S64])
    var out = f"{label}: "
    for x in r
        out = out + f"{x} "
    show(out)
    return

routine start()
    # Inclusive ascending
    print_range(label: "1 to 5", r: 1 to 5)
    # Inclusive descending
    print_range(label: "5 to 1", r: 5 to 1 by -1)
    # Exclusive ascending
    print_range(label: "1 til 5", r: 1 til 5)
    # Exclusive descending
    print_range(label: "5 til 1", r: 5 til 1 by -1)

    # With step
    print_range(label: "1 to 10 by 2", r: 1 to 10 by 2)
    print_range(label: "1 til 10 by 2", r: 1 til 10 by 2)
    print_range(label: "10 to 1 by 2", r: 10 to 1 by -2)
    print_range(label: "10 til 1 by 2", r: 10 til 1 by -2)

    # Single-element range
    print_range(label: "5 to 5", r: 5 to 5)
    # Empty range
    print_range(label: "5 til 5", r: 5 til 5)

    # Sum via IterTools
    var s = 0
    for x in 1 to 100
        s = s + x
    show(f"sum 1..100: {s}")

    # counting down to the unsigned type's lowest value stops there instead of stepping below it
    var down = ""
    var u64_3: U64 = 3
    var u64_0: U64 = 0
    for u in u64_3 to u64_0 by -1
        down = down + f"{u} "
    show(f"3 to 0 (U64): {down}")

    # a range only counts down when its step says so: `2 to 1` is empty
    print_range(label: "2 to 1", r: 2 to 1)
    show(f"2 to 1 have 1: {(2 to 1).has(1)}")
    show(f"10 to 0 by -2 have 4: {(10 to 0 by -2).has(4)}")

    # a range reaching the ends of its type runs every pass and stops there: the distance to the end may not
    # fit in the type, and the step is never taken past it
    var passes: S64 = 0
    for i in S64_MAX to S64_MIN by -1
        passes = passes + 1
        if passes == 3
            break
    show(f"S64_MAX to S64_MIN by -1: {passes} passes")
    var tops: S64 = 0
    for i in (S64_MAX - 2) to S64_MAX
        tops = tops + 1
    var bottoms: S64 = 0
    for i in (S64_MIN + 2) to S64_MIN by -1
        bottoms = bottoms + 1
    var wide: S64 = 0
    for i in S64_MIN to S64_MAX by S64_MAX
        wide = wide + 1
    show(f"ends: {tops} {bottoms} {wide}")
    show(f"has at the ends: {(S64_MIN to S64_MAX).has(S64_MAX)} {(S64_MAX to S64_MIN by -1).has(S64_MIN)} {(S64_MIN to S64_MAX by 2).has(S64_MAX)}")

    # A walk whose end leaves room for one more step compares with the last value a step still fits from, and one
    # whose end does not measures how far the end still is: both stop at the same place.
    print_range(label: "-10 til -1 by 3", r: -10 til -1 by 3)
    print_range(label: "-5 to -1 by 2", r: -5 to -1 by 2)
    print_range(label: "-3 to 3", r: -3 to 3)
    print_range(label: "5 to 3 by -4", r: 5 to 3 by -4)
    print_range(label: "3 to -3 by -2", r: 3 to -3 by -2)
    print_range(label: "-1 to -9 by -4", r: -1 to -9 by -4)
    var u8_0: U8 = 0
    var u8_1: U8 = 1
    var u8_250: U8 = 250
    var u8_254: U8 = 254
    var u8_255: U8 = 255
    var bytes = ""
    for b in u8_0 to u8_255 by 255
        bytes = bytes + f"{b} "
    bytes = bytes + "| "
    for b in u8_250 to u8_255 by 3
        bytes = bytes + f"{b} "
    bytes = bytes + "| "
    for b in u8_255 to u8_1 by -200
        bytes = bytes + f"{b} "
    bytes = bytes + "| "
    for b in u8_255 to u8_254 by -100
        bytes = bytes + f"{b} "
    show(f"U8 ends: {bytes}")
    var whole = ""
    for n in 10.to[Int]() to 0.to[Int]() by -3
        whole = whole + f"{n} "
    for n in -2.to[Int]() til 2.to[Int]()
        whole = whole + f"{n} "
    show(f"Int: {whole}")

    show("DONE")
    return
