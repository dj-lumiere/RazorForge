module Tests/Stdlib/LanguageGapsApi

import IO/Console
import Collections

record Point
    x: S64
    y: S64

common routine Point.origin() -> Me
    return Me(x: 0, y: 0)

record Version
obeys Comparable
    major: S64
    minor: S64

routine total(values...: S64) -> S64
    var sum: S64 = 0
    each v in values
        sum += v
    return sum

routine start()
    # A local routine value is called by its name.
    var add = (a: S64, b: S64) => a + b
    show(add(a: 2, b: 3))

    # A variadic routine takes no values too.
    show(total())
    show(total(1, 2, 3))

    # `Me(...)` builds the type the routine is on.
    show(Point.origin())

    # A record that obeys Comparable compares member by member.
    var a = Version(major: 1, minor: 2)
    var b = Version(major: 1, minor: 3)
    show(a <=> b)
    show(a < b)

    # A bit array is written as a literal.
    var bits: BitArray[4] = [true, false, true, false]
    show(bits)

    # An element `each` hands out is assigned as its value.
    var best: S64 = 0
    each item in [3, 9, 4]
        if item > best
            best = item
    show(best)

    # Collections are read back from their serialized form.
    var d = Dict[S64, Text]()
    d[1] = "one"
    d[2] = "two"
    var d2 = d.serialize().to[Dict[S64, Text]]()
    show(d2[2])
    var s = Set[S64]()
    drop s.add(7)
    show(s.serialize().to[Set[S64]]().has(7))
    var sd = SortedDict[Text, S64]()
    sd["z"] = 26
    show(sd.serialize().to[SortedDict[Text, S64]]()["z"])
    var bad = try d.serialize().to[Dict[S64, S64]]()
    when bad
        is None => show("not a dictionary of numbers")
        else => show("read back")
    return
