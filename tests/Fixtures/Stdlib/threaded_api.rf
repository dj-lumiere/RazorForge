module Tests/Stdlib/ThreadedApi

import BuilderQuery
import IO/Console
# Record return — exercises by-value aggregate handoff across the thread boundary.
record Point
    x: S64
    y: S64

# `f.to[Work](...)` makes a Work[T] over a plain routine and `retrieve()` waits for its value. A Work
# with a deadline (`.waitfor(d)`) that nothing started runs on an OS thread of its own (`start_apart()`),
# and `try …retrieve()` gives Optional[T] (None when the deadline passes).

routine compute(x: S64, y: S64) -> S64
    return x * y + 1

routine make_point(a: S64, b: S64) -> Point
    return Point(x: a, y: b)

routine excessive_compute(a: S64) -> S64
    each i in 0 til 1000000000000000  # Magic big number to guarantee failure
        a *%= i
    return a

routine start()
    # 1. make the Work, hold the handle, then retrieve (starts it with start_now()).
    var t = compute.to[Work](x: 6, y: 7)
    var r = t.retrieve()
    show(f"compute => {r}")

    # 2. make and retrieve in one expression.
    var r2 = compute.to[Work](x: 2, y: 5).retrieve()
    show(f"fused => {r2}")

    # 3. record result.
    var p = make_point.to[Work](a: 3, b: 4).retrieve()
    show(f"point => x={p.x} y={p.y}")

    # 4. bounded wait via the recovering form — `retrieve()` throws on timeout, whereas
    #    `try …retrieve()` yields Optional[T] (None on timeout). Generous window -> the value.
    var r3 = try compute.to[Work](x: 3, y: 4).waitfor(5s).retrieve()
    when r3
        is None => show("within => none")
        is S64 as v => show(f"within => {v}")

    var r4 = try excessive_compute.to[Work](a: 1).waitfor(500ms).retrieve()
    when r4
        is None => show("within => none")
        is S64 as v => show(f"within => {v}")

    return
