module Tests/Stdlib/DropTeardownApi

import IO/Console
# `drop` tears down the entity a call hands over when the statement ends, and `for (k, v) in d.items()` walks pairs.

entity Node
    value: S64

@override
routine Node.destruct()
    show(f"gone {me.value}")
    return

routine start()
    var d = Dict[S64, S64]()
    d[1] = 10
    d[2] = 20
    var total = 0
    for (k, v) in d.items()
        total += k * v
    show(f"{total}")
    var xs = List[Node]()
    xs.add_last(value: Node(value: 1))
    xs.add_last(value: Node(value: 2))
    drop xs.remove_at(index: 0)
    show("after drop")
    return
