module Tests/Stdlib/OptionalHandleCopyApi

import IO/Console

entity Node
    value: S64
    left: Retained[Node]?

routine start()
    # Copying an absent Optional of a handle copies nothing inside it.
    var x = Retained(from: Node(value: 9, left: none))
    var empty: Retained[Node]? = none
    x.left = empty
    show(f"absent copied: {x.left}")

    # A present one gains one more holder.
    var child: Retained[Node]? = Retained(from: Node(value: 1, left: none))
    x.left = child
    when child
        is None => show("child: none")
        else as c => show(f"child holders: {c.strong_count()}")
    show("DONE")
    return
