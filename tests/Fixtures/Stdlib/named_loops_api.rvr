module Tests/Stdlib/NamedLoopsApi
import IO/Console

routine find_pair(grid: Viewing[List[List[S64]]], target: S64) -> S64
    var found = -1
    for y in 0 til 3 as rows
        for x in 0 til 3
            if grid[y][x] == target
                found = y * 10 + x
                break to rows
        then
            show(f"row {y} done")
    then
        show("rows over")
    return found

routine skip_rows() -> S64
    var total = 0
    for y in 0 til 4 as rows
        for x in 0 til 4 as cols
            if x == 2
                continue to rows
            if y == 3
                break to cols
            total += 1
        then
            show(f"inner then {y}")
        total += 100
    return total

routine carried() -> S64
    for y in 0 til 5 as rows with sum: S64 = 0
        for x in 0 til 5
            if x == 1
                continue to rows with sum: sum + 10
        continue with sum: sum + 1000
    then
        return sum

routine start()
    var g = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    show(find_pair(grid: g.view(), target: 5))
    show(find_pair(grid: g.view(), target: 99))
    show(skip_rows())
    show(carried())
    return
