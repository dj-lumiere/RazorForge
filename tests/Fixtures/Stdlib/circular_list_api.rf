module Tests/Stdlib/CircularListApi

import Collections
import IO/Console
routine start()
    var dq = CircularList[S64]()
    show(f"new size: {dq.count()}")
    show(f"is_empty: {dq.is_empty()}")

    dq.add_last(value: 10)
    dq.add_last(value: 20)
    dq.add_first(value: 0)
    show(f"after add_last 10/20 + add_first 0, size: {dq.count()}")

    # peek
    show(f"first: {dq.first()}")
    show(f"last: {dq.last()}")

    # iteration in order
    each x in dq
        show(f"  iter: {x}")

    # remove_first
    discard dq.remove_first()
    show(f"first after remove_first: {dq.first()}")
    show(f"size: {dq.count()}")

    # rotation with free slots in the buffer (3 elements, room for more): the free slots stay out
    var ring = CircularList[S64]()
    ring.add_last(value: 1)
    ring.add_last(value: 2)
    ring.add_last(value: 3)
    ring.rotate_left(n: 1)
    show(f"rotate_left: {ring}")
    ring.rotate_right(n: 2)
    show(f"rotate_right: {ring}")

    show("DONE")
    return
