module Tests/Stdlib/EachCompoundApi

import IO/Console
# A compound assignment reads the token an `each` loop binds, like the binary form does.

routine start()
    var xs = List[S64]()
    xs.add_last(value: 3)
    xs.add_last(value: 4)
    var total = 0
    each x in xs
        total += x
    var other = 0
    each x in xs
        other = other + x
    show(f"{total} {other}")
    show("DONE")
    return
