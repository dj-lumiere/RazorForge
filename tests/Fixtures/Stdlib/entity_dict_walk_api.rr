module Tests/Stdlib/EntityDictWalkApi

import IO/Console
# `for (k, v) in d` over a Dict whose values are entities: `v` reaches the entity the Dict keeps, so the walk ends
# nothing and the Dict ends each value once, at its own end.

entity Box
    n: S64

routine Box.destruct()
    show(f"ends {me.n}")
    return

routine start()
    var boxes: Dict[S64, Box] = {:}
    for i in 1 to 3
        boxes[i] = Box(n: i * 10)
    var sum: S64 = 0
    for (k, b) in boxes
        sum += k * b.n
    show(sum)
    for (_, b) in boxes
        b.n += 1
    for entry in boxes
        sum += entry.item1.n
    show(sum)
    var names: Dict[S64, Text] = {1: "one", 2: "two"}
    for (k, t) in names
        show(f"{k}={t}")
    show("done")
    return
