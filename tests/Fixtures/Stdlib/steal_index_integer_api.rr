module Tests/Stdlib/StealIndexIntegerApi

import IO/Console

# `steal xs[i] as t` takes its index like an ordinary subscript: any integer type works, not only the one the
# container's own element routines take.
entity Box
    n: S64

routine start()
    var xs = List[Optional[Box]]()
    xs.add_last(value: Box(n: 1))
    xs.add_last(value: Box(n: 2))
    var signed: S64 = 1
    steal xs[signed] as second
    show(f"second present {second.is_present()}")
    show(f"slot now present {xs[signed].is_present()}")
    var narrow: U8 = 0
    steal xs[narrow] as first
    show(f"first present {first.is_present()}")
    var unsigned: U64 = 0
    steal xs[unsigned] as again
    show(f"again present {again.is_present()}")
    show("DONE")
    return
