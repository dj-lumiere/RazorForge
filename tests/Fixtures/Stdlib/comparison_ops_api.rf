module Tests/Stdlib/ComparisonOpsApi

import IO/Console
# Builder-generated lt/le/gt/ge from cmp on types that obey Comparable.
record Score
obeys Comparable
    value: S64

@readonly
routine Score.eq(you: Score) -> Bool
    return me.value == you.value

# Score auto-derives Equatable/Hashable; we expose cmp manually so lt/le/gt/ge
# can be derived from it.
@readonly
routine Score.cmp(you: Score) -> ComparisonSign
    if me.value < you.value
        return ComparisonSign.ME_SMALL
    if me.value > you.value
        return ComparisonSign.ME_LARGE
    return ComparisonSign.SAME

routine start()
    var a = Score(value: 10)
    var b = Score(value: 20)
    var c = Score(value: 10)

    show(f"a < b: {a < b}")
    show(f"a <= b: {a <= b}")
    show(f"a == c: {a == c}")
    show(f"a != b: {a != b}")
    show(f"a >= c: {a >= c}")
    show(f"b > a: {b > a}")

    # Numeric chain
    show(f"1 < 2 < 3: {1 < 2 and 2 < 3}")
    show(f"max chain: {3.max(you: 7).max(you: 5)}")

    # Text ordering
    show(f"'abc' < 'abd': {"abc" < "abd"}")
    show(f"'abc' < 'abcd': {"abc" < "abcd"}")
    show(f"'A' < 'a': {"A" < "a"}")

    show("DONE")
    return
