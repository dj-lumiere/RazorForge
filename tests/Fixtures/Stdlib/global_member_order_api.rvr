module Tests/Stdlib/GlobalMemberOrderApi

import IO/Console
# A global whose value comes from a member routine is made after the globals that routine reads, however the call
# reaches it: through another global, `me`, a type's own routine or a value made in place.

record Box
    n: S64

routine Box.plus_base() -> S64
    return me.n + me.base_part()

routine Box.base_part() -> S64
    return order_base

routine Box.scaled(by: S64) -> S64
    return by * order_scale

routine Box.zero() -> Box
    return Box(n: order_offset)

routine make_base() -> S64
    return 100

global order_holder: Box = Box(n: 1)
global order_total: S64 = order_holder.plus_base()
global order_made: S64 = Box(n: 2).scaled(by: 3)
global order_box: Box = Box.zero()
global order_base: S64 = make_base()
global order_scale: S64 = 7
global order_offset: S64 = 5

routine start()
    show(order_total)
    show(order_made)
    show(order_box.n)
    return
