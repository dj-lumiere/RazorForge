module Tests/Stdlib/RealDivideByZeroApi

import IO/Console
import Numerics.[Real]
# Real division by zero crashes like every other number type: a nonzero value over zero throws
# DivisionByZeroError, 0 / 0 throws NumericDomainError, and `try` / `grab` recover both. The same
# holds for `divide`, for a reciprocal written as 1 / x, and for 0 ** -n.
routine start()
    var zero = Real()
    var one = Real.one()
    var seven = Real(from: 7_s64)
    var two = Real(from: 2_s64)

    show("-- nonzero / 0 --")
    when grab seven / zero
        is DivisionByZeroError e => show(f"7 / 0: {e.crash_title()}")
        is Crashables e => show(f"7 / 0 other: {e.crash_title()}")
        else v => show(f"7 / 0 unexpected: {v}")
    when grab Real(from: -7_s64) / zero
        is DivisionByZeroError e => show(f"-7 / 0: {e.crash_title()}")
        is Crashables e => show(f"-7 / 0 other: {e.crash_title()}")
        else v => show(f"-7 / 0 unexpected: {v}")
    show(f"try 7 / 0: {try seven / zero}")
    show(f"7 / 2 still works: {seven / two}")

    show("-- 0 / 0 --")
    when grab zero / zero
        is NumericDomainError e => show(f"0 / 0: {e.crash_title()}")
        is Crashables e => show(f"0 / 0 other: {e.crash_title()}")
        else v => show(f"0 / 0 unexpected: {v}")
    show(f"try 0 / 0: {try zero / zero}")
    show(f"0 / 7: {zero / seven}")

    show("-- divide(precision) --")
    when grab one.divide(you: zero, precision: 20_s32)
        is DivisionByZeroError e => show(f"divide 1 by 0: {e.crash_title()}")
        is Crashables e => show(f"divide 1 by 0 other: {e.crash_title()}")
        else v => show(f"divide 1 by 0 unexpected: {v}")
    when grab zero.divide(you: zero, precision: 20_s32)
        is NumericDomainError e => show(f"divide 0 by 0: {e.crash_title()}")
        is Crashables e => show(f"divide 0 by 0 other: {e.crash_title()}")
        else v => show(f"divide 0 by 0 unexpected: {v}")

    show("-- reciprocal 1 / 0 --")
    when grab one / zero
        is DivisionByZeroError e => show(f"1 / 0: {e.crash_title()}")
        is Crashables e => show(f"1 / 0 other: {e.crash_title()}")
        else v => show(f"1 / 0 unexpected: {v}")
    show(f"1 / 2: {one / two}")

    show("-- zero base, negative exponent --")
    when grab zero ** Real(from: -2_s64)
        is DivisionByZeroError e => show(f"0 ** -2: {e.crash_title()}")
        is Crashables e => show(f"0 ** -2 other: {e.crash_title()}")
        else v => show(f"0 ** -2 unexpected: {v}")
    when grab zero.pow(exp: Real(from: -1_s64), precision: 20_s32)
        is DivisionByZeroError e => show(f"0 pow -1 (20): {e.crash_title()}")
        is Crashables e => show(f"0 pow -1 (20) other: {e.crash_title()}")
        else v => show(f"0 pow -1 (20) unexpected: {v}")
    show(f"0 ** 2: {zero ** two}")
    show(f"0 ** 0: {zero ** zero}")

    show("DONE")
    return
