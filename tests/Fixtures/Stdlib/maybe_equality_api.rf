module Tests/Stdlib/MaybeEqualityApi

import IO/Console
# `Maybe[T]` compares and hashes by what it holds: two absent ones are equal, an absent and a present one differ,
# two present ones compare their values. A record with an optional member variable so gets `==` and a hash.

record Slot
    item: S64?

routine start()
    show(f"both present, equal: {Slot(item: 1) == Slot(item: 1)}")
    show(f"both present, different: {Slot(item: 1) == Slot(item: 2)}")
    show(f"one absent: {Slot(item: 1) == Slot(item: none)}")
    show(f"both absent: {Slot(item: none) == Slot(item: none)}")
    var slots = Set[Slot]()
    drop slots.add(value: Slot(item: 1))
    drop slots.add(value: Slot(item: 1))
    drop slots.add(value: Slot(item: none))
    drop slots.add(value: Slot(item: none))
    show(f"slots in set: {slots.count()}")
    show(f"absent found: {slots.has(value: Slot(item: none))}")
    return
