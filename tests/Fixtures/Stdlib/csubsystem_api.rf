module Tests/Stdlib/CSubsystemApi

import BuilderQuery
import IO/Console
# Platform-INDEPENDENT surface of the C FFI scalar/string wrappers. Every value here fits BOTH data
# models (CLong/CULong ≤ 2^31-1, CWChar ≤ 0xFFFF), so the observable output is identical on Windows
# (LLP64) and Unix (LP64). The platform-DIVERGENT behavior (widths, overflow at the 32-/16-bit
# boundary, supplementary code units) is covered by the OS-keyed CFfiPlatformWidthTests instead.

# Builds a 3-element (+ null) wide C string from BMP code units, allocating a fresh buffer whose
# element stride matches the platform's wchar_t width.
routine make_wstr(a: U32, b: U32, c: U32) -> CWStrView
    danger
        var elem = CWChar.data_size().byte_size()
        var nbytes = 4 * elem
        var raw = Hijacked[Byte](from: C::rf_allocate_dynamic(nbytes))
        var buf = raw.recast_as[CWChar]()
        buf.stride(count: 0).poke(value: a.to[CWChar]())
        buf.stride(count: 1).poke(value: b.to[CWChar]())
        buf.stride(count: 2).poke(value: c.to[CWChar]())
        var u32_0: U32 = 0
        buf.stride(count: 3).poke(value: u32_0.to[CWChar]())
        return CWStrView(from_ptr: buf)

routine start()
    # ----- CLong -----
    var la = 100.to[CLong]()
    var lb = 100.to[CLong]()
    var lc = 250.to[CLong]()
    show(f"CLong repr={la} diag={la.diagnose()}")
    show(f"CLong eq={la.eq(you: lb)} ne={la.eq(you: lc)} cmp_lt={la.cmp(you: lc)} cmp_eq={la.cmp(you: lb)}")
    show(f"CLong hash_eq={la.hash(k0: 0, k1: 0) == lb.hash(k0: 0, k1: 0)}")

    # ----- CULong -----
    var u64_4000: U64 = 4000
    var ua = u64_4000.to[CULong]()
    var ub = u64_4000.to[CULong]()
    var u64_9000: U64 = 9000
    var uc = u64_9000.to[CULong]()
    show(f"CULong repr={ua} diag={ua.diagnose()}")
    show(f"CULong eq={ua.eq(you: ub)} cmp_lt={ua.cmp(you: uc)} cmp_gt={uc.cmp(you: ua)}")
    show(f"CULong hash_eq={ua.hash(k0: 0, k1: 0) == ub.hash(k0: 0, k1: 0)}")

    # ----- CWChar (BMP: 'A'=65, euro sign U+20AC=8364) -----
    var u32_65: U32 = 65
    var wa = u32_65.to[CWChar]()
    var wb = u32_65.to[CWChar]()
    var u32_8364: U32 = 8364
    var we = u32_8364.to[CWChar]()
    show(f"CWChar repr={wa} cp={wa.codepoint()} diag={wa.diagnose()}")
    show(f"CWChar euro repr={we} cp={we.codepoint()}")
    show(f"CWChar eq={wa.eq(you: wb)} cmp_lt={wa.cmp(you: we)}")

    # ----- CWStrView (BMP wide strings) -----
    var s = make_wstr(a: 72, b: 105, c: 33)  # "Hi!"
    var s2 = make_wstr(a: 72, b: 105, c: 33)  # "Hi!"
    var s3 = make_wstr(a: 72, b: 105, c: 63)  # "Hi?"
    show(f"CWStrView count={s.count()} is_null={s.is_null()} is_empty={s.is_empty()}")
    show(f"CWStrView eq={s.eq(you: s2)} ne={s.eq(you: s3)} cmp_lt={s.cmp(you: s3)}")
    show(f"CWStrView null is_null={CWStrView.null().is_null()} is_empty={CWStrView.null().is_empty()}")
    danger
        show(f"CWStrView get0={s.getitem(index: 0).codepoint()} get2={s.getitem(index: 2).codepoint()}")
        var tail = s.offset(n: 1)
        show(f"CWStrView offset1 count={tail.count()} get0={tail.getitem(index: 0).codepoint()}")

    show("DONE")
    return
