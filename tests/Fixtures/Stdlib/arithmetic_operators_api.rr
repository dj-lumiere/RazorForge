module Tests/Stdlib/ArithmeticOperatorsApi

import IO/Console
# The four arithmetic-overflow modes, exercised on S64/U64:
#   +   checked  — throws IntegerOverflowError on overflow
#   +!  unchecked — UB on overflow (LLVM nsw/nuw); ONLY in-range case tested
#   +%  wrapping — defined as mod 2^N
#   +^  clamping — saturate at type bounds
# Same family applies to -, *, **. Unary - is always checked-throw.
# Stdlib provides `add!`/`sub!`/`mul!`/`pow!` whose `try_*`/`check_*` variants
# expose the carrier without wrapping the operators manually.

routine start()
    # --- In-range: all four agree ---
    show("--- in-range ---")
    show(f"100 + 50 (checked): {100 + 50}")
    danger
        show(f"100 +! 50 (unchecked): {100 +! 50}")
    show(f"100 +% 50 (wrap): {100 +% 50}")
    show(f"100 +^ 50 (clamp): {100 +^ 50}")

    # --- Overflow: differs per mode ---
    show("--- overflow ---")

    # checked: catch via stdlib try_add
    show(f"try_add S64_MAX + 1: {try S64_MAX.add(1)}")

    # wrap: S64_MAX + 1 = S64_MIN
    show(f"S64_MAX +% 1: {S64_MAX +% 1}")

    # clamp: S64_MAX + 1 = S64_MAX
    show(f"S64_MAX +^ 1: {S64_MAX +^ 1}")

    # unchecked: NOT tested under overflow (UB)
    show("S64_MAX +! 1 not exercised — undefined behavior")

    # --- Underflow ---
    show("--- underflow ---")
    show(f"try_sub S64_MIN - 1: {try S64_MIN.sub(1)}")
    show(f"S64_MIN -% 1: {S64_MIN -% 1}")
    show(f"S64_MIN -^ 1: {S64_MIN -^ 1}")

    # --- Multiplication overflow ---
    show("--- mul overflow ---")
    show(f"try_mul S64_MAX * 2: {try S64_MAX.mul(2)}")
    show(f"S64_MAX *% 2: {S64_MAX *% 2}")
    show(f"S64_MAX *^ 2: {S64_MAX *^ 2}")

    # --- Exponent overflow ---
    show("--- pow overflow ---")
    show(f"try_pow 2 ** 62: {try 2.pow(62)}")
    show(f"try_pow 2 ** 63 (overflow): {try 2.pow(63)}")

    # --- Unary -: always checked-throw ---
    show("--- unary - ---")
    show(f"-(5): {-(5)}")
    show(f"-(-5): {-(-5)}")

    # --- U64 underflow (unsigned) ---
    show("--- U64 underflow ---")
    var u64_0: U64 = 0
    var u64_1: U64 = 1
    show(f"try_sub 0u64 - 1: {try u64_0.sub(u64_1)}")
    show(f"0u64 -% 1: {u64_0 -% u64_1}")
    show(f"0u64 -^ 1: {u64_0 -^ u64_1}")

    # --- All four agree on benign U64 cases ---
    show("--- U64 in-range ---")
    var u64_10: U64 = 10
    var u64_3: U64 = 3
    show(f"10u64 + 3: {u64_10 + u64_3}")
    show(f"10u64 +% 3: {u64_10 +% u64_3}")
    show(f"10u64 +^ 3: {u64_10 +^ u64_3}")

    show("DONE")
    return
