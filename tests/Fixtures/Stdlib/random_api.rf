module Tests/Stdlib/RandomApi

import Collections
# Random stdlib module — end-to-end smoke test for the xoshiro256** generator and its
# Sized-powered collection helpers. Exercises make_random (splitmix64 seeding), next_u64
# determinism, next_b64 range, chance() distribution, pick! across List + CircularList (the
# ModifyingIndexable extension), and in-place Fisher-Yates shuffle. All draws use fixed seeds
# so the output is fully deterministic.

import IO/Console
import Random
### All failable draws (pick!, indexing) live here so the `!` calls propagate naturally;
### returns a deterministic checksum so the fixture output is stable.
failable routine run_demo() -> S64
    # Determinism: same seed replays the same 64-bit stream.
    var a = make_random(seed: 12345)
    var b = make_random(seed: 12345)
    var same = true
    var i: U64 = 0
    until i >= 8
        if a.next_u64() != b.next_u64()
            same = false
        i = i +% 1
    show(f"same-seed streams match: {same}")

    # next_b64 stays in the half-open unit interval.
    var d = make_random(seed: 7)
    var in_range = true
    var j: U64 = 0
    until j >= 1000
        var x = d.next_b64()
        if x < 0.0 or x >= 1.0
            in_range = false
        j = j +% 1
    show(f"1000 b64 draws all in [0,1): {in_range}")

    # chance(0.5) over 10000 trials — deterministic count for this seed.
    var e = make_random(seed: 2024)
    var heads: U64 = 0
    var k: U64 = 0
    until k >= 10000
        if e.chance(probability: 0.5)
            heads = heads +% 1
        k = k +% 1
    show(f"heads out of 10000: {heads}")

    # pick! generalizes across ModifyingIndexable collections (List and CircularList here).
    var r = make_random(seed: 42)
    var lst = List[S64]()
    var dq = CircularList[S64]()
    var f = 0
    until f >= 6
        lst.add_last(value: f)
        dq.add_last(value: f)
        f = f + 1
    var lv = lst.pick(rng: r.modify())
    var dv = dq.pick(rng: r.modify())
    show(f"List pick in [0,6): {lv >= 0 and lv < 6}")
    show(f"CircularList pick in [0,6): {dv >= 0 and dv < 6}")

    # shuffle moves elements in place; the multiset is preserved (sum invariant) and
    # the count is unchanged.
    lst.shuffle(rng: r.modify())
    var total = 0
    var m: U64 = 0
    until m >= lst.count()
        total = total + lst[m]
        m = m +% 1
    show(f"count after shuffle: {lst.count()}")
    show(f"sum after shuffle: {total}")
    return total

routine start()
    when try run_demo()
        is None => show("demo produced no value")
        else as result => show(f"demo checksum: {result}")
    return
