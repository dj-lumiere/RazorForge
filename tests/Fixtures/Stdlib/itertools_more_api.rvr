module Tests/Stdlib/EmitterToolsMoreApi

import IO/Console
import EmitterTools
# EmitterTools coverage round 2 — select_chained, min_by/max_by, exclude, count(predicate),
# first_or_default, last_or_default.
routine start()
    var src: List[S64] = [1, 2, 3, 4, 5]

    # select_chained — flatten by mapping each element to a sub-sequence
    var fanned = src.select_chained[S64, List[S64]](transform: x => (1 to x).to[List]()).to[List]()
    show(f"select_chained 1..x: {fanned}")

    # min_by / max_by — select key
    var words: List[Text] = ["pear", "fig", "banana", "kiwi"]
    show(f"min by length: {words.min_by[U64](selector: w => w.count())}")
    show(f"max by length: {words.max_by[U64](selector: w => w.count())}")

    # exclude — set-style difference
    var a: List[S64] = [1, 2, 3, 4, 5]
    var b: List[S64] = [2, 4]
    show(f"exclude: {a.exclude(you: b).to[List]()}")

    # get_count(predicate)
    show(f"count > 3: {src.get_count(predicate: x => x > 3)}")
    show(f"count even: {src.get_count(predicate: x => x % 2 == 0)}")

    # first_or_default / last_or_default
    var empty: List[S64] = []
    show(f"first_or_default empty: {empty.first_or_default(default: -1)}")
    show(f"first_or_default src: {src.first_or_default(default: -1)}")
    show(f"last_or_default empty: {empty.last_or_default(default: -1)}")
    show(f"last_or_default src: {src.last_or_default(default: -1)}")

    # accumulate as fold
    var product = src.accumulate[S64](start: 1, combiner: (acc, x) => acc * x)
    show(f"product 1..5: {product}")

    show("DONE")
    return
