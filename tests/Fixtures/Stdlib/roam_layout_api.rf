module Tests/Stdlib/RoamLayoutApi

import BuilderQuery
import IO/Console
# Ingrid's Roamed runtime (Ingrid/tessera/roam.tess) reads a RoamManager[T] through its own RoamHeader record, so
# the two layouts must agree field for field. This compares every member variable's offset with Ingrid's.

entity Probe
    value: S64

routine start()
    var fields = RoamManager[Probe].member_variable_info()
    var mismatches = 0
    var i: U64 = 0
    each f in fields
        var ingrid = C::ingrid_roam_field_offset(i: i)
        if ingrid != f.offset
            show(f"{f.name}: RazorForge {f.offset}, Ingrid {ingrid}")
            mismatches = mismatches + 1
        i = i + 1
    if C::ingrid_roam_field_offset(i: i) != U64_MAX
        show("Ingrid's RoamHeader has more fields than RoamManager")
        mismatches = mismatches + 1
    show(f"fields: {i}, mismatches: {mismatches}")
    return
