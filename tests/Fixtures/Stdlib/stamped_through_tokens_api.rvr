module Tests/Stdlib/StampedThroughTokensApi

import IO/Console
# Stamps reached through tokens: `fetch()` through a read token on a list of stamps, a field write through the
# token a `fetch()` gives (it has no source in the loop element), a loop element handed where a `Stamped[T]?` is
# wanted, and stamps whose type is inferred (`var at = PoolManager.add(...)`, `[...]`).

entity Creature
    x: S64
    y: S64
    parent: Stamped[Creature]?

routine total(stamps: Viewing[List[Stamped[Creature]]]) -> S64
    var sum: S64 = 0
    for at in stamps
        sum += at.fetch().x
    return sum

routine nudge(stamps: Modifying[List[Stamped[Creature]]])
    for at in stamps
        var c = at.fetch()
        c.y = 5
        c.x = c.y + 2
    return

routine fetched_x(at: Stamped[Creature]) -> S64
    when try at.fetch()
        is None => return -2
        else as live => return live.x

routine parent_x(c: Modifying[Creature]) -> S64
    when c.parent
        is None => return -1
        else as p => return fetched_x(at: p)

entity Pin
    n: S64

routine start()
    var pool = PoolManager.set_up()
    var a = PoolManager.add(value: Creature(x: 1, y: 1, parent: none))
    var b = PoolManager.add(value: Creature(x: 3, y: 1, parent: none))
    var stamps = [a, b]
    show(total(stamps: stamps))
    nudge(stamps: stamps)
    show(f"{a.fetch().x} {a.fetch().y} {b.fetch().x}")
    var kids = List[Creature]()
    for at in stamps
        kids.add_last(value: Creature(x: 0, y: 0, parent: at))
    for kid in kids
        show(parent_x(c: kid))
    var at = PoolManager.add(value: Pin(n: 9))
    var more = [at]
    when try at.fetch()
        is None => show("stale")
        else as live => show(f"live {live.n}")
    PoolManager.remove(at)
    when try more[0].fetch()
        is None => show("stale")
        else as live => show(f"live {live.n}")
    return
