module Tests/Stdlib/BitListApi

import Collections
import IO/Console
routine start()
    var bl = BitList()
    show(f"new size: {bl.count()}")
    show(f"is_empty: {bl.is_empty()}")

    bl.add_last(value: true)
    bl.add_last(value: false)
    bl.add_last(value: true)
    show(f"after add_last(t,f,t), size: {bl.count()}")
    show(f"bl[0]: {bl[0]}")
    show(f"bl[1]: {bl[1]}")
    show(f"bl[2]: {bl[2]}")

    show(f"first_true: {bl.first_true()}  next_true(after: 0): {bl.next_true(after: 0)}  first_false: {bl.first_false()}")
    when try bl.next_false(after: 1)
        is None => show("next_false(after: 1): none")
        else as at => show(f"next_false(after: 1): {at}")
    show("DONE")
    return
