module Tests/Stdlib/EntityOptionalStealApi

import IO/Console

# A local entity handed to a constructor's `Node?` field with `steal` leaves its slot empty, so reassigning the local
# and ending the routine ends each node exactly once.

entity Node
    value: S64
    left: Node?
    right: Node?

routine chain_of(length: S64) -> Node
    var chain = Node(value: 0, left: none, right: none)
    var i: S64 = 1
    until i >= length
        var next = Node(value: i, left: steal chain, right: none)
        chain = steal next
        i += 1
    return chain

routine depth(node: Viewing[Node]) -> S64
    var n: S64 = 1
    when node.left
        is None => nothing
        else as c => n += depth(node: c)
    return n

routine start()
    var root = chain_of(length: 5)
    show(root.value)
    show(depth(node: root.view()))
    return
