module Tests/Stdlib/TupleSwapApi

import IO/Console
# `(a, b) = (b, a)` swaps places: locals, three in a rotation, member variables, and entities, whose owners stay the
# same.

record Pair
    left: S64
    right: S64

entity Node
    name: Text

routine start()
    var a = 1
    var b = 2
    (a, b) = (b, a)
    show(f"{a} {b}")
    var x = "x"
    var y = "y"
    var z = "z"
    (x, y, z) = (z, x, y)
    show(f"{x} {y} {z}")
    var p = Pair(left: 10, right: 20)
    (p.left, p.right) = (p.right, p.left)
    show(f"{p.left} {p.right}")
    var n = Node(name: "first")
    var m = Node(name: "second")
    (n, m) = (m, n)
    show(f"{n.name} {m.name}")
    show("DONE")
    return
