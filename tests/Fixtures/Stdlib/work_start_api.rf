module Tests/Stdlib/WorkStartApi

import IO/Console

# `f.to[Work](...)` computes the arguments now and defers the call into a Work. A verb chooses where it runs:
# start_now() on the pool of threads, start_here() on this thread beside its other start_here() jobs,
# start_apart() on a thread of its own. retrieve() starts a Work nothing started with start_now().

record Pair
    a: S64
    b: S64

routine Pair.sum() -> S64
    return me.a + me.b

routine Pair.twice() -> Pair
    return Pair(a: me.a * 2, b: me.b * 2)

routine add(a: S64, b: S64) -> S64
    return a + b

routine bump(cell: Atomic[S64], times: S64)
    each i in 0 til times
        drop cell.fetch_add(delta: 1)
    return

failable routine checked(n: S64) -> S64
    if n < 0
        throw VerificationFailedError()
    return n

routine relay(n: S64) -> S64
    return checked(n: n)

routine slow(n: S64) -> S64
    var i = 0
    until i >= 2000
        if cancellation_requested()
            return -1
        waitfor(1ms)
        i += 1
    return n

routine start()
    var now = add.to[Work](a: 1, b: 2)
    now.start_now()
    show(f"now: {now.retrieve()}")

    var here = add.to[Work](a: 3, b: 4)
    here.start_here()
    show(f"here: {here.retrieve()}")

    var apart = add.to[Work](a: 5, b: 6)
    apart.start_apart()
    show(f"apart: {apart.retrieve()}")

    # Nothing started it: retrieve() starts it with start_now().
    var waiting = add.to[Work](a: 7, b: 8)
    show(f"waiting: {waiting.retrieve()}")

    # The arguments are computed when the job is made, not when it runs.
    var x = 40
    var early = add.to[Work](a: x, b: 2)
    x = 0
    show(f"arguments now: {early.retrieve()}")

    # A receiver that is a value is computed now too: only the routine converted runs as the work.
    var p = Pair(a: 2, b: 3)
    show(f"member: {p.sum.to[Work]().retrieve()}")
    show(f"chain: {p.twice().sum.to[Work]().retrieve()}")

    # An Atomic is shared with the work, never copied.
    var counter = Atomic[S64](initial: 0)
    var jobs = [bump.to[Work](cell: counter, times: 1000), bump.to[Work](cell: counter, times: 1000),
        bump.to[Work](cell: counter, times: 1000)]
    drop jobs.gather()
    show(f"atomic: {counter.load()}")

    # A failure stays in the work and is recovered where the Work is collected.
    var failing = checked.to[Work](n: -1)
    show(f"try retrieve: {try failing.retrieve()}")
    var fine = checked.to[Work](n: 5)
    show(f"try retrieve ok: {try fine.retrieve()}")

    # A Work starts once.
    var twice = add.to[Work](a: 1, b: 1)
    twice.start_now()
    when check twice.start_here()
        is WorkStartError as e => show(f"second start: {e.crash_message()}")
        else => show("second start: ran")
    drop twice.retrieve()

    # A deadline needs a thread of its own: a fiber cannot be given up on while it runs.
    var fiber = add.to[Work](a: 2, b: 2)
    fiber.start_now()
    when check fiber.waitfor(deadline: 5s).retrieve()
        is WorkStartError => show("deadline on a fiber: refused")
        else => show("deadline on a fiber: ran")
    drop fiber.retrieve()

    # A failure inside the work stays in its Work: it surfaces where the Work is retrieved, and the others go on.
    var bad = relay.to[Work](n: -1)
    var good = relay.to[Work](n: 3)
    bad.start_now()
    good.start_now()
    show(f"good: {good.retrieve()}")
    when check bad.retrieve()
        is S64 as v => show(f"bad: {v}")
        is Crashables as e => show(f"bad failed: {e.crash_message()}")

    # cancel(): running work stops at its next wait, work nothing started never runs, and retrieving either is
    # CancelRequested.
    var running = slow.to[Work](n: 1)
    running.start_now()
    running.cancel()
    when check running.retrieve()
        is CancelRequested => show("running: cancelled")
        else => show("running: other")
    var idle = slow.to[Work](n: 2)
    idle.cancel()
    when check idle.retrieve()
        is CancelRequested => show("waiting: cancelled")
        else => show("waiting: other")
    var set = [slow.to[Work](n: 3), slow.to[Work](n: 4)]
    set[0].start_now()
    set.cancel_all()
    show("cancel_all: wound down")
    show("DONE")
    return
