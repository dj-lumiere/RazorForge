module Tests/Stdlib/TupleReprApi

import IO/Console
# Tuple `represent()`/`diagnose()` — the SPECIAL tuple format via the `is TupleType` derive
# templates: represent `(v0, v1)` (no type name / field names), diagnose `Module.Tuple[…](v0, v1)`
# (qualified type name prefixed; elements still render via `represent`).

routine start()
    var s32_1: S32 = 1
    var s32_2: S32 = 2
    var pair = (s32_1, s32_2)
    show(pair.represent())
    show(f"{pair.diagnose()}")

    var s32_42: S32 = 42
    var mixed = (s32_42, "hi", true)
    show(mixed.represent())
    show(f"{mixed.diagnose()}")

    var s32_3: S32 = 3
    var nested = ((s32_1, s32_2), s32_3)
    show(nested.represent())

    show("DONE")
    return
