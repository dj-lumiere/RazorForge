module Tests/Stdlib/F128ExpSubnormalEdge

import IO/Console

# B128 exp at the bottom of the subnormal range: inputs within 3 bit patterns of ln(t) for the targets below. Near
# 2^-16495 the accurate retry can land one binade lower, so the result rounds from the top significand bit
# alone (a 128-bit shift by 128 before the fix). Raw bits are printed; the expected values are mpmath's exp
# rounded to nearest-even binary128.

routine start()
    show(f"exp = 2^-16495, bits -3: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF31_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits -2: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF32_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits -1: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF33_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits +0: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF34_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits +1: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF35_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits +2: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF36_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits +3: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF37_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits -3: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96271_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits -2: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96272_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits -1: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96273_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits +0: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96274_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits +1: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96275_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits +2: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96276_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits +3: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96277_u128).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits -3: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A9488_u128).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits -2: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A9489_u128).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits -1: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948A_u128).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits +0: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948B_u128).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits +1: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948C_u128).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits +2: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948D_u128).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits +3: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948E_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits -3: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B0_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits -2: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B1_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits -1: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B2_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits +0: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B3_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits +1: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B4_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits +2: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B5_u128).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits +3: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B6_u128).exp_unchecked().to_bits()}")
    return
