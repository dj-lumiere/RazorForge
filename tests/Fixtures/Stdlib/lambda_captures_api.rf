module Tests/Stdlib/LambdaCapturesApi

import IO/Console
import IterTools
# Lambdas capture surrounding bindings — verifies the closure machinery used by
# IterTools `where`/`select`/etc. with non-trivial bodies.

routine make_adder(n: S64) -> Routine[(S64,), S64]
    return x given n => x + n

# A lambda passed to a Routine parameter takes its parameter types from it, also when another argument is a
# bare literal or the arguments are named out of order.
routine twice(f: Routine[(S64,), S64], x: S64) -> S64
    return f(f(x))

routine apply(x: S64, f: Routine[(S64,), S64]) -> S64
    return f(x)

routine start()
    # Simple capture
    var add5 = make_adder(n: 5)
    show(f"add5(10): {add5(10_s64)}")
    show(f"add5(-3): {add5(-3_s64)}")

    # Capture used in IterTools chain
    var threshold = 4_s64
    var src: List[S64] = [1, 2, 3, 4, 5, 6, 7, 8]
    var above = src.where(predicate: x given threshold => x > threshold).List()
    show(f"above {threshold}: {above}")

    # Mutating capture target (via `given` for explicit capture binding)
    var sum = 0_s64
    each x in src
        sum = sum + x
    show(f"sum via for: {sum}")

    # Capture in select with arithmetic
    var scale = 3_s64
    var scaled = src.select(transform: x given scale => x * scale).List()
    show(f"scaled by {scale}: {scaled}")

    # Lambda parameters typed by the Routine parameter
    show(f"twice +1 from 2: {twice(f: y => y + 1, x: 2)}")
    show(f"apply *10 to 4: {apply(f: y => y * 10, x: 4)}")
    show(f"twice -1 from 5: {twice(x: 5, f: y => y - 1)}")

    show("DONE")
    return
