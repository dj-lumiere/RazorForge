module Tests/Stdlib/IdentityOperatorApi

import IO/Console
# Reference identity (=== / !==): "same object?", distinct from value equality (==).
# Valid on entities and the handles that reach one (Retained, Tracked, Guarded, Witnessed, Roamed, Watched,
# Hijacked). The access tokens (Viewing, Modifying) and value types are RF-S440.
# It is a primitive pointer compare — not overloadable, never lowered to `.eq()`.

entity Node
    value: S32

routine start()
    var a = Node(value: 1)
    var b = Node(value: 1)

    # Same binding = same object; two distinct entities (even with equal fields) = different objects.
    show(f"a === a: {a === a}")
    show(f"a === b: {a === b}")
    show(f"a !== b: {a !== b}")
    show(f"a !== a: {a !== a}")

    # Handles: two Roamed handles to two entities differ, and so do their Watched observers (a struct with the
    # manager's address inside).
    var ra = Roamed[Node](from: Node(value: 2))
    var rb = Roamed[Node](from: Node(value: 2))
    var wa = ra.watch()
    var wb = rb.watch()
    show(f"ra === rb: {ra === rb}  wa === wb: {wa === wb}  wa !== wb: {wa !== wb}")
    danger
        var ha = a.hijack()
        var hb = ha
        show(f"ha === hb: {ha === hb}")

    show("DONE")
    return
