module Tests/Stdlib/AddressApi

import IO/Console
# Address: integer-valued pointer-sized address.
# Pointer arithmetic uses Address ± ByteSize → Address; Address − Address → ByteSize.
# Multiplication and division have no meaningful semantics on addresses and are
# intentionally not provided.
routine start()
    var u64_0x1000: U64 = 0x1000
    var a = u64_0x1000.to[Address]()
    var u64_0x2000: U64 = 0x2000
    var b = u64_0x2000.to[Address]()
    var offset = ByteSize(bytes: 0x100)

    show(f"a: {a}")
    show(f"b: {b}")
    show(f"offset: {offset}")

    # Pointer arithmetic: Address ± ByteSize → Address
    show(f"a + offset: {a + offset}")
    show(f"b - offset: {b - offset}")

    # Address − Address → ByteSize (byte-distance)
    show(f"b - a: {b - a}")

    # Comparison
    show(f"a == a: {a == a}")
    show(f"a < b: {a < b}")
    show(f"a > b: {a > b}")
    show(f"max(a, b): {a.max(you: b)}")
    show(f"min(a, b): {a.min(you: b)}")

    show("DONE")
    return
