module Tests/Stdlib/EntityTreeEqualityApi

import IO/Console
# The builder's `==` on entities holding entities compares them member by member, down the whole tree, and two
# different entities with equal contents are `==` and not `===`.

entity Leaf
    name: Text

entity Branch
    name: Text
    leaves: List[Leaf]

routine tree(leaf_name: Text) -> Branch
    var leaves = List[Leaf]()
    leaves.add_last(value: Leaf(name: "a"))
    leaves.add_last(value: Leaf(name: leaf_name))
    return Branch(name: "root", leaves: leaves)

routine start()
    var first = tree(leaf_name: "b")
    var second = tree(leaf_name: "b")
    var third = tree(leaf_name: "c")
    show(f"equal trees: {first == second}")
    show(f"other leaf: {first == third}")
    show(f"same tree: {first === first}")
    return
