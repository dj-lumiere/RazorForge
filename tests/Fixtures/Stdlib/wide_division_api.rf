module Tests/Stdlib/WideDivisionApi

import IO/Console
# U128 / S128 division (Knuth division underneath `//` and `%`) over deterministic LCG cases: single-limb and
# multi-limb divisors (U128) and all four sign combinations, the remainder never negative (S128). Each result folds
# into a checksum, and the expected checksums were computed beforehand in Python, so nothing here divides through a
# raw 128-bit LLVM divide.

routine fold(acc: U128, v: U128) -> U128
    return acc *% 1099511628211 +% v

routine start()
    var s: U64 = 0x2545F4914F6CDD1D
    var uq: U128 = 0
    var ur: U128 = 0
    var sq: U128 = 0
    var sr: U128 = 0
    var i = 0
    while i < 50000
        s = s *% 6364136223846793005 +% 1442695040888963407
        var ah = s
        s = s *% 6364136223846793005 +% 1442695040888963407
        var al = s
        s = s *% 6364136223846793005 +% 1442695040888963407
        var bh = s
        s = s *% 6364136223846793005 +% 1442695040888963407
        var bl = s
        # half the time use a single-limb divisor
        if LLVM::int_eq[U64](a: LLVM::bit_and[U64](a: s, b: 1), b: 0)
            bh = 0
        if LLVM::int_eq[U64](a: LLVM::bit_or[U64](a: bh, b: bl), b: 0)
            bl = 1
        var au = LLVM::bit_or[U128](
            a: LLVM::shift_left[U128](LLVM::zero_extend[U64, U128](ah), 64),
            b: LLVM::zero_extend[U64, U128](al),
        )
        var bu = LLVM::bit_or[U128](
            a: LLVM::shift_left[U128](LLVM::zero_extend[U64, U128](bh), 64),
            b: LLVM::zero_extend[U64, U128](bl),
        )
        uq = fold(acc: uq, v: au // bu)
        ur = fold(acc: ur, v: au % bu)
        var asg = LLVM::reinterpret_bits[U128, S128](au)
        var bsg = LLVM::reinterpret_bits[U128, S128](bu)
        sq = fold(acc: sq, v: LLVM::reinterpret_bits[S128, U128](asg // bsg))
        sr = fold(acc: sr, v: LLVM::reinterpret_bits[S128, U128](asg % bsg))
        i = i + 1
    show(f"U128 // checksum: {uq}")
    show(f"U128 % checksum: {ur}")
    show(f"S128 // checksum: {sq}")
    show(f"S128 % checksum: {sr}")
    return
