module Tests/Stdlib/NoneCompareApi

import IO/Console

# `x == none` and `x != none` ask whether any `T?` is absent: a tuple, a record, a text, a list, inside a generic routine.

record Pt
    x: S32

routine absent[T](value: T?) -> Bool
    return value == none

routine present[T](value: T?) -> Bool
    return value != none

routine pick(flag: Bool) -> (Text, Text)?
    if flag
        return ("a", "b")
    return none

routine start()
    var pair: (Text, Text)? = pick(flag: true)
    var missing: (Text, Text)? = pick(flag: false)
    show(f"pair != none: {pair != none}")
    show(f"pair == none: {pair == none}")
    show(f"missing != none: {missing != none}")
    show(f"missing == none: {missing == none}")

    var a: Pt? = Pt(x: 1)
    var b: Pt? = none
    var c: Text? = "hi"
    var d: List[S32]? = none
    show(f"{a == none} {b == none} {c != none} {d == none}")
    show(f"{absent(value: a)} {absent(value: b)} {present(value: c)} {present(value: d)}")
    return
