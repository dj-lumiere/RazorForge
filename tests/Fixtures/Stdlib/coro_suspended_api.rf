module Tests/Stdlib/CoroSuspendedApi

# `agent f(...)` over a plain routine yields an Agent[T]. `retrieve()` starts it as a fiber
# (`start_now()`), drives it to completion (through every rf_coro_yield) and returns its value.
# Dropping a never-retrieved handle abandons it.

import IO/Console
routine compute(x: S64) -> S64
    return x * 2

routine counter() -> S64
    var n = 10_s64
    C::rf_coro_yield()
    n = n + 5_s64
    C::rf_coro_yield()
    n = n + 5_s64
    return n

routine start()
    var c = agent compute(x: 21)
    show(f"compute => {c.retrieve()}")

    var k = agent counter()
    show(f"counter => {k.retrieve()}")
    return
