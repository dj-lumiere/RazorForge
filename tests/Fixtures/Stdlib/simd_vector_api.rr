module Tests/Stdlib/SimdVectorApi

import IO/Console
import Simd
# Exercises the generic SIMD Vector[E, N] over B32 lanes (LLVM <N x float>).
routine start()
    # Build a 4-lane vector a = <1, 2, 3, 4> from a zero fill + per-lane writes
    # through the `[]=` operator (in-place setitem!).
    var a: Vector[B32, 4] = Vector[B32, 4](fill: 0.0)
    a[0] = 1.0
    a[1] = 2.0
    a[2] = 3.0
    a[3] = 4.0

    var b: Vector[B32, 4] = Vector[B32, 4](fill: 10.0)

    show(f"a: {a}")
    show(f"b: {b}")
    show(f"a count: {a.count()}")
    show(f"a lane 2: {a[2]}")

    # Elementwise arithmetic (lowers to <4 x float> ops).
    show(f"a + b: {a + b}")
    show(f"a - b: {a - b}")
    show(f"a * b: {a * b}")
    show(f"b / a: {b / a}")
    show(f"-a: {-a}")
    show(f"a scaled 2: {a.scale(factor: 2.0)}")

    # Reductions.
    show(f"a sum: {a.sum()}")
    show(f"a dot b: {a.dot(you: b)}")
    show(f"a length_squared: {a.length_squared()}")

    # Equality.
    var a2: Vector[B32, 4] = a
    show(f"a == a2: {a == a2}")
    show(f"a == b: {a == b}")

    # A different lane count instantiates a distinct LLVM vector type.
    var c: Vector[B64, 2] = Vector[B64, 2](fill: 1.5)
    show(f"c (B64x2): {c}")
    show(f"c sum: {c.sum()}")

    show("DONE")
    return
