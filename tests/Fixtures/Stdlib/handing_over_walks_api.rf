module Tests/Stdlib/HandingOverWalksApi

import IO/Console
import IterTools
# Walks whose items are handed over: `select` and `select_many` make new values, `(steal xs)` takes a list apart, and
# `where`, `skip` and `take` after them hand over what they pass on. A step of `for` over such a walk ends its item,
# an adapter ends the items it passes by, and a collection made from the walk keeps them.

entity Crate
    n: S64

routine start()
    var nums: List[S64] = [1, 2, 3, 4]
    for c in nums.select(transform: x => Crate(n: x))
        show(f"made {c.n}")
    for t in nums.select(transform: x => f"t{x}").where(t => t != "t2").skip(1)
        show(t)
    var crates: List[Crate] = [Crate(n: 3), Crate(n: 4)]
    for k in crates.select_many(transform: c => [Crate(n: c.n * 100), Crate(n: c.n * 1000)]).take(3)
        show(f"many {k.n}")
    for c in nums.select(transform: x => Crate(n: x)).where(c => c.n % 2 == 0)
        show(f"even {c.n}")
    var big = nums.select(transform: x => Crate(n: x)).where(c => c.n > 2).to[List]()
    show(f"big {big.count()}")
    show(nums.select(transform: x => Crate(n: x)).skip(1).get_count())
    var kept = List[Crate]()
    for m in nums.select(transform: x => Crate(n: x + 10))
        kept.add_last(steal m)
    show(f"kept {kept.count()}")
    var taken = (steal crates).where(c => c.n > 3).to[List]()
    show(f"taken {taken.count()} {taken[0].n}")
    var rest: List[Crate] = [Crate(n: 7), Crate(n: 8), Crate(n: 9)]
    for c in (steal rest).where(c => c.n != 8)
        show(f"rest {c.n}")
    for r in big.reverse().where(c => c.n > 3)
        show(f"reversed {r.n}")
    show(f"still {big.count()}")
    return
