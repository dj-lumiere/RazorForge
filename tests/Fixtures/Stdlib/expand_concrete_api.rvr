module Tests/Stdlib/ExpandConcreteApi

import BuilderExpansion
import IO/Console

# An `expand` over a concrete type in a routine that is not generic: each copy uses its member's own type, so
# `!=` on a member needs no `needs Equatable everywhere`.

record Pair
    a: S64
    b: Text

routine changed(before: Pair, after: Pair) -> S64
    var count: S64 = 0
    expand m in allmemvarof(Pair)
        if before.$nameof(m) != after.$nameof(m)
            count += 1
    return count

routine Pair.differs_from(you: Pair) -> S64
    var count: S64 = 0
    expand m in allmemvarof(Pair)
        if me.$nameof(m) != you.$nameof(m)
            count += 1
    return count

routine start()
    show(changed(before: Pair(a: 1, b: "x"), after: Pair(a: 2, b: "y")))
    show(Pair(a: 1, b: "x").differs_from(you: Pair(a: 1, b: "y")))
    show(changed(before: Pair(a: 1, b: "x"), after: Pair(a: 1, b: "x")))
    return
