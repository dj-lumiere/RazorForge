module Tests/Stdlib/CoroAsyncReadApi

# Async I/O parking. `FileManager.read_text` reads a whole file on the runtime's I/O threads. Called inside an
# Agent's fiber, the fiber PARKS while the worker reads, so its thread goes on with other fibers.
# Proven here by the read returning the file contents AND a ticker Agent (which parks on timers)
# completing — no deadlock, no block.

import IO/Console
import IO/File
routine read_it(path: Text) -> Text
    return FileManager.read_text(at: File(at: path))

routine ticker(n: S64) -> S64
    var i = 0
    while i < n
        waitfor(2ms)  # parks the fiber on a timer
        i = i + 1
    return i

routine start()
    var r = read_it.to[Agent](path: "tests/Fixtures/Stdlib/coro_async_read_data.txt")
    var t = ticker.to[Agent](n: 3)
    show(f"read => {r.retrieve()}")
    show(f"ticks => {t.retrieve()}")
    return
