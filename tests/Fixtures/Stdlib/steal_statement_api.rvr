module Tests/Stdlib/StealStatementApi

import IO/Console

# `steal place as old inject fresh` takes a value out of a member variable or an element and puts the new one in at
# once. Without `inject` a `T?` place is left `none`, and a whole variable just moves.
entity Item
    name: Text

@override
routine Item.destruct()
    show(f"  destruct {me.name}")
    me.name.destruct()
    return

entity Slot
    item: Item
    spare: Item?

routine start()
    var slot = Slot(item: Item(name: "a"), spare: Item(name: "s"))
    steal slot.item as old inject Item(name: "b")
    show(f"took {old.name}, now {slot.item.name}")
    steal slot.spare as kept
    when kept
        is Item as k => show(f"spare taken: {k.name}")
        is None => show("spare was empty")
    when slot.spare
        is Item => show("spare still there")
        is None => show("spare left empty")
    var items = List[Item]()
    items.add_last(value: Item(name: "x"))
    steal items[0] as first inject Item(name: "y")
    show(f"took {first.name}, now {items[0].name}")
    var text = "hello"
    steal text as moved
    show(moved)
    show("DONE")
    return
