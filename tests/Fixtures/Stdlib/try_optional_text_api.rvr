module Tests/Stdlib/TryOptionalTextApi

import IO/Console
import IO/Environment

# A routine that can fail and gives a `Text?`, called under `try`, hands back a text of its own: the `Text?` the
# keyword gives holds a text that is still alive after the routine's temporaries are torn down.

routine describe(n: S64) -> Text?
    if n < 0
        throw AbsentValueError()
    if n == 0
        return none
    var base = "hello world, long enough text"
    return base.concat(other: "!")

routine start()
    show(try describe(n: 1))
    show(try describe(n: 0))
    show(try describe(n: -1))
    var kept = try describe(n: 2)
    show(kept)
    show((try Environment.variable(name: "PATH")).is_present())
    show(try Environment.variable(name: "SURELY_NOT_SET_REVARE_FIXTURE"))
    return
