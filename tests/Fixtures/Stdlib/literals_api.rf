module Tests/Stdlib/LiteralsApi

import IO/Console
# Exercises every literal token form the tokenizer produces (see src/01.Tokenizer/TokenType.cs):
# signed/unsigned fixed-width integers, Addr, arbitrary-precision Int (`n`),
# number bases + digit separators, floats, fixed + arbitrary-precision Decimal (`dn`),
# Bool, Text, Character, and ByteLetter literals.
routine start()
    # --- Signed integers (S8..S128) ---
    var s8_42: S8 = 42
    show(f"s8: {s8_42}")
    var s16_1000: S16 = 1000
    show(f"s16: {s16_1000}")
    var s32_100000: S32 = 100000
    show(f"s32: {s32_100000}")
    show(f"s64: {10000000000}")
    var s128_value: S128 = 170141183460469231731687303715884105727
    show(f"s128: {s128_value}")
    show(f"s64 neg: {-42}")

    # --- Unsigned integers (U8..U128) ---
    var u8_255: U8 = 255
    show(f"u8: {u8_255}")
    var u16_65535: U16 = 65535
    show(f"u16: {u16_65535}")
    var u32_4000000000: U32 = 4000000000
    show(f"u32: {u32_4000000000}")
    var u64_value: U64 = 18000000000000000000
    show(f"u64: {u64_value}")
    var u128_value: U128 = 340282366920938463463374607431768211455
    show(f"u128: {u128_value}")

    # --- Addr ---
    var address_4096: Addr = 4096
    show(f"addr: {address_4096}")

    # --- Arbitrary-precision Int (n) ---
    var integer_42: Int = 42
    show(f"n: {integer_42}")
    var integer_value: Int = 123456789012345678901234567890
    show(f"n big: {integer_value}")
    var integer_value_2: Int = 1_000_000
    show(f"n grouped: {integer_value_2}")

    # --- Number bases + separators ---
    var u32_0xff: U32 = 0xFF
    show(f"hex: {u32_0xff}")
    var u32_0xdead_beef: U32 = 0xDEAD_BEEF
    show(f"hex mixed: {u32_0xdead_beef}")
    var u8_0b1010: U8 = 0b1010
    show(f"binary: {u8_0b1010}")
    show(f"sep: {1_234_567}")

    # --- Floats (B16..B128) ---
    var b16_1_5: B16 = 1.5
    show(f"b16: {b16_1_5}")
    var b32_3_14: B32 = 3.14
    show(f"b32: {b32_3_14}")
    show(f"b64: {2.5}")
    var b128_1_25: B128 = 1.25
    show(f"b128: {b128_1_25}")
    show(f"sci: {1.5e3}")

    # --- Decimals (D32..D128) ---
    var d32_3_5: D32 = 3.5
    show(f"d32: {d32_3_5}")
    var d64_2_5: D64 = 2.5
    show(f"d64: {d64_2_5}")
    var d128_1_25: D128 = 1.25
    show(f"d128: {d128_1_25}")

    # --- Arbitrary-precision Decimal (dn) ---
    var decimal_3_14: Decimal = 3.14
    show(f"dn: {decimal_3_14}")
    var decimal_0_1: Decimal = 0.1
    var decimal_0_2: Decimal = 0.2
    show(f"dn exact: {decimal_0_1 + decimal_0_2}")

    # --- Imaginary literal (width-less `i`) -> pure-imaginary complex ---
    # No context -> defaults to C128 (2xB64). The `_i` spelling is accepted too.
    show(f"i default: {2.0i}")
    show(f"i sep: {4.0_i}")
    # Natural `real + imag*i` construction: the real literal fills the real part, `i` the imaginary,
    # and the type comes from context (default C128).
    var c_default = 3 + 4i
    show(f"c default: {c_default}")
    var c64: C64 = 1 + 3i
    show(f"c in C64: {c64}")
    var c256: C256 = 2 + 5i
    show(f"c in C256: {c256}")

    # --- Bool ---
    show(f"true: {true}")
    show(f"false: {false}")

    # --- Text / Character / ByteLetter / Bytes ---
    var t: Text = "hello"
    show(f"text: {t}")
    show(f"char: {'A'}")
    show(f"byte: {b'x'}")
    var bv: Bytes = b"hi"
    show(f"bytes: {bv}")

    # --- Duration literals (w/d/h/m/s/ms/us/ns) ---
    show(f"dur_w: {2w}")
    show(f"dur_d: {3d}")
    show(f"dur_h: {4h}")
    show(f"dur_m: {5m}")
    show(f"dur_s: {6s}")
    show(f"dur_ms: {7ms}")
    show(f"dur_us: {8us}")
    show(f"dur_ns: {9ns}")

    # --- ByteSize literals (b/kb/kib/mb/mib/gb/gib) ---
    show(f"bs_b: {100b}")
    show(f"bs_kb: {8kb}")
    show(f"bs_kib: {8kib}")
    show(f"bs_mb: {2mb}")
    show(f"bs_mib: {2mib}")
    show(f"bs_gb: {1gb}")
    show(f"bs_gib: {1gib}")

    show("DONE")
    return
