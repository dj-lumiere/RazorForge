module Tests/Stdlib/NumberTextApi

import IO/Console
# Number formatting is member routines, not f-text format specs: `to_text(radix:)` / `hex()` / `bin()` /
# `oct()` on every integer, `fixed(places)` on every real type (exact value, ties to even, Decimal ties away from zero),
# and `pad_start` / `pad_end` / `center` / `zero_pad` on Text.

routine start()
    var neg = -255
    var small: S8 = -128
    var tiny = -0.001
    show(f"{255.hex()} {neg.hex()} {5.bin()} {8.oct()} {255.to_text(radix: 36)}")
    var u8_255: U8 = 255
    var u16_65535: U16 = 65535
    show(f"{u8_255.hex()} {small.hex()} {u16_65535.hex()} {S64_MIN.hex()} {U64_MAX.hex()}")
    show(f"{S128_MIN.hex()} {U128_MAX.hex()} {U256_MAX.bin().count()} {S256_MIN.to_text(radix: 10)}")
    var u64_255: U64 = 255
    show(f"{u64_255.to[Int]().hex()} {255.hex().to_uppercase()}")
    show(f"[{"ab".pad_start(5)}] [{"ab".pad_end(5)}] [{"ab".center(6)}] [{("-5").zero_pad(4)}] [{"ff".zero_pad(4)}]")
    show(f"{3.14159.fixed(2)} {2.675.fixed(2)} {0.5.fixed(0)} {1.5.fixed(0)} {tiny.fixed(2)} {1e20.fixed(1)} {1.0.fixed(3)}")
    show(f"{3.14159.to[B32]().fixed(3)} {0.5.to[B16]().fixed(2)} {2.5.to[B128]().fixed(4)}")
    show(f"{1.235.to[D64]().fixed(2)} {1.245.to[D128]().fixed(2)} {12.5.to[D32]().fixed(0)}")
    show(f"{7.125.to[Decimal]().fixed(2)}")
    show("DONE")
    return
