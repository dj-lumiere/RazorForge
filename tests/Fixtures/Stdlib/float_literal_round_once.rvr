module Tests/Stdlib/FloatLiteralRoundOnce

import IO/Console
# A decimal float literal goes into B32 rounded once from its exact value. This one is just past the halfway point
# between 1.0 and the next B32, so it rounds up. Rounding through a B64 first would land exactly on the halfway
# point and round down to 1.0.
routine start()
    var x: B32 = 1.0000000596046447753906251
    show(f"above one: {x > 1.0}")
    var y: B32 = 1.000000059604644775390625
    show(f"halfway stays even: {y == 1.0}")
    show("DONE")
    return
