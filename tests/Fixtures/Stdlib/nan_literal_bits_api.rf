module Tests/Stdlib/NanLiteralBitsApi

import IO/Console
# The `nan` literal is the positive quiet NaN in every binary float width: sign bit clear, top mantissa bit set
# (B16 0x7E00, B32 0x7FC00000, B64 0x7FF8000000000000, B128 0x7FFF8000000000000000000000000000).

routine start()
    var h: B16 = nan
    var f: B32 = nan
    var d: B64 = nan
    var q: B128 = nan
    show(f"B16 bits: {h.to_bits()}")
    show(f"B32 bits: {f.to_bits()}")
    show(f"B64 bits: {d.to_bits()}")
    show(f"B128 bits: {q.to_bits()}")
    show(f"negated B64 bits: {(-d).to_bits()}")
    return
