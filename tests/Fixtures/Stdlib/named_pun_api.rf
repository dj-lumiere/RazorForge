module Tests/Stdlib/NamedPunApi

import IO/Console

# A variable named like its parameter goes by its name alone, in order or not, and beside named arguments.
routine label(name: Text, age: S64, city: Text) -> Text
    return f"{name} {age} {city}"

record Point
    x: S64
    y: S64
    z: S64

routine start()
    var name = "Lumi"
    var age = 30
    var city = "Seoul"
    show(label(name, age, city))
    show(label(city, name, age))
    show(label(name, city, age: 31))
    var x = 1
    var y = 2
    var z = 3
    var p = Point(z, y, x)
    show(f"{p.x} {p.y} {p.z}")
    show("DONE")
    return
