module Tests/Stdlib/NamedPunApi

import IO/Console

# Arguments without a label fill the parameters in order. A variable named like its parameter may stand alone after a
# label, and a variable in another parameter's place is written with its label.
routine label(name: Text, age: S64, city: Text) -> Text
    return f"{name} {age} {city}"

record Point
    x: S64
    y: S64
    z: S64

routine start()
    var name = "Lumi"
    var age = 30
    var city = "Seoul"
    show(label(name, age, city))
    show(label(city: city, name, age))
    show(label(name, city: city, age: 31))
    var x = 1
    var y = 2
    var z = 3
    var p = Point(z: z, y, x)
    show(f"{p.x} {p.y} {p.z}")
    var q = Point(x, y, z)
    show(f"{q.x} {q.y} {q.z}")
    show("DONE")
    return
