module Tests/Stdlib/OptionalEntityElementApi

import IO/Console
# A `List[Box?]` element (Box an entity) is read in its place: `when shelf.slots[i]` and `when slot` in a loop over
# the list bind a token on the entity the list keeps, so nothing is copied and the list ends each Box once.

entity Box
    n: S64

routine Box.destruct()
    show(f"ends {me.n}")
    return

entity Shelf
    slots: List[Box?]

routine start()
    var shelf = Shelf(slots: [none])
    shelf.slots.add_last(value: Box(n: 4))
    shelf.slots.add_last(value: Box(n: 6))
    var sum: S64 = 0
    for i in 0 til 3
        when shelf.slots[i]
            is None => show(f"slot {i} empty")
            else as b => sum += b.n
    show(sum)
    for slot in shelf.slots
        when slot
            is None => nothing
            else as b => b.n += 1
    when shelf.slots[1]
        is None => nothing
        else as b => show(b.n)
    show("done")
    return
