module Tests/Stdlib/DecimalBidProbe

import IO/Console
routine start()
    # literals (now BID-encoded)
    var a = 6.0_d128
    var b = 2.0_d128
    show(a / b)  # 3
    show(1.0_d128 + 0.5_d128)
    show(0.1_d64 + 0.2_d64)
    show(1.5_d32 * 2.0_d32)
    # int -> decimal
    show(42_s64.to[D128]())
    show(255_u8.to[D64]())
    show(7_s32.to[D32]())
    # decimal -> int
    show(123.9_d128.to[S64]())
    show(255.0_d64.to[U8]())
    # float <-> decimal
    show(3.25_b64.to[D128]())
    show(2.5_d128.to[B64]())
    # decimal -> decimal
    show(9.75_d128.to[D64]())
    show(1.25_d32.to[D128]())
    # comparison
    show(2.0_d128 < 3.0_d128)
    show(1.to[D128]() == 1.to[D128]())
    # parse
    show("3.14159".to[D128]())
    return
