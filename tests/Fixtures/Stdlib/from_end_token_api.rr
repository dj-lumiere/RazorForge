module Tests/Stdlib/FromEndTokenApi

import IO/Console
# An index counted from the end (`xs[^1]`) on a token: the element a `for` binds over a list of lists is a token on
# the inner list, and `^1` reads that list's count.

routine last_of(xs: Viewing[List[S64]]) -> S64
    return xs[^1]

routine start()
    var lists = List[List[S64]]()
    lists.add_last(value: [1, 2, 3])
    lists.add_last(value: [40, 50])
    for xs in lists
        show(f"{xs[^1]} {xs[^2]}")
    var total: S64 = 0
    for xs in lists
        total += xs[^1]
    show(total)
    for xs in lists
        xs[^1] = xs[^1] * 2
    show(lists)
    show(last_of(xs: lists[0].view()))
    return
