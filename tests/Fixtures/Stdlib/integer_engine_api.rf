module Tests/Stdlib/IntegerEngineApi

import IO/Console
# Wrapper exposing the failable `sqrt` for try_ generation.
failable routine integer_sqrt(value: Int) -> Int
    return value.sqrt()

# Broad coverage of the Int surface: widening constructors, parsing and radix rendering, exact
# arithmetic across the schoolbook and NTT multiplication sizes, Euclidean division (remainder in
# [0, |b|)), two's-complement bitwise operators, shifts, powers, roots, gcd/lcm and narrowing conversions.
routine start()
    var two = 2.to[Int]()
    var seven = 7.to[Int]()
    var ten = 10.to[Int]()
    var p20 = ten.pow(exp: 20)
    var prime = 1_000_000_007.to[Int]()
    var big3 = 3.to[Int]().pow(exp: 5000)
    var big7 = seven.pow(exp: 5000)

    show("-- construction --")
    show(f"s64 min/max: {S64_MIN.to[Int]()} {S64_MAX.to[Int]()}")
    show(f"u64 max: {U64_MAX.to[Int]()}")
    var s8_minus_128: S8 = -128
    var u16_65535: U16 = 65535
    var s32_minus_2147483648: S32 = -2147483648
    show(f"s8/u16/s32: {s8_minus_128.to[Int]()} {u16_65535.to[Int]()} {s32_minus_2147483648.to[Int]()}")
    show(f"u128 max: {U128_MAX.to[Int]()}")
    show(f"s128 min: {S128_MIN.to[Int]()}")
    show(f"s256 min: {S256_MIN.to[Int]()}")
    show(f"u256 max: {U256_MAX.to[Int]()}")
    var integer_value: Int = 123456789012345678901234567890
    show(f"literal: {integer_value}")

    show("-- parsing / rendering --")
    show(f"parse big: {Int(text: "-123456789012345678901234567890123456789", radix: 10)}")
    show(f"parse ff/FF (16): {Int(text: "ff", radix: 16)} {Int(text: "FF", radix: 16)}")
    show(f"parse zz (36): {Int(text: "zz", radix: 36)}")
    show(f"parse 101 (2): {Int(text: "101", radix: 2)}")
    show(f"parse -0 / empty: {Int(text: "-0", radix: 10)} {Int(text: "", radix: 10)}")
    show(f"from_hex/from_binary: {Int.from_hex(text: "DeadBeef")} {Int.from_binary(text: "11111111")}")
    show(f"radix 16: {(-255).to[Int]().represent_radix(radix: 16)}")
    show(f"radix 36: {1295.to[Int]().represent_radix(radix: 36)}")
    show(f"radix 2: {10.to[Int]().represent_radix(radix: 2)}")
    show(f"radix 16 big: {two.pow(exp: 130).represent_radix(radix: 16)}")

    show("-- arithmetic --")
    show(f"factorial 40: {factorial(n: 40.to[Int]())}")
    show(f"fib 300: {fibonacci_big(n: 300)}")
    var prod = big3 * big7
    show(f"3^5000*7^5000 mod p: {prod % prime}")
    show(f"3^5000*7^5000 low: {prod % p20}")
    show(f"digits: {prod.represent().count()}")
    show(f"21^5000 == prod: {21.to[Int]().pow(exp: 5000) == prod}")
    show(f"sub to negative: {5.to[Int]() - p20}")
    show(f"neg/abs: {p20.neg()} {p20.neg().abs()}")

    show("-- division --")
    var n7 = (-7).to[Int]()
    var n2 = (-2).to[Int]()
    show(f"//: {seven // two} {n7 // two} {seven // n2} {n7 // n2}")
    show(f"%: {seven % two} {n7 % two} {seven % n2} {n7 % n2}")
    danger
        var qr = n7.divmod(other: two)
        show(f"divmod(-7,2): {qr.item0} {qr.item1}")
        var qb = big7.divmod(other: big3)
        show(f"big divmod q low: {qb.item0 % p20}")
        show(f"big divmod check: {qb.item0 * big3 + qb.item1 == big7}")
        show(f"big divmod r < d: {qb.item1 < big3}")
        # ~4950 / ~2410 limbs: long enough on both sides for the Newton-reciprocal division path
        var huge = 3.to[Int]().pow(exp: 200000)
        var hd = seven.pow(exp: 55000)
        var qh = huge.divmod(other: hd)
        show(f"newton divmod check: {qh.item0 * hd + qh.item1 == huge} {qh.item1 < hd} {qh.item0 % p20}")
    show(f"big // small: {big3 // prime % p20}")
    show(f"big % small: {big3 % prime}")

    show("-- bitwise / shifts --")
    var n12 = (-12).to[Int]()
    show(f"and: {n12.bitand(other: ten)} {n12.bitand(other: (-10).to[Int]())}")
    show(f"or: {n12.bitor(other: ten)} {n12.bitor(other: (-10).to[Int]())}")
    show(f"xor: {n12.bitxor(other: ten)} {n12.bitxor(other: (-10).to[Int]())}")
    show(f"not: {n12.bitnot()} {ten.bitnot()}")
    show(f"big and: {(two.pow(exp: 200) - Int.one()).bitand(other: p20.neg())}")
    show(f"shl: {Int.one().shift_left(bits: 200)}")
    show(f"shr: {(-5).to[Int]().arith_shift_right(bits: 1)} {(-1).to[Int]().arith_shift_right(bits: 1)} {(-4).to[Int]().arith_shift_right(bits: 1)} {p20.arith_shift_right(bits: 10)} {p20.arith_shift_right(bits: 100)}")
    var neg_big = (two.pow(exp: 200) + Int.one()).neg()
    show(f"shr big negative == floor div: {neg_big.arith_shift_right(bits: 100) == neg_big // two.pow(exp: 100)} {neg_big.arith_shift_right(bits: 300)}")

    show("-- powers / roots / gcd --")
    show(f"pow: {two.pow(exp: 100)} {(-3).to[Int]().pow(exp: 5)} {Int.zero().pow(exp: 0)}")
    show(f"sqrt: {(p20 * p20 + Int.one()).sqrt()} {(two * ten.pow(exp: 100)).sqrt()} {Int.zero().sqrt()} {99.to[Int]().sqrt()}")
    show(f"gcd: {(-12).to[Int]().gcd(other: 18.to[Int]())} {Int.zero().gcd(other: Int.zero())} {big3.gcd(other: 3.to[Int]().pow(exp: 40) * seven)}")
    var gx = two.pow(exp: 100) * 3.to[Int]().pow(exp: 200) * 5.to[Int]().pow(exp: 50)
    var gy = two.pow(exp: 90) * 3.to[Int]().pow(exp: 250) * seven
    show(f"gcd balanced: {gx.gcd(other: gy) == two.pow(exp: 90) * 3.to[Int]().pow(exp: 200)} {gy.neg().gcd(other: gx)}")
    var neg_root = try integer_sqrt(value: (-4).to[Int]())
    show(f"sqrt negative: {neg_root}")
    show(f"lcm: {(-4).to[Int]().lcm(other: 6.to[Int]())} {Int.zero().lcm(other: 5.to[Int]())}")
    show(f"modpow: {3.to[Int]().modpow(exp: p20, modulus: prime)}")

    show("-- predicates / conversions --")
    show(f"bit_length: {Int.zero().bit_length()} {(-1024).to[Int]().bit_length()} {big3.bit_length()}")
    show(f"power of two: {two.pow(exp: 300).is_power_of_two()} {p20.is_power_of_two()}")
    show(f"even/odd: {big3.is_even()} {big3.is_odd()} {(-4).to[Int]().is_even()}")
    show(f"signum: {n7.signum()} {Int.zero().signum()} {p20.signum()}")
    show(f"cmp: {n7 < two} {big7 > big3} {p20 == ten.pow(exp: 20)} {n7.min(other: two)} {n7.max(other: two)}")
    show(f"to s64: {S64_MIN.to[Int]().to[S64]()} {n7.to[S64]()}")
    show(f"to u64: {U64_MAX.to[Int]().to[U64]()}")
    show("DONE")
    return
