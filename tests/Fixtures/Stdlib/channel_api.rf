module Tests/Stdlib/ChannelApi

# v0.3.0 channels — first end-to-end smoke test (single-threaded, buffered, no parking yet). A Transmitter
# sends three values into a capacity-4 Receiver; after close, the `for` loop drains the buffer in order
# then ends when the channel is closed-and-empty. Exercises make_channel, transmit, close, and the
# Emittable receive path (Receiver.emitter -> ChannelDrain.emit!) through real codegen.

import IO/Console
routine start()
    var (feeder, hop) = make_channel[S64](capacity: 4)
    danger
        feeder.transmit(item: 10)
        feeder.transmit(item: 20)
        feeder.transmit(item: 30)
    feeder.close()

    var total = 0
    var seen = 0
    each v in hop
        total = total + v
        seen = seen + 1
    show(f"count={seen} sum={total}")
    return
