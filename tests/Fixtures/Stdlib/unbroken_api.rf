module Tests/Stdlib/UnbrokenApi

import IO/Console
# Single-threaded exercise of Unbroken[T]: every method drives a SeqCst atomic
# intrinsic on the cell's live address (by-ref `me` + me.value.hijack()).
# Sharing one cell across jobs (an `Unbroken` parameter is passed by reference)
# is covered by the shared-counter fixture.

routine start()
    # Integer cell: load / store / swap / fetch_add / fetch_sub / compare_exchange.
    var c = Unbroken[S64](initial: 10)
    drop c.fetch_add(delta: 5)
    show(f"after add: {c.load()}")

    drop c.fetch_sub(delta: 3)
    show(f"after sub: {c.load()}")

    var prev = c.swap(desired: 100)
    show(f"swapped from: {prev}")
    show(f"now: {c.load()}")

    c.store(desired: 7)
    show(f"stored: {c.load()}")

    var ok = c.compare_exchange(expected: 7, desired: 42)
    show(f"cas ok: {ok} val: {c.load()}")

    var ok2 = c.compare_exchange(expected: 7, desired: 99)
    show(f"cas2 ok: {ok2} val: {c.load()}")

    # Bitwise RMW on an unsigned cell.
    var bits = Unbroken[U32](initial: 0b1100)
    drop bits.fetch_or(mask: 0b0001)
    drop bits.fetch_and(mask: 0b1101)
    drop bits.fetch_xor(mask: 0b1000)
    show(f"bits: {bits.load()}")

    # Flag via Unbroken[U8] (Bool is sub-byte, so not atomic-capable): 0 = clear, 1 = set.
    var flag = Unbroken[U8](initial: 0)
    show(f"flag: {flag.load()}")
    flag.store(desired: 1)
    show(f"flag: {flag.load()}")
    var was = flag.swap(desired: 0)
    show(f"was: {was} flag: {flag.load()}")
    var caso = flag.compare_exchange(expected: 0, desired: 1)
    show(f"caso: {caso} flag: {flag.load()}")
    return
