module Tests/Stdlib/JsonEncodeApi

import Collections
import IO/Console
# JSON encoding over the `SerialValue` tree: `value.serialize().to_json_text()` / `.to_json_bytes()`.
# Record fields serialize to a Dict in declaration order and the encoder walks keys() in insertion
# order, so the object output is deterministic. Exercises scalars, strings (with escapes), a nested
# object, an array, and a Bytes-as-number-array.

record Point
    x: S32
    y: S32

entity Doc
    title: Text
    origin: Point
    tags: List[Text]
    ok: Bool

routine start()
    # Scalars
    var s32_42: S32 = 42
    show(SerialValue(s32_42).to_json_text())
    show(SerialValue(true).to_json_text())
    show(SerialValue(3.5).to_json_text())

    # String escaping: quote, backslash, newline, tab, and a control char (U+0001).
    var messy = List[Char]()
    var u32_0x71: U32 = 0x71
    messy.add_last(value: Char(u32_0x71))
    var u32_0x22: U32 = 0x22
    messy.add_last(value: Char(u32_0x22))
    var u32_0x5c: U32 = 0x5C
    messy.add_last(value: Char(u32_0x5c))
    var u32_0x0a: U32 = 0x0A
    messy.add_last(value: Char(u32_0x0a))
    var u32_0x09: U32 = 0x09
    messy.add_last(value: Char(u32_0x09))
    var u32_0x01: U32 = 0x01
    messy.add_last(value: Char(u32_0x01))
    show(SerialValue(Text(from_list: steal messy)).to_json_text())

    # Array
    var nums = List[SerialValue]()
    var s32_1: S32 = 1
    nums.add_last(value: SerialValue(s32_1))
    var s32_2: S32 = 2
    nums.add_last(value: SerialValue(s32_2))
    var s32_3: S32 = 3
    nums.add_last(value: SerialValue(s32_3))
    show(SerialValue(steal nums).to_json_text())

    # Bytes -> array of byte values
    var raw = List[Byte]()
    var u8_0xde: U8 = 0xDE
    raw.add_last(value: u8_0xde.to[Byte]())
    var u8_0x00: U8 = 0x00
    raw.add_last(value: u8_0x00.to[Byte]())
    var u8_0x41: U8 = 0x41
    raw.add_last(value: u8_0x41.to[Byte]())
    show(SerialValue(Bytes(from_list: steal raw)).to_json_text())

    # Nested aggregate through serialize()
    var tags = List[Text]()
    tags.add_last(value: "a")
    tags.add_last(value: "b")
    var doc = Doc(title: "hi", origin: Point(x: 1, y: 2), tags: steal tags, ok: false)
    var sv = doc.serialize()
    show(sv.to_json_text())
    show(f"bytes: {sv.to_json_bytes().count()}")

    show("DONE")
    return
