module Tests/Stdlib/SetEntityArgumentApi

import IO/Console
# An entity made right in the argument of a routine that keeps it (`Set.add`, `List.add_last`) is handed over to
# that routine, also when the call's result is dropped: the caller doesn't tear it down after the call.

entity Badge
obeys Hashable
    code: Text

routine start()
    var badges = Set[Badge]()
    drop badges.add(value: Badge(code: "A1"))
    drop badges.add(value: Badge(code: "A1"))
    drop badges.add(value: Badge(code: "B2"))
    show(f"badges: {badges.count()}")
    show(f"has A1: {badges.has(value: Badge(code: "A1"))}")
    var list = List[Badge]()
    list.add_last(value: Badge(code: "C3"))
    show(f"list: {list.count()}")
    return
