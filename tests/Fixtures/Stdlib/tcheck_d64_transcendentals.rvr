module Tests/Stdlib/TcheckD64Transcendentals

import IO/Console
# Merged D64 softfloat checks (was tcheck_d64_{sin,cos,exp}; consolidated post-fix).
# Extended to cover the composite transcendentals (cos/tan/hyperbolic/log2/log10)
# whose internal exp/log/expm1/log1p iteration counts are sized to D64's 54-bit
# target rather than B128's full 113-bit. Expected values are the correctly-rounded
# D64 results (captured from the full-count build); reduced counts must reproduce them.
routine start()
    var d64_1_0: D64 = 1.0
    show(d64_1_0.sin().represent())
    show(d64_1_0.cos().represent())
    show(d64_1_0.exp_unchecked().represent())
    show(d64_1_0.tan().represent())
    show(d64_1_0.sinh_unchecked().represent())
    show(d64_1_0.cosh_unchecked().represent())
    show(d64_1_0.tanh().represent())
    var d64_0_5: D64 = 0.5
    show(d64_0_5.atanh_unchecked().represent())
    var d64_7_0: D64 = 7.0
    show(d64_7_0.log2_unchecked().represent())
    show(d64_7_0.log10_unchecked().represent())
    var d64_2_5: D64 = 2.5
    show(d64_2_5.asinh().represent())
    show(d64_2_5.acosh_unchecked().represent())
    var d64_0_25: D64 = 0.25
    show(d64_0_25.exp2_unchecked().represent())
    show(d64_0_25.exp10_unchecked().represent())
    # erf/erfc run the continued fraction at B128 width with reduced levels (lm=50/lt=64); these
    # cover the mid branch (|z|<3.1) and the tail branch (|z|>=3.1) and must match the octuple result.
    show(d64_1_0.erf().represent())
    show(d64_0_5.erf().represent())
    var d64_3_5: D64 = 3.5
    show(d64_3_5.erf().represent())
    show(d64_1_0.erfc().represent())
    var d64_4_0: D64 = 4.0
    show(d64_4_0.erfc().represent())
    # gamma/lgamma run the octuple Stirling core at reduced degrees (sdeg=12/logn=10/sinn=9/expn=10);
    # cover small-arg augmentation, large arg, and the reflection path (negative non-integer).
    show(d64_0_5.gamma_unchecked().represent())
    var d64_5_0: D64 = 5.0
    show(d64_5_0.gamma_unchecked().represent())
    show((-d64_2_5).gamma_unchecked().represent())
    var d64_10_0: D64 = 10.0
    show(d64_10_0.ln_gamma().represent())
    show((-d64_2_5).ln_gamma().represent())
    # atan/asin/acos run atan2 at reduced degree/depth (deg=12/depth=2); cover large-arg atan and
    # near-1 asin/acos (the octant-folded reduction stress points).
    var d64_100_0: D64 = 100.0
    show(d64_100_0.atan().represent())
    var d64_minus_2_0: D64 = -2.0
    show(d64_minus_2_0.atan().represent())
    var d64_0_9: D64 = 0.9
    show(d64_0_9.asin_unchecked().represent())
    var d64_0_99: D64 = 0.99
    show(d64_0_99.acos_unchecked().represent())
    return
