module Tests/Stdlib/LoopUntilThenApi

import IO/Console
# `until c` loops until c holds. A loop's `then` block runs once the loop is left for the line after it: when the
# loop ends by itself and after its own `break` (a `break` of a loop inside it only leaves that loop).

routine find(target: S64) -> Text
    var xs = List[S64]()
    xs.add_last(value: 1)
    xs.add_last(value: 2)
    var found = "no"
    each x in xs
        if x == target
            found = "yes"
            break
    then
        found = f"{found}, then ran"
    return found

routine start()
    var i = 0
    until i >= 3
        i += 1
    show(f"i {i}")
    var xs = List[S64]()
    xs.add_last(value: 1)
    xs.add_last(value: 2)
    show(find(target: 2))
    show(find(target: 9))
    var n = 0
    until n >= 5
        n += 1
        each y in xs
            if y == 1
                break
    then
        show("until finished")
    show("DONE")
    return
