module Tests/Stdlib/LoopUntilThenApi

import IO/Console
# `until c` loops while c is false. A loop's `then` block runs when the loop ends by itself, not after its own `break`
# (a `break` of a loop inside it doesn't count).

routine find(target: S64) -> Text
    var xs = List[S64]()
    xs.add_last(value: 1)
    xs.add_last(value: 2)
    var found = "no"
    each x in xs
        if x == target
            found = "yes"
            break
    then
        found = "searched all"
    return found

routine start()
    var i = 0
    until i >= 3
        i += 1
    show(f"i {i}")
    var xs = List[S64]()
    xs.add_last(value: 1)
    xs.add_last(value: 2)
    show(find(target: 2))
    show(find(target: 9))
    var n = 0
    while n < 5
        n += 1
        each y in xs
            if y == 1
                break
    then
        show("while finished")
    show("DONE")
    return
