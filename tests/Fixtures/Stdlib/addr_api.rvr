module Tests/Stdlib/AddrApi

import IO/Console
# Addr: an address with no pointee type (LLVM `ptr`).
# Two addresses are compared by identity (`===` / `!==`). An address moves by a ByteSize with `+%` and `-%`, and
# `b -% a` is the distance from `a` to `b`. All three wrap around and check no bounds.
routine start()
    var u64_0x1000: U64 = 0x1000
    var a = u64_0x1000.to[Addr]()
    var u64_0x2000: U64 = 0x2000
    var b = u64_0x2000.to[Addr]()

    show(f"a: {a}")
    show(f"b: {b}")

    # Moving forward and back by a ByteSize
    show(f"a +% 256b: {a +% 256b}")
    show(f"b -% 256b: {b -% 256b}")
    var step = ByteSize(bytes: 16)
    show(f"a +% step * 2: {a +% step * 2}")

    # The distance between two addresses
    var distance = b -% a
    show(f"b -% a in bytes: {distance.byte_size()}")
    show(f"a +% (b -% a) === b: {a +% distance === b}")

    # Wrapping: back past the address 0 and forward again
    show(f"a -% 8192b +% 8192b === a: {a -% 8192b +% 8192b === a}")

    # Identity
    show(f"a === a: {a === a}")
    show(f"a === b: {a === b}")
    show(f"a !== b: {a !== b}")

    # The address 0
    show(f"Addr.hollow().is_hollow(): {Addr.hollow().is_hollow()}")
    show(f"a.is_not_hollow(): {a.is_not_hollow()}")

    # Alignment: to a buildtime power of two, or to a ByteSize known while the program runs
    var u64_0x1003: U64 = 0x1003
    var c = u64_0x1003.to[Addr]()
    show(f"c.align_up[16](): {c.align_up[16]()}")
    show(f"c.align_down[16](): {c.align_down[16]()}")
    show(f"c.is_aligned[16](): {c.is_aligned[16]()} b.is_aligned[4096](): {b.is_aligned[4096]()}")
    show(f"b.align_up[4096]() === b: {b.align_up[4096]() === b}")
    show(f"c.align_up(by: 8b): {c.align_up(by: 8b)} c.align_down(by: 8b): {c.align_down(by: 8b)}")
    var odd = try c.align_up(by: 12b)
    show(f"align to 12b: {odd.is_present()}")
    var u64_last: U64 = 0xFFFF_FFFF_FFFF_FFF9
    var last = u64_last.to[Addr]()
    var past = try last.align_up[16]()
    show(f"align past the end: {past.is_present()}")

    show("DONE")
    return
