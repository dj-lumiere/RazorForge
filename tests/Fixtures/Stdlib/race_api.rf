module Tests/Stdlib/RaceApi

# race() over a `List[Agent[T]]`. Every `agent f(...)` call yields the ONE concrete type Agent[T], so
# Agents over different routines live together in one list. `agents.race()` starts every Agent nothing
# started (with `start_now()`) and drives the whole set CONCURRENTLY until the first finishes, returning
# that winner's value. At race()'s return the winner is freed and every loser is abandoned (a parked
# fiber tears down via its shadow stack, a still-running thread is joined then discarded).

import IO/Console
# Quick competitor: parks briefly, then wins the race.
routine quick(x: S64) -> S64
    waitfor(5ms)
    return x + 1

# Slow competitor: takes much longer, so it loses and is abandoned at teardown.
routine slow(x: S64) -> S64
    waitfor(60ms)
    return x * 2

# Two nap competitors: the shorter park wins regardless of insertion order.
routine nap(label: S64, ms: S64) -> S64
    waitfor(Duration.from_milliseconds(ms: ms))
    return label

routine start()
    # Mixed set: a quick routine vs a slow one. The quick one wins, the slow one is abandoned.
    var mixed = List[Agent[S64]]()
    mixed.add_last(value: quick.to[Agent](x: 41))
    mixed.add_last(value: slow.to[Agent](x: 10))
    show(f"mixed => {mixed.race()}")

    # Same-routine set: the shortest nap wins (returns its own label, 7).
    var coros = List[Agent[S64]]()
    coros.add_last(value: nap.to[Agent](label: 3, ms: 40))
    coros.add_last(value: nap.to[Agent](label: 7, ms: 5))
    show(f"coros => {coros.race()}")
    return
