module Tests/Stdlib/NamedArgumentsApi

import IO/Console
# Arguments without a label fill the parameters in order, labels pick one.
# Default values + reordering also exercised here.

routine subtract(a: S64, b: S64) -> S64
    return a - b

routine greet(name: Text, prefix: Text = "Hello", suffix: Text = "!") -> Text
    return prefix + ", " + name + suffix

routine start()
    # Multi-param: must be named
    show(f"subtract: {subtract(a: 10, b: 3)}")
    # Named-arg reordering
    show(f"subtract reordered: {subtract(b: 3, a: 10)}")

    # Defaults
    show(f"greet defaults: {greet(name: "World")}")
    show(f"greet custom prefix: {greet(name: "World", prefix: "Hi")}")
    show(f"greet all: {greet(name: "World", prefix: "Hey", suffix: "?")}")
    # Reordered with defaults
    show(f"greet reordered: {greet(suffix: ".", name: "World")}")

    # Without labels: in the order of the parameters
    show(f"greet in order: {greet("World", "Hey", "?")}")
    show(f"greet in order then label: {greet("World", suffix: ".")}")

    show("DONE")
    return
