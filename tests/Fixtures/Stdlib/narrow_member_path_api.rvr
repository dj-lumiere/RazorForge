module Tests/Stdlib/NarrowMemberPathApi

import IO/Console

record Leaf
    name: Text

record Mid
    leaf: Leaf?

record Top
    mid: Mid?
    note: Text?

routine deep(t: Top) -> Text
    if t.mid is None
        return "no mid"
    if t.mid.leaf is None
        return "no leaf"
    return t.mid.leaf.name

routine killed(t: Top) -> Text
    if t.note is None
        return "none"
    var a = t.note
    t.note = none
    return a

routine via_when(t: Top) -> Text
    when t.note
        is None => return "n"
        else => show("ok")
    return t.note

routine start()
    var t = Top(mid: Mid(leaf: Leaf(name: "deep")), note: "hi")
    show(deep(t: t))
    show(killed(t: t))
    show(via_when(t: Top(mid: none, note: "w")))
    return
