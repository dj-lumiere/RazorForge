module Tests/Stdlib/ListAddRangeApi

# add_range adds every element of an iterable at the back: another list and a set.

import IO/Console

routine start()
    var xs: List[S64] = [0]
    var ys: List[S64] = [1, 2]
    xs.add_range(you: ys)
    show(f"{xs}")
    var more: Set[S64] = {7}
    xs.add_range(you: more)
    show(f"{xs}")
    show(f"{ys}")
    return
