module Tests/Stdlib/CoroSuspendedApi

# `f.to[Work](...)` over a plain routine yields a Work[T]. `retrieve()` starts it as a fiber
# (`start_now()`), drives it to completion (through every rf_coro_yield) and returns its value.
# Dropping a never-retrieved handle abandons it.

import IO/Console
routine compute(x: S64) -> S64
    return x * 2

routine counter() -> S64
    var n = 10
    C::rf_coro_yield()
    n = n + 5
    C::rf_coro_yield()
    n = n + 5
    return n

routine start()
    var c = compute.to[Work](x: 21)
    show(f"compute => {c.retrieve()}")

    var k = counter.to[Work]()
    show(f"counter => {k.retrieve()}")
    return
