module Tests/Stdlib/NumericLiteralsApi

import IO/Console
# Numeric literal forms — decimal, hex, binary, octal (if any), with type suffixes
# and digit separators.
routine start()
    # Decimal
    show(f"decimal: {12345}")
    show(f"decimal with separator: {1_234_567}")
    show(f"negative: {-42}")

    # Hex
    var u32_0xff: U32 = 0xFF
    show(f"hex 0xff: {u32_0xff}")
    var u32_0xdead_beef: U32 = 0xDEAD_BEEF
    show(f"hex 0xDEAD_BEEF: {u32_0xdead_beef}")
    var u32_0xabcd: U32 = 0xABCD
    show(f"hex (mixed case): {u32_0xabcd}")

    # Binary
    var u8_0b1010: U8 = 0b1010
    show(f"binary 0b1010: {u8_0b1010}")
    var u8_0b1100_1100: U8 = 0b1100_1100
    show(f"binary with separator: {u8_0b1100_1100}")

    # Same value, different bases
    var u32_255: U32 = 255
    show(f"255 == 0xff: {u32_255 == u32_0xff}")
    var u32_0b1111_1111: U32 = 0b1111_1111
    show(f"255 == 0b1111_1111: {u32_255 == u32_0b1111_1111}")

    # Float literals
    show(f"float: {3.14}")
    show(f"scientific: {1.5e3}")
    show(f"neg scientific: {2.5e-2}")

    # Bool
    show(f"true: {true}")
    show(f"false: {false}")

    show("DONE")
    return
