module Tests/Stdlib/RuntimeErrorArithmeticApi

import IO/Console
# Runtime arithmetic errors caught via the stdlib `try_*` family
# (`try_add`/`try_sub`/`try_mul`/`try_pow` etc.) and `try_*` on division/abs.
# These are the safe (`try_`) variants of the failable operator methods
# (`add!`/`sub!`/`mul!`/`floordiv!`/`mod!`/`pow!`/`neg!`/`abs!`), so they
# are called in method form on the receiver.
routine start()
    # --- Checked overflow ---
    show(f"try_add S64_MAX + 1: {try S64_MAX.add(you: 1)}")
    show(f"try_add S64_MAX + 0: {try S64_MAX.add(you: 0)}")
    show(f"try_sub S64_MIN - 1: {try S64_MIN.sub(you: 1)}")
    show(f"try_mul S64_MAX * 2: {try S64_MAX.mul(you: 2)}")
    show(f"try_mul S64_MAX * 1: {try S64_MAX.mul(you: 1)}")
    show(f"try_pow 2 ** 62: {try 2.pow(exp: 62)}")
    show(f"try_pow 2 ** 63: {try 2.pow(exp: 63)}")

    # --- U64 unsigned underflow ---
    var u64_0: U64 = 0
    var u64_1: U64 = 1
    show(f"try_sub 0u64 - 1: {try u64_0.sub(you: u64_1)}")
    var u64_5: U64 = 5
    var u64_3: U64 = 3
    show(f"try_sub 5u64 - 3: {try u64_5.sub(you: u64_3)}")

    # --- Division: by zero throws ---
    show(f"try_div 10 / 0: {try 10.floordiv(you: 0)}")
    show(f"try_div 10 / 2: {try 10.floordiv(you: 2)}")
    show(f"try_mod 10 % 0: {try 10.mod(you: 0)}")
    show(f"try_mod 10 % 3: {try 10.mod(you: 3)}")

    # --- Unary -: S64_MIN negation overflows ---
    show(f"try_neg S64_MIN: {try S64_MIN.neg()}")
    show(f"try_neg 5: {try 5.neg()}")

    # --- abs on S64_MIN ---
    show(f"try_abs S64_MIN: {try S64_MIN.abs()}")
    show(f"try_abs -5: {try (-5).abs()}")

    # --- Operator-form recovery: `try a + b` ≡ `try a.add(you: b)` (checked-arith operator
    #     overflow is recovered as a whole-expression composition, not just the method form) ---
    show(f"try + overflow: {try S64_MAX + 1}")
    show(f"try + ok: {try S64_MAX + 0}")
    show(f"try * overflow: {try S64_MAX * 2}")
    show(f"try // by zero: {try 10 // 0}")
    show(f"try // ok: {try 10 // 2}")
    show(f"try % by zero: {try 10 % 0}")
    # nested checked-arith composition: (S64_MAX + 1) overflows before the divide
    show(f"try nested: {try (S64_MAX + 1) // 2}")
    # grab keeps the caught crashable
    var g = check S64_MAX * 2
    when g
        is IntegerOverflowError => show("grab *: caught IntegerOverflowError")
        is S64 as n => show(f"grab *: {n}")
        else as e => show("grab *: other")

    show("DONE")
    return
