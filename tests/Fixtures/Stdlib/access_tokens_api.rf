module Tests/Stdlib/AccessTokensApi

import IO/Console
# A `modifying` / `viewing` block over two tokens checks that they are different entities, so an element of one can be
# held while the other grows: two tokens a routine takes may be the same list, and holding an element of one while the
# other changes shape is a build error (RF-S640) outside such a block. A `viewing` target of a write token narrows it.

record Point
    x: S64
    y: S64

routine tokens_grow_while_held(x: Modifying[List[Point]], y: Modifying[List[Point]])
    modifying x as a, y as b
        var p = a.modify_at(index: 0)
        each i in 1 to 100
            b.add_last(value: Point(x: i, y: i))
        p.x = 999
    return

routine tokens_merge(into: Modifying[List[S64]], from: Viewing[List[S64]])
    modifying into, viewing from
        each v in from
            into.add_last(value: v)
    return

routine tokens_total(items: Modifying[List[S64]]) -> S64
    var sum = 0
    viewing items
        each v in items
            sum += v
    return sum

routine start()
    var s = List[Point]()
    s.add_last(value: Point(x: 0, y: 0))
    var t = List[Point]()
    tokens_grow_while_held(x: s, y: t)
    show(f"held: {s[0].x}, grown: {t.count()}")
    var a = [1, 2]
    var b = [3, 4]
    tokens_merge(into: a, from: b)
    show(a)
    show(tokens_total(items: a))
    show("DONE")
    return
