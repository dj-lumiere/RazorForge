module Tests/Stdlib/DerivedDisplayTeardownApi

import IO/Console
# The represent and diagnose the builder writes for a type build their text piece by piece and release every piece
# they no longer need: a record and an entity with a Text member, nested records and entities, a container holding
# them and a variant member. Each is shown many times in a loop, so a piece left behind would pile up.

record Tag
    name: Text

entity Box
    name: Text

record Pair
    left: Tag
    note: Text

entity Shelf
    label: Text
    tag: Tag
    box: Box

record Holder
    value: Text | S64

routine start()
    var t = Tag(name: "tag")
    var b = Box(name: "box")
    var p = Pair(left: Tag(name: "left"), note: "note")
    var s = Shelf(label: "shelf", tag: Tag(name: "inner"), box: Box(name: "inside"))
    var h = Holder(value: "text member")
    var tags = [Tag(name: "a"), Tag(name: "b")]
    var boxes = List[Box]()
    boxes.add_last(value: Box(name: "c"))
    var total: U64 = 0
    each i in 0 til 200
        total = total + t.represent().count() + t.diagnose().count()
        total = total + b.represent().count() + b.diagnose().count()
        total = total + p.represent().count() + p.diagnose().count()
        total = total + s.represent().count() + s.diagnose().count()
        total = total + h.represent().count() + h.diagnose().count()
        total = total + tags.represent().count() + boxes.diagnose().count()
    show(f"{t} {t:?}")
    show(f"{b} {b:?}")
    show(f"{p} {p:?}")
    show(f"{s} {s:?}")
    show(f"{h} {h:?}")
    show(f"{tags} {tags:?}")
    show(f"{boxes} {boxes:?}")
    show(f"total {total}")
    return
