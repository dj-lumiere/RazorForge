module Tests/Stdlib/TcheckD128Transcendentals

import IO/Console
# D128 erf/erfc run the continued fraction at F256 width with a reduced mid-branch level count
# (lm=72, vs the full 120 the F256 type itself needs for 237 bits); the |z|>=3.1 tail keeps 120.
# These cover the mid branch (|z|<3.1) and the tail (|z|>=3.1) and must reproduce the full-level
# octuple result exactly.
routine start()
    var d128_1_0: D128 = 1.0
    show(d128_1_0.erf().represent())
    var d128_0_5: D128 = 0.5
    show(d128_0_5.erf().represent())
    var d128_3_5: D128 = 3.5
    show(d128_3_5.erf().represent())
    var d128_minus_2_0: D128 = -2.0
    show(d128_minus_2_0.erf().represent())
    show(d128_1_0.erfc().represent())
    var d128_4_0: D128 = 4.0
    show(d128_4_0.erfc().represent())
    var d128_minus_1_5: D128 = -1.5
    show(d128_minus_1_5.erfc().represent())
    return
