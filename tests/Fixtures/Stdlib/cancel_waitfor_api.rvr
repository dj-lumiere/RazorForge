module Tests/Stdlib/CancelWaitforApi

# A cancel ends a waitfor in progress: on a fiber (start_now) and on a thread of its own (start_apart) the
# work stops well before its 3s wait would end.

import IO/Console

routine nap() -> S64
    waitfor(3s)
    return 1

routine start()
    var job = nap.to[Work]()
    job.start_now()
    waitfor(50ms)
    var before = Clock.monotonic()
    job.cancel()
    when check job.retrieve()
        is S64 as n => show(f"finished {n}")
        is CancelRequested => show("cancelled")
        is Crashables as e => show(e.crash_message())
    var took = Clock.monotonic() - before
    show(took < 1s)
    var apart = nap.to[Work]()
    apart.start_apart()
    waitfor(50ms)
    var before2 = Clock.monotonic()
    apart.cancel()
    when check apart.retrieve()
        is S64 as n => show(f"finished {n}")
        is CancelRequested => show("cancelled")
        is Crashables as e => show(e.crash_message())
    show(Clock.monotonic() - before2 < 1s)
    return
