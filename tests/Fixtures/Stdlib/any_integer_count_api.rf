module Tests/Stdlib/AnyIntegerCountApi

# A subscript index and a shift amount may be any integer type. A negative one crashes, and a shift by more than the
# width gives 0 (or the sign fill).

import IO/Console

routine start()
    var xs = [10, 20, 30]
    var a: S64 = 1
    var b: U32 = 2
    var c: U8 = 0
    show(f"{xs[a]} {xs[b]} {xs[c]}")
    xs[a] = 5
    show(xs[1])
    var t = "hello"
    show(t[a])
    var n: S64 = 3
    var x: S64 = 1
    show(x << n)
    x <<= n
    show(x)
    var u: U8 = 200
    show(u >> n)
    var far: U64 = 100
    show(x << far)
    var minus: S64 = -16
    show(minus >> far)
    return
