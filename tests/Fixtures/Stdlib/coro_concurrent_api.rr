module Tests/Stdlib/CoroConcurrentApi

# `f.to[Work](...)` builds a Work and starts nothing. `retrieve()` starts it (with `start_now()`) and
# waits until THAT handle finishes. A `waitfor` inside the work PARKS the fiber instead of blocking
# its thread — proven here by two jobs, each parking on a timer, both completing (no deadlock, no
# busy-block).

import IO/Console
routine slow_double(x: S64) -> S64
    waitfor(20ms)  # parks under the scheduler; the sibling runs while we wait
    return x * 2

routine fast_inc(x: S64) -> S64
    waitfor(5ms)
    return x + 1

routine start()
    var a = slow_double.to[Work](x: 21)  # Work[S64], not started
    var b = fast_inc.to[Work](x: 41)  # Work[S64], not started
    show(f"a => {a.retrieve()}")  # starts a and waits until it finishes
    show(f"b => {b.retrieve()}")  # starts b and waits until it finishes
    return
