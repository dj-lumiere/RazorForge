module Tests/Stdlib/TupleHashableApi

import IO/Console
# A tuple of hashable parts is itself Hashable: a Set or a Dict keys on it.

routine start()
    var seen = Set[(S64, S64)]()
    drop seen.add((1, 2))
    drop seen.add((3, 4))
    drop seen.add((1, 2))
    show(f"count: {seen.count()}")
    show(f"has (1, 2): {seen.has((1, 2))}")
    show(f"has (2, 1): {seen.has((2, 1))}")

    var names = Dict[(Text, S64), Bool]()
    names[("a", 1)] = true
    names[("b", 2)] = false
    show(f"a1: {names[("a", 1)]}")
    show(f"has b2: {names.has_key(("b", 2))}")
    show(f"has a2: {names.has_key(("a", 2))}")
    show("DONE")
    return
