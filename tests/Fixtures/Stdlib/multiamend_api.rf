module Tests/Stdlib/MultiamendApi

import IO/Console
# `multiamend` takes two exclusive holds at once (address order, once for the same handle), and `using ... as (a, b)`
# names the two tokens.

entity Account
    total: S64

routine start()
    var xs = List[Guarded[Account, Exclusive]]()
    xs.add_last(value: Guarded[Account, Exclusive](from: Account(total: 10)))
    xs.add_last(value: Guarded[Account, Exclusive](from: Account(total: 32)))
    using multiamend(first: xs[0], second: xs[1]) as (a, b)
        a.total += b.total
    using multiamend(first: xs[1], second: xs[1]) as (c, d)
        c.total += d.total
    using xs[0].amend() as e
        show(f"{e.total}")
    using xs[1].amend() as f
        show(f"{f.total}")
    show("DONE")
    return
