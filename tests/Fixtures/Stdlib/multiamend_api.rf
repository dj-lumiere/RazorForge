module Tests/Stdlib/MultiamendApi

import IO/Console
# `multiamend` takes two exclusive holds at once (address order), and `using ... as (a, b)` names the two tokens. The
# two handles must be different entities: the same one twice is an AliasedTokensError.

entity Account
    total: S64

routine start()
    var xs = List[Guarded[Account, Exclusive]]()
    xs.add_last(value: Guarded[Account, Exclusive](from: Account(total: 10)))
    xs.add_last(value: Guarded[Account, Exclusive](from: Account(total: 32)))
    using multiamend(first: xs[0], second: xs[1]) as (a, b)
        a.total += b.total
    when check multiamend(first: xs[1], second: xs[1])
        is AliasedTokensError => show("the same handle twice: AliasedTokensError")
        is MultiAmending[Account, Exclusive] => show("not reached")
    using xs[0].amend() as e
        show(f"{e.total}")
    using xs[1].amend() as f
        show(f"{f.total}")
    show("DONE")
    return
