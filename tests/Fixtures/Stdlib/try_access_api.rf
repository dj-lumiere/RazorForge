module Tests/Stdlib/TryAccessApi

import IO/Console
# `try modifying g as m` is `try g.modify_enter()`: inside the block `m` is a Maybe of the token, present when the
# block entered `g`, and `when` branches on it. Entering fails when this agent has `g` open already (a routine called
# from inside a block that opened it), so `try` gives none there. Only an entered target is given up at the block's
# end. With several targets each name is a Maybe of its own.

entity Counter
    value: S64

routine Counter.bump(inc: S64)
    me.value = me.value + inc
    return

routine try_bump(s: Guarded[Counter, Exclusive]) -> Text
    try modifying s as entered
        when entered
            is None => return "already open"
            else as c =>
                c.bump(inc: 1)
                return "bumped"
    return "unreachable"

routine try_both(s: Guarded[Counter, Exclusive], r: Guarded[Counter, MultiRead]) -> Text
    try modifying s as first, viewing r as second
        when first
            is None => return "not both"
            else as a =>
                when second
                    is None => return "not both"
                    else as b =>
                        a.bump(inc: b.value)
                        return "both"
    return "unreachable"

routine start()
    var s = Guarded[Counter, Exclusive](from: Counter(value: 10))
    var r = Guarded[Counter, MultiRead](from: Counter(value: 1))

    show(try_bump(s: s))
    modifying s as held
        held.bump(inc: 5)
        show(try_bump(s: s))
    # The access was given up at the block's end, so this one enters again.
    show(try_bump(s: s))

    show(try_both(s: s, r: r))
    modifying s as held
        show(try_both(s: s, r: r))

    modifying s as c
        show(f"value: {c.value}")

    show("DONE")
    return
