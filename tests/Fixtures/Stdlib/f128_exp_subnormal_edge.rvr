module Tests/Stdlib/F128ExpSubnormalEdge

import IO/Console
# B128 exp at the bottom of the subnormal range: inputs within 3 bit patterns of ln(t) for the targets below. Near
# 2^-16495 the accurate retry can land one binade lower, so the result rounds from the top significand bit
# alone (a 128-bit shift by 128 before the fix). Raw bits are printed; the expected values are mpmath's exp
# rounded to nearest-even binary128.

routine start()
    show(f"exp = 2^-16495, bits -3: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF31).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits -2: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF32).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits -1: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF33).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits +0: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF34).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits +1: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF35).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits +2: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF36).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16495, bits +3: {B128.from_bits(bits: 0xC00C654BB3B2C73EBB059FABB506FF37).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits -3: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96271).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits -2: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96272).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits -1: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96273).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits +0: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96274).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits +1: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96275).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits +2: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96276).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16494, bits +3: {B128.from_bits(bits: 0xC00C6546282207802C89D24D65E96277).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits -3: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A9488).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits -2: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A9489).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits -1: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948A).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits +0: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948B).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits +1: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948C).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits +2: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948D).exp_unchecked().to_bits()}")
    show(f"exp = 1.5 * 2^-16494, bits +3: {B128.from_bits(bits: 0xC00C6542E9BD89E8398053F6943A948E).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits -3: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B0).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits -2: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B1).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits -1: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B2).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits +0: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B3).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits +1: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B4).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits +2: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B5).exp_unchecked().to_bits()}")
    show(f"exp = 2^-16493, bits +3: {B128.from_bits(bits: 0xC00C65409C9147C19E0E04EF16CBC5B6).exp_unchecked().to_bits()}")
    return
