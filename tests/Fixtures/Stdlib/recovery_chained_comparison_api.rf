module Tests/Stdlib/RecoveryChainedComparisonApi

import IO/Console
# Every operand of a chained comparison is evaluated once, eagerly, left to right, before any comparison: only
# the comparisons stop at the first false link. So a failure in any operand is a failure point a recovery
# keyword recovers, the last operand included, even when an earlier link is already false.

routine noisy(label: Text, value: S32) -> S32
    show(f"  eval {label}")
    return value

routine in_band(a: S32, b: S32, hi: S32) -> Bool
    return 0 <= a // b <= hi

routine start()
    var zero = 0_s32
    show(f"first: {try 10 // zero < 5 < 7}")
    show(f"middle: {try 1 < 10 // zero < 7}")
    show(f"last: {try 1 < 5 < 10 // zero}")
    show(f"last after a false link: {try 9 < 5 < 10 // zero}")
    show(f"grab last: {grab 1 < 5 < 10 // zero}")
    show(f"lookup middle: {lookup 1 < 10 // zero < 7}")
    show(f"no failure: {try 1 < 10 // 2 < 7}")
    show(f"in a helper: {try in_band(a: 4, b: zero, hi: 9)}")
    show(f"helper ok: {try in_band(a: 8, b: 2, hi: 9)}")
    show("order:")
    var result = noisy(label: "a", value: 9) < noisy(label: "b", value: 5) < noisy(label: "c", value: 7)
    show(f"result: {result}")
    show("DONE")
    return
