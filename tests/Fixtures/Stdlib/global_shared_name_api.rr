module Tests/Stdlib/GlobalSharedNameApi

import IO/Console
# The global_api fixture has globals named `base` and `greeting` too. Each module keeps its own, and a
# global's initializer reads the globals of its own module.
global base: Text = "shared name"
global greeting: Text = f"own {base}"

routine start()
    show(f"{greeting}")
    show("DONE")
    return
