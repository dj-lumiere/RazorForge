module Tests/Stdlib/F128LogTableBoundary

import IO/Console
# B128 log where the crude log2 of the CORE-MATH reduction overshoots an index boundary: significands just below
# 2^(k / 2^20) for k = 29, 256, 285, in every binade (subnormals included). There m * r falls below 1 and
# CORE-MATH's logq.c is off by about 2^-20. Raw bits are printed; the expected values are mpmath's ln rounded to
# nearest-even binary128. "last + 1 ulp" and the last two inputs are outside the ranges.
routine start()
    show(f"F64 0x3FF0001419F90FEC widened: {B128.from_bits(bits: 0x3FFF0001419F90FEC000000000000000).ln_unchecked().to_bits()}")
    show(f"k = 29, first: {B128.from_bits(bits: 0x3FFF0001419F90000000000000000000).ln_unchecked().to_bits()}")
    show(f"k = 29, middle: {B128.from_bits(bits: 0x3FFF0001419F9207CC927853EB477DCF).ln_unchecked().to_bits()}")
    show(f"k = 29, last: {B128.from_bits(bits: 0x3FFF0001419F940F9924F0A7D68EFB9F).ln_unchecked().to_bits()}")
    show(f"k = 29, last + 1 ulp: {B128.from_bits(bits: 0x3FFF0001419F940F9924F0A7D68EFBA0).ln_unchecked().to_bits()}")
    show(f"k = 29, middle * 2: {B128.from_bits(bits: 0x40000001419F9207CC927853EB477DCF).ln_unchecked().to_bits()}")
    show(f"k = 29, middle / 2: {B128.from_bits(bits: 0x3FFE0001419F9207CC927853EB477DCF).ln_unchecked().to_bits()}")
    show(f"k = 29, middle * 2^1000: {B128.from_bits(bits: 0x43E70001419F9207CC927853EB477DCF).ln_unchecked().to_bits()}")
    show(f"k = 29, middle * 2^-16000: {B128.from_bits(bits: 0x017F0001419F9207CC927853EB477DCF).ln_unchecked().to_bits()}")
    show(f"k = 29, middle, subnormal: {B128.from_bits(bits: 0x000000000000010001419F9207CC9278).ln_unchecked().to_bits()}")
    show(f"k = 256, first: {B128.from_bits(bits: 0x3FFF000B175EF8000000000000000000).ln_unchecked().to_bits()}")
    show(f"k = 256, middle: {B128.from_bits(bits: 0x3FFF000B175EFB7BF795D51F8A1D7539).ln_unchecked().to_bits()}")
    show(f"k = 256, last: {B128.from_bits(bits: 0x3FFF000B175EFEF7EF2BAA3F143AEA73).ln_unchecked().to_bits()}")
    show(f"k = 256, last + 1 ulp: {B128.from_bits(bits: 0x3FFF000B175EFEF7EF2BAA3F143AEA74).ln_unchecked().to_bits()}")
    show(f"k = 256, middle * 2: {B128.from_bits(bits: 0x4000000B175EFB7BF795D51F8A1D7539).ln_unchecked().to_bits()}")
    show(f"k = 256, middle / 2: {B128.from_bits(bits: 0x3FFE000B175EFB7BF795D51F8A1D7539).ln_unchecked().to_bits()}")
    show(f"k = 256, middle * 2^1000: {B128.from_bits(bits: 0x43E7000B175EFB7BF795D51F8A1D7539).ln_unchecked().to_bits()}")
    show(f"k = 256, middle * 2^-16000: {B128.from_bits(bits: 0x017F000B175EFB7BF795D51F8A1D7539).ln_unchecked().to_bits()}")
    show(f"k = 256, middle, subnormal: {B128.from_bits(bits: 0x00000000000001000B175EFB7BF795D5).ln_unchecked().to_bits()}")
    show(f"k = 285, first: {B128.from_bits(bits: 0x3FFF000C590C80000000000000000000).ln_unchecked().to_bits()}")
    show(f"k = 285, middle: {B128.from_bits(bits: 0x3FFF000C590C811FCA1AE329FD8D5012).ln_unchecked().to_bits()}")
    show(f"k = 285, last: {B128.from_bits(bits: 0x3FFF000C590C823F9435C653FB1AA024).ln_unchecked().to_bits()}")
    show(f"k = 285, last + 1 ulp: {B128.from_bits(bits: 0x3FFF000C590C823F9435C653FB1AA025).ln_unchecked().to_bits()}")
    show(f"k = 285, middle * 2: {B128.from_bits(bits: 0x4000000C590C811FCA1AE329FD8D5012).ln_unchecked().to_bits()}")
    show(f"k = 285, middle / 2: {B128.from_bits(bits: 0x3FFE000C590C811FCA1AE329FD8D5012).ln_unchecked().to_bits()}")
    show(f"k = 285, middle * 2^1000: {B128.from_bits(bits: 0x43E7000C590C811FCA1AE329FD8D5012).ln_unchecked().to_bits()}")
    show(f"k = 285, middle * 2^-16000: {B128.from_bits(bits: 0x017F000C590C811FCA1AE329FD8D5012).ln_unchecked().to_bits()}")
    show(f"k = 285, middle, subnormal: {B128.from_bits(bits: 0x00000000000001000C590C811FCA1AE3).ln_unchecked().to_bits()}")
    show(f"1 + 2^-16: {B128.from_bits(bits: 0x3FFF0001000000000000000000000000).ln_unchecked().to_bits()}")
    show(f"1.5: {B128.from_bits(bits: 0x3FFF8000000000000000000000000000).ln_unchecked().to_bits()}")
    var b128_0_0: B128 = 0.0
    show(f"+0 and -0 (both -infinity): {b128_0_0.ln_unchecked().to_bits()} {(-b128_0_0).ln_unchecked().to_bits()}")
    return
