module Tests/Stdlib/Bf16Api

import IO/Console
# BF16 (bfloat16): bit patterns, conversions to and from B32/B64, text, comparison, bytes, arithmetic (B32 then one
# rounding) and the correctly rounded library functions.
routine start()
    # bit patterns and exact widening
    var one = BF16.from_bits(bits: 0x3F80)
    show(f"one: {one} bits {one.to_bits()} as B32 {one.to[B32]()} as B64 {one.to[B64]()}")
    var pi = 3.14159265358979.to[BF16]()
    show(f"pi: {pi} bits {pi.to_bits()} diagnose {pi.diagnose()}")

    # narrowing rounds to nearest, ties to even
    show(f"1 + 2^-8 (tie, even stays): {B32.from_bits(bits: 0x3F808000).to[BF16]().to_bits()}")
    show(f"1 + 3 2^-8 (tie, odd goes up): {B32.from_bits(bits: 0x3F818000).to[BF16]().to_bits()}")
    show(f"just above the tie: {B32.from_bits(bits: 0x3F808001).to[BF16]().to_bits()}")

    # range: B32's exponent, so large values stay finite, and past the largest finite value is infinity
    show(f"1e38: {1.0e38.to[BF16]()}")
    show(f"3.4e38: {3.4e38.to[BF16]()} (infinite {3.4e38.to[BF16]().is_infinite()})")
    show(f"smallest subnormal: {BF16.from_bits(bits: 1)} from B64 2^-133: {B64.from_bits(bits: 0x37A0000000000000).to[BF16]().to_bits()}")
    show(f"2^-134 (half the smallest subnormal, ties to 0): {B64.from_bits(bits: 0x3790000000000000).to[BF16]().to_bits()}")

    # one rounding from B64, where going through B32 first would round twice
    var twice = B64.from_bits(bits: 0x3FF0100000000001)
    show(f"direct: {twice.to[BF16]().to_bits()} via B32: {twice.to[B32]().to[BF16]().to_bits()}")

    # specials
    var quiet_nan = B32.from_bits(bits: 0x7FC00000).to[BF16]()
    show(f"nan: {quiet_nan} is_nan {quiet_nan.is_nan()} signaling {BF16.signaling_nan().is_signaling()}")
    show(f"-0: {BF16.from_bits(bits: 0x8000)} is_zero {BF16.from_bits(bits: 0x8000).is_zero()} signbit {BF16.from_bits(bits: 0x8000).signbit()}")

    # text: shortest round-trip form, and parsing with one rounding
    show(f"0.1 parsed: {"0.1".to[BF16]()} bits {"0.1".to[BF16]().to_bits()}")
    show(f"1e-40 parsed: {"1e-40".to[BF16]()}")
    show(f"-inf parsed: {"-inf".to[BF16]()}")
    when try "abc".to[BF16]()
        is None => show("abc: rejected")
        else as v => show(f"abc: {v}")

    # comparison: IEEE semantics
    var a = "1.5".to[BF16]()
    var b = "2".to[BF16]()
    show(f"1.5 < 2: {a < b}  1.5 == 1.5: {a == "1.5".to[BF16]()}  +0 == -0: {BF16.from_bits(bits: 0) == BF16.from_bits(bits: 0x8000)}  nan == nan: {quiet_nan == quiet_nan}")

    # bytes
    var le = pi.to_bytes_le()
    var be = pi.to_bytes_be()
    show(f"pi bytes le: {le[0]} {le[1]}  be: {be[0]} {be[1]}")

    # arithmetic: worked on the B32 values and rounded once
    var x = "1.5".to[BF16]()
    var y = "0.1".to[BF16]()
    var two = "2".to[BF16]()
    show(f"x + y: {x + y}  x - y: {x - y}  x * y: {x * y}  x / y: {x / y}  sqrt(2): {two.sqrt_unchecked()}")
    show(f"-x: {-x}  abs: {(-x).abs()}  floor(2.75): {"2.75".to[BF16]().floor()}  round(2.5): {"2.5".to[BF16]().round()}")
    show(f"next_up(1): {one.next_up().to_bits()}  next_down(1): {one.next_down().to_bits()}  fma: {x.fma_unchecked(b: y, c: one)}")
    var big = "3e38".to[BF16]()
    when try big.add(big)
        is None => show("3e38 + 3e38: overflow")
        else as v => show(f"3e38 + 3e38: {v}")

    # library functions, correctly rounded
    show(f"exp(1): {one.exp_unchecked()}  ln(2): {two.log_unchecked()}  sin(1): {one.sin()}  cbrt(2): {two.cbrt()}")
    show(f"2^10: {two.pow_unchecked("10".to[BF16]())}  atan2(1, 1): {atan2(y: one, x: one)}  hypot(1, 2): {hypot_unchecked(x: one, y: two)}")
    var half = "0.5".to[BF16]()
    var (s1, c1) = one.sincos()
    show(f"exp2m1(1): {one.exp2m1_unchecked()}  exp10m1(1): {one.exp10m1_unchecked()}  log2p1(1): {one.log2p1_unchecked()}  log10p1(9): {"9".to[BF16]().log10p1_unchecked()}")
    show(f"asinpi(0.5): {half.asinpi_unchecked()}  acospi(0.5): {half.acospi_unchecked()}  atanpi(1): {one.atanpi()}  atan2pi(1, 1): {atan2pi(y: one, x: one)}")
    show(f"sincos(1): {s1} {c1}  rsqrt(2): {two.rsqrt_unchecked()}  compound(0.5, 2): {half.compound_unchecked(two)}")
    show(f"hypot(2, 3, 6): {hypot_unchecked(x: two, y: "3".to[BF16](), z: "6".to[BF16]())}")
    return
