module Tests/Stdlib/TextSplitOnceApi

import IO/Console

# `split_once` cuts at the first separator and gives `(before, after)`, or `none` when the separator is not there.

routine cut(text: Text, separator: Text) -> None
    var halves = text.split_once(separator)
    if halves is (Text, Text) as pair
        var (before, after) = pair
        show(f"[{before}] [{after}]")
    else
        show("none")
    return

routine start()
    cut(text: "report.final.txt", separator: ".")
    cut(text: "a=b=c", separator: "=")
    cut(text: "plain", separator: ".")
    cut(text: "key::value", separator: "::")
    cut(text: ".hidden", separator: ".")
    cut(text: "end.", separator: ".")
    return
