module Tests/Stdlib/CoroAsyncWriteApi

# Async I/O parking, write side. `FileManager.write_text` writes a whole file on the runtime's I/O threads.
# Called inside a Work's fiber, the fiber PARKS while the worker writes (the read side does the
# same). Proven here by a round trip: write the file in one Work, then read it back in another and
# confirm the contents. The output path uses the gitignored `.out`
# extension so the test leaves no tracked artifact.

import IO/Console
import IO/File
routine do_write(path: Text, content: Text) -> U64
    FileManager.write_text(at: File(at: path), content: content)
    return FileManager.metadata(at: File(at: path)).size.to[U64]()

routine do_read(path: Text) -> Text
    return FileManager.read_text(at: File(at: path))

routine start()
    var p = "tests/Fixtures/Stdlib/coro_async_write.out"
    drop FileManager.make_file(at: File(at: p), replacing: true)
    var n = do_write.to[Work](path: p, content: "written by coroutine").retrieve()
    show(f"wrote => {n}")
    var back = do_read.to[Work](path: p).retrieve()
    show(f"read => {back}")
    return
