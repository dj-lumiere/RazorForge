module Tests/Stdlib/ReusedNameTeardownApi

import IO/Console
# A name used again for another binding in the same routine: each binding is torn down unless it moved itself,
# whatever another binding of the same name does.

entity Node
    value: S64

routine Node.destruct()
    show(f"ends {me.value}")
    return

routine make(v: S64) -> Node
    return Node(value: v)

routine keep(it: Node)
    show(f"kept {it.value}")
    return

routine start()
    if true
        var tree = make(v: 1)
        show(tree.value)
    if true
        var tree = make(v: 2)
        keep(it: steal tree)
    when try make(v: 3)
        is None => show("none")
        else as tree => keep(it: steal tree)
    when try make(v: 4)
        is None => show("none")
        else as tree => show(tree.value)
    var tree = make(v: 5)
    drop tree
    show("end")
    return
