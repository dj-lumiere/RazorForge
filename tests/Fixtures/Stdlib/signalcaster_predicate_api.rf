module Tests/Stdlib/SignalCasterPredicateApi

# v0.3.0 SignalCaster — CORRECT condvar usage with a shared predicate. The consumer tests a shared
# flag UNDER the monitor lock and only `wait`s while it is unset, so the handoff cannot be lost: the
# consumer parks, the producer sets the flag and casts, and the consumer re-checks the flag on wake.
#
# The predicate cell is a raw `Hijacked[S64]` aliasing a slot on start()'s frame: a raw pointer is
# the simplest copyable cell two Agents can share. Workers may run the two Agents in parallel, so the
# producer writes the cell under the same monitor lock the consumer reads it under.

import IO/Console
routine consumer(sig: SignalCaster, cell: Hijacked[S64]) -> S64
    sig.lock()
    danger
        until cell.peek() != 0  # predicate, tested under the lock
            sig.wait()  # releases the lock while parked, re-acquires on wake
    sig.unlock()
    danger
        return cell.peek()

routine producer(sig: SignalCaster, cell: Hijacked[S64]) -> S64
    sig.lock()
    danger
        cell.poke(value: 42)  # make the predicate true under the lock...
    sig.unlock()
    sig.cast_one()  # ...then wake the waiter
    return 1

routine start()
    var slot = 0
    var sig = SignalCaster()
    danger
        var cell = slot.hijack()  # raw pointer to `slot`, copyable -> both Agents share it
        # Start consumer + producer TOGETHER (`gather`) so the consumer can park on the predicate and
        # the producer can set it + cast. Retrieving the consumer ALONE would hang. Both complete before we
        # read the shared cell, so the frame-aliased slot stays valid. Results in input order: [consumer, producer].
        var results = [
            consumer.to[Agent](sig: steal sig.duplicate(), cell: cell), producer.to[Agent](sig: steal sig, cell: cell),
        ].gather()
        show(f"got={results[0]}")
    return
