module Tests/Stdlib/ChannelBackpressureApi

# v0.3.x M:N + channels — SUSTAINED worker↔worker backpressure. A producer coroutine feeds 500 items
# through a small capacity-4 channel to a single consumer coroutine. With the buffer this small vs the
# volume, the producer repeatedly PARKS on a full channel and the consumer PARKS on an empty one, so the
# run is hundreds of hand-off park/wake cycles bouncing between workers on the pool. The total is
# deterministic (sum 1..500 = 125250) no matter how the pool schedules or steals — a lost wake, a
# double-resume, or a dropped item under backpressure would wrong the sum or hang. The high-volume
# counterpart to channel_workerpool (6 jobs) and channel_rendezvous (3 hand-offs).

import IO/Console
routine produce(out: Transmitter[S64], n: S64) -> S64
    var i = 1
    until i > n
        out.transmit(item: i)
        i = i + 1
    return n

routine consume(inbox: Receiver[S64]) -> S64
    var total = 0
    each v in inbox
        total = total + v
    return total

routine start()
    var (feeder, hop) = make_channel[S64](capacity: 4)

    # `agent f(...)` captures a RECIPE and does not start it — a verb does. The producer is started
    # with `start_now()` (we don't need its count), the consumer is what we await, so `retrieve()`
    # starts + drives it. Both run concurrently on the pool, so the capacity-4 channel hands off under
    # backpressure until the producer's Transmitter drops and the channel closes.
    produce.to[Agent](out: steal feeder, n: 500).start_now()
    var sum = consume.to[Agent](inbox: steal hop).retrieve()
    show(f"backpressure sum 1..500: {sum}")
    return
