module Tests/Stdlib/NumericFloatApi

import IO/Console
# Exercises B16, B32, B64, B128 — basic arithmetic, special values, comparison.
routine start()
    var b32: B32 = 3.14
    var b64: B64 = 2.71828

    show(f"B32: {b32}")
    show(f"B64: {b64}")

    # Arithmetic
    show(f"B32 add: {b32 + 1.0}")
    show(f"B64 sub: {b64 - 1.0}")
    show(f"B32 mul: {b32 * 2.0}")
    show(f"B64 div: {b64 / 2.0}")

    # Comparison
    show(f"B64 1.0 < 2.0: {1.0 < 2.0}")
    show(f"B64 1.0 == 1.0: {1.0 == 1.0}")
    var not_a_number: B64 = nan
    var infinity: B64 = inf
    show(f"B64 NaN == NaN: {not_a_number == not_a_number}")

    # Special values
    show(f"B64 inf: {infinity}")
    show(f"B64 -inf: {-infinity}")
    show(f"B64 isnan(nan): {not_a_number.is_nan()}")
    show(f"B64 isnan(1.0): {1.0.is_nan()}")

    # Conversion
    var to_int: S64 = 3.7.to[S64]()
    show(f"B64->S64 3.7: {to_int}")

    show("DONE")
    return
