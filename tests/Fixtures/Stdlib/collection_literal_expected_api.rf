module Tests/Stdlib/CollectionLiteralExpectedApi

# A collection literal takes its element types from where it goes, the way a bare number does: a protocol
# parameter (`Emittable[U8]`), a concrete collection type, or a dict's entries. Without one it stays List[S64].

import IO/Console
import Collections

routine total(xs: Emittable[U8]) -> U8
    var sum: U8 = 0
    each x in xs
        sum += x
    return sum

routine key_total(entries: Emittable[DictEntry[U16, Text]]) -> U16
    var sum: U16 = 0
    each entry in entries
        sum += entry.key
    return sum

routine start()
    var bytes = List[U8]()
    bytes.add_range(you: [3, 4])
    show(f"{bytes}")
    var ring = RotatableList[S8]()
    ring.add_range(you: [5, 6])
    show(f"{ring.count()}")
    var split: SplitList[S16] = [1, 2, 3]
    show(f"{split.count()}")
    var from_list = total(xs: [5, 6])
    var from_set = total(xs: {7, 8})
    var from_dict = key_total(entries: {1: "a", 2: "b"})
    show(f"{from_list} {from_set} {from_dict}")
    var plain = [1, 2]
    show(f"{plain}")
    return
