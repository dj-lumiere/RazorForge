module Tests/Stdlib/WorkStartHereTokenApi

import IO/Console
# A Work handed a token or a Retained runs on this thread: started with start_here(), retrieved in the routine.

entity Counter
    n: S64

routine bump(c: Modifying[Counter]) -> S64
    c.n += 1
    return c.n

routine start()
    var counter = Counter(n: 0)
    var job = bump.to[Work](c: counter.modify())
    job.start_here()
    var got = job.retrieve()
    var shared = Retained[Counter](from: Counter(n: 5))
    var job2 = bump.to[Work](c: shared.modify())
    job2.start_here()
    var got2 = job2.retrieve()
    show(f"{got} {got2}")
    show("DONE")
    return
