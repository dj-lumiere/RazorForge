module Tests/Stdlib/LambdaCapturesMeApi

import IO/Console
# A lambda made in a member routine of a record may read `me`: it keeps a copy of the record.

record Offset
    n: S64

routine Offset.adder() -> Callable[(S64,), S64]
    return (k: S64) => me.n + k

routine start()
    var o = Offset(n: 10)
    var add = o.adder()
    show(f"10 + 5: {add(5)}")
    o = Offset(n: 20)
    show(f"after a new value, still 10 + 5: {add(5)}")
    return
