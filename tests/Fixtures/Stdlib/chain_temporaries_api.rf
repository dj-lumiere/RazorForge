module Tests/Stdlib/ChainTemporariesApi

import IO/Console
import EmitterTools

# A source made in the call (a range, a literal list) is a temporary that lives to the end of the statement, and the adapter
# built over it reads it there. A token parameter of a member routine's own type parameter (`other: Viewing[TOther]`) is
# given the temporary's place, like any other token parameter.
record Box
    n: S64

routine Box.add_other[TOther](other: Viewing[TOther]) -> S64
needs TOther obeys Emittable[S64]
    return me.n + 1

routine start()
    show(f"chain: {(1 to 3).chain(4 to 5).to[List]()}")
    show(f"chain of chain: {(1 to 2).chain(3 to 4).chain(5 to 6).to[List]()}")
    var named = 10 to 12
    show(f"named then temporary: {named.chain(13 to 14).to[List]()}")
    show(f"temporary then named: {(7 to 8).chain(named).to[List]()}")
    var box = Box(n: 100)
    show(f"member routine: {box.add_other(4 to 8)}")
    return
