module Tests/Stdlib/ReceiverModuleTypeApi

import IO/Console
# A member routine on a generic type whose type argument is this module's own type (`Retained[Tally].total`,
# `List[Duo].sums`) belongs to that one instance: the argument names the module's type and does not declare a type
# parameter.

entity Tally
    n: S64

record Duo
    a: S64
    b: S64

routine Retained[Tally].total() -> S64
    return me.n

routine List[Duo].sums() -> S64
    var s: S64 = 0
    for d in me
        s += d.a + d.b
    return s

routine start()
    var r = Retained(from: Tally(n: 7))
    show(r.total())
    var job = r.total.to[Work]()
    job.start_here()
    show(job.retrieve())
    var duos = [Duo(a: 1, b: 2), Duo(a: 3, b: 4)]
    show(duos.sums())
    return
