module Tests/Stdlib/StealThenRefillApi

import IO/Console
# A local or entity parameter `steal` handed over can take a new value with `=`: the new value is torn down once at
# the end of its scope (or before the next new value), on every path, and the value that left is never torn down
# here (Rust I-unsound port, C46 / C84).

entity Item
    n: S64

routine Item.destruct()
    show(f"destruct {me.n}")
    return

routine keep(i: Item) -> S64
    return i.n

routine refill_param(i: Item) -> S64
    var k = keep(i: steal i)
    i = Item(n: 20)
    return k + i.n

routine in_loop()
    var a = Item(n: 30)
    var turn = 0
    until turn >= 2
        var k = keep(i: steal a)
        a = Item(n: 31 + turn)
        turn += 1
    show("loop done")
    return

routine to_local()
    var a = Item(n: 40)
    var b = Item(n: 41)
    b = steal a
    a = Item(n: 42)
    show(f"b {b.n} a {a.n}")
    return

routine dropped()
    var a = Item(n: 50)
    drop a
    a = Item(n: 51)
    show("dropped done")
    return

routine early(c: Bool) -> S64
    var a = Item(n: 60)
    var k = keep(i: steal a)
    if c
        return k
    a = Item(n: 61)
    return a.n

routine refill_on_one_path(c: Bool)
    var a = Item(n: 70)
    var k = keep(i: steal a)
    if c
        a = Item(n: 71)
    show(f"one path {k}")
    return

routine start()
    show(f"param {refill_param(i: Item(n: 10))}")
    in_loop()
    to_local()
    dropped()
    show(f"early {early(c: true)}")
    show(f"late {early(c: false)}")
    refill_on_one_path(c: true)
    refill_on_one_path(c: false)
    return
