module Tests/Stdlib/DiagnoseTextMemberApi

import IO/Console
# The diagnose the builder writes shows a Text member quoted, with the characters that would hide its value written as
# escapes, so "a, b" in one member never looks like two members. A Text inside a variant member, a list member and a
# crashable's member are quoted the same way. The represent the builder writes shows the Text as it is.

entity Note
    title: Text
    tags: List[Text]
    size: S64

record Slot
    value: Text | S64

crashable NoteError
    note: Text

routine NoteError.crash_message() -> Text
    return "bad note"

routine start()
    var n = Note(title: "a, b \"c\"\n", tags: ["x", "y z"], size: 3)
    var s = Slot(value: "tab\there")
    var e = NoteError(note: "back\\slash")
    show(f"{n}")
    show(f"{n:?}")
    show(f"{s:?}")
    show(f"{e:?}")
    return
