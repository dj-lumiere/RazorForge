module Tests/Stdlib/LifecycleRetainedApi

import IO/Console
# Verifies Retained refcount: destroy fires only when the last strong handle drops.
entity Tracer
    tag: S64

routine Tracer(tag: S32) -> Tracer
    show(f"  create({tag})")
    return Tracer(tag: tag.to[S64]())

@override
routine Tracer.destruct()
    show(f"  destruct({me.tag})")
    return

routine inner()
    show(" inner enter")
    var s32_99: S32 = 99
    var t = Tracer(tag: s32_99)
    var r1 = Retained(from: steal t)
    show(f" after retain, strong={r1.strong_count()}")

    var r2 = r1
    show(f" after r2 = r1.share(), strong={r1.strong_count()}")

    # When inner() returns, r1 and r2 both go out of scope — refcount goes 2->1->0,
    # then destroy fires.
    return

routine start()
    show("--- inner() ---")
    inner()
    show("--- after inner (destruct should have happened) ---")
    show("DONE")
    return
