module Tests/Stdlib/PartialItemsLargeApi

import IO/Console

# A PartialItems of a hundred thousand places: its record is copied with one memmove, not one load and store per place,
# so the build time does not grow with the capacity.

routine start()
    var stack = PartialItems[S64, 100000]()
    var i: S64 = 0
    until i == 50000
        stack.add_last(value: i)
        i += 1
    var total: S64 = 0
    until stack.is_empty()
        total += stack.remove_last()
    show(total)
    var copy = stack
    copy.add_last(value: 7)
    show(f"{stack.count()} {copy.count()} {copy.capacity()}")
    return
