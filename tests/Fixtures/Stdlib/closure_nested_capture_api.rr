module Tests/Stdlib/ClosureNestedCaptureApi

import IO/Console
import EmitterTools
# A capturing lambda inside a capturing lambda: the inner one captures the outer one's parameter,
# the outer one captures a local of the routine.

routine offset_row(dy: S64) -> List[(S64, S64)]
    return (-1 to 1).select(transform: dx given dy => (dx, dy)).to[List]()

routine start()
    var width: S64 = 3
    var grid = (0 til 2).select_chained(transform: y given width => (0 til width).select(transform: x given y => (x, y)).to[List]())
        .to[List]()
    show(f"{grid}")

    var around = (-1 to 1).select_chained(transform: dy => offset_row(dy)).to[List]()
    show(f"{around}")
    show("DONE")
    return
