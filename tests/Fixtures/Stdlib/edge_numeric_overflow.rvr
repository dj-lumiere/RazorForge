module Tests/Stdlib/EdgeNumericOverflow

import IO/Console
# Boundary values for fixed-width integers. Wrap-arithmetic operators (add_wrap)
# expose unchecked wrap; default `+` on integer types is checked / clamping per spec.
routine start()
    # S8 boundaries: [-128, 127]
    var s8_127: S8 = 127
    show(f"S8 max: {s8_127}")
    var s8_minus_128: S8 = -128
    show(f"S8 min: {s8_minus_128}")
    var s8_1: S8 = 1
    show(f"S8 max + 1 (wrap): {s8_127.add_wrap(you: s8_1)}")
    show(f"S8 min - 1 (wrap): {s8_minus_128.sub_wrap(you: s8_1)}")

    # U8 boundaries: [0, 255]
    var u8_255: U8 = 255
    show(f"U8 max: {u8_255}")
    var u8_0: U8 = 0
    show(f"U8 min: {u8_0}")
    var u8_1: U8 = 1
    show(f"U8 max + 1 (wrap): {u8_255.add_wrap(you: u8_1)}")
    show(f"U8 0 - 1 (wrap): {u8_0.sub_wrap(you: u8_1)}")

    # S64 boundaries
    show(f"S64 max + 1 (wrap): {9_223_372_036_854_775_807.add_wrap(you: 1)}")

    # U64 boundaries
    var u64_value: U64 = 18_446_744_073_709_551_615
    show(f"U64 max: {u64_value}")
    var u64_0: U64 = 0
    var u64_1: U64 = 1
    show(f"U64 0 - 1 (wrap): {u64_0.sub_wrap(you: u64_1)}")

    show("DONE")
    return
