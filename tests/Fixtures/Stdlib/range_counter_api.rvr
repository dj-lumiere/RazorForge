module Tests/Stdlib/RangeCounterApi

import IO/Console
import BuilderQuery
# A `for` over a range literal counts. These cover the ends of the types, steps both ways, the loop's
# `break` / `continue` / `return`, and ranges kept in a variable or walked over floats.

routine first_over(limit: S64) -> S64
    for i in 0 til 100
        if i * i > limit
            return i
    return -1

routine walk_by(step: S64) -> Text
    var out = ""
    for i in 10 to 0 by step
        out = out + f"{i} "
    return out

routine start()
    var top = ""
    for i in (S64_MAX - 2) to S64_MAX
        top = top + f"{i - (S64_MAX - 2)} "
    show(f"to S64_MAX: {top}")
    var u8_250: U8 = 250
    var count: S64 = 0
    for b in u8_250 to U8_MAX
        count = count + 1
    show(f"250 to U8_MAX: {count}")
    var bottom = ""
    var u_3: U64 = 3
    var u_0: U64 = 0
    for u in u_3 til u_0 by -1
        bottom = bottom + f"{u} "
    show(f"3 til 0 by -1 (U64): {bottom}")
    show(f"10 to 0 by -3: {walk_by(step: -3)}")
    show(f"10 to 0 by 4: {walk_by(step: 4)}")
    var skipped = ""
    for i in 0 til 10
        if i % 2 == 0
            continue
        if i > 7
            break
        skipped = skipped + f"{i} "
    show(f"odd below 8: {skipped}")
    var inclusive = ""
    for i in 1 to 6
        if i == 2
            continue
        if i == 5
            break
        inclusive = inclusive + f"{i} "
    show(f"1 to 6 skipping 2, stop at 5: {inclusive}")
    show(f"first over 50: {first_over(limit: 50)}")
    var empty: S64 = 0
    for _ in 5 til 5
        empty = empty + 1
    for _ in 5 to 4
        empty = empty + 1
    for _ in 4 to 5 by -1
        empty = empty + 1
    show(f"empty: {empty}")
    var pairs: S64 = 0
    for i in 0 til 4
        for j in i to 3
            pairs = pairs + 1
    show(f"pairs: {pairs}")
    var n: S32 = 3
    var narrow = ""
    for i in 0 til n
        narrow = narrow + f"{i.full_type_name()} "
    show(f"element type: {narrow}")
    var kept = 2 to 8 by 3
    var walked = ""
    for i in kept
        walked = walked + f"{i} "
    show(f"kept range: {walked}")
    var halves = ""
    for x in 0.0 to 1.0 by 0.25
        halves = halves + f"{x} "
    show(f"floats: {halves}")
    var big = ""
    for k in 10.to[Int]() to 12.to[Int]()
        big = big + f"{k} "
    show(f"Int: {big}")
    var evaluated = ""
    var hi: S64 = 3
    for i in 0 til hi
        hi = 10
        evaluated = evaluated + f"{i} "
    show(f"end read once: {evaluated}")
    show("DONE")
    return
