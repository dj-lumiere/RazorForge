module Tests/Stdlib/ValueEqualityApi

import IO/Console
# `==` compares values and `===` asks for the same entity. A record and an entity get `==` without
# `obeys Equatable` when every member variable has one, a record gets a hash the same way, and an
# entity hashes only when it declares `obeys Hashable`.

entity Player
    name: Text

entity Badge
obeys Hashable
    code: Text

record Point
    x: S64
    y: S64

record Named
    name: Text
    size: Integer

routine same[T](a: T, b: T) -> Bool
needs T obeys Equatable
    return a == b

routine start()
    var a = Player(name: "Ada")
    var b = Player(name: "Ada")
    show(f"a == b: {a == b}")
    show(f"a === b: {a === b}")
    show(f"a != other: {a != Player(name: "Bo")}")

    show(f"points equal: {Point(x: 1, y: 2) == Point(x: 1, y: 2)}")
    show(f"points differ: {Point(x: 1, y: 2) != Point(x: 3, y: 2)}")
    show(f"generic same: {same(a: Point(x: 1, y: 2), b: Point(x: 1, y: 2))}")

    var points = Set[Point]()
    drop points.add(value: Point(x: 1, y: 2))
    drop points.add(value: Point(x: 1, y: 2))
    drop points.add(value: Point(x: 3, y: 2))
    show(f"points in set: {points.count()}")

    var built = "Ad" + "a"
    show(f"text hash: {"Ada".hash(k0: 3, k1: 5) == built.hash(k0: 3, k1: 5)}")
    var texts = Set[Text]()
    drop texts.add(value: "Ada")
    show(f"text found: {texts.has(value: built)}")

    var big: Integer = 18446744073709551616
    var two: Integer = 2
    var made = two ** 64
    show(f"integer hash: {big.hash(k0: 3, k1: 5) == made.hash(k0: 3, k1: 5)}")
    var numbers = Set[Integer]()
    drop numbers.add(value: big)
    show(f"integer found: {numbers.has(value: made)}")

    var sizes = Dict[Named, S64]()
    sizes[Named(name: "Ada", size: big)] = 7
    show(f"record key: {sizes[Named(name: built, size: made)]}")

    var badges = Set[Badge]()
    var first = Badge(code: "A1")
    var second = Badge(code: "A1")
    drop badges.add(value: steal first)
    drop badges.add(value: steal second)
    show(f"badges in set: {badges.count()}")
    return
