module Tests/Stdlib/RecordPatternApi

import IO/Console
# A record pattern is written the way the record is built: a member variable takes a value it must equal (`hp: 0`),
# a comparison (`hp: < 5`), an observation (`item: is Weapon as w`) or a name (`hp: as hp`, or `name` alone), and the
# whole value takes a name after it (`is Monster(hp: 0) as m`). In `when` arms and after `if ... is`.

record Weapon
    power: S64

record Shield
    armor: S64

variant Item
    Weapon
    Shield

record Chest
    item: Item

record Monster
    hp: S64
    name: Text

record Wall
    height: S64

variant Cell
    Chest
    Monster
    Wall

routine describe(c: Cell) -> Text
    when c
        is Chest(item: is Weapon as w) => return f"weapon {w.power}"
        is Chest(item: is Shield(armor: as a)) => return f"shield {a}"
        is Chest => return "chest"
        is Monster(hp: 0) as m => return f"dead {m.name}"
        is Monster(hp: < 5, name) => return f"weak {name}"
        is Monster(hp: as health, name: "boss") => return f"boss {health}"
        is Monster(hp) => return f"monster {hp}"
        is Wall(height) => return f"wall {height}"
    return "?"

routine inspect(c: Cell) -> Text
    if c is Monster(hp: 0) as m
        return f"dead {m.name}"
    if c is Monster(name: "boss", hp)
        return f"boss {hp}"
    return "other"

routine start()
    show(describe(c: Chest(item: Weapon(power: 5))))
    show(describe(c: Chest(item: Shield(armor: 2))))
    show(describe(c: Monster(hp: 0, name: "rat")))
    show(describe(c: Monster(hp: 3, name: "bat")))
    show(describe(c: Monster(hp: 30, name: "boss")))
    show(describe(c: Monster(hp: 9, name: "orc")))
    show(inspect(c: Monster(hp: 0, name: "rat")))
    show(inspect(c: Monster(hp: 9, name: "boss")))
    show(inspect(c: Wall(height: 3)))
    show("DONE")
    return
