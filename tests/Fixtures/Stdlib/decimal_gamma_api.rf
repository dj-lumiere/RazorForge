module Tests/Stdlib/DecimalGammaApi

import IO/Console
import Numerics.[Decimal]
# Regression coverage for Decimal.tgamma!/lgamma!, which route through D128's gamma (fast path, then the
# 384-bit tier). validate-stdlib does NOT catch codegen-only errors in such chains, so a fixture must.
routine start()
    danger
        show(f"tgamma(5): {5.to[Decimal]().tgamma()}")
        show(f"tgamma(1): {1.to[Decimal]().tgamma()}")
        show(f"lgamma(10): {10.to[Decimal]().lgamma()}")
    show("DONE")
    return
