module Tests/Stdlib/DecimalGammaApi

import IO/Console
# Regression coverage for Decimal.gamma/ln_gamma, which route through D128's gamma (fast path, then the
# 384-bit tier). validate-stdlib does NOT catch codegen-only errors in such chains, so a fixture must.
routine start()
    danger
        show(f"gamma(5): {5.to[Decimal]().gamma()}")
        show(f"gamma(1): {1.to[Decimal]().gamma()}")
        show(f"ln_gamma(10): {10.to[Decimal]().ln_gamma()}")
    show("DONE")
    return
