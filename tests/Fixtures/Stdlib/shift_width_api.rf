module Tests/Stdlib/ShiftWidthApi

# Shifting by the type's width or more pushes every bit out: `<<` and `>>>` give 0,
# and `>>` gives the sign fill (-1 for a negative value, else 0). The amounts arrive
# as routine arguments so nothing is folded at build time.

import IO/Console

routine s8_row(x: S8, n: U32)
    var left = x << n
    var right = x >> n
    var logical = x >>> n
    show(f"S8 {x} by {n}: {left} {right} {logical}")
    return

routine s64_row(x: S64, n: U32)
    var left = x << n
    var right = x >> n
    var logical = x >>> n
    show(f"S64 {x} by {n}: {left} {right} {logical}")
    return

routine u64_row(x: U64, n: U32)
    var left = x << n
    var right = x >> n
    var logical = x >>> n
    show(f"U64 {x} by {n}: {left} {right} {logical}")
    return

routine u128_row(x: U128, n: U32)
    var left = x << n
    var right = x >> n
    show(f"U128 {x} by {n}: {left} {right}")
    return

routine s128_row(x: S128, n: U32)
    var left = x << n
    var right = x >> n
    var logical = x >>> n
    show(f"S128 {x} by {n}: {left} {right} {logical}")
    return

# The high word of a 256-bit value held as two U128 halves, shifted left by `b`. At
# b = 0 the low half is shifted right by 128, which is 0, so the high word is unchanged.
routine wide_high(hi: U128, lo: U128, b: U32) -> U128
    return (hi << b) | (lo >> (128 - b))

routine compound(x: U64, n: U32) -> U64
    var v = x
    v <<= n
    return v

routine start()
    s8_row(x: -8, n: 0)
    s8_row(x: -8, n: 7)
    s8_row(x: -8, n: 8)
    s8_row(x: -8, n: 9)
    s8_row(x: -8, n: U32_MAX)
    s8_row(x: 101, n: 7)
    s8_row(x: 101, n: 8)
    s64_row(x: -5, n: 63)
    s64_row(x: -5, n: 64)
    s64_row(x: 5, n: 64)
    u64_row(x: U64_MAX, n: 63)
    u64_row(x: U64_MAX, n: 64)
    u64_row(x: U64_MAX, n: 65)
    u128_row(x: 1, n: 127)
    u128_row(x: 1, n: 128)
    s128_row(x: -1, n: 127)
    s128_row(x: -1, n: 128)
    show(f"wide b=0: {wide_high(hi: 5, lo: U128_MAX, b: 0)}")
    show(f"wide b=4: {wide_high(hi: 5, lo: U128_MAX, b: 4)}")
    show(f"compound: {compound(x: 3, n: 1)} {compound(x: 3, n: 64)}")
    return
