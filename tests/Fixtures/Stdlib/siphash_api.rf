module Tests/Stdlib/SiphashApi

import IO/Console
# U64.hash and U128.hash are SipHash-2-4 over the value's bytes in memory (little-endian), from Ingrid's
# Tessera library. These are the reference implementation's test vectors: key 00..0f, message 00..07 and 00..0f.

routine start()
    var k0 = 0x0706050403020100_u64
    var k1 = 0x0F0E0D0C0B0A0908_u64
    var eight = 0x0706050403020100_u64
    show(f"8 bytes: {eight.hash(k0: k0, k1: k1) == 0x93F5F5799A932462_u64}")
    var sixteen = 0x0F0E0D0C0B0A09080706050403020100_u128
    show(f"16 bytes: {sixteen.hash(k0: k0, k1: k1) == 0x3F2ACC7F57C29BDB_u64}")
    # A value and the same value with bit 59 set hash apart (the length byte gets a block of its own).
    var near = 0x0F06050403020100_u64
    show(f"top byte counts: {eight.hash(k0: k0, k1: k1) != near.hash(k0: k0, k1: k1)}")
    return
