module Tests/Stdlib/IntegerMethodsApi

import IO/Console
# Wrapper to expose the failable creator for try_/check_ generation.
failable routine S64_from_text(text: Text) -> S64
    return text.to[S64]()

# Int-specific methods: bit ops, classification, signum, parse from text.
routine start()
    # Classification
    show(f"5 is_positive: {5.is_positive()}")
    show(f"-5 is_negative: {(-5).is_negative()}")
    show(f"0 is_zero: {0.is_zero()}")
    show(f"4 is_even: {4.is_even()}")
    show(f"5 is_odd: {5.is_odd()}")
    show(f"8 is_power_of_two: {8.is_power_of_two()}")
    show(f"6 is_power_of_two: {6.is_power_of_two()}")

    # Sign
    show(f"signum(-7): {(-7).signum()}")
    show(f"signum(0): {0.signum()}")
    show(f"signum(7): {7.signum()}")

    # Bit ops on S64
    show(f"count_ones(0b1101): {0b1101.count_ones()}")
    show(f"count_zeros(0b0000): {0.count_zeros()}")
    show(f"leading_zeros(1): {1.leading_zeros()}")
    show(f"trailing_zeros(8): {8.trailing_zeros()}")

    # Parse from text
    var ok = try S64_from_text(text: "12345")
    var neg = try S64_from_text(text: "-42")
    var bad = try S64_from_text(text: "abc")
    show(f"parse '12345': {ok}")
    show(f"parse '-42': {neg}")
    show(f"parse 'abc': {bad}")

    show("DONE")
    return
