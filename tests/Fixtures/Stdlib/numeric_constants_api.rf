module Tests/Stdlib/NumericConstantsApi

import IO/Console
# Stdlib `preset` constants for numeric bounds + abs/min/max instance methods.
routine start()
    show(f"S64_MIN: {S64_MIN}")
    show(f"S64_MAX: {S64_MAX}")
    show(f"S8_MIN: {S8_MIN}")
    show(f"S8_MAX: {S8_MAX}")
    show(f"U8_MIN: {U8_MIN}")
    show(f"U8_MAX: {U8_MAX}")
    show(f"U64_MAX: {U64_MAX}")

    show(f"B64_EPSILON: {B64_EPSILON}")
    show(f"B64_MIN: {B64_MIN}")
    show(f"B64_MAX: {B64_MAX}")

    # abs / min / max instance methods
    show(f"abs(-5): {try (-5).abs()!!}")
    show(f"abs(5): {try 5.abs()!!}")
    show(f"abs(0): {try 0.abs()!!}")

    show(f"min(3, 7): {3.min(you: 7)}")
    show(f"max(3, 7): {3.max(you: 7)}")

    show(f"abs(-3.14): {(-3.14).abs()}")
    show(f"B64 min(2.0, 5.0): {2.0.min(you: 5.0)}")

    show("DONE")
    return
