module Tests/Stdlib/NumericComplexApi

import IO/Console
# Exercises C64, C128, C256 — real+imag pairs.
routine start()
    var c32: C64 = C64(real: 1.0, imag: 2.0)
    var c64: C128 = C128(real: 3.0, imag: 4.0)

    show(f"c32: {c32}")
    show(f"c64: {c64}")

    show(f"c64 real: {c64.real}")
    show(f"c64 imag: {c64.imag}")
    show(f"c64 abs: {c64.abs()}")

    # Arithmetic
    show(f"c64 + c64: {c64 + c64}")
    show(f"c64 * c64: {c64 * c64}")

    # Equality
    var c64b: C128 = C128(real: 3.0, imag: 4.0)
    show(f"c64 == c64b: {c64 == c64b}")

    # Real <-> complex promotion (`+`/`-` only, matching component width)
    var r32: B32 = 10.0
    var r64: B64 = 10.0
    show(f"r32 + c32: {r32 + c32}")
    show(f"c32 + r32: {c32 + r32}")
    show(f"r64 + c64: {r64 + c64}")
    show(f"c64 - r64: {c64 - r64}")

    show("DONE")
    return
