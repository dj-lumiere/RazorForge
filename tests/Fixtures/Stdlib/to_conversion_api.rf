module Tests/Stdlib/ToConversionApi

import IO/Console

# Conversions are `x.to[T]()`: the type argument picks the conversion, or the type the result goes to does.
record Fahrenheit
    degrees: B64

record Celsius
    degrees: B64

routine Fahrenheit.to[Celsius]() -> Celsius
    return Celsius(degrees: (me.degrees - 32.0) * 5.0 / 9.0)

choice Hue
    RED
    GREEN

flags Access
    READ
    WRITE

routine widen(value: S32) -> S64
    return value.to()

routine takes(n: U8) -> Text
    return f"{n}"

routine start()
    var count = 300
    show(f"explicit: {200.to[U8]()}")
    var a: U64 = count.to()
    show(f"declared: {a}")
    var b: U8? = try count.to()
    show(f"try: {b}")
    var c: Check[U8] = check count.to()
    show(f"check: {c}")
    var d: S64? = try "42".to()
    show(f"parse: {d}")
    var e: S64? = try "4x".to()
    show(f"parse bad: {e}")
    show(f"return: {widen(value: 7)}")
    show(f"argument: {takes(n: 12.to())}")
    var s32_31: S32 = 31
    var w: S64? = try s32_31.to[S64]()
    show(f"widen try: {w}")
    var f = Fahrenheit(degrees: 212.0)
    var g: Celsius = f.to()
    show(f"user: {g.degrees}")
    show(f"choice: {Hue.GREEN.to[S32]()} {Hue.GREEN.to[S64]()}")
    show(f"flags: {Access.WRITE.to[U64]()}")
    show(f"char: {'A'.to[U32]()}")
    show(f"integer: {count.to[Integer]()}")
    var u64_300: U64 = 300
    show(f"wrap: {count.to_wrap[U8]()} {(-1).to_wrap[U16]()} {u64_300.to_wrap[S8]()}")
    show(f"clamp: {count.to_clamp[U8]()} {(-5).to_clamp[U32]()} {count.to_clamp[S8]()}")
    var big = "-1000".to[Integer]()
    show(f"integer wrap: {big.to_wrap[U8]()} {big.to_wrap[S16]()} clamp: {big.to_clamp[U8]()} {big.to_clamp[S8]()}")
    show("DONE")
    return
