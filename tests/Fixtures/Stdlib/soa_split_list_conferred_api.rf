module Tests/Stdlib/SoaSplitListConferredApi

import Collections
import IO/Console

# A record whose member variables all split into flat columns is Splittable without writing it: `Holder` holds a
# `Point` declared after it, and neither says `obeys Splittable`.

record Holder
    p: Point
    w: S32

record Point
    x: B64
    y: B64

routine start()
    var hs = SplitList[Holder]()
    hs.add_last(value: Holder(p: Point(x: 1.5, y: 2.5), w: 3))
    hs.add_last(value: Holder(p: Point(x: 4.5, y: 5.5), w: 6))
    show(f"count={hs.count()}")
    show(f"second y={hs[1].p.y} w={hs[1].w}")
    for h in hs
        show(f"x={h.p.x}")
    return
