module Tests/Stdlib/FlagsMembershipApi

import IO/Console

# `has` asks for all of the members, `has_any` for at least one, `lacks` for none. The flags value with no member on is
# `none`, also in a preset and in a record preset.

flags CellMarks
    MINE
    REVEALED
    FLAGGED

record Cell
    marks: CellMarks
    adjacent_mines: S64

preset EMPTY_MARKS: CellMarks = none
preset BLANK: Cell = Cell(marks: none, adjacent_mines: 0)
preset COMPUTED_BLANK: Cell = Cell(marks: none, adjacent_mines: 1 + 1)
preset MINED: Cell = Cell(marks: CellMarks.MINE and CellMarks.FLAGGED, adjacent_mines: 2 * 3)

routine start()
    var marks = CellMarks.MINE and CellMarks.FLAGGED
    show(f"has(MINE and FLAGGED): {marks.has(MINE and FLAGGED)}")
    show(f"has(MINE and REVEALED): {marks.has(MINE and REVEALED)}")
    show(f"has_any(MINE and REVEALED): {marks.has_any(MINE and REVEALED)}")
    show(f"has_any(REVEALED): {marks.has_any(REVEALED)}")
    show(f"lacks(REVEALED and FLAGGED): {marks.lacks(REVEALED and FLAGGED)}")
    show(f"lacks(REVEALED): {marks.lacks(REVEALED)}")
    show(f"lacks(MINE and FLAGGED): {marks.lacks(MINE and FLAGGED)}")

    var empty: CellMarks = none
    show(f"empty: {empty}")
    show(f"empty == none: {empty == none}")
    show(f"empty.lacks(MINE and REVEALED and FLAGGED): {empty.lacks(MINE and REVEALED and FLAGGED)}")
    empty = REVEALED
    show(f"after REVEALED: {empty}, == none: {empty == none}")
    marks = none
    show(f"marks cleared: {marks}")

    var absent: CellMarks? = none
    show(f"absent Maybe is none: {absent is None}")

    show(f"EMPTY_MARKS: {EMPTY_MARKS}")
    show(f"BLANK.marks: {BLANK.marks}, lacks(MINE): {BLANK.marks.lacks(MINE)}")
    show(f"COMPUTED_BLANK: {COMPUTED_BLANK.marks}, {COMPUTED_BLANK.adjacent_mines}")
    show(f"MINED: {MINED.marks}, {MINED.adjacent_mines}")
    return
