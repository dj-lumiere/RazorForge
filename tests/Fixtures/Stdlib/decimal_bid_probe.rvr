module Tests/Stdlib/DecimalBidProbe

import IO/Console
routine start()
    # literals (now BID-encoded)
    var a: D128 = 6.0
    var b: D128 = 2.0
    show(a / b)  # 3
    var d128_1_0: D128 = 1.0
    var d128_0_5: D128 = 0.5
    show(d128_1_0 + d128_0_5)
    var d64_0_1: D64 = 0.1
    var d64_0_2: D64 = 0.2
    show(d64_0_1 + d64_0_2)
    var d32_1_5: D32 = 1.5
    var d32_2_0: D32 = 2.0
    show(d32_1_5 * d32_2_0)
    # int -> decimal
    show(42.to[D128]())
    var u8_255: U8 = 255
    show(u8_255.to[D64]())
    var s32_7: S32 = 7
    show(s32_7.to[D32]())
    # decimal -> int
    var d128_123_9: D128 = 123.9
    show(d128_123_9.to[S64]())
    var d64_255_0: D64 = 255.0
    show(d64_255_0.to[U8]())
    # float <-> decimal
    show(3.25.to[D128]())
    var d128_2_5: D128 = 2.5
    show(d128_2_5.to[B64]())
    # decimal -> decimal
    var d128_9_75: D128 = 9.75
    show(d128_9_75.to[D64]())
    var d32_1_25: D32 = 1.25
    show(d32_1_25.to[D128]())
    # comparison
    var d128_2_0: D128 = 2.0
    var d128_3_0: D128 = 3.0
    show(d128_2_0 < d128_3_0)
    show(1.to[D128]() == 1.to[D128]())
    # parse
    show("3.14159".to[D128]())
    return
