module Tests/Stdlib/TupleToApi

import IO/Console
# Text reads as a tuple: the text is split into words and each word becomes the item in its place. The tuple type
# is written in the call, or comes from where the value goes (a declared variable, names declared with a type).

routine start()
    var date = "2024 4 1".to[(S64, S64, S64)]()
    show(f"{date}")
    var pair: (S64, B64) = "3 0.5".to()
    show(f"{pair}")
    var (name, age): (Text, S64) = "Lumi 30".to()
    show(f"{name} {age}")
    when check "1".to[(S64, S64)]()
        is (S64, S64) as p => show(f"ok {p}")
        is Crashables as e => show(f"short: {e.crash_message()}")
    var bad = try "1 x".to[(S64, S64)]()
    show(f"not a number: {bad is None}")
    show("DONE")
    return
