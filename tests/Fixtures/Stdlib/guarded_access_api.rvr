module Tests/Stdlib/GuardedAccessApi

import BuilderQuery
import IO/Console
entity Counter
    value: S64

routine Counter.bump(inc: S64)
    me.value = me.value + inc
    return

routine start()
    var s = Guarded[Counter, MultiRead](from: Counter(value: 10))

    # shared (multi-reader) access
    viewing s as v
        show(f"view value: {v.value}")

    # exclusive (read/write) access
    modifying s as c
        c.bump(inc: 5)

    viewing s as v2
        show(f"after bump: {v2.value}")

    show("DONE")
    return
