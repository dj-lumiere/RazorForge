module Tests/Stdlib/RecoveryCreatorApi

import IO/Console
import Numerics

# `try`/`grab`/`lookup` recover a failable creator, and `??` takes the fallback for every arm that is not
# the value: None, a caught error, or both for a Lookup.
routine look!(n: S64) -> S64
    if n < 0
        throw InvalidValueError(input: "negative", target: "S64")
    if n == 0
        throw AbsentValueError()
    return n

routine start()
    var m = check "x".to[Integer]() ?? 7.to[Integer]()
    var k = check "8".to[Integer]() ?? 7.to[Integer]()
    var t = try "x".to[Integer]() ?? 9.to[Integer]()
    show(f"m={m} k={k} t={t}")
    var a = check look(n: -1) ?? 1
    var b = check look(n: 0) ?? 2
    var c = check look(n: 5) ?? 3
    show(f"a={a} b={b} c={c}")
    var bad = try "x".serialize().to[List[S64]]()
    show(f"bad={bad is None}")
    var good = try [4, 5].serialize().to[List[S64]]()
    when good
        is None => show("good=none")
        else as list => show(f"good={list.count()}")
    show("DONE")
    return
