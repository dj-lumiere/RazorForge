module Tests/Stdlib/RecoveryCreatorApi

import IO/Console
import Numerics

# `try`/`grab`/`lookup` recover a failable creator, and `??` takes the fallback for every arm that is not
# the value: None, a caught error, or both for a Lookup.
routine look!(n: S64) -> S64
    if n < 0
        throw InvalidValueError(input: "negative", target: "S64")
    if n == 0
        absent
    return n

routine start()
    var m = grab Integer(text: "x") ?? Integer(from: 7)
    var k = grab Integer(text: "8") ?? Integer(from: 7)
    var t = try Integer(text: "x") ?? Integer(from: 9)
    show(f"m={m} k={k} t={t}")
    var a = lookup look(n: -1) ?? 1
    var b = lookup look(n: 0) ?? 2
    var c = lookup look(n: 5) ?? 3
    show(f"a={a} b={b} c={c}")
    var bad = try List[S64](from: "x".serialize())
    show(f"bad={bad is None}")
    var good = try List[S64](from: [4_s64, 5_s64].serialize())
    when good
        is None => show("good=none")
        else list => show(f"good={list.count()}")
    show("DONE")
    return
