module Tests/Stdlib/EverywhereDeriveApi

import IO/Console
# `protocol P needs P everywhere` auto-derive: a record that OPTS INTO `obeys Comparable` and whose
# members all obey Comparable gets `eq`/`compare` (and the derived `lt`/`le`/`gt`/`ge`/`ne`) structurally —
# NO hand-written eq/cmp. Comparable obeys Equatable, so `==`/`!=` come along too. A plain record that
# does NOT opt in gets none of these (that negative is covered by the analyzer tests).
record Version
obeys Comparable
    major: S64
    minor: S64

routine start()
    var a = Version(major: 1, minor: 4)
    var b = Version(major: 1, minor: 10)
    var c = Version(major: 1, minor: 4)

    # Equality (auto eq / ne via Equatable, the parent of Comparable).
    show(f"a == c: {a == c}")
    show(f"a != b: {a != b}")

    # Ordering (auto compare → lt/le/gt/ge), lexicographic over (major, minor).
    show(f"a < b: {a < b}")
    show(f"a <= c: {a <= c}")
    show(f"b > a: {b > a}")
    show(f"b >= a: {b >= a}")

    # compare directly.
    show(f"a.cmp(b) == ME_SMALL: {a.compare(you: b) == ComparisonSign.ME_SMALL}")
    show(f"a.cmp(c) == SAME: {a.compare(you: c) == ComparisonSign.SAME}")
    return
