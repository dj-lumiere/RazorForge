module Tests/Stdlib/StampedIdentityApi

import IO/Console
# Two stamps compare with `===` / `!==`: the same entity (the same slot and generation). A stamp has no `==`. A stamp
# of an entity that ended is not the same as a stamp of the next entity in its slot.

entity Node
    value: S64

routine start()
    var a = Node(value: 1)
    var b = Node(value: 2)
    var sa: Stamped[Node] = a.stamp()
    var sb = b.stamp()
    show(sa === a.stamp())
    show(sa !== sb)
    show(sa === sb)
    var stamps = [sa, sb]
    var found: S64 = 0
    for at in stamps
        if at === sb
            found += 1
    show(found)
    drop a
    var c = Node(value: 3)
    var sc = c.stamp()
    show(sa === sc)
    show(sa !== sc)
    # Two links that may be missing: the same when both are none or both name one entity.
    var la: Stamped[Node]? = sb
    var lb: Stamped[Node]? = sb
    var lc: Stamped[Node]? = sc
    var ln: Stamped[Node]? = none
    var lm: Stamped[Node]? = none
    show(f"{la === lb} {la === lc} {la !== lc} {la === ln} {ln === lm} {ln !== lm}")
    return
