module Tests/Stdlib/DecimalRemApi

import IO/Console
# Decimal's `rem` is the remainder of the floored division, a - b * floor(a / b), computed exactly, with the
# divisor's sign. Beside it is S64's `%` on the same integers. A zero divisor throws DivisionByZeroError, and a
# remainder that needs more than 34 digits throws NumericOverflowError.
routine side_by_side(a: S64, b: S64)
    var x = a.to[Decimal]()
    var y = b.to[Decimal]()
    show(f"{a} rem {b}: Decimal {x.rem(you: y)}, S64 % {a % b}")
    return

routine show_rem(a: Decimal, b: Decimal)
    when check a.rem(you: b)
        is Decimal as r => show(f"{a} rem {b}: {r}")
        is DivisionByZeroError => show(f"{a} rem {b}: DivisionByZeroError")
        is NumericOverflowError => show(f"{a} rem {b}: NumericOverflowError")
        else => show(f"{a} rem {b}: another error")
    return

routine start()
    side_by_side(a: 7, b: 2)
    side_by_side(a: -7, b: 2)
    side_by_side(a: 7, b: -2)
    side_by_side(a: -7, b: -2)
    side_by_side(a: 6, b: -3)
    show_rem(a: 5.5, b: 2)
    show_rem(a: -5.5, b: 2)
    show_rem(a: 5.5, b: -2)
    show_rem(a: 1E+30, b: 7)
    show_rem(a: -1E+30, b: 7)
    show_rem(a: -4, b: 2)
    show_rem(a: 0.3, b: 0.1)
    show_rem(a: -1e-30, b: 7)
    show_rem(a: -1e-40, b: 7)
    show_rem(a: 7, b: 0)
    show("DONE")
    return
