module Tests/Stdlib/ForTypedRangeApi

# A type after the loop's name gives the bounds of the range written in the loop their type: a bound past S32
# (10**10) counts in S64, and a U8 range that ends at 255 stops there.

import IO/Console

routine start()
    var total: S64 = 0
    for i: S64 in 1 to 10**10 by 10**9
        total += i
    show(total)
    var count: U8 = 0
    for k: U8 in 250 to 255
        count += 1
    show(count)
    var last: U64 = 0
    for j: U64 in 0 til 3
        last = j
    show(last)
    return
