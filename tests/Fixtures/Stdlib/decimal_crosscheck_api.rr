### Whether two Decimal values are the same: one value with one sign (or both NaN).
routine same_decimal(a: Decimal, b: Decimal) -> Bool
    return a.to_bits() == b.to_bits()

### Checks a two-operand operation of Decimal, printing each value that differs, and returns how many it checked.
routine check_decimal_binary(op: Text, a: List[Text], b: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var x = a[i].to[Decimal]()
        var y = b[i].to[Decimal]()
        var got: Decimal = x
        if op == "add"
            got = x + y
        elseif op == "sub"
            got = x - y
        elseif op == "mul"
            got = x * y
        elseif op == "div"
            got = x / y
        else
            got = x.midpoint(you: y)
        if not same_decimal(a: got, b: want[i].to[Decimal]())
            show(f"Decimal {op} {a[i]} {b[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks a one-operand operation of Decimal (sqrt or recip).
routine check_decimal_unary(op: Text, a: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var x = a[i].to[Decimal]()
        var got: Decimal = x.recip()
        if op == "sqrt"
            got = x.sqrt()
        if not same_decimal(a: got, b: want[i].to[Decimal]())
            show(f"Decimal {op} {a[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks Decimal.powi.
routine check_decimal_powi(a: List[Text], n: List[S32], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var got = a[i].to[Decimal]().powi(n: n[i])
        if not same_decimal(a: got, b: want[i].to[Decimal]())
            show(f"Decimal powi {a[i]} {n[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks Decimal.mul_add (a * b + c rounded once).
routine check_decimal_fma(a: List[Text], b: List[Text], c: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var got = a[i].to[Decimal]().mul_add(b: b[i].to[Decimal](), c: c[i].to[Decimal]())
        if not same_decimal(a: got, b: want[i].to[Decimal]())
            show(f"Decimal fma {a[i]} {b[i]} {c[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks Decimal.round(places:, rule:), the rule given by its place in RoundingRule's list.
routine check_decimal_round(a: List[Text], places: List[U64], rules: List[U64], want: List[Text]) -> U64
    var all: List[RoundingRule] = [RoundingRule.HALF_UP, RoundingRule.HALF_EVEN, RoundingRule.HALF_AWAY,
        RoundingRule.FLOOR, RoundingRule.CEIL, RoundingRule.TRUNC]
    var i: U64 = 0
    until i >= a.count()
        var got = a[i].to[Decimal]().round(places: places[i], rule: all[rules[i]])
        if not same_decimal(a: got, b: want[i].to[Decimal]())
            show(f"Decimal round {a[i]} {places[i]} {rules[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks S128 to Decimal, rounded once.
routine check_decimal_from_s128(n: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= n.count()
        var got = n[i].to[S128]().to[Decimal]()
        if not same_decimal(a: got, b: want[i].to[Decimal]())
            show(f"Decimal from S128 {n[i]}: {got}, want {want[i]}")
        i += 1
    return i

routine start()
    var n: U64 = 0
    n = check_d32_binary(op: "add", a: ["-1E+6", "-0.006217754", "7", "-1.0204", "-0.05", "9.1E+5", "8.94625E+11", "51008.02", "-0.705", "8.574", "-5.158476E+10", "8.505", "1000002", "1000002", "1000003", "1000003", "-1000002", "-1000002"],
        b: ["8.56E+5", "2E+1", "9.2675E+8", "0.006", "-7981238", "2E-7", "0.004256558", "-1.1E+5", "-8720", "-3.54706E+9", "0.000004", "8.3", "0.5", "1.5", "0.5", "1.5", "0.5", "1.5"],
        want: ["-1.44E+5", "19.99378", "9.267500E+8", "-1.0144", "-7981238", "910000.0", "8.946250E+11", "-58991.98", "-8720.705", "-3.547060E+9", "-5.158476E+10", "16.805", "1000002", "1000004", "1000004", "1000004", "-1000002", "-1000000"])
    show(f"D32 add: {n} checked")
    n = check_d32_binary(op: "sub", a: ["0.00000227525", "4.985837E+7", "6.430969E+12", "0.000403", "1398.5", "-0.00043", "2.418E+5", "1.37E+8", "68388", "-0.00000844", "0.00000185", "7E+3"],
        b: ["2.2E-7", "-5.467E+7", "9.9463E+9", "7.8E+4", "0.486", "0.5", "-84.235", "7.4E+5", "-4.3", "-494142", "2.6288E+8", "-6.10E+6"],
        want: ["0.00000205525", "1.045284E+8", "6.421023E+12", "-78000.00", "1398.014", "-0.50043", "241884.2", "1.3626E+8", "68392.3", "494142.0", "-2.628800E+8", "6.107E+6"])
    show(f"D32 sub: {n} checked")
    n = check_d32_binary(op: "mul", a: ["4.15439E+6", "0.002661", "0.000991735", "7.9E+5", "3.31E+5", "4.08765E+9", "0.00000976", "7.8054E+9", "5.2", "-1.7755E+10", "1E-7", "-2.447782E+12"],
        b: ["0.0000681", "650270.3", "6.128E+9", "-0.006038", "-0.585022", "0.000048906", "-0.008", "6.50929E+7", "80376.96", "0.0301", "-3.112534E+11", "96"],
        want: ["282.9140", "1730.369", "6077352", "-4770.02", "-193642.3", "199910.6", "-7.808E-8", "5.080761E+17", "417960.2", "-5.344255E+8", "-31125.34", "-2.349871E+14"])
    show(f"D32 mul: {n} checked")
    n = check_d32_binary(op: "div", a: ["1.3", "-0.000003", "0.021726", "-2E+3", "-195510.3", "1.55426E+7", "-6.5913", "-0.0004422263", "4E+3", "4.66E+8", "0.00933523", "8.8766E+6", "9999999", "9999999", "1"],
        b: ["2604.2", "8.803", "-950.50", "7.11262E+11", "-3.1E+2", "9.92E+7", "0.0000536445", "-1.42447E+6", "0.000014606", "0.1", "8.2E+5", "-8.56E+7", "2", "-2", "3"],
        want: ["0.0004991936", "-3.407929E-7", "-0.00002285744", "-2.811903E-9", "630.6784", "0.1566794", "-122870.0", "3.104497E-10", "2.738601E+8", "4.66E+9", "1.138443E-8", "-0.1036986", "5000000", "-5000000", "0.3333333"])
    show(f"D32 div: {n} checked")
    n = check_d32_binary(op: "midpoint", a: ["0.315", "-0.8113", "1.9834E+10", "-6.89", "46.50535", "-0.0009035320", "65787.9", "86.61545", "0.0000062", "2.238E-7", "7.9E+6", "714.97", "1000001", "1000002", "-1000001", "9.999999E+96", "9.999999E+96"],
        b: ["-7.9780E+9", "0.00000172476", "7.2E+2", "0.0085", "0.1077556", "0.000001", "-3E+5", "3.24E+4", "-0.002", "333.52", "0.0926", "-1.44E+6", "1000002", "1000003", "-1000002", "9.999999E+96", "-9.999999E+96"],
        want: ["-3.989000E+9", "-0.4056491", "9.917000E+9", "-3.44075", "23.30655", "-0.0004512660", "-117106.0", "16243.31", "-0.0009969", "166.7600", "3950000", "-719642.5", "1000002", "1000002", "-1000002", "9.999999E+96", "0"])
    show(f"D32 midpoint: {n} checked")
    n = check_d32_unary(op: "sqrt", a: ["3E+2", "0.000064", "8E+6", "54.475", "88467.81", "0.0007", "5.727865", "0.0004961096", "1.363466E+12", "6.1E+3", "0.000008181481", "1.3E-7", "2", "0.01", "1000000"],
        want: ["17.32051", "0.008", "2828.427", "7.380718", "297.4354", "0.02645751", "2.393296", "0.02227352", "1167675", "78.10250", "0.002860329", "0.0003605551", "1.414214", "0.1", "1000"])
    show(f"D32 sqrt: {n} checked")
    n = check_d32_unary(op: "recip", a: ["-2.0E+6", "0.0006", "65.3", "-9E+6", "5.89319E+7", "0.0056239", "5", "5.60E+6", "-0.000170318", "-0.000042398", "-1E+2", "-0.07", "2048", "1.677722E+7", "5.629500E+14", "1.125900E+15"],
        want: ["-5E-7", "1666.667", "0.01531394", "-1.111111E-7", "1.696874E-8", "177.8126", "0.2", "1.785714E-7", "-5871.370", "-23586.02", "-0.01", "-14.28571", "0.0004882812", "5.960463E-8", "1.776357E-15", "8.881783E-16"])
