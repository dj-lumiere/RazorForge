module Tests/Stdlib/DecimalCrosscheckApi

import IO/Console

# D32, D64, D128, and Decimal against Python's decimal module: every expected value was computed exactly and rounded
# once (a tie to the even one for D32, D64, and D128, half up for Decimal), by scripts/gen_decimal_crosscheck.py,
# which writes this file. A line names each value that differs, then each operation prints how many it checked.

### Whether two D32 values are the same: one value with one sign (or both NaN).
routine same_d32(a: D32, b: D32) -> Bool
    if a.is_nan()
        return b.is_nan()
    return a == b and a.is_sign_negative() == b.is_sign_negative()

### Checks a two-operand operation of D32, printing each value that differs, and returns how many it checked.
routine check_d32_binary(op: Text, a: List[Text], b: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var x = a[i].to[D32]()
        var y = b[i].to[D32]()
        var got: D32 = x
        if op == "add"
            got = x + y
        elseif op == "sub"
            got = x - y
        elseif op == "mul"
            got = x * y
        elseif op == "div"
            got = x / y
        else
            got = x.midpoint(you: y)
        if not same_d32(a: got, b: want[i].to[D32]())
            show(f"D32 {op} {a[i]} {b[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks a one-operand operation of D32 (sqrt or recip).
routine check_d32_unary(op: Text, a: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var x = a[i].to[D32]()
        var got: D32 = x.recip()
        if op == "sqrt"
            got = x.sqrt()
        if not same_d32(a: got, b: want[i].to[D32]())
            show(f"D32 {op} {a[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks D32.powi.
routine check_d32_powi(a: List[Text], n: List[S32], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var got = a[i].to[D32]().powi(n: n[i])
        if not same_d32(a: got, b: want[i].to[D32]())
            show(f"D32 powi {a[i]} {n[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks D32.mul_add (a * b + c rounded once).
routine check_d32_fma(a: List[Text], b: List[Text], c: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var got = a[i].to[D32]().mul_add(b: b[i].to[D32](), c: c[i].to[D32]())
        if not same_d32(a: got, b: want[i].to[D32]())
            show(f"D32 fma {a[i]} {b[i]} {c[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks D32.round(places:, rule:), the rule given by its place in RoundingRule's list.
routine check_d32_round(a: List[Text], places: List[U64], rules: List[U64], want: List[Text]) -> U64
    var all: List[RoundingRule] = [RoundingRule.HALF_UP, RoundingRule.HALF_EVEN, RoundingRule.HALF_AWAY,
        RoundingRule.FLOOR, RoundingRule.CEIL, RoundingRule.TRUNC]
    var i: U64 = 0
    until i >= a.count()
        var got = a[i].to[D32]().round(places: places[i], rule: all[rules[i]])
        if not same_d32(a: got, b: want[i].to[D32]())
            show(f"D32 round {a[i]} {places[i]} {rules[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks S128 to D32, rounded once.
routine check_d32_from_s128(n: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= n.count()
        var got = n[i].to[S128]().to[D32]()
        if not same_d32(a: got, b: want[i].to[D32]())
            show(f"D32 from S128 {n[i]}: {got}, want {want[i]}")
        i += 1
    return i

### Checks D32 to S128 (toward zero).
routine check_d32_to_s128(a: List[Text], want: List[Text]) -> U64
    var i: U64 = 0
    until i >= a.count()
        var got = a[i].to[D32]().to[S128]()
        if got != want[i].to[S128]()
            show(f"D32 to S128 {a[i]}: {got}, want {want[i]}")
        i += 1
    return i

