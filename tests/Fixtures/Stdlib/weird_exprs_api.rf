module Tests/Stdlib/WeirdExprsApi

# Homage to rustc's tests/ui/expr/weird-exprs.rs: expressions that are
# pathological but LEGAL. Every routine here stresses a parser/SA/codegen
# corner that once broke (or could break) — if this file compiles and its
# output is stable, the expression grammar's dark corners are holding.

import IO/Console
import Numerics
# punch_card: parenthesization torture — depth and redundancy
routine punch_card() -> S64
    return 1 + 2 + 3 + 4 + 5

# clamp_chain: @positional chains where every call re-bounds the last
routine clamp_chain(n: S64) -> S64
    return n
        .clamp(0, 100)
        .clamp(5, 40)
        .clamp(10, 39)

# iif: a conditional expression whose branches are themselves weird calls
routine iif(x: Bool) -> S64
    return if x then punch_card() else clamp_chain(n: 200)

# truth: negation stacked until it means something again
routine truth() -> Bool
    return not not not false

# widen: create conversion ladder across every signed width
routine widen() -> S128
    return S128(S64(S32(S16(S8(1)))))

# bool_set: a Set[Bool] fed by its own insertion results
routine bool_set() -> U64
    var seen = Set[Bool]()
    discard seen.add(value: seen.add(value: true))
    discard seen.add(value: seen.add(value: false))
    return seen.count()

# op_zoo: logical shifts, masks, and wrapping arithmetic in one expression
routine op_zoo(n: U64) -> U64
    return ((n << 2) & 0xFF | (n >>> 1)) +% n *% 3

# chained_cmp: three-way chained comparison as a single expression
routine chained_cmp(x: S64) -> Bool
    return 0 <= x <= 10

# back_to_front: BackIndex desugaring mixed with forward indexing
routine back_to_front() -> S64
    var items = List[S64]()
    items.add_last(10)
    items.add_last(20)
    items.add_last(30)
    return items[0] + items[^1] + items[^3]

# zombie_negation: explicit-generic intrinsic with a bare literal inside a
# failable routine — the try_ variant must still see a concrete S8
routine zombie_negation!(x: S8) -> S8
    if x == -128_s8
        throw IntegerOverflowError()
    return LLVM::sub[S8](a: 0, b: x)

# loop_the_loop: bare loop with break, counting by wrapping increments
routine loop_the_loop() -> S64
    var spins = 0_s64
    loop
        spins +%= 1
        if spins == 3
            break
    return spins

# Combinations: each feature below works on its own; these stack them the way a
# real program does, which is where the lowering passes have collided before.

# fallback_everywhere: `??` takes the fallback for every arm that is not the
# value: a Maybe's None, a Check's caught error, and both arms of a Lookup
routine look!(n: S64) -> S64
    if n < 0
        throw InvalidValueError(input: "negative", target: "S64")
    if n == 0
        absent
    return n

routine fallback_everywhere() -> Text
    var a = grab Integer(text: "x") ?? Integer(from: 7)
    var b = try Integer(text: "8") ?? Integer(from: 0)
    var c = lookup look(n: -1) ?? 1
    var d = lookup look(n: 0) ?? 2
    var e = lookup look(n: 5) ?? 3
    return f"{a} {b} {c} {d} {e}"

# generic_ctor_recovered: a failable creator with explicit type arguments,
# recovered with `try`, both when the value fits and when it does not
routine generic_ctor_recovered() -> Text
    var bad = try List[S64](from: "x".serialize())
    var good = try List[S64](from: [4_s64, 5_s64].serialize())
    when good
        is None => return f"{bad is None} none"
        else list => return f"{bad is None} {list.count()}"

# each_over_call: a loop over a list nothing names, built by a call
routine three() -> List[S64]
    var xs = List[S64]()
    xs.add_last(1)
    xs.add_last(2)
    xs.add_last(3)
    return steal xs

routine each_over_call() -> S64
    var total = 0_s64
    each x in three()
        total = total + x
    return total

# box_of_box: a type argument that mentions the parameter's own name is
# substituted once (`T = Box[S64]` gives `Box[Box[S64]]`)
record Box[T]
needs RecordType T
    item: T

routine wrap[T](x: T) -> Box[T]
needs RecordType T
    return Box[T](item: x)

routine box_of_box() -> S64
    var inner = wrap[S64](x: 7)
    var outer = wrap[Box[S64]](x: inner)
    return outer.item.item

# pattern_items: a member routine on a receiver pattern whose own `T` has the
# list's name, walked with `each` and a member call per element
routine Box[T].get() -> T
    return me.item

routine List[Box[T]].items() -> List[T]
    var out = List[T]()
    each b in me
        out.add_last(value: b.get())
    return steal out

routine pattern_items() -> S64
    var boxes = List[Box[S64]]()
    boxes.add_last(value: wrap[S64](x: 4))
    boxes.add_last(value: wrap[S64](x: 5))
    var got = boxes.items()
    return got[0] + got[^1]

# slices_from_the_back: end-relative bounds inside a slice, then a count
routine slices_from_the_back() -> Text
    var xs = three()
    return f"{xs[1 til ^0].count()} {xs[^2 til ^0][0]} {xs[0 til ^1][^1]}"

# when_in_each: a `when` inside an `each` that leaves the loop from one arm
routine when_in_each() -> S64
    var seen = 0_s64
    each x in three()
        when x
            == 3 => break
            else => seen = seen + x
    return seen

# arm_fstring: an f-string hole inside a `when` arm reads `is` as the test it is,
# not as the start of the next arm's pattern
routine arm_fstring(m: S64?, other: S64?) -> Text
    when m
        is None => return f"none {other is None}"
        else v => return f"{v} {other is None} {(v + 1) * 2}"

routine start()
    show(f"punch_card: {punch_card()}")
    show(f"clamp_chain: {clamp_chain(n: 42)}")
    show(f"iif(true): {iif(x: true)}")
    show(f"iif(false): {iif(x: false)}")
    show(f"truth: {truth()}")
    show(f"widen: {widen()}")
    show(f"bool_set: {bool_set()}")
    show(f"op_zoo: {op_zoo(n: 5_u64)}")
    show(f"chained_cmp(5): {chained_cmp(x: 5)}")
    show(f"chained_cmp(11): {chained_cmp(x: 11)}")
    show(f"back_to_front: {back_to_front()}")
    var z = try zombie_negation(x: 5_s8)
    when z
        is None => show("zombie: absent")
        else v => show(f"zombie: {v}")
    show(f"loop_the_loop: {loop_the_loop()}")
    show(f"fallback_everywhere: {fallback_everywhere()}")
    show(f"generic_ctor_recovered: {generic_ctor_recovered()}")
    show(f"each_over_call: {each_over_call()}")
    show(f"box_of_box: {box_of_box()}")
    show(f"pattern_items: {pattern_items()}")
    show(f"slices_from_the_back: {slices_from_the_back()}")
    show(f"when_in_each: {when_in_each()}")
    show(f"in_fstring: {three().count()} {box_of_box() + each_over_call()}")
    show(f"arm_fstring: {arm_fstring(m: 4, other: none)} / {arm_fstring(m: none, other: 1)}")
    return
