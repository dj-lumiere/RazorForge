module Tests/Stdlib/WhenBecomesApi

import IO/Console
# A block arm of a `when` that gives a value ends with `becomes value`, the arm's value; its lines run first.
routine label(n: S64) -> Text
    var text = when n
        == 0 =>
            show("zero seen")
            var doubled = n * 2
            becomes f"zero {doubled}"
        == 1, 2 => "small"
        else => "other"
    return text

routine start()
    show(label(n: 0))
    show(label(n: 2))
    show(label(n: 9))
    show("DONE")
    return
