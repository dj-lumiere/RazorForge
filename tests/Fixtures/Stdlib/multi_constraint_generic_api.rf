module Tests/Stdlib/MultiConstraintGenericApi

import IO/Console
# Generics with multiple protocol constraints — `T obeys A + B` style (whatever
# the actual syntax is). Tests that the routine sees both protocol surfaces.
routine in_set_and_max[T](items: Viewing[List[T]], target: T) -> Bool
needs T obeys Equatable, Hashable
    # Hashable lets us build a Set; Equatable lets us check contains
    var s: Set[T] = Set[T]()
    each x in items
        drop s.add(value: x)
    return s.has(target)

routine start()
    var nums: List[S64] = [10, 20, 30, 40]
    modifying nums as g
        show(f"in_set 20: {in_set_and_max(items: g, target: 20)}")
        show(f"in_set 99: {in_set_and_max(items: g, target: 99)}")

    var words: List[Text] = ["alpha", "bravo", "charlie"]
    modifying words as g
        show(f"in_set 'bravo': {in_set_and_max(items: g, target: "bravo")}")
        show(f"in_set 'delta': {in_set_and_max(items: g, target: "delta")}")

    show("DONE")
    return
