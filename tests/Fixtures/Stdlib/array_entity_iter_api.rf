module Tests/Stdlib/ArrayEntityIterApi
import IO/Console
# Iterating a Slots of entities reads each element where it is: no copy, one teardown each.
entity Res
    n: S64

@override
routine Res.destruct()
    show(f"destruct {me.n}")
    return

routine sum_values() -> S64
    var arr: Array[S64, 3] = [1, 2, 3]
    var total = 0
    each v in arr
        total += v
    return total

routine start()
    show(f"values {sum_values()}")
    var arr: Slots[Res, 3] = [Res(n: 1), Res(n: 2), Res(n: 3)]
    var total = 0
    each r in arr
        total += r.n
        show(f"saw {r.n}")
    show(f"total {total}")
    var texts: Array[Text, 2] = ["a", "b"]
    each t in texts
        show(t)
    show("end")
    return
