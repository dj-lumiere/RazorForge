module Tests/Stdlib/WorkPunningApi

import IO/Console
# A variable named like its parameter counts as a named argument (`a` for `a: a`) in a Work conversion as it does in
# a direct call, so `add3.to[Work](a, b: 2, c)` mixes nothing and binds `a` and `c` by name, in any order.

routine add3(a: S64, b: S64, c: S64) -> S64
    return a * 100 + b * 10 + c

routine start()
    var a: S64 = 1
    var c: S64 = 3
    show(add3(a, b: 2, c))
    var job = add3.to[Work](a, b: 2, c)
    job.start_now()
    show(job.retrieve())
    var swapped = add3.to[Work](c, b: 5, a)
    swapped.start_now()
    show(swapped.retrieve())
    return
