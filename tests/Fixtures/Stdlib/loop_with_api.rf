module Tests/Stdlib/LoopWithApi

import IO/Console

# A loop carries values with `with`, passes the next ones with `continue with`, and `then` sees the last ones. A loop
# whose `then` ends in `return` always returns, so nothing follows it.

### Collatz steps from `start` to 1: the two carried values change every round.
routine collatz_steps(start: U64) -> U64
    until n <= 1 with n: U64 = start, steps: U64 = 0
        var after = if n % 2 == 0 then n // 2 else 3 * n + 1
        continue with n: after, steps: steps + 1
    then
        return steps

### The sum of the values before the first negative one: `then` runs after the `break` too.
routine sum_until_negative(xs: List[S64]) -> S64
    each x in xs with sum: S64 = 0, count: S64 = 0
        if x < 0
            break
        continue with sum: sum + x, count: count + 1
    then
        show(f"summed {count} values")
        return sum

### The greatest common divisor, the carried pair swapped in one `continue with`.
routine gcd(a: U64, b: U64) -> U64
    until y == 0 with x: U64 = a, y: U64 = b
        continue with x: y, y: x % y
    then
        return x

routine start()
    show(f"collatz 27: {collatz_steps(start: 27)}")
    show(f"collatz 1: {collatz_steps(start: 1)}")
    show(f"sum: {sum_until_negative(xs: [1, 2, 3])}")
    show(f"stopped: {sum_until_negative(xs: [1, -2, 3])}")
    show(f"gcd: {gcd(a: 48, b: 18)}")
    show("DONE")
    return
