module Tests/Stdlib/RsqrtApi

import IO/Console
# rsqrt: 1 / sqrt(x) rounded once, on every binary float, the D types and Decimal. Binary results are shown as bits
# (correctly rounded to nearest, ties to even): powers of four are exact, the B32 inputs CORE-MATH corrects by hand,
# subnormals, the largest finite values, and B64 / B128 worst cases. The decimal ties are exact: 1 / sqrt(0.04194304)
# is 4.8828125, so D32 rounds to the even 4.882812 and Decimal (34 digits) keeps it. x <= 0 fails in the checked
# form and gives the IEEE value in the unchecked one.

routine show_domain(label: Text, x: B64)
    when check x.rsqrt()
        is NumericDomainError as e => show(f"{label}: domain {e.crash_message()}")
        is NumericOverflowError as e => show(f"{label}: overflow {e.crash_message()}")
        is Crashables as e => show(f"{label}: other")
        else as v => show(f"{label}: {v}")
    return

routine show_decimal_domain(label: Text, x: Decimal)
    when check x.rsqrt()
        is NumericDomainError as e => show(f"{label}: domain")
        is Crashables as e => show(f"{label}: other")
        else as v => show(f"{label}: {v}")
    return

routine start()
    # B16: 0.25 0.5 1.5 10.25, the smallest subnormal, the largest finite value
    show(f"b16 {B16.from_bits(bits: 0x3400).rsqrt().to_bits()} {B16.from_bits(bits: 0x3800).rsqrt().to_bits()} {B16.from_bits(bits: 0x3E00).rsqrt().to_bits()} {B16.from_bits(bits: 0x4920).rsqrt().to_bits()} {B16.from_bits(bits: 0x0001).rsqrt().to_bits()} {B16.from_bits(bits: 0x7BFF).rsqrt().to_bits()}")
    # BF16: 2 and 0.5
    show(f"bf16 {BF16.from_bits(bits: 0x4000).rsqrt().to_bits()} {BF16.from_bits(bits: 0x3F00).rsqrt().to_bits()}")
    # B32: 4, 2, 0.1, the hand-corrected 0x002F7E2A, 0x3EBDF8A8 and 0x4055B7BD, the smallest subnormal, the largest
    show(f"b32 {B32.from_bits(bits: 0x40800000).rsqrt().to_bits()} {B32.from_bits(bits: 0x40000000).rsqrt().to_bits()} {B32.from_bits(bits: 0x3DCCCCCD).rsqrt().to_bits()}")
    show(f"b32 hard {B32.from_bits(bits: 0x002F7E2A).rsqrt().to_bits()} {B32.from_bits(bits: 0x3EBDF8A8).rsqrt().to_bits()} {B32.from_bits(bits: 0x4055B7BD).rsqrt().to_bits()}")
    show(f"b32 ends {B32.from_bits(bits: 0x00000001).rsqrt().to_bits()} {B32.from_bits(bits: 0x7F7FFFFF).rsqrt().to_bits()}")
    # B64: 4, 2, 0.1, CORE-MATH worst cases 0x1.a6a9cc15abccep+0 and 0x1.c562b857453ddp+1, 4 - 2^-51, the ends
    show(f"b64 {B64.from_bits(bits: 0x4010000000000000).rsqrt().to_bits()} {B64.from_bits(bits: 0x4000000000000000).rsqrt().to_bits()} {B64.from_bits(bits: 0x3FB999999999999A).rsqrt().to_bits()}")
    show(f"b64 hard {B64.from_bits(bits: 0x3FFA6A9CC15ABCCE).rsqrt().to_bits()} {B64.from_bits(bits: 0x400C562B857453DD).rsqrt().to_bits()} {B64.from_bits(bits: 0x400FFFFFFFFFFFFE).rsqrt().to_bits()}")
    show(f"b64 ends {B64.from_bits(bits: 0x0000000000000001).rsqrt().to_bits()} {B64.from_bits(bits: 0x7FEFFFFFFFFFFFFF).rsqrt().to_bits()}")
    # B128: 4, 2, the smallest subnormal, the largest finite value
    show(f"b128 {B128.from_bits(bits: 0x40010000000000000000000000000000).rsqrt().to_bits()} {B128.from_bits(bits: 0x40000000000000000000000000000000).rsqrt().to_bits()}")
    show(f"b128 ends {B128.from_bits(bits: 1).rsqrt().to_bits()} {B128.from_bits(bits: 0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF).rsqrt().to_bits()}")

    # rsqrt rounds once, 1 / sqrt rounds twice: they differ at 0x3F7FFF3B (B32) and 0x3FEFFFFFFFFFFF3B (B64)
    var b32 = B32.from_bits(bits: 0x3F7FFF3B)
    var b64 = B64.from_bits(bits: 0x3FEFFFFFFFFFFF3B)
    show(f"once {b32.rsqrt().to_bits()} twice {(1.0 / b32.sqrt()).to_bits()}")
    show(f"once {b64.rsqrt().to_bits()} twice {(1.0 / b64.sqrt()).to_bits()}")

    # decimal: ties, odd and even exponents, the ends of the range
    var d32_tie: D32 = 0.04194304
    var d64_tie: D64 = 0.0281474976710656
    var d128_tie: D128 = 0.316912650057057350374175801344
    var dec_tie: Decimal = 0.316912650057057350374175801344
    show(f"d32 {d32_tie.rsqrt()} d64 {d64_tie.rsqrt()}")
    show(f"d128 {d128_tie.rsqrt()}")
    show(f"decimal {dec_tie.rsqrt()}")
    var two32: D32 = 2
    var ten64: D64 = 10
    var hundredth128: D128 = 0.01
    var two_dec: Decimal = 2
    show(f"{two32.rsqrt()} {ten64.rsqrt()} {hundredth128.rsqrt()} {two_dec.rsqrt()}")
    var tiny32 = D32.from_bits(bits: 1)
    show(f"d32 smallest {tiny32.rsqrt()}")

    # x <= 0: checked fails, unchecked gives the IEEE value
    var zero: B64 = 0.0
    var minus: B64 = -2.0
    show(f"unchecked {zero.rsqrt_unchecked()} {(-zero).rsqrt_unchecked()} {minus.rsqrt_unchecked()}")
    show_domain(label: "rsqrt(0)", x: zero)
    show_domain(label: "rsqrt(-2)", x: minus)
    show_domain(label: "rsqrt(4)", x: 4.0)
    var d_zero: D64 = 0
    var d_minus: D64 = -4
    show(f"d64 unchecked {d_zero.rsqrt_unchecked()} {d_minus.rsqrt_unchecked()}")
    show_decimal_domain(label: "decimal rsqrt(0)", x: 0)
    show_decimal_domain(label: "decimal rsqrt(-4)", x: -4)
    show_decimal_domain(label: "decimal rsqrt(0.25)", x: 0.25)
    return
