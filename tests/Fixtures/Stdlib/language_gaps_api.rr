module Tests/Stdlib/LanguageGapsApi

import IO/Console
import Collections

record Point
    x: S64
    y: S64

common routine Point.origin() -> Me
    return Me(x: 0, y: 0)

record Version
obeys Comparable
    major: S64
    minor: S64

record Pair[A, B]
needs RecordType A, RecordType B
    first: A
    second: B

record Box[T]
needs RecordType T
    item: T

routine Box[TItem].peek() -> TItem
    return me.item

routine Pair[X, Y].swapped() -> Pair[Y, X]
    var f: Y = me.second
    var s: X = me.first
    return Pair[Y, X](first: f, second: s)

entity Crate
    label: Text

routine archive(crate: Crate)
    show(f"archived {crate.label}")
    return

routine weigh(crate: Crate) -> S64
    return crate.label.count().to[S64]()

routine total(values...: S64) -> S64
    var sum: S64 = 0
    for v in values
        sum += v
    return sum

routine start()
    # A local routine value is called by its name.
    var add = (a: S64, b: S64) => a + b
    show(add(a: 2, b: 3))

    # A variadic routine takes no values too.
    show(total())
    show(total(1, 2, 3))

    # `Me(...)` builds the type the routine is on.
    show(Point.origin())

    # A record that obeys Comparable compares member by member.
    var a = Version(major: 1, minor: 2)
    var b = Version(major: 1, minor: 3)
    show(a <=> b)
    show(a < b)

    # A bit array is written as a literal.
    var bits: Bits[4] = [true, false, true, false]
    show(bits)

    # An element `for` hands out is assigned as its value.
    var best: S64 = 0
    for item in [3, 9, 4]
        if item > best
            best = item
    show(best)

    # Collections are read back from their serialized form.
    var d = Dict[S64, Text]()
    d[1] = "one"
    d[2] = "two"
    var d2 = d.serialize().to[Dict[S64, Text]]()
    show(d2[2])
    var s = Set[S64]()
    drop s.add(7)
    show(s.serialize().to[Set[S64]]().has(7))
    var sd = SortedDict[Text, S64]()
    sd["z"] = 26
    show(sd.serialize().to[SortedDict[Text, S64]]()["z"])
    var bad = try d.serialize().to[Dict[S64, S64]]()
    when bad
        is None => show("not a dictionary of numbers")
        else => show("read back")

    # A receiver's parameter names are the type's own slots, whatever they are called.
    show(Box[S64](item: 4).peek())
    var swapped = Pair[S64, Text](first: 1, second: "one").swapped()
    show(f"{swapped.first} {swapped.second}")

    # `for x in steal xs` hands each element over, and the loop variable is a new name each time.
    var crates = [Crate(label: "a"), Crate(label: "b")]
    for c in steal crates
        archive(crate: steal c)
    var more = [Crate(label: "c"), Crate(label: "d"), Crate(label: "e")]
    for c in steal more
        if c.label == "d"
            break
        archive(crate: steal c)

    # An entity made right in a job's argument goes to the Work.
    var job = weigh.to[Work](crate: Crate(label: "heavy"))
    job.start_now()
    show(job.retrieve())
    return
