module Tests/Stdlib/BuilderQueryBuildInfoApi

import BuilderQuery
import IO/Console
# The standalone BuilderQuery routines that report the build are folded to build-time values at each call, so
# they build, link and run like any other call. The values that differ by machine are checked, not printed.

routine start()
    var os = target_os()
    show(f"os known: {os == "linux" or os == "macos" or os == "windows"}")
    show(f"arch known: {target_arch().count() > 0}")
    show(f"word: {word_size()}")
    show(f"page: {page_size() > 0b}")
    show(f"line: {cache_line() > 0b}")
    show(f"version: {builder_version().count() > 0}")
    show(f"stamp: {build_timestamp().count() == 20}")
    show(f"mode: {build_mode()}")
    return
