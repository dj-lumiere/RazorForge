module Tests/Stdlib/TypeArgOptionalApi

import IO/Console

# `T?` works inside the type arguments of a constructor call, as it does in an annotation: `List[Box?]()` is
# `List[Optional[Box]]()`.
entity Box
    n: S64

routine start()
    var xs = List[Box?]()
    xs.add_last(value: Box(n: 1))
    xs.add_last(value: none)
    var d = Dict[S64, Box?]()
    d[3] = Box(n: 9)
    var nested = List[List[Box?]]()
    nested.add_last(value: List[Box?]())
    show(f"{xs.count()} {d.count()} {nested.count()}")
    show(f"first present {xs[0].is_present()}, second present {xs[1].is_present()}")
    show("DONE")
    return
