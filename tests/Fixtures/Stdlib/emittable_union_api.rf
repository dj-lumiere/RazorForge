module Tests/Stdlib/EmittableUnionApi

import IO/Console
import EmitterTools

# A routine of a protocol that hands its own `you: Viewing[TOther]` to another routine with a type parameter of the
# same name (`union` calls `chain`) binds each from its own place in the parameter list: the called routine's `TOther`
# is the caller's argument, however the two are spelled.
routine start()
    var a = 1 to 4
    var b = 3 to 6
    show(f"union: {a.union(b).to[List]()}")
    show(f"union of lists: {[5, 1, 5].union([1, 9]).to[List]()}")
    return
