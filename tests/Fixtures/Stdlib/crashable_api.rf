module Tests/Stdlib/CrashableApi

import BuilderQuery
import IO/Console
# User-defined crashable type — exercises what declaring a crashable gives it.
crashable BadInputError
    nothing

@readonly
@override
routine BadInputError.crash_message() -> Text
    return "Input was not in the accepted range."

@readonly
@override
routine BadInputError.crash_title() -> Text
    return "BadInputError"

failable routine validate(n: S64) -> S64
    if n < 0
        throw BadInputError()
    return n * 2

routine start()
    # Happy path: check_ variant returns Check[T] (T is S64 record-typed)
    var ok = check validate(n: 5)
    show(f"ok type: {ok.type_name()}")
    show(f"ok: {ok}")

    # Failure path
    var err = check validate(n: -1)
    show(f"err: {err}")
    show(f"err diagnose: {err:?}")

    when err
        is BadInputError => show("  caught BadInputError")
        is S64 as v => show(f"  got value: {v}")

    # Stdlib-provided crashables
    var av = AbsentValueError()
    show(f"AbsentValueError.crash_title(): {av.crash_title()}")
    show(f"AbsentValueError.crash_message(): {av.crash_message()}")

    show("DONE")
    return
