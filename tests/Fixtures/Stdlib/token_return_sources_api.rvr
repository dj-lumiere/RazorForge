module Tests/Stdlib/TokenReturnSourcesApi

import IO/Console
# A routine may return a token taken from any of its token parameters, a different one on each return. The caller's
# token comes from every argument handed to them, so it stays usable while all of them do.

entity Box
    n: S64

routine shorter(x: Viewing[List[S64]], y: Viewing[List[S64]]) -> Viewing[List[S64]]
    if x.count() <= y.count()
        return x
    return y

routine shortest(p: Viewing[List[S64]], q: Viewing[List[S64]]) -> Viewing[List[S64]]
    return shorter(x: p, y: q)

routine first_box(x: Modifying[List[Box]], y: Modifying[List[Box]]) -> Modifying[Box]
    return if x.count() > 0 then x.modify_at(index: 0) else y.modify_at(index: 0)

routine start()
    var a = [1, 2, 3]
    var b = [4, 5]
    show(shorter(x: a, y: b))
    show(shorter(x: b, y: a))
    var w = shortest(p: a, q: b)
    show(w.count())
    var xs = List[Box]()
    var ys = List[Box]()
    ys.add_last(value: Box(n: 7))
    var first = first_box(x: xs, y: ys)
    first.n = 8
    show(ys[0].n)
    show("DONE")
    return
