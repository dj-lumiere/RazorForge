module Tests/Stdlib/RealFiniteApi

import IO/Console
import Numerics.[Real]
# Real is finite-only like Decimal: every operation that would hand back an infinity or a NaN throws
# instead. Poles throw DivisionByZeroError, results with no real value throw NumericDomainError, and
# results past the exponent range throw NumericOverflowError. `grab` names each one, `try` turns it
# into none, and the in-range neighbours keep working.
routine start()
    var zero = Real()
    var one = Real.one()
    var two = Real(from: 2_s64)
    var minus_one = Real(from: -1_s64)
    var minus_two = Real(from: -2_s64)
    var half = one / two
    var huge = Real(from: 1_000_000_000_000_000_000_s64)
    var giant = two ** Real(from: 576_460_752_303_423_488_s64)

    show("-- domain errors --")
    when grab minus_one.sqrt()
        is NumericDomainError e => show(f"sqrt -1: {e.crash_title()}")
        is Crashables e => show(f"sqrt -1 other: {e.crash_title()}")
        else v => show(f"sqrt -1 unexpected: {v}")
    when grab minus_one.sqrt(precision: 20_s32)
        is NumericDomainError e => show(f"sqrt -1 (20): {e.crash_title()}")
        is Crashables e => show(f"sqrt -1 (20) other: {e.crash_title()}")
        else v => show(f"sqrt -1 (20) unexpected: {v}")
    when grab minus_two.log()
        is NumericDomainError e => show(f"log -2: {e.crash_title()}")
        is Crashables e => show(f"log -2 other: {e.crash_title()}")
        else v => show(f"log -2 unexpected: {v}")
    when grab minus_two.log(precision: 20_s32)
        is NumericDomainError e => show(f"log -2 (20): {e.crash_title()}")
        is Crashables e => show(f"log -2 (20) other: {e.crash_title()}")
        else v => show(f"log -2 (20) unexpected: {v}")
    when grab minus_two.log2()
        is NumericDomainError e => show(f"log2 -2: {e.crash_title()}")
        is Crashables e => show(f"log2 -2 other: {e.crash_title()}")
        else v => show(f"log2 -2 unexpected: {v}")
    when grab minus_two.log10(precision: 20_s32)
        is NumericDomainError e => show(f"log10 -2 (20): {e.crash_title()}")
        is Crashables e => show(f"log10 -2 (20) other: {e.crash_title()}")
        else v => show(f"log10 -2 (20) unexpected: {v}")
    when grab two.asin()
        is NumericDomainError e => show(f"asin 2: {e.crash_title()}")
        is Crashables e => show(f"asin 2 other: {e.crash_title()}")
        else v => show(f"asin 2 unexpected: {v}")
    when grab minus_two.acos(precision: 20_s32)
        is NumericDomainError e => show(f"acos -2 (20): {e.crash_title()}")
        is Crashables e => show(f"acos -2 (20) other: {e.crash_title()}")
        else v => show(f"acos -2 (20) unexpected: {v}")
    when grab half.acosh()
        is NumericDomainError e => show(f"acosh 0.5: {e.crash_title()}")
        is Crashables e => show(f"acosh 0.5 other: {e.crash_title()}")
        else v => show(f"acosh 0.5 unexpected: {v}")
    when grab two.atanh()
        is NumericDomainError e => show(f"atanh 2: {e.crash_title()}")
        is Crashables e => show(f"atanh 2 other: {e.crash_title()}")
        else v => show(f"atanh 2 unexpected: {v}")
    when grab minus_two.pow(exp: half, precision: 20_s32)
        is NumericDomainError e => show(f"-2 pow 0.5 (20): {e.crash_title()}")
        is Crashables e => show(f"-2 pow 0.5 (20) other: {e.crash_title()}")
        else v => show(f"-2 pow 0.5 (20) unexpected: {v}")
    when grab minus_two ** half
        is NumericDomainError e => show(f"-2 ** 0.5: {e.crash_title()}")
        is Crashables e => show(f"-2 ** 0.5 other: {e.crash_title()}")
        else v => show(f"-2 ** 0.5 unexpected: {v}")
    show(f"try sqrt -1: {try minus_one.sqrt()}")
    show(f"try asin 2 (20): {try two.asin(precision: 20_s32)}")
    show(f"try acosh 0.5 (20): {try half.acosh(precision: 20_s32)}")
    show(f"try atanh 2 (20): {try two.atanh(precision: 20_s32)}")

    show("-- poles --")
    when grab zero.log()
        is DivisionByZeroError e => show(f"log 0: {e.crash_title()}")
        is Crashables e => show(f"log 0 other: {e.crash_title()}")
        else v => show(f"log 0 unexpected: {v}")
    when grab zero.log(precision: 20_s32)
        is DivisionByZeroError e => show(f"log 0 (20): {e.crash_title()}")
        is Crashables e => show(f"log 0 (20) other: {e.crash_title()}")
        else v => show(f"log 0 (20) unexpected: {v}")
    when grab zero.log2(precision: 20_s32)
        is DivisionByZeroError e => show(f"log2 0 (20): {e.crash_title()}")
        is Crashables e => show(f"log2 0 (20) other: {e.crash_title()}")
        else v => show(f"log2 0 (20) unexpected: {v}")
    when grab zero.log10()
        is DivisionByZeroError e => show(f"log10 0: {e.crash_title()}")
        is Crashables e => show(f"log10 0 other: {e.crash_title()}")
        else v => show(f"log10 0 unexpected: {v}")
    when grab one.atanh()
        is DivisionByZeroError e => show(f"atanh 1: {e.crash_title()}")
        is Crashables e => show(f"atanh 1 other: {e.crash_title()}")
        else v => show(f"atanh 1 unexpected: {v}")
    when grab minus_one.atanh(precision: 20_s32)
        is DivisionByZeroError e => show(f"atanh -1 (20): {e.crash_title()}")
        is Crashables e => show(f"atanh -1 (20) other: {e.crash_title()}")
        else v => show(f"atanh -1 (20) unexpected: {v}")
    show(f"try log 0: {try zero.log()}")
    show(f"try log2 0: {try zero.log2()}")
    show(f"try log10 0 (20): {try zero.log10(precision: 20_s32)}")

    show("-- overflow --")
    when grab huge.exp()
        is NumericOverflowError e => show(f"exp 1e18: {e.crash_title()}")
        is Crashables e => show(f"exp 1e18 other: {e.crash_title()}")
        else v => show(f"exp 1e18 unexpected: {v}")
    when grab huge.exp(precision: 20_s32)
        is NumericOverflowError e => show(f"exp 1e18 (20): {e.crash_title()}")
        is Crashables e => show(f"exp 1e18 (20) other: {e.crash_title()}")
        else v => show(f"exp 1e18 (20) unexpected: {v}")
    when grab (huge * huge).exp()
        is NumericOverflowError e => show(f"exp 1e36: {e.crash_title()}")
        is Crashables e => show(f"exp 1e36 other: {e.crash_title()}")
        else v => show(f"exp 1e36 unexpected: {v}")
    when grab (huge + huge).exp2()
        is NumericOverflowError e => show(f"exp2 2e18: {e.crash_title()}")
        is Crashables e => show(f"exp2 2e18 other: {e.crash_title()}")
        else v => show(f"exp2 2e18 unexpected: {v}")
    when grab huge.exp10()
        is NumericOverflowError e => show(f"exp10 1e18: {e.crash_title()}")
        is Crashables e => show(f"exp10 1e18 other: {e.crash_title()}")
        else v => show(f"exp10 1e18 unexpected: {v}")
    when grab huge.sinh()
        is NumericOverflowError e => show(f"sinh 1e18: {e.crash_title()}")
        is Crashables e => show(f"sinh 1e18 other: {e.crash_title()}")
        else v => show(f"sinh 1e18 unexpected: {v}")
    when grab huge.neg().sinh(precision: 20_s32)
        is NumericOverflowError e => show(f"sinh -1e18 (20): {e.crash_title()}")
        is Crashables e => show(f"sinh -1e18 (20) other: {e.crash_title()}")
        else v => show(f"sinh -1e18 (20) unexpected: {v}")
    when grab huge.neg().cosh()
        is NumericOverflowError e => show(f"cosh -1e18: {e.crash_title()}")
        is Crashables e => show(f"cosh -1e18 other: {e.crash_title()}")
        else v => show(f"cosh -1e18 unexpected: {v}")
    when grab huge.cosh(precision: 20_s32)
        is NumericOverflowError e => show(f"cosh 1e18 (20): {e.crash_title()}")
        is Crashables e => show(f"cosh 1e18 (20) other: {e.crash_title()}")
        else v => show(f"cosh 1e18 (20) unexpected: {v}")
    when grab Real(from: 10_s64) ** huge
        is NumericOverflowError e => show(f"10 ** 1e18: {e.crash_title()}")
        is Crashables e => show(f"10 ** 1e18 other: {e.crash_title()}")
        else v => show(f"10 ** 1e18 unexpected: {v}")
    when grab two.pow(exp: huge * huge, precision: 20_s32)
        is NumericOverflowError e => show(f"2 pow 1e36 (20): {e.crash_title()}")
        is Crashables e => show(f"2 pow 1e36 (20) other: {e.crash_title()}")
        else v => show(f"2 pow 1e36 (20) unexpected: {v}")
    when grab giant * giant
        is NumericOverflowError e => show(f"2^(2^59) squared: {e.crash_title()}")
        is Crashables e => show(f"2^(2^59) squared other: {e.crash_title()}")
        else v => show(f"2^(2^59) squared unexpected: {v}")
    when grab giant / (one / giant)
        is NumericOverflowError e => show(f"2^(2^59) / 2^-(2^59): {e.crash_title()}")
        is Crashables e => show(f"2^(2^59) / 2^-(2^59) other: {e.crash_title()}")
        else v => show(f"2^(2^59) / 2^-(2^59) unexpected: {v}")
    when grab giant + one
        is NumericOverflowError e => show(f"2^(2^59) + 1 exact: {e.crash_title()}")
        is Crashables e => show(f"2^(2^59) + 1 exact other: {e.crash_title()}")
        else v => show(f"2^(2^59) + 1 exact unexpected: {v}")
    when grab one - giant
        is NumericOverflowError e => show(f"1 - 2^(2^59) exact: {e.crash_title()}")
        is Crashables e => show(f"1 - 2^(2^59) exact other: {e.crash_title()}")
        else v => show(f"1 - 2^(2^59) exact unexpected: {v}")
    show(f"2^(2^59) + 2^(2^59) still exact: {(giant + giant).eq(you: giant * Real(from: 2_s64))}")
    var far = two ** Real(from: 1_099_511_627_776_s64)
    show(f"try 2^(2^40) + 1: {try far + one}")
    show(f"try 1 - 2^(2^40): {try one - far}")
    # sin, cos and tan of arguments whose quotient by pi/2 is past S64
    var p100 = two ** Real(from: 100_s64)
    var m1000 = (two ** Real(from: 1000_s64)).neg()
    show(f"sin 2^100: {p100.sin(precision: 20_s32).fixed(places: 15)} cos {p100.cos(precision: 20_s32).fixed(places: 15)} tan {p100.tan(precision: 20_s32).fixed(places: 15)}")
    show(f"sin -2^1000: {m1000.sin(precision: 20_s32).fixed(places: 15)} cos {m1000.cos(precision: 20_s32).fixed(places: 15)} tan {m1000.tan(precision: 20_s32).fixed(places: 15)}")
    show(f"try exp 1e18: {try huge.exp()}")
    show(f"try exp2 2e18: {try (huge + huge).exp2()}")
    show(f"try cosh 1e18: {try huge.cosh()}")

    show("-- inputs --")
    when grab Real(text: "nan")
        is InvalidValueError e => show(f"text nan: {e.crash_title()}")
        is Crashables e => show(f"text nan other: {e.crash_title()}")
        else v => show(f"text nan unexpected: {v}")
    when grab Real(text: "inf")
        is InvalidValueError e => show(f"text inf: {e.crash_title()}")
        is Crashables e => show(f"text inf other: {e.crash_title()}")
        else v => show(f"text inf unexpected: {v}")
    when grab Real(text: "-Infinity", radix: 16_s32)
        is InvalidValueError e => show(f"text -Infinity (16): {e.crash_title()}")
        is Crashables e => show(f"text -Infinity (16) other: {e.crash_title()}")
        else v => show(f"text -Infinity (16) unexpected: {v}")
    show(f"try text NaN: {try Real(text: "NaN")}")
    show(f"text 1.5e3 still parses: {Real(text: "1.5e3")}")
    var b64_inf = B64.from_bits(bits: 0x7FF0000000000000u64)
    var b64_nan = B64.from_bits(bits: 0x7FF8000000000000u64)
    when grab Real(from: b64_inf)
        is NumericOverflowError e => show(f"from b64 inf: {e.crash_title()}")
        is Crashables e => show(f"from b64 inf other: {e.crash_title()}")
        else v => show(f"from b64 inf unexpected: {v}")
    when grab Real(from: b64_inf.neg())
        is NumericOverflowError e => show(f"from b64 -inf: {e.crash_title()}")
        is Crashables e => show(f"from b64 -inf other: {e.crash_title()}")
        else v => show(f"from b64 -inf unexpected: {v}")
    when grab Real(from: b64_nan)
        is NumericDomainError e => show(f"from b64 nan: {e.crash_title()}")
        is Crashables e => show(f"from b64 nan other: {e.crash_title()}")
        else v => show(f"from b64 nan unexpected: {v}")
    show(f"try from b64 nan: {try Real(from: b64_nan)}")
    show(f"from b64 0.5: {Real(from: 0.5_b64)}")

    show("-- in range --")
    show(f"exp -1e18: {huge.neg().exp()}")
    show(f"0.5 ** 2e18: {half ** (huge + huge)}")
    show(f"tanh 1e18: {huge.tanh()}")
    show(f"tanh -1e18 (20): {huge.neg().tanh(precision: 20_s32)}")
    show(f"tanh 2^31 is 1: {Real(from: 2_147_483_648_s64).tanh() == one}")
    show(f"asinh -1e198 (20): {(huge ** Real(from: 11_s64)).neg().asinh(precision: 20_s32).represent_with_places(decimal_places: 10_s32)}")
    show(f"acosh 1: {one.acosh()}")
    show(f"atanh 0: {zero.atanh()}")
    show(f"log2 1/2: {half.log2()}")
    show(f"hypot giant, giant finite: {hypot(x: giant, y: giant) > giant}")
    show(f"hypot 3,4,12: {hypot(x: Real(from: 3_s64), y: Real(from: 4_s64), z: Real(from: 12_s64))}")
    show(f"2^(2^59) is finite: {giant > huge}")

    show("DONE")
    return
