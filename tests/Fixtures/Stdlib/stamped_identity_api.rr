module Tests/Stdlib/StampedIdentityApi

import IO/Console
# Two stamps compare with `===` / `!==`: the same entity (the same slot and generation). A stamp has no `==`. A stamp
# of an entity that ended is not the same as a stamp of the next entity in its slot.

entity Node
    value: S64

routine start()
    var a = Node(value: 1)
    var b = Node(value: 2)
    var sa: Stamped[Node] = a.stamp()
    var sb = b.stamp()
    show(sa === a.stamp())
    show(sa !== sb)
    show(sa === sb)
    var stamps = [sa, sb]
    var found: S64 = 0
    for at in stamps
        if at === sb
            found += 1
    show(found)
    drop a
    var c = Node(value: 3)
    var sc = c.stamp()
    show(sa === sc)
    show(sa !== sc)
    return
