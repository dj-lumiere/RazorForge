module Tests/Stdlib/SerialRoundtripApi

import IO/Console
# serialize and its reverse, sv.to[T](): every value that serializes
# rebuilds to an equal value. Choices serialize as their case name, flags as the list of set names,
# variants as a one-entry {arm: payload} table (None as none), and fixed-width scalars without their
# own SerialValue arm (S128, D64, Character, ...) as their text.

choice Color
    RED
    GREEN

flags Perm
    READ
    WRITE
    EXECUTE

variant Shape
    S64
    Text

variant Opt
    None
    S64

record Point
    x: S64
    y: S64

record Tagged
    label: Text
    at: Point
    color: Color
    perms: Perm
    big: S128

entity Player
    name: Text
    hp: S64

routine start()
    show(f"choice: {Color.GREEN.serialize()}")
    show(f"flags: {(Perm.READ and Perm.EXECUTE).serialize()}")
    show(f"s128: {7.to[S128]().serialize()}")

    var shape: Shape = Shape(from: 5)
    show(f"variant: {shape.serialize()}")
    var present: Opt = Opt(from: 9)
    var absent_opt: Opt = none
    show(f"optional: {present.serialize()} {absent_opt.serialize()}")

    var tagged = Tagged(
        label: "origin",
        at: Point(x: 3, y: 4),
        color: Color.RED,
        perms: Perm.READ and Perm.WRITE,
        big: 12.to[S128](),
    )
    var saved = tagged.serialize()
    show(f"record: {saved}")

    var back = saved.to[Tagged]()
    show(f"record back: {back.label} ({back.at.x}, {back.at.y}) {back.color} {back.perms} {back.big}")
    show(f"choice back: {Color.GREEN.serialize().to[Color]()}")
    show(f"flags back: {(Perm.READ and Perm.EXECUTE).serialize().to[Perm]()}")
    show(f"variant back: {shape.serialize().to[Shape]()}")
    show(f"optional back: {present.serialize().to[Opt]()} {absent_opt.serialize().to[Opt]()}")
    var hero = Player(name: "hero", hp: 30)
    var hero_back = hero.serialize().to[Player]()
    show(f"entity back: {hero_back.name} {hero_back.hp}")
    show(f"list back: {[1, 2, 3].serialize().to[List[S64]]()}")
    var u32_65: U32 = 65
    show(f"character back: {u32_65.to[Char]().serialize().to[Char]()}")
    # A list element that doesn't fit fails the whole rebuild, which `try` recovers.
    show(f"bad element: {try ["a"].serialize().to[List[S64]]()}")
    return
