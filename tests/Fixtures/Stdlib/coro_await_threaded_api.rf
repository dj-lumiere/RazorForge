module Tests/Stdlib/CoroAwaitThreadedApi

# An Agent's work waits on another Agent. Inside a fiber, `Agent[T].retrieve()` is UNCOLORED — it
# PARKS the waiting fiber and the inner work wakes it on completion, rather than blocking the worker
# thread. The same retrieve() that blocks a plain thread parks here.

import IO/Console
routine heavy(x: S64) -> S64
    return x * x

routine orchestrate(n: S64) -> S64
    var t = heavy.to[Agent](x: n)  # Agent[S64], started by the retrieve below
    var v = t.retrieve()  # inside a fiber: parks until the inner work wakes us (no block)
    return v + 1

routine start()
    var c = orchestrate.to[Agent](n: 6)  # Agent[S64], not started
    show(f"orchestrate => {c.retrieve()}")  # starts it with start_now(), it waits on the inner Agent
    return
