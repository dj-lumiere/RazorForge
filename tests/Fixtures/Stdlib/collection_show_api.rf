module Tests/Stdlib/CollectionShowApi

import BuilderExpansion
import Collections
import IO/Console

# Every collection shows itself with `show(x)` and `f"{x:?}"`: sequences as [a, b], sets as {a, b}, maps as
# {key: value}, the empty set as {} and the empty map as {:}. Text inside a collection is quoted. Sorted collections
# show in order, a PriorityQueue its `priority: element` pairs in the order they come out, and a range as it is
# written. The diagnose form puts the qualified type and the count around the same text.

record Particle
obeys Equatable, Splittable
    id: S64
    mass: S64

routine start()
    var numbers: List[S64] = [1, 2, 3]
    show(numbers)
    show(f"{numbers:?}")
    var words: List[Text] = ["a", "b"]
    show(f"{words} {words:?}")
    var ages: Dict[Text, S64] = {"ann": 31, "bob": 27}
    show(f"{ages} {ages:?}")
    var no_ages = Dict[Text, S64]()
    show(f"{no_ages} {no_ages:?}")
    var sets: List[Dict[S32, S32]] = [{1: 10, 2: 5}, Dict[S32, S32]()]
    show(sets)
    var seen: Set[S64] = {2, 1}
    show(f"{seen} {seen:?}")
    var none_seen = Set[S64]()
    show(f"{none_seen} {none_seen:?}")
    var fixed: Array[S64, 3] = [7, 8, 9]
    show(f"{fixed} {fixed:?}")

    show(f"{0 to 10} {0 til 10 by 2} {10 to 0 by -2}")
    var r = 0 til 10 by 2
    show(f"{r:?}")

    var queue = PriorityQueue[S64, Text]()
    queue.add(element: "d", priority: 4)
    queue.add(element: "a", priority: 1)
    queue.add(element: "c", priority: 3)
    queue.add(element: "b", priority: 2)
    show(f"{queue} {queue:?}")
    show(f"{queue.peek()} {queue.count()}")
    var no_queue = PriorityQueue[S64, Text]()
    show(no_queue)

    var index = SortedDict[S64, Text]()
    index[3] = "c"
    index[1] = "a"
    show(f"{index} {index:?}")
    var no_index = SortedDict[S64, Text]()
    show(f"{no_index} {no_index:?}")
    var tree = SortedSet[S64]()
    drop tree.add(3)
    drop tree.add(1)
    show(f"{tree} {tree:?}")
    var ranked = SortedList[S64]()
    ranked.add(3)
    ranked.add(1)
    ranked.add(3)
    show(f"{ranked} {ranked:?}")
    var ring = RotatableList[Char]()
    ring.add_last('b')
    ring.add_first('a')
    show(f"{ring} {ring:?}")
    var bits = BitList()
    bits.add_last(true)
    bits.add_last(false)
    show(f"{bits} {bits:?}")
    var marks = BitArray[3]()
    show(f"{marks} {marks:?}")
    var columns = SplitList[Particle]()
    columns.add_last(value: Particle(id: 1, mass: 2))
    show(f"{columns} {columns:?}")
    var fixed_columns = SplitArray[Particle, 1].blank()
    show(f"{fixed_columns} {fixed_columns:?}")
    return
