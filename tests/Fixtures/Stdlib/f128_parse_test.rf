module Tests/Stdlib/B128ParseTest

import IO/Console
# Covers Text -> B128 parse (pure RF: parse_float_components + b128_from_ratio,
# exact rational rounded once to binary128).

routine start()
    var a = "3.14".to[B128]()
    var b = "2.718281828459045".to[B128]()
    var c = "0".to[B128]()
    var d = "-1.5e10".to[B128]()
    show(f"3.14 -> {a}")
    show(f"e     -> {b}")
    show(f"0     -> {c}")
    show(f"-1.5e10 -> {d}")
    return
