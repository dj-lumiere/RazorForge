module Tests/Stdlib/GlobalApi

import IO/Console
# `global`s of types threads may share: initialized in dependency order when start() begins (`greeting` reads
# `base`, declared after it), reached from any routine, and torn down when start() ends.
global hits: Atomic[U64] = Atomic[U64](initial: 0)
global greeting: Text = f"hello {base}"
global base: Text = "world"
global table: Guarded[Table, MultiRead] = Guarded[Table, MultiRead](from: Table(names: List[Text]()))

entity Table
    names: List[Text]

routine record_hit(name: Text)
    hits.fetch_add(delta: 1)
    using table.modify() as t
        t.names.add_last(value: name)
    return

routine start()
    record_hit(name: "a")
    record_hit(name: "b")
    show(f"{greeting} {hits.load()}")
    using table.view() as t
        show(f"{t.names.count()}")
    show("DONE")
    return
