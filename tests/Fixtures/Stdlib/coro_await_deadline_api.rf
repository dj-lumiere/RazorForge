module Tests/Stdlib/CoroAwaitDeadlineApi

# Non-blocking timed wait. An Agent with a deadline that nothing started runs on an OS thread of its
# own (`start_apart()`). Inside a fiber, `job.waitfor(d).retrieve()` races that thread against the
# deadline WITHOUT blocking: the fiber parks on a deadline timer that is also wakeable by the work's
# completion, and resumes on whichever wins. If the work finishes first the value comes back, if the
# deadline wins it throws TaskTimeoutError (here caught via `try …retrieve()` -> None). The same call
# blocks with a deadline on a plain thread.

import IO/Console
routine quick(x: S64) -> S64
    return x + 1

routine slow(x: S64) -> S64
    waitfor(150ms)  # on the worker thread this just sleeps; outlives the 20ms deadline below
    return x + 1

routine in_time() -> S64
    # Worker returns immediately, well within the 5s deadline -> parks briefly, then the value.
    return (agent quick(x: 41)).waitfor(5s).retrieve()

routine times_out() -> S64
    # Worker takes 150ms but the deadline is 20ms -> the timer wins; `try …retrieve()` yields None.
    var r = try (agent slow(x: 41)).waitfor(20ms).retrieve()
    when r
        is None => return 99  # timed out, as expected
        is S64 as v => return v  # would be 42 if it had not timed out

routine start()
    show(f"in-time => {(agent in_time()).retrieve()}")
    show(f"timed-out => {(agent times_out()).retrieve()}")
    return
