module Tests/Stdlib/FloatNarrowApi

import IO/Console
# A conversion to a narrower float crashes when a finite value rounds to an infinity (try gives None),
# to_unchecked gives the infinity, and an infinity or NaN passes through both forms.
routine start()
    var big: B64 = 1.0e300
    var wide: B32 = 70000.0
    var top: B64 = inf
    var hole: B64 = nan
    var quad: B128 = big.to[B128]().mul_unchecked(you: big.to[B128]())
    var dec: D64 = 1.0e300
    var huge: D128 = 1.0e400
    var most: U128 = U128_MAX
    var small: S32 = 70000

    show(f"unchecked: {big.to_unchecked[B32]()} {big.to_unchecked[B16]()} {big.to_unchecked[BF16]()} {wide.to_unchecked[B16]()} {wide.to_unchecked[BF16]()}")
    show(f"unchecked B128: {quad.to_unchecked[B64]()} {quad.to_unchecked[B32]()} {quad.to_unchecked[B16]()}")
    show(f"unchecked decimals: {dec.to_unchecked[B32]()} {dec.to_unchecked[B16]()} {huge.to_unchecked[B64]()}")
    show(f"unchecked integers: {most.to_unchecked[B32]()} {small.to_unchecked[B16]()}")
    show(f"pass through: {top.to[B32]()} {(-top).to[B16]()} {top.to[BF16]()} {hole.to[B32]().is_nan()}")
    show(f"in range: {(1.5).to[B16]()} {(0.1).to[B32]() == (0.1).to_unchecked[B32]()} {(65504.0).to[B16]()}")

    when try big.to[B32]()
        is None => show("B64 to B32: overflow")
        else as v => show(f"B64 to B32: {v}")
    when try wide.to[B16]()
        is None => show("B32 to B16: overflow")
        else as v => show(f"B32 to B16: {v}")
    when try big.to[BF16]()
        is None => show("B64 to BF16: overflow")
        else as v => show(f"B64 to BF16: {v}")
    when try quad.to[B64]()
        is None => show("B128 to B64: overflow")
        else as v => show(f"B128 to B64: {v}")
    when try huge.to[B64]()
        is None => show("D128 to B64: overflow")
        else as v => show(f"D128 to B64: {v}")
    when try most.to[B32]()
        is None => show("U128 to B32: overflow")
        else as v => show(f"U128 to B32: {v}")
    when try small.to[B16]()
        is None => show("S32 to B16: overflow")
        else as v => show(f"S32 to B16: {v}")
    return
