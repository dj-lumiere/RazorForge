module Tests/Stdlib/ReturnOptionalEntityApi

import IO/Console

# A local `Node?` handed to a constructor inside a `return` ends at that return, so it moves without `steal`, set or
# empty.

entity Node
    value: S64
    left: Node?
    right: Node?

routine with_left(has: Bool) -> Node
    var left: Node? = none
    if has
        left = Node(value: 7, left: none, right: none)
    return Node(value: 1, left: left, right: none)

routine start()
    var set = with_left(has: true)
    var empty = with_left(has: false)
    show(f"{set.value} {empty.value}")
    when set.left
        is Node as n => show(n.value)
        else => show("none")
    when empty.left
        is Node as n => show(n.value)
        else => show("none")
    return
