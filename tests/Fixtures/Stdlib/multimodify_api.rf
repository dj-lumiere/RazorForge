module Tests/Stdlib/MultimodifyApi

import IO/Console
# `multimodify` hands out write tokens on two different entities, so an element of one can be held while the other
# grows: two tokens a routine takes may be the same list, and holding an element of one while the other changes
# shape is a build error (RF-S640) without it. The same entity twice is an AliasedTokensError.

record Point
    x: S64
    y: S64

routine grow_while_held(x: Modifying[List[Point]], y: Modifying[List[Point]])
    using multimodify(first: x, second: y) as (a, b)
        var p = a.modify_at(index: 0)
        each i in 1 to 100
            b.add_last(value: Point(x: i, y: i))
        p.x = 999
    return

routine start()
    var s = List[Point]()
    s.add_last(value: Point(x: 0, y: 0))
    var t = List[Point]()
    grow_while_held(x: s, y: t)
    show(f"held: {s[0].x}, grown: {t.count()}")
    when check multimodify(first: s, second: s)
        is AliasedTokensError => show("the same list twice: AliasedTokensError")
        is MultiModifying[List[Point]] => show("not reached")
    show("DONE")
    return
