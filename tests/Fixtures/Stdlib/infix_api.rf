module Tests/Stdlib/InfixApi

import IO/Console
# A routine marked `@infix` is written between its operands, left to right, looser than ranges and tighter than
# comparisons: `a plus b dot b` is `(a plus b) dot b`, and `a dot b > 10` compares the result.

record Vec
    x: S64
    y: S64

@infix
routine Vec.dot(you: Vec) -> S64
    return me.x * you.x + me.y * you.y

@infix
routine Vec.plus(you: Vec) -> Vec
    return Vec(x: me.x + you.x, y: me.y + you.y)

@infix
routine S64.max_with(you: S64) -> S64
    return if me > you then me else you

routine start()
    var a = Vec(x: 1, y: 2)
    var b = Vec(x: 3, y: 4)
    show(f"{a dot b}")
    show(f"{a plus b dot b}")
    show(f"{3 max_with 7 max_with 5}")
    var big = a dot b > 10
    show(f"{big}")
    show("DONE")
    return
