module Tests/Stdlib/RecoveryOperatorsApi

import IO/Console
# With `try`, `grab` or `lookup` in front of a call, a checked operator anywhere beneath it is recovered like a
# `throw`: a division by zero, an overflow, the negation of the minimum, a compound assignment, inside a loop,
# in a routine called bare, in a routine that is not failable at all. Only the carrier differs.

crashable NopeError

routine NopeError.crash_message() -> Text
    return "nope"

# depth 1: the operator is in the routine the keyword calls
failable routine ten_over(n: S64) -> S64
    if n < 0
        throw NopeError()
    var k = 10 // n
    return k

failable routine grow(n: S64) -> S64
    if n < 0
        throw AbsentValueError()
    return n + 9223372036854775800

failable routine bump(n: S64) -> S64
    if n < 0
        throw AbsentValueError()
    var total = n
    total += 9223372036854775800
    return total

failable routine negate(n: S64) -> S64
    if n > 0
        throw AbsentValueError()
    return -n

failable routine sum_quotients(n: S64) -> S64
    if n < 0
        throw AbsentValueError()
    var total = 0
    var i = 0
    until i >= 3
        total = total + 60 // (n - i)
        i = i + 1
    return total

# depth 2: the operator is in a failable routine called bare
failable routine via_bare(n: S64) -> S64
    var v = ten_over(n: n)
    return v + 1

# depth 2: the operator is in a routine that is not failable
failable routine hundred_over(n: S64) -> S64
    return 100 // n

failable routine via_plain(n: S64) -> S64
    if n < 0
        throw AbsentValueError()
    return hundred_over(n: n) + 1

# depth 3: the failure rises through failable routines only, each calling the next bare
failable routine inner_check(n: S64) -> S64
    if n == 0
        throw NopeError()
    return n

failable routine middle(n: S64) -> S64
    var v = inner_check(n: n)
    return v * 2

failable routine outer(n: S64) -> S64
    if n < 0
        throw AbsentValueError()
    var v = middle(n: n)
    return v + 1

# a loop condition, a branch of a conditional return and the fallback of `??` run only when reached
failable routine count_below(n: S64) -> S64
    if n < 0
        throw AbsentValueError()
    var i = 0
    until i >= 10 // n
        i = i + 1
    return i

failable routine pick_branch(n: S64) -> S64
    if n < 0
        throw AbsentValueError()
    return if n > -5 then 10 // n else 0

failable routine negative_only(n: S64) -> S64
    if n >= 0
        throw AbsentValueError()
    return n

failable routine or_quotient(n: S64) -> S64
    if n < -100
        throw AbsentValueError()
    return (try negative_only(n: n)) ?? 10 // n

record Pair
    a: S64
    b: S64

failable routine Pair.ratio() -> S64
    return me.a // me.b

routine start()
    show(f"try ten_over(5): {try ten_over(n: 5)}")
    show(f"try ten_over(0): {try ten_over(n: 0)}")
    show(f"grab ten_over(0): {check ten_over(n: 0)}")
    show(f"check ten_over(0): {check ten_over(n: 0)}")
    show(f"grab ten_over(-1): {check ten_over(n: -1)}")
    show(f"try grow(100): {try grow(n: 100)}")
    show(f"grab grow(100): {check grow(n: 100)}")
    show(f"check grow(-1): {check grow(n: -1)}")
    show(f"try bump(7): {try bump(n: 7)}")
    show(f"grab bump(100): {check bump(n: 100)}")
    show(f"grab negate(min): {check negate(n: -9223372036854775807 - 1)}")
    show(f"try negate(-4): {try negate(n: -4)}")
    show(f"try sum_quotients(10): {try sum_quotients(n: 10)}")
    show(f"check sum_quotients(1): {check sum_quotients(n: 1)}")
    show(f"try via_bare(2): {try via_bare(n: 2)}")
    show(f"grab via_bare(0): {check via_bare(n: 0)}")
    show(f"check via_bare(0): {check via_bare(n: 0)}")
    show(f"grab via_plain(0): {check via_plain(n: 0)}")
    show(f"try hundred_over(0): {try hundred_over(n: 0)}")
    show(f"grab hundred_over(4): {check hundred_over(n: 4)}")
    show(f"try outer(3): {try outer(n: 3)}")
    show(f"grab outer(0): {check outer(n: 0)}")
    show(f"check outer(0): {check outer(n: 0)}")
    show(f"check outer(-1): {check outer(n: -1)}")
    var p = Pair(a: 6, b: 0)
    show(f"grab p.ratio(): {check p.ratio()}")
    show(f"try (ratio) + 1: {try p.ratio() + 1}")
    when check via_bare(n: 0)
        is DivisionByZeroError as e => show(f"when: {e.crash_title()}")
        is S64 as v => show(f"when: {v}")
    show(f"try count_below: {try count_below(n: 2)} {try count_below(n: 0)}")
    show(f"grab pick_branch: {check pick_branch(n: 2)} {check pick_branch(n: 0)}")
    show(f"check or_quotient: {check or_quotient(n: -3)} {check or_quotient(n: 5)} {check or_quotient(n: 0)}")
    # a bare literal on the left of a checked operator takes the other operand's type (S32 here)
    var two: S32 = 2
    var zero: S32 = 0
    show(f"try 10 // two: {try 10 // two}")
    show(f"grab 10 // zero: {check 10 // zero}")
    show(f"check 100 - two: {check 100 - two}")
    show("DONE")
    return
