module Tests/Stdlib/EmitterMoreApi

import IO/Console
import IterTools

# Collecting into a fixed-size Array (C64), terminals and adapters straight on an emitter (C63), and emitters
# returned from a routine (C62).

routine big_ones(xs: Viewing[List[S64]]) -> WhereEmittable[S64, List[S64]]
    return xs.where(predicate: v => v > 1)

routine walk_of(xs: Viewing[List[S64]]) -> ListEmitter[S64]
    var it = xs.emitter()
    return it

routine taken() -> ListTakingEmitter[Text]
    var names: List[Text] = ["a", "b"]
    return (steal names).emitter()

routine start()
    var xs: List[S64] = [4, 1, 3]

    # to[Array[T, N]]: the bracket names the size, a different count fails.
    show(f"array: {xs.to[Array[S64, 3]]()}")
    show(f"array from where: {xs.where(predicate: v => v > 1).to[Array[S64, 2]]()}")
    show(f"array from range: {(1 to 4).to[Array[S64, 4]]()}")
    var names: List[Text] = ["a", "b"]
    show(f"array of text: {names.to[Array[Text, 2]]()}")
    when try xs.to[Array[S64, 2]]()
        is None => show("array of 2: none")
        else => show("array of 2: some")
    var short = check xs.to[Array[S64, 5]]()
    when short
        is ElementCountMismatchError as e => show(e.crash_message())
        else => show("array of 5: some")
    var long = check xs.to[Array[S64, 1]]()
    when long
        is ElementCountMismatchError as e => show(e.crash_message())
        else => show("array of 1: some")

    # Terminals and adapters on an emitter go on from where it is.
    var it = xs.emitter()
    show(f"first: {it.emit()}")
    show(f"rest: {it.to[List]()}")
    var counting = (1 to 5).emitter()
    drop counting.emit()
    show(f"sum of the rest: {counting.sum()}")
    var walk = xs.emitter()
    drop walk.emit()
    show(f"where on the rest: {walk.where(predicate: v => v > 1).to[List]()}")
    var whole = xs.emitter()
    show(f"max: {whole.max()}")

    # An emitter made from a token parameter goes back to the caller, a token on what it passed.
    each b in big_ones(xs: xs)
        show(f"returned adapter: {b}")
    var w = walk_of(xs: xs)
    show(f"returned emitter: {w.emit()}")
    var t = taken()
    each n in t
        show(f"returned taking emitter: {n}")
    return
