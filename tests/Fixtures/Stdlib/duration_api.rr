module Tests/Stdlib/DurationApi

import IO/Console
routine start()
    var zero = Duration.zero()
    show(f"zero: {zero}")

    var one_sec = Duration.from_seconds(s: 1)
    var one_ms = Duration.from_milliseconds(ms: 1)
    var one_us = Duration.from_microseconds(us: 1)
    var one_ns = Duration.from_nanoseconds(ns: 1)

    show(f"1s: {one_sec}")
    show(f"1ms: {one_ms}")
    show(f"1us: {one_us}")
    show(f"1ns: {one_ns}")

    # Arithmetic
    var two_sec = one_sec + one_sec
    show(f"1s + 1s: {two_sec}")
    show(f"2s - 1s: {two_sec - one_sec}")
    show(f"-1s: {-one_sec}")

    # Larger units
    var hour = Duration.from_hours(h: 1)
    var day = Duration.from_days(d: 1)
    show(f"1h: {hour}")
    show(f"1d: {day}")

    # Ordering
    show(f"1ns < 1us: {one_ns < one_us}")
    show(f"1us < 1ms: {one_us < one_ms}")
    show(f"1ms < 1s: {one_ms < one_sec}")
    show(f"1s == 1s: {one_sec == Duration.from_seconds(s: 1)}")

    # Multi-component formatting (space-separated)
    var hms = hour + Duration.from_minutes(m: 2) + Duration.from_seconds(s: 3)
    show(f"1h+2m+3s: {hms}")

    var full = day + hour + Duration.from_minutes(m: 2) + Duration.from_seconds(s: 3) + one_ms + one_us + one_ns
    show(f"all units: {full}")

    show(f"negative all units: {-full}")

    var minus_ten: Duration = -10s
    show(f"-10s // 3s: {minus_ten // 3s}")
    show(f"-10s % 3s: {minus_ten % 3s}")
    show(f"7s // -2s: {7s // -2s}")
    show(f"-1500ms % 1s: {-1500ms % 1s}")

    show("DONE")
    return
