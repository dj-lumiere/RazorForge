module Tests/Stdlib/FileMetadataApi

import IO/Console
import IO/Errors
import IO/File
# FileManager end to end on a known directory under the temp directory, so the output is deterministic:
# making, writing, reading, metadata, listing, moving, copying, and the failures a missing or existing file gives.
routine start()
    var root = FileManager.temp_directory().subdir(name: "rf_fixture_file_metadata_api")
    if FileManager.exists(at: root)
        FileManager.delete_all(at: root)
    drop FileManager.make_directory(at: root, parents: true)

    var f = FileManager.make_file(at: root.file(name: "hello.txt"))
    FileManager.write_text(at: f, content: "hello")
    FileManager.append_text(at: f, content: "!")
    show(f"read: {FileManager.read_text(at: f)}")
    drop FileManager.make_directory(at: root.subdir(name: "inner"))

    var m = FileManager.metadata(at: f)
    show(f"size: {m.size}")
    show(f"file is_directory: {m.is_directory}")
    show(f"dir is_directory: {FileManager.metadata(at: root).is_directory}")

    var entries = FileManager.entries(at: root)
    show(f"entries: {entries.count()}")
    var dirs: U64 = 0
    var hello_seen = false
    each e in entries
        if e.is_directory
            dirs += 1
        if e.name == "hello.txt"
            hello_seen = true
    show(f"directories: {dirs}")
    show(f"hello seen: {hello_seen}")

    # A missing file can't be read or written, and an existing one can't be made again.
    var missing = root.file(name: "missing.txt")
    show(f"read missing: {try FileManager.read_text(at: missing)}")
    when check FileManager.write_text(at: missing, content: "x")
        is None => show("write missing: written")
        is IOError => show("write missing: IOError")
    when check FileManager.make_file(at: f)
        is File => show("make existing: made")
        is IOError => show("make existing: IOError")
    drop FileManager.make_file(at: f, replacing: true)
    show(f"replaced size: {FileManager.size(at: f)}")

    # Move and copy refuse an existing destination unless replacing.
    var twin = root.file(name: "copy.txt")
    FileManager.copy(from: f, to: twin)
    when check FileManager.copy(from: f, to: twin)
        is None => show("copy again: copied")
        is IOError => show("copy again: IOError")
    var moved = root.file(name: "moved.txt")
    FileManager.move(from: twin, to: moved)
    show(f"moved: {FileManager.exists(at: moved)} {FileManager.exists(at: twin)}")

    FileManager.delete_all(at: root)
    show(f"cleaned: {not FileManager.exists(at: root)}")
    return
