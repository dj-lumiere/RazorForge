module Tests/Stdlib/FileMetadataApi
import IO/Console
import IO/File

# File.metadata() and Directory.entries() return records declared in IO/FileSystem, which IO/File
# imports. Builds a known directory under the temp directory so the output is deterministic.
routine start()
  var root = temp_dir().subdir(name: "rf_fixture_file_metadata_api")
  if root.exists()
    root.delete_all()
  root.create_all()

  var f = root.file(name: "hello.txt")
  discard f.write_text(content: "hello")
  root.subdir(name: "inner").create_all()

  var m = f.metadata()
  show(f"size: {m.size}")
  show(f"file is_directory: {m.is_directory}")
  show(f"dir is_directory: {root.metadata().is_directory}")

  var entries = root.entries()
  show(f"entries: {entries.count()}")
  var dirs: U64 = 0
  var hello_seen = false
  each e in entries
    if e.is_directory
      dirs += 1
    if e.name == "hello.txt"
      hello_seen = true
  show(f"directories: {dirs}")
  show(f"hello seen: {hello_seen}")

  root.delete_all()
  show(f"cleaned: {not root.exists()}")
  return
