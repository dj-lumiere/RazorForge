module Tests/Stdlib/CaughtErrorDisplay

import IO/Console

# A caught error shown whole (`show(e)`) shows its message, as `e.represent()` does, and the name an `else as` arm
# binds when only `None` is left holds `none`.

crashable NopeError
    what: Text

routine NopeError.crash_message() -> Text
    return f"nope: {me.what}"

failable routine half(n: S64) -> S64
    if n % 2 != 0
        throw AbsentValueError()
    return n // 2

failable routine nope() -> S64
    throw NopeError(what: "bad")

routine start()
    when check half(n: 3)
        is S64 as v => show(v)
        else as e => show(e)
    when check nope()
        is S64 as v => show(v)
        is Crashables as e => show(e)
    when try half(n: 3)
        is S64 as v => show(v)
        else as e => show(e)
    when try half(n: 4)
        is S64 as v => show(v)
        else as e => show(e)
    return
