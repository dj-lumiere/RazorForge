module Tests/Stdlib/NumericSignedApi

import IO/Console
# Exercises S8, S16, S32, S64, S128 — arithmetic, conversion, comparison, represent.
routine start()
    var s8: S8 = 100
    var s16: S16 = 1000
    var s32: S32 = 1_000_000
    var s64: S64 = 1_000_000_000_000
    var s128: S128 = 123_456_789_123_456_789

    show(f"S8:   {s8}")
    show(f"S16:  {s16}")
    show(f"S32:  {s32}")
    show(f"S64:  {s64}")
    show(f"S128: {s128}")

    # Arithmetic (same-width)
    show(f"S8 add: {s8 + 5}")
    show(f"S16 sub: {s16 - 1}")
    show(f"S32 mul: {s32 * 2}")
    show(f"S64 div: {s64 // 1000}")
    show(f"S64 mod: {s64 % 7}")

    # Comparison
    show(f"S64 100 < 200: {100 < 200}")
    show(f"S64 200 > 100: {200 > 100}")
    show(f"S64 50 == 50: {50 == 50}")
    show(f"S64 50 != 51: {50 != 51}")

    # Negation
    var s8_42: S8 = 42
    show(f"-S8 42: {-s8_42}")
    show(f"-S64 1000: {-1000}")

    # Conversions
    var n: S64 = s8_42.to[S64]()
    show(f"S8->S64 42: {n}")
    var n2: S32 = 12345.to[S32]()
    show(f"S64->S32 12345: {n2}")

    show("DONE")
    return
