module Tests/Stdlib/NumericUnsignedApi

import IO/Console
# Exercises U8, U16, U32, U64, U128 — arithmetic, conversion, comparison, bit ops.
routine start()
    var u8: U8 = 200
    var u16: U16 = 50000
    var u32: U32 = 4_000_000_000
    var u64: U64 = 18_000_000_000_000_000_000
    var u128: U128 = 340_282_366_920_938_463_463

    show(f"U8:   {u8}")
    show(f"U16:  {u16}")
    show(f"U32:  {u32}")
    show(f"U64:  {u64}")
    show(f"U128: {u128}")

    # Arithmetic
    show(f"U8 add: {u8 + 5}")
    show(f"U16 sub: {u16 - 1}")
    var u32_2: U32 = 2
    var u32_100: U32 = 100
    show(f"U32 mul: {u32_2 * u32_100}")
    show(f"U64 div: {u64 // 1000}")
    show(f"U64 mod: {u64 % 7}")

    # Bitwise
    var u32_0b1100: U32 = 0b1100
    var u32_0b1010: U32 = 0b1010
    show(f"U32 and: {u32_0b1100 & u32_0b1010}")
    show(f"U32 or: {u32_0b1100 | u32_0b1010}")
    show(f"U32 xor: {u32_0b1100 ^ u32_0b1010}")
    var u32_1: U32 = 1
    show(f"U32 shl: {u32_1 << 4}")
    var u32_16: U32 = 16
    show(f"U32 shr: {u32_16 >> 2}")

    # Comparison
    var u64_100: U64 = 100
    var u64_200: U64 = 200
    show(f"U64 100 < 200: {u64_100 < u64_200}")
    var u64_0: U64 = 0
    show(f"U64 0 == 0: {u64_0 == u64_0}")

    # Conversion
    var u8_42: U8 = 42
    var n: U64 = u8_42.to[U64]()
    show(f"U8->U64 42: {n}")

    show("DONE")
    return
