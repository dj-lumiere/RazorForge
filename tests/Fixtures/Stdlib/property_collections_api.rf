module Tests/Stdlib/PropertyCollectionsApi

import IO/Console
# Property-style invariants asserted in-RF. Each line prints PASS or FAIL — the
# snapshot oracle catches regressions even if a property's value happens to
# match a wrong expected output by coincidence.

routine expect(name: Text, ok: Bool)
    if ok
        show(f"PASS {name}")
    else
        show(f"FAIL {name}")
    return

routine start()
    # List: add+remove inverse
    var l: List[S64] = [1, 2, 3]
    l.add_last(value: 99)
    drop l.remove_last()
    expect(name: "list add_last + remove_last preserves size", ok: l.count() == 3_u64)
    expect(name: "list add_last + remove_last preserves last", ok: l[2] == 3_s64)

    # Set: contains-after-add
    var s: Set[S64] = {10, 20, 30}
    drop s.add(value: 40)
    expect(name: "set contains added value", ok: s have 40_s64)

    # Set: add idempotence
    var size_before = s.count()
    drop s.add(value: 40)
    expect(name: "set add duplicate is idempotent", ok: s.count() == size_before)

    # Set: remove inverse
    drop s.remove(value: 40)
    expect(name: "set remove undoes add", ok: s lack 40_s64)

    # Dict: add then get
    var d: Dict[S64, S64] = {1: 10, 2: 20}
    d[3] = 30
    expect(name: "dict add then index", ok: d[3] == 30_s64)
    expect(name: "dict contains_key after add", ok: d have 3_s64)

    # Dict: remove inverse
    drop d.remove(key: 3)
    expect(name: "dict remove undoes add", ok: d lack 3_s64)

    # Equality symmetry
    var a: List[S64] = [1, 2, 3]
    var b: List[S64] = [1, 2, 3]
    expect(name: "list equality reflexive", ok: a == a)
    expect(name: "list equality symmetric", ok: (a == b) == (b == a))

    show("DONE")
    return
