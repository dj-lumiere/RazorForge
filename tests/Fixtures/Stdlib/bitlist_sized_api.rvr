module Tests/Stdlib/BitListSizedApi
import IO/Console
import Collections

routine start()
    var ones = BitList(count: 70, fill_value: true)
    var zeros = BitList(count: 5, fill_value: false)
    var empty = BitList(count: 0, fill_value: true)
    show(f"{ones.count()} {ones.count_trues()} {zeros.count()} {zeros.count_trues()} {empty.count()}")
    ones[3] = false
    show(ones.count_trues())
    return
