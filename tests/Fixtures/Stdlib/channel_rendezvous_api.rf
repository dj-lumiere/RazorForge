module Tests/Stdlib/ChannelRendezvousApi

# v0.3.0 channels — rendezvous (capacity 0). With no buffer, every transmit is hand-to-hand: it parks
# until a consumer takes that exact item, so a completed transmit means the hand-off happened. Here a
# producer Work and a consumer Work cooperatively rendezvous three times. Proves the capacity-0 path (transmit waits for a taker, not for buffer space).

import IO/Console
routine produce(out: Transmitter[S64]) -> S64
    danger
        out.transmit(item: 7)  # each parks until the consumer takes it
        out.transmit(item: 8)
        out.transmit(item: 9)
    return 3

routine consume(inbox: Receiver[S64]) -> S64
    var total = 0
    for v in inbox
        total = total + v
    return total

routine start()
    var (feeder, hop) = make_channel[S64](capacity: 0)  # rendezvous: no buffered slots

    danger
        # The producer is started now (`start_now()`), the consumer is awaited (`retrieve`). Capacity-0
        # rendezvous: each transmit parks until the consumer takes it, so driving the consumer hands the two
        # jobs back and forth until the producer's Transmitter drops and the channel closes.
        produce.to[Work](out: steal feeder).start_now()
        var sum = consume.to[Work](inbox: steal hop).retrieve()
        show(f"sum={sum}")
    return
