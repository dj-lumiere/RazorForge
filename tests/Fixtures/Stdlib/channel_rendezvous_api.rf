module Tests/Stdlib/ChannelRendezvousApi

# v0.3.0 channels — rendezvous (capacity 0). With no buffer, every send! is hand-to-hand: it parks
# until a consumer takes that exact item, so a completed send means the hand-off happened. Here a
# producer Agent and a consumer Agent cooperatively rendezvous three times. Proves the capacity-0 path (send waits for a taker, not for buffer space).

import IO/Console
routine produce(out: Sender[S64]) -> S64
    danger
        out.send(item: 7)  # each parks until the consumer takes it
        out.send(item: 8)
        out.send(item: 9)
    return 3

routine consume(inbox: Receiver[S64]) -> S64
    var total = 0
    each v in inbox
        total = total + v
    return total

routine start()
    var (feeder, hop) = make_channel[S64](capacity: 0)  # rendezvous: no buffered slots

    danger
        # The producer is started now (`start_now()`), the consumer is awaited (`retrieve`). Capacity-0
        # rendezvous: each send parks until the consumer takes it, so driving the consumer hands the two
        # Agents back and forth until the producer's Sender drops and the channel closes.
        (agent produce(out: steal feeder)).start_now()
        var sum = (agent consume(inbox: steal hop)).retrieve()
        show(f"sum={sum}")
    return
