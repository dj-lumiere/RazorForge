module Tests/Stdlib/DefaultArgsApi
import IO/Console
import Numerics

# Parameter defaults are written into each call that leaves them out: a choice case, a preset, a letter,
# an empty collection, on a member routine, a generic routine and a suspended routine. A member conversion
# `x.Type()` is the construction `Type(x)`, its creator's defaults included.

choice Mode
    FAST
    SLOW

preset LIMIT: S64 = 42

entity Box
    v: S64

routine Box.bump(amount: S64 = 1)
    me.v = me.v + amount
    return

routine describe(mode: Mode = Mode.SLOW, limit: S64 = LIMIT, fill: Character = '*',
                 items: List[S64] = []) -> Text
    var m = if mode == Mode.FAST then "fast" else "slow"
    return f"{m} {limit} {fill} {items.count()}"

routine label_of[T](value: T, label: Text = "v") -> Text
    return f"{label}={value}"

suspended routine later(x: S64, extra: S64 = 100) -> S64
    return x + extra

routine start()
    show(describe())
    show(describe(mode: Mode.FAST, items: [1, 2]))
    show(describe(items: [3], mode: Mode.FAST))
    var b = Box(v: 0)
    b.bump()
    b.bump(amount: 5)
    show(f"{b.v}")
    show(label_of(value: 3))
    show(label_of(value: "t", label: "w"))
    show(f"{later(x: 1).retrieve()}")
    show(f"{'x'.Text()} {"12".Integer()} {65_u8.Character()}")
    return
