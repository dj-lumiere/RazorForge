module Tests/Stdlib/ShowBytesApi

import IO/Console

# `show(bytes)` writes the bytes literal that makes them (`b"\x61\x62"`), like any other value, and
# `stdout().push(data:)` writes the bytes themselves.

routine start()
    var raw = "ab".encode_as_utf8()
    show(raw)
    show(raw, end: "|\n")
    show(b'a')
    show(raw.count())
    drop stdout().push(data: "cd\n".encode_as_utf8())
    show("DONE")
    return
