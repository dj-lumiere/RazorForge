### Checks C128's operations rounded once on two operands, bit for bit.
routine check_c128_exact(op: Text, z: List[C128], w: List[C128], want: List[C128]) -> U64
    var i: U64 = 0
    until i >= z.count()
        var r: C128 = z[i]
        var a = z[i]
        var b = w[i]
        if op == "add"
            r = a + b
        elseif op == "sub"
            r = a - b
        elseif op == "mul"
            r = a * b
        elseif op == "div"
            r = a / b
        elseif op == "add_real"
            r = a + b.real
        elseif op == "sub_real"
            r = a - b.real
        elseif op == "mul_real"
            r = a * b.real
        elseif op == "div_real"
            r = a / b.real
        elseif op == "neg"
            r = -a
        elseif op == "conjugate"
            r = a.conjugate()
        elseif op == "reciprocal"
            r = a.reciprocal()
        if not same_c128(a: r, b: want[i])
            show(f"C128 {op} {a.diagnose()} {b.diagnose()}: {r.diagnose()}, want {want[i].diagnose()}")
        i += 1
    return i

### Whether two C128 values have the same bits in both parts.
routine same_c128(a: C128, b: C128) -> Bool
    return a.real.to_bits() == b.real.to_bits() and a.imag.to_bits() == b.imag.to_bits()

### Checks C128's squared modulus or modulus, bit for bit.
routine check_c128_part(op: Text, z: List[C128], want: List[B64]) -> U64
    var i: U64 = 0
    until i >= z.count()
        var r = z[i].abs()
        if op == "norm"
            r = z[i].norm()
        elseif op == "arg"
            r = z[i].arg()
        if r.to_bits() != want[i].to_bits()
            show(f"C128 {op} {z[i].diagnose()}: {r}, want {want[i]}")
        i += 1
    return i

### Checks an elementary function of C128 to within the bound `limit` in each part.
routine check_c128_near(op: Text, z: List[C128], want: List[C128], limit: List[B64]) -> U64
    var i: U64 = 0
    until i >= z.count()
        var a = z[i]
        var r = a.sqrt_unchecked()
        if op == "exp"
            r = a.exp_unchecked()
        elseif op == "ln"
            r = a.ln_unchecked()
        elseif op == "log10"
            r = a.log10()
        elseif op == "log2"
            r = a.log2()
        elseif op == "sin"
            r = a.sin()
        elseif op == "cos"
            r = a.cos()
        elseif op == "tan"
            r = a.tan()
        elseif op == "asin"
            r = a.asin()
        elseif op == "acos"
            r = a.acos()
        elseif op == "atan"
            r = a.atan()
        elseif op == "sinh"
            r = a.sinh_unchecked()
        elseif op == "cosh"
            r = a.cosh_unchecked()
        elseif op == "tanh"
            r = a.tanh()
        elseif op == "asinh"
            r = a.asinh()
        elseif op == "acosh"
            r = a.acosh()
        elseif op == "atanh"
            r = a.atanh()
        var dr = (r.real - want[i].real).abs()
        var di = (r.imag - want[i].imag).abs()
        if dr > limit[i] or di > limit[i]
            show(f"C128 {op} {a.diagnose()}: {r.diagnose()}, want {want[i].diagnose()}")
        i += 1
    return i

### A C128 from its parts' bits.
routine c128(re: U64, im: U64) -> C128
    return C128(real: B64.from_bits(bits: re), imag: B64.from_bits(bits: im))

