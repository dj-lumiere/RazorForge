module Tests/Stdlib/ComplexCrosscheckApi

import IO/Console

# C64, C128, and C256 against exact rational arithmetic and a high-precision reference: scripts/gen_complex_crosscheck.py
# writes this file. The sums, differences, products, quotients, reciprocals, squared moduli, moduli, scalings, and
# narrowings are rounded once, so each is checked bit for bit against the exact value rounded once (a tie to the
# even one, signed zeros included). The elementary functions are checked to within 8 units in the last place of the
# larger part of a 120 or 160 digit reference, principal branches with a zero part's sign picking the side of a cut.
# A line names each value that is off, then each operation prints how many it checked.

### Checks C64's operations rounded once on two operands, bit for bit.
routine check_c64_exact(op: Text, z: List[C64], w: List[C64], want: List[C64]) -> U64
    var i: U64 = 0
    until i >= z.count()
        var r: C64 = z[i]
        var a = z[i]
        var b = w[i]
        if op == "add"
            r = a + b
        elseif op == "sub"
            r = a - b
        elseif op == "mul"
            r = a * b
        elseif op == "div"
            r = a / b
        elseif op == "add_real"
            r = a + b.real
        elseif op == "sub_real"
            r = a - b.real
        elseif op == "mul_real"
            r = a * b.real
        elseif op == "div_real"
            r = a / b.real
        elseif op == "neg"
            r = -a
        elseif op == "conjugate"
            r = a.conjugate()
        elseif op == "reciprocal"
            r = a.reciprocal()
        if not same_c64(a: r, b: want[i])
            show(f"C64 {op} {a.diagnose()} {b.diagnose()}: {r.diagnose()}, want {want[i].diagnose()}")
        i += 1
    return i

### Whether two C64 values have the same bits in both parts.
routine same_c64(a: C64, b: C64) -> Bool
    return a.real.to_bits() == b.real.to_bits() and a.imag.to_bits() == b.imag.to_bits()

### Checks C64's squared modulus or modulus, bit for bit.
routine check_c64_part(op: Text, z: List[C64], want: List[B32]) -> U64
    var i: U64 = 0
    until i >= z.count()
        var r = z[i].abs()
        if op == "norm"
            r = z[i].norm()
        elseif op == "arg"
            r = z[i].arg()
        if r.to_bits() != want[i].to_bits()
            show(f"C64 {op} {z[i].diagnose()}: {r}, want {want[i]}")
        i += 1
    return i

### Checks an elementary function of C64 to within the bound `limit` in each part.
routine check_c64_near(op: Text, z: List[C64], want: List[C64], limit: List[B32]) -> U64
    var i: U64 = 0
    until i >= z.count()
        var a = z[i]
        var r = a.sqrt_unchecked()
        if op == "exp"
            r = a.exp_unchecked()
        elseif op == "ln"
            r = a.ln_unchecked()
        elseif op == "log10"
            r = a.log10()
        elseif op == "log2"
            r = a.log2()
        elseif op == "sin"
            r = a.sin()
        elseif op == "cos"
            r = a.cos()
        elseif op == "tan"
            r = a.tan()
        elseif op == "asin"
            r = a.asin()
        elseif op == "acos"
            r = a.acos()
        elseif op == "atan"
            r = a.atan()
        elseif op == "sinh"
            r = a.sinh_unchecked()
        elseif op == "cosh"
            r = a.cosh_unchecked()
        elseif op == "tanh"
            r = a.tanh()
        elseif op == "asinh"
            r = a.asinh()
        elseif op == "acosh"
            r = a.acosh()
        elseif op == "atanh"
            r = a.atanh()
        var dr = (r.real - want[i].real).abs()
        var di = (r.imag - want[i].imag).abs()
        if dr > limit[i] or di > limit[i]
            show(f"C64 {op} {a.diagnose()}: {r.diagnose()}, want {want[i].diagnose()}")
        i += 1
    return i

### A C64 from its parts' bits.
routine c64(re: U32, im: U32) -> C64
    return C64(real: B32.from_bits(bits: re), imag: B32.from_bits(bits: im))

