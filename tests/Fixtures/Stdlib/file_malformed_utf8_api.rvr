module Tests/Stdlib/FileMalformedUtf8Api

# Malformed UTF-8 fails by default: `read_text`, and a FileSource's `read_line`, `read_word`, `read_all` and `read_lines`,
# throw `MalformedUtf8Error` naming the byte. The `_lossy` twin of each reads the same file with U+FFFD in place of
# each malformed byte. The file is under the gitignored `.out` extension so the test leaves no tracked artifact.

import IO/Console
import IO/File
import System

routine receive_text(file: File) -> Text
    when check FileManager.read_text(at: file)
        is Text as text => return f"read {text.count()}"
        is MalformedUtf8Error as e => return e.crash_message()
        else => return "other"

routine receive_line(file: File) -> Text
    using FileManager.open_read(at: file) as r
        when check r.read_line()
            is Text as text => return f"line {text.count()}"
            is MalformedUtf8Error as e => return e.crash_message()
            else => return "other"

routine receive_word(file: File) -> Text
    using FileManager.open_read(at: file) as r
        when check r.read_word()
            is Text as text => return f"word {text.count()}"
            is MalformedUtf8Error as e => return e.crash_message()
            else => return "other"

routine receive_all(file: File) -> Text
    using FileManager.open_read(at: file) as r
        when check r.read_all()
            is Text as text => return f"all {text.count()}"
            is MalformedUtf8Error as e => return e.crash_message()
            else => return "other"

routine receive_lines(file: File) -> Text
    using FileManager.open_read(at: file) as r
        when check r.read_lines()
            is List[Text] as lines => return f"lines {lines.count()}"
            is MalformedUtf8Error as e => return e.crash_message()
            else => return "other"

routine malformed_pair() -> Bytes
    var raw = List[Byte]()
    var first: U8 = 0xFF
    raw.add_last(value: Byte(first))
    var second: U8 = 0xFE
    raw.add_last(value: Byte(second))
    return Bytes(from_list: raw)

routine start()
    var file = FileManager.make_file(at: File(at: "tests/Fixtures/Stdlib/file_malformed_utf8.out"), replacing: true)
    using FileManager.open_write(at: file) as f
        f.write("ok ".encode_as_utf8(), end: "")
        f.write(malformed_pair(), end: "")
        f.write(" bad".encode_as_utf8(), end: "")
    show(receive_text(file: file))
    show(receive_line(file: file))
    show(receive_word(file: file))
    show(receive_all(file: file))
    show(receive_lines(file: file))
    show(FileManager.read_text_lossy(at: file))
    using FileManager.open_read(at: file) as r
        show(r.read_line_lossy())
    using FileManager.open_read(at: file) as r
        show(r.read_word_lossy())
        show(r.read_word_lossy())
    using FileManager.open_read(at: file) as r
        show(r.read_all_lossy().count())
    return
