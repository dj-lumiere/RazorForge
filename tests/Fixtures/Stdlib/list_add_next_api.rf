module Tests/Stdlib/ListAddNextApi

import IO/Console
# add_next takes the steps in the order they run and adds them so that remove_last gives them back in that order.

entity Step
    name: Text

@override
routine Step.destruct()
    show(f"end {me.name}")
    return

routine start()
    var stack: List[S64] = [100]
    stack.add_next(1, 2, 3)
    show(f"{stack}")
    until stack.count() == 1
        show(f"run {stack.remove_last()}")

    var steps = List[Step]()
    steps.add_next(Step(name: "plan"), Step(name: "build"), Step(name: "test"))
    show(f"count {steps.count()}")
    var step = steps.remove_last()
    show(f"first {step.name}")
    var again = steps.remove_last()
    show(f"second {again.name}")
    return
