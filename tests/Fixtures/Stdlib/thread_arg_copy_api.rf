module Tests/Stdlib/ThreadArgCopyApi

import IO/Console
# Verifies the `agent` argument boundary discipline (RF-S632):
#   * a thread-shareable cell (Atomic[S64]) is passed BY REFERENCE — every worker
#     aliases the spawner's one cell, so 2 workers x 5 fetch_add = 10.
#   * a plain value record (Point) is passed BY VALUE — the worker mutates its OWN
#     copy, so the spawner's original is untouched after the retrieve.

record Point
    posted x: S64
    posted y: S64

# Atomic arg: shared by reference (the headline cross-thread sharing).
routine add_n(cell: Atomic[S64], times: S64) -> S64
    each i in 0 til times
        drop cell.fetch_add(delta: 1_s64)
    return times

# Plain-record arg: copied by value into the worker's own frame.
routine bump_point(p: Point) -> S64
    return p.x + p.y

routine start()
    var counter = Atomic[S64](initial: 0_s64)
    var a = agent add_n(cell: counter, times: 5_s64)
    var b = agent add_n(cell: counter, times: 5_s64)
    drop a.retrieve()
    drop b.retrieve()
    show(f"shared total: {counter.load()}")

    var origin = Point(x: 1_s64, y: 2_s64)
    var moved = agent bump_point(p: origin)
    var got = moved.retrieve()
    show(f"worker saw: {got}")
    show(f"origin x after join: {origin.x}")
    return
