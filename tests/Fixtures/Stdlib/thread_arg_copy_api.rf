module Tests/Stdlib/ThreadArgCopyApi

import IO/Console
# Verifies the `to[Work]` argument boundary discipline (RF-S632):
#   * a thread-shareable cell (Unbroken[S64]) is passed BY REFERENCE — every worker
#     aliases the spawner's one cell, so 2 workers x 5 fetch_add = 10.
#   * a plain value record (Point) is passed BY VALUE — the worker mutates its OWN
#     copy, so the spawner's original is untouched after the retrieve.

record Point
    posted x: S64
    posted y: S64

# Unbroken arg: shared by reference (the headline cross-thread sharing).
routine add_n(cell: Unbroken[S64], times: S64) -> S64
    each i in 0 til times
        drop cell.fetch_add(delta: 1)
    return times

# Plain-record arg: copied by value into the worker's own frame.
routine bump_point(p: Point) -> S64
    return p.x + p.y

routine start()
    var counter = Unbroken[S64](initial: 0)
    var a = add_n.to[Work](cell: counter, times: 5)
    var b = add_n.to[Work](cell: counter, times: 5)
    drop a.retrieve()
    drop b.retrieve()
    show(f"shared total: {counter.load()}")

    var origin = Point(x: 1, y: 2)
    var moved = bump_point.to[Work](p: origin)
    var got = moved.retrieve()
    show(f"worker saw: {got}")
    show(f"origin x after join: {origin.x}")
    return
