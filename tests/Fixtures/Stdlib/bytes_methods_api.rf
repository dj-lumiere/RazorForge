module Tests/Stdlib/BytesMethodsApi

import IO/Console
# Bytes manipulation — direct indexing, slicing, comparison, iteration.
routine start()
    var b = "hello".encode_as_utf8()
    show(f"count: {b.count()}")
    show(f"is_empty: {b.is_empty()}")

    # Indexing (each byte is U8)
    show(f"b[0]: {b[0]}")  # 'h' = 104
    show(f"b[1]: {b[1]}")  # 'e' = 101
    show(f"b[4]: {b[4]}")  # 'o' = 111

    # Equality
    show(f"hello.bytes == hello.bytes: {"hello".encode_as_utf8() == "hello".encode_as_utf8()}")
    show(f"hello.bytes == world.bytes: {"hello".encode_as_utf8() == "world".encode_as_utf8()}")

    # Iteration over bytes
    var sum: U64 = 0
    each byte in b
        sum = sum + byte.value().to[U64]()
    show(f"byte sum: {sum}")

    # Multi-byte UTF-8 (Korean) — byte count > codepoint count
    var k = "한".encode_as_utf8()
    show(f"한 byte count: {k.count()}")

    show("DONE")
    return
