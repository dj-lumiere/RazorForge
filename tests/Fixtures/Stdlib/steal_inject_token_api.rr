module Tests/Stdlib/StealInjectTokenApi

# An element taken out with `steal … as … inject …` through a write token: the new value goes in as the old one
# comes out, and the old one is the taker's to keep.

import IO/Console

entity Item
    name: Text

routine swap_out(items: Modifying[List[Item]], index: U64) -> Text
    steal items[index] as old inject Item(name: "fresh")
    return old.name

routine start()
    var items = List[Item]()
    items.add_last(value: Item(name: "a"))
    items.add_last(value: Item(name: "b"))
    var taken = swap_out(items: items, index: 1)
    show(f"{taken} {items[0].name} {items[1].name}")
    return
