module Tests/Stdlib/GenericLiteralRecordApi

import IO/Console
import Collections
# A bare literal given to a type parameter takes the concrete type after the routine is made for it: an `Integer` or
# `Decimal` one is built as that number, so comparing with it is right. A range of either shows its step only when it
# is not 1. `BitArray[3].blank()` takes 3 as the bit count, as `BitArray[3]()` does.

routine is_one[T](x: T) -> Bool
needs T obeys Comparable
    var one: T = 1
    return x == one

routine not_one[T](x: T) -> Bool
needs T obeys Comparable
    var one: T = 1
    return x != one

routine start()
    var a: Integer = 1
    var b: Integer = 2
    show(f"{is_one(x: a)} {is_one(x: b)} {not_one(x: a)} {not_one(x: b)}")
    var c: S64 = 1
    show(f"{is_one(x: c)} {not_one(x: c)}")
    var d: Decimal = 1
    var e: Decimal = 3
    show(f"{is_one(x: d)} {not_one(x: e)}")
    var low: Integer = 0
    var high: Integer = 9
    var two: Integer = 2
    show(f"{low to high} {low til high by two} {high to low by -two}")
    var dlow: Decimal = 0
    var dhigh: Decimal = 4
    show(f"{dlow to dhigh}")
    var bits = BitArray[3].blank()
    show(f"{bits.count()}")
    show("DONE")
    return
