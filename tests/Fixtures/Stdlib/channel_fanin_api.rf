module Tests/Stdlib/ChannelFanInApi

# Channels — cooperative fan-in with backpressure. Two producer Agents and one consumer Agent share a
# capacity-2 Receiver, all started with `start_now()` on the runtime's pool. When the buffer fills, a
# producer's send PARKS (cooperative backpressure) and the consumer runs, draining and waking the
# producer. When the buffer empties, the consumer's receive parks and the producers run. No deadlock
# (parking, not blocking).
#
# Each producer owns its Sender (one cloned, one the original), so once both finish and their Feeders
# drop, the channel auto-closes and the consumer's `for` loop ends.

import IO/Console
# Feeds lo..hi-1, parking cooperatively whenever the buffer is full. `out` drops on return.
routine produce(out: Sender[S64], lo: S64, hi: S64) -> S64
    var i = lo
    danger
        while i < hi
            out.send(item: i)
            i = i + 1
    return hi - lo

# Drains the channel until it closes, summing the values; parks cooperatively while empty.
routine consume(inbox: Receiver[S64]) -> S64
    var total = 0_s64
    each v in inbox
        total = total + v
    return total

routine start()
    var (feeder, hop) = make_channel[S64](capacity: 2)

    danger
        # Start the two producers now (`start_now()` — we don't need their counts), then await the
        # consumer (`retrieve`). All three run concurrently, ping-ponging under backpressure until both
        # Feeders drop and the channel closes.
        (agent produce(out: steal feeder.duplicate(), lo: 1, hi: 6)).start_now()  # 1+2+3+4+5     = 15
        (agent produce(out: steal feeder, lo: 10, hi: 15)).start_now()  # 10+11+12+13+14 = 60
        var sum = (agent consume(inbox: steal hop)).retrieve()
        show(f"sum={sum}")
    return
