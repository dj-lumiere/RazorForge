module Tests/Stdlib/EmitterGapsApi

import IO/Console
import IterTools

# Forms that once passed analysis and then stopped the LLVM emitter or the linker.
entity Box
    n: S64

entity Battery
    level: S64

entity Labeled[T]
    label: Text
    item: T

record Pair[TFirst, TSecond]
needs RecordType TFirst, RecordType TSecond
    first: TFirst
    second: TSecond

failable routine half(n: S64) -> S64
    if n % 2 != 0
        throw InvalidValueError(input: n.represent(), target: "an even number")
    return n // 2

routine start()
    # A raw bytes literal keeps its backslash.
    var raw = br"a\n"
    show(raw.count())

    # A value assigned to an optional variable becomes a present optional.
    var port: S64? = none
    port ??= 8080
    show(port)
    var later: S64? = none
    later = 5
    show(later)

    # `!!` on a Check gives the value.
    show(check half(n: 4) !!)

    # A lambda captures a value it uses in a chained comparison.
    var low: S64 = 2
    var mid = [1, 3, 5, 7].where(predicate: n given low => low <= n < 6).to[List]()
    show(mid)

    # `strip_out` moves the value out of an optional, an entity's too.
    var m: Box? = Box(n: 3)
    var b = m.strip_out()
    show(b.n)
    var t: Text? = "hi"
    show(t.strip_out())

    # An entity holding an entity moves with `steal`.
    var slot = Labeled[Battery](label: "a", item: Battery(level: 5))
    var moved = steal slot
    show(moved.item.level)

    # A field-by-field construction infers the type arguments.
    var pair = Pair(first: 1, second: "one")
    show(pair.second)

    # An element `for` hands out converts like the value it is on.
    var total: S64 = 0
    for w in ["1", "22"]
        total += w.to[S64]()
    show(total)
    return
