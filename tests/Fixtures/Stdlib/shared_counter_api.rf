module Tests/Stdlib/SharedCounterApi

import IO/Console
# The headline of the concurrency data layer: N Agents incrementing ONE shared
# counter. The Atomic[S64] cell lives on start()'s frame, and an `Atomic` parameter
# is always passed by reference, so every worker's `cell` aliases the same storage.
# We retrieve every worker BEFORE reading the cell, so the total is deterministic
# and the cell outlives every worker.

routine add_n(cell: Atomic[S64], times: S64, amount: S64) -> S64
    each i in 0 til times
        drop cell.fetch_add(delta: amount)
    return times

routine start()
    var counter = Atomic[S64](initial: 0_s64)

    # 4 workers x 1000 increments of 1 = 4000, regardless of interleaving.
    var t1 = agent add_n(cell: counter, times: 1000_s64, amount: 1_s64)
    var t2 = agent add_n(cell: counter, times: 1000_s64, amount: 1_s64)
    var t3 = agent add_n(cell: counter, times: 1000_s64, amount: 1_s64)
    var t4 = agent add_n(cell: counter, times: 1000_s64, amount: 1_s64)

    drop t1.retrieve()
    drop t2.retrieve()
    drop t3.retrieve()
    drop t4.retrieve()

    show(f"total: {counter.load()}")
    return
