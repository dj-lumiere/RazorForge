module Tests/Stdlib/SharedCounterApi

import IO/Console
# The headline of the concurrency data layer: N jobs incrementing ONE shared
# counter. The Unbroken[S64] cell lives on start()'s frame, and an `Unbroken` parameter
# is always passed by reference, so every worker's `cell` aliases the same storage.
# We retrieve every worker BEFORE reading the cell, so the total is deterministic
# and the cell outlives every worker.

routine add_n(cell: Unbroken[S64], times: S64, amount: S64) -> S64
    for i in 0 til times
        drop cell.fetch_add(delta: amount)
    return times

routine start()
    var counter = Unbroken[S64](initial: 0)

    # 4 workers x 1000 increments of 1 = 4000, regardless of interleaving.
    var t1 = add_n.to[Work](cell: counter, times: 1000, amount: 1)
    var t2 = add_n.to[Work](cell: counter, times: 1000, amount: 1)
    var t3 = add_n.to[Work](cell: counter, times: 1000, amount: 1)
    var t4 = add_n.to[Work](cell: counter, times: 1000, amount: 1)

    drop t1.retrieve()
    drop t2.retrieve()
    drop t3.retrieve()
    drop t4.retrieve()

    show(f"total: {counter.load()}")
    return
