module Tests/Stdlib/ForCompoundApi

import IO/Console
# A compound assignment reads the token a `for` loop binds, like the binary form does.

routine start()
    var xs = List[S64]()
    xs.add_last(value: 3)
    xs.add_last(value: 4)
    var total = 0
    for x in xs
        total += x
    var other = 0
    for x in xs
        other = other + x
    show(f"{total} {other}")
    show("DONE")
    return
