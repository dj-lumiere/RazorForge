module Tests/Stdlib/TuplePatternApi

import IO/Console
# A parenthesized `when` arm is a tuple pattern: each element binds or tests the member at its position.
routine describe(point: (S64, S64)) -> Text
    when point
        (0, 0) => return "origin"
        (x, 0) => return f"x-axis {x}"
        (0, y) => return f"y-axis {y}"
        (x, y) => return f"at {x}, {y}"
    return "unreachable"

routine start()
    show(describe(point: (0, 0)))
    show(describe(point: (3, 0)))
    show(describe(point: (0, 4)))
    show(describe(point: (5, 6)))
    var n = 3
    unless n > 5
        show("small")
    else
        show("big")
    return
