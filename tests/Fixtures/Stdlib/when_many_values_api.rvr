module Tests/Stdlib/WhenManyValuesApi

import IO/Console
choice Color
    RED
    GREEN
    BLUE

# One arm takes several values after `==`, for numbers and for choice cases, which count as covered.
routine days(month: S64) -> S64
    when month
        == 4, 6, 9, 11 => return 30
        == 2 => return 28
        else => return 31

routine warm(c: Color) -> Bool
    when c
        == RED, GREEN => return true
        == BLUE => return false

routine start()
    show(f"{days(month: 4)} {days(month: 2)} {days(month: 7)} {days(month: 11)}")
    show(f"{warm(c: RED)} {warm(c: GREEN)} {warm(c: BLUE)}")
    show("DONE")
    return
