module Tests/Stdlib/WhenIsnotApi
import IO/Console

# `isnot T` in a when clause matches exactly when `is T` does not, on a user variant and on a carrier.

record Point
    x: S64
    y: S64

variant Shape
    Point
    Text

routine kind(s: Shape) -> Text
    when s
        isnot Point => return "not a point"
        else => return "point"

routine pick!(x: S64) -> S64
    if x < 0
        absent
    return x

routine maybe_kind(x: S64) -> Text
    var m = try pick(x: x)
    when m
        isnot None => return "present"
        else => return "absent"

routine start()
    show(kind(s: Point(x: 1, y: 2)))
    show(kind(s: "t"))
    show(maybe_kind(x: 3))
    show(maybe_kind(x: -1))
    return
