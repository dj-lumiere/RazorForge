module Tests/Stdlib/IntToFloatOverflowApi

import IO/Console
# An `Int` past a binary float's range fails with NumericOverflowError instead of turning into an infinity, for each
# sign. A value that rounds to the largest finite float still converts.

routine show_b32(label: Text, v: Int)
    when check v.to[B32]()
        is B32 as x => show(f"{label}: {x}")
        is NumericOverflowError => show(f"{label}: NumericOverflowError")
    return

routine show_b64(label: Text, v: Int)
    when check v.to[B64]()
        is B64 as x => show(f"{label}: {x}")
        is NumericOverflowError => show(f"{label}: NumericOverflowError")
    return

routine start()
    var one: Int = 1
    show_b32(label: "2^127 to B32", v: one << 127)
    show_b32(label: "2^128 to B32", v: one << 128)
    show_b32(label: "-2^200 to B32", v: -(one << 200))
    show_b32(label: "(2^128 - 2^103) to B32", v: (one << 128) - (one << 103))
    show_b32(label: "(2^128 - 2^104) to B32", v: (one << 128) - (one << 104))
    show_b64(label: "2^1023 to B64", v: one << 1023)
    show_b64(label: "2^1024 to B64", v: one << 1024)
    show_b64(label: "-2^1100 to B64", v: -(one << 1100))
    show_b64(label: "2^100 to B64", v: one << 100)
    return
