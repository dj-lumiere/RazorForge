module Tests/Stdlib/GatherApi

# gather() — the twin of race(). Where race() returns the FIRST finisher, gather() starts every Agent
# nothing started (with `start_now()`), drives the whole set CONCURRENTLY and waits for ALL of them,
# returning their results in INPUT order. The set is a List[Agent[T]] over different routines, and the
# total wait is the slowest agent, not the sum. Completed agents are freed at teardown.

import IO/Console
# First routine: parks `x` ms, then returns x*10.
routine compute(x: S64) -> S64
    waitfor(Duration.from_milliseconds(ms: x))
    return x * 10

# Second routine: parks `x` ms, then returns x+100.
routine twork(x: S64) -> S64
    waitfor(Duration.from_milliseconds(ms: x))
    return x + 100

routine start()
    # Same-routine set: results come back in INPUT order even though the middle one finishes first.
    var coros = List[Agent[S64]]()
    coros.add_last(value: compute.to[Agent](x: 30))
    coros.add_last(value: compute.to[Agent](x: 5))
    coros.add_last(value: compute.to[Agent](x: 15))
    var rs = coros.gather()
    show(f"coros => {rs[0]} {rs[1]} {rs[2]}")

    # Mixed set over two routines: both run at once, gathered in order.
    var mixed = List[Agent[S64]]()
    mixed.add_last(value: compute.to[Agent](x: 10))
    mixed.add_last(value: twork.to[Agent](x: 20))
    var rs2 = mixed.gather()
    show(f"mixed => {rs2[0]} {rs2[1]}")
    return
