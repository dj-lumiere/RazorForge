module Tests/Stdlib/ForValueTokenIndexApi

import IO/Console
# `for x in xs` over a list of values hands out a token on each value. Where a value is read, the token reads it:
# as an index, in arithmetic, in a comparison, and in a declared-type variable.

routine start()
    var xs = List[S64]()
    xs.add_last(value: 2)
    xs.add_last(value: 0)
    xs.add_last(value: 2)
    var seen = List[Bool](count: 3, fill_value: false)
    var hits = List[S64](count: 3, fill_value: 0)
    var last: S64 = -1
    for x in xs
        seen[x] = true
        hits[x] = hits[x] + 1
        last = x
    show(seen)
    show(hits)
    show(last)

    # A token kept in a variable stays a token on the element. The value read from it is a copy.
    var total: S64 = 0
    for w in xs
        var x = w
        var next: S64 = (x + 1) % 3
        seen[next] = false
        total += x
    show(seen)
    show(total)
    return
