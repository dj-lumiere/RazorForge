module Tests/Stdlib/NumericArbitraryApi

import IO/Console
import Numerics.[Integer, Decimal]
# Exercises Integer and Decimal, the arbitrary-precision counterparts.
routine start()
    var big: Integer = 123_456_789.to[Integer]() * 987_654_321.to[Integer]()
    show(f"big: {big}")

    var dec: Decimal = 1.to[Decimal]() / 7.to[Decimal]()
    show(f"dec 1/7: {dec}")

    # Comparisons
    show(f"big > 0: {big > 0.to[Integer]()}")
    show(f"big == big: {big == big}")

    show("DONE")
    return
