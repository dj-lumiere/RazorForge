module Tests/Stdlib/NumericArbitraryApi

import IO/Console
import Numerics.[Integer, Decimal]
# Exercises Integer and Decimal, the arbitrary-precision counterparts.
routine start()
    var big: Integer = Integer(from: 123_456_789_s64) * Integer(from: 987_654_321_s64)
    show(f"big: {big}")

    var dec: Decimal = Decimal(from: 1_s64) / Decimal(from: 7_s64)
    show(f"dec 1/7: {dec}")

    # Comparisons
    show(f"big > 0: {big > Integer(from: 0_s64)}")
    show(f"big == big: {big == big}")

    show("DONE")
    return
