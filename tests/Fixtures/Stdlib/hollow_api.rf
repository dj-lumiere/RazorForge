module Tests/Stdlib/HollowApi

import IO/Console
import Collections
# `T.hollow()` is the all-zero value every type has: 0, false, an empty handle, a collection with no memory, a
# choice's first member, and for an entity a new entity whose member variables are all zero. It is dangerous, so it
# is called inside `danger`. The nine handle types and Addr say whether they are hollow with `is_hollow()`, and
# every `destruct` leaves a hollow value alone when its scope ends.

choice Color
    RED
    GREEN

record Point
    x: S64
    y: S64

entity Bag
    items: List[S64]
    label: Text

routine start()
    danger
        var n = S64.hollow()
        var flag = Bool.hollow()
        var color = Color.hollow()
        var point = Point.hollow()
        show(f"{n} {flag} {color == Color.RED} {point.x} {point.y}")
        var list = List[S64].hollow()
        show(f"{list.count()} {list.is_empty()}")
        list.add_last(value: 7)
        show(f"{list.count()} {list[0]}")
        var bag = Bag.hollow()
        show(bag.items.hijack().is_hollow())
        var retained = Retained[Bag].hollow()
        var tracked = Tracked[Bag].hollow()
        var guarded = Guarded[Bag, Exclusive].hollow()
        var witnessed = Witnessed[Bag, Exclusive].hollow()
        var hijacked = Hijacked[S64].hollow()
        show(f"{retained.is_hollow()} {tracked.is_hollow()} {guarded.is_hollow()} {witnessed.is_hollow()}")
        show(f"{hijacked.is_hollow()} {Addr.hollow().is_hollow()}")
        var roamed = Roamed[Bag].hollow()
        var watched = Watched[Bag].hollow()
        var seen = Viewing[Bag].hollow()
        var changed = Modifying[Bag].hollow()
        show(f"{roamed.is_hollow()} {watched.is_hollow()} {seen.is_hollow()} {changed.is_hollow()}")
        var text = Text.hollow()
        var dict = Dict[S64, Text].hollow()
        var set = Set[S64].hollow()
        var big = Integer.hollow()
    var real = Retained[Bag](from: Bag(items: [1, 2], label: "real"))
    show(real.is_hollow())
    show("done")
    return
