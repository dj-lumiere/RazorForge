module Tests/Stdlib/BacktickNamesApi

import IO/Console
# A name between backticks: a keyword as a name, or words with a space, in declarations, calls and f-text holes.
routine `check`(`some value`: S64, 개수: S64) -> S64
    return `some value` + 개수

routine start()
    var `total count` = 3
    var `if` = 4
    show(f"{`check`(`some value`: `total count`, 개수: `if`)} {`total count`}")
    show("DONE")
    return
