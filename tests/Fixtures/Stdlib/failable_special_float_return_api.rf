module Tests/Stdlib/FailableSpecialFloatReturnApi

import IO/Console
# A failable routine returning B16 or B32 that returns a bare `inf`, `-inf` or `nan`: the `try` / `check` recovery
# variant keeps the literal at the routine's own float width.

failable routine pick(x: S64) -> B32
    if x > 5
        throw VerificationFailedError()
    if x > 2
        return nan
    if x > 0
        return inf
    return -inf

failable routine low(x: S64) -> B16
    if x > 5
        throw VerificationFailedError()
    return -inf

routine show_pick(x: S64)
    when try pick(x: x)
        is None =>
            show("none")
        else as v =>
            show(f"{v}")
    return

routine start()
    show_pick(x: 0)
    show_pick(x: 1)
    show_pick(x: 3)
    show_pick(x: 9)
    when check low(x: 1)
        is Crashables as e =>
            show("failed")
        else as v =>
            show(f"{v}")
    return
