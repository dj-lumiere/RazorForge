module Tests/Stdlib/RangeHaveApi
import IO/Console

routine start()
  show(f"{0 to 10 have 10}")
  show(f"{0 til 10 have 10}")
  show(f"{0 to 10 have 0}")
  show(f"{0 to 10 have 11}")
  show(f"{0 to 10 have -1}")
  show(f"{0 to 10 by 2 have 4}")
  show(f"{0 to 10 by 2 have 3}")
  show(f"{0 to 10 lack 3}")
  var r = 1 to 9 by 4
  show(f"{r have 9}")
  show(f"{r have 5}")
  show(f"{r have 6}")
  return
