module Tests/Stdlib/RangeHaveApi

import IO/Console
routine start()
    show(f"{(0 to 10).has(10)}")
    show(f"{(0 til 10).has(10)}")
    show(f"{(0 to 10).has(0)}")
    show(f"{(0 to 10).has(11)}")
    show(f"{(0 to 10).has(-1)}")
    show(f"{(0 to 10 by 2).has(4)}")
    show(f"{(0 to 10 by 2).has(3)}")
    show(f"{(0 to 10).lacks(3)}")
    var r = 1 to 9 by 4
    show(f"{r.has(9)}")
    show(f"{r.has(5)}")
    show(f"{r.has(6)}")
    return
