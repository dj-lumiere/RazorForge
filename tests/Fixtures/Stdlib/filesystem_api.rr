module Tests/Stdlib/FilesystemApi

import IO/Console
import IO/File
# Path members only, no disk I/O, so the fixture is deterministic and parallel-safe.
routine start()
    var z = File(at: "/x/y/z.txt")
    show(f"join: {Directory(at: "foo").file(name: "bar").at}")
    show(f"parent: {z.parent().at}")
    show(f"name: {z.name()}")
    show(f"stem: {z.stem()}")
    show(f"extension: {z.extension()}")
    show(f"with_extension: {z.with_extension(ext: "md").at}")
    show(f"with_name: {z.with_name(name: "w.txt").at}")

    var plain = File(at: "plain")
    show(f"stem no ext: {plain.stem()}")
    show(f"extension no ext: {plain.extension()}")

    show("DONE")
    return
