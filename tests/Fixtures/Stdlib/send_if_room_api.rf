module Tests/Stdlib/SendIfRoomApi

# `send_if_room` puts an item into a channel only when it has room, never waiting, and `take_finished` takes the
# finished Agents out of a list in place, leaving the rest. `next_finished` hands Agents over in the order they finish,
# and `gather_all` keeps every result and failure. A receiver that closes drops what is buffered and refuses later sends.

import IO/Console
routine double(n: S64) -> S64
    return n * 2

routine slow(n: S64, ms: S64) -> S64
    waitfor(Duration.from_milliseconds(ms: ms))
    return n

failable routine risky(n: S64) -> S64
    if n == 2
        throw ChannelClosedError()
    return n * 10

routine start()
    var (feeder, hop) = make_channel[S64](capacity: 2)
    var first = feeder.send_if_room(item: 1)
    var second = feeder.send_if_room(item: 2)
    var third = feeder.send_if_room(item: 3)
    show(f"room: {first} {second} {third} count={hop.count()}")
    feeder.close()
    var late = try feeder.send_if_room(item: 4)
    show(f"after close: {late is None}")
    var total = 0
    each v in hop
        total = total + v
    show(f"drained: {total}")

    var jobs = List[Agent[S64]]()
    jobs.add_last(value: double.to[Agent](n: 1))
    jobs.add_last(value: double.to[Agent](n: 2))
    jobs.add_last(value: double.to[Agent](n: 3))
    var two = jobs[1].retrieve()
    var done = jobs.take_finished()
    show(f"taken: {done.count()} left: {jobs.count()} value: {two}")
    show(f"rest: {jobs.gather()}")

    var racers = List[Agent[S64]]()
    racers.add_last(value: slow.to[Agent](n: 1, ms: 60))
    racers.add_last(value: slow.to[Agent](n: 2, ms: 5))
    racers.add_last(value: slow.to[Agent](n: 3, ms: 30))
    var order = List[S64]()
    until racers.is_empty()
        var next = racers.next_finished()
        order.add_last(value: next.retrieve())
    show(f"finish order: {order}")

    var tries = List[Agent[S64]]()
    tries.add_last(value: risky.to[Agent](n: 1))
    tries.add_last(value: risky.to[Agent](n: 2))
    tries.add_last(value: risky.to[Agent](n: 3))
    var outcomes = tries.gather_all()
    show(f"all: {outcomes.count()} first: {outcomes[0]} third: {outcomes[2]}")
    var (tx, rx) = make_channel[Text](capacity: 4)
    tx.send(item: "a")
    tx.send(item: "b")
    rx.close()
    var sent = try tx.send(item: "c")
    show(f"receiver closed: {rx.is_closed()} left: {rx.count()} sent after: {sent}")
    show("DONE")
    return
