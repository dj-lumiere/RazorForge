module Tests/Stdlib/TryAdapterEntitiesApi

import IO/Console
import IterTools
# `try` and `check` over an adapter chain whose source holds entities: the collected list has the adapter's
# element type (the lambda's result), not the entity type the source list holds.
entity Racer
    name: Text
    laps: S64

routine start()
    var racers = List[Racer]()
    racers.add_last(Racer(name: "Ada", laps: 4))
    racers.add_last(Racer(name: "Lin", laps: 0))
    when try racers.select(transform: r => r.laps * 2).to[List]()
        is None => show("none")
        else as doubled => show(f"doubled: {doubled}")
    when try racers.select(transform: r => 8 // r.laps).to[List]()
        is None => show("a lap count of 0 fails")
        else as split => show(f"split: {split}")
    when check racers.select(transform: r => 8 // r.laps).to[List]()
        is DivisionByZeroError as e => show(f"check: {e.crash_message()}")
        is Crashables => show("other")
        is List[S64] as split => show(f"split: {split}")
    show("DONE")
    return
