module Tests/Stdlib/LifecycleOwnedApi

import IO/Console
# Verifies destroy fires on scope exit. Side-effecting destructor prints a marker;
# the recorded order of prints proves lifetime semantics.

entity Tracer
    tag: S64

routine Tracer(tag: S32) -> Tracer
    show(f"  create({tag})")
    return Tracer(tag: tag.to[S64]())

@override
routine Tracer.destruct()
    show(f"  destruct({me.tag})")
    return

routine inner()
    show(" inner enter")
    var s32_10: S32 = 10
    var a = Tracer(tag: s32_10)
    var s32_11: S32 = 11
    var b = Tracer(tag: s32_11)
    show(" inner body")
    return
    # a, b destroyed at function exit (reverse-creation order expected)

routine start()
    show("--- inner() ---")
    inner()
    show("--- after inner() ---")

    var s32_1: S32 = 1
    var keep = Tracer(tag: s32_1)
    show("--- start body ---")
    # keep destroyed at start() exit, after the final show
    show("DONE")
    return
