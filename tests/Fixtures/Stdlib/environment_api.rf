module Tests/Stdlib/EnvironmentApi

import IO/Console
import IO/Environment
import IO/File
import Random

# What the operating system gives the program: arguments, environment variables, the well-known directories, the
# partition a directory is on, and random bits.
routine start()
    var arguments = OsEnvironment.arguments()
    show(f"arguments: {arguments.count()}")
    show(f"PATH set: {(try OsEnvironment.variable(name: "PATH")).is_present()}")
    show(f"missing variable: {try OsEnvironment.variable(name: "RF_FIXTURE_SURELY_NOT_SET")}")
    var variables = OsEnvironment.to[Dict[Text, Text]]()
    show(f"PATH in the snapshot: {variables.has_key(key: "PATH")}")
    var working = OsEnvironment.working_directory()
    show(f"working directory exists: {OsFileManager.exists(at: working)}")
    show(f"temp directory exists: {OsFileManager.exists(at: OsEnvironment.temp_directory())}")
    var partition = OsFileManager.partition(at: working)
    show(f"partition root exists: {OsFileManager.exists(at: partition.root)}")
    var known = false
    each p in PartitionManager.all()
        if p.root.at == partition.root.at
            known = true
    show(f"partition listed: {known}")
    show(f"entropy differs: {OsEntropy.next_u64() != OsEntropy.next_u64()}")
    var a = Random.from_entropy()
    var b = Random.from_entropy()
    show(f"streams differ: {a.next_u64() != b.next_u64()}")
    return
