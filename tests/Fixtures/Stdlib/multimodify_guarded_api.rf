module Tests/Stdlib/MultimodifyGuardedApi

import IO/Console
# `multimodify` on two Guarded handles takes both locks at once (address order), and `using ... as (a, b)` names the
# two write tokens. The two handles must be different entities: the same one twice is an AliasedTokensError.

entity Account
    total: S64

routine start()
    var xs = List[Guarded[Account, Exclusive]]()
    xs.add_last(value: Guarded[Account, Exclusive](from: Account(total: 10)))
    xs.add_last(value: Guarded[Account, Exclusive](from: Account(total: 32)))
    using multimodify(first: xs[0], second: xs[1]) as (a, b)
        a.total += b.total
    using multimodify(first: xs[1], second: xs[0]) as (c, d)
        c.total += 1
    when check multimodify(first: xs[1], second: xs[1])
        is AliasedTokensError => show("the same handle twice: AliasedTokensError")
        is MultiModifyingGuarded[Account, Exclusive] => show("not reached")
    using xs[0].modify() as e
        show(f"{e.total}")
    using xs[1].modify() as f
        show(f"{f.total}")
    show("DONE")
    return
