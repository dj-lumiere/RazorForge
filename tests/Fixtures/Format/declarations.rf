# The file's opening comment stays first.
module Tests/Format/Declarations
import Numerics as num
import IO/Console
import Collections.[List, Dict]

routine start()
    show("hi")
    return

### A point.
@llvm("i64")
record Point[T obeys Comparable]   obeys Equatable, Hashable onlyif T obeys Hashable
needs T obeys Copyable
relates PointEmitter[T] as Iter
    x: T     # the x
    y: T
    secret hidden: S32 = 0

routine C::abs(S32) -> S32

preset LIMIT: S32 = 100
preset FLOOR: S32 = 0

entity Node
    pass

crashable ParseError
    pass

choice Color
    RED
    GREEN: 5

flags Perm
    READ
    WRITE

variant Value[T]
    T
    None

protocol Shape[AnyType T]
    relates Key obeys Hashable
    @readonly
    routine Me.area() -> B64
    common routine Me.unit() -> Me

define Old as New

@[readonly, inline]
routine List[T].first_or!(fallback: T) -> T
    return fallback

routine identity[T](value: T) -> T
needs T obeys Copyable
    preset local: S32 = 1
    lateinit var later: S32
    var (left, right) = (value, value)
    return value
