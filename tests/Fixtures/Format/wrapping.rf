module Tests/Format/Wrapping
import IO/Console

routine many_parameters(first_parameter: S64, second_parameter: S64, third_parameter: S64, fourth: S64) -> S64
    return first_parameter

routine pair(left: S64, right: S64) -> S64
    return left + right

routine start()
    var result = many_parameters(first_parameter: 1, second_parameter: 2, third_parameter: 3, fourth: 4)
    var short_call = many_parameters(
        first_parameter: 1,
        second_parameter: 2,
        third_parameter: 3,
        fourth: 4)
    var joined = pair(
        left: 1,
        right: 2
    )
    if result > 100 and short_call > 100 and result + short_call > 1000 and result - short_call < 50000
        show("large")
    var chained = result.to_text().trim_start().trim_end().replace(old: "a", new: "b").replace(old: "c", new: "d")
    var short_chain = result.to_text().trim()
    var three_calls = result.to_text().trim().upper()
    var masked = (result & 0xFF) == 0 and (result & (1 << 3)) != 0 or (short_call > 2 and result < 3)
    show(f"a single argument that cannot break stays on one line even when it is longer than the limit {result}")
    return
