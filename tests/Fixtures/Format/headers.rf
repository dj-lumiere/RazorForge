module Tests/Format/Headers

@test
@case(input: (1, -2), output: -1)
@time_limit(5s)
@memory_limit(1mib)
routine test_add(a: S32, b: S32) -> S32
    return a + b

entity Pair[EntityType A, U64 B] obeys Equatable, Hashable, Comparable, Sized, Container, Iterable[A], Copyable, Assignable, Representable
needs Hashable everywhere
needs A obeys Hashable, Equatable
needs Equatable everywhere
relates PairEmitter[A] as Iter
relates A as Key
    first: A

record Box[AnyType T]
    value: T

routine identity[AnyType T, U64 N](value: T) -> T
    var tab_parser = CSVParser['\t']
    var tab = '\t'
    var text = "a\tb"
    return value

routine describe(point: (S64, S64)) -> Text
    when point
        (0, 0) => return "origin"
        (x, 0) => return f"x-axis {x}"
        (x, y) => return f"at {x}, {y}"
    unless point.item0 > 5
        return "small"
    else
        return "big"

protocol Keyed
    relates Key obeys Hashable
    relates Value
    routine Me.size() -> U64
