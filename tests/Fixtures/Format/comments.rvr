module Tests/Format/Comments
import IO/Console
#no space after the hash
###no space after the doc marker
routine documented() -> S32
    # leads the first statement
    var a = 1   # trails a statement, two spaces in the output


    # a run of blank lines above becomes one
    return a
    ### a doc comment written after the last statement stays in its block

# leads the next routine
routine branches(x: S32)
    if x > 0  # trails the if header
        show("positive")
        # written after the last statement of the then-block, stays in it
    else  # trails the else header
        show("other")
    return
    # written after the last statement of the routine, stays in it

# leads the last routine, at its indent
routine last()
    return
