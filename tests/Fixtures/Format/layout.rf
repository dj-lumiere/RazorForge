module Tests/Format/Layout
import IO/Console

routine helper!(a: S32) -> S32
    if a < 0
        throw ValueError(message: "negative")
    unless a != 0
        absent
    return a



routine spacing(xs: List[S32], perms: Perm, v: Shape)
    var total=0
    var hx = 0xff_u32
    var mixed:S32 = ((1 + 2) * 3)
    var bits = (hx & (1u32 << 4u32)) != 0u32
    var neg = -5
    var call_on_neg = (-5).abs()
    var minus_paren = -(5)
    var r = 0 to 10 by 2
    var inside = 0 to 10 have 5
    var q = (try helper(a: 1))!! + 1
    var p = try helper(a: 1)!!
    var raw = r"raw\n"
    var bs = b"bytes\x01"
    var ch = 'a'
    var text = "tab\tquote\"backslash\\"
    var f = f"value {hx:=} {{braces}} {neg}"
    var tup = (1,)
    var empty = {:}
    var st = {1, 2}
    var dct = {1: "a", 2: "b"}
    var doubled = xs.select(_ * 2)
    var ranged = xs.where(x given (lo, hi) => lo <= x < hi)
    var add = (x: S32, y: S32) => x + y
    var last = xs[^1]
    var bigger = if total > 3 then total else 3
    each x in xs
        total += x
    else
        show("done")
    each (i, x) in xs.enumerate()
        discard i
    var n = 10
    while n > 0
        n -= 1
    loop
        break
    var w: U8 = 250u8
    w +%= 10u8
    var m: S32? = none
    m ??= 5
    when perms
        have READ => pass
        lack WRITE => pass
        else => pass
    when v
        is Circle c and c.radius > 0 =>    show("circle")
        is Rect (w, h) => show("rect")
        isnot Square => pass
        else => pass
    when
        v is Circle => show("c")
        else => show("other")
    var access = when perms
        have READ and WRITE but EXEC => "rw"
        lack READ => "no read"
        else => "other"
    if (v is Circle) and (perms have READ or WRITE) and (perms have EXEC)
        pass
    elseif total == 0
        pass
    else
        pass
    using open(path: "a") as fa, open(path: "b") as fb
        show("both")
    danger
        var unsafe_value = 1
    return
