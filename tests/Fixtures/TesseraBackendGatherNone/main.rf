module Tests/TesseraBackendGatherNone

import IO/Console

entity Counter
    sold: U32

routine sell_one(counter: Guarded[Counter, Exclusive])
    modifying counter as c
        c.sold = c.sold + 1
    return

routine start()
    var counter = Guarded[Counter, Exclusive](from: Counter(sold: 0))
    var jobs: List[Work[None]] = []
    for i in 1 to 9
        jobs.add_last(value: sell_one.to[Work](counter: counter))
    drop jobs.gather()
    var total: U32 = 0
    modifying counter as c
        total = c.sold
    show(f"{total}")
    return
