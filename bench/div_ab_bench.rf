import IO/Console
# --- verbatim copy of Core.reciprocal_word (so the bench is self-contained) ---
preset RECIP_SEED_BENCH: Array[U16, 256] = [
    2045, 2037, 2029, 2021, 2013, 2005, 1998, 1990, 1983,
    1975, 1968, 1960, 1953, 1946, 1938, 1931, 1924, 1917,
    1910, 1903, 1896, 1889, 1883, 1876, 1869, 1863, 1856,
    1849, 1843, 1836, 1830, 1824, 1817, 1811, 1805, 1799,
    1792, 1786, 1780, 1774, 1768, 1762, 1756, 1750, 1745,
    1739, 1733, 1727, 1722, 1716, 1710, 1705, 1699, 1694,
    1688, 1683, 1677, 1672, 1667, 1661, 1656, 1651, 1646,
    1641, 1636, 1630, 1625, 1620, 1615, 1610, 1605, 1600,
    1596, 1591, 1586, 1581, 1576, 1572, 1567, 1562, 1558,
    1553, 1548, 1544, 1539, 1535, 1530, 1526, 1521, 1517,
    1513, 1508, 1504, 1500, 1495, 1491, 1487, 1483, 1478,
    1474, 1470, 1466, 1462, 1458, 1454, 1450, 1446, 1442,
    1438, 1434, 1430, 1426, 1422, 1418, 1414, 1411, 1407,
    1403, 1399, 1396, 1392, 1388, 1384, 1381, 1377, 1374,
    1370, 1366, 1363, 1359, 1356, 1352, 1349, 1345, 1342,
    1338, 1335, 1332, 1328, 1325, 1322, 1318, 1315, 1312,
    1308, 1305, 1302, 1299, 1295, 1292, 1289, 1286, 1283,
    1280, 1276, 1273, 1270, 1267, 1264, 1261, 1258, 1255,
    1252, 1249, 1246, 1243, 1240, 1237, 1234, 1231, 1228,
    1226, 1223, 1220, 1217, 1214, 1211, 1209, 1206, 1203,
    1200, 1197, 1195, 1192, 1189, 1187, 1184, 1181, 1179,
    1176, 1173, 1171, 1168, 1165, 1163, 1160, 1158, 1155,
    1153, 1150, 1148, 1145, 1143, 1140, 1138, 1135, 1133,
    1130, 1128, 1125, 1123, 1121, 1118, 1116, 1113, 1111,
    1109, 1106, 1104, 1102, 1099, 1097, 1095, 1092, 1090,
    1088, 1086, 1083, 1081, 1079, 1077, 1074, 1072, 1070,
    1068, 1066, 1064, 1061, 1059, 1057, 1055, 1053, 1051,
    1049, 1047, 1044, 1042, 1040, 1038, 1036, 1034, 1032,
    1030, 1028, 1026, 1024,
]

# ============================================================================
# A/B microbenchmark: the 2-by-1 word-division PRIMITIVE that M-G replaced.
#   HW  = C::rf_udivrem_128_64 (hardware x86 `divq`, the deleted shim; restored TEMPORARILY)
#   M-G = reciprocal_word + div2by1 (multiply-only), copied verbatim below as b_recip/b_div2by1.
# Two regimes, identical operand streams, calibration (PRNG+sink, no divide) subtracted:
#   * fixed-d   : one normalized divisor reused N times  -> models the Knuth inner loop (reciprocal amortized)
#   * varying-d : a fresh normalized divisor every iter  -> models a one-shot divide (reciprocal recomputed)
# MUST be built at release (-O2/-O3); at -O0 M-G's ~30 ops lose to one `divq` for no real reason.
# ============================================================================

record WQR
    q: U64
    r: U64

# --- splitmix64 draw ---
record Draw
    st: U64
    v: U64

routine b_recip(d: U64) -> U64
    var d9 = LLVM::shift_right_unsigned(d, 55)
    var v0 = LLVM::zero_extend[U16, U64](RECIP_SEED_BENCH[LLVM::sub(a: d9, b: 256)])
    var d40 = LLVM::add(a: LLVM::shift_right_unsigned(d, 24), b: 1)
    var t1 = LLVM::shift_right_unsigned(LLVM::mul(a: LLVM::mul(a: v0, b: v0), b: d40), 40)
    var v1 = LLVM::sub(a: LLVM::sub(a: LLVM::shift_left(v0, 11), b: t1), b: 1)
    var inner = LLVM::sub(a: 1152921504606846976, b: LLVM::mul(a: v1, b: d40))
    var t2 = LLVM::shift_right_unsigned(LLVM::mul(a: v1, b: inner), 47)
    var v2 = LLVM::add(a: LLVM::shift_left(v1, 13), b: t2)
    var d0 = LLVM::bit_and(a: d, b: 1)
    var d63 = LLVM::add(a: LLVM::shift_right_unsigned(d, 1), b: d0)
    var mask = LLVM::sub(a: 0, b: d0)
    var e = LLVM::sub(
        a: LLVM::bit_and(a: LLVM::shift_right_unsigned(v2, 1), b: mask),
        b: LLVM::mul(a: v2, b: d63),
    )
    var v2e = LLVM::mul(a: LLVM::zero_extend[U64, U128](v2), b: LLVM::zero_extend[U64, U128](e))
    var v3 = LLVM::add(
        a: LLVM::shift_right_unsigned(
            LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(v2e, 64)),
            1,
        ),
        b: LLVM::shift_left(v2, 31),
    )
    var v3d = LLVM::add(
        a: LLVM::mul(a: LLVM::zero_extend[U64, U128](v3), b: LLVM::zero_extend[U64, U128](d)),
        b: LLVM::zero_extend[U64, U128](d),
    )
    var v4 = LLVM::sub(
        a: LLVM::sub(
            a: v3,
            b: LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(v3d, 64)),
        ),
        b: d,
    )
    return v4

# --- verbatim copy of Core.div2by1 ---
routine b_div2by1(u1: U64, u0: U64, d: U64, v: U64) -> WQR
    var u = LLVM::bit_or(
        a: LLVM::shift_left(LLVM::zero_extend[U64, U128](u1), 64),
        b: LLVM::zero_extend[U64, U128](u0),
    )
    var qfull = LLVM::add(
        a: LLVM::mul(a: LLVM::zero_extend[U64, U128](v), b: LLVM::zero_extend[U64, U128](u1)),
        b: u,
    )
    var q0 = LLVM::int_truncate[U128, U64](qfull)
    var q1 = LLVM::add(
        a: LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(qfull, 64)),
        b: 1,
    )
    var r = LLVM::sub(a: u0, b: LLVM::mul(a: q1, b: d))
    if LLVM::unsigned_gt(a: r, b: q0)
        q1 = LLVM::sub(a: q1, b: 1)
        r = LLVM::add(a: r, b: d)
    if LLVM::unsigned_ge(a: r, b: d)
        q1 = LLVM::add(a: q1, b: 1)
        r = LLVM::sub(a: r, b: d)
    return WQR(q: q1, r: r)

@inline
routine nextdraw(st: U64) -> Draw
    var s = st +% 11400714819323198485
    var z = s
    z = (z ^ (z >>> 30)) *% 13787848793156543929
    z = (z ^ (z >>> 27)) *% 10723151780598845931
    return Draw(st: s, v: z ^ (z >>> 31))

# operand mask: u1 = draw & (2^63 - 1) is < 2^63 <= d (d normalized), so u1 < d holds.
# ============================ fixed-d scenarios ============================
routine calib_fixed(n: S64, seed0: U64) -> S64
    var best = -1
    var rep = 0
    while rep < 3
        var t0 = Moment.now()
        var st = seed0
        var sink: U64 = 0
        var i = 0
        while i < n
            var da = nextdraw(st: st)
            st = da.st
            var db = nextdraw(st: st)
            st = db.st
            sink = sink ^ (da.v & 9223372036854775807) ^ db.v
            i = i +% 1
        drop LLVM::do_not_optimize[U64](value: sink)
        var ns = Moment
            .now()
            .elapsed_since(earlier: t0)
            .total_nanoseconds()
        best = when
            rep == 0 => ns
            ns < best => ns
            else => best
        rep = rep +% 1
    return best

routine hw_fixed(n: S64, d: U64, seed0: U64) -> S64
    var best = -1
    var rep = 0
    while rep < 3
        var t0 = Moment.now()
        var st = seed0
        var sink: U64 = 0
        var i = 0
        while i < n
            var da = nextdraw(st: st)
            st = da.st
            var db = nextdraw(st: st)
            st = db.st
            var scratch: U64 = 0
            danger
                var q = C::rf_udivrem_128_64(
                    hi: da.v & 9223372036854775807,
                    lo: db.v,
                    d: d,
                    rem: scratch.hijack(),
                )
                sink = sink ^ q ^ scratch
            i = i +% 1
        drop LLVM::do_not_optimize[U64](value: sink)
        var ns = Moment
            .now()
            .elapsed_since(earlier: t0)
            .total_nanoseconds()
        best = when
            rep == 0 => ns
            ns < best => ns
            else => best
        rep = rep +% 1
    return best

routine mg_fixed(n: S64, d: U64, seed0: U64) -> S64
    var best = -1
    var rep = 0
    while rep < 3
        var t0 = Moment.now()
        var st = seed0
        var sink: U64 = 0
        var v = b_recip(d: d)  # reciprocal computed ONCE (amortized, like the Knuth loop)
        var i = 0
        while i < n
            var da = nextdraw(st: st)
            st = da.st
            var db = nextdraw(st: st)
            st = db.st
            var dr = b_div2by1(u1: da.v & 9223372036854775807, u0: db.v, d: d, v: v)
            sink = sink ^ dr.q ^ dr.r
            i = i +% 1
        drop LLVM::do_not_optimize[U64](value: sink)
        var ns = Moment
            .now()
            .elapsed_since(earlier: t0)
            .total_nanoseconds()
        best = when
            rep == 0 => ns
            ns < best => ns
            else => best
        rep = rep +% 1
    return best

# ============================ varying-d scenarios ============================
routine calib_var(n: S64, seed0: U64) -> S64
    var best = -1
    var rep = 0
    while rep < 3
        var t0 = Moment.now()
        var st = seed0
        var sink: U64 = 0
        var i = 0
        while i < n
            var dd = nextdraw(st: st)
            st = dd.st
            var da = nextdraw(st: st)
            st = da.st
            var db = nextdraw(st: st)
            st = db.st
            sink = sink ^ (dd.v | 9223372036854775808) ^ (da.v & 9223372036854775807) ^ db.v
            i = i +% 1
        drop LLVM::do_not_optimize[U64](value: sink)
        var ns = Moment
            .now()
            .elapsed_since(earlier: t0)
            .total_nanoseconds()
        best = when
            rep == 0 => ns
            ns < best => ns
            else => best
        rep = rep +% 1
    return best

routine hw_var(n: S64, seed0: U64) -> S64
    var best = -1
    var rep = 0
    while rep < 3
        var t0 = Moment.now()
        var st = seed0
        var sink: U64 = 0
        var i = 0
        while i < n
            var dd = nextdraw(st: st)
            st = dd.st
            var da = nextdraw(st: st)
            st = da.st
            var db = nextdraw(st: st)
            st = db.st
            var scratch: U64 = 0
            danger
                var q = C::rf_udivrem_128_64(
                    hi: da.v & 9223372036854775807,
                    lo: db.v,
                    d: dd.v | 9223372036854775808,
                    rem: scratch.hijack(),
                )
                sink = sink ^ q ^ scratch
            i = i +% 1
        drop LLVM::do_not_optimize[U64](value: sink)
        var ns = Moment
            .now()
            .elapsed_since(earlier: t0)
            .total_nanoseconds()
        best = when
            rep == 0 => ns
            ns < best => ns
            else => best
        rep = rep +% 1
    return best

routine mg_var(n: S64, seed0: U64) -> S64
    var best = -1
    var rep = 0
    while rep < 3
        var t0 = Moment.now()
        var st = seed0
        var sink: U64 = 0
        var i = 0
        while i < n
            var dd = nextdraw(st: st)
            st = dd.st
            var da = nextdraw(st: st)
            st = da.st
            var db = nextdraw(st: st)
            st = db.st
            var d = dd.v | 9223372036854775808
            var v = b_recip(d: d)  # reciprocal recomputed EVERY divide (one-shot, no amortization)
            var dr = b_div2by1(u1: da.v & 9223372036854775807, u0: db.v, d: d, v: v)
            sink = sink ^ dr.q ^ dr.r
            i = i +% 1
        drop LLVM::do_not_optimize[U64](value: sink)
        var ns = Moment
            .now()
            .elapsed_since(earlier: t0)
            .total_nanoseconds()
        best = when
            rep == 0 => ns
            ns < best => ns
            else => best
        rep = rep +% 1
    return best

routine start()
    var n = 30000000
    var seed: U64 = 2611923443488238969
    var dfix = LLVM::bit_or(a: nextdraw(st: seed).v, b: 9223372036854775808)
    var so: U64 = 88172645463325252
    var cf = calib_fixed(n: n, seed0: so)
    var hf = hw_fixed(n: n, d: dfix, seed0: so)
    var mf = mg_fixed(n: n, d: dfix, seed0: so)
    var cv = calib_var(n: n, seed0: so)
    var hv = hw_var(n: n, seed0: so)
    var mv = mg_var(n: n, seed0: so)
    show(f"N = {n} divides per timed loop (best of 3)")
    show(f"[fixed-d, reciprocal reused]  hw(divq) net = {hf -% cf} ns  ({(hf -% cf) *% 1000 // n} ps/op)")
    show(f"                              m-g      net = {mf -% cf} ns  ({(mf -% cf) *% 1000 // n} ps/op)")
    show(f"[varying-d, one-shot]         hw(divq) net = {hv -% cv} ns  ({(hv -% cv) *% 1000 // n} ps/op)")
    show(f"                              m-g      net = {mv -% cv} ns  ({(mv -% cv) *% 1000 // n} ps/op)")
    return
