{
  "name": "Revare",
  "scopeName": "source.revare",
  "fileTypes": ["rvr", "revare"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#text-literals" },
    { "include": "#letter-literals" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "Documentation comment",
          "name": "comment.block.documentation.revare",
          "match": "###.*$"
        },
        {
          "comment": "Line comment",
          "name": "comment.line.revare",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "Annotations (@target, @link, @positional, @reshaping, @readonly, @writable, @llvm, @inline, @innate, @override, @overridable, @crash_only, @dangerous, @generated, ...)",
          "name": "storage.modifier.annotation.revare",
          "match": "@\\w+"
        },
        {
          "comment": "Type declarations",
          "name": "storage.type.revare",
          "match": "\\b(routine|entity|record|bundle|choice|variant|protocol|flags|crashable)\\b"
        },
        {
          "comment": "Variable declarations",
          "name": "keyword.declaration.revare",
          "match": "\\b(var|preset|common|define|lateinit|global)\\b"
        },
        {
          "comment": "Access and routine modifiers",
          "name": "keyword.modifier.revare",
          "match": "\\b(secret|posted|failable|dangerous|suspended|threaded)\\b"
        },
        {
          "comment": "A named jump (break to rows, continue to rows) and a loop named with loop as rows",
          "match": "\\b(break|continue)\\s+(to)\\s+([A-Za-z_][A-Za-z0-9_]*)|\\b(loop)\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.revare" },
            "2": { "name": "keyword.control.revare" },
            "3": { "name": "entity.name.label.revare" },
            "4": { "name": "keyword.control.revare" },
            "5": { "name": "keyword.control.revare" },
            "6": { "name": "entity.name.label.revare" }
          }
        },
        {
          "comment": "Control flow",
          "name": "keyword.control.revare",
          "match": "\\b(if|elseif|else|then|for|expand|loop|when|break|continue|return|throw|try|check|drop|todo|danger|until|becomes|inject)\\b"
        },
        {
          "comment": "Buildtime reflection SOURCE keywords (reserved; expand h in openmemvarof(T)/allmemvarof(T)/branchof(T)/caseof(T))",
          "name": "keyword.control.revare",
          "match": "\\b(openmemvarof|allmemvarof|branchof|caseof)\\b"
        },
        {
          "comment": "Buildtime reflection metadata accessors — contextual builtins, NOT reserved keywords (nameof(m)/typeof(m)/valueof(c)/…)",
          "name": "support.function.builtin.revare",
          "match": "\\b(nameof|orderof|placeof|sizeof|typeof|typeidof|valueof|visibilityof)\\b"
        },
        {
          "comment": "Type and pattern operations",
          "name": "keyword.operator.revare",
          "match": "\\b(is|isnot|obeys|in|everywhere)\\b"
        },
        {
          "comment": "Module system",
          "name": "keyword.control.import.revare",
          "match": "\\b(import|module)\\b"
        },
        {
          "comment": "Resource management and access blocks",
          "name": "keyword.control.revare",
          "match": "\\b(using|viewing|modifying)\\b"
        },
        {
          "comment": "Generic constraints and associated types",
          "name": "keyword.other.revare",
          "match": "\\b(needs|relates|onlyif)\\b"
        },
        {
          "comment": "Logical operators",
          "name": "keyword.operator.logical.revare",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "comment": "Self reference",
          "name": "variable.language.revare",
          "match": "\\b(me|Me)\\b"
        },
        {
          "comment": "Range keywords",
          "name": "keyword.operator.revare",
          "match": "\\b(to|til|by)\\b"
        },
        {
          "comment": "Danger block keyword",
          "name": "keyword.other.revare",
          "match": "\\bdanger"
        },
        {
          "comment": "Special keywords",
          "name": "keyword.other.revare",
          "match": "\\b(as|nothing|steal|given)\\b"
        },
        {
          "comment": "Boolean literals",
          "name": "constant.language.boolean.revare",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "None type (absent-arm type for variants and carriers)",
          "name": "constant.language.null.revare",
          "match": "\\b(None)\\b"
        },
        {
          "comment": "none value literal (the empty value of an Optional or a variant with a None case)",
          "name": "constant.language.null.revare",
          "match": "\\b(none)\\b"
        }
      ]
    },
    "text-literals": {
      "patterns": [
        {
          "comment": "Prefixed text literals (rf, r, f)",
          "name": "string.quoted.double.revare",
          "begin": "(rf|r|f)\"",
          "beginCaptures": {
            "1": { "name": "storage.modifier.revare" }
          },
          "end": "\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "comment": "Text literal",
          "name": "string.quoted.double.revare",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "comment": "Unicode escape \\uXXXXXX (6 hex)",
          "name": "constant.character.escape.revare",
          "match": "\\\\u[0-9a-fA-F]{6}"
        },
        {
          "comment": "Hex byte escape \\xFF (2 hex)",
          "name": "constant.character.escape.revare",
          "match": "\\\\x[0-9a-fA-F]{2}"
        },
        {
          "comment": "Simple escapes",
          "name": "constant.character.escape.revare",
          "match": "\\\\[nrt0\\\\\"']"
        }
      ]
    },
    "letter-literals": {
      "patterns": [
        {
          "comment": "Letter literal 'x'",
          "name": "string.quoted.single.revare",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "Hex number",
          "name": "constant.numeric.revare",
          "match": "\\b0x[0-9a-fA-F_]+([a-z0-9]+)?\\b"
        },
        {
          "comment": "Binary number",
          "name": "constant.numeric.revare",
          "match": "\\b0b[01_]+([a-z0-9]+)?\\b"
        },
        {
          "comment": "Octal number",
          "name": "constant.numeric.revare",
          "match": "\\b0o[0-7_]+([a-z0-9]+)?\\b"
        },
        {
          "comment": "Quaternary number",
          "name": "constant.numeric.revare",
          "match": "\\b0q[0-3_]+([a-z0-9]+)?\\b"
        },
        {
          "comment": "Float with suffix",
          "name": "constant.numeric.revare",
          "match": "\\b[0-9][0-9_]*\\.[0-9_]+([eE][+-]?[0-9_]+)?([a-z0-9]+)?\\b"
        },
        {
          "comment": "Int with suffix",
          "name": "constant.numeric.revare",
          "match": "\\b[0-9][0-9_]*([a-z]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Compound annotation",
          "name": "storage.modifier.annotation.revare",
          "match": "@\\[[a-zA-Z_][a-zA-Z0-9_, ]*\\]"
        },
        {
          "comment": "Annotation",
          "name": "storage.modifier.annotation.revare",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "comment": "Arrows",
          "name": "keyword.operator.revare",
          "match": "(->|=>)"
        },
        {
          "comment": "Three-way comparison",
          "name": "keyword.operator.revare",
          "match": "<=>"
        },
        {
          "comment": "Shift operators",
          "name": "keyword.operator.revare",
          "match": "(>>>|<<|>>)"
        },
        {
          "comment": "Comparison",
          "name": "keyword.operator.revare",
          "match": "(===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "comment": "Power operators",
          "name": "keyword.operator.revare",
          "match": "(\\*\\*[%^]?=?)"
        },
        {
          "comment": "Integer division",
          "name": "keyword.operator.revare",
          "match": "//=?"
        },
        {
          "comment": "Overflow arithmetic",
          "name": "keyword.operator.revare",
          "match": "[+\\-*][%^]=?"
        },
        {
          "comment": "Optional/coalesce operators",
          "name": "keyword.operator.revare",
          "match": "(\\?\\?=?|\\?\\.?|!!)"
        },
        {
          "comment": "Assignment",
          "name": "keyword.operator.revare",
          "match": "[+\\-*/%&|^]=|="
        },
        {
          "comment": "Basic operators",
          "name": "keyword.operator.revare",
          "match": "[+\\-*/%&|^~!]"
        }
      ]
    }
  }
}
